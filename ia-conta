#!/usr/bin/env bash
# ia-conta (também claude-conta) — seletor de contas de IA: perfis de login do Claude Code com
# conversas locais compartilhadas, e o uso da janela de todas as contas da rotação (Claude, Codex, Kiro).
#
# Cada perfil guarda apenas sua credencial em ~/.local/share/claude-contas/<nome>.
# Projetos, transcrições, histórico, sessões e configurações continuam sendo os de ~/.claude.
# O uso da janela (5 h / 7 dias do Claude e do Codex, créditos do mês do Kiro) vem do
# contas-uso.py, ao lado deste arquivo no pacote do tt.

set -euo pipefail

BASE="$HOME/.claude"
RAIZ="$HOME/.local/share/claude-contas"
CLAUDE_BIN="$HOME/.local/bin/claude"
[[ -x $CLAUDE_BIN ]] || CLAUDE_BIN=$(command -v claude 2>/dev/null || echo "$CLAUDE_BIN")
[[ -x $CLAUDE_BIN ]] || CLAUDE_BIN=$(command -v claude 2>/dev/null || echo "$CLAUDE_BIN")
AQUI=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
USO_PY="$AQUI/contas-uso.py"
[[ -f $USO_PY ]] || USO_PY="$HOME/.local/share/tt/contas-uso.py"
CADASTRO="${XDG_CONFIG_HOME:-$HOME/.config}/tt/contas-ia"
TT_BIN="$AQUI/tt"
[[ -x $TT_BIN ]] || TT_BIN=$(command -v tt 2>/dev/null || true)
ESTADO_ROT="$HOME/.cache/claude-rot.state"
EMAILS_CACHE="$HOME/.cache/ia-conta.emails" # e-mail do Codex e do Kiro daqui (o do Claude fica na pasta)
ATUAL_ROT="$HOME/.cache/claude-rot.current"
# Percentuais de referência (os mesmos do ia-rot): a partir do aviso, preparar a passagem; no
# limite, passar a tarefa adiante.
AVISO=${CLAUDE_ROT_AVISO:-85}
LIMITE=${CLAUDE_ROT_LIMITE:-95}

die() { printf 'ia-conta: %s\n' "$*" >&2; exit 1; }

nome_valido() {
  [[ $1 =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]]
}

# Nomes que já têm outro significado na rotação ou nos subcomandos.
nome_reservado() {
  case $1 in
    principal | codex | kiro | abrir | adicionar | entrar | renomear | remover | descadastrar | listar | uso | cadastro | ajuda) return 0 ;;
  esac
  return 1
}

perfil() { printf '%s/%s' "$RAIZ" "$1"; }

# Estes dados são independentes da conta e permanecem canônicos em ~/.claude. O link é criado
# uma única vez por perfil; assim, uma conversa iniciada por qualquer conta pode ser retomada por
# todas as outras, sem copiar nem dividir o histórico local.
compartilhar_dados() {
  local nome=$1 dir item
  dir=$(perfil "$nome")
  mkdir -p "$dir"
  for item in projects history.jsonl file-history sessions settings.json settings.local.json plugins skills commands cache; do
    [[ -e $BASE/$item || -L $BASE/$item ]] || continue
    if [[ -e $dir/$item || -L $dir/$item ]]; then
      [[ -L $dir/$item && $(readlink -f "$dir/$item") == "$(readlink -f "$BASE/$item")" ]] ||
        die "o perfil '$nome' já tem '$item' próprio; não vou substituí-lo"
    else
      ln -s "$BASE/$item" "$dir/$item"
    fi
  done
}

uso() {
  cat <<'EOF'
Uso:
  ia-conta principal [argumentos do claude]
  ia-conta <conta> [argumentos do claude]
  ia-conta abrir [--retomar <id-da-conversa-do-claude>] [--exceto <conta>]...
  ia-conta adicionar <conta> [--email <e-mail>]
  ia-conta entrar <conta>
  ia-conta renomear <conta> <novo-nome>
  ia-conta remover <conta> [--sim]
  ia-conta listar [--rapido]
  ia-conta uso [--eu | <conta>...]
  ia-conta cadastro [nomear <apelido|e-mail|provedor:e-mail> <novo> | esquecer <...>]

Exemplos:
  ia-conta adicionar pessoal    # abre o login uma única vez para a conta
  ia-conta adicionar trabalho
  claude-pessoal                    # atalho criado automaticamente
  claude-trabalho --resume
  ia-conta renomear trabalho empresa
  ia-conta remover pessoal      # tira da lista (e da rotação do ia-rot)
  ia-conta uso --eu             # quanto a conta desta sessão já gastou da janela
  ia-conta abrir                # abre a IA com mais folga agora, já sem pedir permissões

O nome antigo claude-conta continua valendo.

abrir escolhe, entre todas as contas da rotação (Claude, Codex e Kiro), a com mais folga de uso
neste momento (ia-rot --melhor) e a abre interativa no modo sem confirmações do provedor:
claude --dangerously-skip-permissions, codex --yolo (no Android, também --no-daemon),
kiro-cli chat --v3 --trust-all-tools. --retomar continua a conversa do Claude dada quando a escolhida também é do Claude (as conversas
são compartilhadas entre as contas); se for Codex ou Kiro, abre uma sessão nova.

"principal" usa a credencial que já estava em ~/.claude. Os demais perfis têm
credenciais separadas, mas compartilham sessões, histórico e memórias locais.

listar mostra todas as contas da rotação do ia-rot (Claude, Codex e Kiro) com a
coluna USO: janela de 5 h e semanal do Claude e do Codex, créditos do mês do Kiro.
Tokens vencidos do Claude são renovados pelo próprio Claude (--rapido pula isso e
usa o último valor conhecido, marcado com ~).

cadastro é a lista comum de contas de todas as máquinas do tt, identificadas pelo par
(provedor, e-mail) — claude, codex, kiro — com um apelido que é só rótulo; o listar a preenche.
Cada máquina faz o próprio login (copiar a credencial derrubaria a outra quando o token
renovasse); o listar mostra as contas do Claude do cadastro que faltam aqui. nomear muda o
apelido; esquecer tira a conta do cadastro.

uso imprime "conta<TAB>pico%<TAB>situação<TAB>detalhe"; situação é ok, aviso (pico
≥ CLAUDE_ROT_AVISO, padrão 85) ou passar (≥ CLAUDE_ROT_LIMITE, padrão 95). Saída 0
= ok, 3 = aviso, 4 = passar, 2 = desconhecido.
EOF
}

atalho_de() { printf '%s/.local/bin/claude-%s' "$HOME" "$1"; }
texto_atalho() { printf '#!/usr/bin/env bash\nexec %q %q "$@"' "$HOME/.local/bin/claude-conta" "$1"; }

criar_atalho() {
  local nome=$1 alvo
  alvo=$(atalho_de "$nome")
  [[ -e $alvo || -L $alvo ]] && return
  printf '%s\n' "$(texto_atalho "$nome")" >"$alvo"
  chmod 700 "$alvo"
}

# Só apaga o atalho se ele é exatamente o que criar_atalho gerou (um claude-x escrito à mão fica).
apagar_atalho() {
  local alvo
  alvo=$(atalho_de "$1")
  if [[ -f $alvo && ! -L $alvo && $(cat "$alvo") == "$(texto_atalho "$1")" ]]; then
    rm -f "$alvo"
  fi
}

entrar() {
  local nome=$1 email=${2:-} dir
  nome_valido "$nome" || die "nome inválido: use letras, números, - ou _"
  nome_reservado "$nome" && die "'$nome' é reservado; escolha outro nome"
  [[ -x $CLAUDE_BIN ]] || die "não achei o Claude Code em $CLAUDE_BIN"
  [[ -d $BASE ]] || die "não achei a base local $BASE"
  compartilhar_dados "$nome"
  criar_atalho "$nome"
  dir=$(perfil "$nome")
  rm -f "$dir/.account-email" # outro login pode ser outro e-mail
  printf 'Abrindo login da conta "%s". As sessões locais continuam compartilhadas.\n' "$nome"
  # Com o e-mail esperado (ia-login), a página de login já abre nele: menos chance de entrar na errada.
  CLAUDE_CONFIG_DIR="$dir" exec "$CLAUDE_BIN" auth login ${email:+--email "$email"}
}

# PIDs de processos (fora este) que rodam com CLAUDE_CONFIG_DIR apontando para DIR. Um Claude aberto
# guarda o caminho: se a pasta muda de nome ou sai, ele perde a credencial no meio da conversa.
em_uso() {
  local dir=$1 f pid
  for f in /proc/[0-9]*/environ; do
    pid=${f#/proc/}; pid=${pid%/environ}
    [[ $pid == "$$" || $pid == "$BASHPID" ]] && continue
    grep -qzxF -e "CLAUDE_CONFIG_DIR=$dir" -e "CLAUDE_CONFIG_DIR=$dir/" "$f" 2>/dev/null && printf '%s ' "$pid"
  done
  return 0
}

recusar_em_uso() {
  local nome=$1 pids
  pids=$(em_uso "$(perfil "$nome")")
  [[ -z $pids ]] && return 0
  die "a conta '$nome' está aberta agora (processos: ${pids% }); feche essas sessões antes"
}

# Troca o nome NOME por NOVO nos arquivos de estado do ia-rot, do uso e dos atalhos do tt.
trocar_nome_estado() {
  local velho=$1 novo=$2 f
  if [[ -f $ESTADO_ROT ]]; then
    awk -F'\t' -v OFS='\t' -v a="$velho" -v b="$novo" '$1==a{$1=b} {print}' "$ESTADO_ROT" >"$ESTADO_ROT.novo" &&
      mv "$ESTADO_ROT.novo" "$ESTADO_ROT"
  fi
  [[ $(cat "$ATUAL_ROT" 2>/dev/null) == "$velho" ]] && printf '%s' "$novo" >"$ATUAL_ROT"
  f="$HOME/.cache/claude-rot.uso.json"
  [[ -f $f ]] && python3 -I - "$f" "$velho" "$novo" <<'PY' 2>/dev/null || true
import json, sys
f, a, b = sys.argv[1:]
d = json.load(open(f))
if a in d:
    d[b] = d.pop(a)
    if str(d[b].get("alvo", "")).endswith("/" + a):
        d[b]["alvo"] = d[b]["alvo"][: -len(a)] + b
    json.dump(d, open(f, "w"))
PY
  # Atalho da barra do tt com ajuste local (desativado, outro emoji): o ID acompanha o nome.
  f="${XDG_CONFIG_HOME:-$HOME/.config}/tt/atalhos"
  if [[ -f $f ]] && grep -q "	claude-conta-$velho	" "$f"; then
    awk -F'\t' -v OFS='\t' -v a="claude-conta-$velho" -v b="claude-conta-$novo" '$2==a{$2=b} {print}' "$f" >"$f.novo" &&
      mv "$f.novo" "$f"
  fi
}

redesenhar_tt() {
  command -v tt >/dev/null 2>&1 && [[ -n ${TMUX:-} ]] && tt --redesenhar >/dev/null 2>&1 || true
}

renomear() {
  local velho=$1 novo=$2 dir destino email
  [[ $velho == principal ]] && die "a principal é a credencial de ~/.claude; não tem pasta para renomear"
  for n in "$velho" "$novo"; do nome_valido "$n" || die "nome inválido '$n': use letras, números, - ou _"; done
  nome_reservado "$novo" && die "'$novo' é reservado; escolha outro nome"
  dir=$(perfil "$velho"); destino=$(perfil "$novo")
  [[ -d $dir && ! -L $dir ]] || die "não existe a conta '$velho' (veja: ia-conta listar)"
  [[ -e $destino || -L $destino ]] && die "já existe uma conta '$novo'"
  recusar_em_uso "$velho"
  mv "$dir" "$destino"
  apagar_atalho "$velho"
  criar_atalho "$novo"
  trocar_nome_estado "$velho" "$novo"
  email=$(email_local "$novo")
  if [[ -n $email && $(cadastro_nome claude "$email") == "$velho" ]] && [[ -z $(cadastro_par "$novo" claude) ]]; then
    printf 'claude\t%s\t%s\t%s\n' "$email" "$novo" "$(hora_mudanca claude "$email")" | cadastro_gravar
  fi
  redesenhar_tt
  printf 'Conta "%s" agora se chama "%s" (atalho: claude-%s).\n' "$velho" "$novo" "$novo"
}

# Tira o perfil da lista. Nada é apagado: a pasta vai para claude-contas.removidas (fora da rotação do
# ia-rot) e volta com mv. Os links para ~/.claude são só links, a pasta compartilhada fica intacta.
remover() {
  local nome=$1 sim=$2 dir destino email resp
  [[ $nome == principal ]] && die "a principal é a credencial de ~/.claude; não dá para removê-la daqui"
  nome_valido "$nome" || die "nome inválido: use letras, números, - ou _"
  dir=$(perfil "$nome")
  [[ -d $dir ]] || die "não existe a conta '$nome' (veja: ia-conta listar)"
  recusar_em_uso "$nome"
  if [[ -s $dir/.credentials.json && $sim != 1 ]]; then
    email=$(claude_status_email "$dir") || email='e-mail desconhecido'
    [[ -t 0 ]] || die "a conta '$nome' está conectada ($email); confirme com: ia-conta remover $nome --sim"
    read -r -p "A conta '$nome' está conectada ($email). Remover? [s/N] " resp
    [[ $resp == [sS]* ]] || { echo 'Nada removido.'; return; }
  fi
  destino="$RAIZ.removidas/$nome-$(date +%Y%m%dT%H%M%S)"
  mkdir -p "$RAIZ.removidas"
  mv "$dir" "$destino"
  apagar_atalho "$nome"
  [[ $(cat "$ATUAL_ROT" 2>/dev/null) == "$nome" ]] && rm -f "$ATUAL_ROT"
  redesenhar_tt
  printf 'Conta "%s" removida. Guardada em %s\nPara desfazer: mv %q %q\n' "$nome" "$destino" "$destino" "$dir"
}

rodar() {
  local nome=$1 dir
  shift
  # codex/kiro são outros provedores, não perfis do Claude (criar a pasta deixava um perfil vazio).
  case $nome in codex | kiro) die "'$nome' não é conta do Claude; rode $( [[ $nome == kiro ]] && echo kiro-cli || echo codex) direto (ou veja: ia-conta uso $nome)" ;; esac
  if [[ $nome == principal ]]; then
    IA_CONTA=principal exec env -u CLAUDE_CONFIG_DIR "$CLAUDE_BIN" "$@"
  fi
  nome_valido "$nome" || die "nome inválido: use letras, números, - ou _"
  compartilhar_dados "$nome"
  dir=$(perfil "$nome")
  [[ -s $dir/.credentials.json ]] || die "a conta '$nome' ainda não foi conectada; rode: ia-conta adicionar $nome"
  exec env IA_CONTA="$nome" CLAUDE_CONFIG_DIR="$dir" "$CLAUDE_BIN" "$@"
}

# Contas na ordem da rotação do ia-rot: principal, perfis (alfabética), codex, kiro.
contas_rotacao() {
  local dir
  echo principal
  if [[ -d $RAIZ ]]; then
    for dir in "$RAIZ"/*/; do
      dir=${dir%/}
      [[ -d $dir && ! -L $dir ]] || continue
      nome_valido "${dir##*/}" || continue # travas (.lock) e outras pastas não são contas
      case ${dir##*/} in codex | kiro) continue ;; esac
      echo "${dir##*/}"
    done
  fi
  command -v codex >/dev/null 2>&1 && echo codex
  command -v kiro-cli >/dev/null 2>&1 && echo kiro
  return 0
}

pasta_claude() { if [[ $1 == principal ]]; then echo "$BASE"; else perfil "$1"; fi; }

alvo_uso() {
  case $1 in codex | kiro) echo "$1" ;; *) pasta_claude "$1" ;; esac
}

# Token do Claude vencido (ou perto de vencer): a consulta de uso precisa de um válido.
token_vencido() {
  python3 -I -c '
import json, sys, time
c = json.load(open(sys.argv[1])).get("claudeAiOauth") or {}
sys.exit(0 if c.get("expiresAt", 0) / 1000 < time.time() + 60 else 1)' "$1/.credentials.json" 2>/dev/null
}

# Quem renova é o próprio Claude, ao iniciar (antes mesmo de ler o prompt): sem prompt, ele renova e
# sai com erro, sem gastar nada da janela. Renovar por fora trocaria o refresh token e derrubaria a
# sessão aberta da conta.
renovar_tokens() {
  local c dir pids=()
  for c in "$@"; do
    case $c in codex | kiro) continue ;; esac
    dir=$(pasta_claude "$c")
    [[ -s $dir/.credentials.json ]] && token_vencido "$dir" || continue
    if [[ $c == principal ]]; then
      (cd /tmp && env -u CLAUDE_CONFIG_DIR timeout 30 "$CLAUDE_BIN" -p --no-session-persistence </dev/null >/dev/null 2>&1) &
    else
      (cd /tmp && CLAUDE_CONFIG_DIR="$dir" timeout 30 "$CLAUDE_BIN" -p --no-session-persistence </dev/null >/dev/null 2>&1) &
    fi
    pids+=($!)
  done
  # O Claude sem prompt sai com erro (é o esperado): o status do wait não interessa.
  ((${#pids[@]} == 0)) || wait "${pids[@]}" 2>/dev/null || true
  return 0
}

# TSV do contas-uso.py para as contas dadas: conta pico volta texto fonte email folga.
consultar_uso() {
  local c args=()
  [[ -f $USO_PY ]] || return 0
  for c in "$@"; do args+=("$c=$(alvo_uso "$c")"); done
  python3 -I "$USO_PY" "${args[@]}" 2>/dev/null || true
}

hora_reset() {
  local t=$1
  [[ -n $t ]] || return 0
  t=$((t + 30)) # 20:49:59.6 é 20:50
  local f='+%d/%m %H:%M'
  ((t - $(date +%s) < 72000)) && f=+%H:%M
  date -d "@$t" "$f" 2>/dev/null || date -r "$t" "$f" 2>/dev/null || true # GNU / macOS
}

# Cadastro comum (todas as máquinas, mantido pelo tt): "provedor<TAB>e-mail<TAB>apelido<TAB>hora".
# A identidade de uma conta é o par (provedor, e-mail): o apelido é só o rótulo (apelido "-" =
# esquecida). Linhas antigas "e-mail<TAB>apelido<TAB>hora" são do Claude.
cadastro_linhas() {
  awk -F'\t' -v OFS='\t' 'NF == 3 && $1 ~ /@/ { print "claude", $0; next } NF >= 4' "$CADASTRO" 2>/dev/null || true
}
cadastro_nome() { cadastro_linhas | awk -F'\t' -v p="$1" -v e="$2" '$1 == p && $2 == e { print $3 }'; }
# Pares "provedor<TAB>e-mail" com o apelido N (de qualquer provedor, ou só do provedor P).
cadastro_par() { cadastro_linhas | awk -F'\t' -v OFS='\t' -v n="$1" -v p="${2:-}" '$3 == n && (p == "" || $1 == p) { print $1, $2 }'; }

# Hora para uma mudança no par P E: agora, ou a da entrada atual + 1 se ela estiver no futuro
# (relógio adiantado em outra máquina): senão a mudança perderia na mesclagem.
hora_mudanca() {
  local agora t
  agora=$(date +%s)
  t=$(cadastro_linhas | awk -F'\t' -v p="$1" -v e="$2" '$1 == p && $2 == e { print $4 }')
  ((${t:-0} >= agora)) && agora=$((t + 1))
  echo "$agora"
}

# Grava as linhas do stdin no cadastro (o tt mescla, com trava) e envia às outras máquinas.
cadastro_gravar() {
  if [[ -z $TT_BIN ]]; then cat >/dev/null; return 0; fi
  "$TT_BIN" --receber-contas-ia || return 0
  ("$TT_BIN" --propagar-contas-ia >/dev/null 2>&1 &)
  return 0
}

provedor_de() { case $1 in codex | kiro) echo "$1" ;; *) echo claude ;; esac; }

# E-mail da conta local C só por cache (sem chamar CLI nem rede): o do Claude fica na pasta da
# conta; o do Codex e o do Kiro, no cache que o listar grava.
email_local() {
  local f
  case $1 in
    codex | kiro) awk -F'\t' -v c="$1" '$1 == c { print $2 }' "$EMAILS_CACHE" 2>/dev/null | tail -n 1 ;;
    *) f=$(pasta_claude "$1")/.account-email; [[ -s $f ]] && head -n 1 "$f" ;;
  esac
  return 0
}

# Contas daqui com e-mail conhecido: "conta<TAB>provedor<TAB>e-mail".
pares_locais() {
  local c email
  while read -r c; do
    email=$(email_local "$c")
    [[ $email == *@* ]] && printf '%s\t%s\t%s\n' "$c" "$(provedor_de "$c")" "$email"
  done <<<"$(contas_rotacao)"
  return 0
}

# Apelido para um par que ainda não está no cadastro: o nome local (perfil do Claude), se livre no
# provedor; senão o começo do e-mail (helio.cardoso@x → helio-cardoso), com -2, -3… se preciso.
# USADOS: apelidos já tomados no provedor.
nome_novo() {
  local email=$1 local_=$2 usados=$3 base n=2 nome
  if [[ -n $local_ && $local_ != principal && $local_ != codex && $local_ != kiro ]] &&
     ! grep -qxF -- "$local_" <<<"$usados"; then echo "$local_"; return; fi
  base=${email%%@*}; base=${base,,}; base=${base//[^a-z0-9_]/-}; base=${base#-}; base=${base:-conta}
  nome_reservado "$base" && base="$base-ia"
  nome=$base
  while grep -qxF -- "$nome" <<<"$usados"; do nome="$base-$n"; n=$((n + 1)); done
  echo "$nome"
}

# Põe no cadastro os pares daqui que ele ainda não conhece. Recebe "conta<TAB>provedor<TAB>e-mail".
cadastro_registrar() {
  local c p email usados novas="" nome agora
  agora=$(date +%s)
  while IFS=$'\t' read -r c p email; do
    [[ $email == *@* ]] || continue
    [[ -n $(cadastro_nome "$p" "$email") ]] && continue # conhecido (ou esquecido)
    grep -qF -- "$p"$'\t'"$email"$'\t' <<<"$novas" && continue
    usados=$( { cadastro_linhas; printf '%s' "$novas"; } | awk -F'\t' -v p="$p" '$1 == p && $3 != "-" { print $3 }')
    nome=$(nome_novo "$email" "$c" "$usados")
    novas+="$p"$'\t'"$email"$'\t'"$nome"$'\t'"$agora"$'\n'
  done
  [[ -n $novas ]] && printf '%s' "$novas" | cadastro_gravar
  return 0
}

# Depois da tabela: contas do Claude do cadastro que faltam aqui (o Claude é o único provedor com
# vários perfis por máquina; Codex e Kiro têm um login só) e apelidos locais diferentes (só rótulo).
cadastro_resumo() { # linhas "conta<TAB>provedor<TAB>e-mail" daqui
  local locais=$1 p email nome ts c n faltam="" difere=""
  [[ -s $CADASTRO ]] || return 0
  while IFS=$'\t' read -r p email nome ts; do
    [[ $p == claude && $nome != - ]] || continue
    awk -F'\t' -v e="$email" '$2 == "claude" && $3 == e { f = 1 } END { exit !f }' <<<"$locais" && continue
    # O nome já é de outra conta daqui: adicionar por cima trocaria o login dela.
    c=$(awk -F'\t' -v n="$nome" '$1 == n { print $3 }' <<<"$locais")
    if [[ -n $c ]]; then
      n=$(cadastro_nome claude "$c"); [[ -z $n || $n == - || $n == "$nome" ]] && n='<outro-nome>'
      faltam+="  $nome  $email  → antes, ia-conta renomear $nome $n; depois ia-conta adicionar $nome"$'\n'
    else
      faltam+="  $nome  $email  → ia-conta adicionar $nome"$'\n'
    fi
  done <<<"$(cadastro_linhas)"
  while IFS=$'\t' read -r c p email; do
    [[ $p == claude && $c != principal ]] || continue
    n=$(cadastro_nome claude "$email")
    [[ -n $n && $n != - && $n != "$c" ]] && difere+="  $c  é \"$n\" no cadastro  → ia-conta renomear $c $n"$'\n'
  done <<<"$locais"
  [[ -n $faltam ]] && printf '\nNo cadastro das máquinas, faltam aqui (Claude):\n%s' "$faltam"
  [[ -n $difere ]] && printf '\nApelidos diferentes do cadastro (opcional, só rótulo):\n%s' "$difere"
  return 0
}

# Resolve ALVO (apelido, e-mail ou provedor:e-mail) para um único par "provedor<TAB>e-mail".
resolver_par() {
  local alvo=$1 pares n
  if [[ $alvo == *:*@* ]]; then
    pares=$(cadastro_linhas | awk -F'\t' -v OFS='\t' -v p="${alvo%%:*}" -v e="${alvo#*:}" '$1 == p && $2 == e && $3 != "-" { print $1, $2 }')
  elif [[ $alvo == *@* ]]; then
    pares=$(cadastro_linhas | awk -F'\t' -v OFS='\t' -v e="$alvo" '$2 == e && $3 != "-" { print $1, $2 }')
  else
    pares=$(cadastro_par "$alvo")
  fi
  n=$(grep -c . <<<"$pares")
  [[ -n $pares ]] || die "'$alvo' não está no cadastro (veja: ia-conta cadastro)"
  ((n == 1)) || die "'$alvo' é mais de uma conta ($(tr '\t\n' ': ' <<<"$pares")); use provedor:e-mail"
  echo "$pares"
}

# ia-conta cadastro [nomear <apelido|e-mail|provedor:e-mail> <novo> | esquecer <...>]
cadastro() {
  local acao=${1:-} alvo=${2:-} novo=${3:-} p email c par aq
  case $acao in
    '')
      [[ -s $CADASTRO ]] || { echo 'Cadastro vazio: o ia-conta listar registra as contas desta máquina.'; return 0; }
      local -A aqui=()
      while IFS=$'\t' read -r c p email; do [[ -n $c ]] && aqui[$p$'\t'$email]+="${aqui[$p$'\t'$email]:+, }$c"; done <<<"$(pares_locais)"
      { printf 'PROVEDOR\tAPELIDO\tE-MAIL\tAQUI\n'
        while IFS=$'\t' read -r p email c _; do
          [[ -n $p && $c != - ]] || continue
          aq=${aqui[$p$'\t'$email]:-falta}
          # Codex e Kiro sem CLI aqui não "faltam": a máquina simplesmente não usa o provedor.
          [[ $aq == falta && $p != claude ]] && ! command -v "$( [[ $p == kiro ]] && echo kiro-cli || echo "$p")" >/dev/null 2>&1 &&
            aq='não instalado'
          printf '%s\t%s\t%s\t%s\n' "$p" "$c" "$email" "$aq"
        done <<<"$(cadastro_linhas | sort -t$'\t' -k1,1 -k3,3)"
      } | tabela
      ;;
    nomear | esquecer)
      [[ -n $alvo ]] || { uso >&2; exit 2; }
      par=$(resolver_par "$alvo"); p=${par%%$'\t'*}; email=${par#*$'\t'}
      if [[ $acao == esquecer ]]; then
        printf '%s\t%s\t-\t%s\n' "$p" "$email" "$(hora_mudanca "$p" "$email")" | cadastro_gravar
        echo "$p $email saiu do cadastro de todas as máquinas (os logins já feitos continuam)."
        return 0
      fi
      nome_valido "$novo" || die "nome inválido '$novo': use letras, números, - ou _"
      nome_reservado "$novo" && die "'$novo' é reservado; escolha outro nome"
      c=$(cadastro_par "$novo" "$p")
      [[ -z $c || $c == "$par" ]] || die "'$novo' já é o apelido de ${c#*$'\t'} ($p) no cadastro"
      printf '%s\t%s\t%s\t%s\n' "$p" "$email" "$novo" "$(hora_mudanca "$p" "$email")" | cadastro_gravar
      echo "No cadastro, $p $email agora é \"$novo\"."
      ;;
    *) uso >&2; exit 2 ;;
  esac
}

# Imprime o TSV do stdin alinhado (larguras em caracteres; a última coluna fica solta).
tabela() {
  local -a linhas campos larg=()
  local l i n
  mapfile -t linhas
  for l in "${linhas[@]}"; do
    IFS=$'\t' read -r -a campos <<<"$l"
    n=${#campos[@]}
    for ((i = 0; i < n - 1; i++)); do ((${#campos[i]} > ${larg[i]:-0})) && larg[i]=${#campos[i]}; done
  done
  for l in "${linhas[@]}"; do
    IFS=$'\t' read -r -a campos <<<"$l"
    n=${#campos[@]}
    for ((i = 0; i < n - 1; i++)); do printf '%s%*s  ' "${campos[i]}" $((${larg[i]:-0} - ${#campos[i]})) ''; done
    printf '%s\n' "${campos[n - 1]}"
  done
}

listar() {
  local rapido=${1:-0} c dir email estado detalhe pico volta texto fonte em
  local -a contas
  local -A U_PICO U_TEXTO U_FONTE U_EMAIL U_VOLTA
  mapfile -t contas <<<"$(contas_rotacao)"
  [[ $rapido == 1 ]] || renovar_tokens "${contas[@]}"
  while IFS=$'\t' read -r c pico volta texto fonte em _; do
    [[ -n $c ]] || continue
    U_PICO[$c]=${pico#-} U_VOLTA[$c]=${volta#-} U_TEXTO[$c]=${texto#-} U_FONTE[$c]=$fonte U_EMAIL[$c]=${em#-}
  done <<<"$(consultar_uso "${contas[@]}")"
  local -a linhas=('CONTA	PROVEDOR	E-MAIL	ESTADO	USO')
  local locais="" emails_cli=""
  for c in "${contas[@]}"; do
    email='—'
    case $c in
      codex)
        email=${U_EMAIL[$c]:-}
        [[ -n $email ]] || email=$(email_local codex)
        [[ -n $email ]] || email='—'
        if codex login status >/dev/null 2>&1; then estado='conectada'; else estado='sem login'; fi ;;
      kiro)
        email=$(timeout 20 kiro-cli whoami 2>/dev/null | sed -n 's/^Email: *//p' | head -n 1) || true
        if [[ -n $email ]]; then estado='conectada'; else email='—'; estado='sem login'; fi ;;
      *)
        dir=$(pasta_claude "$c")
        if [[ -s $dir/.credentials.json ]]; then
          estado='conectada'
          email=$(claude_status_email "$( [[ $c == principal ]] || echo "$dir")") || email='—'
        elif [[ $c == principal && -x $CLAUDE_BIN ]]; then
          estado='outra autenticação' # Keychain, chave de API, Bedrock: sem arquivo de credencial
        else
          estado='sem login'
        fi ;;
    esac
    pico=${U_PICO[$c]:-}
    if [[ $estado == conectada && -n $pico ]] && ((pico >= LIMITE)); then
      estado="esgotada"
    elif [[ $estado == conectada && $(cat "$ATUAL_ROT" 2>/dev/null) == "$c" ]]; then
      estado='última do rot'
    fi
    texto=${U_TEXTO[$c]:-}
    case ${U_FONTE[$c]:-desconhecido} in
      cache | reiniciou) texto="~$texto" ;;
      desconhecido) texto='?' ;;
    esac
    [[ $estado == 'sem login' ]] && texto='—'
    if [[ $email == *@* && $estado != 'sem login' ]]; then
      locais+="$c"$'\t'"$(provedor_de "$c")"$'\t'"$email"$'\n'
      case $c in codex | kiro) emails_cli+="$c"$'\t'"$email"$'\n' ;; esac
    fi
    linhas+=("$c"$'\t'"$(provedor_de "$c")"$'\t'"$email"$'\t'"$estado"$'\t'"$texto")
  done
  [[ -n $emails_cli ]] && { mkdir -p "${EMAILS_CACHE%/*}"; printf '%s' "$emails_cli" >"$EMAILS_CACHE"; }
  printf '%s\n' "${linhas[@]}" | tabela
  # A principal por último: com o mesmo e-mail de um perfil, o nome do perfil é o que vale.
  printf '%s' "$locais" | awk -F'\t' '$1 != "principal" { print } $1 == "principal" { p = $0 } END { if (p != "") print p }' |
    cadastro_registrar
  cadastro_resumo "$locais"
}

# Conta desta sessão: IA_CONTA (posta pelo ia-conta e pelo ia-rot), senão a pasta do
# CLAUDE_CONFIG_DIR, senão a principal quando dentro do Claude Code.
conta_atual() {
  if [[ -n ${IA_CONTA:-} ]]; then echo "$IA_CONTA"; return; fi
  if [[ -n ${CLAUDE_CONFIG_DIR:-} ]]; then
    local d=${CLAUDE_CONFIG_DIR%/}
    [[ $d == "$RAIZ"/* ]] && { echo "${d##*/}"; return; }
    [[ $d == "$BASE" ]] && { echo principal; return; }
  fi
  [[ -n ${CLAUDECODE:-} ]] && { echo principal; return; }
  [[ -n ${CODEX_SANDBOX:-}${CODEX_SANDBOX_NETWORK_DISABLED:-}${CODEX_THREAD_ID:-} ]] && { echo codex; return; }
  return 1
}

uso_contas() {
  local c pico volta texto fonte em situacao rc=0 r detalhe
  local -a contas=()
  for c in "$@"; do
    if [[ $c == --eu ]]; then
      c=$(conta_atual) || die "não sei qual conta esta sessão usa; diga qual: ia-conta uso <conta> (codex, kiro, principal…)"
    fi
    contas+=("$c")
  done
  ((${#contas[@]})) || mapfile -t contas <<<"$(contas_rotacao)"
  for c in "${contas[@]}"; do
    case $c in principal | codex | kiro) ;; *) [[ -d $(perfil "$c") ]] || die "não existe a conta '$c'" ;; esac
  done
  renovar_tokens "${contas[@]}"
  while IFS=$'\t' read -r c pico volta texto fonte em _; do
    [[ -n $c ]] || continue
    pico=${pico#-} volta=${volta#-} texto=${texto#-}
    if [[ -z $pico ]]; then situacao=desconhecido; r=2
    elif ((pico >= LIMITE)); then situacao=passar; r=4
    elif ((pico >= AVISO)); then situacao=aviso; r=3
    else situacao=ok; r=0
    fi
    detalhe=$texto
    [[ $fonte == cache || $fonte == reiniciou ]] && detalhe+=" (último valor conhecido)"
    [[ -n $volta && $situacao != ok ]] && detalhe+=" · reinicia $(hora_reset "$volta")"
    printf '%s\t%s\t%s\t%s\n' "$c" "${pico:-?}" "$situacao" "$detalhe"
    ((r > rc)) && rc=$r
  done <<<"$(consultar_uso "${contas[@]}")"
  return "$rc"
}

claude_status_email() {
  local config_dir=$1 saida email cache_dir cache tentativa
  cache_dir=${config_dir:-$BASE}
  cache="$cache_dir/.account-email"
  # O e-mail de uma credencial não muda (um novo login apaga o cache em entrar).
  if [[ -s $cache ]]; then
    IFS= read -r email <"$cache" || true
    [[ -n $email ]] && { printf '%s\n' "$email"; return 0; }
  fi
  for tentativa in 1 2 3; do
    if [[ -n $config_dir ]]; then
      saida=$(CLAUDE_CONFIG_DIR="$config_dir" "$CLAUDE_BIN" auth status --json 2>/dev/null) || true
    else
      saida=$(env -u CLAUDE_CONFIG_DIR "$CLAUDE_BIN" auth status --json 2>/dev/null) || true
    fi
    email=$(printf '%s\n' "$saida" |
      sed -n 's/^[[:space:]]*"email"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' |
      head -n 1) || email=''
    if [[ -n $email ]]; then
      printf '%s\n' "$email" >"$cache"
      chmod 600 "$cache"
      printf '%s\n' "$email"
      return 0
    fi
    sleep 0.2
  done
  return 1
}

# A IA com mais folga agora (ia-rot --melhor), interativa e sem pedir permissões.
abrir() {
  local retomar="" rot linha conta pico texto c
  local -a exceto=() claude_contas=()
  while (($#)); do
    case $1 in
      --retomar) retomar=${2:-}; shift ;;
      --exceto) exceto+=(--exceto "${2:-}"); shift ;;
      *) die "abrir: opção desconhecida '$1' (veja: ia-conta ajuda)" ;;
    esac
    shift
  done
  rot=$AQUI/ia-rot
  [[ -x $rot ]] || rot=$(command -v ia-rot 2>/dev/null) || die 'não achei o ia-rot'
  # Token vencido deixa o uso desconhecido (e a conta, para trás): o próprio Claude renova antes.
  while read -r c; do case $c in codex | kiro) ;; *) claude_contas+=("$c") ;; esac; done <<<"$(contas_rotacao)"
  renovar_tokens "${claude_contas[@]}"
  linha=$("$rot" --melhor "${exceto[@]}") || exit 2
  IFS=$'\t' read -r conta pico texto <<<"$linha"
  printf '%s' "$conta" >"$ATUAL_ROT" 2>/dev/null || true
  printf '→ %s (%s)\n' "$conta" "$texto"
  # Como root (Debian do proot no celular) o Claude só aceita pular permissões em ambiente isolado.
  [[ $EUID == 0 ]] && export IS_SANDBOX=1
  case $conta in
    codex)
      [[ -n $retomar ]] && echo '(conversa do Claude não continua no Codex: sessão nova)'
      # No Android (proot) o Codex não tem o pacote do servidor em segundo plano e sai com erro.
      if [[ -n ${ANDROID_ROOT:-} ]]; then exec env IA_CONTA=codex codex --no-daemon --yolo; fi
      exec env IA_CONTA=codex codex --yolo ;;
    kiro)
      [[ -n $retomar ]] && echo '(conversa do Claude não continua no Kiro: sessão nova)'
      exec env IA_CONTA=kiro kiro-cli chat --v3 --trust-all-tools ;;
    *)
      if [[ -n $retomar ]]; then rodar "$conta" --dangerously-skip-permissions --resume "$retomar"
      else rodar "$conta" --dangerously-skip-permissions; fi ;;
  esac
}

acao=${1:-}
case $acao in
  '' | -h | --help | ajuda) uso ;;
  adicionar | entrar)
    case "$#:${3:-}" in
      2:) entrar "$2" ;;
      4:--email) entrar "$2" "$4" ;;
      *) uso >&2; exit 2 ;;
    esac
    ;;
  renomear)
    [[ $# == 3 ]] || { uso >&2; exit 2; }
    renomear "$2" "$3"
    ;;
  remover | descadastrar)
    case "$#:${3:-}" in
      2:) remover "$2" 0 ;;
      3:--sim | 3:-s) remover "$2" 1 ;;
      *) uso >&2; exit 2 ;;
    esac
    ;;
  listar)
    case "$#:${2:-}" in
      1:) listar 0 ;;
      2:--rapido) listar 1 ;;
      *) die 'uso: ia-conta listar [--rapido]' ;;
    esac
    ;;
  uso) uso_contas "${@:2}" ;;
  abrir) abrir "${@:2}" ;;
  cadastro) cadastro "${@:2}" ;;
  *) rodar "$acao" "${@:2}" ;;
esac
