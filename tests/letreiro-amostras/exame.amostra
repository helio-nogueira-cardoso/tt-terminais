                    <item>
                        <title>Palmeiras x Corinthians: quais foram as maiores goleadas do Verdão</title>
                        <link>https://exame.com/esporte/palmeiras-x-corinthians-quais-foram-as-maiores-goleadas-do-verdao/</link>
                        <pubDate>2026-10-11T19:24:44</pubDate>
