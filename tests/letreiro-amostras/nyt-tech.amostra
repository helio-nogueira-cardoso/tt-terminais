    <item>
      <title>Inside Mark Zuckerberg’s Decision to Pull the Trigger on Meta’s A.I. Agent</title>
      <link>https://www.nytimes.com/2026/10/09/technology/inside-mark-zuckerbergs-decision-to-pull-the-trigger-on-metas-ai-agent.html</link>
      <guid isPermaLink="true">https://www.nytimes.com/2026/10/09/technology/inside-mark-zuckerbergs-decision-to-pull-the-trigger-on-metas-ai-agent.html</guid>
      <ns0:link href="https://www.nytimes.com/2026/10/09/technology/inside-mark-zuckerbergs-decision-to-pull-the-trigger-on-metas-ai-agent.html" rel="standout" />
      <description>Meta had delayed releasing Muse, its A.I. agent app, for months over safety concerns. Then new competition forced Mr. Zuckerberg’s hand.</description>
      <pubDate>Fri, 09 Oct 2026 09:03:46 +0000</pubDate>
      <category domain="http://www.nytimes.com/namespaces/keywords/des">Artificial Intelligence</category>
