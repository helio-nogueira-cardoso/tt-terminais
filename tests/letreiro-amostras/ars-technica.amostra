            <item>
                <title>Review: 4-hour Musk documentary feels like two different films</title>
                <link>https://arstechnica.com/culture/2026/10/review-4-hour-musk-documentary-feels-like-two-different-films/</link>
                                    <comments>https://arstechnica.com/culture/2026/10/review-4-hour-musk-documentary-feels-like-two-different-films/#comments</comments>
                
                <pubDate>Sun, 11 Oct 2026 18:10:54 +0000</pubDate>
