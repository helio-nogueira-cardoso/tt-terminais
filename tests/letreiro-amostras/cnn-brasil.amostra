<ns2:site>196779705</ns2:site>	<item>
		<title>China impõe sanções a ministros de Paraguai e Belize por laços com Taiwan</title>
		<link>https://www.cnnbrasil.com.br/internacional/china-impoe-sancoes-a-ministros-de-paraguai-e-belize-por-lacos-com-taiwan/</link>
		
		<pubDate>Mon, 12 Oct 2026 02:55:04 +0000</pubDate>
				<category>Internacional</category>
		<category>-agencia-reuters-</category>
		<category>China</category>
		<category>Paraguai</category>
		<category>sanções</category>
		<category>Taiwan</category>
		<guid isPermaLink="false">https://www.cnnbrasil.com.br///</guid>

					<description>Ministério das Relações Exteriores citou a soberania e a segurança nacionais como razões para as medidas</description>
										<ns3:encoded>&lt;p&gt;A China impôs sanções, a partir de segunda-feira (12), ao ministro das Comunicações do Paraguai e ao ministro das Relações Exteriores de Belize, devido aos laços de seus países com Taiwan.&lt;/p&gt;&lt;div id="mid2" class="custom__ad__element"&gt;&lt;/div&gt;
&lt;p&gt;O Ministério das Relações Exteriores citou a soberan</ns3:encoded>
					
		
		
		<ns2:post-id>15529714</ns2:post-id>	</item>
		<item>
