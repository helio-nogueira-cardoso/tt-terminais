O presidente </description>  <ns1:content url="https://s2-g1.glbimg.com/TbfPG_z2rFRRT279C5q8VYYKvqU=/i.s3.glbimg.com/v1/AUTH_59edd422c0c84a879bd37670ae4f538a/internal_photos/bs/2026/J/v/m4IAi8R2aNW1pmyt8zjA/55573953516-ef09ac051c-k.jpg" medium="image" />    <category>G1</category> <pubDate>Sun, 11 Oct 2026 15:36:31 -0000</pubDate>  </item>  </channel>  </rss>