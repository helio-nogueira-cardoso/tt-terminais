{"count":6167,"page":1,"totalPages":2056,"nextPage":2,"previousPage":0,"showingFrom":1,"showingTo":3,"items":[{"id":48255,"tipo":"Notícia","titulo":"Acervo bibliográfico de Pedro Geiger é doado à Biblioteca do IBGE","introducao":"A Gerência de Biblioteca, Informação e Memória (GEBIM), do Instituto Brasileiro de Geografia e Estatística (IBGE), recebeu a doação do acervo bibliográfico pessoal do geógrafo Pedro Pinchas Geiger, um dos mais importantes estudiosos da Geografia...","data_publicacao":"09/10/2026 06:03:16","produto_id":0,"produtos":"","editorias":"ibge","imagens":"{\"image_intro\":\"images\\/agenciadenoticias\\/ibge\\/2026_10\\/geigercapa.jpg\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"images\\/agenciadenoticias\\/ibge\\/2026_10\\/geigercapa.jpg\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}","produtos_relacionados":"","destaque":true,"link":"http://agenciadenoticias.ibge.gov.br/agencia-noticias/2012-agencia-de-noticias/noticias/48255-acervo-bibliografico-de-pedro-geiger-e-doado-a-biblioteca-do-ibge.html"},{"id":48259,"tipo":"Notícia","titulo":"IBGE divulga programação de censos na conferência","introducao":"O Instituto Brasileiro de Geografia e Estatística (IBGE) realizou, nesta sexta-feira (9/10), na 64ª Festa do Boi, a coletiva pública de apresentação da programação do Espaço Censos, que detalhou o debate internacional do 1° encontro internacional do 12º...","data_publicacao":"09/10/2026 06:01:01","produto_id":0,"produtos":"","editorias":"ibge","imagens":"{\"image_intro\":\"images\\/agenciadenoticias\\/ibge\\/2026_10\\/coletiva-festa-boi_003.jpg\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"images\\/agenciadenoticias\\/ibge\\/2026_10\\/coletiva-festa-boi_003.jpg\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}","produtos_relacionados":"","destaque":true,"link":"http://agenciadenoticias.ibge.gov.br/agencia-noticias/2012-agencia-de-noticias/noticias/48259-ibge-divulga-programacao-de-censos-na-conferencia.html"},{"id":48246,"tipo":"Release","titulo":"IPCA fica em 0,82% em setembro","introducao":"O Índice Nacional de Preços ao Consumidor Amplo (IPCA) de setembro foi de 0,82%, 1,14 ponto percentual (p.p.) acima do -0,32% registrado em agosto. No ano, o IPCA acumula alta de 3,95% e, nos últimos 12 meses, o índice ficou em 4,58%, acima dos 4,22% dos...","data_publicacao":"09/10/2026 09:00:00","produto_id":0,"produtos":"9256|Índice Nacional de Preços ao Consumidor Amplo|indice-nacional-de-precos-ao-consumidor-amplo|2210;9258|Índice Nacional de Preços ao Consumidor|indice-nacional-de-precos-ao-consumidor|2077","editorias":"economicas","imagens":"{\"image_intro\":\"images\\/agenciadenoticias\\/releases\\/INPC_Release1.png\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"images\\/agenciadenoticias\\/releases\\/INPC_Release1.png\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}","produtos_relacionados":"9256, 9258","destaque":true,"link":"http://agenciadenoticias.ibge.gov.br/agencia-sala-de-imprensa/2013-agencia-de-noticias/releases/48246-ipca-fica-em-0-82-em-setembro.html"}]}