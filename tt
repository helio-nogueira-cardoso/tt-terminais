  --janela) exec tmux new-session -s "$(proximo_nome)" ;;
  -h | --help | ajuda) ajuda; exit 0 ;;
  # Opção que não existe: antes abria a central em silêncio (um erro de digitação parecia funcionar).
  -*) echo "tt: opção desconhecida: $1 (tt --help mostra as principais)" >&2; exit 2 ;;
