# Aprova (vira aberta, com as subtarefas) ou recusa (lápide) demandas pendentes. Imprime quantas mudaram.
tarefas_demanda_mudar_linhas() { # aprovar|recusar ID...
  local op=$1; shift
  [[ -f $CONF_TAREFAS ]] || { echo 0; return 1; }
  local now ids=" $* " n tmp
  now=$(hora_agora)
  tarefas_travar || return 1
  tmp=$(mktemp "$CONF_TAREFAS.XXXXXX")
  awk -F'\t' -v OFS='\t' -v op="$op" -v now="$now" -v ids="$ids" '
    function mv(m, k,   n, a, i) { n = split(m, a, "|"); for (i = 1; i <= n; i++) if (index(a[i], k "=") == 1) return substr(a[i], length(k) + 2); return "" }
    function limpa(m,   n, a, i, o) { n = split(m, a, "|"); o = ""; for (i = 1; i <= n; i++) if (a[i] !~ /^(sest|iest|rem|v2|colide|scod)=/) o = o (o == "" ? "" : "|") a[i]; return o }
    NR == FNR {
      if (NF >= 5 && $2 == "pendente") {
        p = mv($6, "pai")
        if (p == "" && index(ids, " " $1 " ")) alvo[$1] = 1
        if (p != "" && mv($6, "sest") != "f") naberta[p]++
      }
      next
    }
    NF >= 5 {
      if ($2 == "pendente" && (($1 in alvo) || (mv($6, "pai") in alvo))) {
        if (op == "aprovar") {
          # chega como estava na origem: [x] nas subtarefas e a tarefa concluída (se nada ficou aberto)
          if ($1 in alvo) novo = (mv($6, "iest") == "f" && !(naberta[$1] + 0)) ? "feita" : "aberta"
          else novo = (mv($6, "sest") == "f") ? "feita" : "aberta"
          $6 = limpa($6)
        } else novo = "removida"
        $2 = novo; $4 = now; if ($1 in alvo) n++
      }
      print
    }
    END { print n + 0 > "/dev/stderr" }' "$CONF_TAREFAS" "$CONF_TAREFAS" >"$tmp" 2>"$tmp.n"
  n=$(cat "$tmp.n" 2>/dev/null); rm -f "$tmp.n"
  mv "$tmp" "$CONF_TAREFAS"; marcar_tarefas
  tarefas_destravar
  atualizar_barras_pedir 2>/dev/null
  ("$EU" --tarefas-espelhar >/dev/null 2>&1 &)
  echo "${n:-0}"
}
# Aprovar uma proposta de atualização aplica-a na tarefa alvo e descarta a proposta; o resto segue o
# caminho normal (pendente -> aberta). Imprime quantas mudaram.
tarefas_demanda_mudar() { # aprovar|recusar [--recebida|--minha] ID...
  local op=$1 id n=0 k rc=0 padrao=""; shift
  while [[ ${1:-} == --* ]]; do
    case $1 in --recebida) padrao=inc ;; --minha) padrao=cur ;; *) break ;; esac
    shift
  done
  local -a props=() outros=() feitas=()
  for id in "$@"; do
    if [[ -n $(tarefas_meta_get "$(tarefas_meta_de "$id")" upd) && $(tarefas_estado_de "$id") == pendente ]]; then props+=("$id"); else outros+=("$id"); fi
  done
  if ((${#props[@]})); then
    if [[ $op == aprovar ]]; then
      for id in "${props[@]}"; do
        if tarefa_aplicar_proposta "$id" ${padrao:+--padrao "$padrao"}; then feitas+=("$id")
        else
          rc=4
          echo "⚡ $(tarefa_ref "$(tarefas_meta_get "$(tarefas_meta_de "$id")" upd)") tem conflitos: veja tt --demanda-diff $id; resolva com tt --demanda-merge $id ou aprove com --recebida / --minha" >&2
        fi
      done
    else feitas=("${props[@]}"); fi
    if ((${#feitas[@]})); then n=$(tarefas_demanda_mudar_linhas recusar "${feitas[@]}"); fi
  fi
  if ((${#outros[@]})); then
    k=$(tarefas_demanda_mudar_linhas "$op" "${outros[@]}"); n=$((n + k))
    # tarefa aprovada: a versão que chegou é a base do próximo confronto
    if [[ $op == aprovar ]]; then for id in "${outros[@]}"; do [[ $(tarefas_estado_de "$id") != pendente ]] && tarefa_base_gravar "$id"; done; fi
  fi
  echo "$n"
  return $rc
}
# Texto: demandas pendentes (id, remetente, título).
demandas_pendentes() {
  [[ -f $CONF_TAREFAS ]] || { echo "nenhuma demanda pendente"; return 0; }
  awk -F'\t' '
    function mv(m, k,   n, a, i) { n = split(m, a, "|"); for (i = 1; i <= n; i++) if (index(a[i], k "=") == 1) return substr(a[i], length(k) + 2); return "" }
    NF >= 5 && $2 == "pendente" && mv($6, "pai") == "" { print $1 "\t" (mv($6, "de") == "" ? "?" : mv($6, "de")) "\t" (mv($6, "upd") == "" ? "" : "[atualiza " mv($6, "upd") "] ") $5; n++ }
    END { if (!n) print "nenhuma demanda pendente" }' "$CONF_TAREFAS"
}
