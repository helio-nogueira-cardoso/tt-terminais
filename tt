# Menu das máquinas (clique no nome da máquina, na barra): escolher a máquina. Abre na hora com o que
# se soube de cada uma na última consulta (sessões, versão) e atualiza isso em segundo plano para
# o próximo clique. Arquivos, tmux e cadastro ficam em "Administrar" (menu_admin).
menu_maquinas() {
  local c=$1 p=${2:-} i n v vl marca info dest rot f
  vl=$(versao_num)
  atualizar_info >/dev/null 2>&1 &
  {
    n=$(tmux list-sessions -F '#{@ponte}' 2>/dev/null | grep -c '^$')
    printf '1\t● %-10s %s sessões\t%s\n' "$MAQUINA" "$n" "TT_X=0 $EU --seletor-em $(q "$c") $(q "$MAQUINA") $p"
    local -A SELO SELO_COR; fixadas_selos
    i=1
    while read -r dest rot; do
      i=$((i + 1))
      f=$(info_maquina "$rot")
      if [[ -s $f ]]; then read -r n v <"$f"; else n="…"; v=$vl; fi
      case $n in
        '?') info="sem resposta" ;;
        '…') info="consultando…" ;;
        *) info="$n sessões"; ((${v:-0} < vl)) && info+="  ⚠ v$v" ;;
      esac
      printf '%s\t%s %-10s %s\t%s\n' "$i" "$( [[ -n ${SELO[$rot]:-} ]] && printf '%*s%s' $((2 - ${#SELO[$rot]})) '' "$(selo_ansi "$rot")" || echo '  ')" "$rot" "$info" "TT_X=0 $EU --seletor-em $(q "$c") $(q "$rot") $p"
    done < <(maquinas)
    printf 't\t  Todas as máquinas\t%s\n' "$EU --seletor-em $(q "$c") todas $p"
    printf 'c\t  ☰ Central completa…\t%s\n' "$EU --clique tt $(q "$c") $p ''"
    printf -- '-\t\t\n'
    printf 'g\t  ⚙ Administrar (arquivos, tmux, cadastro)…\t%s\n' "$EU --menu-admin $(q "$c") $p"
  } | menu_popup "$c" "máquinas · tt v$vl"
}

# Administração das máquinas: arquivos, tmux, atualização e cadastro (botão direito em "máquina ▾",
# ou "Administrar" no menu das máquinas).
menu_admin() {
  local c=$1 p=${2:-} vl atras=0 rot f n v
  vl=$(versao_num)
  while read -r _ rot; do
    f=$(info_maquina "$rot")
    [[ -s $f ]] || continue
    read -r n v <"$f"
    [[ $n != '?' ]] && ((${v:-0} < vl)) && atras=1
  done < <(maquinas)
  {
    printf 'e\t  📤 Enviar arquivos…\t%s\n' "$(popup_tt "$c" "📤 enviar" "TT_CLIENTE=$c TT_PANE=$p $EU --enviar")"
    printf 'r\t  📥 Trazer arquivos…\t%s\n' "$(popup_tt "$c" "📥 trazer" "TT_CLIENTE=$c TT_PANE=$p $EU --trazer")"
    printf 'f\t  ⇅ Acompanhar as transferências…\t%s\n' "$(popup_tt "$c" "⇅ transferências" "$EU --transferencias")"
    printf 'o\t  📂 Abrir a pasta de recebidos\t%s\n' "$EU --abrir-pasta $(q "$(pasta_recebidos)") $(q "$c")"
    printf 'p\t  ⚙ Pasta padrão de recebidos desta máquina…\t%s\n' "$(popup_tt "$c" "pasta padrão" "TT_CLIENTE=$c TT_PANE=$p $EU --pasta-padrao; read -rsn1 -p '(tecla fecha)'")"
    printf 'm\t  ⚙ tmux…\t%s\n' "$EU --menu-tmux $(q "$c") $p"
    printf -- '-\t\t\n'
    printf 'c\t  📧 Contas de e-mail…\t%s\n' "$EU --email-contas $(q "$c")"
    printf -- '-\t\t\n'
    ((atras)) && printf 'u\t  ⟳ Atualizar as desatualizadas (v%s)\t%s\n' "$vl" "$(popup_tt "$c" sincronizar "$EU --sincronizar; read -rsn1 -p '(tecla fecha)'")"
    (($(versao_github) > vl)) && printf 'g\t  ⟳ Atualizar do GitHub (v%s → v%s)\t%s\n' "$vl" "$(versao_github)" "$(popup_tt "$c" "atualizar do GitHub" "$EU --atualizar --todas; read -rsn1 -p '(tecla fecha)'")"
    printf 'a\t  ＋ Cadastrar máquina…\t%s\n' "$(popup_tt "$c" "cadastrar máquina" "$EU --cadastrar; read -rsn1 -p '(tecla fecha)'")"
    printf 'd\t  − Descadastrar máquina…\t%s\n' "$(popup_tt "$c" "descadastrar máquina" "$EU --descadastrar; read -rsn1 -p '(tecla fecha)'")"
    printf 'h\t  ◌ Ocultar máquina…\t%s\n' "$(popup_tt "$c" "ocultar máquina" "$EU --ocultar-maquina; read -rsn1 -p '(tecla fecha)'")"
    printf 'H\t  ◉ Mostrar máquina oculta…\t%s\n' "$(popup_tt "$c" "mostrar máquina" "$EU --mostrar-maquina; read -rsn1 -p '(tecla fecha)'")"
  } | menu_popup "$c" "administrar · tt v$vl"
}

# Cria uma sessão nova e leva este terminal para ela.
nova_e_ir() {
  local nome
  nome=$("$EU" --nova) && tmux switch-client -c "$1" -t "=$nome"
}

# Menu da sessão atual (botão direito em "sessão ▾"): trocar, criar, renomear, dividir e fechar.
menu_sessao() {
