  chmod +x "$DIR_TT/voz" "$DIR_TT/voz-audio.py" 2>/dev/null
  e_mobile && return 0
  [[ -f $DIR_TT/voz ]] || return 0
  [[ -e $HOME/.local/bin/voz && ! -L $HOME/.local/bin/voz ]] && return 0
  ln -sfn "$DIR_TT/voz" "$HOME/.local/bin/voz"
}

# Seletor e rotator de contas de IA (ia-conta/ia-rot, com os nomes antigos claude-conta/claude-rot
# como apelidos) em ~/.local/bin, e a skill rodizio-de-contas para o Claude, o Codex e o Kiro que
# existirem aqui. Um claude-conta/claude-rot escrito à mão (que não é uma versão deste) fica intacto;
# uma versão antiga deste vai para <nome>.antes-tt. No Termux os agentes rodam dentro do proot: nada.
instalar_contas_ia() {
  if e_mobile; then instalar_contas_ia_proot; return 0; fi
  local n src alvo casa skill
  [[ -f $DIR_TT/ia-conta && -f $DIR_TT/ia-rot ]] || return 0
  chmod +x "$DIR_TT/ia-conta" "$DIR_TT/ia-rot" "$DIR_TT/ia-login" "$DIR_TT/contas-uso.py" 2>/dev/null
  mkdir -p "$HOME/.local/bin" "$ESTADO_DIR/passagens"
  [[ -f $DIR_TT/ia-login ]] && ln -sfn "$DIR_TT/ia-login" "$HOME/.local/bin/ia-login"
  for n in ia-conta claude-conta ia-rot claude-rot; do
    case $n in *conta) src=$DIR_TT/ia-conta ;; *) src=$DIR_TT/ia-rot ;; esac
    alvo=$HOME/.local/bin/$n
    if [[ -f $alvo && ! -L $alvo ]]; then
      if grep -qE '^# (claude-conta|claude-rot) —' "$alvo"; then
        [[ -e $alvo.antes-tt ]] || cp -p "$alvo" "$alvo.antes-tt"
      else
        echo "$(conf nome): ⚠ $alvo não é do tt; mantido (o tt instalou ${src##*/})" >&2
        continue
      fi
    fi
    ln -sfn "$src" "$alvo"
  done
  for casa in "$HOME/.claude" "${CODEX_HOME:-$HOME/.codex}" "${KIRO_HOME:-$HOME/.kiro}"; do
    [[ -d $casa ]] || continue
    skill=$casa/skills/rodizio-de-contas
    cmp -s "$DIR_TT/skill-rodizio-de-contas.md" "$skill/SKILL.md" && continue
    mkdir -p "$skill" && cp "$DIR_TT/skill-rodizio-de-contas.md" "$skill/SKILL.md"
  done
  instalar_ferramentas_agentes "$HOME" "$DIR_TT" "$HOME/.claude" "${CODEX_HOME:-$HOME/.codex}" "${KIRO_HOME:-$HOME/.kiro}"
  return 0
}

# Ferramentas e referência para os agentes de IA: o aidlc-tt (perguntas do AI-DLC respondidas na
# descrição de uma tarefa) em ~/.local/bin e as skills tt-terminais (verbos do tt, como avisar o
# usuário com tt --notificar-daqui) e celular-android (operar um Android do tt: Termux, proot, adb
# local, Shizuku, Tasker, tela) nos agentes que existirem. Um aidlc-tt que não é link fica.
instalar_ferramentas_agentes() { # casa pasta-do-pacote-vista-de-lá agente...
  local casa=$1 fonte=$2 ag sk alvo=$1/.local/bin/aidlc-tt
  shift 2
  if [[ -f $DIR_TT/aidlc-tt ]]; then
    chmod +x "$casa/.local/share/tt/aidlc-tt" 2>/dev/null
    mkdir -p "$casa/.local/bin"
    [[ -e $alvo && ! -L $alvo ]] || ln -sfn "$fonte/aidlc-tt" "$alvo"
  fi
  for sk in tt-terminais celular-android; do
    [[ -f $DIR_TT/skill-$sk.md ]] || continue
    for ag in "$@"; do
      [[ -d $ag ]] || continue
      cmp -s "$DIR_TT/skill-$sk.md" "$ag/skills/$sk/SKILL.md" && continue
      mkdir -p "$ag/skills/$sk" && cp "$DIR_TT/skill-$sk.md" "$ag/skills/$sk/SKILL.md"
    done
  done
  instalar_regras_agentes "$casa" "$@"
  return 0
}

# AGENTS.md único: $casa/.agents/AGENTS.md é a fonte das instruções globais de TODAS as IAs — o que o
# usuário escreve e, entre marcadores, o bloco de regras do tt (agentes-regras-tt.md). Normalizador
# sempre reforçado (instalação e cada volta do vigia), sem exceção:
#  - Claude (~/.claude e cada perfil do ia-conta) e Codex: CLAUDE.md / AGENTS.md são link RELATIVO para a
#    fonte (vale também visto de dentro do proot). O Claude deduplica pelo arquivo real: o perfil, que
#    enxerga ~/.claude/CLAUDE.md como CLAUDE.md de projeto do $HOME, não o carrega duas vezes.
#  - Kiro: cópia gerada em steering/agentes.md (inclusion: always; steering por link é ignorado).
#  - Texto escrito à mão num desses arquivos, fora do bloco do tt, vai para a fonte (só os parágrafos
#    novos: nem na fonte nem no retrato dela da volta anterior, para o que o usuário apagou não voltar
#    de uma cópia velha; cópia em ~/.local/state/tt/agentes-backup) e o link ou a cópia voltam.
#  - Claude: AGENTS.md de projeto lido mesmo onde há CLAUDE.md (instructionFiles=claude-md-and-agents-md).
#  - Travas do Claude (<perfil>.lock) paradas há mais de 10 min são apagadas (viva, é renovada a cada
#    poucos segundos); só pasta com nome de perfil recebe instruções. Só entra em IA que já existe.
# Chamado pela instalação (toda atualização) e pelo vigia (a cada volta de reforço): ver reforcar_agentes.
instalar_regras_agentes() { # casa agente...
  local casa=$1 ag p fonte=$DIR_TT/agentes-regras-tt.md canon real
  shift
  [[ -f $fonte ]] || return 0
  canon=$casa/.agents/AGENTS.md
  mkdir -p "$casa/.agents" 2>/dev/null || return 0
  [[ -e $canon || -L $canon ]] || : >"$canon"
  real=$(readlink -f "$canon") || return 0 # fonte que já é link (dotfiles): grava no destino
  for p in "$casa/.local/share/claude-contas"/*.lock; do
    [[ -d $p && -n $(find "$p" -maxdepth 0 -mmin +10 2>/dev/null) ]] && rm -rf "$p"
  done
  for ag in "$@"; do
    [[ -d $ag ]] || continue
    case $ag in
      */.kiro) ;;
      */.codex)
        agentes_ligar "$canon" "$real" "$ag/AGENTS.md" "$casa"
        # O override esconderia a fonte do Codex: o texto dele vai para a fonte.
        [[ -f $ag/AGENTS.override.md ]] && agentes_absorver "$real" "$ag/AGENTS.override.md" "$casa" && rm -f "$ag/AGENTS.override.md" ;;
      *)
        agentes_ligar "$canon" "$real" "$ag/CLAUDE.md" "$casa"
        agentes_claude_instrucoes "$ag/settings.json" ;;
    esac
  done
  for p in "$casa/.local/share/claude-contas"/*/; do
    p=${p%/}
    [[ ${p##*/} =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]] || continue # travas e pastas auxiliares não são perfis
    agentes_ligar "$canon" "$real" "$p/CLAUDE.md" "$casa"
    # Perfil sem settings.json ganharia um próprio e deixaria de compartilhar o de ~/.claude.
    [[ -e $p/settings.json ]] && agentes_claude_instrucoes "$p/settings.json"
  done
  regras_bloco_gravar "$real" "$fonte"
  for ag in "$@"; do
    [[ $ag == */.kiro && -d $ag ]] && agentes_kiro "$real" "$ag/steering" "$casa"
  done
  p=$casa/.local/state/tt/agentes-fonte.anterior
  cmp -s "$real" "$p" || { mkdir -p "${p%/*}" && cp "$real" "$p"; }
  return 0
}
caminho_relativo() { # de-pasta para — caminhos absolutos, sem . nem ..
  local base=${1%/} alvo=$2 sobe=
  while [[ -n $base && $alvo != "$base"/* ]]; do base=${base%/*}; sobe+=../; done
  printf '%s%s' "$sobe" "${alvo#"$base"/}"
}
agentes_ligar() { # fonte fonte-real arquivo casa — o arquivo vira link relativo para a fonte
  local canon=$1 real=$2 arq=$3 casa=$4 dir=${3%/*} tmp
  [[ -d $arq && ! -L $arq ]] && return 0
  if [[ -L $arq && $(readlink -f "$arq") == "$real" ]]; then return 0; fi
  [[ -f $arq ]] && agentes_absorver "$real" "$arq" "$casa" "$dir"
  tmp=$arq.tt-$$
  ln -s "$(caminho_relativo "$dir" "$canon")" "$tmp" 2>/dev/null || return 0
  [[ -L $arq ]] && rm -f "$arq" # link para pasta: o mv entraria nela
  mv -f "$tmp" "$arq"
}
# Leva para a fonte os parágrafos de fora do bloco do tt que ela ainda não tem (antes do bloco). Um
# "@caminho" relativo (import do Claude) passa a apontar para a pasta de onde veio.
agentes_absorver() { # fonte-real arquivo casa [pasta-dos-imports] [front-matter: 1]
  local real=$1 arq=$2 casa=$3 base=${4:-} fm=${5:-} novos tmp bkp
  [[ -n $base && $base == "$casa"/* ]] && base="~/${base#"$casa"/}"
  novos=$(awk -v base="$base" -v fm="$fm" '
    NR == 1 && fm && /^---[ \t]*$/ { emfm = 1; next }
    emfm { if (/^---[ \t]*$/) emfm = 0; next }
    /<!-- tt-managed:regras-tt BEGIN/ { pula = 1; next }
    pula { if (/<!-- tt-managed:regras-tt END -->/) pula = 0; next }
    /^<!-- tt-gerado:agentes / { next }
    base != "" && /^@[^\/~[:space:]][^[:space:]]*$/ { sub(/^@/, "@" base "/") }
    { print }' "$arq" | awk -v fonte="$real" -v antes="$casa/.local/state/tt/agentes-fonte.anterior" '
    function limpa(s) { sub(/[ \t\r]+$/, "", s); return s }
    function fecha() { if (p != "" && !(p in tem)) { out = out (out == "" ? "" : "\n\n") p; tem[p] = 1 } p = "" }
    function conhece(arq,  l, q) {
      while ((getline l < arq) > 0) { l = limpa(l); if (l == "") { if (q != "") tem[q] = 1; q = "" } else q = (q == "" ? l : q "\n" l) }
      if (q != "") tem[q] = 1
    }
    BEGIN { conhece(fonte); conhece(antes) }
    { l = limpa($0); if (l == "") fecha(); else p = (p == "" ? l : p "\n" l) }
    END { fecha(); printf "%s", out }')
  [[ -n $novos ]] || return 0
  bkp=$casa/.local/state/tt/agentes-backup
  mkdir -p "$bkp" && cp -L "$arq" "$bkp/$(printf '%s' "${arq#"$casa"/}" | tr / %).$(date +%Y%m%dT%H%M%S)" 2>/dev/null
  tmp=$(mktemp "$real.XXXXXX") || return 1
  NOVOS=$novos awk '
    /<!-- tt-managed:regras-tt BEGIN/ && !feito { print ENVIRON["NOVOS"]; print ""; feito = 1 }
    { print }
    END { if (!feito) { if (NR) print ""; print ENVIRON["NOVOS"] } }' "$real" >"$tmp"
  chmod --reference="$real" "$tmp" 2>/dev/null || chmod 644 "$tmp"
  mv -f "$tmp" "$real"
}
# Kiro: steering/agentes.md é cópia gerada da fonte; a soma no cabeçalho denuncia edição feita na cópia,
# que então vai para a fonte antes de regravar. O steering/tt-terminais.md antigo entrega o texto e sai.
agentes_kiro() { # fonte-real pasta-steering casa
  local real=$1 st=$2 casa=$3 arq=$2/agentes.md soma tmp
  mkdir -p "$st" 2>/dev/null || return 0
  if [[ -f $st/tt-terminais.md ]]; then agentes_absorver "$real" "$st/tt-terminais.md" "$casa" "" 1 && rm -f "$st/tt-terminais.md"; fi
  if [[ -f $arq ]]; then
    soma=$(sed -n 's/^<!-- tt-gerado:agentes .* soma:\([0-9-]*\) -->$/\1/p' "$arq" | head -n 1)
    [[ $soma == "$(sed '1,/^<!-- tt-gerado:agentes /d' "$arq" | cksum | tr ' ' -)" ]] || agentes_absorver "$real" "$arq" "$casa" "" 1
  fi
  tmp=$(mktemp "$arq.XXXXXX") || return 0
  printf -- '---\ninclusion: always\n---\n<!-- tt-gerado:agentes cópia de ~/.agents/AGENTS.md: edite lá, o tt regrava esta · soma:%s -->\n' \
    "$(cksum <"$real" | tr ' ' -)" >"$tmp"
  cat "$real" >>"$tmp"
  if cmp -s "$tmp" "$arq"; then rm -f "$tmp"; else chmod 644 "$tmp"; mv -f "$tmp" "$arq"; fi
}
# Claude: AGENTS.md de projeto entra também onde há CLAUDE.md. Os dois nomes do plugin embutido (o antigo
# vale até a 2.1.284). JSON inválido fica como está.
agentes_claude_instrucoes() { # settings.json
  local arq
  arq=$(readlink -f "$1" 2>/dev/null) || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$arq" <<'PY' 2>/dev/null || true
import json, os, sys, tempfile
arq = sys.argv[1]
try:
    with open(arq, encoding="utf-8") as f:
        dados = json.load(f)
except FileNotFoundError:
    dados = {}
if not isinstance(dados, dict):
    sys.exit(0)
antes = json.dumps(dados, sort_keys=True)
pc = dados.setdefault("pluginConfigs", {})
if not isinstance(pc, dict):
    sys.exit(0)
for nome in ("cc-plugin-agents-md@builtin", "agents-md@builtin"):
    ent = pc.setdefault(nome, {})
    if not isinstance(ent, dict):
        ent = pc[nome] = {}
    op = ent.setdefault("options", {})
    if not isinstance(op, dict):
        op = ent["options"] = {}
    op["instructionFiles"] = "claude-md-and-agents-md"
if json.dumps(dados, sort_keys=True) == antes:
    sys.exit(0)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(arq), prefix=".settings.")
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(dados, f, indent=2, ensure_ascii=False)
    f.write("\n")
try:
    os.chmod(tmp, os.stat(arq).st_mode & 0o777)
except FileNotFoundError:
    os.chmod(tmp, 0o600)
os.replace(tmp, arq)
PY
}
regras_bloco_gravar() { # arquivo fonte [prefixo-se-criar]
  local dest=$1 fonte=$2 pref=${3:-} ini='<!-- tt-managed:regras-tt BEGIN (o tt reescreve este bloco; edite fora dele) -->' fim='<!-- tt-managed:regras-tt END -->' tmp
  tmp=$(mktemp "${dest}.XXXXXX" 2>/dev/null) || return 0
  if [[ -s $dest ]] && grep -qF '<!-- tt-managed:regras-tt BEGIN' "$dest"; then
    awk -v ini="$ini" -v fim="$fim" -v fonte="$fonte" '
      /<!-- tt-managed:regras-tt BEGIN/ { if (!feito) { print ini; while ((getline l < fonte) > 0) print l; print fim; feito = 1 } pula = 1; next }
      pula && /<!-- tt-managed:regras-tt END -->/ { pula = 0; next }
      !pula { print }' "$dest" >"$tmp"
  else
    { [[ -s $dest ]] && { cat "$dest"; printf '\n'; } || printf '%s' "$pref"
      printf '%s\n' "$ini"; cat "$fonte"; printf '%s\n' "$fim"; } >"$tmp"
  fi
  if cmp -s "$tmp" "$dest" 2>/dev/null; then rm -f "$tmp"; else chmod --reference="$dest" "$tmp" 2>/dev/null || chmod 644 "$tmp"; mv -f "$tmp" "$dest"; fi
  return 0
}

# Reforço do vigia (a cada ~5 min, junto de --reforcar-padrao) e da instalação: skill tt-terminais, regras
# globais e aidlc-tt em TODAS as IAs desta máquina, inclusive as de dentro dos proots do celular. Barato
# (compara antes de gravar); uma IA nova que aparecer é coberta na volta seguinte.
reforcar_agentes() {
  local base=${PREFIX:-/nonexistent}/var/lib/proot-distro raiz r
  [[ -f $DIR_TT/skill-tt-terminais.md ]] || return 0
  instalar_ferramentas_agentes "$HOME" "$DIR_TT" "$HOME/.claude" "${CODEX_HOME:-$HOME/.codex}" "${KIRO_HOME:-$HOME/.kiro}"
  for raiz in "$base"/containers/*/rootfs "$base"/installed-rootfs/*; do
    r=$raiz/root
    [[ -d $r/.local/share/tt ]] || continue
    for f in skill-tt-terminais.md agentes-regras-tt.md aidlc-tt; do [[ -f $DIR_TT/$f ]] && cp -f "$DIR_TT/$f" "$r/.local/share/tt/$f" 2>/dev/null; done
    instalar_ferramentas_agentes "$r" /root/.local/share/tt "$r/.claude" "$r/.codex" "$r/.kiro"
  done
  return 0
}

# No celular os agentes rodam dentro do proot-distro. O Termux ganha só o ia-login (que pergunta ao
# proot); dentro de cada proot onde já existe /root/.local/share/tt (quem quis ter as contas de IA lá),
# o pacote é espelhado e ganham os links ia-conta/ia-rot/ia-login (+ claude-conta/claude-rot), a skill
# e o link para o cadastro comum do Termux. Um proot sem essa pasta não é tocado.
instalar_contas_ia_proot() {
  local base=${PREFIX:-/nonexistent}/var/lib/proot-distro raiz r n src alvo casa f
  if [[ -f $DIR_TT/ia-login ]]; then
    mkdir -p "$HOME/.local/bin"; chmod +x "$DIR_TT/ia-login"
    [[ -e $HOME/.local/bin/ia-login && ! -L $HOME/.local/bin/ia-login ]] || ln -sfn "$DIR_TT/ia-login" "$HOME/.local/bin/ia-login"
  fi
  for raiz in "$base"/containers/*/rootfs "$base"/installed-rootfs/*; do
    r=$raiz/root
    [[ -d $r/.local/share/tt ]] || continue
    for f in "${ARQUIVOS_PACOTE[@]}"; do [[ -f $DIR_TT/$f ]] && cp -f "$DIR_TT/$f" "$r/.local/share/tt/$f"; done
    chmod +x "$r/.local/share/tt/"{tt,ia-conta,ia-rot,ia-login,contas-uso.py} 2>/dev/null
    mkdir -p "$r/.local/bin"
    for n in ia-conta claude-conta ia-rot claude-rot ia-login; do
      case $n in *conta) src=ia-conta ;; *rot) src=ia-rot ;; *) src=ia-login ;; esac
      alvo=$r/.local/bin/$n
      if [[ -f $alvo && ! -L $alvo ]]; then
        grep -qE '^# (claude-conta|claude-rot) —' "$alvo" || continue # script alheio: fica
        [[ -e $alvo.antes-tt ]] || cp -p "$alvo" "$alvo.antes-tt"
      fi
      ln -sfn "/root/.local/share/tt/$src" "$alvo"
    done
    for casa in "$r/.claude" "$r/.codex" "$r/.kiro"; do
      [[ -d $casa ]] || continue
      cmp -s "$DIR_TT/skill-rodizio-de-contas.md" "$casa/skills/rodizio-de-contas/SKILL.md" && continue
      mkdir -p "$casa/skills/rodizio-de-contas" && cp "$DIR_TT/skill-rodizio-de-contas.md" "$casa/skills/rodizio-de-contas/SKILL.md"
    done
    instalar_ferramentas_agentes "$r" /root/.local/share/tt "$r/.claude" "$r/.codex" "$r/.kiro"
    mkdir -p "$r/.config/tt"
    [[ -e $r/.config/tt/contas-ia || -L $r/.config/tt/contas-ia ]] || ln -s "$CONF_CONTAS_IA" "$r/.config/tt/contas-ia"
  done
  return 0
}

# Envia o pacote para DEST e instala lá. Imprime "rótulo: versão".
instalar_em() {
  local dest=$1 nome=${2:-}
  if [[ $dest == . ]]; then
    local tmp; tmp=$(mktemp -d)
    pacote | tar -C "$tmp" -xf - && TT_NOME=$nome "$tmp/tt" --instalar-aqui
    local st=$?
    rm -rf "$tmp"
    return $st
  else
    aquecer_rota "${dest#*@}"  # sobe a rota direta antes do envio pesado (evita travar no relay)
    pacote | ssh "${SSH_OPC[@]}" "$dest" "$PATH_REMOTO rm -rf ~/.cache/tt-pacote && mkdir -p ~/.cache/tt-pacote && tar -C ~/.cache/tt-pacote -xf - && TT_NOME=$(q "$nome") ~/.cache/tt-pacote/tt --instalar-aqui; rm -rf ~/.cache/tt-pacote"
  fi
}

# --- Atualização pelo GitHub -----------------------------------------------
#
# A versão publicada fica num clone em ~/.local/share/tt-fonte (o repositório oficial, ou o de
# "fonte=" no config). `tt --atualizar` instala de lá se for mais nova; o vigia sonda a cada 5 min (git ls-remote)
# e avisa uma vez quando sai versão nova (e o menu de máquinas oferece atualizar).

URL_FONTE_PADRAO='https://github.com/helio-nogueira-cardoso/tt-terminais.git'
DIR_FONTE=$HOME/.local/share/tt-fonte
CACHE_GITHUB="$HOME/.cache/tt-github-versao"

url_fonte() { local u; u=$(conf fonte); echo "${u:-$URL_FONTE_PADRAO}"; }

# Traz a versão publicada para o clone local. Imprime o número da versão (nº de commits).
buscar_fonte() {
  command -v git >/dev/null || { echo "precisa do git" >&2; return 1; }
  if [[ ! -e $DIR_FONTE/.git ]]; then
    rm -rf "$DIR_FONTE"
    git clone -q "$(url_fonte)" "$DIR_FONTE" 2>/dev/null || return 1
  else
    git -C "$DIR_FONTE" remote set-url origin "$(url_fonte)"
    git -C "$DIR_FONTE" fetch -q origin 2>/dev/null || return 1
    git -C "$DIR_FONTE" reset -q --hard origin/HEAD 2>/dev/null || git -C "$DIR_FONTE" reset -q --hard origin/main
  fi
  git -C "$DIR_FONTE" rev-list --count HEAD
}
# Rótulo MAIOR.MENOR.PATCH do que está publicado (no clone da fonte, já atualizado por buscar_fonte).
rotulo_fonte() { versao_marco_git "$DIR_FONTE" 2>/dev/null; }

# Consulta (sem instalar) e guarda "N data" em cache; o vigia chama isto a cada 12 h.
verificar_atualizacao() {
  local n
  n=$(buscar_fonte) || return 1
  mkdir -p "$(dirname "$CACHE_GITHUB")"
  echo "$n $(date +%s) $(rotulo_fonte)" >"$CACHE_GITHUB"
  # Qual versão já foi avisada é estado, não escolha do usuário: fica em $ESTADO_DIR/avisado.
  if ((n > $(versao_num))) && [[ $(cat "$ESTADO_DIR/avisado" 2>/dev/null) != "$n" ]]; then
    avisar "⟳ tt: versão $(versao_rotulo "$n" "$(rotulo_fonte)") disponível no GitHub (esta é a $(versao_humana)) — menu de máquinas → Atualizar"
    mkdir -p "$ESTADO_DIR" && echo "$n" >"$ESTADO_DIR/avisado"
  fi
}

# Instala a publicação se (e só se) for mais nova. Ignora REPO_TT de propósito: em uma máquina de
# desenvolvimento ele pode apontar para um clone local, enquanto o vigia deve obedecer à fonte
# publicada. Falha de rede é transitória; o próximo ciclo tentará de novo.
garantir_atualizacao() {
  local n atual antes repo_anterior pub h rel
  command -v git >/dev/null || { atu_falha git "esta máquina não tem o git: não há como buscar a versão publicada"; return 1; }
  n=$(buscar_fonte) || { atu_falha rede "o git fetch de $(url_fonte) falhou (sem rede, proxy ou firewall bloqueando o GitHub?)"; return 1; }
  mkdir -p "$(dirname "$CACHE_GITHUB")"
  echo "$n $(date +%s) $(rotulo_fonte)" >"$CACHE_GITHUB"
  atual=$(versao_num); antes=$(versao_humana) # o rótulo de antes: depois do instalar_em, o VERSAO já é o novo
  pub=$(git -C "$DIR_FONTE" rev-parse HEAD 2>/dev/null)
  h=$(versao_hash_instalado)
  # Quem decide é a ancestralidade, não só o nº de commits: publicado que CONTÉM o instalado é mais novo;
  # instalado que contém o publicado é uma máquina de desenvolvimento à frente; nenhum contém o outro é
  # divergência (aí só a contagem maior autoriza, como sempre, e o pode_instalar barra o rebaixamento).
  rel=$(atu_relacao "$h" "$pub")
  case $rel in
    igual) atu_ok "$pub:$h"; return 0 ;;
    frente) atu_ok "$pub:$h" "esta máquina está à frente do publicado (versão de desenvolvimento)"; return 0 ;;
    atras) ;;
    *) ((n > atual)) || { atu_ok "$pub:$h" "a versão instalada ($h) não está no publicado e tem número maior: não rebaixei (tt --atualizar decide)"; return 0; } ;;
  esac
  repo_anterior=$REPO_TT
  REPO_TT=$DIR_FONTE
  instalar_em . || { REPO_TT=$repo_anterior; atu_falha pacote "a instalação da versão publicada falhou (detalhes em ~/.cache/tt-vigia.log)"; return 1; }
  REPO_TT=$repo_anterior
  atu_ok "$pub:$(versao_hash_instalado)"
  echo "$(date '+%F %T') vigia: tt atualizado de $antes (build $atual) para $(versao_rotulo "$n" "$(rotulo_fonte)") (build $n)"
}

# --- Estado da atualização: $ESTADO_DIR/atualizacao (chave=valor) ------------------------------------
# sonda_em/publicado (última sonda e o SHA visto), decidido (SHA já resolvido: nada a buscar de novo),
# falhas/motivo/erro/erro_desde (falhas seguidas), obs (situação), avisado (a falha já virou aviso).
ATU_ARQ="$ESTADO_DIR/atualizacao"
atu_get() { awk -v k="$1" 'index($0, k "=") == 1 { v = substr($0, length(k) + 2) } END { print v }' "$ATU_ARQ" 2>/dev/null; }
atu_set() { # chave=valor…
  local tmp k re=""
  mkdir -p "$ESTADO_DIR"; tmp=$(mktemp "$ATU_ARQ.XXXXXX" 2>/dev/null) || return 0
  for k in "$@"; do re+="${re:+|}${k%%=*}"; done
  { [[ -f $ATU_ARQ ]] && grep -v -E "^($re)=" "$ATU_ARQ"; printf '%s\n' "$@"; } >"$tmp" && mv -f "$tmp" "$ATU_ARQ"
}
versao_hash_instalado() { local h=""; read -r _ h _ 2>/dev/null <"$DIR_TT/VERSAO"; printf '%s' "${h%+dev}"; }
atu_relacao() { # hash-instalado sha-publicado (no clone da fonte) -> igual|atras|frente|divergente|desconhecida
  local h=$1 pub=$2 full
  [[ -n $h && -n $pub ]] || { echo desconhecida; return; }
  full=$(git -C "$DIR_FONTE" rev-parse -q --verify "$h^{commit}" 2>/dev/null) || { echo desconhecida; return; }
  if [[ $full == "$pub" ]]; then echo igual
  elif git -C "$DIR_FONTE" merge-base --is-ancestor "$full" "$pub" 2>/dev/null; then echo atras
  elif git -C "$DIR_FONTE" merge-base --is-ancestor "$pub" "$full" 2>/dev/null; then echo frente
  else echo divergente; fi
}
atu_ok() { # publicado:instalado [observação]
  local agora; printf -v agora '%(%s)T' -1
  atu_set "decidido=${1:-}" "falhas=0" "motivo=" "erro=" "erro_desde=" "avisado=" "obs=${2:-}" "ok_em=$agora"
}
# Falha seguida: conta e, na 3ª, avisa uma vez (🔔) com o motivo — antes a falha ficava só no log do vigia
# e ninguém sabia por que a máquina não atualizava.
atu_falha() { # motivo texto
  local agora f; printf -v agora '%(%s)T' -1
  f=$(( $(atu_get falhas || echo 0) + 0 + 1 ))
  atu_set "falhas=$f" "motivo=$1" "erro=$2" "erro_desde=$(v=$(atu_get erro_desde); echo "${v:-$agora}")"
  echo "$(date '+%F %T') atualização: falhou ($1): $2" >&2
  if ((f >= 3)) && [[ -z $(atu_get avisado) ]]; then
    atu_set "avisado=$agora"
    notificar "⚠ tt não consegue se atualizar: $2 — tt --atualizacao-estado" 86400 2>/dev/null || true
  fi
  return 1
}

# tt --sondar-atualizacao (vigia, a cada TT_T_SONDA): pergunta só o SHA publicado. Igual ao instalado, ou
# já resolvido antes (máquina à frente, divergência que não rebaixa): nada. Mudou: busca e instala.
atualizacao_sondar() {
  local sha agora h
  command -v git >/dev/null || { atu_falha git "esta máquina não tem o git: não há como buscar a versão publicada"; return 1; }
  printf -v agora '%(%s)T' -1
  sha=$(GIT_TERMINAL_PROMPT=0 timeout 20 git ls-remote "$(url_fonte)" HEAD 2>/dev/null | awk 'NR == 1 { print $1 }')
  [[ -n $sha ]] || { atu_falha rede "não consegui consultar $(url_fonte) (sem rede, proxy ou firewall bloqueando o GitHub?)"; return 1; }
  atu_set "sonda_em=$agora" "publicado=$sha"
  h=$(versao_hash_instalado)
  if [[ -n $h && $sha == "$h"* ]]; then atu_ok "$sha:$h"; return 0; fi
  # Já resolvido para ESTE par publicado:instalado (à frente, divergência que não rebaixa): não busca de novo.
  [[ "$sha:$h" == "$(atu_get decidido)" && $(atu_get falhas) == 0 ]] && return 0
  garantir_atualizacao
}

# tt --atualizacao-estado: por que esta máquina está (ou não) na versão publicada.
atualizacao_estado() {
  local agora sonda pub h dec f obs vivo fonte
  printf -v agora '%(%s)T' -1
  sonda=$(atu_get sonda_em); pub=$(atu_get publicado); h=$(versao_hash_instalado); f=$(atu_get falhas); obs=$(atu_get obs)
  fonte=$(conf fonte)
  vivo="não (o vigia vive no tmux do tt: sem ele, nada se atualiza sozinho)"
  [[ -r $RT/tt-vigia-$UID.pid ]] && kill -0 "$(cat "$RT/tt-vigia-$UID.pid" 2>/dev/null)" 2>/dev/null && vivo="sim"
  echo "Atualização do tt nesta máquina ($MAQUINA)"
  printf '  instalada:     %s (%s, build %s)\n' "$(versao_humana)" "${h:--}" "$(versao_num)"
  if [[ -n $pub ]]; then printf '  publicada:     %s\n' "${pub:0:7}"; else echo "  publicada:     (ainda não consultada)"; fi
  printf '  fonte:         %s%s\n' "$(url_fonte)" "${fonte:+  (fonte= do config: não é o repositório oficial)}"
  printf '  vigia ativo:   %s\n' "$vivo"
  if [[ -n $sonda ]]; then printf '  última sonda:  há %s min (a cada %s min)\n' $(( (agora - sonda) / 60 )) $(( ${TT_T_SONDA:-$([[ ${PREFIX:-} == *com.termux* ]] && echo 900 || echo 300)} / 60 ))
  else echo "  última sonda:  nunca"; fi
  if ((${f:-0} > 0)); then
    printf '  situação:      ✗ falhando há %s min (%s falha(s) seguida(s)) — %s\n' $(( (agora - $(atu_get erro_desde)) / 60 )) "$f" "$(atu_get erro)"
  elif [[ -n $pub && -n $h && $pub == "$h"* ]]; then echo "  situação:      ✓ em dia"
  elif [[ -n $obs ]]; then echo "  situação:      · $obs"
  elif [[ -n $pub ]]; then echo "  situação:      ⟳ há versão nova; instala na próxima sonda (ou agora: tt --atualizar)"
  else echo "  situação:      ? sem consulta ainda (tt --atualizar consulta agora)"; fi
}
versao_github() { awk '{ print $1 + 0 }' "$CACHE_GITHUB" 2>/dev/null || echo 0; }
versao_github_rotulo() { versao_rotulo "$(versao_github)" "$(awk '{ print $3 }' "$CACHE_GITHUB" 2>/dev/null)"; }

# tt --atualizar [--todas]: instala a versão mais nova do GitHub aqui (e nas cadastradas, com --todas).
atualizar() {
  local todas=${1:-} n
  if [[ -e $REPO_TT/.git ]]; then
    echo "Esta máquina é a de desenvolvimento ($REPO_TT): alinhando com o publicado…"
    repo_atualizar "$REPO_TT" || return 1
  else
    printf 'Buscando a versão publicada (%s)… ' "$(url_fonte)"
    n=$(buscar_fonte) || { echo "falhou (sem rede ou sem git?)."; return 1; }
    echo "$(versao_rotulo "$n" "$(rotulo_fonte)")"
    echo "$n $(date +%s) $(rotulo_fonte)" >"$CACHE_GITHUB"
    if ((n <= $(versao_num))) && [[ -z $todas ]]; then echo "Já está na mais nova ($(versao_humana))."; return 0; fi
    REPO_TT=$DIR_FONTE
  fi
  if [[ -n $todas ]]; then sincronizar
  else printf '  %-10s ' "$MAQUINA"; instalar_em . | sed 's/^[^:]*: //'; fi
}

# Máquina de desenvolvimento: traz o publicado para o clone sem perder commit local. Só atrás: avança. À
# frente: nada. Divergiu: guarda os commits num ramo local/<data>, reaplica-os sobre o publicado (rebase)
# e, se der conflito, desiste do rebase e deixa o clone no publicado — os commits ficam no ramo. Nunca usa
# stash (a pilha é de todos os clones e agentes) nem descarta o que não foi gravado: arquivo versionado
# mudado e não gravado faz recusar, com a lista (tt --repo-checar explica). Antes, um `git pull --ff-only`
# só dizia "git pull falhou" e o clone ficava preso.
repo_atualizar() { # repositório
  local r=$1 ref suj frente atras ramo
  local -x GIT_TERMINAL_PROMPT=0 GIT_EDITOR=true
  repo_local_para_exclude "$r"
  suj=$(git -C "$r" status --porcelain --untracked-files=no 2>/dev/null)
  if [[ -n $suj ]]; then
    echo "  ✗ Há mudanças não gravadas em arquivos versionados:"; sed 's/^/      /' <<<"$suj"
    echo "    Grave (commit) ou desfaça antes de atualizar; tt --repo-checar explica cada uma."
    return 1
  fi
  timeout 60 git -C "$r" fetch -q origin 2>/dev/null || { echo "  ✗ git fetch falhou (sem rede?)."; return 1; }
  ref=$(git -C "$r" rev-parse -q --verify --symbolic-full-name '@{u}' 2>/dev/null) || ref=refs/remotes/origin/main
  read -r frente atras < <(git -C "$r" rev-list --left-right --count "HEAD...$ref" 2>/dev/null)
  frente=${frente:-0} atras=${atras:-0}
  if ((atras == 0)); then
    ((frente > 0)) && echo "  · $frente commit(s) local(is) à frente do publicado; nada a trazer." || echo "  ✓ já está no publicado."
    return 0
  fi
  if ((frente == 0)); then
    git -C "$r" merge -q --ff-only "$ref" && { echo "  ✓ avançou $atras commit(s)."; return 0; }
    echo "  ✗ não consegui avançar o clone."; return 1
  fi
  ramo="local/$(date +%Y%m%d-%H%M%S)"
  git -C "$r" branch "$ramo" HEAD || { echo "  ✗ não consegui guardar os commits locais num ramo."; return 1; }
  if git -C "$r" -c core.hooksPath=/dev/null rebase -q "$ref" >/dev/null 2>&1; then
    git -C "$r" branch -q -D "$ramo"
    echo "  ✓ $frente commit(s) local(is) reaplicado(s) sobre o publicado ($atras novo(s))."
    return 0
  fi
  git -C "$r" rebase --abort >/dev/null 2>&1
  git -C "$r" reset -q --hard "$ref"
  echo "  ⚠ Os $frente commit(s) local(is) conflitam com o publicado: ficaram no ramo $ramo e o clone agora segue o publicado."
  echo "    Para retomá-los: git -C $(q "$r") cherry-pick ..$ramo (resolvendo os conflitos)."
  return 0
}

# Configuração só desta máquina não vai em arquivo versionado: linhas acrescentadas ao .gitignore (sem
# remover nada) passam para .git/info/exclude, que vale igual e não é versionado, e o .gitignore volta
# ao publicado. Era o que travava o clone de desenvolvimento (o bloco do AI-DLC no .gitignore).
repo_local_para_exclude() { # repositório
  local r=$1 ex add
  git -C "$r" diff --quiet -- .gitignore 2>/dev/null && return 0
  [[ $(git -C "$r" diff --numstat -- .gitignore | awk '{ print $2 }') == 0 ]] || return 0
  add=$(git -C "$r" diff -U0 -- .gitignore | sed -n 's/^+\([^+].*\)$/\1/p; s/^+$//p')
  ex=$(git -C "$r" rev-parse --git-path info/exclude 2>/dev/null) || return 0
  [[ $ex == /* ]] || ex=$r/$ex
  mkdir -p "${ex%/*}"; touch "$ex"
  printf '\n# Do .gitignore local, movido pelo tt em %s\n' "$(date +%F)" >>"$ex"
  while IFS= read -r l; do [[ -z $l ]] || grep -qxF -- "$l" "$ex" || printf '%s\n' "$l" >>"$ex"; done <<<"$add"
  git -C "$r" checkout -q -- .gitignore && echo "  → linhas locais do .gitignore foram para ${ex#"$r"/} (não versionado)."
}

# tt --repo-checar [--corrigir]: o que neste clone é local e o que trava a atualização.
repo_checar() {
  local r=$REPO_TT l f arq motivo n=0 ref frente atras
  [[ -e $r/.git ]] || { echo "Esta máquina não é a de desenvolvimento (sem repo= de um clone git)."; return 0; }
  [[ ${1:-} == --corrigir ]] && repo_local_para_exclude "$r"
  echo "Clone: $r"
  ref=$(git -C "$r" rev-parse -q --verify --symbolic-full-name '@{u}' 2>/dev/null) || ref=refs/remotes/origin/main
  read -r frente atras < <(git -C "$r" rev-list --left-right --count "HEAD...$ref" 2>/dev/null)
  printf '  em relação a %s: %s à frente, %s atrás\n' "${ref#refs/remotes/}" "${frente:-?}" "${atras:-?}"
  while IFS= read -r l; do
    [[ -n $l ]] || continue
    arq=${l:3}; n=$((n + 1))
    motivo="trava o rebase dos commits locais (tt --atualizar)"
    for f in "${ARQUIVOS_FONTE[@]}"; do [[ $f == "$arq" ]] && motivo="arquivo do pacote: trava a atualização e o --sincronizar"; done
    if [[ $arq == .gitignore ]] && [[ $(git -C "$r" diff --numstat -- .gitignore | awk '{ print $2 }') == 0 ]]; then
      motivo="só acréscimos locais: tt --repo-checar --corrigir os move para .git/info/exclude"
    fi
    printf '  ✗ %s — %s\n' "$arq" "$motivo"
  done < <(git -C "$r" status --porcelain --untracked-files=no 2>/dev/null)
  ((n)) || echo "  ✓ nenhum arquivo versionado mudado: o clone pode ser atualizado."
  n=$(git -C "$r" status --porcelain 2>/dev/null | grep -c '^??')
  ((n)) && echo "  · $n arquivo(s) não versionado(s) (não travam nada; tt --repo-checar não mexe neles)."
  return 0
}

# Um clone atrasado em relação ao GitHub não pode ser a fonte: instalaria código velho por cima
# de recursos que outras máquinas já têm. Sem rede ou sem upstream, segue (o pode_instalar ainda
# barra o rebaixamento em cada máquina).
repo_em_dia() {
  [[ -e $REPO_TT/.git ]] || return 0
  local ref atras
  # Sem ramo de acompanhamento (@{u}) vale o main publicado do remoto: um clone ou worktree sem
  # upstream passava direto e, em 08/10, instalou nas 4 máquinas, pela contagem de commits, uma
  # versão divergente que não continha o main publicado (e desfez o que ele trazia).
  ref=$(git -C "$REPO_TT" rev-parse -q --verify --symbolic-full-name '@{u}' 2>/dev/null) ||
    ref=$(git -C "$REPO_TT" for-each-ref --format='%(refname)' 'refs/remotes/*/main' 'refs/remotes/*/HEAD' 2>/dev/null | head -1)
  [[ -n $ref ]] || return 0
  timeout 15 git -C "$REPO_TT" fetch -q --all 2>/dev/null ||
    echo "⚠ não consegui consultar o repositório publicado (sem rede?); conferindo contra a última cópia conhecida."
  atras=$(git -C "$REPO_TT" rev-list --count "HEAD..$ref" 2>/dev/null || echo 0)
  ((atras == 0)) && return 0
  echo "✗ $REPO_TT está $atras commit(s) atrás de ${ref#refs/remotes/}: git pull --rebase antes de sincronizar."
  return 1
}

# tt --sincronizar [rótulo…]: instala a versão daqui (do repositório, se houver) nesta máquina e
# nas cadastradas. Não rebaixa: pula quem já tem versão mais nova.
sincronizar() {
  local n_local
  local -a alvos=("$@")
  repo_em_dia || return 1
  echo "Versão a instalar: $(pacote | tar -xOf - VERSAO)"
  [[ -e $REPO_TT/.git ]] && { printf '  %-10s ' "$MAQUINA"; instalar_em . | sed 's/^[^:]*: //'; }
  n_local=$(pacote | tar -xOf - VERSAO | awk '{ print $1 + 0 }')
  # As outras máquinas recebem ao mesmo tempo; cada linha sai na ordem delas, assim que fica pronta.
  nas_maquinas sincronizar_em
}
sincronizar_em() { # dest rótulo (alvos e n_local: os de sincronizar)
  local dest=$1 rot=$2 alvo n_rem
  if ((${#alvos[@]})); then
    for alvo in "${alvos[@]}"; do [[ $alvo == "$rot" ]] && break; alvo=""; done
    [[ -n $alvo ]] || return 0
  fi
  printf '  %-10s ' "$rot"
  n_rem=$(timeout 8 ssh "${SSH_OPC[@]}" "$dest" "cat ~/.local/share/tt/VERSAO 2>/dev/null || echo 0" </dev/null 2>/dev/null | awk '{ print $1 + 0 }')
  if [[ -z $n_rem ]]; then echo "✗ sem resposta"; return 0; fi
  if ((n_rem > n_local)); then echo "· já tem versão mais nova ($n_rem), não mexi"; return 0; fi
  instalar_em "$dest" "$rot" 2>&1 | tail -1 | sed 's/^[^:]*: //'
}

# tt --cadastrar [host [usuario [rótulo]]]: testa o acesso, instala o tt lá e cadastra as duas
# máquinas uma na outra.
cadastrar() {
  local host=${1:-} usuario=${2:-} rot=${3:-} dest err falta r h
  if [[ -z $host ]]; then
    host=$( { candidatas | awk '{ printf "%s\t\033[1m%s\033[0m \033[90m(Tailscale, %s)\033[0m\n", $1, $1, $2 }'
              printf '!outro\t\033[36m✎ outra (digitar host ou IP)\033[0m\n'; } |
      fzf --ansi --delimiter='\t' --with-nth=2 --no-sort --layout=reverse --height=~15 \
        --header='Qual máquina cadastrar? (Linux online no Tailscale ainda não cadastradas)' --prompt='❯ ' |
      cut -f1) || return 1
    [[ $host == !outro ]] && read -rp "Host ou IP (como no ssh): " host
  fi
  [[ -n $host ]] || return 1
  usuario=${usuario:-$(id -un)}
  while :; do
    r=$usuario
    read -rep "Usuário em $host: " -i "$r" usuario || return 1
    usuario=${usuario:-$r}
    printf 'Testando ssh %s@%s… ' "$usuario" "$host"
    err=$(timeout 15 ssh "${SSH_OPC[@]}" "$usuario@$host" true 2>&1 </dev/null) && { echo ok; break; }
    echo "falhou."
    if grep -q login.tailscale.com <<<"$err"; then
      echo "O Tailscale SSH de lá pede aprovação no navegador:"; grep -o 'https://login.tailscale.com[^ ]*' <<<"$err"
      read -rp "Aprove e tecle Enter para tentar de novo (ou Ctrl+C)." r
    else
      echo "  ${err:0:200}"
      read -rp "Tentar outro usuário? [S/n] " r; [[ $r == [nN]* ]] && return 1
    fi
  done
  dest="$usuario@$host"
  # Dependências completas de uma vez (as opcionais — w3m, curl, unzip, mbsync — também: quem
  # está sendo cadastrado já recebe tudo). O gerenciador e o privilégio são detectados lá (a biblioteca
  # de pacotes vai pelo ssh e roda no destino: apt, dnf, zypper, pacman, apk, xbps, brew, pkg do Termux
  # ou do FreeBSD…), não presumidos; brew e o pkg do Termux dispensam sudo.
  falta=$(ssh "${SSH_OPC[@]}" "$dest" 'for p in tmux fzf python3 tar rg w3m curl unzip mbsync; do command -v $p >/dev/null || printf "%s " $p; done' </dev/null)
  if [[ -n $falta ]]; then
    echo "Faltam lá: $falta"
    local ger_rem priv_rem cmd_txt
    if pacotes_lib; then
      { read -r ger_rem; read -r priv_rem; } < <({ cat "$PACOTES_LIB"; echo 'pk_gerenciador || echo; pk_privilegio "$(pk_gerenciador 2>/dev/null)"'; } | ssh "${SSH_OPC[@]}" "$dest" 'bash -s' 2>/dev/null)
    fi
    if [[ -z ${ger_rem:-} ]]; then
      echo "Não achei um gerenciador de pacotes lá; instale à mão: $falta"
    else
      pend_resolver "$ger_rem" $falta
      cmd_txt=$(pk_comando_texto "$ger_rem" "${priv_rem:-nenhum}" ${PK_PACOTES[@]+"${PK_PACOTES[@]}"})
      read -rp "Instalar lá com $cmd_txt? [S/n] " r
      [[ $r == [nN]* ]] || ssh -t "${SSH_OPC[@]}" "$dest" "$cmd_txt"
    fi
  fi
  h=$(ssh "${SSH_OPC[@]}" "$dest" 'sed -n "s/^nome=//p" ~/.config/tt/config 2>/dev/null | tail -1' </dev/null)
  rot=${rot:-${h:-${host%%.*}}}
  r=$rot
  read -rep "Nome dela no menu: " -i "$r" rot || return 1
  rot=${rot:-$r}
  rot=$(limpar "$rot")
  [[ $rot == "$MAQUINA" ]] && { echo "Esse nome já é o desta máquina; escolha outro."; return 1; }
  echo "Instalando o tt em $rot…"
  instalar_em "$dest" "$rot" | tail -1 || { echo "A instalação falhou."; return 1; }
  instalar_chave_em "$dest" 2>/dev/null && echo "chave desta máquina autorizada em $rot (acesso direto garantido)."
  registrar "$host" "$usuario" "$rot"
  # O endereço com que me apresento é o que ELA enxerga (no Termux o meu_host dá "localhost").
  ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --registrar $(q "$(meu_endereco_em "$dest" || meu_host)" "$(id -un)" "$MAQUINA")" </dev/null
  [[ -n $(estado_de "$rot") ]] && estado_propagar "$rot" ativa # já esteve removida: as outras precisam saber que voltou
  malha_completar # as demais passam a conhecer a nova (e a nova, as demais)
  echo "✓ $rot cadastrada: aparece no menu daqui, e esta ($MAQUINA) no menu de lá."
}

# tt --descadastrar [rótulo]: tira do menu (aqui e lá), fecha as pontes e, se quiser, desinstala lá.
descadastrar() {
  local rot=${1:-} dest host r s
  if [[ -z $rot ]]; then
    rot=$(awk '!/^#/ && NF { print ($3 ? $3 : $1) "\t" $1 }' "$CONF_MAQ" 2>/dev/null |
      fzf --delimiter='\t' --layout=reverse --height=~12 --header='Descadastrar qual máquina?' --prompt='❯ ' | cut -f1) || return 1
  fi
  [[ -n $rot ]] || return 1
  host=$(awk -v r="$rot" '!/^#/ && ($3 == r || $1 == r) { print $1; exit }' "$CONF_MAQ" 2>/dev/null)
  [[ -n $host ]] || { echo "$rot não está cadastrada."; return 1; }
  dest=$(dest_de "$rot")
  read -rp "Descadastrar $rot? [s/N] " r; [[ $r == [sSyY]* ]] || return 1
  for s in $(tmux list-sessions -F '#{session_name}|#{@ponte}' 2>/dev/null | awk -F'|' -v d="$dest" '$2 == d && d != "" { print $1 }'); do
    tmux kill-session -t "=$s"
  done
  if [[ -n $dest && $dest != . ]]; then
    ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --desregistrar $(q "$(meu_host)")" </dev/null 2>/dev/null
    read -rp "Remover o tt de lá também (volta o ~/.tmux.conf antigo)? [s/N] " r
    [[ $r == [sSyY]* ]] && ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --desinstalar-aqui" </dev/null
  fi
  desregistrar "$host"
  # A remoção vale em TODAS as máquinas (a troca de listas da malha não pode ressuscitá-la).
  estado_set "$rot" removida
  estado_propagar "$rot" removida
  echo "✓ $rot descadastrada."
}

desinstalar_aqui() {
  if [[ -f $HOME/.tmux.conf.antes-tt ]]; then mv "$HOME/.tmux.conf.antes-tt" "$HOME/.tmux.conf"
  elif grep -q '^source-file ~/.local/share/tt/tmux.conf' "$HOME/.tmux.conf" 2>/dev/null; then rm -f "$HOME/.tmux.conf"; fi
  [[ -L $HOME/.local/bin/tt ]] && rm -f "$HOME/.local/bin/tt"
  remover_bashrc
  remover_zshenv
  remover_aerc
  rm -rf "$DIR_TT"
  echo "tt removido de $(hostname -s) (a configuração em ~/.config/tt ficou)."
}

# macOS: o ssh não interativo (zsh) só lê o ~/.zshenv, e ali o PATH não tem o Homebrew — sem tmux
# e com o bash 3.2 do sistema, os comandos que as outras máquinas mandam para cá falhavam. Bloco
# entre marcadores no ~/.zshenv, só no macOS (TT_ZSHENV=1 força, para teste).
ZSHENV_INI='# >>> tt (PATH para comandos via ssh) >>>'
ZSHENV_FIM='# <<< tt (PATH para comandos via ssh) <<<'
configurar_zshenv() {
  [[ $(uname -s) == Darwin || -n ${TT_ZSHENV:-} ]] || return 0
  local z=$HOME/.zshenv tmp
  tmp=$(mktemp) || return 1
  { [[ -f $z ]] && awk -v i="$ZSHENV_INI" -v f="$ZSHENV_FIM" '$0==i{p=1} !p{print} $0==f{p=0}' "$z"
    echo "$ZSHENV_INI"
    echo 'for _tt_d in /usr/local/bin /opt/homebrew/bin "$HOME/.local/bin"; do'
    echo '  [[ -d $_tt_d && ":$PATH:" != *":$_tt_d:"* ]] && PATH="$_tt_d:$PATH"'
    echo 'done; unset _tt_d; export PATH'
    echo "$ZSHENV_FIM"; } >"$tmp"
  if cmp -s "$tmp" "$z" 2>/dev/null; then rm -f "$tmp"; else cat "$tmp" >"$z"; rm -f "$tmp"; fi
}
remover_zshenv() {
  local z=$HOME/.zshenv tmp
  grep -qxF "$ZSHENV_INI" "$z" 2>/dev/null || return 0
  tmp=$(mktemp) && awk -v i="$ZSHENV_INI" -v f="$ZSHENV_FIM" '$0==i{p=1} !p{print} $0==f{p=0}' "$z" >"$tmp" && cat "$tmp" >"$z"; rm -f "$tmp"
}

# Comportamento do cliente de e-mail (aerc) que o botão 📧 depende, garantido em TODA máquina (não
# só onde o dono configurou à mão): mouse ligado (clicar/rolar no popup) e uma saída instantânea
# (Q), já que o popup é uma subjanela que deve fechar e voltar à tela de baixo sem diálogo. Só mexe
# em aerc.conf e binds.conf; NUNCA toca accounts.conf (contas e credenciais são do usuário). Roda
# só quando o cliente é o aerc e ele está instalado. Idempotente.
AERC_BINDS_INI='# >>> tt (saída rápida do popup) >>>'
AERC_BINDS_FIM='# <<< tt (saída rápida do popup) <<<'
# Define KEY=VALUE na seção [SEÇÃO] do arquivo INI do aerc. Por padrão só ACRESCENTA (se a chave já
# existe, mesmo com outro valor, é uma escolha do dono e fica); "forcar" substitui o valor.
aerc_definir() { # arquivo seção chave valor [forcar]
  local f=$1 sec=$2 k=$3 v=$4 forcar=${5:-} tmp
  [[ -f $f ]] || : >"$f"
  tmp=$(mktemp) || return 1
  awk -v S="$sec" -v K="$k" -v V="$v" -v F="$forcar" '
    function poe() { if (!feito) { print K "=" V; feito = 1 } }
    /^\[.*\]/ { if (sec == S) poe(); sec = $0; gsub(/^\[|\].*$/, "", sec); print; next }
    # Compara a chave literalmente: K pode ter "*" (x-scheme-handler/http*), que como regex nunca casa
    # e fazia cada execução acrescentar mais uma linha igual.
    function chave(l,   i) { sub(/^[ \t]*/, "", l); i = index(l, "="); if (!i) return ""; l = substr(l, 1, i - 1); sub(/[ \t]+$/, "", l); return l }
    function chave_com(l) { sub(/^[ \t]*#[ \t]*/, "", l); return chave(l) }
    sec == S && chave($0) == K { if (F != "") { poe() } else { print; feito = 1 } next }
    sec == S && F != "" && $0 ~ /^[ \t]*#/ && chave_com($0) == K { poe(); next }
    { print }
    END { if (sec == S) poe(); if (!feito) { print ""; print "[" S "]"; print K "=" V } }' "$f" >"$tmp"
  cmp -s "$tmp" "$f" || cat "$tmp" >"$f"; rm -f "$tmp"
}

# Conversor de HTML para o leitor: w3m (o filtro "html" do aerc) > lynx > o do tt (python, sempre há).
# Em todos os caminhos, os links viram hyperlinks OSC 8 clicáveis (email-tt.py linkify no w3m/lynx;
# nativo no conversor do tt): o terminal abre a URL inteira num clique, mesmo que ela esteja quebrada
# em várias linhas na tela. Antes, o clique pegava só o pedaço da linha e caía em "wrong link".
# O filtro html do aerc chama "unshare --map-root-user --net"; no WSL, logo depois de a máquina
# acordar, criar user namespace falha transitoriamente ("unshare failed: Invalid argument") e o
# e-mail aparecia só com esse erro. O html-tt testa o unshare antes: funcionando, usa o filtro
# normal (w3m sem rede); quebrado, roda o MESMO filtro com um unshare de mentira no PATH (o w3m
# fica sem o isolamento momentos após o despertar — a navegação continua bloqueada pelo keymap e
# o w3m não busca nada sozinho).
aerc_html_tt_garantir() {
  local alvo=${TT_AERC_FILTRO_HTML:-} f
  [[ -n $alvo && -x $alvo ]] && { :; } || alvo=""
  [[ -n $alvo ]] || for f in "${PREFIX:-/nonexistent}/libexec/aerc/filters/html" /usr/libexec/aerc/filters/html /usr/lib/aerc/filters/html /usr/local/libexec/aerc/filters/html; do
    [[ -x $f ]] && { alvo=$f; break; }
  done
  [[ -n $alvo ]] || return 1
  mkdir -p "$DIR_TT/sem-unshare"
  cat >"$DIR_TT/sem-unshare/unshare" <<'FIM'
#!/bin/sh
# unshare de mentira (só o fallback do html-tt usa): ignora as opções de isolamento e roda o comando.
while [ $# -gt 0 ]; do case $1 in --) shift; break ;; -*) shift ;; *) break ;; esac; done
exec "$@"
FIM
  cat >"$DIR_TT/html-tt" <<FIM
#!/bin/sh
# Filtro HTML do tt: o do aerc, tolerante a unshare quebrado (WSL pós-suspensão). Gerado pelo tt.
if unshare --map-root-user --net true 2>/dev/null; then exec $alvo "\$@"; fi
PATH=$DIR_TT/sem-unshare:\$PATH exec $alvo "\$@"
FIM
  chmod +x "$DIR_TT/html-tt" "$DIR_TT/sem-unshare/unshare"
}

aerc_filtro_html() {
  if command -v w3m >/dev/null; then
    # O filtro "html" do aerc roda o w3m interativo SEM rede (unshare --net): Enter num link dava
    # "Can't load <URL cortada na largura da tela>" e a URL colada caía em "wrong link". Aqui Enter
    # (e ESC M) abre o link no navegador via tt --abrir-url, com a URL inteira.
    mkdir -p "$DIR_TT" && printf 'keymap C-m EXTERN_LINK\nkeymap C-j EXTERN_LINK\n' >"$DIR_TT/w3m-keymap"
    # Sem pipe: com "!" o aerc só dá TTY ao w3m se ele for o processo principal; "html | colorize"
    # o põe em modo dump (texto cru, sem caixas nem links navegáveis).
    local filtro="! html"
    aerc_html_tt_garantir && filtro="! $DIR_TT/html-tt"
    echo "$filtro -o extbrowser='$HOME/.local/bin/tt --abrir-link %s' -o keymap_file=$DIR_TT/w3m-keymap"
  elif command -v lynx >/dev/null; then echo "lynx -assume_charset=utf-8 -display_charset=utf-8 -dump -force_html -stdin -width=100 | colorize | python3 $DIR_TT/email-tt.py linkify"
  else echo "python3 $DIR_TT/email-tt.py html | colorize | python3 $DIR_TT/email-tt.py linkify"; fi
}

