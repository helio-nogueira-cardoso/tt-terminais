}

# Cabeçalho do painel. Na lista: as abas de filtro e, abaixo, a barra de botões (que agem na tarefa
# em foco). Na ajuda e no menu: um "‹ Voltar" e o título. Tudo clicável: cada item desenhado é
# registrado no mapa (linha, colunas inicial e final, ação) que o clique consulta. As colunas são
# as de exibição, contadas como o fzf conta FZF_CLICK_HEADER_COLUMN (1 = início do texto). Os
# rótulos só usam caracteres de largura 1, então a largura é o número de caracteres. Um botão
# nunca é partido entre linhas, nem sobra separador solto no fim de uma linha.
tarefas_cabecalho() {
  [[ $(locale charmap 2>/dev/null) == UTF-8 ]] || local LC_ALL=C.UTF-8
  local larg=$(( ${FZF_COLUMNS:-64} - 3 )) mapa modo f
  ((larg < 20)) && larg=20
  mapa=$(tarefas_mapa_arq); mkdir -p "$RT"; : >"$mapa.tmp"
  modo=$(tarefas_ui_get modo); f=$(tarefas_filtro); f=${f:-todas}
  local z=$'\e[0m' bg=$'\e[48;2;49;50;68m' txt=$'\e[38;2;205;214;244m' sub=$'\e[38;2;166;173;200m'
  local dim=$'\e[38;2;108;112;134m' amar=$'\e[38;2;249;226;175m' neg=$'\e[1m'
  local ativo=$'\e[48;2;137;180;250m\e[38;2;30;30;46m\e[1m' verm=$'\e[38;2;243;139;168m' lar=$'\e[38;2;250;179;135m'
  local lin=1 col=1 buf="" saida=""
  _quebra() { saida+="$buf"$'\n'; buf=""; lin=$((lin + 1)); col=1; }
  _item() { # texto-visível desenho ação [colado: sem espaço antes, na mesma linha]
    local w=${#1}
    if [[ -z ${4:-} ]]; then
      ((col > 1 && col + 1 + w - 1 > larg)) && _quebra
      ((col > 1)) && { buf+=" "; col=$((col + 1)); }
    fi
    buf+=$2; printf '%s %s %s %s\n' "$lin" "$col" "$((col + w - 1))" "$3" >>"$mapa.tmp"
    col=$((col + w))
  }
  _botao() { _item " $1 " "$bg$txt $1 $z" "$2"; }
  case $modo in
    ajuda)
      _item " ‹ Voltar " "$ativo ‹ Voltar $z" voltar
      _item "Como usar o painel de tarefas" "$neg${txt}Como usar o painel de tarefas$z" "" ;;
    menu:*)
      local t; t=$(tarefas_raw | awk -F'\t' -v id="${modo#menu:}" '$1==id{print $5; exit}')
      ((${#t} > larg - 22)) && t="${t:0:$((larg - 23))}…"
      _item " ‹ Voltar " "$ativo ‹ Voltar $z" voltar
      _item "Ações: $t" "${sub}Ações: $neg$txt$t$z" "" ;;
    *)
      local h ab fe pz to ar atr; read -r h ab fe pz to ar atr < <(tarefas_contagens)
      _aba() { # chave rótulo contador
        local n=""; (($3 > 0)) && n=" $3"
        if [[ $1 == "$f" ]]; then _item " $2$n " "$ativo $2$n $z" "filtro:$1"
        elif [[ $1 == hoje && ${atr:-0} -gt 0 ]]; then _item " $2$n " "$bg$sub $2$neg$lar$n $z" "filtro:$1"
        else _item " $2$n " "$bg$sub $2$amar$n $z" "filtro:$1"; fi
      }
      _aba hoje Hoje "$h"; _aba abertas Abertas "$ab"; _aba feitas Feitas "$fe"
      _aba prazo Agenda "$pz"; _aba todas Todas "$to"; _aba arquivo Arquivo "$ar"
      _item " ▦ Calendário " "$bg$txt ▦ Calendário $z" calendario
      _quebra
      _botao '+ Nova' nova; _botao '✓ Feita' feita; _botao '✎ Editar' editar; _botao '↳ Subtarefa' sub; _botao '✎ Descrição' desc
      _botao '◷ Prazo' prazo; _botao '! Prioridade' prio; _botao '↻ Repetir' rep
      # ↑ e ↓ numa pílula só, cada seta com a sua ação; as duas metades nunca se separam
      ((col > 1 && col + 6 > larg)) && _quebra
      _item " ↑" "$bg$txt ↑" cima; _item " ↓ " "$bg$txt ↓ $z" baixo colado
      _botao '✕ Apagar' apagar; _botao '⋯ Mais' mais
      _botao '? Ajuda' ajuda
      # Aviso de uma ação recusada (ex.: concluir mãe com subtarefa aberta): aparece uma vez.
      local av; av=$(tarefas_ui_get aviso)
      if [[ -n $av ]]; then
        tarefas_ui_set aviso ""
        _quebra
        ((${#av} > larg - 1)) && av="${av:0:$((larg - 2))}…"
        if [[ $av == ⚠* ]]; then _item "$av" "$verm$neg$av$z" ""; else _item "$av" $'\e[38;2;137;180;250m'"$neg$av$z" ""; fi
      fi ;;
  esac
  _quebra
  local regua; printf -v regua '%*s' "$larg" ''; regua=${regua// /─}
  saida+="$dim$regua$z"
  mv "$mapa.tmp" "$mapa"
  printf '%s' "$saida"
}

# Ação do item do cabeçalho na coluna/linha clicada (FZF_CLICK_HEADER_*), ou vazio.
tarefas_cabecalho_acao() {
  local l=${FZF_CLICK_HEADER_LINE:-0} c=${FZF_CLICK_HEADER_COLUMN:-0}
  awk -v l="$l" -v c="$c" '$1 == l && c >= $2 && c <= $3 { print $4; exit }' "$(tarefas_mapa_arq)" 2>/dev/null
}

# Linhas da lista para o fzf (veja as chaves no topo desta seção).
tarefas_lista_fzf() { # [busca]
  local q=${1:-} modo; modo=$(tarefas_ui_get modo)
  case $modo in
    ajuda) tarefas_ajuda_linhas; return 0 ;;
    menu:*) tarefas_menu_linhas "${modo#menu:}"; return 0 ;;
  esac
  local filtro exp agora tz arq=$CONF_TAREFAS
  filtro=$(tarefas_filtro); filtro=${filtro:-todas}
  exp=$(sed -n 's/^exp=//p' "$(tarefas_estado_arq)" 2>/dev/null | tr '\n' ',')
  read -r agora tz < <(tarefas_relogio)
  [[ -f $arq ]] || arq=/dev/null
  TQ=$q TQL=${q,,} TEXP=",$exp" LC_ALL=C \
    awk -F'\t' -v NOW="$agora" -v TZOFF="$tz" -v FILTRO="$filtro" -v COLS="${FZF_COLUMNS:-64}" "$TAREFAS_AWK"'
    function caixa(est, venc) {
      if (est == "feita") return VERDE "☑" Z
      return (venc ? VERM : TXT) "☐" Z
    }
    function progresso(f, t,   c, i, s) {
      c = int(f * 6 / t); s = ""
      for (i = 0; i < 6; i++) s = s (i < c ? TEAL : DIM) "━"
      return s Z " " SUB f "/" t Z
    }
    function linha_topo(i, aberto, tagtxt,   id, est, meta, prazo, hora, venc, nfil, tem, s, ex, p, r, n, dl, k) {
      id = TID[i]; est = TEST[i]; meta = TMETA[i]; prazo = mv(meta, "prazo"); hora = (mv(meta, "hora") == 1)
      if (est == "arquivada") {
        r = mv(meta, "arq")
        s = " " (NFI[id] + 0 > 0 || TDESC[i] != "" ? AZUL : DIM) (aberto ? "▾" : "▸") Z " " DIM (r ~ /:a$/ ? "☐" : "☑") " " TTXT[i] Z
        ex = "  " DIM "▤ arquivada " quando(TARQ[i]) Z
        if (tagtxt != "") ex = ex "  " DIM tagtxt Z
        if (TDESC[i] != "") ex = ex "  " DIM "≡" Z
        printf "%s\t%s%s\n", id, s, ex
        return
      }
      nfil = NFI[id] + 0; venc = (prazo != "" && est == "aberta" && vencida(prazo, hora))
      tem = (nfil > 0 || TDESC[i] != "")
      s = " " (tem ? AZUL NEG : DIM) (aberto ? "▾" : "▸") Z " " caixa(est, venc) " "
      p = mv(meta, "prio")
      if (est == "aberta" && p == 1) s = s VERM "●" Z " "
      else if (est == "aberta" && p == 2) s = s AMAR "●" Z " "
      # Na agenda o dia já está no título do grupo: a hora vem antes do texto. As atrasadas
      # mantêm o rótulo completo ("venceu ontem 14:00"), que diz desde quando.
      if (AGENDA && hora && !venc) s = s AZUL NEG hhmm(prazo) Z " "
      s = s (est == "feita" ? DIM RISCO TTXT[i] Z : TXT TTXT[i] Z)
      ex = ""
      if (!AGENDA || venc) { r = rotulo_prazo(prazo, est, hora); if (r != "") ex = ex "  " r }
      r = mv(meta, "rep")
      if (r != "") ex = ex "  " TEAL "↻ " (r == "d" ? "diária" : (r == "w" ? "semanal" : "mensal")) Z
      if (nfil > 0) ex = ex "  " progresso(NFE[id] + 0, nfil)
      if (tagtxt != "") ex = ex "  " LILAS tagtxt Z
      if (TDESC[i] != "") ex = ex "  " SUB "≡" Z      # tem descrição (a visão própria mostra)
      printf "%s\t%s%s\n", id, s, ex
    }
    function detalhes(i,   id, j, k, v, f, n, a, L, ind, prim) {
      id = TID[i]; ind = "      "
      # subtarefas na ordem manual (ord) e, no empate, de criação
      n = NFI[id] + 0
      for (j = 1; j <= n; j++) S[j] = FI[id, j]
      for (j = 2; j <= n; j++) {
        v = S[j]; k = j - 1
        while (k >= 1 && (FORD[S[k]] > FORD[v] || (FORD[S[k]] == FORD[v] && FCRI[S[k]] > FCRI[v]))) { S[k + 1] = S[k]; k-- }
        S[k + 1] = v
      }
      if (TEST[i] == "arquivada") {
        for (j = 1; j <= n; j++) { f = S[j]; printf "\t%s%s%s %s%s\n", ind, DIM, (FARQ[f] ~ /:a$/ ? "☐" : "☑"), FTXT[f], Z }
        printf "rest:%s\t%s%s↩ restaurar para a lista%s %s(volta com as subtarefas, como estava)%s\n", id, ind, AZUL, Z, DIM, Z
        printf "apag:%s\t%s%s✕ apagar de vez%s %s(sem histórico)%s\n", id, ind, VERM, Z, DIM, Z
        return
      }
      for (j = 1; j <= n; j++) {
        f = S[j]
        printf "%s\t%s%s %s\n", FID[f], ind, caixa(FEST[f], 0), (FEST[f] == "feita" ? DIM RISCO FTXT[f] Z : TXT FTXT[f] Z)
      }
      # Um menuzinho só, discreto e encostado à direita (pedido do dono: as linhas de ação sob a
      # tarefa poluíam): clique abre o menu da tarefa — descrição, subtarefa, prazo, prioridade…
      printf "menu:%s\t%*s%s⋯ menu%s\n", id, (COLS > 14 ? COLS - 9 : 6), "", DIM, Z
    }
    # Título de um grupo da agenda: "Atrasadas", "Hoje · quinta, 08/10", "Amanhã · …", "Sábado, 10/10".
    function titulo_dia(d,   s, df) {
      civil(d); s = DOWL[(d + 4) % 7 + 1] ", " sprintf("%02d/%02d", CD, CM)
      if (CY != ANO) s = s sprintf("/%02d", CY % 100)
      df = d - HOJE
      if (df == 0) return "Hoje · " s
      if (df == 1) return "Amanhã · " s
      return toupper(substr(s, 1, 1)) substr(s, 2)
    }
    BEGIN {
      cores(); HOJE = dia(NOW); civil(HOJE); ANO = CY
      split("domingo segunda terça quarta quinta sexta sábado", DOWL, " ")
      AGENDA = (FILTRO == "prazo" || FILTRO == "hoje"); ARQ = (FILTRO == "arquivo")
      Q = ENVIRON["TQ"]; QL = ENVIRON["TQL"]; EXP = ENVIRON["TEXP"]
    }
    NF >= 5 && (valida($1, $2) || (ARQ && $2 == "arquivada" && valida($1, "feita"))) && !($1 in VISTO) {
      VISTO[$1] = 1; meta = (NF >= 6 ? $6 : ""); pai = mv(meta, "pai")
      if (pai != "") {
        nf++; FID[nf] = $1; FEST[nf] = $2; FTXT[nf] = $5; FPAI[nf] = pai; FARQ[nf] = mv(meta, "arq")
        FORD[nf] = mv(meta, "ord") + 0; FCRI[nf] = $3 + 0
        next
      }
      nt++; TID[nt] = $1; TEST[nt] = $2; TTXT[nt] = $5; TMETA[nt] = meta
      d64 = mv(meta, "desc"); TDESC[nt] = (d64 != "" ? b64d(d64) : "")
      TKEY[nt] = chave_ordem($1, $2, $3, meta)
      # Arquivo: o arquivado mais recente primeiro.
      if (ARQ) { a = mv(meta, "arq"); sub(/:.*/, "", a); TARQ[nt] = a + 0; TKEY[nt] = sprintf("%010d", 9999999999 - a) $1 }
      # Agenda (abas Hoje e Agenda): atrasadas primeiro, depois por dia; no dia, o "dia todo" antes
      # e as com horário na ordem da hora.
      p = mv(meta, "prazo")
      if (AGENDA && p != "") {
        h = (mv(meta, "hora") == 1); v = ($2 == "aberta" && vencida(p, h))
        TGRP[nt] = (v ? "A" : dia(p))
        TKEY[nt] = sprintf("%d%010d%d%010d", (v ? 0 : 1), (v ? 0 : dia(p)), h, p) TKEY[nt]
      }
    }
    END {
      for (i = 1; i <= nf; i++) if (FPAI[i] in VISTO) {
        p = FPAI[i]; NFI[p]++; FI[p, NFI[p]] = i; if (FEST[i] == "feita") NFE[p]++
      }
      for (i = 1; i <= nt; i++) O[i] = i
      for (i = 2; i <= nt; i++) {
        v = O[i]; j = i - 1
        while (j >= 1 && TKEY[O[j]] > TKEY[v]) { O[j + 1] = O[j]; j-- }
        O[j + 1] = v
      }
      vistas = 0; grupo = ""
      for (k = 1; k <= nt; k++) {
        i = O[k]; id = TID[i]; est = TEST[i]; prazo = mv(TMETA[i], "prazo")
        if (ARQ != (est == "arquivada")) continue
        if (FILTRO == "abertas" && est != "aberta") continue
        if (FILTRO == "feitas" && est != "feita") continue
        if (FILTRO == "prazo" && !(est == "aberta" && prazo != "")) continue
        if (FILTRO == "hoje" && !(est == "aberta" && prazo != "" && dia(prazo) <= HOJE)) continue
        tags = mv(TMETA[i], "tags"); tagtxt = ""
        if (tags != "") { tagtxt = "#" tags; gsub(/,/, " #", tagtxt) }
        achou_sub = 0
        if (QL != "") {
          for (j = 1; j <= NFI[id]; j++) if (index(tolower(FTXT[FI[id, j]]), QL)) achou_sub = 1
          if (!index(tolower(TTXT[i] " " tagtxt " " TDESC[i]), QL) && !achou_sub) continue
        }
        if (AGENDA && TGRP[i] != grupo) {
          grupo = TGRP[i]
          if (vistas > 0) printf "\t\n"
          if (grupo == "A") printf "\t %sAtrasadas%s\n", VERM NEG, Z
          else printf "dia:%s\t %s%s%s  %s▦%s\n", grupo, SUB NEG, titulo_dia(grupo), Z, DIM, Z
        }
        vistas++
        aberto = (index(EXP, "," id ",") > 0 || achou_sub)
        linha_topo(i, aberto, tagtxt)
        if (aberto) detalhes(i)
      }
      if (Q != "" && ARQ) {
        if (vistas == 0) printf "\t   %snada no arquivo com “%s”%s\n", DIM, Q, Z
      } else if (Q != "") {
        printf "criar\t %s+ criar tarefa:%s %s%s%s  %s⏎%s\n", AZUL NEG, Z, AMAR, Q, Z, DIM, Z
        if (vistas == 0) printf "\t   %snenhuma tarefa existente com “%s”%s\n", DIM, Q, Z
      } else if (vistas == 0) {
        if (FILTRO == "hoje")         { m1 = "Nada vence hoje."; m2 = "Aproveite. As outras estão na aba Abertas." }
        else if (FILTRO == "feitas")  { m1 = "Nenhuma tarefa concluída ainda."; m2 = "Marque uma com ⏎, duplo clique ou ✓ Feita." }
        else if (FILTRO == "prazo")   { m1 = "Nada agendado."; m2 = "Use ◷ Prazo, ou escreva @sex 14h ao criar. ▦ Calendário mostra o mês." }
        else if (FILTRO == "arquivo") { m1 = "O arquivo está vazio."; m2 = "^l (ou ▤ Arquivar no menu ⋯) guarda as feitas aqui, sem perder o histórico." }
        else if (FILTRO == "abertas") { m1 = "Tudo feito por aqui!"; m2 = "Digite no campo acima e tecle ⏎ para criar outra." }
        else                          { m1 = "Nenhuma tarefa ainda."; m2 = "Digite no campo acima e tecle ⏎ para criar a primeira." }
        printf "\t\n\t   %s%s%s\n\t   %s%s%s\n\t\n\t   %s? mostra como usar o painel%s\n", TXT NEG, m1, Z, SUB, m2, Z, DIM, Z
      }
    }' "$arq"
}

# "Como usar": linhas da ajuda, no próprio painel (esc ou ‹ Voltar retorna à lista).
