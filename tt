  printf '\t   histórico; %s✕ Apagar de vez%s some sem histórico. Uma tarefa sozinha:\n' "$y" "$z"
  printf '\t   menu ⋯ → ▤ Arquivar (leva as subtarefas; subtarefa não vai sozinha).\n'
  printf '\t   A aba %sArquivo%s mostra o histórico (a busca vale lá dentro); abra uma\n' "$y" "$z"
  printf '\t   tarefa e clique em %s↩ restaurar%s para ela voltar como estava.\n' "$a" "$z"
