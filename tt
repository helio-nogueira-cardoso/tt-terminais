# O tmux não possui evento de movimento/hover. Num atalho sem menu (5ª coluna vazia), o botão direito funciona
# como tooltip explícito, mostrando o comando completo sem executar nada; o clique normal continua abrindo a sessão.
atalho_info() {
  local cliente=$1 i=$2 emoji id cmd cor
  IFS=$'\t' read -r emoji id cmd cor _ < <(atalhos_lista | sed -n "${i}p")
  [[ -n $cmd ]] || return 0
  tmux display-message -c "$cliente" "$emoji  $id: $cmd"
}

# --- Menu do botão direito dos atalhos ------------------------------------------------
#
# A 5ª coluna do atalho (opcional) dá a ele um menu no botão direito, com outros jeitos de rodar o mesmo atalho;
# o clique normal não muda. Itens separados por " ;; ":
#   @contas         uma opção por conta de IA desta máquina: o comando roda com {conta} → "--conta NOME". As contas
#                   saem do próprio comando, com {conta} → "--listar-contas" (o ia-conta abrir lista as dele e sai):
#                   assim valem as do ambiente em que o atalho roda, o que o perfil de atalhos da máquina define
#                   (o do celular entra no proot), sem o tt saber de nenhum.
#   @maquinas       uma opção por máquina do tt: o atalho de mesmo ID roda na máquina escolhida, numa sessão nova de
#                   lá (com o perfil de atalhos dela), e a tela vai para ela. No @seguir, a conversa vai para lá.
#   Rótulo=comando  opção fixa (o comando segue as regras do atalho: @aqui, {retomar}, {conta}…)
#   -               separador
# Clicado direto (ou no item do topo do menu), {conta} e {maquina} somem: o rotador escolhe; a máquina é esta.
ATALHO_SEP=' ;; '

atalho_por_id() { atalhos_lista | awk -F'\t' -v id="$1" '$2 == id { print; exit }'; }

# Tira as marcas que o tt preenche ({conta}, {maquina}, {prompt}; com 2º arg, também {retomar}).
sem_marcas() { # comando [tudo]
  local s=$1
  s=${s//\{conta\}/}; s=${s//\{maquina\}/}; s=${s//\{prompt\}/}
  [[ -n ${2:-} ]] && s=${s//\{retomar\}/}
  printf '%s' "$s"
}

# Contas do @contas: "conta<TAB>provedor<TAB>rótulo<TAB>uso", do próprio comando do atalho com {conta} →
# --listar-contas, no mesmo ambiente dele (bash -lc, como o atalho). Guardadas por comando: o menu abre na hora com
# a última lista (até um dia) e ela se renova em segundo plano depois de 2 min; sem lista guardada, espera até 15 s
# (entrar no proot do celular leva alguns segundos).
atalho_contas() { # comando
  local cmd f
  [[ $1 == *'{conta}'* ]] || return 0
  cmd=${1#@aqui }; cmd=$(sem_marcas "${cmd//\{conta\}/--listar-contas}" tudo)
  f=$RT/tt-atalho-contas-$UID-$(cksum <<<"$cmd" | cut -d' ' -f1)
  if [[ -s $f && -n $(find "$f" -mmin -1440 2>/dev/null) ]]; then
    cat "$f"
    [[ -z $(find "$f" -mmin -2 2>/dev/null) ]] && (atalho_contas_gerar "$cmd" "$f" &) >/dev/null 2>&1
    return 0
  fi
  atalho_contas_gerar "$cmd" "$f"
  cat "$f" 2>/dev/null
  return 0
}
atalho_contas_gerar() { # comando arquivo
  local t=$2.$BASHPID # (o nome fica fora do cano: dentro dele o $BASHPID é o do subshell)
  timeout 15 bash -lc "$1" </dev/null 2>/dev/null | awk -F'\t' 'NF >= 3 && $1 ~ /^[A-Za-z0-9][A-Za-z0-9_-]*$/' >"$t"
  if [[ -s $t ]]; then mv -f "$t" "$2"; else rm -f "$t"; fi
}

# Itens do menu do atalho ID (no formato do menu_popup). tt --atalho-menu-itens ID CLIENTE PAINEL.
atalho_menu_itens() { # id cliente painel
  local id=$1 c=$2 p=$3 emoji cmd cor menu item rot r d conta prov uso k=0 nfixa=0 seguir="" tecla
  local teclas=123456789abcdefghijklmnopqrstuvwxyz rodar
  IFS=$'\t' read -r emoji _ cmd cor menu < <(atalho_por_id "$id")
  [[ -n $cmd ]] || return 0
  [[ $cmd == @seguir* ]] && seguir=1
  rodar="$EU --atalho-rodar $(q "$id" "$c" "$p")"
  if [[ -n $seguir ]]; then rot="$emoji Seguir com outra IA aqui mesmo (o clique)"
  elif [[ $cmd == *'{conta}'* ]]; then rot="$emoji A de mais folga agora, pelo rotador (o clique)"
  else rot="$emoji Como no clique"; fi
  printf '0\t%s\t%s\n' "$rot" "$rodar"
  while [[ -n $menu ]]; do
    item=${menu%%"$ATALHO_SEP"*}
    [[ $item == "$menu" ]] && menu="" || menu=${menu#*"$ATALHO_SEP"}
    item=${item#"${item%%[![:space:]]*}"}; item=${item%"${item##*[![:space:]]}"}
    case $item in
      '') ;;
      -) printf -- '-\t\t\n' ;;
      @contas)
        printf -- '-\t\t\n'
        while IFS=$'\t' read -r conta prov rot uso; do
          [[ -n $conta ]] || continue
          [[ $uso == - ]] && uso=""
          tecla=${teclas:k:1} k=$((k + 1))
          printf '%s\t🤖 %s%s\t%s %s\n' "$tecla" "$rot" "${uso:+  ·  $uso}" "$rodar" "$(q "conta=$conta")"
        done < <(atalho_contas "$cmd")
        ;;
      @maquinas)
        printf -- '-\t\t\n'
        while read -r d r; do
          [[ $r == "$MAQUINA" ]] && continue
          tecla=${teclas:k:1} k=$((k + 1))
          if [[ -n $seguir ]]; then rot="$emoji Seguir em $r"; else rot="🖥 Em $r (sessão nova lá)"; fi
          printf '%s\t%s\t%s %s\n' "$tecla" "$rot" "$rodar" "$(q "maquina=$r")"
        done < <(maquinas)
        ;;
      *=*)
        nfixa=$((nfixa + 1)) tecla=${teclas:k:1} k=$((k + 1))
        printf '%s\t%s\t%s %s\n' "$tecla" "${item%%=*}" "$rodar" "$(q "opcao=$nfixa")"
        ;;
    esac
  done
  printf -- '-\t\t\n'
  printf ' \tℹ %s\t\n' "${cmd:0:70}"
  printf 'e\t✏ Editar os atalhos…\t%s\n' "$(popup_tt "$c" "✏ atalhos da barra" "$EU --editar-atalhos")"
}

# Botão direito num atalho: o menu dele, ou (sem a 5ª coluna) o comando, como antes.
atalho_menu() { # cliente índice painel
  local c=$1 i=$2 p=${3:-} emoji id cmd cor menu
  IFS=$'\t' read -r emoji id cmd cor menu < <(atalhos_lista | sed -n "${i}p")
  [[ -n $cmd ]] || return 0
  [[ -n $menu ]] || { atalho_info "$c" "$i"; return 0; }
  [[ -n $p ]] || p=$(do_cliente "$c" '#{pane_id}')
  atalho_menu_itens "$id" "$c" "$p" | menu_popup "$c" "$emoji $id"
}

# Roda o atalho ID como no clique ou com a escolha de um item do menu: conta=NOME, maquina=RÓTULO, opcao=N (a N-ésima
# opção fixa). tt --atalho-rodar ID CLIENTE PAINEL [ESCOLHA].
atalho_rodar() { # id cliente painel [escolha]
  local id=$1 c=$2 p=${3:-} esc=${4:-} emoji cmd cor menu pasta item n=0 v
  IFS=$'\t' read -r emoji _ cmd cor menu < <(atalho_por_id "$id")
  [[ -n $cmd ]] || { botao_aviso "$c" "atalho $id: não existe (mais) nesta máquina"; return 0; }
  [[ -n $p ]] || p=$(do_cliente "$c" '#{pane_id}')
  pasta=$(tmux display-message -p -t "$p" '#{pane_current_path}' 2>/dev/null); [[ -n $pasta ]] || pasta=$HOME
  v=${esc#*=}
  case $esc in
    conta=*)
      [[ $v =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || return 0
      cmd=${cmd//\{conta\}/--conta $v} ;;
    maquina=*)
      if [[ $v != "$MAQUINA" ]]; then atalho_na_maquina "$id" "$c" "$p" "$v" "$cmd" "$pasta"; return 0; fi ;;
    opcao=*)
      [[ $v =~ ^[0-9]+$ ]] || return 0
      while [[ -n $menu ]]; do
        item=${menu%%"$ATALHO_SEP"*}
        [[ $item == "$menu" ]] && menu="" || menu=${menu#*"$ATALHO_SEP"}
        [[ $item == *=* ]] || continue
        n=$((n + 1)); ((n == v)) && { cmd=${item#*=}; break; }
      done
      ((n == v)) || return 0 ;;
  esac
  atalho_comando "$c" "$p" "$pasta" "$cmd" "$id"
}

# Pasta como as outras máquinas a entendem: "~/…" se está na home desta (as homes mudam de máquina para máquina).
pasta_portavel() {
  case $1 in
    "$HOME") echo '~' ;;
    "$HOME"/*) echo "~/${1#"$HOME"/}" ;;
    *) echo "$1" ;;
  esac
}

# @maquinas: o atalho de mesmo ID roda na máquina R, numa sessão nova de lá (com o perfil de atalhos dela), e a
# tela vai para ela. O @seguir passa a conversa deste painel para lá.
atalho_na_maquina() { # id cliente painel rótulo comando pasta
  local id=$1 c=$2 p=$3 r=$4 cmd=$5 pasta=$6 d s
  if [[ $cmd == @seguir* ]]; then seguir_ia "$c" "$p" "$r"; return 0; fi
  d=$(dest_ir "$r")
  [[ -n $d && $d != . ]] || { botao_aviso "$c" "⚠ $r: máquina não cadastrada"; return 0; }
  tmux display-message -c "$c" -d 2000 "⟳ abrindo o atalho $id em $r…" 2>/dev/null
  s=$(timeout 20 ssh "${SSH_OPC[@]}" "$d" "$TT_REMOTO --atalho-sessao $(q "$id" "$(pasta_portavel "$pasta")")" </dev/null 2>/dev/null)
  [[ $s =~ ^[^[:space:]]+$ ]] || { botao_aviso "$c" "⚠ $r não abriu o atalho $id (sem resposta, ou o tt de lá não tem esse atalho)"; return 0; }
  _remota_confirmada=$d TT_CLIENTE=$c ir_para "$d" "$s"
}

# Sessão nova desta máquina rodando o comando de um atalho; imprime o nome.
atalho_nova_sessao() { # pasta comando id
  local nome
  nome=$(proximo_nome atalho)
  tmux new-session -d -s "$nome" -c "$1" "$(script_atalho "$(sem_marcas "$2" tudo)")" || return 1
  tmux set-option -w -t "=$nome:" @tt_papel atalho
  tmux set-option -w -t "=$nome:" @tt_atalho "$3"
  printf '%s\n' "$nome"
}

# O atalho ID numa sessão nova desta máquina (o @maquinas pedido de outra); imprime o nome da sessão.
atalho_sessao() { # id [pasta]
  local id=$1 pasta emoji cmd cor
  IFS=$'\t' read -r emoji _ cmd cor _ < <(atalho_por_id "$id")
  [[ -n $cmd && $cmd != @seguir* ]] || return 1
  pasta=$(expandir "${2:-$HOME}"); [[ -d $pasta ]] || pasta=$HOME
  atalho_nova_sessao "$pasta" "${cmd#@aqui }" "$id"
}

# Clique num botão da barra de baixo: RANGE CLIENTE PAINEL PASTA [X-DO-MOUSE].
atalhos_base() {
  local padrao=$ATALHOS_PADRAO
  e_mobile && [[ -f $DIR_TT/atalhos-padrao-mobile ]] && padrao=$DIR_TT/atalhos-padrao-mobile
  [[ -f $padrao ]] && sed '/^[[:space:]]*#/d;/^[[:space:]]*$/d' "$padrao"
  return 0
}

# A configuração local sobrescreve pelo ID (2ª coluna). Emoji '-' desativa um padrão; um ID
# novo adiciona um atalho. Assim o arquivo versionado continua recebendo melhorias sem apagar a
# personalização de cada máquina.
atalhos_lista() {
  local base localf
  base=$(mktemp "${RT:-/tmp}/tt-atalhos.XXXXXX") || return 1
  atalhos_base >"$base"
  localf=$CONF_ATALHOS
  e_mobile && localf=/dev/null
  [[ -f $localf ]] || localf=/dev/null
  # Padrões na ordem do pacote (trocados pela versão local do mesmo id; emoji "-" some), depois os
  # atalhos só locais, na ordem do arquivo. Cor vazia com menu depois sai "-": quem lê com IFS=tab juntaria os
  # dois tabs e o menu cairia no lugar da cor.
  awk -F '\t' -v b="$base" '
    function linha(l,   f, n, k) {
      n = split(l, f, "\t")
      if (n >= 5 && f[4] == "") { f[4] = "-"; l = f[1]; for (k = 2; k <= n; k++) l = l "\t" f[k] }
      return l
    }
    FILENAME == b { if ($2 != "" && !($2 in base)) { base[$2] = $0; ob[++nb] = $2 }; next }
    $2 != "" { if (!($2 in loc)) ol[++nl] = $2; loc[$2] = $0; em[$2] = $1 }
    END {
      for (i = 1; i <= nb; i++) { id = ob[i]; if (id in loc) { if (em[id] != "-") print linha(loc[id]) } else print linha(base[id]) }
      for (i = 1; i <= nl; i++) { id = ol[i]; if (!(id in base) && em[id] != "-") print linha(loc[id]) }
    }
  ' "$base" "$localf"
  rm -f "$base"
}

atalhos_barra() {
  local emoji id cmd cor i=0
  while IFS=$'\t' read -r emoji id cmd cor _; do
    [[ -n $emoji && -n $cmd ]] || continue
    [[ $cor =~ ^#[[:xdigit:]]{6}$ ]] || cor='#cba6f7'
    i=$((i + 1))
    printf '#[range=user|at%d]#[fg=#1e1e2e,bg=%s,bold] %s #[norange]#[default] ' "$i" "$cor" "$emoji"
  done < <(atalhos_lista)
}

# Script que um atalho roda: em bash -lc para que comandos editados com argumentos, pipes ou
# variáveis tenham o mesmo comportamento em qualquer máquina. Mantém o shell aberto e deixa o erro
# visível quando o programa não existe ou termina imediatamente.
# O Codex guarda as cores do terminal ao iniciar; o fundo precisa estar correto ANTES dele.
script_atalho() {
  local script quoted
  script="$(q "$EU") --reforcar-padrao >/dev/null 2>&1"$'\n'$1$'\nrc=$?\nif (( rc != 0 )); then printf "\\natalho terminou com código %d; shell mantido aberto\\n" "$rc"; fi\nexec "${SHELL:-bash}"'
  printf -v quoted '%q' "$script"
  printf 'bash -lc %s' "$quoted"
}

# Atalho "@aqui CMD": troca o que roda no painel (um agente, que é fechado, ou o shell) por CMD,
# no mesmo painel. {retomar} no CMD vira "--retomar ID" quando o painel tinha uma conversa do
# Claude (o ia-conta abrir a continua se a próxima conta também for do Claude), ou some.
atalho_aqui() {
  local cliente=$1 pane=$2 pasta=$3 cmd=$4 id=$5 sessao pid conversa=""
  [[ -n $pane ]] || pane=$(tmux display-message -p -c "$cliente" '#{pane_id}' 2>/dev/null)
  [[ -n $pane ]] || { botao_aviso "$cliente" "atalho: nenhum painel ativo"; return; }
  sessao=$(tmux display-message -p -t "$pane" '#{session_name}' 2>/dev/null)
  if [[ -n $(tmux show-options -qv -t "=$sessao:" @ponte 2>/dev/null) ]]; then
    botao_aviso "$cliente" "este painel é de outra máquina: use o atalho da barra de lá"; return
  fi
  pasta=$(tmux display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null || echo "$pasta")
  if pid=$(claude_no_painel "$pane") && [[ -n $pid ]]; then
    conversa=$(claude_info "$pid" 2>/dev/null | awk '{print $1}')
  fi
  [[ $conversa =~ ^[0-9a-fA-F-]{8,}$ ]] || conversa=""
  cmd=${cmd//\{retomar\}/${conversa:+--retomar $conversa}}
  # respawn -k fecha tudo o que roda no painel (agente e shell) e começa o novo ali mesmo.
  tmux respawn-pane -k -t "$pane" -c "$pasta" "$(script_atalho "$cmd")" || {
    botao_aviso "$cliente" "atalho: não consegui reabrir o painel"; return
  }
  tmux set-option -w -t "$pane" @tt_atalho "$id" 2>/dev/null || true # (o set já redesenha o cliente)
}

atalho_executar() {
  local i=$1 cliente=$2 pane=$3 pasta=${4:-$HOME} emoji id cmd cor
  IFS=$'\t' read -r emoji id cmd cor _ < <(atalhos_lista | sed -n "${i}p")
  [[ -n $cmd ]] || { tmux display-message -c "$cliente" "atalho indisponível" 2>/dev/null || true; return 0; }
  atalho_comando "$cliente" "$pane" "$pasta" "$cmd" "$id"
}

# O comando de um atalho, pelo clique ou pelo menu: "@seguir …" passa a conversa do painel adiante (nesta máquina),
# "@aqui …" troca o que roda no painel, "@janela …" roda numa janela flutuante sobre a tela (o 🎤), o resto abre numa
# sessão nova e a tela vai para ela.
atalho_comando() { # cliente painel pasta comando id
  local cliente=$1 pane=$2 pasta=$3 cmd=$4 id=$5 nome
  case $cmd in
    @seguir | '@seguir '*) seguir_ia "$cliente" "$pane" ""; return 0 ;;
    '@aqui '*) atalho_aqui "$cliente" "$pane" "$pasta" "$(sem_marcas "${cmd#@aqui }")" "$id"; return 0 ;;
    '@janela '*) atalho_janela "$cliente" "$pasta" "$(sem_marcas "${cmd#@janela }" tudo)" "$id"; return 0 ;;
  esac
  nome=$(atalho_nova_sessao "$pasta" "$cmd" "$id") || {
    botao_aviso "$cliente" "atalho: não consegui abrir a sessão"; return 0
  }
  tmux switch-client -c "$cliente" -t "=$nome" # (a troca de sessão já redesenha o cliente)
}

# Atalho "@janela CMD": o comando numa janela flutuante encostada na barra, à direita (a do 🎤); fecha quando ele
# termina. É um popup de verdade (um clique fora não a fecha: a conversa segue enquanto se olha a tela de baixo).
# O 🎤 (comando "voz …") é do aparelho onde você está: clicado numa ponte (você vê esta máquina de outra), a janela abre
# na máquina de origem, por cima da ponte, com o microfone e o som dela; a conversa já começa na sessão daqui.
atalho_janela() { # cliente pasta comando id
  local c=$1 pasta=$2 cmd=$3 id=$4 cw ch w=96 h=16 tit origem om op sess
  if [[ $cmd == 'voz '* ]] && origem=$(origem_ponte "$c") && [[ -n $origem && $origem == *'|'* ]]; then
    om=${origem%%|*} op=${origem#*|}
    sess=$(do_cliente "$c" '#{session_name}')
    pedir_na_origem "$om" --janela-ponte "$op" "$cmd" "$MAQUINA" "$sess" && return 0
    botao_aviso "$c" "⚠ 🎤 não consegui abrir na máquina de origem ($om); abrindo aqui"
  fi
  # até 96 colunas e quase a altura toda (a conversa do 🎤 rola por dentro: roda do mouse, PgUp/PgDn), até 60 linhas
  read -r cw ch < <(do_cliente "$c" '#{client_width} #{client_height}')
  [[ $cw =~ ^[0-9]+$ ]] && ((cw < w + 2)) && w=$((cw > 22 ? cw - 2 : 20))
  [[ $ch =~ ^[0-9]+$ ]] && { h=$((ch - 6)); ((h > 60)) && h=60; ((h < 6)) && h=6; }
  tit=$(atalho_por_id "$id" | cut -f1); tit="${tit:+$tit }$id"
  popup_fixo -c "$c" -E -w "$w" -h "$h" -x R -y S -T " $tit " -d "${pasta:-$HOME}" -e TT_EM_JANELA=1 \
    "bash -lc $(q "PATH=\"\$HOME/.local/bin:$DIR_TT:\$PATH\"; $cmd")"
}

# Pedido de uma máquina vista por esta numa ponte: abre o comando (o 🎤) na janela do cliente daqui que olha a ponte P
# (o último que agiu, como no --ir-ponte). Na conversa, a sessão-alvo já é a que estava na tela de lá.
janela_ponte() { # ponte comando máquina-de-lá sessão-de-lá
  local p=$1 cmd=$2 m=$3 s=$4 c
  [[ $cmd == 'voz '* ]] || return 1
  prazo_vencido && return 1
  tmux has-session -t "=$p" 2>/dev/null || return 1
  c=$(tmux list-clients -t "=$p" -F '#{client_activity} #{client_name}' 2>/dev/null | sort -rn | awk 'NR == 1 { print $2 }')
  [[ -n $c ]] || return 1
  [[ $cmd == *--conversa* && -n $m && -n $s ]] && "$HOME/.local/bin/voz" --alvo "$m" "$s" >/dev/null 2>&1
  ( atalho_janela "$c" "$HOME" "$cmd" voz & ) >/dev/null 2>&1
  return 0
}

# O 🎤 pela tecla (Ctrl+B v): o atalho "voz" desta máquina, como o clique nele; escondido da barra, a conversa de sempre.
atalho_voz() { # cliente painel pasta
  local cmd
  cmd=$(atalho_por_id voz | cut -f3)
  atalho_comando "$1" "$2" "${3:-$HOME}" "${cmd:-@janela voz --conversa}" voz
}

# --- ⏩ Seguir a conversa com outra IA ------------------------------------------------
#
# O atalho "@seguir CMD" acha a conversa de IA do painel (Claude, Codex ou Kiro) e o código dela, encerra o agente e
# abre outra IA com CMD (o padrão é "ia-conta abrir {prompt}": o rotador escolhe a conta de mais folga), pedindo que
# leia a conversa inteira e siga o trabalho de onde parou; {prompt} vira "--prompt-arquivo ARQ". Nesta máquina, a
# nova IA abre no mesmo painel. Em outra (menu @maquinas), numa sessão nova de lá, com o @seguir DELA (o perfil de
# atalhos de cada máquina sabe abrir a IA ali), e a tela vai para lá; o agente daqui só fecha depois que a de lá
# abriu. A conversa vai em Markdown (tt --conversa-ia CÓDIGO --de MÁQUINA, pela rede do tt) para
# ~/.cache/tt/conversas/CÓDIGO.md na máquina da nova IA antes de ela começar.

# "provedor pid pids" do agente de IA que roda no painel (o mais perto da raiz do painel) e todos os processos do
# painel (separados por vírgula); nada se não houver agente.
agente_no_painel() { # painel
  local raiz
  raiz=$(tmux display-message -p -t "$1" '#{pane_pid}' 2>/dev/null)
  [[ $raiz =~ ^[0-9]+$ ]] || return 1
  { if [[ -n ${PS_CACHE:-} ]]; then echo "$PS_CACHE"; else ps -eo pid=,ppid=,comm=; fi; } | awk -v raiz="$raiz" '
    { pai[$1] = $2; n = $3; sub(/.*\//, "", n); cmd[$1] = n } # no Termux, um binário fora do PATH aparece com o caminho
    END {
      for (p in cmd) {
        d = 0
        for (q = p; q in pai && q != 1 && q != raiz; q = pai[q]) d++
        if (q != raiz) continue
        todos = todos (todos == "" ? "" : ",") p
        n = cmd[p]
        if (n == "claude") prov = "claude"; else if (n ~ /^codex/) prov = "codex"; else if (n ~ /^kiro-cli/ || n == "kiro") prov = "kiro"; else continue
        if (melhor == "" || d < dm) { melhor = prov " " p; dm = d }
      }
      if (melhor == "") exit 1
      print melhor, raiz "," todos
    }'
}

# "provedor pid código" da conversa do agente no painel P. O Claude registra o código pelo pid; o Kiro e o Codex
# são achados pelo sessoes-ia.py (trava do Kiro com o pid; conversa do Codex na mesma pasta, mexida desde que o
# agente começou, desempatada pela tela do painel).
conversa_do_painel() { # painel
  local p=$1 prov pid pids id="" tela
  read -r prov pid pids < <(agente_no_painel "$p") || return 1
  [[ -n $pid ]] || return 1
  [[ $prov == claude ]] && id=$(claude_info "$pid" 2>/dev/null | awk '{ print $1 }')
  if [[ -z $id ]]; then
    tela=$(mktemp "$RT/tt-tela.XXXXXX") || return 1
    tmux capture-pane -p -t "$p" -S -60 >"$tela" 2>/dev/null
    id=$(python3 -I "$DIR_TT/sessoes-ia.py" achar --provedor "$prov" --pid "$pid" --pids "$pids" --tela "$tela" 2>/dev/null | cut -f2)
    rm -f "$tela"
  fi
  [[ $id =~ ^[0-9A-Za-z][0-9A-Za-z_-]{6,}$ ]] || return 1
  printf '%s %s %s\n' "$prov" "$pid" "$id"
}

# A conversa de código ID em Markdown, desta máquina ou de --de MÁQUINA (pela rede do tt). --salvar grava em
# ~/.cache/tt/conversas/ID.md e diz onde. tt --conversa-ia ID [--de MÁQUINA] [--salvar].
conversa_ia() { # id [--de máquina] [--salvar]
  local id=${1:-} de="" salvar="" d f
  shift || true
  while (($#)); do
    case $1 in --de) de=${2:-}; shift ;; --salvar) salvar=1 ;; *) echo "tt: --conversa-ia: opção desconhecida $1" >&2; return 2 ;; esac
    shift
  done
  [[ $id =~ ^[0-9A-Za-z][0-9A-Za-z_-]{6,}$ ]] || { echo "uso: tt --conversa-ia CÓDIGO [--de MÁQUINA] [--salvar]" >&2; return 2; }
  [[ $de == "$MAQUINA" ]] && de=""
  if [[ -n $salvar ]]; then
    mkdir -p "$HOME/.cache/tt/conversas"; f=$HOME/.cache/tt/conversas/$id.md
    printf '⟳ buscando a conversa %s%s…\n' "$id" "${de:+ em $de}"
    if conversa_ia "$id" ${de:+--de "$de"} >"$f.$$" && [[ -s $f.$$ ]]; then
      mv -f "$f.$$" "$f"; printf '✓ %s (%d KB)\n' "$f" $(($(wc -c <"$f") / 1024)); return 0
    fi
    rm -f "$f.$$"; echo "⚠ não consegui a conversa $id${de:+ de $de}" >&2; return 1
  fi
  if [[ -z $de ]]; then python3 -I "$DIR_TT/sessoes-ia.py" exportar "$id"; return; fi
  d=$(dest_de "$de")
  [[ -n $d ]] || { echo "tt: $de não está cadastrada ou está desligada" >&2; return 1; }
  ssh "${SSH_OPC[@]}" "$d" "$TT_REMOTO --conversa-ia $(q "$id")" </dev/null
}

# Comando do @seguir desta máquina, sem o "@seguir " (o do perfil, mesmo desativado na barra).
seguir_cmd() {
  local emoji id cmd
  while IFS=$'\t' read -r emoji id cmd _; do
    [[ $cmd == '@seguir '* ]] && { printf '%s\n' "${cmd#@seguir }"; return 0; }
  done < <(atalhos_lista; atalhos_base)
  return 1
}

# O pedido para a nova IA.
seguir_pedido() { # origem provedor código pasta-lá pasta-aqui arquivo-da-conversa
  local o=$1 prov=$2 id=$3 la=$4 aqui=$5 conv=$6 d n=3
  cat <<EOF
Você vai continuar o trabalho de outra IA. A conversa dela foi encerrada para seguir aqui com você (o tt-terminais
passou a conversa adiante, em geral porque a conta dela estava ficando sem créditos).

- Conversa: $prov, código $id
- Máquina de origem: $o · pasta lá: $la
- Você está em: $MAQUINA · pasta aqui: $aqui

1. Antes de qualquer outra coisa, leia a conversa inteira: $conv (Markdown; leia todo o arquivo, em partes se ele
   for grande). Se ele não existir ou parecer incompleto, gere de novo com: tt --conversa-ia $id --de $o --salvar
2. Siga de forma integral o trabalho que ela estava fazendo, como se fosse ela: os mesmos objetivos, as decisões já
   tomadas e as instruções do usuário que continuam valendo. Não refaça o que já foi feito: confira o estado real
   (arquivos, git, testes, processos) e retome do ponto em que ela parou.
EOF
  if [[ $o != "$MAQUINA" ]]; then
    d=$(dest_de "$o")
    printf '%s. Os arquivos do trabalho estão na máquina %s. Para lê-los ou mudá-los, entre nela pela rede do tt: ssh %s\n' "$n" "$o" "${d:-<veja ~/.config/tt/maquinas>}"
    printf '   (as máquinas do tt estão em ~/.config/tt/maquinas; tt --help mostra o resto).\n'
    n=$((n + 1))
  fi
  printf '%s. Comece dizendo, em poucas linhas, o que estava sendo feito e qual é o próximo passo; depois continue.\n' "$n"
}

# Abre a nova IA desta máquina para seguir a conversa (a ⏩): escreve o pedido, monta o comando com o @seguir daqui e
# abre numa sessão nova (imprime o nome) ou, com PAINEL, no lugar do que roda nele. tt --seguir-abrir ORIGEM
# PROVEDOR CÓDIGO PASTA (pasta de lá; "~/…" quando está na home de lá).
seguir_abrir() { # origem provedor código pasta [painel pasta-do-painel]
  local o=$1 prov=$2 id=$3 la=$4 p=${5:-} cmd arq conv aqui script nome
  cmd=$(seguir_cmd) || { echo "tt: nenhum atalho @seguir nesta máquina" >&2; return 1; }
  [[ $cmd == *'{prompt}'* ]] || { echo "tt: o atalho @seguir daqui não tem {prompt} no comando" >&2; return 1; }
  [[ $id =~ ^[0-9A-Za-z][0-9A-Za-z_-]{6,}$ ]] || return 1
  aqui=$(expandir "$la"); [[ -d $aqui ]] || aqui=$HOME
  [[ $la == '~'* && $o != "$MAQUINA" ]] && la="$la (na home de $o)"
  mkdir -p "$HOME/.cache/tt/seguir" || return 1
  conv=$HOME/.cache/tt/conversas/$id.md
  arq=$HOME/.cache/tt/seguir/$id-$(date +%Y%m%d-%H%M%S).md
  seguir_pedido "$o" "$prov" "$id" "$la" "$aqui" "$conv" >"$arq" || return 1
  # A conversa vem antes da IA (do próprio Termux/PC, fora do ambiente do agente): a IA já começa com ela no disco.
  script="$(q "$EU") --conversa-ia $(q "$id") --de $(q "$o") --salvar"$'\n'"$(sem_marcas "${cmd//\{prompt\}/--prompt-arquivo $(q "$arq")}" tudo)"
  if [[ -n $p ]]; then
    tmux respawn-pane -k -t "$p" -c "${6:-$aqui}" "$(script_atalho "$script")" || return 1
    tmux set-option -w -t "$p" @tt_atalho ia-seguir 2>/dev/null || true
    return 0
  fi
  nome=$(proximo_nome atalho)
  tmux new-session -d -s "$nome" -c "$aqui" "$(script_atalho "$script")" || return 1
  tmux set-option -w -t "=$nome:" @tt_papel atalho
  tmux set-option -w -t "=$nome:" @tt_atalho ia-seguir
  printf '%s\n' "$nome"
}

# A ⏩: a conversa de IA do painel segue com outra IA, nesta máquina (no mesmo painel) ou na de rótulo R.
seguir_ia() { # cliente painel [rótulo-destino]
  local c=$1 p=${2:-} r=${3:-} sessao prov pid id pasta la d s
  [[ -n $r ]] || r=$MAQUINA
  [[ -n $p ]] || p=$(do_cliente "$c" '#{pane_id}')
  [[ -n $p ]] || { botao_aviso "$c" "⏩ nenhum painel ativo"; return 0; }
  sessao=$(tmux display-message -p -t "$p" '#{session_name}' 2>/dev/null)
  if [[ -n $(tmux show-options -qv -t "=$sessao:" @ponte 2>/dev/null) ]]; then
    botao_aviso "$c" "este painel é de outra máquina: use o ⏩ da barra de lá"; return 0
  fi
  if ! read -r prov pid id < <(conversa_do_painel "$p") || [[ -z $id ]]; then
    botao_aviso "$c" "⏩ não achei uma conversa de IA (Claude, Codex ou Kiro) neste painel"; return 0
  fi
  pasta=$(tmux display-message -p -t "$p" '#{pane_current_path}' 2>/dev/null); [[ -n $pasta ]] || pasta=$HOME
  # A pasta do agente como ele a vê (o /proc mostra a de dentro de um proot com a raiz dele na frente).
  la=$(cwd_do_pid "$pid" || echo "$pasta")
  la=$(sed -E 's#^.*/proot-distro/(containers/[^/]+/rootfs|installed-rootfs/[^/]+)(/|$)#/#' <<<"$la")
  if [[ $r == "$MAQUINA" ]]; then
    seguir_abrir "$MAQUINA" "$prov" "$id" "$la" "$p" "$pasta" || { botao_aviso "$c" "⚠ ⏩ não consegui abrir a nova IA (veja o atalho @seguir)"; return 0; }
    botao_aviso "$c" "⏩ a conversa $prov ${id:0:8} segue com outra IA neste painel"
    return 0
  fi
  d=$(dest_ir "$r")
  [[ -n $d && $d != . ]] || { botao_aviso "$c" "⚠ $r: máquina não cadastrada"; return 0; }
  tmux display-message -c "$c" -d 3000 "⏩ passando a conversa para $r…" 2>/dev/null
  s=$(timeout 30 ssh "${SSH_OPC[@]}" "$d" "$TT_REMOTO --seguir-abrir $(q "$MAQUINA" "$prov" "$id" "$(pasta_portavel "$la")")" </dev/null 2>/dev/null)
  if [[ ! $s =~ ^[^[:space:]]+$ ]]; then
    botao_aviso "$c" "⚠ $r não abriu a nova IA; a conversa continua aqui"; return 0
  fi
  # Lá já abriu: o agente daqui fecha (o painel fica num shell, com o recado de onde a conversa seguiu).
  tmux respawn-pane -k -t "$p" -c "$pasta" "$(script_atalho "printf '%s\n' $(q "⏩ esta conversa ($prov $id) seguiu em $r, na sessão $s")")" 2>/dev/null
  _remota_confirmada=$d TT_CLIENTE=$c ir_para "$d" "$s"
}

# --- Rolagem nos chips da barra ---------------------------------------------------------
#
# A roda do mouse em "máquina ▾" troca de máquina e em "sessão ▾", de sessão (no resto da barra, o padrão do tmux:
# janela anterior/seguinte). Para baixo = a seguinte, para cima = a anterior, dando a volta.

# Rolagem em rajada: cada dente da roda (e cada passo do arrasto no celular) é um evento, e uma rolagem longa manda
# vários. Um passo por vez por tela: enquanto um anda, os outros eventos caem; depois dele, MS ms de folga
# (TT_ROLAR_FOLGA muda a folga, em ms, das duas rodas).
rolar_vez() { # chave ms → 0 = este evento leva o passo (rolar_fim fecha a marca)
  local -; set -C
  local f=$RT/tt-rolar-$UID-${1//[^A-Za-z0-9_-]/_} ms=$2 agora fim="" dono="" desde=""
  agora=${EPOCHREALTIME/[.,]/}
  { read -r fim <"$f.fim"; } 2>/dev/null
  [[ $fim =~ ^[0-9]+$ ]] && ((agora >= fim && agora - fim < ms * 1000)) && return 1
  if ! { printf '%s %s\n' "$BASHPID" "$agora" >"$f"; } 2>/dev/null; then
    { read -r dono desde <"$f"; } 2>/dev/null
    # Dono vivo há menos de 30 s: o passo dele ainda anda. Morto (ou preso): a marca é tomada.
    [[ $dono =~ ^[0-9]+$ && $desde =~ ^[0-9]+$ ]] && ((agora - desde < 30000000)) && kill -0 "$dono" 2>/dev/null && return 1
    rm -f "$f"
    { printf '%s %s\n' "$BASHPID" "$agora" >"$f"; } 2>/dev/null || return 1
  fi
  return 0
}
rolar_fim() {
  local f=$RT/tt-rolar-$UID-${1//[^A-Za-z0-9_-]/_}
  printf '%s\n' "${EPOCHREALTIME/[.,]/}" >|"$f.fim"
  rm -f "$f"
}

# Sessões desta máquina na ordem da roda: a do tmux (a do Ctrl+B ( e ), por nome), sem pontes (são de outra
# máquina) nem ocultas (_nome). Ordem fixa de propósito: pela atividade, como na lista, a sessão em que se chega
# redesenha, sobe para o topo e a roda ficava indo e voltando entre duas.
sessoes_roda() {
  tmux list-sessions -F $'#{session_name}\x1f#{@ponte}' 2>/dev/null | awk -F'\037' '$2 == "" && $1 !~ /^_/ { print $1 }'
}

# Leva o cliente C desta máquina à sessão S da máquina de rótulo R (desta, direto; de outra, por ponte), como o
# ir_ponte, mas pelo cliente. Não depende de rodar dentro do tmux: o pedido pode vir por ssh, da barra de outra máquina.
levar_cliente() { # cliente rótulo sessão
  local c=$1 r=$2 s=$3 alvo dest
  if [[ $r == "$MAQUINA" ]]; then alvo=$s
  else
    dest=$(dest_de "$r"); [[ -n $dest ]] || return 1
    alvo=$(criar_ponte "$dest" "$s" "$c") || return 1
  fi
  fecha_ciclo "$alvo" "$(contem_cliente "$c")" && return 1
  tmux switch-client -c "$c" -t "=$alvo"
}

# A primeira sessão da lista desta máquina (a do seletor: a de atividade mais recente, as vazias por último).
primeira_sessao() { listar_leve | awk -F'\t' '$1 != "" && $1 !~ /^!/ { print $1; exit }'; }

rolar_sessao() { # cliente ±1
  local c=$1 dir=$2 atual alvo i=-1 k n
  local -a L=()
  rolar_vez "s-$c" "${TT_ROLAR_FOLGA:-150}" || return 0
  atual=$(do_cliente "$c" '#{session_name}')
  mapfile -t L < <(sessoes_roda)
  n=${#L[@]}
  for k in "${!L[@]}"; do [[ ${L[k]} == "$atual" ]] && { i=$k; break; }; done
  if ((n == 0)) || ((n == 1 && i == 0)); then
    botao_aviso "$c" "só há esta sessão em $MAQUINA"; rolar_fim "s-$c"; return 0
  fi
  if ((i < 0)); then ((dir > 0)) && alvo=${L[0]} || alvo=${L[n - 1]}
  else alvo=${L[(i + dir + n) % n]}; fi
  levar_cliente "$c" "$MAQUINA" "$alvo"
  rolar_fim "s-$c"
}

# Máquina que não respondeu à roda há menos de 1 min: a próxima rolagem nem tenta (sem ficar esperando a cada passo).
rolar_falhou() { # rótulo [marcar]
  local f=$RT/tt-rolar-falha-$UID-${1//[^A-Za-z0-9_-]/_} t="" agora
  printf -v agora '%(%s)T' -1
  if [[ -n ${2:-} ]]; then printf '%s\n' "$agora" >"$f"; return 0; fi
  { read -r t <"$f"; } 2>/dev/null
  [[ $t =~ ^[0-9]+$ ]] && ((agora - t < ${TT_T_ROLAR_FALHA:-60}))
}

# Leva o cliente C (desta máquina) à máquina antes ou depois da ATUAL, na ordem do cabeçalho da central (esta
# primeiro, depois as cadastradas e ligadas), para a primeira sessão da lista de lá (ou uma nova, se não houver
# nenhuma). Máquina que não responde em ~3 s é pulada, com aviso, e segue para a próxima, até dar a volta.
rolar_maquina_cliente() { # cliente rótulo-atual ±1
  local c=$1 atual=$2 dir=$3 i=0 j k n r d s saida pulei=""
  local -a R=() D=()
  rolar_vez "m-$c" "${TT_ROLAR_FOLGA:-400}" || return 0
  R=("$MAQUINA"); D=(.)
  while read -r d r; do [[ -n $r ]] && R+=("$r") D+=("$d"); done < <(maquinas)
  n=${#R[@]}
  for k in "${!R[@]}"; do [[ ${R[k]} == "$atual" ]] && { i=$k; break; }; done
  for ((k = 1; k < n; k++)); do
    j=$(((i + dir * k) % n)); ((j < 0)) && j=$((j + n))
    r=${R[j]} d=${D[j]}
    [[ $r == "$atual" ]] && continue
    if [[ $d == . ]]; then
      s=$(primeira_sessao)
      [[ -n $s ]] || s=$("$EU" --nova 2>/dev/null)
      [[ -n $s ]] || continue
      levar_cliente "$c" "$MAQUINA" "$s"
      rolar_fim "m-$c"; return 0
    fi
    if rolar_falhou "$r"; then pulei+=" $r"; continue; fi
    tmux display-message -c "$c" -d 1500 "⟳ $r…${pulei:+ (pulei:$pulei, sem resposta)}" 2>/dev/null
    if ! saida=$(timeout "${TT_T_ROLAR:-3}" ssh -o ConnectTimeout=2 "${SSH_OPC[@]}" "$d" "$TT_REMOTO --listar-leve" </dev/null 2>/dev/null); then
      rolar_falhou "$r" marcar; pulei+=" $r"; continue
    fi
    s=$(awk -F'\t' '$1 != "" && $1 !~ /^!/ { print $1; exit }' <<<"$saida")
    if [[ -z $s ]]; then
      s=$(timeout 5 ssh "${SSH_OPC[@]}" "$d" "$TT_REMOTO --nova" </dev/null 2>/dev/null)
      [[ $s =~ ^[^[:space:]]+$ ]] || { rolar_falhou "$r" marcar; pulei+=" $r"; continue; }
    fi
    levar_cliente "$c" "$r" "$s"
    [[ -n $pulei ]] && botao_aviso "$c" "⚠ sem resposta, pulei:$pulei"
    rolar_fim "m-$c"; return 0
  done
  if ((n < 2)); then botao_aviso "$c" "só há esta máquina no tt"
  else botao_aviso "$c" "⚠ nenhuma outra máquina respondeu${pulei:+ (pulei:$pulei)}"; fi
  rolar_fim "m-$c"
}

# Na máquina de origem (a da tela): o aparelho que está na PONTE vai para a máquina antes/depois de ATUAL.
# tt --rolar-ponte PONTE RÓTULO-ATUAL ±1 (pedido pela barra da outra máquina).
rolar_ponte() { # ponte rótulo-atual ±1
  local c
  prazo_vencido && return 1
  c=$(tmux list-clients -t "=$1" -F '#{client_activity} #{client_name}' 2>/dev/null | sort -rn | awk 'NR == 1 { print $2 }')
  [[ -n $c ]] || return 1
  rolar_maquina_cliente "$c" "$2" "$3"
}

# Roda do mouse num chip da barra: tt --rolar RANGE ±1 CLIENTE (do tmux.conf).
rolar() { # range ±1 cliente
  local faixa=${1#user|} dir=$2 c=$3 origem om op d
  [[ $dir == -1 || $dir == +1 || $dir == 1 ]] || return 0
  dir=$((dir))
  [[ -n $c ]] || return 0
  case $faixa in
    sessao) rolar_sessao "$c" "$dir" ;;
    fixmais)  # a roda no chip "+N ▾": para cima gira as do chip com a última visível; para baixo, todas
      rolar_vez "fx-$c" "${TT_ROLAR_FOLGA:-400}" || return 0
      fixadas_girar "$c" "$( ((dir < 0)) && echo cima || echo baixo)"
      rolar_fim "fx-$c" ;;
    maquina)
      # Vendo esta máquina de outra (ponte): quem troca a tela é a máquina de lá, na ordem das máquinas dela.
      origem=$(origem_ponte "$c")
      om=${origem%%|*} op=${origem#*|}
      if [[ -z $origem || -z $op ]]; then rolar_maquina_cliente "$c" "$MAQUINA" "$dir"; return 0; fi
      rolar_vez "m-$c" "${TT_ROLAR_FOLGA:-400}" || return 0
      if ! pedir_na_origem "$om" --rolar-ponte "$op" "$MAQUINA" "$dir"; then
        botao_aviso "$c" "⚠ não consegui falar com $om (a máquina desta tela) para trocar de máquina"
      fi
      rolar_fim "m-$c" ;;
  esac
  return 0
}

clique() {
  export TT_X=$(( ${5:-0} > 4 ? ${5:-0} - 4 : 0 ))
  # Algumas versões/configurações do tmux devolvem o tipo junto no range (user|at1).
  # Normalizar aqui evita que um clique válido seja descartado silenciosamente.
  local faixa=${1#user|}
  local marca="$RT/tt-clique-$UID" agora anterior cliente_anterior faixa_anterior
  # O 📌/📍 alterna, então age só ao PRESSIONAR (6º argumento d). O soltar (u) é ignorado: num toque lento (> 0,5 s)
  # os dois eventos passavam do debounce abaixo e o pino fixava e desafixava na mesma volta. Sem o 6º argumento
  # (CLI, testes) age como sempre.
  [[ $faixa == fixar && ${6:-} == u ]] && return 0
  vigia_garantir
  agora=${EPOCHREALTIME/[.,]/}000 # ns (com a precisão de µs), como o date +%s%N, sem processo
  if read -r anterior cliente_anterior faixa_anterior 2>/dev/null <"$marca" &&
     [[ $cliente_anterior == "$2" && $faixa_anterior == "$faixa" ]] &&
     ((agora - anterior < 500000000)); then
    return 0
  fi
  printf '%s %s %s\n' "$agora" "$2" "$faixa" >"$marca"
  case $faixa in
    window) tmux select-window -t = ;;
    maquina) menu_maquinas "$2" "$3" ;;
    arquivos) menu_arquivos "$2" "$3" ;;
    email) botao_email "$2" ;;
    transferencias) eval "$(popup_tt "$2" "⇅ transferências" "$EU --transferencias")" ;;
    copias) eval "$(popup_tt "$2" "📋 cópias" "TT_CLIENTE=$2 TT_PANE=$3 $EU --copias")" ;;
    at[0-9]*) atalho_executar "${faixa#at}" "$2" "$3" "${4:-$HOME}" ;;
    voz) atalho_voz "$2" "$3" "${4:-$HOME}" ;;
    ajustar) ajustar "$2" ;;
    sessao) seletor_em "$2" "$MAQUINA" "$3" ;;
    fxx*) desafixar_item "$2" "${faixa#fxx}" ;;
    fixprev | fixnext | fixmais) fixadas_popup "$2" ;;
    fixar) fixar_atual "$2" ;;
    fx*) ir_fixada "$2" "$faixa" ;;
    tarefas) abrir_tarefas "$2" ;;
    snapshots) eval "$(popup_tt "$2" "📸 snapshots" "$EU --snapshots")" ;;
    entrada) tarefas_filtro_set entrada; abrir_tarefas "$2" ;;   # chip 📥: direto na Entrada
    em_*) email_botao_acao "${faixa#em_}" ;;
    notifs) notifs_popup "$2" ;;
    notifx) notifs_clique "$2" ;;
    letreiro) letreiro_clique "$2" "${5:-0}" ;;
    relogio) abrir_calendario "$2" ;;
    tt) tmux display-popup -c "$2" -E $(tam_popup "$2") "TT_CLIENTE=$(q "$2") TT_PANE=$3 $EU" ;;
    lado) tmux split-window -h -t "$3" -c "$4" ;;
    baixo) tmux split-window -v -t "$3" -c "$4" ;;
    painel) menu_painel "$2" "$3" ;;
  esac
}

# --- Arquivos entre máquinas -----------------------------------------------
#
# Navegador de pastas (→ entra, ← sobe, Tab marca arquivos ou pastas inteiras, ⏎ confirma) numa
# máquina, escolha da máquina e da pasta de destino, e cópia por tar+ssh (de/para qualquer máquina,
# inclusive entre duas outras). Pastas são empacotadas recursivamente. Nada é sobrescrito: se já
# existe, chega como "nome (2)". Quem recebe vê um aviso na tela.

# wsl | termux | linux
tipo_maquina() {
  # Termux primeiro: o PREFIX do Termux é sinal explícito e nunca existe no WSL; testar o WSL
  # antes fazia PREFIX=…com.termux não valer lá (perfil mobile nunca escolhido).
  if [[ ${PREFIX:-} == *com.termux* ]]; then echo termux
  elif grep -qi microsoft /proc/version 2>/dev/null; then echo wsl
  else echo linux; fi
}

# Esta maquina e um ambiente mobile (celular com Termux)? Vale para o perfil de atalhos:
# no Termux os agentes rodam dentro de um Debian via proot, nao direto no shell, e nao ha
# o diretorio de contas do claude-conta local. Detecta pela plataforma, sem fixar o nome.
e_mobile() { [[ $(tipo_maquina) == termux ]]; }

# Como a pasta aparece para quem usa esta máquina: no WSL, o caminho do Windows (C:\… ou
# \\wsl.localhost\…, que o Explorer não mostra sozinho); no Termux, se está no armazenamento do
# Android (visível no app de arquivos) ou só dentro do Termux.
caminho_visivel() {
  local d
  d=$(expandir "$1")
  case $(tipo_maquina) in
    wsl)
      if [[ $d == /mnt/[a-z]/* ]]; then echo "$(wslpath -w "$d" 2>/dev/null || echo "$d")  (aparece no Explorer)"
      else echo "$(wslpath -w "$d" 2>/dev/null || echo "$d")  (só dentro do WSL, fora das pastas do Windows)"; fi ;;
    termux)
      local r; r=$(readlink -f "$d" 2>/dev/null || echo "$d")
      if [[ $r == /storage/emulated/0/* ]]; then echo "Armazenamento interno/${r#/storage/emulated/0/}  (aparece no app de arquivos)"
      else echo "$d  (só dentro do Termux)"; fi ;;
    *) echo "$d" ;;
  esac
}

# Pasta padrão onde ESTA máquina recebe arquivos: "recebidos=" no config. Sem ele: no WSL, a pasta
# Downloads\Recebidos do Windows (aparece no Explorer; descoberta uma vez e gravada no config);
# nas outras, ~/Recebidos.
pasta_recebidos() {
  local p u
  p=$(conf recebidos)
  if [[ -z $p ]] && grep -qi microsoft /proc/version 2>/dev/null; then
    u=$(cd /mnt/c 2>/dev/null && timeout 5 /mnt/c/Windows/System32/cmd.exe /c 'echo %USERNAME%' 2>/dev/null | tr -d '\r')
    if [[ -n $u && -d /mnt/c/Users/$u/Downloads ]]; then
      p="/mnt/c/Users/$u/Downloads/Recebidos"
      mkdir -p "$CONF_DIR"; echo "recebidos=$p" >>"$CONF"
    fi
  fi
  if [[ -z $p && $(tipo_maquina) == termux && -d $HOME/storage/downloads ]]; then
    p='~/storage/downloads/Recebidos'
  fi
  echo "${p:-~/Recebidos}"
}

# Grava a pasta padrão de recebidos desta máquina (sem argumento: escolhe navegando).
definir_recebidos() {
  local p=${1:-}
  if [[ -z $p ]]; then
    p=$(escolher_arquivos . "$(pasta_recebidos)" "pasta padrão de recebidos" pasta) || return 0
  fi
  [[ -n $p ]] || return 0
  mkdir -p "$(expandir "$p")" || { echo "Não consegui criar $p"; return 1; }
  mkdir -p "$CONF_DIR"
  grep -v '^recebidos=' "$CONF" 2>/dev/null >"$CONF.novo"; echo "recebidos=$p" >>"$CONF.novo"; mv "$CONF.novo" "$CONF"
  echo "✓ Os arquivos enviados para $MAQUINA passam a chegar em: $(caminho_visivel "$p")"
}

# tt --pasta-padrao [caminho | máquina:caminho | máquina]
pasta_padrao_cli() {
  local a=${1:-} maq dest p
  if [[ -z $a ]]; then definir_recebidos; return; fi
  maq=${a%%:*}; dest=$(dest_de "$maq")
  if [[ -n $dest && $dest != . && ( $a == *:* || $a == "$maq" ) ]]; then
    [[ $a == *:* ]] && p=${a#*:} || p=$(escolher_arquivos "$dest" "$(rodar "$dest" --pasta-recebidos)" "pasta padrão de $maq" pasta) || return 0
    rodar "$dest" --definir-recebidos "$p"
  else
    definir_recebidos "${a#*:}"
  fi
}

# Destinos possíveis nesta máquina (para quem envia escolher): "pasta<TAB>descrição".
destinos() {
  local p v s
  p=$(pasta_recebidos)
  printf '%s\t\033[1m%s\033[0m \033[32m(padrão: recebidos)\033[0m \033[90m%s\033[0m\n' "$p" "$p" "$(caminho_visivel "$p" | sed 's/^[^(]*//')"
  while IFS=$'\t' read -r v s; do
    printf '%s\t\033[1m%s\033[0m \033[90m(sessão %s) %s\033[0m\n' "$v" "$v" "$s" "$(caminho_visivel "$v" | sed 's/^[^(]*//')"
  done < <(pastas_sessoes)
  printf '~\t\033[1m~\033[0m \033[90m(pasta pessoal) %s\033[0m\n' "$(caminho_visivel '~' | sed 's/^[^(]*//')"
}

# Abre a pasta no gerenciador de arquivos (Explorer no WSL; o da área de trabalho no Linux).
# Sem nenhum, abre uma janela do tmux nela (no cliente C).
abrir_pasta() {
  local dir c=${2:-} sess
  dir=$(expandir "$1"); mkdir -p "$dir"
  if grep -qi microsoft /proc/version 2>/dev/null && [[ -x /mnt/c/Windows/explorer.exe ]]; then
    (cd /mnt/c && /mnt/c/Windows/explorer.exe "$(wslpath -w "$dir")") && return
  fi
  if [[ -n ${WAYLAND_DISPLAY:-}${DISPLAY:-} ]] || [[ -S ${XDG_RUNTIME_DIR:-/run/user/$UID}/wayland-0 ]]; then
    WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-0} setsid xdg-open "$dir" >/dev/null 2>&1 </dev/null && return
  fi
  sess=$( [[ -n $c ]] && do_cliente "$c" '#{session_name}')
  tmux new-window ${sess:+-t "=$sess:"} -c "$dir" -n recebidos
}

# "~" e "~/x" → caminho absoluto nesta máquina (as funções de arquivos sempre rodam na máquina
# dona da pasta, via tt de lá).
expandir() {
  case $1 in
    '~') echo "$HOME" ;;
    '~/'*) echo "$HOME/${1#\~/}" ;;
    *) echo "$1" ;;
  esac
}

# Roda um subcomando do tt em DEST repassando stdin/stdout (para os fluxos de tar).
rodar_io() {
  local dest=$1; shift
  if [[ $dest == . ]]; then (cd && "$EU" "$@")
  else ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO $(q "$@")"; fi
}

# Lista uma pasta (desta máquina) para o navegador: "tipo<TAB>nome<TAB>texto". Pastas primeiro.
listar_pasta() {
  local dir=$1 ocultos=${2:-} so_pastas=${3:-}
  cd "$(expandir "$dir")" 2>/dev/null || { printf 'x\t\t\033[31mpasta não encontrada: %s\033[0m\n' "$dir"; return; }
  printf 'u\t..\t\033[36m⬆ ..\033[0m \033[90m(%s)\033[0m\n' "$(encurtar "$(dirname "$PWD")")"
  local -a filtro=()
  [[ -n $ocultos ]] || filtro=(-not -name '.*')
  [[ -n $so_pastas ]] && filtro+=(-type d)
  find . -mindepth 1 -maxdepth 1 "${filtro[@]}" \
    -printf '%y\t%f\t%s\t%TY-%Tm-%Td %TH:%TM\n' 2>/dev/null |
    sort -t$'\t' -k1,1 -k2,2f |
    awk -F'\t' '{
      if ($1 == "d") printf "d\t%s\t\033[1;34m▸ %s/\033[0m\n", $2, $2
      else {
        t = $3; u = "B"
        if (t >= 1073741824) { t = t / 1073741824; u = "G" } else if (t >= 1048576) { t = t / 1048576; u = "M" } else if (t >= 1024) { t = t / 1024; u = "K" }
        printf "f\t%s\t  %-40s \033[90m%6.1f%s  %s\033[0m\n", $2, $2, t, u, $4
      }
    }'
}

# Prévia de um item: pasta → conteúdo; texto → começo; binário → tipo e tamanho.
previa_item() {
  local dir=$1 nome=$2 alvo
  alvo="$(expandir "$dir")/$nome"
  [[ $nome == .. ]] && alvo=$(dirname "$(expandir "$dir")")
  if [[ -d $alvo ]]; then ls -la --color=always "$alvo" 2>/dev/null | head -60
  elif file -b --mime "$alvo" 2>/dev/null | grep -q 'charset=binary'; then
    echo "$(file -b "$alvo")"; du -h "$alvo" | cut -f1
  else head -c 20000 "$alvo" 2>/dev/null | head -80; fi
}

# Pasta absoluta (resolvida nesta máquina) de "~/x", "..", relativos.
resolver_pasta() { (cd "$(expandir "$1")" 2>/dev/null && encurtar "$(pwd -P)"); }

# Navegador: imprime a pasta final na 1ª linha e os nomes escolhidos nas seguintes.
escolher_arquivos() {
  local dest=$1 dir=$2 titulo=${3:-escolha} modo=${4:-} saida
  estado_por arq_modo "$modo"
  estado_por arq_dest "$dest"
  estado_por arq_dir "$(rodar "$dest" --resolver-pasta "$dir" || echo "$dir")"
  estado_por arq_ocultos ""
  saida=$(rodar "$dest" --listar-pasta "$(estado arq_dir)" "" "$modo" | fzf --ansi $([[ -z $modo ]] && echo --multi) --delimiter='\t' --with-nth=3 \
    --layout=reverse --no-sort --exact --prompt='❯ ' --pointer='▶' --marker='✓' \
    --border=rounded --border-label=" 📁 $titulo · $(rotulo "$dest") " --border-label-pos=3 \
    --header="$(cabecalho_arquivos)" \
    --color='bg:#282a36,fg:#f8f8f2,border:#bd93f9,label:#bd93f9:bold,header:#f8f8f2,pointer:#ff79c6,marker:#50fa7b,prompt:#bd93f9,hl:#f1fa8c,hl+:#ffb86c,fg+:#f8f8f2,bg+:#44475a' \
    --preview="$EU --previa-item-em {1} {2}" --preview-window="$(compacto && echo 'down,40%,border-top,hidden' || echo 'right,45%,border-left')" \
    --bind='ctrl-/:toggle-preview' \
    --bind="right:transform($EU --arq-acao entrar {1} {2})" \
    --bind="left:transform($EU --arq-acao subir)" \
    --bind="enter:transform($EU --arq-acao enter {1} {2})" \
    --bind="double-click:transform($EU --arq-acao enter {1} {2})" \
    --bind="click-header:transform($EU --arq-acao clique)" \
    --bind="alt-h:transform($EU --arq-acao ocultos)" \
    --bind="ctrl-s:accept") || return 1
  estado arq_dir
  [[ -n $modo ]] && return 0
  cut -f2 <<<"$saida" | grep -v '^\.\.$' | grep -v '^$'
}

cabecalho_arquivos() {
  printf '\033[1m%s\033[0m\n' "$(estado arq_dir)"
  if [[ -n $(estado arq_modo) ]]; then
    echo "✓ usar-esta-pasta   ⬆ subir   ⌂ início   ◌ ocultos"
    printf '\033[90m%s\033[0m\n' "→ ou ⏎ entra na pasta · ← sobe · ^s ou ✓ usa a pasta mostrada acima"
  else
    echo "⬆ subir   ⌂ início   ✓ confirmar   ◌ ocultos"
    printf '\033[90m%s\033[0m\n' "Tab marca arquivos ou pastas inteiras · →/⏎ entra · ← sobe · ⏎ confirma marcados"
  fi
}

# Ações do navegador (devolvem ações do fzf).
arq_acao() {
  local a=$1 tipo=${2:-} nome=${3:-} dir dest w recarga
  dir=$(estado arq_dir); dest=$(estado arq_dest)
  recarga="reload-sync($EU --listar-pasta-em)+transform-header($EU --cabecalho-arquivos)+clear-query+first"
  case $a in
    clique)
      w=$(palavra_em "$(cabecalho_arquivos | sed -n "${FZF_CLICK_HEADER_LINE:-0}p" | sed 's/\x1b\[[0-9;]*m//g')" "${FZF_CLICK_HEADER_COLUMN:-0}")
      case $w in
        ⬆ | subir) arq_acao subir ;;
        ⌂ | início) estado_por arq_dir '~'; echo "$recarga" ;;
        ✓ | confirmar | usar-esta-pasta) echo accept ;;
        ◌ | ocultos) arq_acao ocultos ;;
      esac ;;
    subir)
      [[ -n ${FZF_QUERY:-} ]] && { echo backward-char; return; }
      estado_por arq_dir "$(rodar "$dest" --resolver-pasta "$dir/..")"; echo "$recarga" ;;
    entrar)
      [[ -n ${FZF_QUERY:-} ]] && { echo forward-char; return; }
      case $tipo in
        d) estado_por arq_dir "$(rodar "$dest" --resolver-pasta "$dir/$nome")"; echo "$recarga" ;;
        u) arq_acao subir ;;
      esac ;;
    enter)
      if ((${FZF_SELECT_COUNT:-0} > 0)); then echo accept
      elif [[ $tipo == d ]]; then estado_por arq_dir "$(rodar "$dest" --resolver-pasta "$dir/$nome")"; echo "$recarga"
      elif [[ $tipo == u ]]; then FZF_QUERY="" arq_acao subir
      elif [[ $tipo == f ]]; then echo accept; fi ;;
    ocultos)
      [[ -n $(estado arq_ocultos) ]] && estado_por arq_ocultos "" || estado_por arq_ocultos 1
      echo "$recarga" ;;
  esac
}

# Pastas de destino possíveis em DEST: a de cada sessão de lá (mais usadas primeiro), Recebidos, início.
pastas_sessoes() {
  tmux list-sessions -F '#{window_activity}|#{@ponte}|#{pane_current_path}|#{session_name}' 2>/dev/null |
    sort -t'|' -k1,1nr | awk -F'|' '$2 == "" && !v[$3]++ { print $3 "|" $4 }' |
    while IFS='|' read -r p s; do printf '%s\t%s\n' "$(encurtar "$p")" "$s"; done
}

escolher_destino() {
  local dest=$1 aqui=${2:-} titulo=${3:-Para qual pasta?} escolha p
  escolha=$( {
      [[ -n $aqui ]] && printf '%s\t\033[1m%s\033[0m \033[90m(pasta deste painel)\033[0m\n' "$aqui" "$aqui"
      rodar "$dest" --destinos
      printf '!padrao\t\033[36m⚙ mudar a pasta padrão de %s…\033[0m\n' "$(rotulo "$dest")"
      printf '!outra\t\033[36m✎ outra pasta…\033[0m\n'
    } | awk -F'\t' '!v[$1]++' | fzf --ansi --delimiter='\t' --with-nth=2 --layout=reverse --no-sort \
      --border=rounded --border-label=" $titulo · $(rotulo "$dest") " --border-label-pos=3 \
      --prompt='❯ ' --pointer='▶' --color='bg:#282a36,fg:#f8f8f2,border:#bd93f9,label:#bd93f9:bold,pointer:#ff79c6,fg+:#f8f8f2,bg+:#44475a' \
      --bind='left-click:accept' | cut -f1) || return 1
  if [[ $escolha == !outra ]]; then read -rep "Pasta em $(rotulo "$dest"): " -i "~/" p; escolha=$p; fi
  if [[ $escolha == !padrao ]]; then
    escolha=$(escolher_arquivos "$dest" "$(rodar "$dest" --pasta-recebidos)" "nova pasta padrão de $(rotulo "$dest")" pasta) || return 1
    rodar "$dest" --definir-recebidos "$escolha" >&2
  fi
  [[ -n $escolha ]] && echo "$escolha"
}

escolher_maquina() { # título [exceto] [preferida: destino que vem primeiro, "(onde você está)"]
  local titulo=$1 exceto=${2:-} pref=${3:-}
  { [[ -n $pref && $pref != . && $pref != "$exceto" ]] && maquinas | awk -v p="$pref" '$1 == p { printf "%s\t\033[1m%s\033[0m \033[90m(onde você está)\033[0m\n", $1, $2; exit }'
    [[ $exceto != . ]] && printf '.\t\033[1m%s\033[0m \033[90m(esta)\033[0m\n' "$MAQUINA"
    maquinas | awk -v x="$exceto" -v p="$pref" '$1 != x && $1 != p { printf "%s\t\033[1m%s\033[0m\n", $1, $2 }'; } |
    fzf --ansi --delimiter='\t' --with-nth=2 --layout=reverse --no-sort --height=~12 \
      --border=rounded --border-label=" $titulo " --prompt='❯ ' --pointer='▶' \
      --color='bg:#282a36,fg:#f8f8f2,border:#bd93f9,label:#bd93f9:bold,pointer:#ff79c6,fg+:#f8f8f2,bg+:#44475a' --bind='left-click:accept' | cut -f1
}

# Lado de lá da cópia: lê um tar do stdin e põe os itens em DIR sem sobrescrever. Imprime os nomes.
receber() {
  local dir tmp f n base ext i alvo
  dir=$(expandir "$1")
  mkdir -p "$dir" || return 1
  # Restos de cópias que morreram no meio (máquina suspensa) somem depois de 6 h sem mudança.
  local velho
  for velho in "$dir"/.tt-recebendo.*; do
    [[ -d $velho ]] && (($(idade_arquivo "$velho") > 21600)) && rm -rf "$velho"
  done
  tmp=$(mktemp -d "$dir/.tt-recebendo.XXXXXX") || return 1
  # Cancelada (TERM) ou conexão caída (HUP/PIPE): nada pela metade fica na pasta.
  trap 'rm -rf "$tmp"; exit 1' TERM INT HUP PIPE
  # -m: o arquivo ganha a data de chegada (senão fica com a data original e some no meio da pasta).
  tar -C "$tmp" -xmf - || { rm -rf "$tmp"; return 1; }
  shopt -s dotglob nullglob
  for f in "$tmp"/*; do
    n=$(basename "$f"); alvo="$dir/$n"
    if [[ -e $alvo ]]; then
      base=$n ext=""
      [[ -f $f && $n == ?*.* ]] && base=${n%.*} ext=".${n##*.}"
      i=2; while [[ -e "$dir/$base ($i)$ext" ]]; do i=$((i + 1)); done
      alvo="$dir/$base ($i)$ext"
    fi
    mv "$f" "$alvo" && basename "$alvo"
  done
  rmdir "$tmp"
}

empacotar() { local dir; dir=$(expandir "$1"); shift; tar -C "$dir" -cf - -- "$@"; }
tamanho() { local dir; dir=$(expandir "$1"); shift; (cd "$dir" && du -scb -- "$@" 2>/dev/null | tail -1 | cut -f1); }

avisar() {
  local c
  for c in $(tmux list-clients -F '#{client_name}' 2>/dev/null); do tmux display-message -c "$c" -d 6000 "$1"; done
}

# ---- Botões --------------------------------------------------------------------------------
# Os botões da barra de teclas extras do Termux (e qualquer teclado) mandam Ctrl+B F1…F10; o tmux
# chama `tt --botao <ação> <cliente> <painel> <pasta>` e a ação decide pelo estado do momento.

botao_aviso() { tmux display-message -c "$1" -d 3000 "$2"; }

# Descendentes de um PID (um por linha, "pid args"), lendo a árvore de processos.
descendentes() {
  ps -A -o pid= -o ppid= -o args= 2>/dev/null | awk -v raiz="$1" '
    { pid = $1; pai[pid] = $2; $1 = $2 = ""; sub(/^ +/, ""); arg[pid] = $0 }
    END { for (p in pai) { q = p; while (q != "" && q != 0 && q != raiz) q = pai[q]; if (q == raiz && p != raiz) print p, arg[p] } }'
}

# Linux do proot-distro (Termux) a usar: distro= no config; senão o Debian; senão o primeiro
# instalado (aceita o layout novo, containers/, e o antigo, installed-rootfs/).
distro_proot() {
  local base=${PREFIX:-/nonexistent}/var/lib/proot-distro d
  command -v proot-distro >/dev/null || return 1
  for d in "$(conf distro)" debian $(ls "$base"/containers "$base"/installed-rootfs 2>/dev/null); do
    [[ -n $d && ( -d $base/containers/$d/rootfs || -d $base/installed-rootfs/$d ) ]] && { echo "$d"; return; }
  done
  return 1
}

# Comando que abre o Linux do proot-distro (Termux) na pasta dada, ou nada se não houver.
debian_comando() {
  local d
  d=$(distro_proot) || return 1
  printf 'proot-distro login %q --shared-tmp --work-dir %q' "$d" "$1"
}

# Caminho do claude desta máquina (também em ~/.local/bin, que pode não estar no PATH do tmux).
claude_local() {
  if [[ -x $HOME/.local/bin/claude ]]; then echo "$HOME/.local/bin/claude"; else command -v claude; fi
}

# Comando do Claude Code: o claude local, ou o do Debian do Termux; falha se nenhum existe.
# Opções extras desta máquina vêm de claude_flags= e variáveis de ambiente de claude_env=
# (ex.: IS_SANDBOX=1) no ~/.config/tt/config. No Debian, o ~/.local/bin vai no próprio comando: o
# login do proot só o põe no PATH se o ~/.bashrc de lá tiver a linha (já sumiu uma vez: código 127).
claude_comando() {
  local pasta=$1 a e c; shift
  a="$(conf claude_flags) $(printf '%q ' "$@")"
  e=$(conf claude_env); e=${e:+$e }
  if c=$(claude_local); then printf '%s%q %s' "$e" "$c" "$a"
  elif debian_comando "$pasta" >/dev/null; then
    printf '%s -- bash -lc %q' "$(debian_comando "$pasta")" "PATH=\"\$HOME/.local/bin:\$PATH\" ${e}claude $a"
  else return 1; fi
}

# Vai para a janela marcada com o papel (claude, debian…) naquela pasta, ou cria uma sessão nova.
# Se o painel atual já é desse papel, o botão alterna de volta para a sessão anterior.
ir_papel() {
  local papel=$1 cmd=$2 cliente=$3 pane=$4 pasta=$5 sess jan p dir nome
  if [[ $(tmux show-options -wqv -t "$pane" @tt_papel) == "$papel" ]]; then
    tmux switch-client -c "$cliente" -l 2>/dev/null || botao_aviso "$cliente" "$papel: não há outra sessão para onde voltar"
    return
  fi
  while IFS=$'\t' read -r sess jan p dir; do
    if [[ $p == "$papel" && $dir == "$pasta" ]]; then
      tmux select-window -t "$jan" && tmux switch-client -c "$cliente" -t "=$sess"; return
    fi
  done < <(tmux list-windows -a -F '#{session_name}'$'\t''#{window_id}'$'\t''#{@tt_papel}'$'\t''#{@tt_pasta}')
  nome=$(proximo_nome "$papel")
  tmux new-session -d -s "$nome" -c "$pasta" "$cmd; exec \${SHELL:-bash}" || { botao_aviso "$cliente" "$papel: não consegui abrir a sessão"; return; }
  tmux set-option -w -t "=$nome:" @tt_papel "$papel"
  tmux set-option -w -t "=$nome:" @tt_pasta "$pasta"
  tmux switch-client -c "$cliente" -t "=$nome"
}

# Túnel da tela remota (Guacamole): liga se está desligado, desliga se está ligado.
botao_tela() {
  local cliente=$1 dest porta url
  dest=$(conf tela_destino); porta=$(conf tela_porta); porta=${porta:-8089}
  url=$(conf tela_url); url=${url:-http://localhost:$porta/guacamole/}
  [[ -n $dest ]] || { botao_aviso "$cliente" "tela: defina tela_destino=usuario@host em ~/.config/tt/config"; return; }
  if pgrep -f "L $porta:127.0.0.1:$porta" >/dev/null; then
    pkill -f "L $porta:127.0.0.1:$porta"; botao_aviso "$cliente" "tela: túnel desligado"
  elif ssh -f -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ConnectTimeout=6 -L "$porta:127.0.0.1:$porta" "$dest"; then
    command -v termux-open-url >/dev/null && termux-open-url "$url"
    botao_aviso "$cliente" "tela: túnel ligado em $url"
  else botao_aviso "$cliente" "tela: não consegui conectar em $dest"; fi
}

# Cliente de e-mail desta máquina: do config (email=), senão aerc. Falha se não existe.
email_comando() {
  local c; c=$(conf email); c=${c:-aerc}
  command -v "${c%% *}" >/dev/null || return 1
  printf '%s' "$c"
}

# E-mail numa subjanela (display-popup), como a central ☰ — não uma sessão tmux comum: não
# aparece na lista/central nem vira "sessão de trabalho". O popup abre o cliente (aerc) sobre a
# tela atual; ao sair do cliente o popup fecha e não sobra nada (nem sessão, nem shell órfão), então
# o botão sempre reabre limpo. Se o cliente falhar ao abrir, cai num shell com a mensagem para o
# erro ficar visível, em vez de o popup sumir num piscar.
botao_email() {
  local cliente=$1 cmd prog dica
  # Sem nenhuma conta ainda: o aerc abriria o próprio assistente em inglês; vai direto ao cadastro do tt.
  if [[ ! -s $HOME/.config/aerc/accounts.conf ]] || ! grep -q '^\[' "$HOME/.config/aerc/accounts.conf"; then
    botao_email_contas "$cliente"; return
  fi
  cmd=$(email_comando) || {
    local cli; cli=$(conf email); cli=${cli%% *}
    if [[ -z $cli || ${cli##*/} == aerc ]]; then   # sem o aerc: oferece instalar (modal das pendências) em vez de só avisar
      popup_fixo -c "$cliente" -E $(dim_popup "$cliente" 92 22) -b rounded -S 'fg=#f9e2af' -T ' 📦 aerc ' "$EU --pedir-sudo email-aerc"
      cmd=$(email_comando) || return
    else
      botao_aviso "$cliente" "e-mail: instale o aerc (ou defina email=<cliente> em ~/.config/tt/config)"; return
    fi
  }
  # Auto-reparo: se o aerc foi instalado depois do tt ou perdeu o conversor HTML, corrige somente
  # o filtro text/html. Quando houve reparo, reinicia a sessão oculta para carregar a configuração.
  if [[ ${cmd%% *} == */aerc || ${cmd%% *} == aerc ]] && aerc_reparar_se_preciso; then
    tmux kill-session -t "=$EMAIL_SESSAO" 2>/dev/null
  fi
  # Dica de como fechar: display-popup não tem X clicável, então o popup só some quando o
  # cliente sai. Mostra no título a tecla de saída do cliente para quem não a conhece.
  prog=${cmd%% *}
  case ${prog##*/} in
    aerc)        dica="Esc fecha" ;; # o resto está nos botões do rodapé
    mutt|neomutt) dica="q fecha" ;;
    *)           dica="feche o cliente p/ sair" ;;
  esac
  # A prévia da mensagem acompanha a tela: estreita (< 100: lado a lado, celular) — sem prévia e
  # sem a barra de pastas (J/K trocam de pasta); média — prévia EMBAIXO, com a largura toda (HTML
  # lê melhor); muito larga (≥ 180) — prévia AO LADO. As variantes são cópias da configuração em
  # ~/.cache; a normal não muda.
  local larg modo=largo; larg=$(do_cliente "$cliente" '#{client_width}')
  if [[ ${prog##*/} == aerc && -f $HOME/.config/aerc/aerc.conf ]]; then
    local copia=""
    if ((${larg:-200} < 100)); then
      modo=estreito; copia="$HOME/.cache/tt-aerc-estreito.conf"; mkdir -p "$HOME/.cache"
      cp "$HOME/.config/aerc/aerc.conf" "$copia"
      aerc_definir "$copia" ui sidebar-width 0 forcar
      aerc_definir "$copia" ui index-columns 'flags:3,name<12%,subject,date>=' forcar
      sed -i '/^[[:space:]]*message-list-split[[:space:]]*=/d' "$copia"
    elif ((${larg:-200} >= 180)); then
      modo=amplo; copia="$HOME/.cache/tt-aerc-amplo.conf"; mkdir -p "$HOME/.cache"
      cp "$HOME/.config/aerc/aerc.conf" "$copia"
      aerc_definir "$copia" ui message-list-split 'vertical 70' forcar
    fi
    [[ -n $copia ]] && cmd+=" -C $(printf %q "$copia")"
  fi
  # Subjanela por cima da tela, com borda arredondada na cor do tema e título. (O tmux deixa arrastar
  # um popup pela linha da borda e não tem opção para desligar isso; o dono prefere a borda.)
  local geo=($(tam_popup "$cliente") -b rounded -S 'fg=#89b4fa' -T " 📧 e-mail · $dica ")
  if [[ ${prog##*/} == aerc ]]; then
    # aerc fica aberto e conectado numa sessão oculta: abrir de novo é instantâneo (antes, ~6 s
    # reconectando às contas a cada vez), e e-mail novo chega com ele fechado. Esc (ou q) só esconde
    # a subjanela; Ctrl+q encerra o aerc de verdade.
    email_sessao "$cmd" "$modo" || { botao_aviso "$cliente" "e-mail: não consegui abrir o aerc"; return; }
    # Se o aerc morrer logo ao abrir (tema/config/conta inválidos), a sessão fica num shell com o
    # erro em vez de o popup abrir e sumir vazio. Dá um instante para ele iniciar e checa o estado.
    sleep 0.4
    if ! tmux has-session -t "=$EMAIL_SESSAO" 2>/dev/null; then
      botao_aviso "$cliente" "e-mail: o aerc fechou sozinho ao abrir. Rode: aerc  (fora do tt) para ver o erro, ou 📧 → contas para corrigir."
      return
    fi
    local pane_cmd; pane_cmd=$(tmux display -p -t "=$EMAIL_SESSAO:" '#{pane_current_command}' 2>/dev/null)
    if [[ $pane_cmd != aerc* ]]; then
      # O aerc saiu e o shell da sessão mostra o erro: anexa o popup a ele para o erro ficar visível.
      email_popup_abrir "$cliente" "env -u TMUX $(email_origem "$cliente")$(q "$TT_TMUX_BIN") -u attach -t $(q "=$EMAIL_SESSAO")"
      tmux kill-session -t "=$EMAIL_SESSAO" 2>/dev/null
      botao_aviso "$cliente" "e-mail: o aerc não abriu. Verifique a conta em 📧 → contas (ou rode: aerc)."
      return
    fi
    email_popup_abrir "$cliente" "env -u TMUX $(email_origem "$cliente")$(q "$TT_TMUX_BIN") -u attach -t $(q "=$EMAIL_SESSAO")"
    return
  fi
  tmux display-popup -c "$cliente" -E "${geo[@]}" \
    "cd ${HOME@Q}; VAXIS_FORCE_UNICODE=1 $cmd || { printf '\\n[e-mail] o cliente saiu com erro (código %s). Qualquer tecla fecha.' \"\$?\"; read -rsn1 _; }"
}

# Um único popup pode anexar-se à sessão oculta do aerc por vez. Cliques repetidos enquanto o
# painel está aberto (ou duas notificações quase simultâneas) não devem abrir popups aninhados,
# que no tmux parecem subir em cascata e acabam fechando o cliente.
# "TT_ORIGEM=máquina " para o cliente de dentro do popup do e-mail quando o cliente de fora é uma ponte de
# outra máquina: um link aberto no e-mail vai para a tela de lá (abrir_na_tela). O q já termina em espaço.
email_origem() { local o; o=$(origem_ponte "$1"); o=${o%%|*}; [[ -n $o ]] && printf 'TT_ORIGEM=%s' "$(q "$o")"; return 0; }
email_popup_abrir() { # cliente comando
  local cliente=$1 comando=$2 fd; local -a geo
  local trava="${XDG_RUNTIME_DIR:-/tmp}/tt-email-popup.lock"
  mkdir -p "${trava%/*}" 2>/dev/null || return 1
  exec {fd}>"$trava" || return 1
  flock -n "$fd" || { exec {fd}>&-; return 0; }
  if [[ $(tmux display -p -t "=$EMAIL_SESSAO:" '#{session_attached}' 2>/dev/null) =~ ^[1-9] ]]; then
    exec {fd}>&-
    return 0
  fi
  # Uma central ou outra janela flutuante já aberta ocupa o cliente. O browser tem rota própria
  # (popup_fixo) e continua podendo ser aberto a partir do e-mail.
  if [[ -n $(do_cliente "$cliente" '#{window_modal_pane}' 2>/dev/null) ]]; then
    exec {fd}>&-
    return 0
  fi
  popup_exclusivo_reservar email "$cliente" || { exec {fd}>&-; return 0; }
  geo=($(tam_popup "$cliente") -b rounded -S 'fg=#89b4fa' -T ' 📧 e-mail · Esc fecha ')
  tmux display-popup -c "$cliente" -E "${geo[@]}" "$comando"
  local rc=$?
  popup_exclusivo_liberar "$POPUP_EXCLUSIVO"
  exec {fd}>&-
  return "$rc"
}

# Sessão oculta com o aerc aberto. Marcada como "ponte" do tipo email: fica fora da central, do
# seletor, do vigia e da limpeza de sessões paradas/vazias. Recriada se o aerc saiu ou se o modo
# (largo/estreito) mudou. Nela, q desanexa em vez de sair (binds próprios, gerados do binds.conf).
EMAIL_SESSAO=_tt-email
email_sessao() {
  local cmd=$1 modo=$2 b="$HOME/.config/aerc/binds.conf" contas="$HOME/.config/aerc/accounts.conf" bo="$HOME/.cache/tt-aerc-binds-oculto.conf" pane_cmd
  # Versão da sessão: binds, contas e pastas. O aerc não recarrega accounts.conf; inclui sua soma para
  # recriar a sessão quando a configuração muda. Pastas locais novas também pedem recriação (senão o
  # folder-map e ações como apagar não as enxergam). Se a sessão estiver anexada, aplica na próxima
  # abertura para não interromper uma resposta em andamento.
  local base="$EMAIL_BINDS_VER:$( [[ -f $b ]] && cksum <"$b" | cut -d' ' -f1 || echo 0)" ver atual
  ver="$base:$( [[ -f $contas ]] && cksum <"$contas" | cut -d' ' -f1 || echo 0):$(email_pastas_soma)"
  if tmux has-session -t "=$EMAIL_SESSAO" 2>/dev/null; then
    pane_cmd=$(tmux display -p -t "=$EMAIL_SESSAO:" '#{pane_current_command}' 2>/dev/null)
    atual=$(tmux show -qv -t "=$EMAIL_SESSAO:" @tt_email_binds)
    # Aberta em outra tela (popup anexado), mudança só de contas/pastas não a derruba: fecharia o e-mail
    # lá, possivelmente com uma resposta pela metade. Fica para a próxima abertura desanexada.
    [[ $atual != "$ver" && $atual == "$base:"* &&
       $(tmux display -p -t "=$EMAIL_SESSAO:" '#{session_attached}' 2>/dev/null) =~ ^[1-9] ]] && atual=$ver
    if [[ $(tmux show -qv -t "=$EMAIL_SESSAO:" @tt_email_modo) == "$modo" && $pane_cmd == aerc* &&
          $atual == "$ver" &&
          $(tmux show-environment -t "=$EMAIL_SESSAO" VAXIS_FORCE_UNICODE 2>/dev/null) == VAXIS_FORCE_UNICODE=1 ]]; then email_sessao_botoes; return 0; fi
    tmux kill-session -t "=$EMAIL_SESSAO" 2>/dev/null
  fi
  mkdir -p "$HOME/.cache"
  if [[ -f $b ]]; then
    # Na sessão oculta: q/Q desanexam; ? e F2 abrem as telas do tt como janelas da sessão (não como
    # abas do aerc, que deixavam os botões sem alvo); e as teclas de função dos botões (F3–F10).
    sed -e 's/^\([[:space:]]*\)\(q\|Q\)[[:space:]]*=[[:space:]]*:quit<Enter>[[:space:]]*$/\1\2 = :exec tmux detach-client<Enter>/' \
        -e "s/^<C-q>[[:space:]]*=.*/<C-q> = :quit<Enter>/" \
        -e "s|:term $HOME/.local/bin/tt --email-atalhos<Enter>|:exec $HOME/.local/bin/tt --email-tela atalhos<Enter>|" \
        -e "s|:term $HOME/.local/bin/tt --email-contas-ui<Enter>|:exec $HOME/.local/bin/tt --email-tela contas<Enter>|" "$b" >"$bo"
    { echo '[messages]'; email_binds_botoes messages; echo '[view]'; email_binds_botoes view; email_binds_botoes_contas; } >>"$bo"
    cmd+=" -B $(printf %q "$bo")"
  fi
  email_sessao_criar "$cmd" "$modo" "$ver" || return 1
  email_sessao_botoes
  return 0
}
# Soma da lista de pastas do espelho local (as pastas de maildir: as que têm cur/). Não entra em cur/,
# new/ nem tmp/ (um INBOX de 90 mil mensagens não pesa).
email_pastas_soma() {
  local base=${EMAIL_MAILDIR_BASE:-$HOME/.cache/tt/maildir}
  [[ -d $base ]] || { echo 0; return 0; }
  find "$base" -mindepth 2 -maxdepth 5 -type d \( -name cur -print -o -name new -o -name tmp \) -prune 2>/dev/null | LC_ALL=C sort | cksum | cut -d' ' -f1
}
# Versão dos binds da sessão oculta: uma sessão criada com binds antigos é recriada (os botões
# mandam F3–F10, que o aerc de antes não conhecia).
EMAIL_BINDS_VER=5
email_sessao_criar() {
  local cmd=$1 modo=$2 ver=${3:-$EMAIL_BINDS_VER:0}
  # VAXIS_FORCE_UNICODE: o aerc mede emoji com seletor de variação (🕸️, ⚠️) como 2 colunas, igual ao
  # tmux (3.5 e 3.6) e aos terminais. Sem isso ele contava 1, a linha ficava com uma coluna a mais e o
  # fim dela (o horário) transbordava para a linha de baixo: dígitos soltos na coluna de pastas.
  # XDG_CONFIG_HOME: no macOS o aerc só olha ~/Library/Preferences/aerc (não ~/.config/aerc, onde o tt grava contas,
  # binds e o styleset tt-catppuccin) e morria com "Can't find styleset" logo ao abrir. Apontar para ~/.config vale
  # igual no Linux.
  tmux new-session -d -s "$EMAIL_SESSAO" -x 150 -y 40 -c "$HOME" -e VAXIS_FORCE_UNICODE=1 -e "XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}" "$cmd" || return 1
  tmux set -q -t "=$EMAIL_SESSAO:" @ponte email
  tmux set -q -t "=$EMAIL_SESSAO:" @tt_oculta 1
  tmux set -q -t "=$EMAIL_SESSAO:" @nome_auto 0
  tmux set -q -t "=$EMAIL_SESSAO:" @tt_email_modo "$modo"
  tmux set -q -t "=$EMAIL_SESSAO:" @tt_email_binds "$ver"
  return 0
}

# Barra de botões do e-mail: a linha de status da sessão oculta (aparece no rodapé do popup). Cada
# botão é um range user|em_<ação>; o clique chega pelo mesmo caminho dos botões da barra principal
# (MouseDown1Status → tt --clique) e vira a tecla do aerc (email_botao_acao). Em tela estreita
# (< 100) ficam só os ícones. Aplicada toda vez que o popup abre (a sessão pode ser antiga).
email_sessao_botoes() {
  tmux set -q -t "=$EMAIL_SESSAO:" status on
  tmux set -q -t "=$EMAIL_SESSAO:" status-position bottom
  tmux set -q -t "=$EMAIL_SESSAO:" status-style 'bg=#181825,fg=#cdd6f4'
  tmux set -q -t "=$EMAIL_SESSAO:" 'status-format[0]' "$(email_barra_fmt)"
}
# Os botões: ação, ícone, rótulo, tecla de função mandada ao aerc (cor de fundo própria para os
# destrutivos). As ações do aerc vão por F3–F10, não pelas letras: uma letra cairia no que estiver
# na frente (o editor de uma mensagem, um terminal), enquanto a tecla de função só faz algo nos
# contextos em que o tt a ligou (lista e leitura; ver email_binds_botoes). Contas e atalhos são
# telas do tt (email_tela), sem passar pelo aerc.
EMAIL_BOTOES=(
  'abrir|📖|Abrir|F3'
  'nova|+|Nova|F4'
  'resp|↩|Responder|F5'
  'todos|↩↩|Todos|F6'
  'enc|↪|Encaminhar|F7'
  'arq|▤|Arquivar|F8'
  'apagar|✕|Apagar|F9'
  'pasta|📁|Pasta|F10'
  'tudo|☑|Tudo|'
  'lote|⚡|Em lote|'
  'naolidas|✉|Não lidas|'
  'lixeira|🧹|Lixeira|'
  'sync|⟳|Sincronizar|'
  'contas|👤|Contas|'
  'atalhos|?|Atalhos|'
)
# Apagar e arquivar CERTOS em toda conta. Com a lixeira conhecida (a pasta que o servidor marca como
# \Trash, gravada em pasta_lixeira), d/D (e o botão ✕) movem para ela, com pergunta; dentro da
# lixeira e do spam, d/D apagam de vez. Conta sem lixeira conhecida: d apaga de vez, e a pergunta diz
# isso (antes caía no padrão do aerc, que no Gmail só arquivava, sem aviso nenhum). No Gmail as pastas
# são rótulos: tirar a mensagem do INBOX (o que :delete faz, direto ou pelo mbsync) só a ARQUIVA — ela
# segue em "Todos os e-mails" —, então lá a (e ▤) é :delete (arquivar sem subir cópia); nas outras
# contas a fica com o :archive de fábrica. Seções por conta ([messages:account=^Nome$]) e por pasta
# (a pasta ganha da conta). Lista: "nome␟lixeira␟spam␟todos␟gmail(1|0)" (0x1F: um TAB entre campos vazios
# some no read; pastas relativas à pasta-mãe).
email_contas_lixeira() {
  local s mae l sp td g; local -A E=()
  declare -F email_slugs >/dev/null || return 0
  for s in $(email_slugs 2>/dev/null); do
    E=(); email_ler "$s" 2>/dev/null || continue
    g=0; [[ ${E[provedor]:-} == gmail || ${E[imap_host]:-} == imap.gmail.com ]] && g=1
    mae=${E[pasta_naoabre]:-}; l=${E[pasta_lixeira]:-}; sp=${E[pasta_spam]:-}; td=${E[pasta_todos]:-}
    [[ -n $mae ]] && { l=${l#"$mae"/}; sp=${sp#"$mae"/}; td=${td#"$mae"/}; }
    printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\n' "${E[nome]}" "$l" "$sp" "$td" "$g"
  done
}
re_escapar() { printf '%s' "$1" | sed 's/[][\\.*^$+?(){}|]/\\&/g'; }
# As seções, com as teclas pedidas: APAGAR (pergunta), APAGAR_DIRETO e ARQUIVAR (vazia = não gera).
# Para o binds.conf são d, D e a; para a sessão oculta, os botões ✕ (F9) e ▤ (F8).
email_binds_contas_gerar() { # tecla_apagar tecla_apagar_direto tecla_arquivar
  local ka=$1 kd=$2 kq=$3 nome l sp td g re p ctx; local -A vistas=()
  while IFS=$'\x1f' read -r nome l sp td g; do
    [[ -n $nome ]] || continue
    re=$(re_escapar "$nome")
    if [[ -z $l ]]; then
      # Sem lixeira conhecida: no Gmail, apagar só arquivaria; nada é gerado e a checagem do tt
      # (tt --email-conferir) descobre a lixeira. Nas outras, d apaga de vez, e a pergunta diz isso.
      ((g)) && continue
      for ctx in messages view; do
        printf '[%s:account=^%s$]\n' "$ctx" "$re"
        [[ -n $ka ]] && printf '%s = :choose -o y '"'"'Apagar de vez (esta conta não tem lixeira)'"'"' delete-message<Enter>\n' "$ka"
      done
      continue
    fi
    for ctx in messages view; do
      printf '[%s:account=^%s$]\n' "$ctx" "$re"
      [[ -n $ka ]] && printf '%s = :choose -o y '"'"'Apagar (vai para a lixeira)'"'"' '"'"'move %s'"'"'<Enter>\n' "$ka" "$l"
      [[ -n $kd ]] && printf '%s = :move %s<Enter>\n' "$kd" "$l"
      ((g)) && [[ -n $kq ]] && printf '%s = :delete<Enter>\n' "$kq" # arquivar no Gmail = tirar do INBOX (segue em Todos os e-mails)
    done
    # Na lixeira e no spam, apagar é de vez; no Gmail, lá e em "Todos os e-mails", arquivar não faz sentido.
    for p in "$l" "$sp" "$( ((g)) && printf '%s' "$td")"; do
      [[ -n $p && -z ${vistas[$p]:-} ]] || continue; vistas[$p]=1
      for ctx in messages view; do
        printf '[%s:folder=^%s$]\n' "$ctx" "$(re_escapar "$p")"
        if [[ $p != "$td" ]]; then
          [[ -n $ka ]] && printf '%s = :choose -o y '"'"'Apagar de vez (não volta)'"'"' delete-message<Enter>\n' "$ka"
          [[ -n $kd ]] && printf '%s = :delete<Enter>\n' "$kd"
        fi
        ((g)) && [[ -n $kq ]] && printf '%s =\n' "$kq"
      done
    done
  done < <(email_contas_lixeira)
  return 0
}
email_binds_contas() { email_binds_contas_gerar d D a; }                    # → binds.conf
email_binds_botoes_contas() { email_binds_contas_gerar '<F9>' '' '<F8>'; }   # → binds da sessão oculta

# O que cada tecla de função faz no aerc, por contexto (vai para os binds da sessão oculta).
email_binds_botoes() { # messages|view
  [[ $1 == messages ]] && echo '<F3> = :view<Enter>'
  # Esc volta um passo: na mensagem aberta, fecha-a; na lista, limpa o filtro/busca ou esconde o e-mail.
  if [[ $1 == messages ]]; then echo "<Esc> = :exec $HOME/.local/bin/tt --email-esc<Enter>"; else echo '<Esc> = :close<Enter>'; fi
  echo '<F4> = :compose<Enter>'
  echo '<F5> = :reply<Enter>'
  echo '<F6> = :reply -a<Enter>'
  echo '<F7> = :forward<Enter>'
  echo '<F8> = :archive flat<Enter>'
  echo '<F9> = :choose -o y '"'"'Apagar esta mensagem'"'"' delete-message<Enter>'
  echo '<F10> = :move<space>'
  echo '<F11> = :check-mail<Enter>' # depois do ⟳: as contas só IMAP conferem também
}
# Os rótulos entram conforme a largura do popup: só os ícones cabem em qualquer tela; cada rótulo
# aparece quando a barra inteira, com ele e com os que vêm antes na ordem abaixo, cabe. Os ícones
# menos óbvios ganham rótulo primeiro.
EMAIL_ROTULOS_ORDEM=(tudo lote naolidas lixeira arq todos enc resp sync atalhos apagar pasta contas nova abrir)
email_barra_fmt() {
  local b acao ic rot tecla est out="" largura=0 r; local -A limite=() w=()
  for b in "${EMAIL_BOTOES[@]}"; do
    IFS='|' read -r acao ic rot tecla <<<"$b"
    tt_largura "$rot"; w[$acao]=$W
    tt_largura "$ic"; largura=$((largura + W + 3)) # " ic " + o espaço depois
  done
  for r in "${EMAIL_ROTULOS_ORDEM[@]}"; do [[ -n ${w[$r]:-} ]] && { largura=$((largura + w[$r] + 1)); limite[$r]=$largura; }; done
  for b in "${EMAIL_BOTOES[@]}"; do
    IFS='|' read -r acao ic rot tecla <<<"$b"
    case $acao in
      abrir) est='#[fg=#1e1e2e,bg=#89b4fa,bold]' ;;
      apagar) est='#[fg=#1e1e2e,bg=#f38ba8,bold]' ;;
      *) est='#[fg=#cdd6f4,bg=#45475a]' ;;
    esac
    if [[ $acao == sync ]]; then
      # Enquanto consulta (e logo depois), o botão mostra o estado (@tt_email_sync: "consultando…", "✓ 2 novos").
      out+="#[range=user|em_$acao]$est $ic#{?#{@tt_email_sync}, #{@tt_email_sync},#{?#{e|<:#{client_width},${limite[$acao]:-0}},, $rot}} #[norange]#[default] "
      continue
    fi
    out+="#[range=user|em_$acao]$est $ic#{?#{e|<:#{client_width},${limite[$acao]:-0}},, $rot} #[norange]#[default] "
  done
  printf '%s' "$out"
}
# Clique num botão do popup do e-mail. Funciona de qualquer lugar: contas e atalhos abrem/fecham a
# tela do tt (email_tela); as ações do aerc fecham antes a tela do tt que estiver na frente e só
# então mandam a tecla de função à janela do aerc.
email_botao_acao() { # ação
  tmux has-session -t "=$EMAIL_SESSAO" 2>/dev/null || return 0
  local b acao ic rot tecla=""
  case $1 in
    contas | atalhos | lixeira | lote) email_tela "$1"; return 0 ;;
    tudo) email_tela_fechar; email_tudo; return 0 ;;
    sync) (email_sync_agora >/dev/null 2>&1 &); return 0 ;; # consulta as contas agora, sem travar o clique
    naolidas) email_tela_fechar; email_naolidas; return 0 ;;
  esac
  for b in "${EMAIL_BOTOES[@]}"; do IFS='|' read -r acao ic rot tecla <<<"$b"; [[ $acao == "$1" ]] && break; tecla=""; done
  [[ -n $tecla ]] || return 0
  email_tela_fechar
  tmux send-keys -t "=$EMAIL_SESSAO:" "$tecla"
}

# Telas do tt por cima do aerc (⌨ atalhos, 👤 contas — e dentro dela cadastro, edição, propagar —, 🧹 lixeira):
# janelas da própria sessão oculta, com a barra de botões visível; a tela fecha com q/Esc, com o
# mesmo botão de novo, ou quando outro botão age (fecha e age). Abrir uma com outra aberta troca.
# Vale de qualquer lugar: botão, tecla do aerc (? e F2 na sessão oculta) ou tt --email-tela.
email_tela() { # atalhos|contas|lixeira|lote
  local nome cmd tela id
  case $1 in
    atalhos) nome='⌨ atalhos'; cmd="$HOME/.local/bin/tt --email-atalhos" ;;
    contas)  nome='👤 contas';  cmd="cd ${HOME@Q}; $HOME/.local/bin/tt --email-contas-ui" ;;
    lixeira) nome='🧹 lixeira'; cmd="cd ${HOME@Q}; $HOME/.local/bin/tt --email-lixeira-ui" ;;
    lote)    nome='⚡ em lote'; cmd="cd ${HOME@Q}; $HOME/.local/bin/tt --email-lote --tela" ;;
    *) return 0 ;;
  esac
  [[ -x $HOME/.local/bin/tt ]] || cmd=${cmd//"$HOME/.local/bin/tt"/"$EU"}
  tmux has-session -t "=$EMAIL_SESSAO" 2>/dev/null || return 0
  tela=$(tmux show -wqv -t "=$EMAIL_SESSAO:" @tt_email_tela)
  [[ -n $tela ]] && email_tela_fechar
  [[ $tela == "$1" ]] && return 0 # o mesmo botão de novo: só fecha
  id=$(tmux new-window -P -F '#{window_id}' -t "=$EMAIL_SESSAO:" -n "$nome" -c "$HOME" "$cmd") || return 0
  tmux set -wq -t "$id" @tt_email_tela "$1"
  tmux set -wq -t "$id" remain-on-exit off
  return 0
}
# Fecha a tela do tt que estiver na frente (a janela corrente da sessão oculta); o aerc nunca.
email_tela_fechar() {
  [[ -n $(tmux show -wqv -t "=$EMAIL_SESSAO:" @tt_email_tela 2>/dev/null) ]] && tmux kill-window -t "=$EMAIL_SESSAO:"
  return 0
}

# Filtro ou busca ativos na lista do aerc: a linha de status dele (a última linha do painel) mostra
# "| filter …" ou "| search …" enquanto valem.
email_aerc_painel() { tmux list-panes -s -t "=$EMAIL_SESSAO" -F '#{pane_current_command} #{pane_id}' 2>/dev/null | awk '$1 ~ /^aerc/ { print $2; exit }'; }
email_filtro_ativo() {
  local p; p=$(email_aerc_painel); [[ -n $p ]] || return 1
  tmux capture-pane -p -t "$p" 2>/dev/null | awk 'NF { u = $0 } END { exit !(u ~ /\| (filter|search) /) }'
}
# Manda um comando ao aerc da sessão oculta: pelo IPC; sem ele, digitado na lista (só é chamado
# com a lista na frente, pela tecla Esc dela ou pelo botão, que antes fecha a tela do tt).
email_aerc_cmd() { # :comando [argumentos…]
  email_ipc "$@" && return 0
  local p; p=$(email_aerc_painel); [[ -n $p ]] || return 1
  tmux send-keys -t "$p" -l "$*" && tmux send-keys -t "$p" Enter
}
# Esc na lista do e-mail (sessão oculta): volta um passo. Com filtro ou busca, limpa (:clear); sem
# nada, esconde o e-mail como o q (o popup fecha; o aerc segue conectado). Na mensagem aberta o Esc
# a fecha (:close, nos binds), e nas telas do tt (atalhos, contas, lixeira) o Esc já fechava.
email_esc() {
  if email_filtro_ativo; then email_aerc_cmd :clear; return 0; fi
  local c; c=$(tmux list-clients -t "=$EMAIL_SESSAO" -F '#{client_activity} #{client_name}' 2>/dev/null | sort -rn | awk 'NR == 1 { print $2 }')
  [[ -n $c ]] && tmux detach-client -t "$c" 2>/dev/null
  return 0
}
# ☑ Tudo (botão e Ctrl+a na lista): seleciona todas as mensagens da pasta aberta — com busca ou filtro
# ativo, só as encontradas —, e então ✕, ▤, 📁 (e d, a, M) agem em todas. De novo, desmarca todas. O
# estado fica na sessão oculta (@tt_email_tudo): o aerc não diz se há marcadas.
email_tudo() {
  if [[ $(tmux show -qv -t "=$EMAIL_SESSAO:" @tt_email_tudo 2>/dev/null) == 1 ]]; then
    email_aerc_cmd :unmark -a; tmux set -q -t "=$EMAIL_SESSAO:" @tt_email_tudo 0
  else
    email_aerc_cmd :mark -a; tmux set -q -t "=$EMAIL_SESSAO:" @tt_email_tudo 1
  fi
  return 0
}
# ✉ Não lidas: liga/desliga o filtro do aerc na pasta aberta da conta em uso (cada aba de conta tem
# o seu). Ligado, a linha de status do aerc mostra "filter -u"; Esc ou o botão de novo desligam.
email_naolidas() {
  if email_filtro_ativo; then email_aerc_cmd :clear; else email_aerc_cmd :filter -u; fi
  return 0
}

# 🧹 Esvaziar a lixeira. A conta é consultada e esvaziada pelo IMAP (email-tt.py lixeira): a pasta
# que o servidor marca como \Trash, apagada de vez (no Gmail, apagar na Lixeira é para sempre).
# Pergunta antes; --sim pula a pergunta; sem terminal e sem --sim, só mostra quanto há. Depois, uma
# rodada completa do sync (em segundo plano) tira as mesmas mensagens do espelho local.
#   tt --email-lixeira [CONTA…|--todas] [--sim]
email_lixeira() {
  local sim=0 todas=0 a s n total=0 saida pasta ok=0; local -a slugs=() vivas=() rotulos=(); local -A E=()
  for a in "$@"; do
    case $a in
      --sim) sim=1 ;;
      --todas) todas=1 ;;
      *) s=$(email_achar "$a") || { echo "Conta não encontrada: $a"; return 1; }; slugs+=("$s") ;;
    esac
  done
  if ((todas || ${#slugs[@]} == 0)); then
    slugs=(); for s in $(email_slugs); do E=(); email_ler "$s" && [[ -n ${E[imap_host]:-} ]] && slugs+=("$s"); done
  fi
  ((${#slugs[@]})) || { echo "Nenhuma conta de e-mail com IMAP cadastrada."; return 1; }
  for s in "${slugs[@]}"; do
    E=(); email_ler "$s" || continue
    printf '%s: consultando a lixeira…' "${E[nome]:-$s}"
    if ! saida=$(python3 -I "$EMAIL_PY" lixeira "$(email_conf_arq "$s")" 2>&1); then
      printf '\r\033[K✗ %s: %s\n' "${E[nome]:-$s}" "${saida#✗ }"; continue
    fi
    pasta=$(sed -n 's/^pasta=//p' <<<"$saida"); n=$(sed -n 's/^mensagens=//p' <<<"$saida")
    printf '\r\033[K  %s — %s: %s mensage%s\n' "${E[nome]:-$s}" "$pasta" "${n:-0}" "$( ((${n:-0} == 1)) && echo m || echo ns)"
    ((${n:-0} > 0)) && { vivas+=("$s"); rotulos+=("${E[nome]:-$s}"); total=$((total + n)); }
  done
  ((total)) || { echo "Nada para apagar: a lixeira já está vazia."; return 0; }
  if ((!sim)); then
    [[ -t 0 && -t 1 ]] || { echo "(Para esvaziar: tt --email-lixeira ${slugs[*]} --sim)"; return 0; }
    printf '\nApagar DE VEZ %s mensage%s da lixeira (%s)? Não dá para desfazer.\n  s = sim, apagar · qualquer outra tecla = não  ' \
      "$total" "$( ((total == 1)) && echo m || echo ns)" "$(IFS=,; echo "${rotulos[*]}" | sed 's/,/, /g')"
    read -rsn1 a; echo
    [[ $a == [sS] ]] || { echo "Nada foi apagado."; return 0; }
  fi
  for s in "${vivas[@]}"; do
    E=(); email_ler "$s" || continue
    if saida=$(python3 -I "$EMAIL_PY" lixeira "$(email_conf_arq "$s")" --esvaziar 2>&1); then
      n=$(sed -n 's/^apagadas=//p' <<<"$saida"); a=$(sed -n 's/^restam=//p' <<<"$saida")
      printf '✓ %s: %s apagada%s%s\n' "${E[nome]:-$s}" "${n:-0}" "$( ((${n:-0} == 1)) || echo s)" "$( ((${a:-0} > 0)) && echo " (restam $a que chegaram agora)")"
      ok=1
      [[ ${E[sync_local]:-} == 1 ]] && (setsid "$EU" --email-sync "$s" --completo >/dev/null 2>&1 </dev/null &)
    else
      printf '✗ %s: %s\n' "${E[nome]:-$s}" "${saida#✗ }"
    fi
  done
  ((ok)) && echo "O espelho local acompanha na rodada do sync que começou agora."
  return 0
}
# A tela 🧹 (botão do popup do e-mail, menu do 📧): escolhe a conta (ou todas) e esvazia com a
# pergunta de email_lixeira. Esc fecha.
email_lixeira_ui() {
  local s esc linhas n md; local -A E=()
  while :; do
    linhas=""
    for s in $(email_slugs); do
      E=(); email_ler "$s" && [[ -n ${E[imap_host]:-} ]] || continue
      n=""; md="$(email_maildir "$s")/${E[pasta_lixeira]:-}"
      [[ ${E[sync_local]:-} == 1 && -n ${E[pasta_lixeira]:-} && -d $md ]] &&
        n=" · $(( $(find "$md/cur" "$md/new" -type f 2>/dev/null | wc -l) )) no espelho"
      linhas+="$s"$'\t'"🧹 ${E[nome]:-$s} — ${E[pasta_lixeira]:-lixeira}$n"$'\n'
    done
    [[ -n $linhas ]] || { echo "Nenhuma conta de e-mail com IMAP cadastrada."; read -rsn1 -t 5 _; return 0; }
    (( $(grep -c . <<<"$linhas") > 1 )) && linhas+="--todas"$'\t'"🧹 Todas as contas"$'\n'
    esc=$(printf '%s' "$linhas" | fzf --delimiter='\t' --with-nth=2 --layout=reverse --no-sort --info=hidden \
      --border=rounded --border-label=' 🧹 esvaziar a lixeira ' --prompt='❯ ' --pointer='▶' \
      --header='⏎ esvazia a conta escolhida (pergunta antes; apaga de vez) · Esc fecha') || return 0
    clear
    email_lixeira "${esc%%$'\t'*}"
    printf '\n(qualquer tecla volta)'; read -rsn1 _
  done
}

# ─── Escrever e-mails (compose do aerc) ──────────────────────────────────────
#
# O aerc chama o tt em três pontos do compose (aerc.conf [compose], posto por configurar_aerc):
#   editor            tt --email-editor ARQ        o editor padronizado (abaixo)
#   address-book-cmd  tt --email-contatos TEXTO    destinatários a partir dos e-mails já trocados
#   file-picker-cmd   tt --email-anexos-escolher F  seletor de anexos (tecla a na revisão)
# e ganha, por conta, a assinatura (signature-file no bloco do accounts.conf, arquivo
# ~/.config/tt/email/<slug>.assinatura) e os avisos de assunto vazio e de anexo esquecido.

# Editor das mensagens: o editor_tt (VISUAL/EDITOR do dono mandam; senão o vim com a configuração
# do tt) mais o jeito de e-mail quando é o vim — largura 72 com format=flowed (fo+=w: o vim deixa
# o espaço no fim da linha quebrada, e o aerc manda text/plain; format=flowed, que o leitor do
# outro lado reflui à largura dele), ortografia em português e inglês (z= sugere), sem números de
# linha, começa escrevendo acima da citação. Sem vim: vi ou nano, como estão.
email_editor() { # [arquivo…]
  local -a ed; read -ra ed <<<"$(editor_tt)"
  case ${ed[0]##*/} in
    vim|nvim)
      local spell=en
      if email_vim_spell_tem; then spell=pt_br,en
      elif [[ -z ${TT_EMAIL_SEM_REDE:-} ]]; then (email_vim_spell_garantir >/dev/null 2>&1 &); fi
      email_vimrc_garantir
      ed+=(--cmd "let g:tt_spelllang='$spell'" -S "$DIR_TT/vimrc-tt-email") ;;
    nano) ed+=(-r 72) ;;
  esac
  if [[ -n ${TT_EMAIL_EDITOR_MOSTRAR:-} ]]; then printf '%q ' "${ed[@]}" "$@"; echo; return 0; fi
  exec "${ed[@]}" "$@"
}
# O trecho de e-mail do vim (vim -S ele, depois do vimrc que estiver valendo).
email_vimrc_garantir() {
  local f=$DIR_TT/vimrc-tt-email tmp
  tmp=$(mktemp) || return 0
  cat >"$tmp" <<'VIMRC'
" E-mail no editor do tt: largura 72 em format=flowed, ortografia pt/en, sem números de linha.
setlocal filetype=mail
setlocal textwidth=72 formatoptions+=w formatoptions+=q formatoptions-=l
setlocal nonumber norelativenumber
execute 'setlocal spelllang=' . get(g:, 'tt_spelllang', 'en')
setlocal spell
let &l:statusline = ' ✉ %m%=Ctrl+S salva e volta à revisão · :q! cancela · z= corrige a palavra  %l/%L '
" Começa escrevendo no alto; se já há texto (a citação da resposta), numa linha nova acima dele.
if !(line('$') == 1 && empty(getline(1))) | call append(0, '') | endif
call cursor(1, 1)
startinsert
VIMRC
  mkdir -p "$DIR_TT" 2>/dev/null
  cmp -s "$tmp" "$f" 2>/dev/null || cat "$tmp" >"$f"
  rm -f "$tmp"
}
# Dicionário de português do vim (~/.vim/spell/pt.utf-8.spl, de onde o próprio vim o leria).
EMAIL_VIM_SPELL="$HOME/.vim/spell/pt.utf-8.spl"
EMAIL_VIM_SPELL_URL=${TT_VIM_SPELL_URL:-https://ftp.nluug.nl/pub/vim/runtime/spell/pt.utf-8.spl}
email_vim_spell_tem() { [[ -s $EMAIL_VIM_SPELL ]]; }
email_vim_spell_garantir() {
  email_vim_spell_tem && return 0
  command -v curl >/dev/null || return 1
  mkdir -p "${EMAIL_VIM_SPELL%/*}" || return 1
  curl -sfL --max-time 120 -o "$EMAIL_VIM_SPELL.tmp" "$EMAIL_VIM_SPELL_URL" && [[ -s $EMAIL_VIM_SPELL.tmp ]] &&
    mv "$EMAIL_VIM_SPELL.tmp" "$EMAIL_VIM_SPELL" || { rm -f "$EMAIL_VIM_SPELL.tmp"; return 1; }
}

# Destinatários: índice "endereço<TAB>nome<TAB>vezes" dos remetentes e destinatários de todos os
# e-mails nos maildirs (contas com sync local), refeito ao fim de cada volta completa do sync e,
# se está velho (> 1 h) quando o aerc pede, em segundo plano. Contatos escritos à mão em
# ~/.config/tt/email/contatos.tsv (endereço<TAB>nome) vêm primeiro. (EMAIL_CONTATOS_* ficam junto
# de EMAIL_DIR, na seção de cadastro.)
email_contatos_indexar() {
  local -a mds=(); local s meus=""; local -A E=()
  for s in $(email_slugs); do
    [[ -d $(email_maildir "$s") ]] && mds+=("$(email_maildir "$s")")
    E=(); email_ler "$s" 2>/dev/null && [[ -n ${E[endereco]:-} ]] && meus+="${meus:+,}${E[endereco]}" # os próprios endereços ficam de fora
  done
  mkdir -p "${EMAIL_CONTATOS_CACHE%/*}"
  ((${#mds[@]})) || { : >"$EMAIL_CONTATOS_CACHE"; return 0; }
  # Uma indexação por vez: ela cobre todas as contas, e as contas sincronizando em paralelo acabavam juntas e
  # disparavam várias (4 por vez, minutos cada uma, saturando o celular). Com a trava ocupada, esta sai.
  (
    flock -n 8 || exit 0
    python3 -I "$EMAIL_PY" contatos-indexar "--sem=$meus" "${mds[@]}" >"$EMAIL_CONTATOS_CACHE.tmp" 2>/dev/null &&
      mv "$EMAIL_CONTATOS_CACHE.tmp" "$EMAIL_CONTATOS_CACHE" || rm -f "$EMAIL_CONTATOS_CACHE.tmp"
  ) 8>"$EMAIL_CONTATOS_CACHE.lock"
}
# tt --email-contatos TEXTO (address-book-cmd): "endereço<TAB>nome" dos que casam com TEXTO (no
# nome ou no endereço, sem distinguir maiúsculas), manuais primeiro, depois os mais frequentes.
email_contatos() {
  local q=${1:-}
  if [[ ! -f $EMAIL_CONTATOS_CACHE ]] || (( $(date +%s) - $(stat -c %Y "$EMAIL_CONTATOS_CACHE" 2>/dev/null || echo 0) > 3600 )); then
    mkdir -p "${EMAIL_CONTATOS_CACHE%/*}"; touch "$EMAIL_CONTATOS_CACHE" # a idade zera já: uma indexação por vez
    ("$EU" --email-contatos-indexar >/dev/null 2>&1 &)
  fi
  { [[ -f $EMAIL_CONTATOS_MANUAL ]] && grep -v '^#' "$EMAIL_CONTATOS_MANUAL"; cut -f1,2 "$EMAIL_CONTATOS_CACHE"; } 2>/dev/null |
    awk -F'\t' -v q="${q,,}" 'NF && $1 != "" { l = tolower($0); if (q == "" || index(l, q)) { k = tolower($1); if (!(k in v)) { v[k] = 1; print $1 "\t" $2; if (++n >= 50) exit } } }'
}

# Seletor de anexos (file-picker-cmd; tecla a na revisão): os arquivos da pasta de recebidos e da
# pasta pessoal, os mais recentes primeiro, Tab marca vários; grava os escolhidos no arquivo que
# o aerc indica (%f). Sem terminal, lê os caminhos da entrada padrão.
email_anexos_escolher() { # arquivo-de-saída
  local saida=${1:?uso: tt --email-anexos-escolher ARQUIVO} esc rec; local -a raizes=()
  rec=$(pasta_recebidos </dev/null 2>/dev/null); [[ -n $rec && -d $rec ]] && raizes+=("$rec") # (</dev/null: no WSL o cmd.exe de pasta_recebidos comeria a entrada)
  raizes+=("$HOME")
  if [[ -t 0 && -t 1 ]] && command -v fzf >/dev/null; then
    esc=$(find "${raizes[@]}" -maxdepth 4 -type f ! -path '*/.*' ! -path '*/node_modules/*' -printf '%T@\t%p\n' 2>/dev/null |
      sort -rn | cut -f2 | awk '!s[$0]++' | head -20000 |
      fzf --multi --layout=reverse --prompt='📎 ' --header='Tab marca vários · ⏎ anexa · Esc cancela' \
        --preview 'ls -lh {} 2>/dev/null | cut -d" " -f5-' --preview-window=down,3,wrap) || esc=""
  else esc=$(cat); fi
  printf '%s\n' "$esc" | sed '/^$/d' >"$saida"
  return 0
}

# Assinatura da conta: ~/.config/tt/email/<slug>.assinatura (texto livre, várias linhas); o bloco
# do aerc ganha signature-file quando o arquivo tem conteúdo. tt --email-assinatura CONTA abre o
# editor_tt nele (sem terminal: lê a entrada padrão); vazio = sem assinatura.
email_assinatura_arq() { echo "$EMAIL_DIR/$1.assinatura"; }
email_assinatura_editar() { # slug
  local slug=$1 f; f=$(email_assinatura_arq "$slug")
  mkdir -p "$EMAIL_DIR"
  if [[ -t 0 ]] && { : >/dev/tty; } 2>/dev/null; then
    local -a ed; read -ra ed <<<"$(editor_tt)"; [[ ${ed[0]##*/} == nano ]] && ed+=(-t)
    "${ed[@]}" "$f" </dev/tty >/dev/tty 2>&1 || true
  else cat >"$f"; fi
  [[ -s $f ]] || rm -f "$f"
  local -A E=(); email_ler "$slug" && email_regerar "$slug"
  if [[ -s $f ]]; then echo "✓ assinatura de ${E[nome]:-$slug} gravada ($(wc -l <"$f") linha$( (($(wc -l <"$f") > 1)) && echo s))"
  else echo "· ${E[nome]:-$slug} fica sem assinatura"; fi
}

# ─── Cadastro e gerência de contas de e-mail (aerc) ────────────────────────────
# Cada conta do tt tem um arquivo chave=valor em ~/.config/tt/email/<slug>.conf (nada secreto:
# provedor, servidores, portas, segurança, autenticação) e o segredo em ~/.secrets/aerc-<slug>.txt
# (600): a senha, ou o token de renovação do OAuth2. O accounts.conf do aerc é GERADO: cada conta do
# tt vira um bloco entre marcadores "# >>> tt e-mail: <slug> >>>"; blocos escritos à mão ficam
# intactos. Nenhuma função aqui imprime, versiona ou copia o segredo.
