# Fixa ou desafixa a sessão S da máquina de rótulo R. Ao fixar uma sessão daqui, o vigia para de
# renomeá-la (senão o item da barra ficaria apontando para um nome que sumiu).
alternar_fixada() {
  local r=$1 s=$2 id="" d
  mkdir -p "$CONF_DIR"; touch "$CONF_FIX"
  # O identificador de uma sessão de outra máquina é pedido antes da trava (ssh pode demorar).
  if [[ $r != "$MAQUINA" ]] && ! awk -F'\t' -v r="$r" -v s="$s" '$1 == r && $2 == s { f=1 } END { exit !f }' "$CONF_FIX"; then
    d=$(dest_de "$r")
    [[ -n $d ]] && id=$(timeout 5 ssh "${SSH_OPC[@]}" "$d" "$TT_REMOTO --session-id $(q "$s")" </dev/null 2>/dev/null)
  fi
  travar_fixadas || return 1
  if awk -F'\t' -v r="$r" -v s="$s" '$1 == r && $2 == s { found=1 } END { exit !found }' "$CONF_FIX"; then
    awk -F'\t' -v r="$r" -v s="$s" '$1 != r || $2 != s' "$CONF_FIX" >"$CONF_FIX.novo"; mv "$CONF_FIX.novo" "$CONF_FIX"
    echo "desafixada"
  else
    [[ $r == "$MAQUINA" ]] && id=$(session_id "$s")
    printf '%s\t%s\t%s\n' "$r" "$s" "$id" >>"$CONF_FIX"
    # A marca fica dentro da sessão. Se ela for renomeada fora do tt, conseguimos achar a
    # mesma sessão pelo marcador e corrigir o nome mostrado na barra.
    if [[ $r == "$MAQUINA" ]]; then
      tmux set-option -t "=$s:" @nome_auto 0 2>/dev/null
      tmux set-option -t "=$s:" @tt_fixado_nome "$s" 2>/dev/null
    else
      d=$(dest_de "$r")
      [[ -n $d ]] && timeout 5 ssh "${SSH_OPC[@]}" "$d" "$PATH_REMOTO tmux set-option -t $(q "=$s:") @nome_auto 0; tmux set-option -t $(q "=$s:") @tt_fixado_nome $(q "$s")" </dev/null >/dev/null 2>&1
    fi
    echo "fixada"
  fi
  marcar_fixadas
  destravar_fixadas
  aplicar_fixadas
  propagar_fixadas
}

# ✕ de um item da faixa de fixadas: desafixa a sessão identificada pela chave estável.
desafixar_item() {
  local c=$1 chave=${2#fxx} r s id k
  while IFS=$'\t' read -r r s id; do
    k=$(fixada_chave "$r" "$s" "$id")
    [[ $k == "$chave" ]] && break
    r=""; s=""
  done < <(fixadas)
  [[ -n $s ]] || return 0
  # Só remove, nunca alterna: o ✕ dispara no apertar e no soltar e, num toque lento (> 0,5 s), os
  # dois rodam juntos; com alternar, o segundo achava a sessão já fora da lista e fixava de novo.
  remover_fixada "$r" "$s" "$id"
  tmux display-message -c "$c" -d 2500 "📌 desafixada: $([[ $r == "$MAQUINA" ]] && echo "$s" || echo "$r:$s")"
}

# Tira da lista a fixada de R com nome S ou identificador ID (o nome pode ter mudado num rename entre
# o clique e a trava). Idempotente: se já saiu, não faz nada.
remover_fixada() {
  local r=$1 s=$2 id=${3:-}
  [[ -f $CONF_FIX ]] || return 0
  travar_fixadas || return 1
  if ! awk -F'\t' -v r="$r" -v s="$s" -v id="$id" '$1 == r && ($2 == s || (id != "" && $3 == id)) { f = 1 } END { exit !f }' "$CONF_FIX"; then
    destravar_fixadas; return 0
  fi
  awk -F'\t' -v r="$r" -v s="$s" -v id="$id" '!($1 == r && ($2 == s || (id != "" && $3 == id)))' "$CONF_FIX" >"$CONF_FIX.novo"
  mv "$CONF_FIX.novo" "$CONF_FIX"
  marcar_fixadas
  destravar_fixadas
  aplicar_fixadas
  propagar_fixadas
}

# Pino ao lado do nome da sessão, na barra (mesma convenção do seletor): 📍 = não fixada, o clique
# fixa; 📌 = fixada, o clique desafixa.
fixar_atual() {
  local c=$1 s r
  s=$(do_cliente "$c" '#{session_name}')
  [[ -n $s ]] || return 0
  r=$(alternar_fixada "$MAQUINA" "$s")
  tmux display-message -c "$c" -d 2500 "$([[ $r == fixada ]] && echo 📌 || echo 📍) $s $r$([[ $r == fixada ]] && echo " — aparece na faixa das fixadas em todas as máquinas; o ✕ dela desafixa")"
}

# Sessão daqui renomeada: o item fixado acompanha.
fixada_renomeada() {
  [[ -f $CONF_FIX ]] || return 0
  travar_fixadas || return 0
  awk -F'\t' -v r="$MAQUINA" -v a="$1" -v n="$2" 'BEGIN { OFS = "\t" } $1 == r && $2 == a { $2 = n; mudou = 1 } { print } END { exit !mudou }' "$CONF_FIX" >"$CONF_FIX.novo" || { rm -f "$CONF_FIX.novo"; destravar_fixadas; return 0; }
  mv "$CONF_FIX.novo" "$CONF_FIX"
  marcar_fixadas
  destravar_fixadas
  tmux set-option -t "=$2:" @tt_fixado_nome "$2" 2>/dev/null
  aplicar_fixadas
  propagar_fixadas
}

# Confere periodicamente os itens fixados. Uma máquina sem resposta é preservada (ela pode
# estar desligada); uma sessão comprovadamente inexistente é desafixada. A marca @tt_fixado_nome
# também permite acompanhar um rename feito diretamente pelo tmux ou por outro programa.
reconciliar_fixadas() {
  [[ -f $CONF_FIX ]] || return 0
  local tmp r s id d resposta st mudou=0 novo novo_id v0
  v0=$(versao_fixadas)
  tmp=$(mktemp "$CONF_FIX.XXXXXX") || return 1
  while IFS=$'\t' read -r r s id; do
    [[ -n $r && -n $s ]] || continue
    novo=$s
    if [[ $r == "$MAQUINA" ]]; then
      # Primeiro resolve pelo UUID. O nome antigo pode ter sido reutilizado por outra sessão.
      if [[ -n $id ]]; then novo=$(session_by_id "$id"); fi
      if [[ -n $novo ]]; then
        opt_sessao "$novo" @tt_fixado_nome "$novo"
        novo_id=$(session_id "$novo")
      elif tmux has-session -t "=$s" 2>/dev/null; then
        # Também migra itens fixados de versões antigas para o marcador de identidade.
        novo=$s
        opt_sessao "$s" @tt_fixado_nome "$s"
        novo_id=$(session_id "$s")
      else
        novo=$(tmux list-sessions -F "#{session_name}"$'\t'"#{@tt_fixado_nome}" 2>/dev/null |
          awk -F'\t' -v antigo="$s" '$2 == antigo { print $1; exit }')
        [[ -n $novo ]] && novo_id=$(session_id "$novo")
      fi
      # Sem sessão e sem marca correspondente: ela foi fechada.
      [[ -n $novo ]] || { mudou=1; continue; }
    else
      d=$(dest_de "$r")
      # Rótulo desconhecido ou máquina inacessível não é evidência de fechamento.
      [[ -n $d ]] || { printf '%s\t%s\t%s\n' "$r" "$s" "$id" >>"$tmp"; continue; }
      resposta=$(timeout 6 ssh "${SSH_OPC[@]}" "$d" "$TT_REMOTO --resolver-fixada $(q "$s") $(q "$id")" </dev/null 2>/dev/null)
      st=$?
      ((st == 0)) || { printf '%s\t%s\t%s\n' "$r" "$s" "$id" >>"$tmp"; continue; }
      novo=${resposta%%$'\t'*}; novo_id=${resposta#*$'\t'}
      [[ -n $novo ]] || { mudou=1; continue; }
    fi
    [[ $novo == "$s" || $novo_id != "$id" ]] || true
    [[ $novo == "$s" && $novo_id == "$id" ]] || mudou=1
    printf '%s\t%s\t%s\n' "$r" "$novo" "$novo_id" >>"$tmp"
  done < <(fixadas)
  # A conferência consulta outras máquinas e leva segundos. Se a lista mudou nesse meio-tempo
  # (fixou/desafixou aqui, ou chegou uma mais nova), esta conferência ficou velha: descarta e a
  # próxima volta do vigia confere de novo. Nunca grava por cima de uma mudança mais recente.
  if ((mudou)) && travar_fixadas; then
    if [[ $(versao_fixadas) == "$v0" ]]; then
      mv "$tmp" "$CONF_FIX"; marcar_fixadas; destravar_fixadas
      aplicar_fixadas
      propagar_fixadas
    else
      destravar_fixadas; rm -f "$tmp"
    fi
  else
    rm -f "$tmp"
  fi
}

# Conteúdo da 2ª linha (chamado pela barra, por sessão: destaca a sessão atual).
# Faixa das fixadas como FORMATO do tmux (vai para @barra_fixadas): o destaque da sessão em uso é
# uma condição do próprio tmux (#{session_name}), então a barra não roda processo nenhum — com
# status-interval curto e comandos #() na barra, cada cliente disparava processos a cada segundo e o
# cursor piscava indo e voltando da barra. Recalculada só quando algo muda (atualizar_barras).
barra_fixadas_fmt() {
  local i=0 r s id rot chave normal='#[bg=#44475a]#[fg=#f8f8f2]#[nobold]' atual='#[bg=#bd93f9]#[fg=#282a36]#[bold]' estilo
  local -A existe
  while read -r s; do existe[$s]=1; done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)
  if [[ -z $(fixadas) ]]; then
    printf '#[fg=#6272a4] ▸ 📌'
    return 0
  fi
  # Overflow: a faixa é uma linha só. Com muitas fixadas o tmux cortaria o fim sem aviso. Em vez
  # disso mostramos uma JANELA de até TT_FIX_VISIVEIS itens a partir de um deslocamento guardado em
  # @fix_off, com setas ‹ › clicáveis quando há itens escondidos (fixprev/fixnext movem a janela).
  # A sessão atual, se fixada, é sempre trazida para dentro da janela, para o destaque não sumir.
  local total vis off atuali=0
  total=$(fixadas | wc -l)
  vis=${TT_FIX_VISIVEIS:-8}; ((vis < 1)) && vis=1
  off=$(tmux show -gqv @fix_off 2>/dev/null); [[ $off =~ ^[0-9]+$ ]] || off=0
  if ((total > vis)); then
    # Só reposiciona a janela pela sessão em uso quando há um cliente anexado de fato: sem cliente,
    # display-message devolveria uma sessão qualquer do servidor (não a que alguém vê na barra).
    local cur=""
    [[ -n $(tmux list-clients -F x 2>/dev/null) ]] && cur=$(tmux display-message -p '#{session_name}' 2>/dev/null)
    if [[ -n $cur ]]; then
      atuali=$(fixadas | awk -F'\t' -v m="$MAQUINA" -v c="$cur" '$1 == m && $2 == c { print NR; exit }')
    fi
    if ((atuali > 0)); then
      ((atuali <= off)) && off=$((atuali - 1))
      ((atuali > off + vis)) && off=$((atuali - vis))
    fi
    ((off > total - vis)) && off=$((total - vis))
    ((off < 0)) && off=0
  else
    off=0
  fi
  [[ $(tmux show -gqv @fix_off 2>/dev/null) == "$off" ]] || tmux set -g @fix_off "$off" 2>/dev/null
  printf '#[fg=#6272a4] ▸ ' # só marcador (não clicável); os pinos da barra são botões
  ((off > 0)) && printf '#[range=user|fixprev]#[fg=#bd93f9,bold] ‹ #[norange]#[default]'
  while IFS=$'\t' read -r r s id; do
    i=$((i + 1))
    ((i <= off)) && continue
    ((i > off + vis)) && break
    chave=$(fixada_chave "$r" "$s" "$id")
    if [[ $r == "$MAQUINA" ]]; then rot=$s; else rot="$r:$s"; fi
    rot=${rot:0:22}; rot=${rot//#/##}
    if [[ $r == "$MAQUINA" && -z ${existe[$s]:-} ]]; then estilo='#[bg=#282a36]#[fg=#6272a4]#[nobold]'; rot="✗ $rot"
    elif [[ $r == "$MAQUINA" && $s != *[,}#]* ]]; then estilo="#{?#{==:#{session_name},$s},$atual,$normal}"
    else estilo=$normal; fi
    # O espaço antes do ✕ fica no range dele: o tmux dá a 1ª coluna de um range ao range colado
    # antes, e um toque bem em cima do ✕ ia para a sessão em vez de desafixar.
    printf '#[range=user|fx%s]%s %s#[norange]#[range=user|fxx%s]%s ✕ #[norange]#[default] ' "$chave" "$estilo" "$rot" "$chave" "$estilo"
  done < <(fixadas)
  ((off + vis < total)) && printf '#[range=user|fixnext]#[fg=#bd93f9,bold] › #[norange]#[default]'
}

# Indicador discreto no canto direito da faixa de fixadas. É uma opção do tmux, não um #(), para
# não iniciar processo a cada redesenho da barra.
versao_barra() { printf '#[fg=#6c7086]v%s ' "$(versao_num)"; }

# Recalcula as faixas da barra (fixadas, atalhos, transferências) e as guarda em opções do tmux,
# que a barra só lê. Redesenha as barras só se algo mudou.
atualizar_barras() {
  tmux list-sessions >/dev/null 2>&1 || return 0
  local nome valor mudou="" c
  for nome in fixadas atalhos transf versao tarefas; do
    case $nome in
      fixadas) valor=$(barra_fixadas_fmt) ;;
      atalhos) valor=$(atalhos_barra) ;;
      transf) valor=$(transferencias_barra) ;;
      versao) valor=$(versao_barra) ;;
      tarefas) valor=$(barra_tarefas_fmt) ;;
    esac
    [[ $valor == "$(tmux show -gqv "@barra_$nome")" ]] && continue
    tmux set -g "@barra_$nome" "$valor"; mudou=1
  done
  [[ -n $mudou ]] || return 0
  for c in $(tmux list-clients -F '#{client_name}' 2>/dev/null); do tmux refresh-client -S -t "$c" 2>/dev/null; done
  return 0
}

barra_fixadas() {
  local atual=${1:-} i=0 r s id rot cor chave
  local -A existe
  while read -r s; do existe[$s]=1; done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)
  printf '#[fg=#6272a4] ▸ ' # só marcador (não clicável); os pinos da barra são botões
  while IFS=$'\t' read -r r s id; do
    i=$((i + 1))
    chave=$(fixada_chave "$r" "$s" "$id")
    if [[ $r == "$MAQUINA" ]]; then rot=$s; else rot="$r:$s"; fi
    rot=${rot:0:22}
    if [[ $r == "$MAQUINA" && $s == "$atual" ]]; then cor='#[bg=#bd93f9,fg=#282a36,bold]'
    elif [[ $r == "$MAQUINA" && -z ${existe[$s]:-} ]]; then cor='#[bg=#282a36,fg=#6272a4]'; rot="✗ $rot"
    else cor='#[bg=#44475a,fg=#f8f8f2]'; fi
    # Item (clique vai à sessão) + ✕ (clique desafixa).
    printf '#[range=user|fx%s]%s %s#[norange]#[range=user|fxx%s]%s ✕ #[norange]#[default] ' "$chave" "$cor" "$rot" "$chave" "$cor"
  done < <(fixadas)
}

# Clique num item fixado: vai para ele (ponte, se for de outra máquina).
ir_fixada() {
  local c=$1 chave=${2#fx} r s id k d resolvida
  while IFS=$'\t' read -r r s id; do
    k=$(fixada_chave "$r" "$s" "$id")
    [[ $k == "$chave" ]] && break
    r=""; s=""
  done < <(fixadas)
  [[ -n $s ]] || return 0
  d=$(dest_de "$r")
  if [[ -z $d ]]; then tmux display-message -c "$c" "📌 $r: máquina não cadastrada ou desligada"; return 0; fi
  if [[ -n $id ]]; then
    if [[ $d == . ]]; then
      resolvida=$(session_by_id "$id")
    else
      resolvida=$(timeout 6 ssh "${SSH_OPC[@]}" "$d" "$TT_REMOTO --resolver-fixada $(q "$s") $(q "$id")" </dev/null 2>/dev/null)
      resolvida=${resolvida%%$'\t'*}
    fi
    [[ -n $resolvida ]] && s=$resolvida
  fi
  if [[ $d == . ]] && ! tmux has-session -t "=$s" 2>/dev/null; then
    reconciliar_fixadas
    tmux display-message -c "$c" "📌 a sessão \"$s\" não existe mais e foi desafixada"; return 0
  fi
  TT_CLIENTE=$c ir_para "$d" "$s"
}

# Botão direito num item fixado.
menu_fixada() {
  local c=$1 chave=${2#fx} r s id k n i
  while IFS=$'\t' read -r r s id; do
    k=$(fixada_chave "$r" "$s" "$id")
    [[ $k == "$chave" ]] && break
    r=""; s=""
  done < <(fixadas)
  [[ -n $s ]] || return 0
  i=$(fixadas | awk -F'\t' -v r="$r" -v s="$s" '$1 == r && $2 == s { print NR; exit }')
  n=$(fixadas | wc -l)
  menu_popup "$c" "📌 $([[ $r == "$MAQUINA" ]] && echo "$s" || echo "$r:$s")" <<ITENS
i	Ir para esta sessão	$EU --ir-fixada $(q "$c") fx$chave
d	Desafixar da barra	$EU --alternar-fixada-rotulo $(q "$r") $(q "$s")
-		
e	◀ Mover para a esquerda	$( ((i > 1)) && echo "$EU --mover-fixada $i $((i - 1))")
r	▶ Mover para a direita	$( ((i < n)) && echo "$EU --mover-fixada $i $((i + 1))")
a	⏮ Mover para o início	$( ((i > 1)) && echo "$EU --mover-fixada $i 1")
z	⏭ Mover para o fim	$( ((i < n)) && echo "$EU --mover-fixada $i $n")
ITENS
}

mover_fixada() {
  local i=$1 j=$2 n
  travar_fixadas || return 0
  n=$(grep -vc '^\s*$' "$CONF_FIX" 2>/dev/null || echo 0)
  # j é o índice de DESTINO absoluto (1..n); fora da faixa é saturado. Mover um item para j desloca
  # os demais (não é troca de pares), para "ir ao início/fim" chegar em um passo.
  ((j < 1)) && j=1; ((j > n)) && j=$n
  if ((i >= 1 && i <= n && i != j)); then
    awk -v i="$i" -v j="$j" '
      { l[NR] = $0 }
      END {
        it = l[i]
        if (i < j) { for (k = i; k < j; k++) l[k] = l[k + 1] }
        else       { for (k = i; k > j; k--) l[k] = l[k - 1] }
        l[j] = it
        for (k = 1; k <= NR; k++) print l[k]
      }' "$CONF_FIX" >"$CONF_FIX.novo" && mv "$CONF_FIX.novo" "$CONF_FIX"
    marcar_fixadas
  fi
  destravar_fixadas
  aplicar_fixadas
  propagar_fixadas
}

# Setas ‹ › da faixa: movem a janela visível (deslocamento @fix_off) de uma página de cada vez,
# saturando nas pontas. Só redesenha a barra; não mexe na lista nem propaga para outras máquinas.
fixada_scroll() {
  local dir=$1 total vis off
  total=$(fixadas | wc -l)
  vis=${TT_FIX_VISIVEIS:-8}; ((vis < 1)) && vis=1
  ((total > vis)) || { tmux set -g @fix_off 0 2>/dev/null; atualizar_barras; return 0; }
  off=$(tmux show -gqv @fix_off 2>/dev/null); [[ $off =~ ^[0-9]+$ ]] || off=0
  case $dir in
    prev) off=$((off - vis)) ;;
    next) off=$((off + vis)) ;;
  esac
  ((off > total - vis)) && off=$((total - vis))
  ((off < 0)) && off=0
  tmux set -g @fix_off "$off" 2>/dev/null
  atualizar_barras
}

# Botão direito na barra: em "máquina ▾" a administração, em "sessão ▾" o menu da sessão, no resto
# da área da esquerda o menu das máquinas. RANGE CLIENTE PAINEL [X-DO-MOUSE].
clique_direito() {
  export TT_X=$(( ${4:-0} > 4 ? ${4:-0} - 4 : 0 ))
  local faixa=${1#user|}
  case $faixa in
    fxx*) desafixar_item "$2" "${faixa#fxx}" ;;
    fixprev | fixnext) : ;;
    fx*) menu_fixada "$2" "$faixa" ;;
    at[0-9]*) atalho_info "$2" "${faixa#at}" ;;
    maquina) menu_admin "$2" "$3" ;;
    sessao) menu_sessao "$2" "$3" ;;
    email) menu_email "$2" ;;
    tarefas) menu_tarefas "$2" ;;
    *) menu_maquinas "$2" "$3" ;;
  esac
}

# Botão direito no 📧: tudo do e-mail num lugar só.
menu_email() {
  local c=$1
  menu_popup "$c" "📧 e-mail" <<ITENS
e	📧 Abrir o e-mail	$EU --email $(q "$c")
c	👤 Contas: cadastrar, descadastrar, testar…	$EU --email-contas $(q "$c")
n	＋ Cadastrar uma conta…	tmux display-popup -c $(q "$c") -E $(tam_popup "$c") -T ' 📧 nova conta ' "cd ${HOME@Q}; $EU --email-conta-nova-ui"
a	⌨ Atalhos do e-mail	tmux display-popup -c $(q "$c") -E $(tam_popup "$c") -T ' ⌨ atalhos do e-mail ' "$EU --email-atalhos"
ITENS
}

# Anexos de um e-mail → pasta de recebidos de uma máquina do tt. A tecla E do aerc salva os anexos
# da mensagem aberta em ~/.cache/tt-anexos/atual e abre isto: marca quais, escolhe a máquina no
# mesmo seletor do ⇅ arquivos, e a cópia segue em segundo plano (barra mostra o andamento).
anexos_enviar() {
  local base="$HOME/.cache/tt-anexos" lote dst ddst escolha
  local -a nomes=()
  # lotes velhos (enviados há mais de 1 dia) somem
  find "$base" -mindepth 1 -maxdepth 1 -type d ! -name atual -mtime +1 -exec rm -rf {} + 2>/dev/null
  [[ -d $base/atual && -n $(ls -A "$base/atual" 2>/dev/null) ]] || { echo "Esta mensagem não tem anexos."; read -rsn1 -t 3; return 0; }
  lote="$base/$(date +%Y%m%d-%H%M%S)"; mv "$base/atual" "$lote"
  escolha=$(cd "$lote" && ls -1 | fzf --multi --bind 'start:select-all' --layout=reverse --height=~20 --border=rounded \
    --border-label=' 📎 anexos para enviar (Tab marca/desmarca · ⏎ segue) ' --prompt='❯ ' --pointer='▶' --marker='✔' \
    --preview 'f={}; printf "%s\n%s\n" "$(du -h "$f" | cut -f1)" "$(file -b "$f" 2>/dev/null)"' --preview-window=down,3) || { rm -rf "$lote"; return 0; }
  mapfile -t nomes <<<"$escolha"; ((${#nomes[@]})) || { rm -rf "$lote"; return 0; }
  dst=$(escolher_maquina "📤 enviar ${#nomes[@]} anexo(s) para") || { rm -rf "$lote"; return 0; }
  [[ -n $dst ]] || { rm -rf "$lote"; return 0; }
  ddst=$(rodar "$dst" --pasta-recebidos)
  transferir . "$(encurtar "$lote")" "$dst" "$ddst" "${nomes[@]}"
}

