  else
    w=$(( cw >= 120 ? 72 : 64 )); ((w > cw)) && w=$cw; x=$((cw - w))
  fi
  tmux display-popup -c "$c" -x "$x" -y S -w "$w" -h 100% -b rounded -S 'fg=#89b4fa' \
