  printf '\t\n\t %sDESCRIÇÃO%s\n' "$a" "$z"
  printf '\t   Tarefa com descrição mostra %s≡%s no fim da linha. Para ler, escolha a\n' "$s" "$z"
  printf '\t   tarefa e tecle %s^/%s (ou %s⋯ menu%s → Ver a descrição): a descrição inteira\n' "$y" "$z" "$a" "$z"
  printf '\t   aparece embaixo, num cartão com prazo e subtarefas (^/ fecha).\n'
  printf '\t   %s^e%s (ou %s✎ Descrição%s) edita no editor do tt (Ctrl+S salva e sai).\n' "$y" "$z" "$y" "$z"
  printf '\t\n\t %sSUBTAREFAS%s\n' "$a" "$z"
