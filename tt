  --ticker-loop) exit 0 ;; # compatibilidade: o vigia de uma versão antiga ainda chama isto na troca; o letreiro é o #() da barra
  --ticker-quadro) python3 -I "$DIR_TT/letreiro-tt.py" quadro "${2:-}"; exit ;; # [largura]: um quadro do miolo da faixa (diagnóstico)
  --ticker-fontes) ticker_atualizar_fontes; ticker_linha_montar; echo; exit 0 ;;
  --mover-fixada) mover_fixada "$2" "$3"; exit ;;
