# --- Sessões fixadas ----------------------------------------------------------
#
# Uma segunda linha na barra com as sessões fixadas (desta ou de outras máquinas), cada uma um
# botão: clique vai para ela; botão direito: ir, desafixar, mover. Lista em ~/.config/tt/fixadas
# ("rótulo-da-máquina<TAB>sessão", na ordem da barra). A linha só aparece se houver alguma.

CONF_FIX=$CONF_DIR/fixadas

fixadas() { [[ -f $CONF_FIX ]] && grep -v '^\s*$' "$CONF_FIX"; }

# A lista é a mesma em todas as máquinas: cada mudança é copiada para as cadastradas (em segundo
# plano), e cada uma redesenha a barra. Assim as fixadas não somem ao entrar numa sessão de outra
# máquina (a barra que aparece é a de lá).
propagar_fixadas() {
  local dest rot v
  v=$(versao_fixadas)
  while read -r dest rot; do
    (timeout 8 ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --receber-fixadas $v" <"$CONF_FIX" >/dev/null 2>&1 &)
  done < <(maquinas)
}

# Versão da lista: a hora (ns) da última mudança, em ~/.config/tt/fixadas.v.
versao_fixadas() { local v; v=$(cat "$CONF_FIX.v" 2>/dev/null); echo "${v:-0}"; }
marcar_fixadas() { date +%s%N >"$CONF_FIX.v"; }

# Recebe a lista de outra máquina (stdin) com a versão V. Só aceita se for mais nova que a daqui:
# uma máquina que volta atrasada nunca desfaz uma mudança mais recente.
receber_fixadas() {
  local v=${1:-0} tmp
  mkdir -p "$CONF_DIR"
  tmp=$(mktemp "$CONF_FIX.XXXXXX"); cat >"$tmp"
  if [[ $v =~ ^[0-9]+$ ]] && ((v > $(versao_fixadas))); then
    mv "$tmp" "$CONF_FIX"; echo "$v" >"$CONF_FIX.v"
    aplicar_fixadas
  else
    rm -f "$tmp"
  fi
}

# Puxa a lista mais nova entre as máquinas cadastradas (o vigia chama ao iniciar e a cada 5 min):
# assim quem estava desligada na hora da mudança se atualiza sozinha ao voltar.
puxar_fixadas() {
  local dest rot v melhor_v melhor_d
  melhor_v=$(versao_fixadas) melhor_d=""
  while read -r dest rot; do
    v=$(timeout 6 ssh "${SSH_OPC[@]}" "$dest" 'cat ~/.config/tt/fixadas.v 2>/dev/null || echo 0' </dev/null 2>/dev/null)
    [[ $v =~ ^[0-9]+$ ]] && ((v > melhor_v)) && { melhor_v=$v; melhor_d=$dest; }
  done < <(maquinas)
  [[ -n $melhor_d ]] || return 0
  timeout 8 ssh "${SSH_OPC[@]}" "$melhor_d" 'cat ~/.config/tt/fixadas 2>/dev/null' </dev/null 2>/dev/null | receber_fixadas "$melhor_v"
}

# Liga/desliga a 2ª linha e força a barra a se redesenhar já (o #() da barra muda de comando).
aplicar_fixadas() {
  tmux list-sessions >/dev/null 2>&1 || return 0
  if [[ -n $(fixadas) ]]; then tmux set -g status 2; else tmux set -g status on; fi
  tmux set -g @fixadas_v "$(date +%s%N)"
  tmux refresh-client -S 2>/dev/null
  local c; for c in $(tmux list-clients -F '#{client_name}'); do tmux refresh-client -S -t "$c" 2>/dev/null; done
}

# Fixa ou desafixa a sessão S da máquina de rótulo R. Ao fixar uma sessão daqui, o vigia para de
# renomeá-la (senão o item da barra ficaria apontando para um nome que sumiu).
alternar_fixada() {
  local r=$1 s=$2
  mkdir -p "$CONF_DIR"; touch "$CONF_FIX"
  if grep -qxF "$r"$'\t'"$s" "$CONF_FIX"; then
    grep -vxF "$r"$'\t'"$s" "$CONF_FIX" >"$CONF_FIX.novo"; mv "$CONF_FIX.novo" "$CONF_FIX"
    echo "desafixada"
  else
    printf '%s\t%s\n' "$r" "$s" >>"$CONF_FIX"
    if [[ $r == "$MAQUINA" ]]; then tmux set-option -t "=$s:" @nome_auto 0 2>/dev/null
    else d=$(dest_de "$r"); [[ -n $d ]] && timeout 5 ssh "${SSH_OPC[@]}" "$d" "tmux set-option -t $(q "=$s:") @nome_auto 0" </dev/null >/dev/null 2>&1; fi
    echo "fixada"
  fi
  marcar_fixadas
  aplicar_fixadas
  propagar_fixadas
}

# Sessão daqui renomeada: o item fixado acompanha.
fixada_renomeada() {
  [[ -f $CONF_FIX ]] || return 0
  awk -F'\t' -v r="$MAQUINA" -v a="$1" -v n="$2" 'BEGIN { OFS = "\t" } $1 == r && $2 == a { $2 = n } { print }' "$CONF_FIX" >"$CONF_FIX.novo" &&
    mv "$CONF_FIX.novo" "$CONF_FIX"
  marcar_fixadas
  aplicar_fixadas
  propagar_fixadas
}

# Conteúdo da 2ª linha (chamado pela barra, por sessão: destaca a sessão atual).
barra_fixadas() {
  local atual=${1:-} i=0 r s rot cor
  local -A existe
  while read -r s; do existe[$s]=1; done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)
  printf '#[fg=#6272a4] 📌 '
  while IFS=$'\t' read -r r s; do
    i=$((i + 1))
    if [[ $r == "$MAQUINA" ]]; then rot=$s; else rot="$r:$s"; fi
    rot=${rot:0:22}
    if [[ $r == "$MAQUINA" && $s == "$atual" ]]; then cor='#[bg=#bd93f9,fg=#282a36,bold]'
    elif [[ $r == "$MAQUINA" && -z ${existe[$s]:-} ]]; then cor='#[bg=#282a36,fg=#6272a4]'; rot="✗ $rot"
    else cor='#[bg=#44475a,fg=#f8f8f2]'; fi
    printf '#[range=user|fx%d]%s %s #[norange]#[default] ' "$i" "$cor" "$rot"
  done < <(fixadas)
}

# Clique num item fixado: vai para ele (ponte, se for de outra máquina).
ir_fixada() {
  local c=$1 i=${2#fx} r s d
  IFS=$'\t' read -r r s < <(fixadas | sed -n "${i}p")
  [[ -n $s ]] || return 0
  d=$(dest_de "$r")
  if [[ -z $d ]]; then tmux display-message -c "$c" "📌 $r: máquina não cadastrada ou desligada"; return 0; fi
  if [[ $d == . ]] && ! tmux has-session -t "=$s" 2>/dev/null; then
    tmux display-message -c "$c" "📌 a sessão \"$s\" não existe mais (botão direito no item para desafixar)"; return 0
  fi
  TT_CLIENTE=$c ir_para "$d" "$s"
}

# Botão direito num item fixado.
menu_fixada() {
  local c=$1 i=${2#fx} r s n
  IFS=$'\t' read -r r s < <(fixadas | sed -n "${i}p")
  [[ -n $s ]] || return 0
  n=$(fixadas | wc -l)
  menu_popup "$c" "📌 $([[ $r == "$MAQUINA" ]] && echo "$s" || echo "$r:$s")" <<ITENS
i	Ir para esta sessão	$EU --ir-fixada $(q "$c") fx$i
d	Desafixar da barra	$EU --alternar-fixada-rotulo $(q "$r") $(q "$s")
-		
e	◀ Mover para a esquerda	$( ((i > 1)) && echo "$EU --mover-fixada $i -1")
r	▶ Mover para a direita	$( ((i < n)) && echo "$EU --mover-fixada $i 1")
ITENS
}

mover_fixada() {
  local i=$1 delta=$2 j
  j=$((i + delta))
  awk -v i="$i" -v j="$j" '{ l[NR] = $0 } END { t = l[i]; l[i] = l[j]; l[j] = t; for (k = 1; k <= NR; k++) print l[k] }' "$CONF_FIX" >"$CONF_FIX.novo" &&
    mv "$CONF_FIX.novo" "$CONF_FIX"
  marcar_fixadas
  aplicar_fixadas
  propagar_fixadas
}

# Botão direito na barra: em "máquina ▾" a administração, em "sessão ▾" o menu da sessão, no resto
# da área da esquerda o menu das máquinas. RANGE CLIENTE PAINEL [X-DO-MOUSE].
clique_direito() {
  export TT_X=$(( ${4:-0} > 4 ? ${4:-0} - 4 : 0 ))
  case $1 in
    fx*) menu_fixada "$2" "$1" ;;
    maquina) menu_admin "$2" "$3" ;;
    sessao) menu_sessao "$2" "$3" ;;
    *) menu_maquinas "$2" "$3" ;;
  esac
}

# Clique num botão da barra de baixo: RANGE CLIENTE PAINEL PASTA [X-DO-MOUSE].
clique() {
  export TT_X=$(( ${5:-0} > 4 ? ${5:-0} - 4 : 0 ))
  case $1 in
    maquina) menu_maquinas "$2" "$3" ;;
    arquivos) menu_arquivos "$2" "$3" ;;
    transferencias) tmux display-popup -c "$2" $(tam_popup "$2") -T ' transferências ' "$EU --transferencias" ;;
    ajustar) ajustar "$2" ;;
    sessao) seletor_em "$2" "$MAQUINA" "$3" ;;
    fx*) ir_fixada "$2" "$1" ;;
    tt) tmux display-popup -c "$2" -E $(tam_popup "$2") "TT_CLIENTE=$(q "$2") TT_PANE=$3 $EU" ;;
    lado) tmux split-window -h -t "$3" -c "$4" ;;
    baixo) tmux split-window -v -t "$3" -c "$4" ;;
    painel) menu_painel "$2" "$3" ;;
  esac
}

# --- Arquivos entre máquinas -----------------------------------------------
#
# Navegador de pastas (→ entra, ← sobe, Tab marca arquivos ou pastas inteiras, ⏎ confirma) numa
# máquina, escolha da máquina e da pasta de destino, e cópia por tar+ssh (de/para qualquer máquina,
# inclusive entre duas outras). Pastas são empacotadas recursivamente. Nada é sobrescrito: se já
# existe, chega como "nome (2)". Quem recebe vê um aviso na tela.

# wsl | termux | linux
tipo_maquina() {
  if grep -qi microsoft /proc/version 2>/dev/null; then echo wsl
  elif [[ ${PREFIX:-} == *com.termux* ]]; then echo termux
  else echo linux; fi
}

# Como a pasta aparece para quem usa esta máquina: no WSL, o caminho do Windows (C:\… ou
# \\wsl.localhost\…, que o Explorer não mostra sozinho); no Termux, se está no armazenamento do
# Android (visível no app de arquivos) ou só dentro do Termux.
caminho_visivel() {
  local d
  d=$(expandir "$1")
  case $(tipo_maquina) in
    wsl)
      if [[ $d == /mnt/[a-z]/* ]]; then echo "$(wslpath -w "$d" 2>/dev/null || echo "$d")  (aparece no Explorer)"
      else echo "$(wslpath -w "$d" 2>/dev/null || echo "$d")  (só dentro do WSL, fora das pastas do Windows)"; fi ;;
    termux)
      local r; r=$(readlink -f "$d" 2>/dev/null || echo "$d")
      if [[ $r == /storage/emulated/0/* ]]; then echo "Armazenamento interno/${r#/storage/emulated/0/}  (aparece no app de arquivos)"
      else echo "$d  (só dentro do Termux)"; fi ;;
    *) echo "$d" ;;
  esac
}

# Pasta padrão onde ESTA máquina recebe arquivos: "recebidos=" no config. Sem ele: no WSL, a pasta
# Downloads\Recebidos do Windows (aparece no Explorer; descoberta uma vez e gravada no config);
# nas outras, ~/Recebidos.
pasta_recebidos() {
  local p u
  p=$(conf recebidos)
  if [[ -z $p ]] && grep -qi microsoft /proc/version 2>/dev/null; then
    u=$(cd /mnt/c 2>/dev/null && timeout 5 /mnt/c/Windows/System32/cmd.exe /c 'echo %USERNAME%' 2>/dev/null | tr -d '\r')
    if [[ -n $u && -d /mnt/c/Users/$u/Downloads ]]; then
      p="/mnt/c/Users/$u/Downloads/Recebidos"
      mkdir -p "$CONF_DIR"; echo "recebidos=$p" >>"$CONF"
    fi
  fi
  if [[ -z $p && $(tipo_maquina) == termux && -d $HOME/storage/downloads ]]; then
    p='~/storage/downloads/Recebidos'
  fi
  echo "${p:-~/Recebidos}"
}

# Grava a pasta padrão de recebidos desta máquina (sem argumento: escolhe navegando).
definir_recebidos() {
  local p=${1:-}
  if [[ -z $p ]]; then
    p=$(escolher_arquivos . "$(pasta_recebidos)" "pasta padrão de recebidos" pasta) || return 0
  fi
  [[ -n $p ]] || return 0
  mkdir -p "$(expandir "$p")" || { echo "Não consegui criar $p"; return 1; }
  mkdir -p "$CONF_DIR"
  grep -v '^recebidos=' "$CONF" 2>/dev/null >"$CONF.novo"; echo "recebidos=$p" >>"$CONF.novo"; mv "$CONF.novo" "$CONF"
  echo "✓ Os arquivos enviados para $MAQUINA passam a chegar em: $(caminho_visivel "$p")"
}

# tt --pasta-padrao [caminho | máquina:caminho | máquina]
pasta_padrao_cli() {
  local a=${1:-} maq dest p
  if [[ -z $a ]]; then definir_recebidos; return; fi
  maq=${a%%:*}; dest=$(dest_de "$maq")
  if [[ -n $dest && $dest != . && ( $a == *:* || $a == "$maq" ) ]]; then
    [[ $a == *:* ]] && p=${a#*:} || p=$(escolher_arquivos "$dest" "$(rodar "$dest" --pasta-recebidos)" "pasta padrão de $maq" pasta) || return 0
    rodar "$dest" --definir-recebidos "$p"
  else
    definir_recebidos "${a#*:}"
  fi
}

# Destinos possíveis nesta máquina (para quem envia escolher): "pasta<TAB>descrição".
destinos() {
  local p v s
  p=$(pasta_recebidos)
  printf '%s\t\033[1m%s\033[0m \033[32m(padrão: recebidos)\033[0m \033[90m%s\033[0m\n' "$p" "$p" "$(caminho_visivel "$p" | sed 's/^[^(]*//')"
  while IFS=$'\t' read -r v s; do
    printf '%s\t\033[1m%s\033[0m \033[90m(sessão %s) %s\033[0m\n' "$v" "$v" "$s" "$(caminho_visivel "$v" | sed 's/^[^(]*//')"
  done < <(pastas_sessoes)
  printf '~\t\033[1m~\033[0m \033[90m(pasta pessoal) %s\033[0m\n' "$(caminho_visivel '~' | sed 's/^[^(]*//')"
}

# Abre a pasta no gerenciador de arquivos (Explorer no WSL; o da área de trabalho no Linux).
# Sem nenhum, abre uma janela do tmux nela (no cliente C).
abrir_pasta() {
  local dir c=${2:-} sess
  dir=$(expandir "$1"); mkdir -p "$dir"
  if grep -qi microsoft /proc/version 2>/dev/null && [[ -x /mnt/c/Windows/explorer.exe ]]; then
    (cd /mnt/c && /mnt/c/Windows/explorer.exe "$(wslpath -w "$dir")") && return
  fi
  if [[ -n ${WAYLAND_DISPLAY:-}${DISPLAY:-} ]] || [[ -S ${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wayland-0 ]]; then
    WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-0} setsid xdg-open "$dir" >/dev/null 2>&1 </dev/null && return
  fi
  sess=$( [[ -n $c ]] && do_cliente "$c" '#{session_name}')
  tmux new-window ${sess:+-t "=$sess:"} -c "$dir" -n recebidos
}

# "~" e "~/x" → caminho absoluto nesta máquina (as funções de arquivos sempre rodam na máquina
# dona da pasta, via tt de lá).
expandir() {
  case $1 in
    '~') echo "$HOME" ;;
    '~/'*) echo "$HOME/${1#\~/}" ;;
    *) echo "$1" ;;
  esac
}

# Roda um subcomando do tt em DEST repassando stdin/stdout (para os fluxos de tar).
rodar_io() {
  local dest=$1; shift
  if [[ $dest == . ]]; then (cd && "$EU" "$@")
  else ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO $(q "$@")"; fi
}

# Lista uma pasta (desta máquina) para o navegador: "tipo<TAB>nome<TAB>texto". Pastas primeiro.
listar_pasta() {
  local dir=$1 ocultos=${2:-} so_pastas=${3:-}
  cd "$(expandir "$dir")" 2>/dev/null || { printf 'x\t\t\033[31mpasta não encontrada: %s\033[0m\n' "$dir"; return; }
  printf 'u\t..\t\033[36m⬆ ..\033[0m \033[90m(%s)\033[0m\n' "$(encurtar "$(dirname "$PWD")")"
  local -a filtro=()
  [[ -n $ocultos ]] || filtro=(-not -name '.*')
  [[ -n $so_pastas ]] && filtro+=(-type d)
  find . -mindepth 1 -maxdepth 1 "${filtro[@]}" \
    -printf '%y\t%f\t%s\t%TY-%Tm-%Td %TH:%TM\n' 2>/dev/null |
    sort -t$'\t' -k1,1 -k2,2f |
    awk -F'\t' '{
      if ($1 == "d") printf "d\t%s\t\033[1;34m▸ %s/\033[0m\n", $2, $2
      else {
        t = $3; u = "B"
        if (t >= 1073741824) { t = t / 1073741824; u = "G" } else if (t >= 1048576) { t = t / 1048576; u = "M" } else if (t >= 1024) { t = t / 1024; u = "K" }
        printf "f\t%s\t  %-40s \033[90m%6.1f%s  %s\033[0m\n", $2, $2, t, u, $4
      }
    }'
}

# Prévia de um item: pasta → conteúdo; texto → começo; binário → tipo e tamanho.
previa_item() {
  local dir=$1 nome=$2 alvo
  alvo="$(expandir "$dir")/$nome"
  [[ $nome == .. ]] && alvo=$(dirname "$(expandir "$dir")")
  if [[ -d $alvo ]]; then ls -la --color=always "$alvo" 2>/dev/null | head -60
  elif file -b --mime "$alvo" 2>/dev/null | grep -q 'charset=binary'; then
    echo "$(file -b "$alvo")"; du -h "$alvo" | cut -f1
  else head -c 20000 "$alvo" 2>/dev/null | head -80; fi
}

# Pasta absoluta (resolvida nesta máquina) de "~/x", "..", relativos.
resolver_pasta() { (cd "$(expandir "$1")" 2>/dev/null && encurtar "$(pwd -P)"); }

# Navegador: imprime a pasta final na 1ª linha e os nomes escolhidos nas seguintes.
escolher_arquivos() {
  local dest=$1 dir=$2 titulo=${3:-escolha} modo=${4:-} saida
  estado_por arq_modo "$modo"
  estado_por arq_dest "$dest"
  estado_por arq_dir "$(rodar "$dest" --resolver-pasta "$dir" || echo "$dir")"
  estado_por arq_ocultos ""
  saida=$(rodar "$dest" --listar-pasta "$(estado arq_dir)" "" "$modo" | fzf --ansi $([[ -z $modo ]] && echo --multi) --delimiter='\t' --with-nth=3 \
    --layout=reverse --no-sort --exact --prompt='❯ ' --pointer='▶' --marker='✓' \
    --border=rounded --border-label=" 📁 $titulo · $(rotulo "$dest") " --border-label-pos=3 \
    --header="$(cabecalho_arquivos)" \
    --color='bg:#282a36,fg:#f8f8f2,border:#bd93f9,label:#bd93f9:bold,header:#f8f8f2,pointer:#ff79c6,marker:#50fa7b,prompt:#bd93f9,hl:#f1fa8c,hl+:#ffb86c,fg+:#f8f8f2,bg+:#44475a' \
    --preview="$EU --previa-item-em {1} {2}" --preview-window="$(compacto && echo 'down,40%,border-top,hidden' || echo 'right,45%,border-left')" \
    --bind='ctrl-/:toggle-preview' \
    --bind="right:transform($EU --arq-acao entrar {1} {2})" \
    --bind="left:transform($EU --arq-acao subir)" \
    --bind="enter:transform($EU --arq-acao enter {1} {2})" \
    --bind="double-click:transform($EU --arq-acao enter {1} {2})" \
    --bind="click-header:transform($EU --arq-acao clique)" \
    --bind="alt-h:transform($EU --arq-acao ocultos)" \
    --bind="ctrl-s:accept") || return 1
  estado arq_dir
  [[ -n $modo ]] && return 0
  cut -f2 <<<"$saida" | grep -v '^\.\.$' | grep -v '^$'
}

cabecalho_arquivos() {
  printf '\033[1m%s\033[0m\n' "$(estado arq_dir)"
  if [[ -n $(estado arq_modo) ]]; then
    echo "✓ usar-esta-pasta   ⬆ subir   ⌂ início   ◌ ocultos"
    printf '\033[90m%s\033[0m\n' "→ ou ⏎ entra na pasta · ← sobe · ^s ou ✓ usa a pasta mostrada acima"
  else
    echo "⬆ subir   ⌂ início   ✓ confirmar   ◌ ocultos"
    printf '\033[90m%s\033[0m\n' "Tab marca arquivos ou pastas inteiras · →/⏎ entra · ← sobe · ⏎ confirma marcados"
  fi
}

# Ações do navegador (devolvem ações do fzf).
arq_acao() {
  local a=$1 tipo=${2:-} nome=${3:-} dir dest w recarga
  dir=$(estado arq_dir); dest=$(estado arq_dest)
  recarga="reload-sync($EU --listar-pasta-em)+transform-header($EU --cabecalho-arquivos)+clear-query+first"
  case $a in
    clique)
      w=$(palavra_em "$(cabecalho_arquivos | sed -n "${FZF_CLICK_HEADER_LINE:-0}p" | sed 's/\x1b\[[0-9;]*m//g')" "${FZF_CLICK_HEADER_COLUMN:-0}")
      case $w in
        ⬆ | subir) arq_acao subir ;;
        ⌂ | início) estado_por arq_dir '~'; echo "$recarga" ;;
        ✓ | confirmar | usar-esta-pasta) echo accept ;;
        ◌ | ocultos) arq_acao ocultos ;;
      esac ;;
    subir)
      [[ -n ${FZF_QUERY:-} ]] && { echo backward-char; return; }
      estado_por arq_dir "$(rodar "$dest" --resolver-pasta "$dir/..")"; echo "$recarga" ;;
    entrar)
      [[ -n ${FZF_QUERY:-} ]] && { echo forward-char; return; }
      case $tipo in
        d) estado_por arq_dir "$(rodar "$dest" --resolver-pasta "$dir/$nome")"; echo "$recarga" ;;
        u) arq_acao subir ;;
      esac ;;
    enter)
      if ((${FZF_SELECT_COUNT:-0} > 0)); then echo accept
      elif [[ $tipo == d ]]; then estado_por arq_dir "$(rodar "$dest" --resolver-pasta "$dir/$nome")"; echo "$recarga"
      elif [[ $tipo == u ]]; then FZF_QUERY="" arq_acao subir
      elif [[ $tipo == f ]]; then echo accept; fi ;;
    ocultos)
      [[ -n $(estado arq_ocultos) ]] && estado_por arq_ocultos "" || estado_por arq_ocultos 1
      echo "$recarga" ;;
  esac
}

# Pastas de destino possíveis em DEST: a de cada sessão de lá (mais usadas primeiro), Recebidos, início.
pastas_sessoes() {
  tmux list-sessions -F '#{window_activity}|#{@ponte}|#{pane_current_path}|#{session_name}' 2>/dev/null |
    sort -t'|' -k1,1nr | awk -F'|' '$2 == "" && !v[$3]++ { print $3 "|" $4 }' |
    while IFS='|' read -r p s; do printf '%s\t%s\n' "$(encurtar "$p")" "$s"; done
}

escolher_destino() {
  local dest=$1 aqui=${2:-} titulo=${3:-Para qual pasta?} escolha p
  escolha=$( {
      [[ -n $aqui ]] && printf '%s\t\033[1m%s\033[0m \033[90m(pasta deste painel)\033[0m\n' "$aqui" "$aqui"
      rodar "$dest" --destinos
      printf '!padrao\t\033[36m⚙ mudar a pasta padrão de %s…\033[0m\n' "$(rotulo "$dest")"
      printf '!outra\t\033[36m✎ outra pasta…\033[0m\n'
    } | awk -F'\t' '!v[$1]++' | fzf --ansi --delimiter='\t' --with-nth=2 --layout=reverse --no-sort \
      --border=rounded --border-label=" $titulo · $(rotulo "$dest") " --border-label-pos=3 \
      --prompt='❯ ' --pointer='▶' --color='bg:#282a36,fg:#f8f8f2,border:#bd93f9,label:#bd93f9:bold,pointer:#ff79c6,fg+:#f8f8f2,bg+:#44475a' \
      --bind='left-click:accept' | cut -f1) || return 1
  if [[ $escolha == !outra ]]; then read -rep "Pasta em $(rotulo "$dest"): " -i "~/" p; escolha=$p; fi
  if [[ $escolha == !padrao ]]; then
    escolha=$(escolher_arquivos "$dest" "$(rodar "$dest" --pasta-recebidos)" "nova pasta padrão de $(rotulo "$dest")" pasta) || return 1
    rodar "$dest" --definir-recebidos "$escolha" >&2
  fi
  [[ -n $escolha ]] && echo "$escolha"
}

escolher_maquina() {
  local titulo=$1 exceto=${2:-}
  { [[ $exceto != . ]] && printf '.\t\033[1m%s\033[0m \033[90m(esta)\033[0m\n' "$MAQUINA"
    maquinas | awk -v x="$exceto" '$1 != x { printf "%s\t\033[1m%s\033[0m\n", $1, $2 }'; } |
    fzf --ansi --delimiter='\t' --with-nth=2 --layout=reverse --no-sort --height=~12 \
      --border=rounded --border-label=" $titulo " --prompt='❯ ' --pointer='▶' \
      --color='bg:#282a36,fg:#f8f8f2,border:#bd93f9,label:#bd93f9:bold,pointer:#ff79c6,fg+:#f8f8f2,bg+:#44475a' --bind='left-click:accept' | cut -f1
}

# Lado de lá da cópia: lê um tar do stdin e põe os itens em DIR sem sobrescrever. Imprime os nomes.
receber() {
  local dir tmp f n base ext i alvo
  dir=$(expandir "$1")
  mkdir -p "$dir" || return 1
  tmp=$(mktemp -d "$dir/.tt-recebendo.XXXXXX") || return 1
  # -m: o arquivo ganha a data de chegada (senão fica com a data original e some no meio da pasta).
  tar -C "$tmp" -xmf - || { rm -rf "$tmp"; return 1; }
  shopt -s dotglob nullglob
  for f in "$tmp"/*; do
    n=$(basename "$f"); alvo="$dir/$n"
    if [[ -e $alvo ]]; then
      base=$n ext=""
      [[ -f $f && $n == ?*.* ]] && base=${n%.*} ext=".${n##*.}"
      i=2; while [[ -e "$dir/$base ($i)$ext" ]]; do i=$((i + 1)); done
      alvo="$dir/$base ($i)$ext"
    fi
    mv "$f" "$alvo" && basename "$alvo"
  done
  rmdir "$tmp"
}

empacotar() { local dir; dir=$(expandir "$1"); shift; tar -C "$dir" -cf - -- "$@"; }
tamanho() { local dir; dir=$(expandir "$1"); shift; (cd "$dir" && du -scb -- "$@" 2>/dev/null | tail -1 | cut -f1); }

avisar() {
  local c
  for c in $(tmux list-clients -F '#{client_name}' 2>/dev/null); do tmux display-message -c "$c" -d 6000 "$1"; done
}

# ---- Botões --------------------------------------------------------------------------------
# Os botões da barra de teclas extras do Termux (e qualquer teclado) mandam Ctrl+B F1…F10; o tmux
# chama `tt --botao <ação> <cliente> <painel> <pasta>` e a ação decide pelo estado do momento.

botao_aviso() { tmux display-message -c "$1" -d 3000 "$2"; }

# Descendentes de um PID (um por linha, "pid args"), lendo a árvore de processos.
descendentes() {
  ps -A -o pid= -o ppid= -o args= 2>/dev/null | awk -v raiz="$1" '
    { pid = $1; pai[pid] = $2; $1 = $2 = ""; sub(/^ +/, ""); arg[pid] = $0 }
    END { for (p in pai) { q = p; while (q != "" && q != 0 && q != raiz) q = pai[q]; if (q == raiz && p != raiz) print p, arg[p] } }'
}

# Linux do proot-distro (Termux) a usar: distro= no config; senão o Debian; senão o primeiro
# instalado (aceita o layout novo, containers/, e o antigo, installed-rootfs/).
distro_proot() {
  local base=${PREFIX:-/nonexistent}/var/lib/proot-distro d
  command -v proot-distro >/dev/null || return 1
  for d in "$(conf distro)" debian $(ls "$base"/containers "$base"/installed-rootfs 2>/dev/null); do
    [[ -n $d && ( -d $base/containers/$d/rootfs || -d $base/installed-rootfs/$d ) ]] && { echo "$d"; return; }
  done
  return 1
}

# Comando que abre o Linux do proot-distro (Termux) na pasta dada, ou nada se não houver.
debian_comando() {
  local d
  d=$(distro_proot) || return 1
  printf 'proot-distro login %q --shared-tmp --work-dir %q' "$d" "$1"
}

# Caminho do claude desta máquina (também em ~/.local/bin, que pode não estar no PATH do tmux).
claude_local() {
  if [[ -x $HOME/.local/bin/claude ]]; then echo "$HOME/.local/bin/claude"; else command -v claude; fi
}

# Comando do Claude Code: o claude local, ou o do Debian do Termux; falha se nenhum existe.
# Opções extras desta máquina vêm de claude_flags= e variáveis de ambiente de claude_env=
# (ex.: IS_SANDBOX=1) no ~/.config/tt/config.
claude_comando() {
  local pasta=$1 a e c; shift
  a="$(conf claude_flags) $(printf '%q ' "$@")"
  e=$(conf claude_env); e=${e:+$e }
  if c=$(claude_local); then printf '%s%q %s' "$e" "$c" "$a"
  elif debian_comando "$pasta" >/dev/null; then printf '%s -- bash -lc %q' "$(debian_comando "$pasta")" "${e}claude $a"
  else return 1; fi
}

# Vai para a janela marcada com o papel (claude, debian…) naquela pasta, ou cria uma sessão nova.
# Se o painel atual já é desse papel, o botão alterna de volta para a sessão anterior.
ir_papel() {
  local papel=$1 cmd=$2 cliente=$3 pane=$4 pasta=$5 sess jan p dir nome
  if [[ $(tmux show-options -wqv -t "$pane" @tt_papel) == "$papel" ]]; then
    tmux switch-client -c "$cliente" -l 2>/dev/null || botao_aviso "$cliente" "$papel: não há outra sessão para onde voltar"
    return
  fi
  while IFS=$'\t' read -r sess jan p dir; do
    if [[ $p == "$papel" && $dir == "$pasta" ]]; then
      tmux select-window -t "$jan" && tmux switch-client -c "$cliente" -t "=$sess"; return
    fi
  done < <(tmux list-windows -a -F '#{session_name}'$'\t''#{window_id}'$'\t''#{@tt_papel}'$'\t''#{@tt_pasta}')
  nome=$(proximo_nome "$papel")
  tmux new-session -d -s "$nome" -c "$pasta" "$cmd; exec \${SHELL:-bash}" || { botao_aviso "$cliente" "$papel: não consegui abrir a sessão"; return; }
  tmux set-option -w -t "=$nome:" @tt_papel "$papel"
  tmux set-option -w -t "=$nome:" @tt_pasta "$pasta"
  tmux switch-client -c "$cliente" -t "=$nome"
}

# Túnel da tela remota (Guacamole): liga se está desligado, desliga se está ligado.
botao_tela() {
  local cliente=$1 dest porta url
  dest=$(conf tela_destino); porta=$(conf tela_porta); porta=${porta:-8089}
  url=$(conf tela_url); url=${url:-http://localhost:$porta/guacamole/}
  [[ -n $dest ]] || { botao_aviso "$cliente" "tela: defina tela_destino=usuario@host em ~/.config/tt/config"; return; }
  if pgrep -f "L $porta:127.0.0.1:$porta" >/dev/null; then
    pkill -f "L $porta:127.0.0.1:$porta"; botao_aviso "$cliente" "tela: túnel desligado"
  elif ssh -f -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ConnectTimeout=6 -L "$porta:127.0.0.1:$porta" "$dest"; then
    command -v termux-open-url >/dev/null && termux-open-url "$url"
    botao_aviso "$cliente" "tela: túnel ligado em $url"
  else botao_aviso "$cliente" "tela: não consegui conectar em $dest"; fi
}

# Fecha o que está vazio; se há algo rodando, só desanexa (a sessão continua).
botao_sair() {
  local cliente=$1 pane=$2 pid cmd filhos paineis janelas
  pid=$(tmux display-message -p -t "$pane" '#{pane_pid}'); cmd=$(tmux display-message -p -t "$pane" '#{pane_current_command}')
  filhos=$(descendentes "$pid" | wc -l)
  case $cmd in
    bash|zsh|sh|dash|fish) ;;
    *) tmux detach-client -t "$cliente"; return ;;
  esac
  ((filhos == 0)) || { tmux detach-client -t "$cliente"; return; }
  paineis=$(tmux display-message -p -t "$pane" '#{window_panes}'); janelas=$(tmux display-message -p -t "$pane" '#{session_windows}')
  if ((paineis > 1)); then tmux kill-pane -t "$pane"
  elif ((janelas > 1)); then tmux kill-window -t "$pane"
  else tmux kill-session -t "$(tmux display-message -p -t "$pane" '#{session_id}')"; fi
}

botao() {
  local acao=$1 cliente=$2 pane=$3 pasta=${4:-$HOME} cmd w h
  case $acao in
    cl|clc|clr)
      local args=()
      [[ $acao == clc ]] && args=(--continue)
      [[ $acao == clr ]] && args=(--resume)
      cmd=$(claude_comando "$pasta" "${args[@]}") || { botao_aviso "$cliente" "claude não está instalado aqui"; return; }
      if [[ $acao == cl || $acao == clr ]]; then   # conversa nova e seletor de conversas são sempre uma sessão nova
        [[ $acao == clr && $(tmux show-options -wqv -t "$pane" @tt_papel) == claude ]] && { botao_aviso "$cliente" "já está no Claude: use /resume"; return; }
        local nome; nome=$(proximo_nome claude)
        tmux new-session -d -s "$nome" -c "$pasta" "$cmd; exec \${SHELL:-bash}" && tmux set-option -w -t "=$nome:" @tt_papel claude \
          && tmux set-option -w -t "=$nome:" @tt_pasta "$pasta" && tmux switch-client -c "$cliente" -t "=$nome"
      else ir_papel claude "$cmd" "$cliente" "$pane" "$pasta"; fi ;;
    dbn)
      cmd=$(debian_comando "$pasta") || { botao_aviso "$cliente" "não há Debian (proot-distro) aqui"; return; }
      ir_papel debian "$cmd" "$cliente" "$pane" "$pasta" ;;
    tela) botao_tela "$cliente" ;;
    sair) botao_sair "$cliente" "$pane" ;;
    ant) tmux switch-client -c "$cliente" -l 2>/dev/null || botao_aviso "$cliente" "não há sessão anterior" ;;
    zm) tmux resize-pane -Z -t "$pane" ;;
    jn) tmux new-window -a -t "$(tmux display-message -p -t "$pane" "#{window_id}")" -c "$pasta" ;;
    dv) w=$(tmux display-message -p -t "$pane" '#{pane_width}'); h=$(tmux display-message -p -t "$pane" '#{pane_height}')
        # célula de terminal é ~2x mais alta que larga: divide ao lado se couber, senão embaixo
        if ((w >= 2 * h)); then tmux split-window -h -t "$pane" -c "$pasta"; else tmux split-window -v -t "$pane" -c "$pasta"; fi ;;
    *) botao_aviso "$cliente" "botão desconhecido: $acao" ;;
  esac
}

humano() { awk -v b="${1:-0}" 'BEGIN { split("B K M G T", u); i = 1; while (b >= 1024 && i < 5) { b /= 1024; i++ } printf (i == 1 ? "%d%s" : "%.1f%s"), b, u[i] }'; }

# Trabalhos de cópia persistem neste diretório até serem concluídos; o popup que os iniciou fica
# livre imediatamente para novas sessões, menus e outras operações.
dir_transferencias() { echo "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/tt-transferencias-$(id -u)"; }

atualizar_transferencia() {
  local id=$1 estado=$2 d
  d=$(dir_transferencias); mkdir -p "$d"
  printf '%s\n' "$estado" >"$d/$id.status"
  tmux refresh-client -S >/dev/null 2>&1 || true
}

transferencias_barra() {
  local d f estado n=0
  d=$(dir_transferencias)
  for f in "$d"/*.status; do
    [[ -f $f ]] || continue; estado=$(cat "$f" 2>/dev/null)
    [[ $estado == na\ fila || $estado == calculando* || $estado == transferindo* ]] && n=$((n + 1))
  done
  ((n)) && printf '#[range=user|transferencias]#[fg=#a6e3a1,bold] ⇅ %d em andamento #[norange]#[default] ' "$n"
}

transferencias() {
  local d f id estado info tecla
  d=$(dir_transferencias)
  [[ -t 0 ]] || { for f in "$d"/*.status; do [[ -f $f ]] && printf '%s: %s\n' "${f##*/}" "$(cat "$f")"; done; return; }
  while true; do
    clear; printf '\033[1mTRANSFERÊNCIAS\033[0m\n\n'
    for f in "$d"/*.status; do
      [[ -f $f ]] || continue; id=${f##*/}; id=${id%.status}; estado=$(cat "$f" 2>/dev/null)
      info=$(tr '\t' ' ' <"$d/$id.info" 2>/dev/null)
      printf '%-18s %-28s %s\n' "$id" "$estado" "$info"
    done
    printf '\n\033[90mAtualiza automaticamente · q fecha\033[0m'
    read -rsn1 -t 1 tecla || true; [[ ${tecla:-} == [qQ] ]] && return; tecla=""
  done
}

transferir_fundo() {
  local id=$1; shift
  atualizar_transferencia "$id" 'calculando tamanho…'
  if transferir_bloqueante "$@"; then atualizar_transferencia "$id" 'concluída'; else atualizar_transferencia "$id" 'erro — veja o log'; fi
}

transferir() {
  local src=$1 dsrc=$2 dst=$3 ddst=$4; shift 4
  local d id
  d=$(dir_transferencias); mkdir -p "$d"; id="$(date +%H%M%S)-$RANDOM"
  printf '%s\t%s\t%s\t%s\n' "$src" "$dsrc" "$dst" "$ddst" >"$d/$id.info"
  atualizar_transferencia "$id" 'na fila'
  nohup "$EU" --transferir-fundo "$id" "$src" "$dsrc" "$dst" "$ddst" "$@" >"$d/$id.log" 2>&1 </dev/null &
  printf '%s\n' "$!" >"$d/$id.pid"
  printf '\033[32m⇅ Transferência %s iniciada em segundo plano.\033[0m Você já pode fechar este popup e continuar usando o tt.\n' "$id"
}

# Copia NOMES de SRC:DIR_SRC para DST:DIR_DST (qualquer combinação de máquinas).
# Executada somente pelo trabalhador de fundo acima.
transferir_bloqueante() {
  local src=$1 dsrc=$2 dst=$3 ddst=$4; shift 4
  local bytes t0 recebidos n
  bytes=$(rodar "$src" --tamanho "$dsrc" "$@")
  printf '\033[90m%s %s:%s → %s:%s (%s)…\033[0m\n' "$#" "$(rotulo "$src")" "$dsrc" "$(rotulo "$dst")" "$ddst" "$(humano "$bytes")"
  t0=$(date +%s)
  if command -v pv >/dev/null && [[ -t 2 ]]; then
    recebidos=$(rodar_io "$src" --empacotar "$dsrc" "$@" | pv -s "${bytes:-0}" -w 60 | rodar_io "$dst" --receber "$ddst")
  else
    recebidos=$(rodar_io "$src" --empacotar "$dsrc" "$@" | rodar_io "$dst" --receber "$ddst")
  fi
  n=$(grep -c . <<<"$recebidos")
  if ((n == 0)); then echo "✗ Nada chegou."; return 1; fi
  printf '\033[32m✓ %d ite%s (%s) em %ss → %s:%s\033[0m\n' "$n" "$([[ $n == 1 ]] && echo m || echo ns)" "$(humano "$bytes")" "$(($(date +%s) - t0))" "$(rotulo "$dst")" "$ddst"
  sed 's/^/   /' <<<"$recebidos" | head -15
  printf '\033[36m📍 em %s: %s\033[0m\n' "$(rotulo "$dst")" "$(rodar "$dst" --caminho-visivel "$ddst")"
  [[ $dst == . ]] || rodar "$dst" --avisar "📥 $n de $(rotulo "$src") → $(rodar "$dst" --caminho-visivel "$ddst" | sed 's/  (.*//'): $(head -3 <<<"$recebidos" | paste -sd, | cut -c1-60)" >/dev/null 2>&1
}

pasta_aqui() {
  if [[ -n ${TT_PANE:-} ]]; then tmux display-message -p -t "$TT_PANE" '#{pane_current_path}' | { read -r p; encurtar "$p"; }
  else encurtar "$PWD"; fi
}

fim_transferencia() {
  local r
  read -rsn1 -p $'\n\033[90ma: abrir a pasta lá  ·  qualquer outra tecla fecha\033[0m' r
  [[ $r == [aA] ]] && rodar "$1" --abrir-pasta "$2" >/dev/null 2>&1
  return 0
}

# Fluxo "enviar": arquivos ou pastas de SRC (navegando a partir de DIR) → máquina e pasta escolhidas.
enviar_fluxo() {
  local src=${1:-.} dir=${2:-$(pasta_aqui)} dst=${3:-} ddst=${4:-} lista pasta
  local -a nomes
  lista=$(escolher_arquivos "$src" "$dir" "arquivos ou pastas para enviar") || return 0
  pasta=$(head -1 <<<"$lista"); mapfile -t nomes < <(tail -n +2 <<<"$lista")
  ((${#nomes[@]})) || return 0
  [[ -n $dst ]] || dst=$(escolher_maquina "📤 enviar ${#nomes[@]} ite$([[ ${#nomes[@]} == 1 ]] && echo m || echo ns) para" "$src") || return 0
  [[ -n $dst ]] || return 0
  [[ -n $ddst ]] || ddst=$(escolher_destino "$dst" "" "📤 para qual pasta") || return 0
  transferir "$src" "$pasta" "$dst" "$ddst" "${nomes[@]}"
}

# Fluxo "trazer": escolhe máquina, pasta de partida e arquivos/pastas de lá → DST:DDST (padrão: aqui).
trazer_fluxo() {
  local src=${1:-} dir=${2:-} dst=${3:-.} ddst=${4:-$(pasta_aqui)} lista pasta
  local -a nomes
  [[ -n $src ]] || src=$(escolher_maquina "📥 trazer de qual máquina" "$dst") || return 0
  [[ -n $src ]] || return 0
  [[ -n $dir ]] || dir=$(escolher_destino "$src" "" "📥 começar em qual pasta") || return 0
  lista=$(escolher_arquivos "$src" "$dir" "arquivos ou pastas para trazer") || return 0
  pasta=$(head -1 <<<"$lista"); mapfile -t nomes < <(tail -n +2 <<<"$lista")
  ((${#nomes[@]})) || return 0
  transferir "$src" "$pasta" "$dst" "$ddst" "${nomes[@]}"
}

# Linha de comando: tt --enviar [arquivos-ou-pastas…] [máquina[:pasta]]  /
# tt --trazer máquina:caminho… [pasta]. Uma pasta é transferida inteira, recursivamente.
enviar_cli() {
  local ultimo dst="" ddst="" maq a dir
  local -a arqs=("$@")
  if ((${#arqs[@]})); then
    ultimo=${arqs[-1]}; maq=${ultimo%%:*}
    if [[ -n $(dest_de "$maq") && ! -e $ultimo ]]; then
      dst=$(dest_de "$maq"); [[ $ultimo == *:* ]] && ddst=${ultimo#*:}
      unset 'arqs[-1]'
    fi
  fi
  if ((${#arqs[@]} == 0)); then enviar_fluxo . "$(encurtar "$PWD")" "$dst" "$ddst"; return; fi
  [[ -n $dst ]] || dst=$(escolher_maquina "📤 enviar para" .) || return 1
  [[ -n $ddst ]] || ddst=$(rodar "$dst" --pasta-recebidos)
  for a in "${arqs[@]}"; do
    [[ -e $a ]] || { echo "Não existe: $a"; return 1; }
    dir=$(cd "$(dirname "$a")" && encurtar "$PWD")
    transferir . "$dir" "$dst" "$ddst" "$(basename "$a")"
  done
}

trazer_cli() {
  local a maq src caminho ddst
  local -a origens=()
  for a in "$@"; do
    maq=${a%%:*}
    if [[ $a == *:* && -n $(dest_de "$maq") ]]; then origens+=("$a"); else ddst=$a; fi
  done
  ddst=${ddst:-$(encurtar "$PWD")}
  if ((${#origens[@]} == 0)); then trazer_fluxo "" "" . "$ddst"; return; fi
  for a in "${origens[@]}"; do
    src=$(dest_de "${a%%:*}"); caminho=${a#*:}
    transferir "$src" "$(dirname "$caminho")" . "$ddst" "$(basename "$caminho")"
  done
}


# --- Botão ✕ nas listas -----------------------------------------------------
#
# Cada sessão (e painel) da central e do seletor tem um ✕ alinhado à direita. O fzf só informa a
# LINHA clicada, então a lista roda atrás de uma camada fina (com_mouse) que anota a coluna de cada
# clique antes de repassá-lo; o clique decide: no ✕ → "fechar? ✕" (2º toque fecha), no resto →
# abre. Sem python3, a lista roda direto (sem ✕).

# Roda CMD com o terminal passando por um pty, anotando em ARQ "coluna linha" de cada clique.
com_mouse() {
  local arq=$1; shift
  command -v python3 >/dev/null || { "$@"; return; }
  local codigo
  # O código vai por -c: a entrada padrão é a lista que o fzf tem de ler.
  codigo=$(cat <<'PYEOF'
import os, sys, tty, termios, select, signal, fcntl, re
arq, cmd = sys.argv[1], sys.argv[2:]  # (com -c, argv[0] é "-c")
try:
    tfd = os.open('/dev/tty', os.O_RDWR)
except OSError:
    os.execvp(cmd[0], cmd)
tam = fcntl.ioctl(tfd, termios.TIOCGWINSZ, b'\0' * 8)
mfd, sfd = os.openpty()
fcntl.ioctl(sfd, termios.TIOCSWINSZ, tam)
pid = os.fork()
if pid == 0:
    os.close(mfd); os.close(tfd)
    os.setsid()
    fcntl.ioctl(sfd, termios.TIOCSCTTY, 0)
    os.dup2(sfd, 2)
    os.close(sfd)
    os.execvp(cmd[0], cmd)
os.close(sfd)
antes = termios.tcgetattr(tfd)
tty.setraw(tfd)
clique = re.compile(rb'\x1b\[<(\d+);(\d+);(\d+)M')
def winch(*_):
    try:
        fcntl.ioctl(mfd, termios.TIOCSWINSZ, fcntl.ioctl(tfd, termios.TIOCGWINSZ, b'\0' * 8))
        os.kill(pid, signal.SIGWINCH)
    except OSError:
        pass
signal.signal(signal.SIGWINCH, winch)
try:
    while True:
        try:
            r, _, _ = select.select([tfd, mfd], [], [])
        except InterruptedError:
            continue
        if tfd in r:
            d = os.read(tfd, 4096)
            if not d:
                break
            for m in clique.finditer(d):
                if int(m.group(1)) == 0:
                    with open(arq, 'w') as f:
                        f.write(m.group(2).decode() + ' ' + m.group(3).decode())
            os.write(mfd, d)
        if mfd in r:
            try:
                d = os.read(mfd, 65536)
            except OSError:
                break
            if not d:
                break
            os.write(tfd, d)
finally:
    termios.tcsetattr(tfd, termios.TCSAFLUSH, antes)
_, st = os.waitpid(pid, 0)
sys.exit(os.waitstatus_to_exitcode(st))
PYEOF
)
  python3 -c "$codigo" "$arq" "$@"
}

# Colunas da área de texto da lista e onde ela começa na tela (1 = primeira coluna), conforme o
# menu (TT_COMX: seletor | central) e o tamanho da tela.
geometria_x() {
  local cols=${FZF_COLUMNS:-0} lista ini
  # No evento "start" o fzf ainda não desenhou e FZF_COLUMNS vem 0: lê do terminal.
  ((cols > 10)) || cols=$(stty size </dev/tty 2>/dev/null | awk '{ print $2 }')
  ((${cols:-0} > 10)) || cols=80
  case ${TT_COMX:-} in
    seletor)
      lista=$cols; ini=3
      [[ -n ${TT_PREVIA:-} ]] && lista=$((cols - (cols * 55 + 99) / 100 - 1)) ;;
    central)
      if [[ -n ${TT_COMPACTO:-} ]]; then lista=$cols; ini=3; else lista=$((cols - 4)); ini=5; fi ;;
    *) return 1 ;;
  esac
  echo "$((lista - 3)) $ini" # texto útil (tira o ▶ e a barra de rolagem), início do texto
}

# Filtro: põe o ✕ no fim do campo 3 de cada linha de sessão/painel ("destino<TAB>chave<TAB>texto…").
com_x() {
  local g w ini
  g=$(geometria_x) || { cat; return; }
  read -r w ini <<<"$g"
  local fx="" r sn d
  while IFS=$'\t' read -r r sn; do
    d=$(dest_de "$r"); [[ -n $d ]] && fx+="$d|$sn"$'\n'
  done < <(fixadas)
  python3 -c '
import sys, re, unicodedata
w = int(sys.argv[1]); conf = sys.argv[2]; fix = set(sys.argv[3].split("\n"))
ansi = re.compile(r"\x1b\[[0-9;]*m")
def largura(t):
    t = ansi.sub("", t)
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in t)
def cortar(t, n):
    out, u, i = [], 0, 0
    partes = re.split(r"(\x1b\[[0-9;]*m)", t)
    for p in partes:
        if ansi.fullmatch(p or "x"):
            out.append(p); continue
        for c in p:
            cw = 0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1
            if u + cw > n: return "".join(out) + "\x1b[0m"
            out.append(c); u += cw
    return "".join(out)
for linha in sys.stdin:
    linha = linha.rstrip("\n")
    c = linha.split("\t")
    if len(c) < 3 or c[1].startswith(("!", "+")) or not c[1]:
        print(linha); continue
    if c[0] + "|" + c[1] == conf:
        x = "\x1b[1;31mfechar? ✕\x1b[0m"; xl = 9
    else:
        x = "\x1b[90m✕\x1b[0m"; xl = 1
    if c[1].startswith("%"): pino = "  "
    else: pino = "📌" if c[0] + "|" + c[1] in fix else "📍"
    x = pino + "  " + x
    alvo = w - xl - 5
    t = c[2]
    if largura(t) > alvo: t = cortar(t, alvo - 1) + "…"
    c[2] = t + " " * (alvo - largura(t)) + " " + x
    print("\t".join(c))
' "$w" "$(estado confirmar)" "$fx" 2>/dev/null || cat
}

# Clique numa linha (MODO: seletor | central). No ✕: 1º toque pede confirmação, 2º fecha.
# Fora dele: abre (e esquece uma confirmação pendente).
clique_linha() {
  local dest=$1 chave=$2 g w ini xc yc lista
  [[ $TT_COMX == central ]] && lista="$EU --listar-tudo" || lista="$EU --lista-seletor"
  if [[ -z $chave || $chave == '!'* || $chave == '+'* ]] || ! g=$(geometria_x) || [[ ! -s ${TT_MOUSE:-} ]]; then
    estado_por confirmar ""; echo accept; return
  fi
  read -r w ini <<<"$g"
  read -r xc yc <"$TT_MOUSE"
  local xl=1 x_ini pino_ini
  [[ $(estado confirmar) == "$dest|$chave" ]] && xl=9
  x_ini=$((ini + w - xl))          # 1ª coluna do ✕ (ou de "fechar? ✕")
  pino_ini=$((x_ini - 4))          # o pino ocupa 2 colunas, seguido de 2 espaços
  if [[ $chave != %* ]] && ((xc >= pino_ini - 1 && xc <= pino_ini + 2)); then
    estado_por confirmar ""
    "$EU" --alternar-fixada "$dest" "$chave" >/dev/null 2>&1
    echo "reload($lista)"
    return
  fi
  if ((xc >= x_ini - 1)); then
    if [[ $(estado confirmar) == "$dest|$chave" ]]; then
      estado_por confirmar ""
      "$EU" --fechar "$dest" "$chave" >/dev/null 2>&1
    else
      estado_por confirmar "$dest|$chave"
    fi
    echo "reload($lista)"
  else
    estado_por confirmar ""
    echo accept
  fi
}

escolher() {
  local rotulo_borda=" 🖥  terminais · $MAQUINA " borda=rounded prev_janela='down,55%,border-top,follow'
  if compacto; then
    export TT_COMPACTO=1
    borda=none prev_janela='down,50%,border-top,follow,hidden'
  else
    unset TT_COMPACTO
  fi
  case ${TT_MODO:-} in
    lado) rotulo_borda+="· ⏎ abre ao lado " ;;
    embaixo) rotulo_borda+="· ⏎ abre embaixo " ;;
    aqui) rotulo_borda+="· ⏎ troca o painel " ;;
  esac
  export TT_COMX=central TT_MOUSE="$TT_ESTADO.mouse"
  listar_tudo | com_mouse "$TT_MOUSE" fzf --ansi --delimiter='\t' --with-nth=3,4 --nth="$(nth_atual)" --exact --no-hscroll --ellipsis='' \
    --tiebreak=begin,index --layout=reverse \
    --border=$borda --border-label="$rotulo_borda" --border-label-pos=3 \
    --prompt="$([[ -n ${TT_COMPACTO:-} ]] && echo "$MAQUINA ❯ " || echo '❯ ')" --pointer='▶' --info=inline-right \
    --header="$(cabecalho)" \
    --color='bg:#282a36,fg:#f8f8f2,border:#bd93f9,label:#bd93f9:bold,header:#f8f8f2,pointer:#ff79c6,prompt:#bd93f9,hl:#f1fa8c,hl+:#ffb86c,fg+:#f8f8f2,bg+:#44475a,info:#6272a4' \
    --preview="$EU --previa-em {1} {2} {q}" --preview-window="$prev_janela" \
    --bind='ctrl-/:toggle-preview' \
    --bind="ctrl-x:execute-silent($EU --fechar {1} {2})+reload($EU --listar-tudo)" \
    --bind="ctrl-n:print(nova)+accept,ctrl-r:print(renomear)+accept,ctrl-a:print(nomear)+accept" \
    --bind="ctrl-v:print(lado)+accept,ctrl-o:print(embaixo)+accept,ctrl-p:print(aqui)+accept,ctrl-t:print(soltar)+accept" \
    --bind="ctrl-s:print(enviar)+accept,ctrl-g:print(trazer)+accept" \
    --bind="ctrl-f:transform($EU --clique-cabecalho máquina),ctrl-e:transform($EU --clique-cabecalho busca)" \
    --bind="click-header:transform($EU --clique-cabecalho \"\$FZF_CLICK_HEADER_WORD\")" \
