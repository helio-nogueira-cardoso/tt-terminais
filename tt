#!/usr/bin/env bash
# tt — central de terminais deste PC.
# Cada janela de terminal roda numa sessão tmux; aqui você vê todas (com prévia ao vivo)
# e entra, cria, renomeia ou fecha. Ao sair de uma sessão (Ctrl+B d), volta para este menu.
# Janelas abertas fora do tmux aparecem como "solta" e podem ser adotadas com Enter.
#
#   tt              abre o menu
#   tt --configurar-bashrc  põe no ~/.bashrc a abertura automática no tmux (--remover-bashrc desfaz)
#   tt --botao A C P D  ação de botão (cl clc clr dbn tela sair ant zm jn dv) pelo cliente C, painel P, pasta D
#   tt --janela     usado pelo ~/.bashrc: abre uma sessão nova "janela-N" para a janela do terminal
#   tt --adotar PID traz para o tmux a janela cujo shell é PID (imprime o nome da sessão criada)
#   tt --sugerir S  sugere um nome semântico para a sessão S (título do Claude ou leitura da tela)
#   tt --renomear S pergunta o novo nome de S, já preenchido com a sugestão (Ctrl+B N no tmux)
#   tt --nomear-todas dá nome semântico às sessões janela-N / claude-N
#   tt --vigia      renomeia sozinho, em segundo plano, conforme as sessões são usadas
#   tt --listar     imprime as linhas do menu só desta máquina (as outras chamam isso via ssh)
#   tt --previa S   mostra a tela atual da sessão S (prévia do fzf)
#   tt --nova [N]   cria uma sessão solta (sem entrar) e imprime o nome
#
# Menu: Enter entra; ^n nova; ^r renomeia; ^x fecha; ^a dá nome às genéricas. As palavras do
# cabeçalho são clicáveis. ^f (ou clique) filtra por máquina; a busca procura em nome, máquina,
# programa, pasta, título do Claude e no conteúdo da tela (^e: só nos nomes); a prévia pula para
# o trecho encontrado. Sessões com vários painéis mostram cada painel (├ └): Enter vai direto
# nele, ^x fecha só ele, ^r dá nome a ele, ^t solta ele como sessão própria.
#
# Painéis: ^v abre a sessão escolhida num painel ao lado da tela atual, ^o embaixo, e ^p troca a
# sessão mostrada no painel em foco (só em painéis abertos assim). Cada painel é uma janela para
# outra sessão (desta ou de outra máquina); fechar o painel não fecha a sessão. Na barra de baixo
# há botões (☰ terminais, ┃ lado, ━ baixo, ⋯ painel); o ⋯ / Ctrl+B m abre o menu do painel.
#
# Outras máquinas: as Linux online da tailnet (Tailscale) aparecem no mesmo menu, com as sessões
# delas, via ssh. O usuário de cada uma vem de ~/.config/tt/maquinas, uma por linha:
#   host-no-tailscale  usuario  rótulo        (ex.: notebook-trabalho joao trabalho)
#   host-no-tailscale  -                      (não mostrar essa máquina)
# Sem linha, usa o mesmo usuário daqui e o nome do host como rótulo.

set -u
EU=$(readlink -f "$0")

CONF_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/tt
CONF=$CONF_DIR/config
CONF_MAQ=$CONF_DIR/maquinas
conf() { sed -n "s/^$1=//p" "$CONF" 2>/dev/null | tail -1; }
# Nome desta máquina no menu: ~/.config/tt/config (nome=…); sem ele, o hostname.
MAQUINA=$(conf nome)
MAQUINA=${MAQUINA:-$(hostname -s)}

proximo_nome() {
  local prefixo=${1:-janela} n=1
  while tmux has-session -t "=$prefixo-$n" 2>/dev/null; do n=$((n + 1)); done
  echo "$prefixo-$n"
}

encurtar() {
  case $1 in "$HOME"*) echo "~${1#"$HOME"}" ;; *) echo "$1" ;; esac
}

# Pastas de dados do Claude Code nesta máquina, achadas sozinhas: a do usuário
# (CLAUDE_CONFIG_DIR ou ~/.claude) e as de dentro dos Linux do proot-distro (Termux), onde o
# Claude costuma rodar no Android. PIDs e IDs de conversa não se repetem entre elas.
pastas_claude() {
  if [[ -z ${PASTAS_CLAUDE+x} ]]; then
    local d raiz
    PASTAS_CLAUDE=()
    for d in ${CLAUDE_CONFIG_DIR:-} "$HOME/.claude"; do [[ -d $d ]] && PASTAS_CLAUDE+=("$d"); done
    for raiz in "${PREFIX:-/nonexistent}"/var/lib/proot-distro/{containers/*/rootfs,installed-rootfs/*}; do
      for d in "$raiz"/root/.claude "$raiz"/home/*/.claude; do [[ -d $d ]] && PASTAS_CLAUDE+=("$d"); done
    done
  fi
  printf '%s\n' "${PASTAS_CLAUDE[@]}"
}

# Arquivo SUB (ex.: sessions/123.json) na primeira pasta do Claude que o tiver.
arquivo_claude() {
  local d
  while read -r d; do
    [[ -n $d ]] || continue
    compgen -G "$d/$1" >/dev/null && { compgen -G "$d/$1" | head -1; return; }
  done < <(pastas_claude)
  return 1
}

# "sessionId status name" do Claude Code rodando no PID dado (vazio se não houver registro).
claude_info() {
  python3 - "$(arquivo_claude "sessions/$1.json")" <<'EOF' 2>/dev/null
import json, sys
d = json.load(open(sys.argv[1]))
print(d.get("sessionId", ""), d.get("status", "?"), d.get("name", ""))
EOF
}

# --- Nomes semânticos ------------------------------------------------------

# Tira os acentos (ação → acao). Em Python, porque o Termux não tem iconv (o do Android é bloqueado).
sem_acento() {
  python3 -c 'import sys, unicodedata as u; t = sys.stdin.buffer.read().decode("utf-8", "ignore"); sys.stdout.write(u.normalize("NFKD", t).encode("ascii", "ignore").decode())'
}

# Texto livre → nome válido de sessão: sem acento, minúsculas, palavras separadas por hífen.
limpar() {
  sem_acento <<<"$1" | tr 'A-Z' 'a-z' |
    sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g' | cut -c1-40
}

# Texto livre → nome sugerido: como limpar, mas só as 3 primeiras palavras relevantes.
slug() {
  limpar "$1" |
    awk -F- '{
      n = 0; s = ""
      for (i = 1; i <= NF; i++) {
        if ($i ~ /^(de|da|do|das|dos|a|o|as|os|e|em|no|na|nos|nas|para|pra|com|um|uma|por|the|of|and|to|in|for)$/) continue
        s = s (n ? "-" : "") $i
        if (++n == 3) break
      }
      print substr(s, 1, 28)
    }'
}

# Título que o próprio Claude Code deu à conversa (aiTitle mais recente do transcript).
titulo_claude() {
  local arq
  arq=$(arquivo_claude "projects/*/$1.jsonl")
  [[ -n $arq ]] || return 1
  grep '"type":"ai-title"' "$arq" | tail -1 | python3 -c 'import json,sys; print(json.loads(sys.stdin.read())["aiTitle"])' 2>/dev/null
}

# PID do Claude Code rodando no painel P (%N, ou "=S:" para o painel ativo da sessão S).
claude_no_painel() {
  local raiz
  raiz=$(tmux display-message -p -t "$1" '#{pane_pid}' 2>/dev/null) || return 1
  { if [[ -n ${PS_CACHE:-} ]]; then echo "$PS_CACHE"; else ps -eo pid=,ppid=,comm=; fi; } | awk -v raiz="$raiz" '
    { pai[$1] = $2; cmd[$1] = $3 }
    END {
      for (p in cmd) {
        if (cmd[p] != "claude") continue
        for (q = p; q in pai && q != 1; q = pai[q]) if (q == raiz) { print p; exit }
      }
    }'
}
claude_na_sessao() { claude_no_painel "=$1:"; }

# Sugere um nome para a sessão S: título da conversa, se for Claude; senão pergunta ao Haiku
# olhando a tela. Sem assunto claro, sugere o nome da pasta e retorna 1.
sugerir_nome() {
  local s=$1 pid id status rot titulo pasta cmd tela claude nome
  pid=$(claude_na_sessao "$s")
  if [[ -n $pid ]]; then
    read -r id status rot < <(claude_info "$pid")
    titulo=$(titulo_claude "${id:-x}") && nome=$(slug "$titulo")
    [[ -n ${nome:-} ]] && { echo "$nome"; return; }
  fi

  pasta=$(tmux display-message -p -t "=$s:" '#{pane_current_path}')
  cmd=$(tmux display-message -p -t "=$s:" '#{pane_current_command}')
  # Numa pasta neutra (sem CLAUDE.md de projeto); no Termux não há /tmp, mas há TMPDIR.
  local neutra=${TMPDIR:-/tmp}
  if claude=$(claude_comando "$neutra" -p --model haiku --no-session-persistence --tools "" \
        --system-prompt "Você nomeia sessões de terminal. Responda só com um nome curto (1 a 3 palavras em português, minúsculas, separadas por hífen) que diga do que trata a sessão: o projeto ou a tarefa, não o programa. Se a tela não mostrar nenhum trabalho concreto (só prompt vazio, boas-vindas), responda exatamente: vazio. Nada além do nome."); then
    tela=$(tmux capture-pane -p -J -S -80 -t "=$s:" | grep -v '^[[:space:]]*$' | tail -60)
    nome=$(cd "$neutra" && printf 'Pasta: %s\nPrograma em primeiro plano: %s\nTela:\n%s\n' "$(encurtar "$pasta")" "$cmd" "$tela" |
      timeout 90 bash -c "$claude" 2>/dev/null | tail -1)
    nome=$(slug "${nome:-}")
    [[ $nome == vazio ]] && nome=""
  fi
  [[ -n ${nome:-} ]] && { echo "$nome"; return; }
  # Sem assunto claro: sugere a pasta, e avisa (status 1) para o "nomear todas" deixar como está.
  nome=$(slug "$(basename "$pasta")")
  [[ $pasta == "$HOME" || -z $nome ]] && nome=terminal
  echo "$nome"
  return 1
}

# Renomeia S para NOVO (ajustado para ser válido e único). Imprime o nome final.
# Com "auto" no 3º argumento o nome fica marcado como automático (o vigia pode trocá-lo depois);
# sem ele, é um nome escolhido por você e o vigia nunca mais mexe.
renomear() {
  local s=$1 novo base n=2 auto=${3:-}
  novo=$(limpar "$2")
  [[ -n $novo ]] || return 1
  base=$novo
  if [[ $novo != "$s" && ${s%-[0-9]*} != "$base" ]]; then
    while tmux has-session -t "=$novo" 2>/dev/null; do novo="$base-$n"; n=$((n + 1)); done
    tmux rename-session -t "=$s" "$novo" || return 1
  else
    novo=$s
  fi
  tmux set-option -t "=$novo:" @nome_auto "$([[ $auto == auto ]] && echo 1 || echo 0)"
  [[ $novo != "$s" ]] && fixada_renomeada "$s" "$novo" >/dev/null 2>&1
  echo "$novo"
}

generico() { [[ $1 =~ ^(janela|claude)-[0-9]+$ ]]; }

# Vigia: roda em segundo plano enquanto o tmux existir (iniciado pelo ~/.tmux.conf) e vai
# renomeando as sessões conforme o uso. Só mexe em nomes genéricos ou automáticos.
#   Claude: segue o título da conversa (sem custo, a cada volta).
#   Shell:  pergunta ao Haiku só se houve uso desde a última vez e
#           (nome genérico há 5 min) ou (mudou de pasta) ou (30 min desde o último nome).
vigiar() {
  local pidf="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/tt-vigia-$(id -u).pid" log="$HOME/.cache/tt-vigia.log" outro
  mkdir -p "$HOME/.cache"
  # Uma instância só: se o PID registrado ainda é um vigia vivo, sai.
  outro=$(cat "$pidf" 2>/dev/null)
  if [[ -n $outro ]] && tr '\0' ' ' <"/proc/$outro/cmdline" 2>/dev/null | grep -q -- '--vigia'; then exit 0; fi
  echo $$ >"$pidf"
  echo "$(date '+%F %T') vigia iniciado (pid $$)" >>"$log"
  local ultima_puxada=0 ultima_tema=0 s agora atividade pasta ultimo pasta_ant auto pid id st rot titulo nome motivo
  local t_generico=${TT_T_GENERICO:-300} t_pasta=${TT_T_PASTA:-120} t_revisao=${TT_T_REVISAO:-1800} pausa=${TT_PAUSA:-60}
  while tmux list-sessions >/dev/null 2>&1; do
    [[ -s $CONF_MAQ ]] && atualizar_info >/dev/null 2>&1 &
    agora=$(date +%s)
    # Fixadas: puxa a lista mais nova das outras máquinas ao iniciar e a cada 5 min.
    if ((agora - ${ultima_puxada:-0} >= 300)); then
      ultima_puxada=$agora
      ("$EU" --puxar-fixadas >/dev/null 2>&1 &)
    fi
    # Um agente pode ter sido instalado depois do tt. Reaplica só as chaves visuais, em até 5 min.
    if ((agora - ${ultima_tema:-0} >= 300)); then
      ultima_tema=$agora
      ("$EU" --tema-agentes >/dev/null 2>&1 &)
    fi
    # GitHub: uma consulta a cada 12 h, em segundo plano.
    if ((agora - $(awk '{ print $2 + 0 }' "$CACHE_GITHUB" 2>/dev/null || echo 0) > 43200)); then
      mkdir -p "$(dirname "$CACHE_GITHUB")"
      echo "$(versao_github) $agora" >"$CACHE_GITHUB" # marca antes: sem rede, não tenta a cada minuto
      ("$EU" --verificar-atualizacao >/dev/null 2>&1 &)
    fi
    while IFS='|' read -r s atividade pasta; do
      auto=$(tmux show-options -qv -t "=$s:" @nome_auto)
      [[ $auto == 1 ]] || { generico "$s" && [[ $auto != 0 ]]; } || continue

      pid=$(claude_na_sessao "$s")
      if [[ -n $pid ]]; then
        read -r id st rot < <(claude_info "$pid")
        titulo=$(titulo_claude "${id:-x}") || continue
        [[ $titulo == "$(tmux show-options -qv -t "=$s:" @nome_titulo)" ]] && continue
        nome=$(renomear "$s" "$(slug "$titulo")" auto) || continue
        tmux set-option -t "=$nome:" @nome_titulo "$titulo"
        echo "$(date '+%F %T') $s → $nome (título: $titulo)" >>"$log"
        continue
      fi

      ultimo=$(tmux show-options -qv -t "=$s:" @nome_em); ultimo=${ultimo:-0}
      pasta_ant=$(tmux show-options -qv -t "=$s:" @nome_pasta)
      ((atividade > ultimo)) || continue
      motivo=""
      if generico "$s" && ((agora - $(tmux display-message -p -t "=$s:" '#{session_created}') >= t_generico)) && ((agora - ultimo >= t_generico)); then
        motivo="ganhou uso"
      elif [[ -n $pasta_ant && $pasta != "$pasta_ant" ]] && ((agora - ultimo >= t_pasta)); then
        motivo="mudou de pasta"
      elif ((ultimo > 0 && agora - ultimo >= t_revisao)); then
        motivo="revisão periódica"
      fi
      [[ -n $motivo ]] || continue

      tmux set-option -t "=$s:" @nome_em "$agora"
      tmux set-option -t "=$s:" @nome_pasta "$pasta"
      nome=$(sugerir_nome "$s") || continue
      [[ $nome == "${s%-[0-9]*}" ]] && continue
      nome=$(renomear "$s" "$nome" auto) || continue
      echo "$(date '+%F %T') $s → $nome ($motivo)" >>"$log"
    done < <(tmux list-sessions -F '#{session_name}|#{window_activity}|#{pane_current_path}' 2>/dev/null)
    sleep "$pausa"
  done
}

# Pergunta o novo nome já preenchido com a sugestão (Enter aceita).
renomear_interativo() {
  local s=$1 sugestao novo
  printf '\033[90mPensando num nome para %s…\033[0m\n' "$s"
  sugestao=$(sugerir_nome "$s")
  read -rep "Novo nome: " -i "$sugestao" novo || return
  [[ -n $novo ]] || return
  if [[ $novo == "$sugestao" ]]; then renomear "$s" "$novo" auto >/dev/null; else renomear "$s" "$novo" >/dev/null; fi
}

# Dá nome semântico a todas as sessões com nome genérico (janela-N, claude-N), em paralelo.
nomear_todas() {
  local s
  for s in $(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -E '^(janela|claude)-[0-9]+$'); do
    (
      if nome=$(sugerir_nome "$s"); then
        printf '  %s → %s\n' "$s" "$(renomear "$s" "$nome" auto)"
      else
        printf '  %s: sem assunto ainda, fica como está\n' "$s"
      fi
    ) &
  done
  wait
}

# Janelas de terminal abertas fora do tmux: shells líderes de sessão num pts, sem TMUX no ambiente,
# que não vieram de SSH/mosh. Saída: "shell|primeiro-plano|programa|diretório".
soltos() {
  local meu_sid pid sid tty pai fg cmd
  meu_sid=$(ps -o sid= -p $$ | tr -d ' ')
  ps -u "$(id -un)" -o pid=,sid=,tty=,ppid=,tpgid=,comm= | while read -r pid sid tty pai fg cmd; do
    [[ $pid == "$sid" && $tty == pts/* && $cmd =~ ^(bash|zsh|fish)$ && $sid != "$meu_sid" ]] || continue
    tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | grep -q '^TMUX=' && continue
    case $(ps -o comm= -p "$pai") in sshd* | mosh-server | tailscaled | tmux*) continue ;; esac
    [[ $fg -gt 0 ]] || fg=$pid
    echo "$pid|$fg|$(ps -o comm= -p "$fg")|$(readlink "/proc/$fg/cwd")"
  done
}

idade() {
  local s=$(($(date +%s) - $1))
  if ((s < 60)); then echo agora
  elif ((s < 3600)); then echo "$((s / 60)) min"
  elif ((s < 86400)); then echo "$((s / 3600)) h"
  else echo "$((s / 86400)) d"; fi
}

# Texto de busca de um painel: título da conversa do Claude, nomes e o fim da tela. Vai no fim de
# cada linha do menu depois de muitos espaços, para a busca achar mas a lista não mostrar.
ESPACOS=$(printf '%*s' 300 '')
busca_painel() {
  local p=$1 pid id st rot titulo=""
  pid=$(claude_no_painel "$p")
  if [[ -n $pid ]]; then
    read -r id st rot < <(claude_info "$pid")
    titulo=$(titulo_claude "${id:-x}")
  fi
  printf '%s %s ' "$titulo" "$(tmux display-message -p -t "$p" '#{pane_title} #{@nome_painel} #{@tt_rotulo}')"
  tmux capture-pane -p -J -S -150 -t "$p" 2>/dev/null | tr -s ' \t\n' ' ' | tail -c 2500 |
    python3 -c 'import sys; sys.stdout.write(sys.stdin.buffer.read().decode("utf-8", "ignore"))'
}

# Sessão "vazia": todos os painéis só no shell (nada rodando), sem histórico e com no máximo 2
# linhas escritas na tela (o prompt).
sessao_vazia() {
  local p cmd hist n
  while IFS='|' read -r p cmd hist; do
    [[ $cmd =~ ^(bash|zsh|fish|sh|dash)$ ]] || return 1
    ((hist < 3)) || return 1
    n=$(tmux capture-pane -p -t "$p" 2>/dev/null | grep -c '[^[:space:]]')
    ((n <= 2)) || return 1
  done < <(tmux list-panes -s -t "=$1" -F '#{pane_id}|#{pane_current_command}|#{history_size}' 2>/dev/null)
}

# Fecha as sessões vazias desta máquina, menos a sessão EXCETO (a que está em uso). Imprime quantas.
fechar_vazias() {
  local s ponte n=0
  while IFS='|' read -r s ponte; do
    [[ -n $ponte || $s == "${1:-}" ]] && continue
    sessao_vazia "$s" && tmux kill-session -t "=$s" && n=$((n + 1))
  done < <(tmux list-sessions -F '#{session_name}|#{@ponte}' 2>/dev/null)
  echo "$n"
}

# Linha separadora do bloco de vazias (chave !vazias: Enter/clique fecha todas).
linha_vazias() {
  printf '!vazias	[90m── %d vazia%s · ⏎ fecha todas ──[0m	%svazias vazia
' "$1" "$([[ $1 -gt 1 ]] && echo s)" "$ESPACOS"
}

# Linhas do menu desta máquina: "chave<TAB>texto<TAB>busca". Chave: nome da sessão, %N (um painel
# de uma sessão com vários) ou +PID (janela solta, fora do tmux).
listar() {
  local sh fg cmd cwd desc id status nome
  PS_CACHE=$(ps -eo pid=,ppid=,comm=)
  soltos | while IFS='|' read -r sh fg cmd cwd; do
    if [[ $cmd == claude ]]; then
      read -r id status nome < <(claude_info "$fg")
      [[ $status == idle ]] && desc=$'\033[33mclaude\033[0m \033[32mocioso\033[0m' || desc=$'\033[33mclaude\033[0m \033[31mtrabalhando\033[0m'
    else
      desc=$'\033[33m'"$cmd"$'\033[0m'
    fi
    printf '+%s\t\033[35m⧉\033[0m \033[1;35m%-20s\033[0m %s %s \033[90m(fora do tmux)\033[0m\t%s%s %s\n' \
      "$sh" "solta" "$desc" "$(encurtar "$cwd")" "$ESPACOS" "$cmd" "$cwd"
  done

  local ativ s anex pasta ponte l n i uso extra marca ativo pid pos cmdp pastap rot nomep
  local -a linhas=() buscas=() vazias=()
  tmux list-sessions -F '#{window_activity}|#{session_name}|#{session_attached}|#{pane_current_command}|#{pane_current_path}|#{@ponte}' 2>/dev/null |
    sort -t'|' -k1,1nr | {
    while IFS='|' read -r ativ s anex cmd pasta ponte; do
      [[ -n $ponte ]] && continue # ponte para sessão de outra máquina: aparece na linha da própria máquina
      if sessao_vazia "$s"; then
        # Vazias vão para um bloco à parte, no fim, apagadas.
        ((anex > 0)) && uso='●' || uso='○'
        vazias+=("$(printf '%s	[90m%s %-20.20s %-7s %s (%s)[0m	%s%s vazia' "$s" "$uso" "$s" "$cmd" "$(encurtar "$pasta")" "$(idade "$ativ")" "$ESPACOS" "$s")")
        continue
      fi
      mapfile -t linhas < <(tmux list-panes -s -t "=$s" -F '#{pane_id}|#{window_index}.#{pane_index}|#{pane_current_command}|#{pane_current_path}|#{@tt_rotulo}|#{@nome_painel}|#{&&:#{pane_active},#{window_active}}')
      n=${#linhas[@]}
      buscas=()
      for l in "${linhas[@]}"; do buscas+=("$(busca_painel "${l%%|*}")"); done
      ((anex > 0)) && uso=$'\033[32m●\033[0m' || uso=$'\033[90m○\033[0m'
      ((n > 1)) && extra=" · $n painéis" || extra=""
      nome=$s
      ((${#nome} > 20)) && nome="${nome:0:19}…"
      printf '%s\t%s \033[1;36m%-20s\033[0m \033[33m%-7s\033[0m %s \033[90m(%s%s)\033[0m\t%s%s %s\n' \
        "$s" "$uso" "$nome" "$cmd" "$(encurtar "$pasta")" "$(idade "$ativ")" "$extra" "$ESPACOS" "$s" "${buscas[*]}"
      ((n > 1)) || continue
      for ((i = 0; i < n; i++)); do
        IFS='|' read -r pid pos cmdp pastap rot nomep ativo <<<"${linhas[i]}"
        ((i == n - 1)) && marca='└' || marca='├'
        ((ativo)) && marca+='▸' || marca+=' '
        if [[ -z $nomep ]]; then [[ -n $rot ]] && nomep="⧉ $rot" || nomep=$cmdp; fi
        printf '%s\t  \033[90m%s%-4s\033[0m \033[36m%-15.15s\033[0m \033[33m%-7s\033[0m %s\t%s%s %s\n' \
          "$pid" "$marca" "$pos" "$nomep" "$cmdp" "$(encurtar "$pastap")" "$ESPACOS" "$s" "${buscas[i]}"
      done
    done
    if ((${#vazias[@]})); then
      linha_vazias "${#vazias[@]}"
      printf '%s\n' "${vazias[@]}"
    fi
  }
}

# Prévia: a tela da sessão/painel. Com texto buscado que aparece na tela, mostra o trecho dele.
previa() {
  local k=$1 q=${2:-} alvo
  case $k in
    +*) previa_solta "${k#+}"; return ;;
    %*) alvo=$k ;;
    *) alvo="=$k:" ;;
  esac
  [[ -n $q ]] && trecho "$k" "$q" && return
  # Sem as linhas vazias do fim (senão o "follow" do fzf mostra só branco).
  tmux capture-pane -ep -t "$alvo" 2>/dev/null |
    awk '{ l[NR] = $0 } END { n = NR; while (n > 0 && l[n] ~ /^(\033\[[0-9;]*m|[[:space:]])*$/) n--; for (i = 1; i <= n; i++) print l[i] }'
}

trecho() {
  local k=$1 q=$2 p
  local paineis=$k
  [[ $k == %* ]] || paineis=$(tmux list-panes -s -t "=$k" -F '#{pane_id}' 2>/dev/null)
  for p in $paineis; do
    tmux capture-pane -p -J -S -150 -t "$p" 2>/dev/null | python3 -c '
import re, sys
termos = [t.strip("^$\x27") for t in sys.argv[1].split() if not t.startswith("!")]
termos = [t for t in termos if t]
if not termos:
    sys.exit(1)
linhas = sys.stdin.read().rstrip("\n").split("\n")
padrao = re.compile("|".join(re.escape(t) for t in termos), re.I)
achou = [i for i, l in enumerate(linhas) if padrao.search(l)]
if not achou:
    sys.exit(1)
i = achou[-1]
print(f"\033[90m🔎 encontrado na tela ({len(achou)} linha(s); mostrando a última) · painel {sys.argv[2]}\033[0m")
for l in linhas[max(0, i - 14): i + 6]:
    print(padrao.sub(lambda m: "\033[30;43m" + m.group(0) + "\033[0m", l))
' "$q" "$p" && return 0
  done
  return 1
}

previa_solta() {
  local sh=$1 fg cmd id status nome
  fg=$(ps -o tpgid= -p "$sh" | tr -d ' ')
  cmd=$(ps -o comm= -p "$fg")
  echo "Janela aberta fora do tmux — não dá para ver a tela dela daqui."
  echo
  echo "  terminal:  $(ps -o tty= -p "$sh")   shell: $sh"
  echo "  rodando:   $(ps -o args= -p "$fg" | cut -c1-70)"
  echo "  pasta:     $(encurtar "$(readlink "/proc/$fg/cwd")")"
  echo
  if [[ $cmd == claude ]]; then
    read -r id status nome < <(claude_info "$fg")
    echo "  conversa:  $nome ($id)"
    echo
    if [[ $status == idle ]]; then
      echo "Enter: fecha esse Claude, reabre a MESMA conversa (claude --resume) numa"
      echo "sessão tmux nova e fecha a janela original."
    else
      echo "Esse Claude está trabalhando agora. Espere ele terminar para adotar."
    fi
  elif [[ $fg == "$sh" ]]; then
    echo "Enter: abre uma sessão tmux nova nesta pasta e fecha a janela original."
    echo "(variáveis definidas à mão nessa janela se perdem; o histórico é salvo)"
  else
    echo "Enter: tenta mover \"$cmd\" para o tmux (reptyr). A janela original fica"
    echo "com o shell parado no prompt."
  fi
}

# Traz para o tmux a janela cujo shell líder é $1. Imprime o nome da sessão criada.
adotar() {
  local sh=$1 fg cmd cwd nome id status rotulo flags claude i titulo
  fg=$(ps -o tpgid= -p "$sh" | tr -d ' ')
  [[ -n $fg ]] || { echo "Essa janela já foi fechada." >&2; return 1; }
  cmd=$(ps -o comm= -p "$fg")
  cwd=$(readlink "/proc/$fg/cwd")

  if [[ $cmd == claude ]]; then
    read -r id status rotulo < <(claude_info "$fg")
    [[ -n ${id:-} ]] || { echo "Não achei qual conversa esse Claude está usando." >&2; return 1; }
    [[ $status == idle ]] || { echo "Esse Claude está trabalhando. Espere ele terminar e tente de novo." >&2; return 1; }
    flags=$(tr '\0' '\n' <"/proc/$fg/cmdline" | grep -xE -- '--dangerously-skip-permissions|--verbose' | tr '\n' ' ')
    claude=$HOME/.local/bin/claude
    [[ -x $claude ]] || claude=$(command -v claude)
    nome=$(proximo_nome claude)
    titulo=$(titulo_claude "$id") || titulo=""
    kill -TERM "$fg"
    for i in $(seq 50); do kill -0 "$fg" 2>/dev/null || break; sleep 0.2; done
    if kill -0 "$fg" 2>/dev/null; then echo "O Claude não fechou; nada foi alterado." >&2; return 1; fi
    tmux new-session -d -s "$nome" -c "$cwd" "set -m; $claude --resume $id $flags; exec bash" || return 1
    # A pasta já tinha sido aprovada na janela original: responde sozinho à pergunta de confiança.
    for i in $(seq 40); do
      sleep 0.5
      case $(tmux capture-pane -p -t "=$nome:") in
        *"Yes, I trust this folder"*) tmux send-keys -t "=$nome:" Down Enter; break ;;
        *"bypass permissions"* | *"? for shortcuts"*) break ;;
      esac
    done
    if [[ -n $titulo ]]; then
      nome=$(renomear "$nome" "$(slug "$titulo")" auto)
      tmux set-option -t "=$nome:" @nome_titulo "$titulo"
    fi
  elif [[ $fg == "$sh" ]]; then
    nome=$(proximo_nome janela)
    tmux new-session -d -s "$nome" -c "$cwd" || return 1
  else
    # Outro programa em primeiro plano: tenta movê-lo; o shell original fica na janela.
    nome=$(proximo_nome janela)
    local reptyr=reptyr
    [[ $(cat /proc/sys/kernel/yama/ptrace_scope 2>/dev/null || echo 0) == 0 ]] || reptyr="sudo reptyr"
    tmux new-session -d -s "$nome" -c "$cwd" \
      "$reptyr $fg || read -rp 'Não deu para mover $cmd (ele tem subprocessos). Enter para continuar.'; exec bash" || return 1
    echo "$nome"
    return 0
  fi

  kill -HUP "$sh" # fecha a janela original
  echo "$nome"
}

# --- Máquinas, instalação e versão -----------------------------------------
#
# Cada máquina tem o tt instalado em ~/.local/share/tt (tt, tmux.conf, VERSAO) e
# ~/.local/bin/tt aponta para lá. O ~/.tmux.conf só carrega o tmux.conf de lá (e ajustes locais).
# ~/.config/tt/config:   nome=<como esta máquina aparece no menu>
# ~/.config/tt/maquinas: as outras máquinas cadastradas, uma por linha: host usuario rótulo
# Na máquina onde se desenvolve, o repositório (~/Projetos/tt) é a origem de `tt --sincronizar`.

DIR_TT=${TT_DIR:-$HOME/.local/share/tt}
# Repositório de origem (só na máquina onde se desenvolve): TT_REPO, "repo=" no config, ou a pasta
# deste tt, se ele estiver rodando de dentro de um clone.
REPO_TT=${TT_REPO:-$(conf repo)}
[[ -z $REPO_TT && -d $(dirname "$EU")/.git && -f $(dirname "$EU")/tmux.conf ]] && REPO_TT=$(dirname "$EU")
SSH_OPC=(-o BatchMode=yes -o ConnectTimeout=4 -o StrictHostKeyChecking=accept-new
  -o ControlMaster=auto -o "ControlPath=$HOME/.cache/tt-ssh-%r@%h" -o ControlPersist=12h
  -o ServerAliveInterval=30)
TT_REMOTO='~/.local/bin/tt'
RT=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}
# O que se soube de cada máquina na última consulta (rótulo = nome dela na barra): as sessões que ela
# mostrou e "quantas-sessões versão". Os menus abrem na hora com isso e atualizam em segundo plano.
cache_bloco() { echo "$RT/tt-bloco-$(id -u)-$1"; }
info_maquina() { echo "$RT/tt-info-$(id -u)-$1"; }

# Máquinas cadastradas e acessíveis: "usuario@host rótulo". Guarda 20 s em cache: a barra e os
# menus chamam isso a cada clique.
maquinas() {
  local cache="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/tt-maquinas-$(id -u)"
  if [[ -f $cache ]] && [[ $cache -nt $CONF_MAQ || ! -f $CONF_MAQ ]] && (($(date +%s) - $(stat -c %Y "$cache") < 20)); then
    cat "$cache"; return
  fi
  local tmp
  tmp=$(mktemp "$cache.XXXXXX") || { maquinas_agora; return; }
  maquinas_agora >"$tmp" && mv -f "$tmp" "$cache" || rm -f "$tmp" # chamadas em paralelo: cada uma com seu temporário
  cat "$cache" 2>/dev/null || maquinas_agora
}
# Consulta todas as outras máquinas ao mesmo tempo e guarda "quantas-sessões versão" de cada uma
# ("? ?" se não responder). Demora até 3 s: chame sempre em segundo plano.
atualizar_info() {
  local dest rot f r
  while read -r dest rot; do
    f=$(info_maquina "$rot")
    {
      r=$(timeout 3 ssh "${SSH_OPC[@]}" "$dest" "echo \$(tmux list-sessions -F '#{@ponte}' 2>/dev/null | grep -c '^\$') \$(awk '{print \$1+0}' ~/.local/share/tt/VERSAO 2>/dev/null || echo 0)" </dev/null 2>/dev/null) || r="? ?"
      echo "$r" >"$f.$$" && mv "$f.$$" "$f"
    } &
  done < <(maquinas)
  wait
}
limpar_cache_maquinas() { rm -f "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/tt-maquinas-$(id -u)"; }

# Lê ~/.config/tt/maquinas; com o Tailscale, pula as desligadas e usa o nome completo
# (host.tailnet.ts.net: o nome curto pode coincidir com o desta máquina — por exemplo, um WSL
# com o mesmo hostname do Windows que o hospeda).
maquinas_agora() {
  [[ -f $CONF_MAQ ]] || return 0
  { command -v tailscale >/dev/null && tailscale status --json 2>/dev/null || echo '{}'; } | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except ValueError:
    d = {}
pares = {}
for p in (d.get("Peer") or {}).values():
    dns = p.get("DNSName", "").rstrip(".")
    for nome in {dns, dns.split(".")[0], p.get("HostName", "")}:
        if nome:
            pares[nome] = p
for linha in open(sys.argv[1]):
    c = linha.split()
    if not c or c[0].startswith("#") or c[1:2] == ["-"]:
        continue
    host = c[0]
    usuario = c[1] if len(c) > 1 else sys.argv[2]
    rotulo = c[2] if len(c) > 2 else host.split(".")[0]
    p = pares.get(host)
    if p is not None:
        if not p.get("Online"):
            continue
        host = p.get("DNSName", "").rstrip(".") or host
    print(f"{usuario}@{host} {rotulo}")
' "$CONF_MAQ" "$(id -un)" 2>/dev/null
}

# Máquinas Linux online da tailnet que ainda não estão cadastradas: "host sistema".
candidatas() {
  command -v tailscale >/dev/null || return 0
  tailscale status --json 2>/dev/null | python3 -c '
import json, sys
d = json.load(sys.stdin)
cad = set()
try:
    for l in open(sys.argv[1]):
        c = l.split()
        if c and not c[0].startswith("#"):
            cad.add(c[0]); cad.add(c[0].split(".")[0])
except OSError:
    pass
for p in (d.get("Peer") or {}).values():
    host = p.get("DNSName", "").split(".")[0]
    if host and p.get("Online") and host not in cad and p.get("OS") in ("linux",):
        print(host, p.get("OS"))
' "$CONF_MAQ" 2>/dev/null
}

# Como as outras máquinas chamam esta: nome curto no Tailscale (senão, hostname).
meu_host() {
  local h=""
  command -v tailscale >/dev/null && h=$(tailscale status --json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("Self",{}).get("DNSName","").split(".")[0])' 2>/dev/null)
  echo "${h:-$(hostname -s)}"
}

dest_de() { [[ $1 == "$MAQUINA" ]] && echo . || maquinas | awk -v r="$1" '$2 == r { print $1; exit }'; }

rotulo_de() { maquinas | awk -v d="$1" '$1 == d { print $2; f = 1 } END { if (!f) print d }'; }

# Grava/tira uma máquina de ~/.config/tt/maquinas (troca a linha do mesmo host, se houver).
registrar() {
  local host=$1 usuario=$2 rot=$3
  mkdir -p "$(dirname "$CONF_MAQ")"
  [[ -f $CONF_MAQ ]] || echo '# host  usuario  rótulo   (gerenciado por tt --cadastrar / --descadastrar)' >"$CONF_MAQ"
  desregistrar "$host"
  echo "$host  $usuario  $rot" >>"$CONF_MAQ"
  limpar_cache_maquinas
}
desregistrar() {
  [[ -f $CONF_MAQ ]] || return 0
  awk -v h="$1" '{ c = $1; sub(/\..*/, "", c); hh = h; sub(/\..*/, "", hh) } !($1 == h || c == hh) || /^#/' "$CONF_MAQ" >"$CONF_MAQ.novo" &&
    mv "$CONF_MAQ.novo" "$CONF_MAQ"
  limpar_cache_maquinas
}

# Versão instalada: "N hash data" (N = nº de commits do repositório; +dev = com mudanças não gravadas).
versao() { cat "$DIR_TT/VERSAO" 2>/dev/null || echo "0 ? ?"; }
versao_num() { versao | awk '{ print $1 + 0 }'; }

# Arquivos versionados que formam o tt instalado; o pacote leva também o VERSAO.
ARQUIVOS_FONTE=(tt tmux.conf tema-terminal.sh tema-agentes.sh README.md)
ARQUIVOS_PACOTE=("${ARQUIVOS_FONTE[@]}" VERSAO)

# Pacote (tar no stdout) com a versão a instalar: do repositório, se esta é a máquina de
# desenvolvimento; senão, a própria instalação.
pacote() {
  local tmp n h d
  if [[ -d $REPO_TT/.git ]]; then
    tmp=$(mktemp -d)
    cp "${ARQUIVOS_FONTE[@]/#/$REPO_TT/}" "$tmp/"
    n=$(git -C "$REPO_TT" rev-list --count HEAD 2>/dev/null || echo 0)
    h=$(git -C "$REPO_TT" rev-parse --short HEAD 2>/dev/null || echo ?)
    d=$(git -C "$REPO_TT" log -1 --format=%cs 2>/dev/null || date +%F)
    [[ -n $(git -C "$REPO_TT" status --porcelain -- "${ARQUIVOS_FONTE[@]}" 2>/dev/null) ]] && h+="+dev"
    echo "$n $h $d" >"$tmp/VERSAO"
    tar -C "$tmp" -cf - "${ARQUIVOS_PACOTE[@]}"
    rm -rf "$tmp"
  else
    tar -C "$DIR_TT" -cf - "${ARQUIVOS_PACOTE[@]}"
  fi
}

# O pacote em DIR tem todos os arquivos e os scripts passam no bash -n. Um pacote incompleto
# (clone antigo, tar cortado) nunca substitui a instalação: trocaria a pasta inteira e sumiria
# com recursos já instalados.
pacote_valido() {
  local dir=$1 f
  for f in "${ARQUIVOS_PACOTE[@]}"; do
    [[ -s $dir/$f ]] || { echo "$(conf nome): ✗ pacote incompleto (falta $f), nada instalado"; return 1; }
  done
  for f in tt tema-terminal.sh tema-agentes.sh; do
    bash -n "$dir/$f" 2>/dev/null || { echo "$(conf nome): ✗ $f com erro de sintaxe, nada instalado"; return 1; }
  done
}

# Não rebaixa nem troca por uma versão paralela: só instala se a versão nova ("N hash data") tiver
# número maior que a instalada, ou o mesmo número e o mesmo commit (reinstalação, ou +dev do mesmo
# commit). TT_FORCAR=1 passa por cima (para voltar de propósito a uma versão anterior).
pode_instalar() {
  local nova=$1 n h na ha
  [[ -n ${TT_FORCAR:-} || ! -f $DIR_TT/VERSAO ]] && return 0
  read -r n h _ <<<"$nova"; read -r na ha _ <"$DIR_TT/VERSAO"
  [[ $n =~ ^[0-9]+$ ]] || n=0; [[ $na =~ ^[0-9]+$ ]] || na=0
  if ((n > na)) || { ((n == na)) && [[ ${h%+dev} == "${ha%+dev}" ]]; }; then return 0; fi
  if ((n < na)); then echo "$(conf nome): · já tem a versão $na ($ha), mais nova que $n ($h); não rebaixei"
  else echo "$(conf nome): · tem outra versão $na ($ha), diferente desta ($h); não troquei — atualize o repositório"; fi
  return 1
}

# Instala o pacote que está na pasta deste tt (chamado como <pasta>/tt --instalar-aqui).
# Troca a pasta de uma vez (nunca sobrescreve o arquivo de um tt que esteja rodando, como o vigia),
# aponta ~/.local/bin/tt para ela, faz o ~/.tmux.conf carregar o tmux.conf dela e recarrega o tmux.
instalar_aqui() {
  local origem nome=${TT_NOME:-} pidf pid
  origem=$(dirname "$EU")
  if [[ $origem != "$DIR_TT" ]]; then
    pacote_valido "$origem" || return 1
    pode_instalar "$(cat "$origem/VERSAO")" || return 1
    rm -rf "$DIR_TT.novo" "$DIR_TT.velho"
    mkdir -p "$(dirname "$DIR_TT")"
    cp -a "$origem" "$DIR_TT.novo" || return 1
    [[ -d $DIR_TT ]] && mv "$DIR_TT" "$DIR_TT.velho"
    mv "$DIR_TT.novo" "$DIR_TT"
    rm -rf "$DIR_TT.velho"
  fi
  chmod +x "$DIR_TT/tt" "$DIR_TT/tema-agentes.sh"
  mkdir -p "$HOME/.local/bin"
  if [[ -f $HOME/.local/bin/tt && ! -L $HOME/.local/bin/tt ]]; then
    mv "$HOME/.local/bin/tt" "$HOME/.local/bin/tt.antes-instalacao"
  fi
  ln -sfn "$DIR_TT/tt" "$HOME/.local/bin/tt"
  if ! grep -q '^source-file ~/.local/share/tt/tmux.conf' "$HOME/.tmux.conf" 2>/dev/null; then
    [[ -f $HOME/.tmux.conf && ! -f $HOME/.tmux.conf.antes-tt ]] && cp "$HOME/.tmux.conf" "$HOME/.tmux.conf.antes-tt"
    cat >"$HOME/.tmux.conf" <<'CONF'
# ~/.tmux.conf — a configuração vem do tt (~/.local/share/tt/tmux.conf), atualizada por
# `tt --sincronizar`. Ajustes só desta máquina vão abaixo da linha do source-file.
source-file ~/.local/share/tt/tmux.conf
CONF
  fi
  mkdir -p "$(dirname "$CONF")"
  if [[ -n $nome ]]; then
    grep -v '^nome=' "$CONF" 2>/dev/null >"$CONF.novo"; echo "nome=$nome" >>"$CONF.novo"; mv "$CONF.novo" "$CONF"
  elif [[ -z $(conf nome) ]]; then
    echo "nome=$(hostname -s)" >>"$CONF"
  fi
  limpar_cache_maquinas
  atualizar_bashrc
  "$DIR_TT/tema-agentes.sh" --aplicar
  if tmux list-sessions >/dev/null 2>&1; then
    tmux source-file "$HOME/.tmux.conf"
    # O vigia em execução é da versão antiga: troca por um novo.
    pidf="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/tt-vigia-$(id -u).pid"
    pid=$(cat "$pidf" 2>/dev/null)
    if [[ -n $pid ]] && tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q -- '--vigia'; then kill "$pid"; fi
    rm -f "$pidf"
    tmux run-shell -b "$HOME/.local/bin/tt --vigia"
  fi
  echo "$(conf nome): $(versao)"
}

# Envia o pacote para DEST e instala lá. Imprime "rótulo: versão".
instalar_em() {
  local dest=$1 nome=${2:-}
  if [[ $dest == . ]]; then
    local tmp; tmp=$(mktemp -d)
    pacote | tar -C "$tmp" -xf - && TT_NOME=$nome "$tmp/tt" --instalar-aqui
    local st=$?
    rm -rf "$tmp"
    return $st
  else
    pacote | ssh "${SSH_OPC[@]}" "$dest" "rm -rf ~/.cache/tt-pacote && mkdir -p ~/.cache/tt-pacote && tar -C ~/.cache/tt-pacote -xf - && TT_NOME=$(q "$nome") ~/.cache/tt-pacote/tt --instalar-aqui; rm -rf ~/.cache/tt-pacote"
  fi
}

# --- Atualização pelo GitHub -----------------------------------------------
#
# A versão publicada fica num clone em ~/.local/share/tt-fonte (o repositório oficial, ou o de
# "fonte=" no config). `tt --atualizar` instala de lá se for mais nova; o vigia consulta a cada 12 h
# e avisa uma vez quando sai versão nova (e o menu de máquinas oferece atualizar).

URL_FONTE_PADRAO='https://github.com/helio-nogueira-cardoso/tt-terminais.git'
DIR_FONTE=$HOME/.local/share/tt-fonte
CACHE_GITHUB="$HOME/.cache/tt-github-versao"

url_fonte() { local u; u=$(conf fonte); echo "${u:-$URL_FONTE_PADRAO}"; }

# Traz a versão publicada para o clone local. Imprime o número da versão (nº de commits).
buscar_fonte() {
  command -v git >/dev/null || { echo "precisa do git" >&2; return 1; }
  if [[ ! -d $DIR_FONTE/.git ]]; then
    rm -rf "$DIR_FONTE"
    git clone -q "$(url_fonte)" "$DIR_FONTE" 2>/dev/null || return 1
  else
    git -C "$DIR_FONTE" remote set-url origin "$(url_fonte)"
    git -C "$DIR_FONTE" fetch -q origin 2>/dev/null || return 1
    git -C "$DIR_FONTE" reset -q --hard origin/HEAD 2>/dev/null || git -C "$DIR_FONTE" reset -q --hard origin/main
  fi
  git -C "$DIR_FONTE" rev-list --count HEAD
}

# Consulta (sem instalar) e guarda "N data" em cache; o vigia chama isto a cada 12 h.
verificar_atualizacao() {
  local n
  n=$(buscar_fonte) || return 1
  mkdir -p "$(dirname "$CACHE_GITHUB")"
  echo "$n $(date +%s)" >"$CACHE_GITHUB"
  if ((n > $(versao_num))) && [[ $(conf avisado) != "$n" ]]; then
    avisar "⟳ tt: versão $n disponível no GitHub (esta é a $(versao_num)) — menu de máquinas → Atualizar"
    grep -v '^avisado=' "$CONF" 2>/dev/null >"$CONF.novo"; echo "avisado=$n" >>"$CONF.novo"; mv "$CONF.novo" "$CONF"
  fi
}
versao_github() { awk '{ print $1 + 0 }' "$CACHE_GITHUB" 2>/dev/null || echo 0; }

# tt --atualizar [--todas]: instala a versão mais nova do GitHub aqui (e nas cadastradas, com --todas).
atualizar() {
  local todas=${1:-} n
  if [[ -d $REPO_TT/.git ]]; then
    echo "Esta máquina é a de desenvolvimento ($REPO_TT): git pull…"
    if [[ -n $(git -C "$REPO_TT" status --porcelain -- "${ARQUIVOS_FONTE[@]}") ]]; then
      echo "Há mudanças não gravadas no repositório; atualize à mão (git stash / commit)."; return 1
    fi
    git -C "$REPO_TT" pull -q --ff-only || { echo "git pull falhou."; return 1; }
  else
    printf 'Buscando a versão publicada (%s)… ' "$(url_fonte)"
    n=$(buscar_fonte) || { echo "falhou (sem rede ou sem git?)."; return 1; }
    echo "v$n"
    echo "$n $(date +%s)" >"$CACHE_GITHUB"
    if ((n <= $(versao_num))) && [[ -z $todas ]]; then echo "Já está na mais nova (v$(versao_num))."; return 0; fi
    REPO_TT=$DIR_FONTE
  fi
  if [[ -n $todas ]]; then sincronizar
  else printf '  %-10s ' "$MAQUINA"; instalar_em . | sed 's/^[^:]*: //'; fi
}

# Um clone atrasado em relação ao GitHub não pode ser a fonte: instalaria código velho por cima
# de recursos que outras máquinas já têm. Sem rede ou sem upstream, segue (o pode_instalar ainda
# barra o rebaixamento em cada máquina).
repo_em_dia() {
  [[ -d $REPO_TT/.git ]] || return 0
  git -C "$REPO_TT" rev-parse -q --verify '@{u}' >/dev/null 2>&1 || return 0
  timeout 15 git -C "$REPO_TT" fetch -q 2>/dev/null || return 0
  local atras
  atras=$(git -C "$REPO_TT" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)
  ((atras == 0)) && return 0
  echo "✗ $REPO_TT está $atras commit(s) atrás de $(git -C "$REPO_TT" rev-parse --abbrev-ref '@{u}'): git pull --rebase antes de sincronizar."
  return 1
}

# tt --sincronizar [rótulo…]: instala a versão daqui (do repositório, se houver) nesta máquina e
# nas cadastradas. Não rebaixa: pula quem já tem versão mais nova.
sincronizar() {
  local dest rot alvo n_local n_rem
  local -a alvos=("$@")
  repo_em_dia || return 1
  echo "Versão a instalar: $(pacote | tar -xOf - VERSAO)"
  [[ -d $REPO_TT/.git ]] && { printf '  %-10s ' "$MAQUINA"; instalar_em . | sed 's/^[^:]*: //'; }
  n_local=$(pacote | tar -xOf - VERSAO | awk '{ print $1 + 0 }')
  while read -r dest rot; do
    if ((${#alvos[@]})); then
      for alvo in "${alvos[@]}"; do [[ $alvo == "$rot" ]] && break; alvo=""; done
      [[ -n $alvo ]] || continue
    fi
    printf '  %-10s ' "$rot"
    n_rem=$(timeout 8 ssh "${SSH_OPC[@]}" "$dest" "cat ~/.local/share/tt/VERSAO 2>/dev/null || echo 0" </dev/null 2>/dev/null | awk '{ print $1 + 0 }')
    if [[ -z $n_rem ]]; then echo "✗ sem resposta"; continue; fi
    if ((n_rem > n_local)); then echo "· já tem versão mais nova ($n_rem), não mexi"; continue; fi
    instalar_em "$dest" "$rot" 2>&1 | tail -1 | sed 's/^[^:]*: //'
  done < <(maquinas)
}

# tt --cadastrar [host [usuario [rótulo]]]: testa o acesso, instala o tt lá e cadastra as duas
# máquinas uma na outra.
cadastrar() {
  local host=${1:-} usuario=${2:-} rot=${3:-} dest err falta r h
  if [[ -z $host ]]; then
    host=$( { candidatas | awk '{ printf "%s\t\033[1m%s\033[0m \033[90m(Tailscale, %s)\033[0m\n", $1, $1, $2 }'
              printf '!outro\t\033[36m✎ outra (digitar host ou IP)\033[0m\n'; } |
      fzf --ansi --delimiter='\t' --with-nth=2 --no-sort --layout=reverse --height=~15 \
        --header='Qual máquina cadastrar? (Linux online no Tailscale ainda não cadastradas)' --prompt='❯ ' |
      cut -f1) || return 1
    [[ $host == !outro ]] && read -rp "Host ou IP (como no ssh): " host
  fi
  [[ -n $host ]] || return 1
  usuario=${usuario:-$(id -un)}
  while :; do
    r=$usuario
    read -rep "Usuário em $host: " -i "$r" usuario || return 1
    usuario=${usuario:-$r}
    printf 'Testando ssh %s@%s… ' "$usuario" "$host"
    err=$(timeout 15 ssh "${SSH_OPC[@]}" "$usuario@$host" true 2>&1 </dev/null) && { echo ok; break; }
    echo "falhou."
    if grep -q login.tailscale.com <<<"$err"; then
      echo "O Tailscale SSH de lá pede aprovação no navegador:"; grep -o 'https://login.tailscale.com[^ ]*' <<<"$err"
      read -rp "Aprove e tecle Enter para tentar de novo (ou Ctrl+C)." r
    else
      echo "  ${err:0:200}"
      read -rp "Tentar outro usuário? [S/n] " r; [[ $r == [nN]* ]] && return 1
    fi
  done
  dest="$usuario@$host"
  falta=$(ssh "${SSH_OPC[@]}" "$dest" 'for p in tmux fzf python3 tar; do command -v $p >/dev/null || printf "%s " $p; done' </dev/null)
  if [[ -n $falta ]]; then
    echo "Faltam lá: $falta"
    read -rp "Instalar com sudo apt-get? [S/n] " r
    [[ $r == [nN]* ]] || ssh -t "${SSH_OPC[@]}" "$dest" "sudo apt-get install -y $falta"
  fi
  h=$(ssh "${SSH_OPC[@]}" "$dest" 'sed -n "s/^nome=//p" ~/.config/tt/config 2>/dev/null | tail -1' </dev/null)
  rot=${rot:-${h:-${host%%.*}}}
  r=$rot
  read -rep "Nome dela no menu: " -i "$r" rot || return 1
  rot=${rot:-$r}
  rot=$(limpar "$rot")
  [[ $rot == "$MAQUINA" ]] && { echo "Esse nome já é o desta máquina; escolha outro."; return 1; }
  echo "Instalando o tt em $rot…"
  instalar_em "$dest" "$rot" | tail -1 || { echo "A instalação falhou."; return 1; }
  registrar "$host" "$usuario" "$rot"
  ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --registrar $(q "$(meu_host)" "$(id -un)" "$MAQUINA")" </dev/null
  echo "✓ $rot cadastrada: aparece no menu daqui, e esta ($MAQUINA) no menu de lá."
}

# tt --descadastrar [rótulo]: tira do menu (aqui e lá), fecha as pontes e, se quiser, desinstala lá.
descadastrar() {
  local rot=${1:-} dest host r s
  if [[ -z $rot ]]; then
    rot=$(awk '!/^#/ && NF { print ($3 ? $3 : $1) "\t" $1 }' "$CONF_MAQ" 2>/dev/null |
      fzf --delimiter='\t' --layout=reverse --height=~12 --header='Descadastrar qual máquina?' --prompt='❯ ' | cut -f1) || return 1
  fi
  [[ -n $rot ]] || return 1
  host=$(awk -v r="$rot" '!/^#/ && ($3 == r || $1 == r) { print $1; exit }' "$CONF_MAQ" 2>/dev/null)
  [[ -n $host ]] || { echo "$rot não está cadastrada."; return 1; }
  dest=$(dest_de "$rot")
  read -rp "Descadastrar $rot? [s/N] " r; [[ $r == [sSyY]* ]] || return 1
  for s in $(tmux list-sessions -F '#{session_name}|#{@ponte}' 2>/dev/null | awk -F'|' -v d="$dest" '$2 == d && d != "" { print $1 }'); do
    tmux kill-session -t "=$s"
  done
  if [[ -n $dest && $dest != . ]]; then
    ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --desregistrar $(q "$(meu_host)")" </dev/null 2>/dev/null
    read -rp "Remover o tt de lá também (volta o ~/.tmux.conf antigo)? [s/N] " r
    [[ $r == [sSyY]* ]] && ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --desinstalar-aqui" </dev/null
  fi
  desregistrar "$host"
  echo "✓ $rot descadastrada."
}

desinstalar_aqui() {
  if [[ -f $HOME/.tmux.conf.antes-tt ]]; then mv "$HOME/.tmux.conf.antes-tt" "$HOME/.tmux.conf"
  elif grep -q '^source-file ~/.local/share/tt/tmux.conf' "$HOME/.tmux.conf" 2>/dev/null; then rm -f "$HOME/.tmux.conf"; fi
  [[ -L $HOME/.local/bin/tt ]] && rm -f "$HOME/.local/bin/tt"
  remover_bashrc
  rm -rf "$DIR_TT"
  echo "tt removido de $(hostname -s) (a configuração em ~/.config/tt ficou)."
}

# Abertura automática no tmux: bloco no fim do ~/.bashrc, entre marcadores, para que cada janela
# de terminal vire uma sessão do tt. Idempotente (também reconhece o trecho antigo, sem marcadores)
# e com backup em ~/.bashrc.antes-tt.
BASHRC_INI='# >>> tt (terminais em tmux) >>>'
BASHRC_FIM='# <<< tt (terminais em tmux) <<<'

bashrc_bloco() {
  cat <<'BLOCO'
# A paleta comum chega antes do tmux: vale também para SSH e para terminais
# abertos diretamente nesta máquina. Em emuladores que não aceitam OSC, não faz nada.
[[ -r "$HOME/.local/share/tt/tema-terminal.sh" ]] && source "$HOME/.local/share/tt/tema-terminal.sh"
[[ -x "$HOME/.local/share/tt/tema-agentes.sh" ]] && "$HOME/.local/share/tt/tema-agentes.sh" --aplicar >/dev/null 2>&1

# Toda janela de terminal (GNOME Terminal / Windows Terminal / Termux) abre numa sessão tmux própria,
# para poder ser assumida de outro lugar pela central `tt`.
# Fica de fora: terminais de IDE, SSH e shells não interativos. Para abrir uma janela sem tmux: NOTMUX=1
if [[ $- == *i* && -t 0 && -t 1 && -z ${TMUX:-} && -z ${NOTMUX:-} && -z ${SSH_CONNECTION:-} \
      && -z ${TERM_PROGRAM:-} && -z ${TERMINAL_EMULATOR:-} \
      && ( -n ${VTE_VERSION:-} || -n ${WT_SESSION:-} || -n ${TERMUX_VERSION:-} ) ]] \
   && command -v tmux >/dev/null && [[ -x $HOME/.local/bin/tt ]]; then
  exec "$HOME/.local/bin/tt" --janela
fi
BLOCO
}

# Em atualizações, substitui somente o conteúdo do bloco gerenciado pelo tt. Assim a paleta nova
# chega às máquinas já cadastradas sem tocar no restante do ~/.bashrc.
atualizar_bashrc() {
  local rc=$HOME/.bashrc tmp
  grep -qF "$BASHRC_INI" "$rc" 2>/dev/null || return 0
  tmp=$(mktemp "${rc}.tt.XXXXXX") || return 1
  {
    awk -v i="$BASHRC_INI" '$0 == i { print; exit } { print }' "$rc"
    bashrc_bloco
    awk -v f="$BASHRC_FIM" '$0 == f { mostra = 1 } mostra { print }' "$rc"
  } >"$tmp" && mv "$tmp" "$rc"
}

configurar_bashrc() {
  local rc=$HOME/.bashrc
  if grep -qF -e "$BASHRC_INI" -e 'tt" --janela' "$rc" 2>/dev/null; then
    echo "~/.bashrc: já configurado, nada a fazer."; return 0
  fi
  [[ -f $rc ]] && cp -p "$rc" "$rc.antes-tt"
  { [[ -s $rc ]] && echo; echo "$BASHRC_INI"; bashrc_bloco; echo "$BASHRC_FIM"; } >>"$rc" || return 1
  echo "~/.bashrc: configurado (backup em ~/.bashrc.antes-tt). Abra um terminal novo para valer."
}

remover_bashrc() {
  local rc=$HOME/.bashrc
  if ! grep -qF "$BASHRC_INI" "$rc" 2>/dev/null; then
    if grep -qF 'tt" --janela' "$rc" 2>/dev/null; then echo "~/.bashrc: o trecho do tt não tem marcadores; remova-o à mão."
    else echo "~/.bashrc: nada do tt para remover."; fi
    return 0
  fi
  cp -p "$rc" "$rc.antes-tt"
  awk -v i="$BASHRC_INI" -v f="$BASHRC_FIM" '$0 == i { pula = 1; next } $0 == f { pula = 0; next } !pula' "$rc.antes-tt" >"$rc"
  echo "~/.bashrc: trecho do tt removido (backup em ~/.bashrc.antes-tt)."
}

rotulo() { [[ $1 == . ]] && echo "$MAQUINA" || rotulo_de "$1"; }

# Linhas "destino<TAB>chave<TAB>texto<TAB>busca" de uma máquina (destino "." é esta).
rotular() {
  awk -F'\t' -v d="$1" -v r="$2" '{ printf "%s\t%s\t\033[34m%-8.8s\033[0m %s\t%s %s\n", d, $1, r, $2, $3, r }'
}

listar_remoto() {
  local dest=$1 rot=$2 saida err st
  err=$(mktemp)
  saida=$(timeout 6 ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --listar" 2>"$err" </dev/null)
  st=$?
  if ((st == 0)); then
    if [[ -n $saida ]]; then rotular "$dest" "$rot" <<<"$saida"
    else printf '!nova\t\033[90m+ nenhuma sessão — Enter cria uma\033[0m\n' | rotular "$dest" "$rot"; fi
  elif grep -q 'login.tailscale.com' "$err"; then
    printf '!autorizar\t\033[33m🔒 precisa autorizar o acesso (Enter mostra o link)\033[0m\n' | rotular "$dest" "$rot"
  elif ((st == 127)); then
    printf '!instalar\t\033[90m✗ não tem o tt — Enter instala\033[0m\n' | rotular "$dest" "$rot"
  else
    printf '!erro\t\033[90m✗ sem resposta (%s)\033[0m\n' "$(tail -1 "$err" | cut -c1-50)" | rotular "$dest" "$rot"
  fi
  rm -f "$err"
}

# Estado do menu aberto (filtro de máquina, escopo da busca), num arquivo temporário por menu.
estado() { [[ -n ${TT_ESTADO:-} ]] && sed -n "s/^$1=//p" "$TT_ESTADO" 2>/dev/null | tail -1; }
estado_por() { [[ -n ${TT_ESTADO:-} ]] && echo "$1=$2" >>"$TT_ESTADO"; }
nth_atual() { [[ $(estado busca) == nomes ]] && echo 1 || echo 1,2; }

# Menu completo: esta máquina primeiro, depois as outras (consultadas em paralelo).
# Com filtro de máquina, só ela.
listar_tudo() {
  if [[ ${TT_COMX:-} == central && -z ${TT_SEM_X:-} ]]; then TT_SEM_X=1 listar_tudo | com_x; return; fi
  local tmp dest rot i=0 n filtro
  filtro=$(estado maquina)
  [[ $filtro == todas ]] && filtro=""
  tmp=$(mktemp -d)
  while read -r dest rot; do
    [[ -z $filtro || $filtro == "$rot" ]] || continue
    i=$((i + 1))
    listar_remoto "$dest" "$rot" >"$tmp/$i" &
  done < <(maquinas)
  [[ -z $filtro || $filtro == "$MAQUINA" ]] && listar | rotular . "$MAQUINA"
  wait
  for ((n = 1; n <= i; n++)); do cat "$tmp/$n"; done
  rm -rf "$tmp"
}

rotulos() { echo "$MAQUINA"; maquinas | awk '{ print $2 }'; }

# Cabeçalho do menu. Cada palavra é clicável (veja clique_cabecalho).
cabecalho() {
  local m b r linha="máquina:"
  m=$(estado maquina); m=${m:-todas}
  b=$(estado busca); b=${b:-tudo}
  for r in todas $(rotulos); do
    [[ $r == "$m" ]] && linha+=" \033[1;30;46m $r \033[0m" || linha+="  $r "
  done
  linha+="    busca:"
  for r in tudo nomes; do
    [[ $r == "$b" ]] && linha+=" \033[1;30;45m $r \033[0m" || linha+="  $r "
  done
  printf '%b\n' "$linha"
  if [[ -n ${TT_COMPACTO:-} && $(estado ajuda) != 1 ]]; then
    printf '\033[90m%s\033[0m\n' "toque abre · ? ajuda · prévia · esc sai"
    return
  fi
  [[ -n ${TT_COMPACTO:-} ]] && printf '\033[90m%s\033[0m\n' "? menos · prévia (^/) · esc sai"
  echo "⏎ entrar   ^n nova   ^r renomear   ^x fechar   ^t soltar   ^a nomear-todas"
  echo "^v ao-lado   ^o embaixo   ^p trocar-painel   ^s enviar   ^g trazer"
  echo "^f filtrar   ^e busca   ⚙ tmux…   🖥 máquinas…   esc sair"
}

# Palavra do texto que contém a coluna C (conta caracteres, não bytes; tolera a coluna vizinha).
palavra_em() {
  local t=$1 c=$2 i a b
  for i in $((c - 1)) "$c" $((c - 2)); do
    ((i >= 0 && i < ${#t})) && [[ ${t:i:1} != " " ]] && break
    i=-1
  done
  ((i >= 0)) || return
  a=$i; while ((a > 0)) && [[ ${t:a-1:1} != " " ]]; do a=$((a - 1)); done
  b=$i; while ((b < ${#t} - 1)) && [[ ${t:b+1:1} != " " ]]; do b=$((b + 1)); done
  echo "${t:a:b-a+1}"
}

# Clique numa palavra do cabeçalho (ou ^f/^e): devolve as ações do fzf a executar.
clique_cabecalho() {
  local w=$1 r m lista l c texto
  # Clique: o fzf 0.60 entrega a linha inteira (com cores) em vez da palavra; acha a palavra pela
  # coluna clicada na linha do cabeçalho.
  l=${FZF_CLICK_HEADER_LINE:-0} c=${FZF_CLICK_HEADER_COLUMN:-0}
  if ((l > 0)); then
    texto=$(cabecalho | sed -n "${l}p" | sed 's/\x1b\[[0-9;]*m//g')
    w=$(palavra_em "$texto" "$c")
  fi
  case $w in
    ⏎ | entrar) echo accept; return ;;
    ^n | nova) echo 'print(nova)+accept'; return ;;
    ^r | renomear) echo 'print(renomear)+accept'; return ;;
    ^t | soltar) echo 'print(soltar)+accept'; return ;;
    ^a | nomear-todas) echo 'print(nomear)+accept'; return ;;
    ^v | ao-lado) echo 'print(lado)+accept'; return ;;
    ^o | embaixo) echo 'print(embaixo)+accept'; return ;;
    ^p | trocar-painel) echo 'print(aqui)+accept'; return ;;
    ^s | enviar) echo 'print(enviar)+accept'; return ;;
    ^g | trazer) echo 'print(trazer)+accept'; return ;;
    ⚙ | tmux…) echo 'print(tmux)+accept'; return ;;
    🖥 | máquinas…) echo 'print(maquinas)+accept'; return ;;
    ^x | fechar) echo "execute-silent($EU --fechar {1} {2})+reload($EU --listar-tudo)"; return ;;
    esc | sair | sai) echo abort; return ;;
    tudo | nomes) estado_por busca "$w" ;;
    '?' | ajuda | menos) [[ $(estado ajuda) == 1 ]] && estado_por ajuda 0 || estado_por ajuda 1
      echo "transform-header($EU --cabecalho)"; return ;;
    prévia | 'prévia (^/)') echo toggle-preview; return ;;
    ^e | busca | busca:) [[ $(estado busca) == nomes ]] && estado_por busca tudo || estado_por busca nomes ;;
    ^f | filtrar | máquina:)
      # Próxima máquina na roda: todas → esta → as outras → todas.
      mapfile -t lista < <(echo todas; rotulos)
      m=$(estado maquina); m=${m:-todas}
      for ((r = 0; r < ${#lista[@]}; r++)); do [[ ${lista[r]} == "$m" ]] && break; done
      estado_por maquina "${lista[(r + 1) % ${#lista[@]}]}" ;;
    *)
      for r in todas $(rotulos); do [[ $w == "$r" ]] && estado_por maquina "$r"; done ;;
  esac
  echo "reload($EU --listar-tudo)+transform-header($EU --cabecalho)+change-nth($(nth_atual))"
}

q() { printf '%q ' "$@"; }

# Roda um subcomando do tt em DEST ("." = aqui). rodar_tty: interativo (pergunta algo na tela).
rodar() {
  local dest=$1; shift
  if [[ $dest == . ]]; then "$EU" "$@"
  else ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO $(q "$@")" </dev/null; fi
}
rodar_tty() {
  local dest=$1; shift
  if [[ $dest == . ]]; then "$EU" "$@"
  else ssh -t "${SSH_OPC[@]}" "$dest" "$TT_REMOTO $(q "$@")"; fi
}

previa_em() {
  local dest=$1 s=$2 qq=${3:-}
  [[ $dest == . ]] && { previa "$s" "$qq"; return; }
  case $s in
    !autorizar) echo "O Tailscale SSH desta máquina pede confirmação no navegador."
                echo "Enter mostra o link; depois de aprovar, vale por umas 12 h." ;;
    !instalar)  echo "Enter copia este tt para ~/.local/bin/tt de $dest (precisa de tmux e fzf lá)." ;;
    !nova)      echo "Enter cria uma sessão nova em $dest e entra nela." ;;
    !erro)      echo "Não consegui falar com $dest (desligada, sem rede ou sem ssh)."; echo "Saia e abra o menu de novo para tentar outra vez." ;;
    *) timeout 6 ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --previa $(q "$s" "$qq")" 2>/dev/null </dev/null ;;
  esac
}

# ^x: fecha a sessão, ou só o painel (linhas ├/└).
fechar_em() {
  local dest=$1 s=$2 cmd
  [[ $s == [+!]* || -z $s ]] && return
  [[ $s == %* ]] && cmd="kill-pane -t $(q "$s")" || cmd="kill-session -t $(q "=$s")"
  if [[ $dest == . ]]; then eval "tmux $cmd"
  else timeout 6 ssh "${SSH_OPC[@]}" "$dest" "tmux $cmd" </dev/null; fi
}

# Painel %N: deixa ele em foco na sessão dele e imprime o nome da sessão.
focar() {
  tmux select-window -t "$1" && tmux select-pane -t "$1" && tmux display-message -p -t "$1" '#{session_name}'
}

# Painel %N vira uma sessão própria (sai da janela onde está). Imprime o nome da sessão nova.
soltar_painel() {
  local p=$1 nome
  nome=$(limpar "$(tmux show-options -pqv -t "$p" @nome_painel)")
  [[ -z $nome ]] || tmux has-session -t "=$nome" 2>/dev/null && nome=$(proximo_nome)
  tmux new-session -d -s "$nome" -n tt-temp || return 1
  tmux break-pane -d -s "$p" -t "=$nome:" && tmux kill-window -t "=$nome:tt-temp" || return 1
  tmux set-option -t "=$nome:" @nome_auto "$([[ $nome == janela-* ]] && echo 1 || echo 0)"
  echo "$nome"
}

renomear_painel() {
  local p=$1 atual novo
  atual=$(tmux show-options -pqv -t "$p" @nome_painel)
  read -rep "Nome do painel: " -i "$atual" novo || return
  tmux set-option -p -t "$p" @nome_painel "$novo"
}

# Comando que mostra a sessão S (de "." = esta máquina, ou de usuario@host) num terminal/painel.
# Nas outras máquinas, o tmux de lá fica sabendo de onde veio (TT_PONTE="máquina|sessão-ponte"),
# para devolver para cá as trocas de sessão feitas pela barra de lá (veja ir_para).
cmd_ver() {
  if [[ $1 == . ]]; then echo "env -u TMUX tmux attach -t $(q "=$2")"
  else echo "ssh -t $(q "${SSH_OPC[@]}") $(q "$1") $(q "exec env TT_PONTE=$(q "$MAQUINA|${3:-}") tmux attach -t $(q "=$2")")"; fi
}

# Uma ponte não pode morrer junto com o ssh: se isso acontecia enquanto uma tela estava dentro
# dela, o tmux desconectava essa tela — e a janela do terminal fechava. Este processo fica vivo
# na sessão-ponte, mostra o erro e permite tentar novamente. Ctrl+B d continua sendo a saída
# normal da ponte.
ponte() {
  local dest=$1 s=$2 ponte=$3 st
  while true; do
    clear
    printf 'Conectando a %s:%s…\n' "$(rotulo_de "$dest")" "$s"
    ssh -t "${SSH_OPC[@]}" "$dest" \
      "exec env TT_PONTE=$(q "$MAQUINA|$ponte") tmux attach -t $(q "=$s")"
    st=$?
    printf '\n\033[33mA conexão com %s:%s terminou (código %s).\033[0m\n' "$(rotulo_de "$dest")" "$s" "$st"
    printf 'A janela foi preservada. Pressione Enter para tentar novamente ou Ctrl+B d para voltar. '
    read -r
  done
}

# Confere antes da troca se a sessão ainda existe. A checagem impede que um item fixado antigo
# mande a tela para uma ponte que já vai falhar; a função ponte acima cobre a corrida entre esta
# checagem e o attach.
sessao_remota_existe() {
  local dest=$1 s=$2
  timeout 5 ssh "${SSH_OPC[@]}" "$dest" "tmux has-session -t $(q "=$s")" </dev/null >/dev/null 2>&1
}

# Abre a sessão S num painel: modo lado | embaixo | aqui (troca o painel em foco, se for do tt).
abrir_painel() {
  local modo=$1 dest=$2 s=$3 painel=${TT_PANE:-} atual novo cmd
  if [[ -z ${TMUX:-} ]]; then
    read -rp "Painéis só funcionam dentro do tmux. Enter para voltar."
    return 1
  fi
  atual=$(tmux display-message -p ${painel:+-t "$painel"} '#{session_name}')
  if [[ $dest == . && $s == "$atual" ]]; then
    read -rp "Essa é a sessão em que você está; não dá para abri-la dentro dela mesma. Enter."
    return 1
  fi
  if [[ $dest == . ]] && fecha_ciclo "$s" "$atual"; then
    aviso_ciclo "$s" "$atual"; read -rp "Enter para voltar."
    return 1
  fi
  cmd=$(cmd_ver "$dest" "$s")
  case $modo in
    lado) novo=$(tmux split-window -h -P -F '#{pane_id}' ${painel:+-t "$painel"} "$cmd") ;;
    embaixo) novo=$(tmux split-window -v -P -F '#{pane_id}' ${painel:+-t "$painel"} "$cmd") ;;
    aqui)
      novo=$(tmux display-message -p ${painel:+-t "$painel"} '#{pane_id}')
      if [[ -z $(tmux show-options -pqv -t "$novo" @tt_painel) ]]; then
        read -rp "^p só troca painéis abertos pelo tt (^v/^o); este tem seu próprio programa. Enter."
        return 1
      fi
      tmux respawn-pane -k -t "$novo" "$cmd" ;;
  esac || return 1
  tmux set-option -p -t "$novo" @tt_painel "$dest $s"
  tmux set-option -p -t "$novo" @tt_rotulo "$(rotulo "$dest") · $s"
  tmux select-pane -t "$novo"
}

# --- Ciclos de painéis --------------------------------------------------------
#
# Um painel que mostra outra sessão é um cliente tmux do tamanho do painel, e o tmux dimensiona a
# janela pelo cliente que mexeu por último. Se A mostra B e B (direta ou indiretamente) mostra A,
# cada redesenho encolhe o painel, que encolhe a janela… até 1x1. Por isso:
#   - antes de abrir um painel ou trocar o que um painel mostra, recusa se fechar um ciclo;
#   - rede de segurança (ganchos de tamanho): vista aninhada minúscula é desligada.

# Arestas "sessão-que-contém → sessão-mostrada" desta máquina: painel cujo processo é um cliente
# tmux deste servidor.
arestas_paineis() {
  local -A sessao_do_cliente
  local pid s
  while read -r pid s; do sessao_do_cliente[$pid]=$s; done < <(tmux list-clients -F '#{client_pid} #{session_name}' 2>/dev/null)
  tmux list-panes -a -F '#{pane_pid} #{session_name}' 2>/dev/null | while read -r pid s; do
    [[ -n ${sessao_do_cliente[$pid]:-} ]] && echo "$s ${sessao_do_cliente[$pid]}"
  done
}

# A sessão que contém o painel onde o cliente C roda (vazio se C é um terminal de verdade).
contem_cliente() {
  local pid
  pid=$(do_cliente "$1" '#{client_pid}')
  [[ -n $pid ]] && tmux list-panes -a -F '#{pane_pid} #{session_name}' 2>/dev/null | awk -v p="$pid" '$1 == p { print $2; exit }'
}

# Verdadeiro se, a partir da sessão DE, seguindo os painéis, chega-se à sessão PARA.
alcanca() {
  local de=$1 para=$2
  [[ $de == "$para" ]] && return 0
  arestas_paineis | awk -v de="$de" -v para="$para" '
    { adj[$1] = adj[$1] " " $2 }
    END {
      fila[1] = de; visto[de] = 1; n = 1
      for (i = 1; i <= n; i++) {
        k = split(adj[fila[i]], viz, " ")
        for (j = 1; j <= k; j++) {
          if (viz[j] == para) { achou = 1; exit }
          if (!visto[viz[j]]++) fila[++n] = viz[j]
        }
      }
    }
    END { exit achou ? 0 : 1 }'
}

# Pôr a sessão S (desta máquina) dentro da sessão CONTAINER fecharia um ciclo?
fecha_ciclo() { [[ -n ${2:-} ]] && alcanca "$1" "$2"; }

aviso_ciclo() {
  echo "Não dá: a sessão \"$1\" já mostra (direta ou indiretamente) \"$2\", onde este painel está."
  echo "Abrir uma dentro da outra cria um ciclo, e a tela encolhe até sumir."
}

# Rede de segurança (ganchos de tamanho): desliga vistas aninhadas (clientes que rodam dentro de um
# painel: TERM tmux*/screen*) que encolheram demais — sinal de ciclo, talvez passando por outra
# máquina, que daqui não dá para ver inteiro.
guarda_tamanho() {
  local c term w h s n=0 trava="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/tt-guarda-$(id -u)"
  mkdir "$trava" 2>/dev/null || return 0 # já tem uma rodando (vários ganchos disparam juntos)
  trap 'rmdir "$trava" 2>/dev/null' RETURN
  sleep 0.2
  while read -r c term w h s; do
    [[ $term == tmux* || $term == screen* ]] || continue
    if ((w < 12 || h < 4)); then
      tmux detach-client -t "$c" && n=$((n + 1))
      echo "$(date '+%F %T') guarda: desliguei a vista aninhada $c ($w x $h, sessão $s)" >>"$HOME/.cache/tt-vigia.log"
    fi
  done < <(tmux list-clients -F '#{client_name} #{client_termname} #{client_width} #{client_height} #{session_name}' 2>/dev/null)
  ((n)) && avisar "⚠ painel fechado: ele mostrava uma sessão que mostra ele mesmo (ciclo) e estava encolhendo a tela"
  return 0
}

# Sessão-ponte local que mostra a sessão S de outra máquina (cria se não existir). Imprime o nome.
criar_ponte() {
  local dest=$1 s=$2 ponte
  ponte=$(limpar "$(rotulo_de "$dest")-$s")
  if ! tmux has-session -t "=$ponte" 2>/dev/null; then
    tmux new-session -d -s "$ponte" "$(q "$EU" --ponte "$dest" "$s" "$ponte")" || return 1
    tmux set-option -t "=$ponte:" @ponte "$dest"
    tmux set-option -t "=$ponte:" @nome_auto 0
    tmux set-option -t "=$ponte:" status off
  fi
  echo "$ponte"
}

# Entra na sessão S de outra máquina. Fora do tmux (celular), é um ssh direto e, ao sair
# (Ctrl+B d), volta ao menu. Dentro do tmux, vai para a sessão-ponte (a barra daqui some; vale a
# de lá). Ctrl+B fala com o tmux daqui; Ctrl+B Ctrl+B, com o de lá.
entrar_remoto() {
  local dest=$1 s=$2 ponte
  if [[ -z ${TMUX:-} ]]; then
    eval "$(cmd_ver "$dest" "$s")"
    return
  fi
  if ! sessao_remota_existe "$dest" "$s"; then
    tmux display-message ${TT_CLIENTE:+-c "$TT_CLIENTE"} "⚠ $(rotulo_de "$dest"):$s não existe mais ou está inacessível"
    return 1
  fi
  ponte=$(criar_ponte "$dest" "$s") || return 1
  sair_menu
  exec tmux switch-client ${TT_CLIENTE:+-c "$TT_CLIENTE"} -t "=$ponte"
}

# Formato tmux avaliado para o cliente C (display-message -c não muda o contexto do formato).
do_cliente() {
  tmux list-clients -F "#{client_name}	$2" 2>/dev/null | awk -F'\t' -v c="$1" '$1 == c { print $2; exit }'
}

# "máquina|ponte" se o cliente tmux atual é uma ponte vinda de outra máquina (vazio se não).
origem_ponte() {
  local pid
  if [[ -n ${1:-} ]]; then pid=$(do_cliente "$1" '#{client_pid}')
  else pid=$(tmux display-message -p '#{client_pid}' 2>/dev/null); fi
  [[ -n $pid ]] || return
  tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | sed -n 's/^TT_PONTE=//p'
}

# Vai para a sessão S de DEST no cliente atual. Se este cliente é uma ponte vinda de outra máquina
# (você está vendo esta máquina de lá), pede para a de lá fazer a troca: assim a tela que você
# usa troca de verdade, sem encadear ponte dentro de ponte.
ir_para() {
  local dest=$1 s=$2 origem om op
  origem=$(origem_ponte "${TT_CLIENTE:-}")
  om=${origem%%|*} op=${origem#*|}
  if [[ -n $origem && -n $op ]] && ssh "${SSH_OPC[@]}" "$(dest_de "$om")" "$TT_REMOTO --ir-ponte $(q "$op" "$(rotulo "$dest")" "$s")" </dev/null; then
    sair_menu
    return 0
  fi
  local container
  container=$( [[ -n ${TT_CLIENTE:-} ]] && contem_cliente "$TT_CLIENTE")
  if [[ -n $container && $dest == . ]] && fecha_ciclo "$s" "$container"; then
    aviso_ciclo "$s" "$container"; read -rp "Enter para voltar."
    return 1
  fi
  # Dentro do tmux sem saber qual é a tela: usa a que está nesta sessão. Se nenhuma estiver (o tt
  # rodando numa sessão sem ninguém olhando), não troca nada — o tmux escolheria uma tela qualquer.
  if [[ -n ${TMUX:-} && -z ${TT_CLIENTE:-} ]]; then
    TT_CLIENTE=$(tmux list-clients -t "$(tmux display-message -p -t "${TMUX_PANE:-}" '#{session_name}' 2>/dev/null)" -F '#{client_name}' 2>/dev/null | head -1)
    if [[ -z $TT_CLIENTE ]]; then
      echo "Nenhuma tela está nesta sessão; não troquei nada. (Use: tmux attach -t =$s)" >&2
      return 1
    fi
  fi
  if [[ $dest != . ]]; then entrar_remoto "$dest" "$s"; return; fi
  sair_menu
  if [[ -n ${TMUX:-} ]]; then exec tmux switch-client ${TT_CLIENTE:+-c "$TT_CLIENTE"} -t "=$s"; fi
  tmux attach-session -t "=$s"
}

# Roda na máquina de origem: os clientes que estão na ponte P passam a mostrar a sessão S da
# máquina de rótulo R (desta, direto; de outra, por uma ponte).
ir_ponte() {
  local p=$1 r=$2 s=$3 alvo c
  if [[ $r == "$MAQUINA" ]]; then alvo=$s
  else alvo=$(criar_ponte "$(dest_de "$r")" "$s") || return 1; fi
  for c in $(tmux list-clients -t "=$p" -F '#{client_name}'); do
    fecha_ciclo "$alvo" "$(contem_cliente "$c")" && continue
    tmux switch-client -c "$c" -t "=$alvo"
  done
}


# --- Seletor da barra (clique no nome da sessão ou numa máquina) ------------

# Lista curta desta máquina: só as sessões, "nome<TAB>texto", mais recentes primeiro.
listar_leve() {
  local ativ s anex cmd ponte uso
  tmux list-sessions -F '#{window_activity}|#{session_name}|#{session_attached}|#{pane_current_command}|#{@ponte}' 2>/dev/null |
    sort -t'|' -k1,1nr |
    {
      local -a vazias=()
      while IFS='|' read -r ativ s anex cmd ponte; do
        [[ -n $ponte ]] && continue
        if sessao_vazia "$s"; then
          ((anex > 0)) && uso='●' || uso='○'
          vazias+=("$(printf '%s\t\033[90m%s %-24.24s %-7.7s %s\033[0m' "$s" "$uso" "$s" "$cmd" "$(idade "$ativ")")")
          continue
        fi
        ((anex > 0)) && uso=$'\033[32m●\033[0m' || uso=$'\033[90m○\033[0m'
        printf '%s\t%s \033[1m%-24.24s\033[0m \033[33m%-7.7s\033[0m \033[90m%s\033[0m\n' "$s" "$uso" "$s" "$cmd" "$(idade "$ativ")"
      done
      if ((${#vazias[@]})); then
        linha_vazias "${#vazias[@]}" | cut -f1,2
        printf '%s\n' "${vazias[@]}"
      fi
    }
}

# Máquinas que entram no seletor, conforme o filtro da aba (rótulo ou "todas"): "destino rótulo".
alvos_seletor() {
  local m dest rot
  m=$(estado maquina); m=${m:-$MAQUINA}
  while read -r dest rot; do
    [[ $m == todas || $m == "$rot" ]] && echo "$dest $rot"
  done < <(echo ". $MAQUINA"; maquinas)
}

# "chave<TAB>texto" (stdin) de uma máquina → linhas do seletor "destino<TAB>chave<TAB>texto".
formatar_bloco() {
  local todas=""
  [[ $(estado maquina) == todas ]] && todas=1
  awk -F'\t' -v d="$1" -v r="$2" -v todas="$todas" -v atual="${TT_ATUAL:-}" -v fx="$(fixadas | tr '\t\n' '|\034')" '{
      marca = (r "|" $1 == atual) ? "\033[35m◆\033[0m " : "  "
      marca = marca "  "
      rot = todas ? sprintf("\033[34m%-8.8s\033[0m ", r) : ""
      printf "%s\t%s\t%s%s%s\n", d, $1, marca, rot, $2
    }'
}

# Sessões de uma máquina de fora, consultadas agora (e guardadas no cache). Se ela não responde,
# imprime a linha de erro.
bloco_vivo() {
  local dest=$1 rot=$2 saida st f
  f=$(cache_bloco "$rot")
  saida=$(timeout 4 ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --listar-leve" </dev/null 2>/dev/null)
  st=$?
  if ((st != 0)); then
    printf '!erro\t\033[90m✗ sem resposta de %s\033[0m\n' "$rot"
  elif [[ -n $saida ]]; then
    printf '%s\n' "$saida" >"$f.$$" && mv "$f.$$" "$f"
    printf '%s\n' "$saida"
  else
    rm -f "$f"
  fi
}

# Ações do fim da lista. Com uma máquina escolhida, a sessão nova nasce nela.
acoes_seletor() {
  local m nova
  m=$(estado maquina); m=${m:-$MAQUINA}
  [[ $m == todas ]] && nova=. || nova=$(dest_de "$m")
  printf '%s\t!nova\t  \033[32m＋ nova sessão em %s\033[0m\n' "${nova:-.}" "$([[ $m == todas ]] && echo "$MAQUINA" || echo "$m")"
  printf '.\t!arquivos\t  \033[33m⇅ arquivos\033[0m \033[90m(enviar / trazer entre máquinas)\033[0m\n'
  printf '.\t!tmux\t  \033[35m⚙ tmux\033[0m \033[90m(janelas, painéis, opções)\033[0m\n'
  printf '.\t!central\t  \033[36m☰ central completa\033[0m \033[90m(busca, painéis, prévia)\033[0m\n'
}

# Primeira versão da lista, sem esperar ninguém: esta máquina na hora; as outras com o que se sabia
# delas (cache) e a linha "atualizando…". A lista completa chega em seguida (reload do fzf).
lista_rapida() {
  local dest rot f
  while read -r dest rot; do
    if [[ $dest == . ]]; then listar_leve | formatar_bloco . "$rot"
    else
      f=$(cache_bloco "$rot")
      [[ -s $f ]] && formatar_bloco "$dest" "$rot" <"$f"
      printf '%s\t!erro\t  \033[90m⟳ atualizando %s…\033[0m\n' "$dest" "$rot"
    fi
  done < <(alvos_seletor)
  acoes_seletor
}
lista_rapida_salva() { lista_rapida | tee "$TT_ESTADO.lista"; }

# Linhas do seletor ("destino<TAB>chave<TAB>texto") da máquina escolhida (ou todas), com as outras
# máquinas consultadas em paralelo. No layout de baixo para cima do seletor, a primeira linha fica
# junto da barra: sessões recentes embaixo, ações (nova, central) no topo. Guarda a lista para
# pos_atual.
lista_seletor() {
  local i dest rot tmp
  local -a dests rots
  while read -r dest rot; do dests+=("$dest"); rots+=("$rot"); done < <(alvos_seletor)
  tmp=$(mktemp -d)
  for i in "${!dests[@]}"; do
    {
      if [[ ${dests[i]} == . ]]; then listar_leve; else bloco_vivo "${dests[i]}" "${rots[i]}"; fi
    } | formatar_bloco "${dests[i]}" "${rots[i]}" >"$tmp/$i" &
  done
  wait
  for ((i = 0; i < ${#dests[@]}; i++)); do cat "$tmp/$i"; done
  acoes_seletor
  rm -rf "$tmp"
}

# Ação do fzf que põe o cursor na sessão atual (◆), ou na primeira.
pos_atual() {
  local n
  [[ -e $TT_ESTADO.pos ]] && return
  : >"$TT_ESTADO.pos"
  n=$(lista_seletor_cache | grep -n $'\t.*◆' | head -1 | cut -d: -f1)
  [[ -n $n ]] && echo "pos($n)" || echo first
}
lista_seletor_cache() { cat "$TT_ESTADO.lista" 2>/dev/null; }
lista_seletor_salva() { lista_seletor | tee "$TT_ESTADO.lista"; }

cabecalho_seletor() {
  local m r linha=""
  m=$(estado maquina); m=${m:-$MAQUINA}
  for r in $(rotulos) todas; do
    [[ $r == "$m" ]] && linha+="\033[1;30;46m $r \033[0m " || linha+=" $r  "
  done
  printf '%b\n' "$linha"
  printf '\033[90m%s\033[0m\n' "clique abre · 📍 fixa · 📌 desafixa · ✕ fecha · tab: máquina · esc sai"
}

clique_seletor() {
  local w=$1 r m lista
  if ((${FZF_CLICK_HEADER_LINE:-0} == 1)); then
    w=$(palavra_em "$(cabecalho_seletor | sed -n 1p | sed 's/\x1b\[[0-9;]*m//g')" "${FZF_CLICK_HEADER_COLUMN:-0}")
  elif ((${FZF_CLICK_HEADER_LINE:-0} > 1)); then return
  fi
  if [[ $w == proxima ]]; then
    mapfile -t lista < <(rotulos; echo todas)
    m=$(estado maquina); m=${m:-$MAQUINA}
    for ((r = 0; r < ${#lista[@]}; r++)); do [[ ${lista[r]} == "$m" ]] && break; done
    w=${lista[(r + 1) % ${#lista[@]}]}
  fi
  for r in $(rotulos) todas; do
    if [[ $w == "$r" ]]; then
      estado_por maquina "$r"
      rm -f "$TT_ESTADO.pos"
      echo "reload-sync($EU --lista-rapida)+transform-header($EU --cabecalho-seletor)+reload($EU --lista-seletor)"
      return
    fi
  done
}

# O seletor em si (roda dentro do popup aberto por seletor_em).
seletor() {
  local saida dest alvo nome prev=()
  estado_por maquina "${TT_SEL_MAQ:-$MAQUINA}"
  [[ -n ${TT_PREVIA:-} ]] && prev=(--preview="$EU --previa-em {1} {2}" --preview-window='right,55%,border-left,follow')
  export TT_COMX=seletor TT_MOUSE="$TT_ESTADO.mouse"
  saida=$(lista_rapida_salva | com_x | com_mouse "$TT_MOUSE" fzf --ansi --delimiter='\t' --with-nth=3 --exact --no-sort \
    --prompt='❯ ' --pointer='▶' --info=inline-right --no-separator \
    --header="$(cabecalho_seletor)" --header-first \
    --color='bg:#282a36,fg:#f8f8f2,header:#f8f8f2,pointer:#ff79c6,prompt:#bd93f9,hl:#f1fa8c,hl+:#ffb86c,fg+:#f8f8f2,bg+:#44475a,info:#6272a4' \
    "${prev[@]}" \
    --bind="start:reload($EU --lista-seletor)" \
    --bind="load:transform($EU --pos-atual)" \
    --bind="left-click:transform($EU --clique-linha {1} {2})" \
    --bind="ctrl-x:execute-silent($EU --fechar {1} {2})+reload($EU --lista-seletor)" \
    --bind="tab:transform($EU --clique-seletor proxima)" \
    --bind="ctrl-f:execute-silent($EU --alternar-fixada {1} {2})+reload($EU --lista-seletor)" \
    --bind="click-header:transform($EU --clique-seletor x)") || return 0
  dest=$(cut -f1 <<<"$saida") alvo=$(cut -f2 <<<"$saida")
  case $alvo in
    '' | !erro) return 0 ;;
    !vazias) confirmar_vazias "$dest"; return 0 ;;
    !central) tmux run-shell -b "sleep 0.15; $EU --clique tt '${TT_CLIENTE:-}' '${TT_PANE:-}' ''"; return 0 ;;
    !tmux) tmux run-shell -b "sleep 0.15; $EU --menu-tmux '${TT_CLIENTE:-}' '${TT_PANE:-}'"; return 0 ;;
    !arquivos) tmux run-shell -b "sleep 0.15; $EU --menu-arquivos '${TT_CLIENTE:-}' '${TT_PANE:-}'"; return 0 ;;
    !nova)
      read -rp "Nome da nova sessão em $(rotulo "$dest") [automático]: " nome
      alvo=$(rodar "$dest" --nova "$nome") || return 0 ;;
  esac
  ir_para "$dest" "$alvo"
}

# Abre o seletor num popup ancorado na barra, junto do clique. M = rótulo da máquina, ou "todas".
seletor_em() {
  local c=$1 m=${2:-$MAQUINA} p=${3:-} cw ch w h x prev="" atual
  read -r cw ch < <(do_cliente "$c" '#{client_width} #{client_height}')
  if ((cw >= 140)); then w=130; prev=1; else w=$((cw < 74 ? cw : 74)); fi
  h=$((ch * 72 / 100)); ((h < 14)) && h=14; ((h > ch - 2)) && h=$((ch - 2))
  x=${TT_X:-0}
  ((x + w > cw)) && x=$((cw - w))
  atual=$(do_cliente "$c" '#{session_name}')
  tmux display-popup -c "$c" -x "$x" -y S -w "$w" -h "$h" -T " ☰ sessões " -E \
    "TT_CLIENTE=$(q "$c") TT_SEL_MAQ=$(q "$m") TT_PREVIA=$prev TT_PANE=$p TT_ATUAL=$(q "$MAQUINA|$atual") $EU --seletor"
}


# Barrinha de título dos painéis só nas janelas com 2+ painéis (chamado pelos ganchos do tmux).
bordas() {
  sleep 0.05
  tmux list-windows -a -F '#{window_id} #{window_panes} #{pane-border-status}' 2>/dev/null |
    while read -r w n atual; do
      if ((n > 1)); then [[ $atual == top ]] || tmux set-option -w -t "$w" pane-border-status top
      else [[ $atual == off ]] || tmux set-option -w -t "$w" pane-border-status off; fi
    done
}

# Confirma e fecha as vazias de DEST, poupando a sessão em uso (se for desta máquina).
confirmar_vazias() {
  local dest=$1 exceto="" r n
  [[ $dest == . && -n ${TT_CLIENTE:-} ]] && exceto=$(do_cliente "$TT_CLIENTE" '#{session_name}')
  [[ $dest == . && -z $exceto && -n ${TMUX:-} ]] && exceto=$(tmux display-message -p '#{session_name}')
  read -rp "Fechar as sessões vazias de $(rotulo "$dest")${exceto:+ (menos \"$exceto\", em uso)}? [s/N] " r
  [[ $r == [sSyY]* ]] || return 0
  n=$(rodar "$dest" --fechar-vazias "$exceto")
  echo "Fechadas: ${n:-0}."
  sleep 0.6
}

# Área de transferência do sistema para o texto da entrada (copy-command do tmux). O servidor tmux
# pode ter nascido sem o ambiente gráfico (ssh, mosh, vigia): sem WAYLAND_DISPLAY o wl-copy falhava
# calado e a seleção não chegava a lugar nenhum. Terminais que aceitam OSC 52 (Termux, Windows
# Terminal) recebem a cópia pelo próprio tmux (set-clipboard on).
copiar() {
  local t
  t=$(mktemp) || return 0
  cat >"$t"
  if command -v clip.exe >/dev/null; then # WSL: vai direto ao Windows
    clip.exe <"$t" >/dev/null 2>&1
  elif command -v wl-copy >/dev/null; then
    local run=${XDG_RUNTIME_DIR:-/run/user/$(id -u)} w=${WAYLAND_DISPLAY:-} s
    if [[ -z $w ]]; then
      for s in "$run"/wayland-*; do [[ -S $s ]] && { w=${s##*/}; break; }; done
    fi
    [[ -n $w ]] && XDG_RUNTIME_DIR=$run WAYLAND_DISPLAY=$w wl-copy <"$t" >/dev/null 2>&1
  elif command -v xclip >/dev/null; then
    DISPLAY=${DISPLAY:-:0} xclip -selection clipboard <"$t" >/dev/null 2>&1
  elif command -v termux-clipboard-set >/dev/null; then
    termux-clipboard-set <"$t" >/dev/null 2>&1
  fi
  rm -f "$t"
  return 0
}

# A janela do cliente C passa explicitamente a ter o tamanho útil da tela dele. Não basta trocar
# para a própria sessão: em algumas versões/casos o tmux trata isso como no-op e mantém o tamanho
# do último cliente. A área útil desconta todas as linhas de status (uma ou duas, conforme as
# fixadas estejam visíveis).
ajustar() {
  local c=$1 s w h status
  read -r s w h status < <(do_cliente "$c" '#{session_name} #{client_width} #{client_height} #{status}')
  [[ -n $s && $w =~ ^[0-9]+$ && $h =~ ^[0-9]+$ && $status =~ ^[0-9]+$ ]] || return 1
  h=$((h - status))
  ((h > 0)) || return 1
  tmux resize-window -t "=$s" -x "$w" -y "$h" || return 1
  tmux refresh-client -c "$c"
}


# --- Menus em popup ----------------------------------------------------------
#
# No lugar do display-menu do tmux: ele fecha quando o ponteiro se mexe fora do menu (o terminal
# relata movimento, e o tmux trata como "soltar fora"), então mal dava para chegar a um item.
# Popups não fecham assim. Itens no stdin: "tecla<TAB>rótulo<TAB>comando shell"; tecla "-" é
# separador; comando vazio deixa o item apagado. Um clique ou a tecla escolhe; Esc fecha.

menu_popup() {
  local c=$1 titulo=$2 arq w h x cw ch
  arq=$(mktemp "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/tt-menu-itens.XXXXXX")
  cat >"$arq"
  read -r cw ch < <(do_cliente "$c" '#{client_width} #{client_height}')
  cw=${cw:-80} ch=${ch:-24}
  w=$(cut -f2 "$arq" | sed 's/\x1b\[[0-9;]*m//g' | wc -L)
  w=$((w + 12)); ((w < 32)) && w=32; ((w > cw)) && w=$cw
  h=$(($(wc -l <"$arq") + 2)); ((h > ch - 1)) && h=$((ch - 1))
  x=${TT_X:-0}; ((x + w > cw)) && x=$((cw - w)); ((x < 0)) && x=0
  # display-popup volta na hora (não espera o popup): quem apaga o arquivo é o menu, depois de ler.
  tmux display-popup -c "$c" -x "$x" -y S -w "$w" -h "$h" -T " $titulo " -E "$EU --menu-popup-ui $(q "$arq")"
}

menu_popup_ui() {
  local itens binds="" i=0 k r cmd escolha
  itens=$(cat "$1"); rm -f "$1"
  while IFS=$'\t' read -r k r cmd; do
    i=$((i + 1))
    [[ ${#k} == 1 && $k =~ [[:alnum:]] && -n $cmd ]] && binds+="$k:pos($i)+accept,"
  done <<<"$itens"
  escolha=$(awk -F'\t' '{
      if ($1 == "-") printf "%d\t\033[90m%s\033[0m\n", NR, "────────────────────────"
      else if ($3 == "") printf "%d\t\033[90m %s\033[0m\n", NR, $2
      else printf "%d\t %s%s\n", NR, $2, ($1 == "" ? "" : "  \033[90m" $1 "\033[0m")
    }' <<<"$itens" |
    fzf --ansi --delimiter='\t' --with-nth=2 --no-input --no-info --no-separator --layout=reverse --no-sort \
      --pointer='▶' --color='bg:#282a36,fg:#f8f8f2,pointer:#ff79c6,fg+:#f8f8f2,bg+:#44475a' --bind='left-click:accept' \
      ${binds:+--bind="${binds%,}"} | cut -f1)
  # Esc/fora: escolha vazia. Sem esta checagem, `sed -n "p"` pegava TODAS as linhas e o menu
  # executava todas as ações de uma vez (abria janelas, desanexava a tela…).
  [[ $escolha =~ ^[0-9]+$ ]] || return 0
  cmd=$(sed -n "${escolha}p" <<<"$itens" | cut -f3)
  # Calado e sempre com sucesso: senão o tmux mostra a saída/erro por cima do painel.
  [[ -n $cmd ]] && tmux run-shell -b "sleep 0.1; ( $cmd ) >/dev/null 2>&1; true"
  return 0
}

# Tamanho dos popups grandes: tela cheia em tela pequena (celular), 90%x85% nas outras.
tam_popup() {
  local cw ch
  read -r cw ch < <(do_cliente "$1" '#{client_width} #{client_height}')
  if ((${cw:-80} < 80 || ${ch:-30} < 30)); then echo "-w 100% -h 100%"; else echo "-w 90% -h 85%"; fi
}

popup_tt() { # cliente título args… → comando que abre o tt num popup grande
  local c=$1 t=$2; shift 2
  echo "tmux display-popup -c $(q "$c") -E $(tam_popup "$c") -T $(q " $t ") $(q "$*")"
}

# Tela pequena (celular, ou janela estreita/baixa): modo compacto nos menus grandes.
compacto() { (($(tput cols 2>/dev/null || echo 80) < 80 || $(tput lines 2>/dev/null || echo 30) < 30)); }

# Menu do painel (botão ⋯, Ctrl+B m, botão direito no painel).
