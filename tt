# Menu do próprio tmux: janelas, arrumação dos painéis, opções, sessão/tela atual e os outros menus.
menu_tmux() {
  local c=$1 p=${2:-} sess win sinc mouse ed
  sess=$(do_cliente "$c" '#{session_name}')
  win=$(do_cliente "$c" '#{window_id}')
  [[ -n $p ]] || p=$(do_cliente "$c" '#{pane_id}')
  [[ $(tmux show-options -wv -t "$win" synchronize-panes) == on ]] && sinc="✓ ligado" || sinc="desligado"
  [[ $(tmux show-options -gv mouse) == on ]] && mouse="✓ ligado" || mouse="desligado"
  ed=$(editor_tt)
  menu_popup "$c" "tmux $(tmux display-message -p '#{version}') · $sess" <<ITENS
c	Nova janela nesta sessão	tmux new-window -t $(q "=$sess:") -c $(q "$(tmux display-message -p -t "$p" '#{pane_current_path}')")
n	Próxima janela	tmux next-window -t $(q "=$sess:")
b	Janela anterior	tmux previous-window -t $(q "=$sess:")
-		
1	Painéis lado a lado	tmux select-layout -t $win even-horizontal
2	Painéis empilhados	tmux select-layout -t $win even-vertical
3	Painéis em grade	tmux select-layout -t $win tiled
4	Um grande + os outros	tmux select-layout -t $win main-vertical
y	Digitar em todos os painéis: $sinc	tmux set-option -w -t $win synchronize-panes
-		
h	Rolar / copiar o histórico	tmux copy-mode -t $p
u	Mouse: $mouse	tmux set-option -g mouse
k	Ver todos os atalhos	$(popup_tt "$c" atalhos "tmux list-keys | sed 's/^bind-key *//' | less -S")
e	Editar a configuração desta máquina	$(popup_tt "$c" "~/.tmux.conf" "$ed ~/.tmux.conf && tmux source-file ~/.tmux.conf")
t	✏ Atalhos da barra…	$(popup_tt "$c" "✏ atalhos da barra" "$EU --editar-atalhos")
l	Recarregar a configuração	tmux source-file ~/.tmux.conf \; display-message -c $(q "$c") 'configuração recarregada'
-		
r	Renomear a sessão…	tmux display-popup -c $(q "$c") -E -w 70 -h 7 -T ' renomear ' $(q "$EU --renomear $(q "$sess")")
d	Desanexar esta tela	tmux detach-client -t $(q "$c")
D	Desanexar as outras telas	tmux detach-client -a -t $(q "$c")
X	Fechar a sessão…	tmux confirm-before -t $(q "$c") -p $(q "Fechar a sessão $sess? (y/n)") $(q "kill-session -t =$sess")
-		
s	☰ Sessões…	$EU --seletor-em $(q "$c") $(q "$MAQUINA") $p
a	🖥 Máquinas…	$EU --menu-maquinas $(q "$c") $p
