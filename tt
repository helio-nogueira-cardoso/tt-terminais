# Abre um arquivo NESTA máquina, no programa padrão: xdg-open (com a tela gráfica achada mesmo vindo de
# ssh ou do vigia), o Windows no WSL, termux-open no celular, open no macOS.
abrir_arquivo_local() {
  local f=${1:-} d w x
  [[ -f $f ]] || return 1
  if command -v xdg-open >/dev/null; then
    { read -r d; read -r w; read -r x; } < <(tela_grafica)
    DISPLAY=$d WAYLAND_DISPLAY=$w XDG_RUNTIME_DIR=$x setsid xdg-open "$f" >/dev/null 2>&1 </dev/null && return 0
  fi
  if command -v wslpath >/dev/null && [[ -x /mnt/c/Windows/System32/cmd.exe ]]; then
    (cd /mnt/c && /mnt/c/Windows/System32/cmd.exe /c start "" "$(wslpath -w "$f")" >/dev/null 2>&1) && return 0
  fi
  if command -v termux-open >/dev/null; then termux-open "$f" >/dev/null 2>&1 && return 0; fi
  if [[ $(uname -s 2>/dev/null) == Darwin ]] && command -v open >/dev/null; then open "$f" >/dev/null 2>&1 && return 0; fi
  echo "Não há programa para abrir; arquivo em $f"; read -rsn1 -t 5
}

# Máquina da TELA de quem pediu, como destino ssh (vazio = esta): o cliente do tmux em uso veio por uma ponte
# (TT_PONTE) ou é o do popup do e-mail aberto dentro de uma (TT_ORIGEM). Mesma regra dos links (abrir_na_tela).
dest_da_tela() {
  local c om d
  c=${TT_LINK_CLIENTE:-}; [[ -n $c || -z ${TMUX:-} ]] || c=$(cliente_externo 2>/dev/null)
  om=$(maquina_da_tela "$c"); [[ -n $om ]] || return 0
  d=$(dest_ir "$om"); [[ -n $d && $d != . ]] && printf '%s\t%s\t%s\n' "$d" "$om" "$c"
  return 0
}

# Anexo (ou imagem) do e-mail: abre na máquina da TELA, não na da sessão. Vendo pelo book-hl o e-mail do PC, o PDF
# abre no book-hl. O arquivo segue por ssh (o aerc apaga o temporário assim que o abridor sai: a cópia vai antes) e a
# de lá o guarda em ~/.cache/tt-anexos/abertos e abre no programa padrão dela. Sem resposta (ou versão sem
# --abrir-recebido): abre aqui, como antes, e avisa.
abrir_anexo() {
  local f=${1:-} t d om c nome
  [[ -f $f ]] || return 1
  if [[ -z ${TT_ABRIR_AQUI:-} ]]; then
    t=$(dest_da_tela)
    if [[ -n $t ]]; then
      IFS=$'\t' read -r d om c <<<"$t"; nome=${f##*/}
      [[ -n $c ]] && tmux display-message -c "$c" -d 2500 "📎 abrindo $nome em $om" 2>/dev/null
      timeout 120 ssh "${SSH_OPC[@]}" "$d" "$TT_REMOTO --abrir-recebido $(q "$nome")" <"$f" >/dev/null 2>&1 && return 0
      [[ -n $c ]] && tmux display-message -c "$c" -d 5000 "📎 $om não respondeu: abri $nome nesta máquina" 2>/dev/null
    fi
  fi
  abrir_arquivo_local "$f"
}

# Lado de lá do abrir_anexo: o conteúdo vem pela entrada padrão; guarda com o nome (sem barras) numa pasta
# própria de ~/.cache/tt-anexos/abertos (as de mais de 1 dia somem) e abre aqui.
abrir_recebido() {
  local nome=${1:-anexo} base="$HOME/.cache/tt-anexos/abertos" dir
  nome=${nome//\//_}; [[ -n $nome && $nome != . && $nome != .. ]] || nome=anexo
  mkdir -p "$base" && find "$base" -mindepth 1 -maxdepth 1 -type d -mtime +1 -exec rm -rf {} + 2>/dev/null
  dir=$(mktemp -d "$base/$(date +%Y%m%d-%H%M%S)-XXXX") || return 1
  cat >"$dir/$nome" || return 1
  TT_ABRIR_AQUI=1 abrir_arquivo_local "$dir/$nome" </dev/null
}

# S no e-mail: o anexo escolhido (o aerc o salvou em ~/.cache/tt-anexos/salvar) vai para a máquina da TELA, na pasta
# de recebidos dela (cópia em segundo plano, a barra mostra). Vendo desta máquina: pergunta a pasta (Tab completa),
# começando pela de recebidos daqui. Nada é sobrescrito: repetido vira "nome (2)".
anexo_salvar() {
  local base="$HOME/.cache/tt-anexos" lote t d om c ddst destino n alvo i
  local -a nomes=()
  [[ -d $base/salvar && -n $(ls -A "$base/salvar" 2>/dev/null) ]] || { echo "Nada para salvar: escolha o anexo com Ctrl+j / Ctrl+k e aperte S."; read -rsn1 -t 4; return 0; }
  lote=$(mktemp -d "$base/$(date +%Y%m%d-%H%M%S)-salvar-XXXX") || return 1
  mv "$base/salvar/"* "$base/salvar/".[!.]* "$lote/" 2>/dev/null; rmdir "$base/salvar" 2>/dev/null
  mapfile -t nomes < <(cd "$lote" && ls -1A)
  ((${#nomes[@]})) || { rm -rf "$lote"; return 0; }
  t=$(dest_da_tela)
  if [[ -n $t ]]; then
    IFS=$'\t' read -r d om c <<<"$t"
    if ddst=$(timeout 20 ssh "${SSH_OPC[@]}" "$d" "$TT_REMOTO --pasta-recebidos" </dev/null 2>/dev/null) && [[ -n $ddst ]]; then
      echo "📎 salvando ${nomes[*]} em $om ($ddst)"
      transferir . "$(encurtar "$lote")" "$d" "$ddst" "${nomes[@]}"
      return 0
    fi
    echo "$om não respondeu: salvo nesta máquina."
  fi
  destino=$(expandir "$(pasta_recebidos)")
  if [[ -t 0 ]]; then read -r -e -p "Salvar em: " -i "$destino/" destino || { rm -rf "$lote"; return 0; }
  else IFS= read -r destino || true; [[ -n $destino ]] || destino=$(expandir "$(pasta_recebidos)"); fi
  destino=$(expandir "${destino%/}"); mkdir -p "$destino" || { echo "Não consegui criar $destino"; read -rsn1 -t 4; return 1; }
  for n in "${nomes[@]}"; do
    alvo="$destino/$n"; i=2
    while [[ -e $alvo ]]; do
      if [[ $n == ?*.* ]]; then alvo="$destino/${n%.*} ($i).${n##*.}"; else alvo="$destino/$n ($i)"; fi
      i=$((i + 1))
    done
    mv "$lote/$n" "$alvo" && echo "✔ $alvo"
  done
  rm -rf "$lote"; sleep 1
}

imagens_do_email() {
  local base="$HOME/.cache/tt-imagens" dir lista esc tipo alvo rot arq n=0 py="$DIR_TT/email-tt.py"
  mkdir -p "$base"; find "$base" -mindepth 1 -maxdepth 1 -type d -mtime +1 -exec rm -rf {} + 2>/dev/null
  dir=$(mktemp -d "$base/XXXXXX") || return 1
  lista=$(python3 -I "$py" imagens "$dir") || { echo "Não consegui ler a mensagem."; read -rsn1 -t 3; return 1; }
  [[ -n $lista ]] || { echo "Esta mensagem não tem imagens."; rm -rf "$dir"; read -rsn1 -t 2; return 0; }
  if command -v fzf >/dev/null; then
    esc=$(awk -F'\t' '{ printf "%s\t%s\t%s\n", $1, $2, ($1=="arq" ? "📎 " : "🌐 ") $3 }' <<<"$lista" |
      fzf --multi --delimiter='\t' --with-nth=3 --layout=reverse --height=~20 --border=rounded \
        --border-label=' 🖼 imagens do e-mail (Tab marca · ⏎ abre · Esc sai) ' --prompt='❯ ' --pointer='▶' --marker='✔') || { rm -rf "$dir"; return 0; }
  else esc=$(awk -F'\t' '{print $1 "\t" $2 "\t" $3}' <<<"$lista" | head -1); fi
  [[ -n $esc ]] || { rm -rf "$dir"; return 0; }
  while IFS=$'\t' read -r tipo alvo rot; do
    n=$((n + 1))
    if [[ $tipo == url ]]; then
      arq="$dir/web-$n"
      echo "⬇ baixando ${alvo:0:80}…"
      python3 -I "$py" baixar-imagem "$alvo" "$arq" || { read -rsn1 -t 4; continue; }
      case $(file -b --mime-type "$arq") in
        image/png) mv "$arq" "$arq.png"; arq+=.png ;; image/jpeg) mv "$arq" "$arq.jpg"; arq+=.jpg ;;
        image/gif) mv "$arq" "$arq.gif"; arq+=.gif ;; image/webp) mv "$arq" "$arq.webp"; arq+=.webp ;;
        image/svg+xml) mv "$arq" "$arq.svg"; arq+=.svg ;; *) mv "$arq" "$arq.img"; arq+=.img ;;
      esac
    else arq=$alvo; fi
    abrir_imagem "$arq"
  done <<<"$esc"
}

# Anexos de um e-mail → pasta de recebidos de uma máquina do tt. A tecla E do aerc salva os anexos
# da mensagem aberta em ~/.cache/tt-anexos/atual e abre isto: marca quais, escolhe a máquina no
# mesmo seletor do ⇅ arquivos, e a cópia segue em segundo plano (barra mostra o andamento).
anexos_enviar() {
  local base="$HOME/.cache/tt-anexos" lote dst ddst escolha
  local -a nomes=()
  # lotes velhos (enviados há mais de 1 dia) somem
  find "$base" -mindepth 1 -maxdepth 1 -type d ! -name atual -mtime +1 -exec rm -rf {} + 2>/dev/null
  [[ -d $base/atual && -n $(ls -A "$base/atual" 2>/dev/null) ]] || { echo "Esta mensagem não tem anexos."; read -rsn1 -t 3; return 0; }
  lote="$base/$(date +%Y%m%d-%H%M%S)"; mv "$base/atual" "$lote"
  escolha=$(cd "$lote" && ls -1 | fzf --multi --bind 'start:select-all' --layout=reverse --height=~20 --border=rounded \
    --border-label=' 📎 anexos para enviar (Tab marca/desmarca · ⏎ segue) ' --prompt='❯ ' --pointer='▶' --marker='✔' \
    --preview 'f={}; printf "%s\n%s\n" "$(du -h "$f" | cut -f1)" "$(file -b "$f" 2>/dev/null)"' --preview-window=down,3) || { rm -rf "$lote"; return 0; }
  mapfile -t nomes <<<"$escolha"; ((${#nomes[@]})) || { rm -rf "$lote"; return 0; }
  local tela; tela=$(dest_da_tela); tela=${tela%%$'\t'*}
  dst=$(escolher_maquina "📤 enviar ${#nomes[@]} anexo(s) para" "" "$tela") || { rm -rf "$lote"; return 0; }
  [[ -n $dst ]] || { rm -rf "$lote"; return 0; }
  ddst=$(rodar "$dst" --pasta-recebidos)
  transferir . "$(encurtar "$lote")" "$dst" "$ddst" "${nomes[@]}"
}

# Tela de atalhos do aerc em português, por assunto (cada um com o seu ícone); Esc ou q fecha.
EMAIL_ATALHOS_ICONES=(Ler 📖 Organizar 📂 Responder 💬 Encontrar 🔍 Anexos 📎 Várias 📑 Escrever 📝 Contas 👤 Ajuda 💡)
email_atalhos() {
  local lista cat tecla desc ic i; local -A icone=()
  lista=$(cat <<'AT'
Ler	Enter  ou  botão 📖	abrir a mensagem
Ler	Esc	voltar: fecha a mensagem; na lista, limpa filtro/busca ou esconde o e-mail
Ler	q	fechar a mensagem; na lista, esconder o e-mail na hora
Ler	Ctrl+q	encerrar o e-mail de verdade (a próxima abertura reconecta)
Ler	Ctrl+s  ou  botão ⟳	sincronizar agora: consulta as contas sem esperar o vigia (útil esperando um código)
Ler	j / k  ou  setas	mensagem seguinte / anterior
Ler	J / K	pasta seguinte / anterior
Ler	Tab	recolher / abrir a conversa
Organizar	u	marcar como lida ↔ não lida
