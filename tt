# Imagens de um e-mail. O HTML do leitor não mostra imagens; a tecla i (na mensagem aberta) manda a
# mensagem crua para tt --imagens: lista as imagens anexadas/embutidas (cid:) e as da web (<img>) e
# abre as escolhidas no visualizador do sistema. Imagens da web só são baixadas se escolhidas
# (nada de pixel de rastreamento ao abrir o e-mail). Tab marca várias.
abrir_imagem() {
  local f=${1:-}
  [[ -f $f ]] || return 1
  if command -v xdg-open >/dev/null; then setsid xdg-open "$f" >/dev/null 2>&1 </dev/null && return 0; fi
  if command -v wslpath >/dev/null && [[ -x /mnt/c/Windows/System32/cmd.exe ]]; then
    (cd /mnt/c && /mnt/c/Windows/System32/cmd.exe /c start "" "$(wslpath -w "$f")" >/dev/null 2>&1) && return 0
  fi
  if command -v termux-open >/dev/null; then termux-open "$f" >/dev/null 2>&1 && return 0; fi
  echo "Sem visualizador de imagens; arquivo em $f"; read -rsn1 -t 5
}

imagens_do_email() {
  local base="$HOME/.cache/tt-imagens" dir lista esc tipo alvo rot arq n=0 py="$DIR_TT/email-tt.py"
  mkdir -p "$base"; find "$base" -mindepth 1 -maxdepth 1 -type d -mtime +1 -exec rm -rf {} + 2>/dev/null
  dir=$(mktemp -d "$base/XXXXXX") || return 1
  lista=$(python3 -I "$py" imagens "$dir") || { echo "Não consegui ler a mensagem."; read -rsn1 -t 3; return 1; }
  [[ -n $lista ]] || { echo "Esta mensagem não tem imagens."; rm -rf "$dir"; read -rsn1 -t 2; return 0; }
  if command -v fzf >/dev/null; then
    esc=$(awk -F'\t' '{ printf "%s\t%s\t%s\n", $1, $2, ($1=="arq" ? "📎 " : "🌐 ") $3 }' <<<"$lista" |
      fzf --multi --delimiter='\t' --with-nth=3 --layout=reverse --height=~20 --border=rounded \
        --border-label=' 🖼 imagens do e-mail (Tab marca · ⏎ abre · Esc sai) ' --prompt='❯ ' --pointer='▶' --marker='✔') || { rm -rf "$dir"; return 0; }
  else esc=$(awk -F'\t' '{print $1 "\t" $2 "\t" $3}' <<<"$lista" | head -1); fi
  [[ -n $esc ]] || { rm -rf "$dir"; return 0; }
  while IFS=$'\t' read -r tipo alvo rot; do
    n=$((n + 1))
    if [[ $tipo == url ]]; then
      arq="$dir/web-$n"
      echo "⬇ baixando ${alvo:0:80}…"
      python3 -I "$py" baixar-imagem "$alvo" "$arq" || { read -rsn1 -t 4; continue; }
      case $(file -b --mime-type "$arq") in
        image/png) mv "$arq" "$arq.png"; arq+=.png ;; image/jpeg) mv "$arq" "$arq.jpg"; arq+=.jpg ;;
        image/gif) mv "$arq" "$arq.gif"; arq+=.gif ;; image/webp) mv "$arq" "$arq.webp"; arq+=.webp ;;
        image/svg+xml) mv "$arq" "$arq.svg"; arq+=.svg ;; *) mv "$arq" "$arq.img"; arq+=.img ;;
      esac
    else arq=$alvo; fi
    abrir_imagem "$arq"
  done <<<"$esc"
}

# Anexos de um e-mail → pasta de recebidos de uma máquina do tt. A tecla E do aerc salva os anexos
# da mensagem aberta em ~/.cache/tt-anexos/atual e abre isto: marca quais, escolhe a máquina no
# mesmo seletor do ⇅ arquivos, e a cópia segue em segundo plano (barra mostra o andamento).
anexos_enviar() {
  local base="$HOME/.cache/tt-anexos" lote dst ddst escolha
  local -a nomes=()
  # lotes velhos (enviados há mais de 1 dia) somem
  find "$base" -mindepth 1 -maxdepth 1 -type d ! -name atual -mtime +1 -exec rm -rf {} + 2>/dev/null
  [[ -d $base/atual && -n $(ls -A "$base/atual" 2>/dev/null) ]] || { echo "Esta mensagem não tem anexos."; read -rsn1 -t 3; return 0; }
  lote="$base/$(date +%Y%m%d-%H%M%S)"; mv "$base/atual" "$lote"
  escolha=$(cd "$lote" && ls -1 | fzf --multi --bind 'start:select-all' --layout=reverse --height=~20 --border=rounded \
    --border-label=' 📎 anexos para enviar (Tab marca/desmarca · ⏎ segue) ' --prompt='❯ ' --pointer='▶' --marker='✔' \
    --preview 'f={}; printf "%s\n%s\n" "$(du -h "$f" | cut -f1)" "$(file -b "$f" 2>/dev/null)"' --preview-window=down,3) || { rm -rf "$lote"; return 0; }
  mapfile -t nomes <<<"$escolha"; ((${#nomes[@]})) || { rm -rf "$lote"; return 0; }
  dst=$(escolher_maquina "📤 enviar ${#nomes[@]} anexo(s) para") || { rm -rf "$lote"; return 0; }
  [[ -n $dst ]] || { rm -rf "$lote"; return 0; }
  ddst=$(rodar "$dst" --pasta-recebidos)
  transferir . "$(encurtar "$lote")" "$dst" "$ddst" "${nomes[@]}"
}

