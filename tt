# Fixa ou desafixa a sessão S da máquina de rótulo R. Ao fixar uma sessão daqui, o vigia para de
# renomeá-la (senão o item da barra ficaria apontando para um nome que sumiu).
alternar_fixada() {
  local r=$1 s=$2 id="" d
  mkdir -p "$CONF_DIR"; touch "$CONF_FIX"
  # O identificador de uma sessão de outra máquina é pedido antes da trava (ssh pode demorar).
  if [[ $r != "$MAQUINA" ]] && ! awk -F'\t' -v r="$r" -v s="$s" '$1 == r && $2 == s { f=1 } END { exit !f }' "$CONF_FIX"; then
    d=$(dest_de "$r")
    [[ -n $d ]] && id=$(timeout 5 ssh "${SSH_OPC[@]}" "$d" "$TT_REMOTO --session-id $(q "$s")" </dev/null 2>/dev/null)
  fi
  travar_fixadas || return 1
  if awk -F'\t' -v r="$r" -v s="$s" '$1 == r && $2 == s { found=1 } END { exit !found }' "$CONF_FIX"; then
    awk -F'\t' -v r="$r" -v s="$s" '$1 != r || $2 != s' "$CONF_FIX" >"$CONF_FIX.novo"; mv "$CONF_FIX.novo" "$CONF_FIX"
    echo "desafixada"
  else
    [[ $r == "$MAQUINA" ]] && id=$(session_id "$s")
    printf '%s\t%s\t%s\n' "$r" "$s" "$id" >>"$CONF_FIX"
    # A marca fica dentro da sessão. Se ela for renomeada fora do tt, conseguimos achar a
    # mesma sessão pelo marcador e corrigir o nome mostrado na barra.
    if [[ $r == "$MAQUINA" ]]; then
      tmux set-option -t "=$s:" @nome_auto 0 \; set-option -t "=$s:" @tt_fixado_nome "$s" 2>/dev/null
    else
      d=$(dest_de "$r")
      [[ -n $d ]] && timeout 5 ssh "${SSH_OPC[@]}" "$d" "$PATH_REMOTO tmux set-option -t $(q "=$s:") @nome_auto 0; tmux set-option -t $(q "=$s:") @tt_fixado_nome $(q "$s")" </dev/null >/dev/null 2>&1
    fi
    echo "fixada"
  fi
  marcar_fixadas
  destravar_fixadas
  aplicar_fixadas
  propagar_fixadas
}

# ✕ de um item da faixa de fixadas: desafixa a sessão identificada pela chave estável.
desafixar_item() {
  local c=$1 chave=${2#fxx} r s id k
  while IFS=$'\t' read -r r s id; do
    fixada_chave_em k "$r" "$s" "$id"
    [[ $k == "$chave" ]] && break
    r=""; s=""
  done < <(fixadas)
  [[ -n $s ]] || return 0
  # Só remove, nunca alterna: o ✕ dispara no apertar e no soltar e, num toque lento (> 0,5 s), os
  # dois rodam juntos; com alternar, o segundo achava a sessão já fora da lista e fixava de novo.
  remover_fixada "$r" "$s" "$id"
  tmux display-message -c "$c" -d 2500 "📌 desafixada: $([[ $r == "$MAQUINA" ]] && echo "$s" || echo "$r:$s")"
}

# Tira da lista a fixada de R com nome S ou identificador ID (o nome pode ter mudado num rename entre
# o clique e a trava). Idempotente: se já saiu, não faz nada.
remover_fixada() {
  local r=$1 s=$2 id=${3:-}
  [[ -f $CONF_FIX ]] || return 0
  travar_fixadas || return 1
  if ! awk -F'\t' -v r="$r" -v s="$s" -v id="$id" '$1 == r && ($2 == s || (id != "" && $3 == id)) { f = 1 } END { exit !f }' "$CONF_FIX"; then
    destravar_fixadas; return 0
  fi
  awk -F'\t' -v r="$r" -v s="$s" -v id="$id" '!($1 == r && ($2 == s || (id != "" && $3 == id)))' "$CONF_FIX" >"$CONF_FIX.novo"
  mv "$CONF_FIX.novo" "$CONF_FIX"
  marcar_fixadas
  destravar_fixadas
  aplicar_fixadas
  propagar_fixadas
}

# Pino ao lado do nome da sessão, na barra (mesma convenção do seletor): 📍 = não fixada, o clique
# fixa; 📌 = fixada, o clique desafixa.
fixar_atual() {
  local c=$1 s alvo dest nome rot r
  IFS=$'\x1f' read -r s alvo <<<"$(do_cliente "$c" $'#{session_name}\x1f#{@ponte_alvo}')"
  [[ -n $s ]] || return 0
  rot=$MAQUINA nome=$s
  # Numa sessão de PONTE o pino vale para a sessão real da outra máquina (@ponte_alvo = "destino|sessão lá"): fixar a
  # ponte não adiantava, o vigia a encerra por ociosidade e o reconciliador apagava a fixada da lista.
  if [[ -n $alvo && ${alvo%%|*} != . && -n ${alvo#*|} ]]; then
    dest=${alvo%%|*}; r=$(rotulo_de "$dest")
    # Rótulo que não está no cadastro (rotulo_de devolve o próprio destino): não há como falar com a máquina.
    [[ $r != "$dest" ]] && { rot=$r; nome=${alvo#*|}; }
  fi
  r=$(alternar_fixada "$rot" "$nome")
  tmux display-message -c "$c" -d 2500 "$([[ $r == fixada ]] && echo 📌 || echo 📍) $([[ $rot == "$MAQUINA" ]] && echo "$nome" || echo "$rot:$nome") $r$([[ $r == fixada ]] && echo " — aparece na faixa das fixadas em todas as máquinas; o ✕ dela desafixa")"
}

# Sessão daqui renomeada: o item fixado acompanha.
fixada_renomeada() {
  [[ -f $CONF_FIX ]] || return 0
  travar_fixadas || return 0
  awk -F'\t' -v r="$MAQUINA" -v a="$1" -v n="$2" 'BEGIN { OFS = "\t" } $1 == r && $2 == a { $2 = n; mudou = 1 } { print } END { exit !mudou }' "$CONF_FIX" >"$CONF_FIX.novo" || { rm -f "$CONF_FIX.novo"; destravar_fixadas; return 0; }
  mv "$CONF_FIX.novo" "$CONF_FIX"
  marcar_fixadas
  destravar_fixadas
  tmux set-option -t "=$2:" @tt_fixado_nome "$2" 2>/dev/null
  aplicar_fixadas
  propagar_fixadas
}

# Confere periodicamente os itens fixados. Uma máquina sem resposta é preservada (ela pode
# estar desligada); uma sessão comprovadamente inexistente é desafixada. A marca @tt_fixado_nome
# também permite acompanhar um rename feito diretamente pelo tmux ou por outro programa.
# Resposta de outra máquina sobre uma fixada (para reconciliar_fixadas): grava "status<TAB>resposta".
resolver_fixada_em() { # arq dest sessão id
  local r st
  r=$(timeout 6 ssh "${SSH_OPC[@]}" "$2" "$TT_REMOTO --resolver-fixada $(q "$3") $(q "$4")" </dev/null 2>/dev/null)
  st=$?
  printf '%s\t%s\n' "$st" "$r" >"$1"
}
# Registro de tudo que tira uma fixada da lista (e de listas recebidas que a encolhem): sem ele não há como
# saber quando nem por que uma aba fixada sumiu. ~/.cache/tt-fixadas.log, cortado a 500 linhas.
fixadas_log() {
  local f=$HOME/.cache/tt-fixadas.log
  { mkdir -p "$HOME/.cache"; echo "$(date '+%F %T') $*" >>"$f"
    (($(wc -l <"$f") > 1000)) && { tail -n 500 "$f" >"$f.novo"; mv "$f.novo" "$f"; }; } 2>/dev/null
  return 0
}

# Fixada local sem sessão: só conta como fechada se o tmux respondeu e a ausência se repetiu em duas
# conferências seguidas (marca em $RT); fechar pelo tt (TT_RECONC_IMEDIATO=1) confirma na hora.
# Imprime "fechada" quando pode remover; senão, o motivo de preservar.
fixada_ausente_confirma() { # chave
  local m=$RT/tt-fixada-ausente-$1
  if [[ ${TT_RECONC_IMEDIATO:-} == 1 ]]; then rm -f "$m"; echo fechada; return 0; fi
  if [[ -e $m ]]; then rm -f "$m"; echo fechada; return 0; fi
  : >"$m"; echo aguardando-2a-conferencia
}

reconciliar_fixadas() {
  local -a pids=()
  [[ -f $CONF_FIX ]] || return 0
  local tmp r s id d resposta st mudou=0 novo novo_id v0 k dir tmux_vivo=1 conf
  # Sem resposta do tmux (servidor fora do ar, versão incompatível) nada local é prova de fechamento.
  tmux list-sessions -F '#{session_name}' >/dev/null 2>&1 || tmux_vivo=0
  local -a FX=() DS=()
  v0=$(versao_fixadas)
  tmp=$(mktemp "$CONF_FIX.XXXXXX") || return 1
  dir=$(mktemp -d "$RT/tt-reconc.XXXXXX") || { rm -f "$tmp"; return 1; }
  mapfile -t FX < <(fixadas)
  # As outras máquinas respondem todas ao mesmo tempo (antes, uma fixada por vez): a conferência leva o
  # tempo da mais lenta, e a janela em que a lista pode mudar no meio fica menor.
  for k in "${!FX[@]}"; do
    IFS=$'\t' read -r r s id <<<"${FX[k]}"
    [[ -n $r && -n $s && $r != "$MAQUINA" ]] || continue
    DS[k]=$(dest_de "$r")
    [[ -n ${DS[k]} ]] && resolver_fixada_em "$dir/$k" "${DS[k]}" "$s" "$id" & pids+=($!)
  done
  esperar ${pids[@]+"${pids[@]}"}
  for k in "${!FX[@]}"; do
    IFS=$'\t' read -r r s id <<<"${FX[k]}"
    [[ -n $r && -n $s ]] || continue
    novo=$s
    if [[ $r == "$MAQUINA" ]]; then
      # Primeiro resolve pelo UUID. O nome antigo pode ter sido reutilizado por outra sessão.
      if [[ -n $id ]]; then novo=$(session_by_id "$id"); fi
      if [[ -n $novo ]]; then
        opt_sessao "$novo" @tt_fixado_nome "$novo"
        novo_id=$(session_id "$novo")
      elif tmux has-session -t "=$s" 2>/dev/null; then
        # Também migra itens fixados de versões antigas para o marcador de identidade.
        novo=$s
        opt_sessao "$s" @tt_fixado_nome "$s"
        novo_id=$(session_id "$s")
      else
        novo=$(tmux list-sessions -F "#{session_name}"$'\t'"#{@tt_fixado_nome}" 2>/dev/null |
          awk -F'\t' -v antigo="$s" '$2 == antigo { print $1; exit }')
        [[ -n $novo ]] && novo_id=$(session_id "$novo")
      fi
      # Sem sessão e sem marca correspondente: ela foi fechada (se o tmux respondeu e a ausência se confirmou).
      if [[ -z $novo ]]; then
        if ((! tmux_vivo)); then
          fixadas_log "preservada $r:$s ($id): tmux sem resposta, nada removido"
        else
          conf=$(fixada_ausente_confirma "$(fixada_chave "$r" "$s" "$id")")
          if [[ $conf == fechada ]]; then
            fixadas_log "removida $r:$s ($id): sessão não existe mais neste tmux (via ${FUNCNAME[1]:-?})"
            mudou=1; continue
          fi
          fixadas_log "preservada $r:$s ($id): ausente, $conf"
        fi
        printf '%s\t%s\t%s\n' "$r" "$s" "$id" >>"$tmp"; continue
      fi
      rm -f "$RT/tt-fixada-ausente-$(fixada_chave "$r" "$s" "$id")"
    else
      d=${DS[k]:-}
      # Rótulo desconhecido ou máquina inacessível não é evidência de fechamento.
      [[ -n $d ]] || { printf '%s\t%s\t%s\n' "$r" "$s" "$id" >>"$tmp"; continue; }
      st=1 resposta=""
      [[ -r $dir/$k ]] && { ler_arquivo resposta "$dir/$k"; st=${resposta%%$'\t'*}; resposta=${resposta#*$'\t'}; }
      [[ $st == 0 ]] || { printf '%s\t%s\t%s\n' "$r" "$s" "$id" >>"$tmp"; continue; }
      novo=${resposta%%$'\t'*}; novo_id=${resposta#*$'\t'}
      [[ -n $novo ]] || { fixadas_log "removida $r:$s ($id): a máquina respondeu sem a sessão"; mudou=1; continue; }
    fi
    [[ $novo == "$s" && $novo_id == "$id" ]] || mudou=1
    printf '%s\t%s\t%s\n' "$r" "$novo" "$novo_id" >>"$tmp"
  done
  rm -rf "$dir"
  # A conferência consulta outras máquinas e leva segundos. Se a lista mudou nesse meio-tempo
  # (fixou/desafixou aqui, ou chegou uma mais nova), esta conferência ficou velha: descarta e a
  # próxima volta do vigia confere de novo. Nunca grava por cima de uma mudança mais recente.
  if ((mudou)) && travar_fixadas; then
    if [[ $(versao_fixadas) == "$v0" ]]; then
      mv "$tmp" "$CONF_FIX"; marcar_fixadas; destravar_fixadas
      aplicar_fixadas
      propagar_fixadas
    else
      destravar_fixadas; rm -f "$tmp"
    fi
  else
    rm -f "$tmp"
  fi
}

# Conteúdo da 2ª linha (chamado pela barra, por sessão: destaca a sessão atual).
# Largura de exibição (colunas de tela) de um texto simples, como o tmux conta: emoji e CJK valem 2.
# Resultado em W (sem subshell: é chamada muitas vezes ao montar a faixa).
tt_largura() {
  local t=$1 i cp n resto LC_ALL=C
  # Cada caractere vale 1; só os não ASCII (poucos) são conferidos um a um, para somar 1 aos largos.
  # Tirar os bytes ASCII no locale C é rápido e não parte caractere nenhum (byte ASCII nunca está no meio
  # de um caractere UTF-8).
  resto=${t//[$'\x01'-$'\x7f']/}
  [[ -z $resto ]] && { W=${#t}; return 0; }
  LC_ALL=$TT_UTF8; n=${#t}
  for ((i = 0; i < ${#resto}; i++)); do
    printf -v cp '%d' "'${resto:i:1}"
    if ((cp >= 0x1100 && (cp <= 0x115f || (cp >= 0x2e80 && cp <= 0xa4cf) || (cp >= 0xac00 && cp <= 0xd7a3) ||
        (cp >= 0xf900 && cp <= 0xfaff) || (cp >= 0xfe30 && cp <= 0xfe4f) || (cp >= 0xff00 && cp <= 0xff60) ||
        (cp >= 0xffe0 && cp <= 0xffe6) || (cp >= 0x1f300 && cp <= 0x1faff) || cp >= 0x20000))); then n=$((n + 1)); fi
  done
  W=$n
}

# Abrevia um nome de sessão para caber em N colunas, POR PALAVRAS (separadas por - _ . ou espaço):
# encurta primeiro a palavra mais longa, mantendo o começo de cada uma (nunca abaixo de 2 letras;
# números ficam inteiros), e só no fim corta com "…". "confere-maquinas-futuro" em 12 vira
# "con-maq-futu" — o fim do nome continua lá, ao contrário de cortar à direita.
fixada_abrev() { # texto n -> A
  local t=$1 n=$2 i maior lm tot k=$1$'\x1f'$2 ult manter
  # Memória por (nome, largura) enquanto a faixa é montada (quem chama declara FX_ABREV e FX_MEMO=1).
  if [[ ${FX_MEMO:-} == 1 && -n ${FX_ABREV[$k]+x} ]]; then A=${FX_ABREV[$k]}; return 0; fi
  if ((${#t} <= n)); then A=$t
  else
    local -a pal=() sep=()
    while [[ -n $t ]]; do
      if [[ $t =~ ^([^-_.\ ]*)([-_.\ ]*)(.*)$ ]]; then pal+=("${BASH_REMATCH[1]}"); sep+=("${BASH_REMATCH[2]}"); t=${BASH_REMATCH[3]}
      else pal+=("$t"); sep+=(""); t=""; fi
    done
    tot=${#1}
    while ((tot > n)); do
      maior=-1; lm=2
      for i in "${!pal[@]}"; do
        [[ ${pal[i]} == *[!0-9]* ]] || continue        # números ficam inteiros
        ((${#pal[i]} > lm)) && { lm=${#pal[i]}; maior=$i; }
      done
      ((maior < 0)) && break
      pal[maior]=${pal[maior]:0:$((lm - 1))}; tot=$((tot - 1))
    done
    A=""; for i in "${!pal[@]}"; do A+="${pal[i]}${sep[i]}"; done
    # Nem por palavras coube: guarda o começo e a ÚLTIMA palavra (o que costuma distinguir).
    if ((${#A} > n)); then
      ult=${pal[-1]}; manter=$((n - 1 - ${#ult}))
      if ((${#pal[@]} > 1 && manter >= 2)); then A="${A:0:manter}…$ult"; else A="${A:0:$((n - 1))}…"; fi
    fi
  fi
  [[ ${FX_MEMO:-} == 1 ]] && FX_ABREV[$k]=$A
  return 0
}

# Selo e cor de cada máquina: a 1ª letra em maiúscula (mais letras se duas máquinas começarem
# igual) e uma cor fixa (pela ordem do cadastro), os mesmos na faixa das fixadas, no popup delas e
# no menu de máquinas. Calculados sobre TODAS as máquinas cadastradas (e as das fixadas), para a
# letra não mudar quando a lista muda. Esta máquina não tem selo. Preenche SELO[] e SELO_COR[].
FIX_CORES=('#ffb86c' '#50fa7b' '#8be9fd' '#ff79c6' '#f1fa8c' '#ff5555')
fixadas_selos() {
  local -a maqs=() cad=() lista=(); local r m k n i j ok ordem l a b c
  SELO=(); SELO_COR=()
  # Em bash puro (eram dois awk e um cut, mais um awk por máquina, a cada redesenho da faixa): os rótulos
  # das cadastradas (3ª coluna das linhas que não começam com #) e as máquinas das fixadas (1º campo).
  if [[ -r $CONF_MAQ ]]; then
    while IFS= read -r l || [[ -n $l ]]; do
      [[ $l == \#* ]] && continue
      c=""; read -r a b c _ <<<"$l"
      [[ -n $c ]] && cad+=("$c")
    done <"$CONF_MAQ"
  fi
  lista=("${cad[@]}")
  if [[ -f $CONF_FIX ]]; then
    while IFS= read -r l || [[ -n $l ]]; do
      [[ $l =~ ^[[:space:]]*$ ]] && continue
      lista+=("${l%%$'\t'*}")
    done <"$CONF_FIX"
  fi
  for r in "${lista[@]}"; do
    r=${r#"${r%%[![:blank:]]*}"}; r=${r%"${r##*[![:blank:]]}"} # sem os brancos das pontas, como o read de antes
    [[ -n $r && $r != "$MAQUINA" && -z ${SELO[$r]:-} ]] || continue
    SELO[$r]=x; maqs+=("$r")
  done
  ((${#maqs[@]})) || return 0
  for ((k = 1; k <= 4; k++)); do
    ok=1
    for m in "${maqs[@]}"; do SELO[$m]=${m:0:k}; SELO[$m]=${SELO[$m]^^}; done
    for ((i = 0; i < ${#maqs[@]}; i++)); do for ((j = i + 1; j < ${#maqs[@]}; j++)); do
      [[ ${SELO[${maqs[i]}]} == "${SELO[${maqs[j]}]}" ]] && ok=0
    done; done
    ((ok)) && break
  done
  for m in "${maqs[@]}"; do
    ordem=""
    for i in "${!cad[@]}"; do [[ ${cad[i]} == "$m" ]] && { ordem=$((i + 1)); break; }; done
    [[ -n $ordem ]] || ordem=$(( $(printf '%s' "$m" | cksum | cut -d' ' -f1) % 6 + 1 ))
    SELO_COR[$m]=${FIX_CORES[$(( (ordem - 1) % ${#FIX_CORES[@]} ))]}
  done
}
# O selo de uma máquina em ANSI (para listas fzf/menus): negrito na cor da máquina.
selo_ansi() { # maquina
  local c=${SELO_COR[$1]:-} 
  [[ -n $c ]] || { printf '%s' "${SELO[$1]:-}"; return 0; }
  printf '\033[1;38;2;%d;%d;%dm%s\033[0m' "0x${c:1:2}" "0x${c:3:2}" "0x${c:5:2}" "${SELO[$1]}"
}

# Faixa das fixadas como FORMATO do tmux (vai para @barra_fixadas). Para cada largura em que o
# desenho muda, a faixa é calculada aqui uma vez, e o próprio tmux escolhe, por cliente, a versão
# que cabe em #{client_width}: monitor, notebook e celular veem cada um a sua, e redimensionar
# redesenha na hora — sem processo nenhum na barra (com #() a cada redesenho o cursor piscava).
# O destaque da sessão em uso também é condição do tmux (#{session_name}).
# Estágios confortáveis, do mais rico ao mais pobre: nome até 28 com ✕ → abreviado 20 com ✕ → 16
# com ✕ → 16 sem ✕. Esse 16 é o PISO DE LEGIBILIDADE (o dono pediu ≥ 15 colunas de rótulo por
# item): abaixo dele o texto vira sopa de letras, então os excedentes vão para o chip "+N ▾"
# (popup com todas) ANTES de comprimir mais, e os visíveis ficam em 16. Só se nem UM item em 16
# couber ao lado do chip é que o rótulo desce (12 → 8 → 6), com um item só. No estouro, o último
# lugar visível mostra a sessão em uso DAQUELE cliente se ela estiver entre as escondidas. Nomes
# abreviados nunca ficam iguais (ganham letras até se distinguirem).
# Cada item de cada estágio e cada versão vão para opções pequenas do tmux (@fxK_I, @fxsK, @fxoN),
# gravadas de uma vez por source-file (o servidor lê o arquivo: sem o limite de tamanho de um
# comando, que a faixa inteira estourava com muitas fixadas); @barra_fixadas só as referencia e
# leva um carimbo vazio (#{?,hash,}) para mudar — e a barra redesenhar — quando um item muda.
# TT_FIX_LARGURA força uma largura (só a versão dela, sem condições de largura: testes);
# TT_FIX_VISIVEIS, se definido, é um teto duro de itens na faixa.
barra_fixadas_fmt() {
  local normal='#[bg=#44475a]#[fg=#f8f8f2]#[nobold]' atual='#[bg=#bd93f9]#[fg=#282a36]#[bold]' morta='#[bg=#282a36]#[fg=#6272a4]#[nobold]'
  local -A existe=() SELO=() SELO_COR=() FX_ABREV=([_]=); local FX_MEMO=1
  local s r id fxk
  while read -r s; do existe[$s]=1; done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)
  if [[ -z $(fixadas) ]]; then
    printf '#[fg=#6272a4] ▸ 📌'
    return 0
  fi
  # Locale que não é UTF-8: as larguras contariam bytes. O teste é o tamanho de um "é" (1 caractere só em
  # UTF-8), sem o processo do `locale charmap`.
  local _u='é'; ((${#_u} == 1)) || local LC_ALL=$TT_UTF8
  fixadas_selos
  local -a nome=() maq=() chaves=() vivas=()
  local total=0
  while IFS=$'\t' read -r r s id; do
    total=$((total + 1))
    fixada_chave_em fxk "$r" "$s" "$id"; chaves[total]=$fxk; nome[total]=$s; maq[total]=$r
    if [[ $r == "$MAQUINA" && -z ${existe[$s]:-} ]]; then vivas[total]=0
    elif [[ $r == "$MAQUINA" && $s != *[,}#\']* ]]; then vivas[total]=2
    else vivas[total]=1; fi
  done < <(fixadas)
  # Largura do canto direito (tarefas + versão), medida, mais o marcador " ▸ " da esquerda.
  # (o atualizar_barras já calculou os dois e os passa em _BARRA_DIR_TXT; chamada avulsa calcula aqui)
  local dir; dir=$(printf '%s' "${_BARRA_DIR_TXT-$(barra_tarefas_fmt)$(versao_barra)}" | sed 's/#\[[^]]*\]//g')
  tt_largura "$dir"; dir=$((W + 3 + 1))
  local cfg="" arq
  _fx_opt() { cfg+="set -g $1 '$2'"$'\n'; }   # valores sem aspa simples (vira ’)
  # Texto escapado para dentro de condições do tmux (## #, #}); a aspa simples vira ’.
  _fx_esc() { local t=${1//\'/’}; t=${t//#/##}; t=${t//,/#,}; E=${t//\}/#\}}; }
  local -a rot=()
  _fx_item() { # i com_x -> ITEM (formato) e WI (largura)
    local i=$1 cx=$2 est pre="" rotulo=${rot[$1]}
    case ${vivas[i]} in
      0) est=$morta; rotulo="✗ $rotulo" ;;
      2) est="#{?#{==:#{session_name},${nome[i]}},$atual,$normal}" ;;
      *) est=$normal ;;
    esac
    tt_largura "$rotulo"; WI=$((W + 2))
    [[ ${maq[i]} != "$MAQUINA" ]] && { pre="#[fg=${SELO_COR[${maq[i]}]}]#[bold]${SELO[${maq[i]}]}$est "; WI=$((WI + ${#SELO[${maq[i]}]} + 1)); }
    _fx_esc "$rotulo"
    if ((cx)); then
      # O espaço antes do ✕ fica no range dele: o tmux dá a 1ª coluna de um range ao range colado
      # antes, e um toque bem em cima do ✕ ia para a sessão em vez de desafixar.
      ITEM="#[range=user|fx${chaves[i]}]$est $pre$E#[norange]#[range=user|fxx${chaves[i]}]$est ✕ #[norange]#[default] "
      WI=$((WI + 3 + 1))
    else
      ITEM="#[range=user|fx${chaves[i]}]$est $pre$E #[norange]#[default] "; WI=$((WI + 1))
    fi
  }
  # Rótulos de um estágio: abreviados a CAP e, se dois ficarem iguais (mesma máquina), mais letras.
  _fx_rotulos() { # cap
    local cap=$1 i j k c
    for ((i = 1; i <= total; i++)); do fixada_abrev "${nome[i]}" "$cap"; rot[i]=$A; done
    for ((k = 0; k < 24; k++)); do
      c=0
      for ((i = 1; i <= total; i++)); do for ((j = i + 1; j <= total; j++)); do
        if [[ ${maq[i]} == "${maq[j]}" && ${rot[i]} == "${rot[j]}" && ${nome[i]} != "${nome[j]}" ]]; then
          fixada_abrev "${nome[i]}" $((${#rot[i]} + 1)); rot[i]=$A
          fixada_abrev "${nome[j]}" $((${#rot[j]} + 1)); rot[j]=$A; c=1
        fi
      done; done
      ((c)) || break
    done
  }
  local teto=$total
  [[ ${TT_FIX_VISIVEIS:-} =~ ^[0-9]+$ ]] && ((TT_FIX_VISIVEIS > 0 && TT_FIX_VISIVEIS < total)) && teto=$TT_FIX_VISIVEIS
  local -a REF=() LIM=() VIS=() # versões da faixa (referências às opções), a largura mínima e os itens antes do chip
  local e cap cx k=0 i w ant="" chave vis refs; local -A WKI=() KCAP=()   # largura por (estágio, item); estágio por cap sem ✕
  for e in "28 1" "20 1" "16 1" "16 0" "12 0" "8 0" "6 0"; do
    read -r cap cx <<<"$e"
    _fx_rotulos "$cap"; chave="$cx|${rot[*]}"; w=0
    for ((i = 1; i <= total; i++)); do _fx_item "$i" "$cx"; _fx_opt "@fx${k}_$i" "$ITEM"; WKI[$k,$i]=$WI; w=$((w + WI)); done
    ((cx == 0)) && KCAP[$cap]=$k
    # Versão com todos os itens só nos estágios confortáveis (cap ≥ 16, o piso).
    if ((teto == total && cap >= 16)) && [[ $chave != "$ant" ]]; then
      refs=""; for ((i = 1; i <= total; i++)); do refs+="#{E:@fx${k}_$i}"; done
      _fx_opt "@fxs$k" "$refs"; REF+=("#{E:@fxs$k}"); LIM+=($((w + dir))); VIS+=("$total")
    fi
    ant=$chave; k=$((k + 1))
  done
  # Estouro: os primeiros VIS itens do estágio K + "+N ▾"; o último lugar mostra a sessão em uso do
  # cliente, se ela estiver entre as escondidas (condição em #{session_name}, avaliada por cliente).
  _fx_estouro() { # k vis
    local k=$1 vis=$2 oculto=$((total - $2)) w=0 refs="" slot walt i
    ((oculto > 0)) || return 0
    for ((i = 1; i < vis; i++)); do refs+="#{E:@fx${k}_$i}"; w=$((w + WKI[$k,$i])); done
    slot="#{E:@fx${k}_$vis}"; walt=${WKI[$k,$vis]}
    for ((i = total; i > vis; i--)); do
      ((vivas[i] == 2)) || continue
      ((WKI[$k,$i] > walt)) && walt=${WKI[$k,$i]}
      slot="#{?#{==:#{session_name},${nome[i]}},#{E:@fx${k}_$i},$slot}"
    done
    _fx_opt "@fxo${k}_$vis" "$refs$slot#[range=user|fixmais]#[bg=#44475a]#[fg=#bd93f9]#[bold] +$oculto ▾ #[norange]#[default]"
    REF+=("#{E:@fxo${k}_$vis}"); LIM+=($((w + walt + ${#oculto} + 5 + dir))); VIS+=("$vis")
  }
  # Primeiro com os visíveis no piso (16); só depois, um item só, cada vez menor.
  for ((vis = teto == total ? total - 1 : teto; vis >= 1; vis--)); do _fx_estouro "${KCAP[16]}" "$vis"; done
  for cap in 12 8 6; do _fx_estouro "${KCAP[$cap]}" 1; done
  # "largura:visíveis …" na ordem das versões (vale a 1ª que cabe; senão a última): a roda do chip lê por cliente
  local mapa=""; for i in "${!REF[@]}"; do mapa+="${LIM[i]}:${VIS[i]} "; done
  _fx_opt "@fx_mapa" "$mapa"
  # Só regrava as opções @fx… quando o conteúdo mudou: um source-file igual ao que está no servidor
  # redesenhava a tela inteira de todos os clientes a cada atualizar_barras (vigia por minuto,
  # tarefas/fixadas recebidas…). O carimbo (cksum do cfg) fica em @fx_carimbo, gravado no MESMO
  # source-file — um atualizar_barras concorrente já o encontra gravado — e também viaja no fim de
  # @barra_fixadas, para o formato mudar junto com o conteúdo.
  local carimbo; carimbo=$(printf '%s' "$cfg" | cksum | cut -d' ' -f1)
  # (carimbo igual mas @fx0_1 ausente = opções apagadas à mão: grava de novo)
  local no_srv="" no_fx="" _sai
  _sai=$(tmux display-message -p "#{@fx_carimbo}"$'\x1f'"#{@fx0_1}"$'\x1f'"fim" 2>/dev/null) &&
    [[ $_sai == *$'\x1f'fim ]] && { no_srv=${_sai%%$'\x1f'*}; _sai=${_sai#*$'\x1f'}; no_fx=${_sai%$'\x1f'fim}; }
  if [[ $no_srv != "$carimbo" || -z $no_fx ]]; then
    [[ -d $RT ]] || mkdir -p "$RT"; arq=$(mktemp "$RT/tt-fixadas-fmt.XXXXXX") || return 0
    printf '%sset -g @fx_carimbo %s\n' "$cfg" "$carimbo" >"$arq"; tmux source-file "$arq" 2>/dev/null; rm -f "$arq"
  fi
  printf '#[fg=#6272a4] ▸ ' # só marcador (não clicável); os pinos da barra são botões
  # Largura forçada (testes): só a versão que cabe nela.
  if [[ ${TT_FIX_LARGURA:-} =~ ^[0-9]+$ ]]; then
    for i in "${!REF[@]}"; do ((LIM[i] <= TT_FIX_LARGURA)) && { printf '%s#{?,%s,}' "${REF[i]}" "$carimbo"; return 0; }; done
    printf '%s#{?,%s,}' "${REF[-1]}" "$carimbo"; return 0
  fi
  # Por cliente: #{?#{e|>=:#{client_width},LIM1},V1,#{?…,V2,…Vúltima}}.
  local out=${REF[-1]}
  for ((i = ${#REF[@]} - 2; i >= 0; i--)); do out="#{?#{e|>=:#{client_width},${LIM[i]}},${REF[i]},$out}"; done
  printf '%s#{?,%s,}' "$out" "$carimbo"
  return 0
}

# Indicador discreto no canto direito da faixa de fixadas. É uma opção do tmux, não um #(), para
# não iniciar processo a cada redesenho da barra.
versao_barra() { printf '#[fg=#6c7086]%s ' "$(versao_humana)"; }

# Vários comandos do tmux numa ida só (um pedido ao servidor e, se mexem em opções, um redesenho só).
# lote=(); lote_add lote set -g @a 1; lote_add lote set -g @b 2; tmux "${lote[@]}"
# Separa com ";", exceto quando o argumento anterior já termina em ";" sem "\" antes: o tmux trata esse
# argumento como fim de comando (é a mesma regra de uma chamada avulsa), e um ";" a mais seria um comando vazio.
lote_add() { # NOME_DO_ARRAY comando [args…]
  local -n _lote_ref=$1; shift
  if ((${#_lote_ref[@]})); then
    local _ult=${_lote_ref[-1]}
    [[ $_ult == *';' && $_ult != *'\;' ]] || _lote_ref+=(';')
  fi
  _lote_ref+=("$@")
}

# Depois de mudar um dado que a barra mostra (tarefas, avisos). Na linha de comando (e nos testes) é o
# atualizar_barras de sempre: volta com a barra pronta. Nas telas interativas que recarregam a própria lista
# (painel de tarefas, histórico de avisos: TT_BARRA_FUNDO=1), a tela não espera a barra: o pedido vai para o
# 2º plano e pedidos seguidos se juntam (atualizar_barras_fundo). Cada ⏎/clique no painel esperava a volta
# inteira da barra antes de redesenhar a lista.
atualizar_barras_pedir() {
  if [[ -n ${TT_BARRA_FUNDO:-} ]]; then atualizar_barras_fundo; else atualizar_barras; fi
}
# Uma volta de atualizar_barras em 2º plano por vez. O pedido marca $RT/tt-barras-UID.pedido; quem pega a
# trava (arquivo com o pid, criado sem sobrescrever) dá voltas enquanto houver pedido novo e confere de novo
# depois de soltar a trava (o pedido que chegou entre a última conferência e a soltura não fica sem volta).
# A última volta sempre começa depois do último pedido: a barra termina no estado final, nunca num anterior.
# Trava de processo que morreu é ignorada.
atualizar_barras_fundo() {
  local pedido=$RT/tt-barras-$UID.pedido trava=$RT/tt-barras-$UID.trava
  { : >"$pedido"; } 2>/dev/null || { atualizar_barras; return; }
  (
    exec </dev/null >/dev/null 2>&1
    local dono quando agora n=0
    _barras_trava() { local -; set -C; printf -v agora '%(%s)T' -1; { printf '%s %s\n' "$BASHPID" "$agora" >"$trava"; } 2>/dev/null; }
    while ((n++ < 20)); do
      if ! _barras_trava; then
        dono="" quando=""; { read -r dono quando <"$trava"; } 2>/dev/null
        # a volta em andamento vê este pedido (trava de mais de 30 s, ou de pid que não existe, é de quem morreu)
        [[ $dono =~ ^[0-9]+$ && $quando =~ ^[0-9]+$ ]] && ((agora >= quando && agora - quando < 30)) &&
          kill -0 "$dono" 2>/dev/null && exit 0
        rm -f "$trava"; continue
      fi
      while [[ -e $pedido ]]; do rm -f "$pedido"; atualizar_barras; done
      rm -f "$trava"
      [[ -e $pedido ]] || exit 0
    done
  ) &
}

# Recalcula as faixas da barra (fixadas, atalhos, transferências) e as guarda em opções do tmux,
# que a barra só lê. Só grava o que mudou: cada set-option redesenha a tela inteira de todos os
# clientes (o miolo da faixa nem passa por aqui — é o letreiro-tt.py, ver barra_notifs_fmt).
atualizar_barras() {
  local nome valor fmt="" i sai l1 st_atual="" faixa=0 st _qn v_tarefas v_versao
  local -a nomes=(fixadas atalhos transf versao tarefas email data hora notifs notifs_n notifs_slot transf0 faixa faixa_dir lado1 fim0) atuais=() lote=()
  # Os valores atuais (e o status) numa ida só ao tmux (eram 16 show, um por opção, e o servidor do tmux
  # atende um pedido por vez); #{@x} devolve o valor literal, sem expandir o que está dentro. Se a leitura
  # vier incompleta, volta ao show por opção: na dúvida, nunca regrava (cada set redesenha todos os clientes).
  for nome in "${nomes[@]}"; do fmt+="#{@barra_$nome}"$'\x1f'; done
  if ! sai=$(tmux display-message -p "${fmt}fim" \; show -gqv status 2>/dev/null); then
    tmux list-sessions >/dev/null 2>&1 || return 0
  fi
  l1=${sai%%$'\n'*}; [[ $sai == *$'\n'* ]] && st_atual=${sai#*$'\n'}
  IFS=$'\x1f' read -r -a atuais <<<"$l1"
  if ((${#atuais[@]} != ${#nomes[@]} + 1)) || [[ ${atuais[-1]} != fim ]]; then
    atuais=(); for nome in "${nomes[@]}"; do atuais+=("$(tmux show -gqv "@barra_$nome")"); done
    st_atual=$(tmux show -gqv status 2>/dev/null)
  fi
  # A faixa ligada ou não decide 6 dos segmentos e o nº de linhas: perguntada uma vez (eram 7 a cada volta).
  faixa_notif_ativa && faixa=1
  # Tarefas e versão também medem o canto direito da faixa das fixadas: calculados uma vez só, aqui.
  v_tarefas=$(barra_tarefas_fmt); v_versao=$(versao_barra)
  local _BARRA_DIR_TXT="$v_tarefas$v_versao"
  for i in "${!nomes[@]}"; do
    nome=${nomes[i]}
    case $nome in
      fixadas) valor=$(barra_fixadas_fmt) ;;
      atalhos) valor=$(atalhos_barra) ;;
      transf) valor=$(transferencias_barra) ;;
      versao) valor=$v_versao; [[ $(versao_num) == 0 ]] && continue ;; # troca de pasta em curso
      tarefas) valor=$v_tarefas ;;
      email) valor=$(barra_email_fmt) ;;
      data) valor=$(barra_data) ;;
      hora) valor=$(barra_hora) ;;
      notifs) valor=$(barra_notifs_fmt) ;;
      # contador do 🔔: avisos frescos (os que piscam no slot) + avisos de agentes ainda não abertos
      notifs_n) { _qn=$(barra_notifs_sino); valor=""; ((_qn > 0)) && valor="#[fg=#f9e2af,bold]$_qn#[nobold]"; } ;;
      notifs_slot) valor="#{E:@barra_notifs}" ;;
      transf0)
        if ((faixa)); then valor=""
        else valor="#{E:@barra_transf}"; fi ;;
      faixa)
        if ((faixa)); then valor="#[range=user|email]#{E:@barra_email}#[norange]#[default] #{E:@barra_tarefas}#[range=user|notifs]#[fg=#a6adc8] 🔔#{E:@barra_notifs_n} #[norange]#[default]"
        else valor=""; fi ;;
      faixa_dir)
        # Responsivo por cliente: o letreiro tem prioridade sobre o enfeite. < 120 colunas sai o dia,
        # < 90 sai também a versão (sobra só a hora) — assim ele ganha ~25 células num terminal estreito.
        if ((faixa)); then valor="#[range=user|relogio]#[fg=#a6adc8]#{?#{e|<:#{client_width},120},,#{E:@barra_data}}#{E:@barra_hora} #[norange]#[default]#{?#{e|<:#{client_width},90},, #{E:@barra_versao}}"
        else valor=""; fi ;;
      lado1)
        if ((faixa)); then valor=""
        else valor="#{E:@barra_tarefas}#{E:@barra_versao}"; fi ;;
      fim0)
        if ((faixa)); then valor=""
        else valor="#[range=user|email]#{E:@barra_email}#[norange]#[default] #{?#{e|<:#{client_width},60},,#[range=user|relogio]#[fg=#a6adc8]#{?#{e|<:#{client_width},90},,#{E:@barra_data}}#{E:@barra_hora} #[norange]#[default]}"; fi ;;
    esac
    [[ $valor == "${atuais[i]}" ]] && continue
    lote_add lote set -g "@barra_$nome" "$valor"
  done
  # Mesmo critério de barra_status_linhas (4 linhas com a faixa, 3 sem).
  if ((faixa)); then st=4; else st=3; fi
  [[ $st_atual == "$st" ]] || lote_add lote set -g status "$st"
  # Tudo o que mudou numa ida só: o servidor aplica os sets juntos e redesenha os clientes UMA vez (cada set
  # separado era um pedido na fila e um redesenho da tela inteira de todos os clientes).
  ((${#lote[@]})) && tmux "${lote[@]}" 2>/dev/null
  # Um refresh-client aqui seria redundante, e recriaria o letreiro (#()) de cada cliente.
  return 0
}

# Dia de hoje para o relógio da barra ("Qui, 08/10/2026 | "), em português sem depender de
# locale; recalculado pelo vigia (vira na madrugada na volta seguinte). Em tela < 90 fica só a hora.
barra_data() {
  local d=(Dom Seg Ter Qua Qui Sex Sáb) ep; ep=$(hora_agora)
  printf '%s, %s | ' "${d[$(tt_fmt_epoch "$ep" +%w)]}" "$(tt_fmt_epoch "$ep" +%d/%m/%Y)"
}
# Hora da barra: o strftime do tmux (%H:%M, relógio da máquina) enquanto o desvio medido é pequeno; com
# 60 s ou mais de desvio, a hora já corrigida (o vigia a renova a cada volta).
barra_hora() {
  hora__ler
  if ((HORA_D >= 60 || HORA_D <= -60)); then
    local agora; printf -v agora '%(%s)T' -1
    tt_fmt_epoch "$((agora + HORA_D))" +%H:%M
  else
    printf '%s' '%H:%M'
  fi
}

barra_fixadas() {
  local atual=${1:-} i=0 r s id rot cor chave
  local -A existe
  while read -r s; do existe[$s]=1; done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)
  printf '#[fg=#6272a4] ▸ ' # só marcador (não clicável); os pinos da barra são botões
  while IFS=$'\t' read -r r s id; do
    i=$((i + 1))
    fixada_chave_em chave "$r" "$s" "$id"
    if [[ $r == "$MAQUINA" ]]; then rot=$s; else rot="$r:$s"; fi
    rot=${rot:0:22}
    if [[ $r == "$MAQUINA" && $s == "$atual" ]]; then cor='#[bg=#bd93f9,fg=#282a36,bold]'
    elif [[ $r == "$MAQUINA" && -z ${existe[$s]:-} ]]; then cor='#[bg=#282a36,fg=#6272a4]'; rot="✗ $rot"
    else cor='#[bg=#44475a,fg=#f8f8f2]'; fi
    # Item (clique vai à sessão) + ✕ (clique desafixa).
    printf '#[range=user|fx%s]%s %s#[norange]#[range=user|fxx%s]%s ✕ #[norange]#[default] ' "$chave" "$cor" "$rot" "$chave" "$cor"
  done < <(fixadas)
}

# Clique num item fixado: vai para ele (ponte, se for de outra máquina).
ir_fixada() {
  local c=$1 chave=${2#fx} r s id k d resolvida fora rc
  while IFS=$'\t' read -r r s id; do
    fixada_chave_em k "$r" "$s" "$id"
    [[ $k == "$chave" ]] && break
    r=""; s=""
  done < <(fixadas)
  [[ -n $s ]] || return 0
  # Dada como desligada pelo Tailscale (fora=2), vai assim mesmo: a marca dele oscila com a máquina de pé
  d=$(dest_ir "$r"); fora=$?
  if [[ -z $d ]]; then tmux display-message -c "$c" "📌 $r: máquina não cadastrada"; return 0; fi
  ((fora == 2)) && tmux display-message -c "$c" -d 4000 "⟳ $r: o Tailscale a dá como desligada; tentando assim mesmo…"
  if [[ -n $id ]]; then
    if [[ $d == . ]]; then
      resolvida=$(session_by_id "$id")
    else
      resolvida=$(timeout 6 ssh "${SSH_OPC[@]}" "$d" "$TT_REMOTO --resolver-fixada $(q "$s") $(q "$id")" </dev/null 2>/dev/null)
      rc=$?
      if ((fora == 2 && (rc == 124 || rc == 255))); then
        tmux display-message -c "$c" "📌 $r não respondeu: o Tailscale a dá como desligada"; return 0
      fi
      resolvida=${resolvida%%$'\t'*}
      # Achada pelo id lá agora há pouco: a sessão existe. O entrar_remoto pula a 2ª ida por ssh
      # (has-session) que só confirmaria isso (~0,2 a 0,6 s a menos até a troca).
      [[ -n $resolvida ]] && local _remota_confirmada=$d
    fi
    [[ -n $resolvida ]] && s=$resolvida
  fi
  if [[ $d == . ]] && ! tmux has-session -t "=$s" 2>/dev/null; then
    TT_RECONC_IMEDIATO=1 reconciliar_fixadas
    tmux display-message -c "$c" "📌 a sessão \"$s\" não existe mais e foi desafixada"; return 0
  fi
  TT_CLIENTE=$c ir_para "$d" "$s"
}

# Botão direito num item fixado.
menu_fixada() {
  local c=$1 chave=${2#fx} r s id k n i
  while IFS=$'\t' read -r r s id; do
    fixada_chave_em k "$r" "$s" "$id"
    [[ $k == "$chave" ]] && break
    r=""; s=""
  done < <(fixadas)
  [[ -n $s ]] || return 0
  i=$(fixadas | awk -F'\t' -v r="$r" -v s="$s" '$1 == r && $2 == s { print NR; exit }')
  n=$(fixadas | wc -l)
  menu_popup "$c" "📌 $([[ $r == "$MAQUINA" ]] && echo "$s" || echo "$r:$s")" <<ITENS
i	Ir para esta sessão	$EU --ir-fixada $(q "$c") fx$chave
d	Desafixar da barra	$EU --alternar-fixada-rotulo $(q "$r") $(q "$s")
-		
e	◀ Mover para a esquerda	$( ((i > 1)) && echo "$EU --mover-fixada $i $((i - 1))")
r	▶ Mover para a direita	$( ((i < n)) && echo "$EU --mover-fixada $i $((i + 1))")
a	⏮ Mover para o início	$( ((i > 1)) && echo "$EU --mover-fixada $i 1")
z	⏭ Mover para o fim	$( ((i < n)) && echo "$EU --mover-fixada $i $n")
-		
t	≡ Todas as fixadas (ir · reordenar · desafixar)…	$EU --fixadas-popup $(q "$c")
ITENS
}

mover_fixada() {
  local i=$1 j=$2 n
  travar_fixadas || return 0
  n=$(grep -vc '^\s*$' "$CONF_FIX" 2>/dev/null || echo 0)
  # j é o índice de DESTINO absoluto (1..n); fora da faixa é saturado. Mover um item para j desloca
  # os demais (não é troca de pares), para "ir ao início/fim" chegar em um passo.
  ((j < 1)) && j=1; ((j > n)) && j=$n
  if ((i >= 1 && i <= n && i != j)); then
    awk -v i="$i" -v j="$j" '
      { l[NR] = $0 }
      END {
        it = l[i]
        if (i < j) { for (k = i; k < j; k++) l[k] = l[k + 1] }
        else       { for (k = i; k > j; k--) l[k] = l[k - 1] }
        l[j] = it
        for (k = 1; k <= NR; k++) print l[k]
      }' "$CONF_FIX" >"$CONF_FIX.novo" && mv "$CONF_FIX.novo" "$CONF_FIX"
    marcar_fixadas
  fi
  destravar_fixadas
  aplicar_fixadas
  propagar_fixadas
}

# Quantas fixadas a faixa deste cliente mostra antes do chip "+N ▾" (todas, se não há chip): pela largura dele e o
# mapa @fx_mapa que a faixa grava ("largura:visíveis …", a 1ª versão que cabe vale, como no formato da barra).
fixadas_visiveis() { # cliente
  local c=$1 w mapa par lim vis ult=""
  if [[ ${TT_FIX_LARGURA:-} =~ ^[0-9]+$ ]]; then w=$TT_FIX_LARGURA; else w=$(do_cliente "$c" '#{client_width}'); fi
  mapa=$(tmux show -gqv @fx_mapa 2>/dev/null)
  for par in $mapa; do
    lim=${par%%:*} vis=${par#*:}; ult=$vis
    [[ $w =~ ^[0-9]+$ ]] && ((w >= lim)) && { echo "$vis"; return 0; }
  done
  [[ -n $ult ]] && echo "$ult" || grep -vc '^\s*$' "$CONF_FIX" 2>/dev/null || echo 0
}

# A roda do mouse no chip "+N ▾": para cima, as do chip giram com a última visível ao lado dele (a 1ª escondida
# aparece, a que estava visível vai para o fim do chip); para baixo, todas giram uma casa (a 1ª vai para o fim).
fixadas_girar() { # cliente cima|baixo
  local c=$1 modo=$2 n vis
  n=$(grep -vc '^\s*$' "$CONF_FIX" 2>/dev/null) || n=0
  ((n >= 2)) || return 0
  if [[ $modo == cima ]]; then
    vis=$(fixadas_visiveis "$c")
    [[ $vis =~ ^[0-9]+$ ]] && ((vis >= 1 && vis < n)) || return 0  # sem chip: nada no chip para girar
    mover_fixada "$vis" "$n"
  else
    mover_fixada 1 "$n"
  fi
}

# Botão direito no chip "+N ▾" (e ^g no popup das fixadas): as sessões de uma mesma máquina ficam lado a lado, as
# máquinas na ordem em que aparecem pela 1ª vez e, dentro de cada uma, a ordem de antes (só muda o necessário).
fixadas_agrupar() { # [cliente]
  local c=${1:-} antes depois
  travar_fixadas || return 0
  antes=$(fixadas)
  depois=$(awk -F'\t' 'NF { if (!($1 in ord)) { ord[$1] = ++k; maq[k] = $1 } n[$1]++; l[$1, n[$1]] = $0 }
    END { for (i = 1; i <= k; i++) for (j = 1; j <= n[maq[i]]; j++) print l[maq[i], j] }' <<<"$antes")
  if [[ -n $depois && $depois != "$antes" ]]; then
    printf '%s\n' "$depois" >"$CONF_FIX.novo" && mv "$CONF_FIX.novo" "$CONF_FIX"
    marcar_fixadas
  fi
  destravar_fixadas
  if [[ $depois == "$antes" ]]; then
    [[ -n $c ]] && botao_aviso "$c" "📌 as fixadas já estão agrupadas por máquina"
    return 0
  fi
  aplicar_fixadas
  propagar_fixadas
  [[ -n $c ]] && botao_aviso "$c" "📌 fixadas agrupadas por máquina"
  return 0
}

# Popup com TODAS as fixadas (abre pelo chip "+N ▾", pelo menu do botão direito, ou
# tt --fixadas-popup): ⏎/clique vai para a sessão, ^x desafixa, ^k/^j (ou alt-↑/↓) REORDENA ao
# vivo — o item acompanha o cursor e a barra e as outras máquinas recebem a ordem nova ao fechar.
fixadas_popup() {
  local c=${1:-$(tmux display-message -p '#{client_name}' 2>/dev/null)}
  [[ -n $c ]] || { fixadas_ui ""; return 0; }
  tmux display-popup -c "$c" -E $(dim_popup "$c" 64 18) -b rounded -S 'fg=#bd93f9' -T ' 📌 sessões fixadas ' "$EU --fixadas-ui $(q "$c")"
}

fixadas_ui_lista() {
  local i=0 r s id rot marca k
  local -A existe SELO SELO_COR
  while read -r s; do existe[$s]=1; done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)
  fixadas_selos
  # Nome inteiro (a faixa abrevia; aqui não): "E sessão  · máquina", com o selo colorido.
  while IFS=$'\t' read -r r s id; do
    i=$((i + 1))
    if [[ $r == "$MAQUINA" ]]; then rot=$s; marca=$([[ -n ${existe[$s]:-} ]] && echo "" || echo " ✗ fechada")
    else rot="$(selo_ansi "$r") $s"; marca="  · $r"; fi
    fixada_chave_em k "$r" "$s" "$id"
    printf 'fx%s\t%2d  📌 %s\033[38;2;108;112;134m%s\033[0m\n' "$k" "$i" "$rot" "$marca"
  done < <(fixadas)
}

fixadas_ui() {
  local c=$1 esc
  while :; do
    [[ -n $(fixadas) ]] || { echo "Nenhuma sessão fixada."; read -rsn1 -t 2; return 0; }
    esc=$(fixadas_ui_lista | fzf --ansi --delimiter=$'\t' --with-nth=2 --layout=reverse --no-sort --no-input \
      --header=$'⏎ vai · ^k/^j reordena · ^g agrupa por máquina · ^x desafixa · Esc fecha' \
      --pointer='▶' --bind "ctrl-k:execute-silent($EU --mover-fixada-rel {n} -1)+reload($EU --fixadas-ui-lista)+up" \
      --bind "alt-up:execute-silent($EU --mover-fixada-rel {n} -1)+reload($EU --fixadas-ui-lista)+up" \
      --bind "ctrl-j:execute-silent($EU --mover-fixada-rel {n} 1)+reload($EU --fixadas-ui-lista)+down" \
      --bind "alt-down:execute-silent($EU --mover-fixada-rel {n} 1)+reload($EU --fixadas-ui-lista)+down" \
      --bind "ctrl-x:execute-silent($EU --desafixar-n {n})+reload($EU --fixadas-ui-lista)" \
      --bind "ctrl-g:execute-silent($EU --fixadas-agrupar)+reload($EU --fixadas-ui-lista)" \
      --bind 'q:abort') || { atualizar_barras; return 0; }
    [[ -n $esc ]] || continue
    atualizar_barras
    [[ -n $c ]] && ir_fixada "$c" "$(cut -f1 <<<"$esc")"
    return 0
  done
}

# Reordena pelo índice 0-based do popup (o {n} do fzf): N vai para N+DELTA.
mover_fixada_rel() {
  local n0=$1 delta=$2 i j
  [[ $n0 =~ ^[0-9]+$ ]] || return 0
  i=$((n0 + 1)); j=$((i + delta))
  mover_fixada "$i" "$j"
}

# Desafixa pelo índice 0-based do popup.
desafixar_n() {
  local n0=$1 r s id
  [[ $n0 =~ ^[0-9]+$ ]] || return 0
  IFS=$'\t' read -r r s id < <(fixadas | sed -n "$((n0 + 1))p")
  [[ -n $s ]] && remover_fixada "$r" "$s" "$id"
  return 0
}

# Botão direito na barra: em "máquina ▾" a administração, em "sessão ▾" o menu da sessão, no resto
# da área da esquerda o menu das máquinas. RANGE CLIENTE PAINEL [X-DO-MOUSE].
clique_direito() {
  export TT_X=$(( ${4:-0} > 4 ? ${4:-0} - 4 : 0 ))
  local faixa=${1#user|}
  case $faixa in
    fxx*) desafixar_item "$2" "${faixa#fxx}" ;;
    fixmais) fixadas_agrupar "$2" ;;
    fixprev | fixnext) fixadas_popup "$2" ;;
    fx*) menu_fixada "$2" "$faixa" ;;
    at[0-9]*) atalho_menu "$2" "${faixa#at}" "$3" ;;
    maquina) menu_admin "$2" "$3" ;;
    sessao) menu_sessao "$2" "$3" ;;
    email) menu_email "$2" ;;
    tarefas) menu_tarefas "$2" ;;
    entrada) menu_tarefas "$2" ;;
    *) menu_maquinas "$2" "$3" ;;
  esac
}

