# --- Sessões fixadas ----------------------------------------------------------
#
# Uma segunda linha na barra com as sessões fixadas (desta ou de outras máquinas), cada uma um
# botão: clique vai para ela; botão direito: ir, desafixar, mover. Lista em ~/.config/tt/fixadas
# ("rótulo-da-máquina<TAB>sessão", na ordem da barra). A linha só aparece se houver alguma.

CONF_FIX=$CONF_DIR/fixadas

fixadas() { [[ -f $CONF_FIX ]] && grep -v '^\s*$' "$CONF_FIX"; }

session_id() {
  local s=$1 id
  id=$(tmux show-options -qv -t "=$s:" @tt_session_id 2>/dev/null)
  if [[ -z $id ]]; then
    id=$(printf '%s\0%s\0%s\0%s' "$MAQUINA" "$s" "$$" "$(date +%s%N)" | sha256sum | cut -c1-32)
    tmux set-option -q -t "=$s:" @tt_session_id "$id" 2>/dev/null || return 1
  fi
  printf '%s\n' "$id"
}

session_by_id() {
  local id=$1
  # O tmux não converte "\t" no formato: o TAB precisa ir literal ($'\t').
  tmux list-sessions -F "#{session_name}"$'\t'"#{@tt_session_id}" 2>/dev/null |
    awk -F'\t' -v id="$id" '$2 == id { print $1; exit }'
}

resolver_fixada_remota() {
  local antigo=$1 id=$2 s
  if [[ -n $id ]]; then s=$(session_by_id "$id"); else s=$antigo; fi
  [[ -n $s ]] || return 1
  printf '%s\t%s\n' "$s" "$(session_id "$s")"
}

# Identidade estável do item da barra. O índice pode mudar enquanto o vigia sincroniza a lista;
# a chave permite resolver o clique contra a máquina e a sessão corretas mesmo nesse intervalo.
# O tmux limita o argumento de range=user|X a 15 bytes; 12 hexadecimais deixam margem para
# classificadores e versões que acrescentam o prefixo do tipo ao valor.
fixada_chave() { printf '%s\t%s' "$1" "${3:-$2}" | sha256sum | cut -c1-12; }

# A lista é a mesma em todas as máquinas: cada mudança é copiada para as cadastradas (em segundo
# plano), e cada uma redesenha a barra. Assim as fixadas não somem ao entrar numa sessão de outra
# máquina (a barra que aparece é a de lá).
propagar_fixadas() {
  local dest rot v
  v=$(versao_fixadas)
  while read -r dest rot; do
    (timeout 8 ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --receber-fixadas $v" <"$CONF_FIX" >/dev/null 2>&1 &)
  done < <(maquinas)
}

# Grava a opção @ da sessão S só se o valor for outro (todo set-option redesenha todos os clientes).
opt_sessao() {
  [[ $(tmux show-options -qv -t "=$1:" "$2" 2>/dev/null) == "$3" ]] && return 0
  tmux set-option -q -t "=$1:" "$2" "$3" 2>/dev/null
}

# Trava das gravações da lista (fixar/desafixar, receber de outra máquina, reconciliar): sem ela,
# duas gravações quase juntas faziam uma desfazer a outra (fixar uma sessão desafixava outra).
# mkdir é atômico em qualquer sistema (o Termux não garante flock). Trava velha (>20 s) é de um
# processo que morreu e é retomada.
travar_fixadas() {
  local t=$CONF_FIX.trava i
  mkdir -p "$CONF_DIR"
  for ((i = 0; i < 200; i++)); do
    mkdir "$t" 2>/dev/null && return 0
    (($(idade_arquivo "$t") > 20)) && rmdir "$t" 2>/dev/null
    sleep 0.05
  done
  return 1
}
destravar_fixadas() { rmdir "$CONF_FIX.trava" 2>/dev/null; return 0; }

# Versão da lista: a hora (ns) da última mudança, em ~/.config/tt/fixadas.v.
versao_fixadas() { local v; v=$(cat "$CONF_FIX.v" 2>/dev/null); echo "${v:-0}"; }
marcar_fixadas() { date +%s%N >"$CONF_FIX.v"; }

# Recebe a lista de outra máquina (stdin) com a versão V. Só aceita se for mais nova que a daqui:
# uma máquina que volta atrasada nunca desfaz uma mudança mais recente.
receber_fixadas() {
  local v=${1:-0} tmp
  mkdir -p "$CONF_DIR"
  tmp=$(mktemp "$CONF_FIX.XXXXXX"); cat >"$tmp"
  travar_fixadas || { rm -f "$tmp"; return 1; }
  if [[ $v =~ ^[0-9]+$ ]] && ((v > $(versao_fixadas))); then
    mv "$tmp" "$CONF_FIX"; echo "$v" >"$CONF_FIX.v"
    destravar_fixadas
    aplicar_fixadas
  else
    destravar_fixadas
    rm -f "$tmp"
  fi
}

# Puxa a lista mais nova entre as máquinas cadastradas (o vigia chama ao iniciar e a cada 5 min):
# assim quem estava desligada na hora da mudança se atualiza sozinha ao voltar.
puxar_fixadas() {
  local dest rot v melhor_v melhor_d
  melhor_v=$(versao_fixadas) melhor_d=""
  while read -r dest rot; do
    v=$(timeout 6 ssh "${SSH_OPC[@]}" "$dest" 'cat ~/.config/tt/fixadas.v 2>/dev/null || echo 0' </dev/null 2>/dev/null)
    [[ $v =~ ^[0-9]+$ ]] && ((v > melhor_v)) && { melhor_v=$v; melhor_d=$dest; }
  done < <(maquinas)
  [[ -n $melhor_d ]] || return 0
  timeout 8 ssh "${SSH_OPC[@]}" "$melhor_d" 'cat ~/.config/tt/fixadas 2>/dev/null' </dev/null 2>/dev/null | receber_fixadas "$melhor_v"
}

# Cadastro comum das contas de IA (ia-conta): "provedor<TAB>e-mail<TAB>apelido<TAB>hora" por conta, igual
# em todas as máquinas; a identidade é o par (provedor, e-mail) e o apelido é só rótulo. Cada máquina faz o próprio login (copiar a credencial derrubaria a outra na renovação do
# token); o cadastro diz que contas existem e o que falta em cada máquina. Mesclar é por par e a
# mudança mais nova vence (apelido "-" = esquecida): a ordem de chegada não importa. Linhas no
# formato antigo (sem provedor) são do Claude.
CONF_CONTAS_IA=$CONF_DIR/contas-ia
receber_contas_ia() {
  local tmp t=$CONF_CONTAS_IA.trava i
  mkdir -p "$CONF_DIR"
  tmp=$(mktemp "$CONF_CONTAS_IA.XXXXXX") || return 1
  cat >"$tmp.in"
  for ((i = 0; i < 200; i++)); do
    mkdir "$t" 2>/dev/null && break
    (($(idade_arquivo "$t") > 20)) && rmdir "$t" 2>/dev/null
    sleep 0.05
  done
  awk -F'\t' -v OFS='\t' '
    NF == 3 && $1 ~ /@/ { $0 = "claude\t" $0 } # formato antigo: só Claude
    NF >= 4 && $1 ~ /^[a-z][a-z0-9-]*$/ && $2 ~ /^[^ ]+@[^ ]+$/ && ($3 == "-" || $3 ~ /^[A-Za-z0-9][A-Za-z0-9_-]*$/) && $4 ~ /^[0-9]+$/ {
      k = $1 OFS $2
      if (!(k in ts) || $4 + 0 > ts[k] + 0 || ($4 + 0 == ts[k] + 0 && $3 > nome[k])) { ts[k] = $4; nome[k] = $3 }
    }
    END { for (k in ts) print k, nome[k], ts[k] }' "$CONF_CONTAS_IA" "$tmp.in" 2>/dev/null | sort >"$tmp"
  if cmp -s "$tmp" "$CONF_CONTAS_IA"; then rm -f "$tmp"; else mv "$tmp" "$CONF_CONTAS_IA"; fi
  rm -f "$tmp.in"; rmdir "$t" 2>/dev/null
  return 0
}

propagar_contas_ia() {
  local dest rot
  [[ -s $CONF_CONTAS_IA ]] || return 0
  while read -r dest rot; do
    (timeout 8 ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --receber-contas-ia" <"$CONF_CONTAS_IA" >/dev/null 2>&1 &)
  done < <(maquinas)
}

# Junta os cadastros das outras máquinas (o vigia chama ao iniciar e a cada 30 min).
puxar_contas_ia() {
  local dest rot
  while read -r dest rot; do
    timeout 6 ssh "${SSH_OPC[@]}" "$dest" 'cat ~/.config/tt/contas-ia 2>/dev/null' </dev/null 2>/dev/null
  done < <(maquinas) | receber_contas_ia
}

# Liga/desliga a 2ª linha e força a barra a se redesenhar já (o #() da barra muda de comando).
aplicar_fixadas() {
  tmux list-sessions >/dev/null 2>&1 || return 0
  # A faixa permanece visível mesmo vazia: o marcador deixa claro onde as fixadas aparecerão.
  local _lin; _lin=$(barra_status_linhas)
  [[ $(tmux show -gv status 2>/dev/null) == "$_lin" ]] || tmux set -g status "$_lin"
  # Marca nas sessões daqui (@tt_fixada): o 📌 ao lado do nome, na barra, fica aceso nas fixadas.
  # Só grava o que mudou: todo set-option redesenha a tela inteira de todos os clientes.
  local sess marca fix
  fix=$(fixadas | awk -F'\t' -v m="$MAQUINA" '$1 == m { print $2 }')
  while IFS=$'\t' read -r sess marca; do
    if grep -qxF -- "$sess" <<<"$fix"; then [[ $marca == 1 ]] || tmux set -q -t "=$sess:" @tt_fixada 1
    else [[ -z $marca ]] || tmux set -q -u -t "=$sess:" @tt_fixada; fi
  done < <(tmux list-sessions -F "#{session_name}"$'\t'"#{@tt_fixada}" 2>/dev/null)
  atualizar_barras
}

# --- Tarefas ---------------------------------------------------------------
#
# Lista de tarefas simples do usuário (afazeres), guardada no perfil em ~/.config/tt/tarefas.
# Cada linha é um registro TAB-separado com identidade estável, para que a sincronização entre
# máquinas (P2P por ssh, como as fixadas, e/ou um repositório git pessoal) junte as duas pontas
# SEM perder tarefa: o merge é POR TAREFA (vence o registro de maior "mudada"), não arquivo
# inteiro. Formato de cada linha:
#
#   id <TAB> estado <TAB> criada <TAB> mudada <TAB> texto
#
#   id     12 hex estáveis (sha256 de origem+criada+texto, cortado); nunca muda após criada.
#   estado aberta | feita | removida (lápide: a remoção é um estado, para o merge propagar que a
#          tarefa saiu em vez de ela "ressurgir" vinda de outra máquina com cópia antiga).
#   criada epoch em segundos (quando a tarefa nasceu).
#   mudada epoch em segundos da última alteração (chave do merge: maior vence).
#   texto  o afazer, numa linha (TAB e quebra viram espaço).
#
# A sincronização é configurável e interoperável (~/.config/tt/config):
#   tarefas_sync = p2p | git | ambos | off   (padrão p2p)
#   tarefas_repo = <url git>                  (só quando git/ambos; credencial fica no git/ssh)

CONF_TAREFAS=$CONF_DIR/tarefas

# Lápides são podadas da exibição, mas mantidas no arquivo por um tempo para o merge propagar a
# remoção às outras máquinas; depois somem (poda em tarefas_compactar).
TAREFAS_LAPIDE_DIAS=${TT_TAREFAS_LAPIDE_DIAS:-30}

tarefas_sync_modo() { local m; m=$(conf tarefas_sync); echo "${m:-p2p}"; }
tarefas_repo_url()  { conf tarefas_repo; }

# Todas as linhas válidas do arquivo (inclui lápides). Sanitiza silenciosamente linhas quebradas.
tarefas_raw() {
  [[ -f $CONF_TAREFAS ]] || return 0
  awk -F'\t' 'NF >= 5 && $1 ~ /^[0-9a-f]{6,}$/ { print }' "$CONF_TAREFAS"
}

# Só as vivas (não removidas), ordenadas: abertas antes de feitas, cada grupo da mais nova para a
# mais velha.
tarefas_vivas() {
  tarefas_raw | awk -F'\t' '$2 == "aberta" || $2 == "feita"' |
    sort -t$'\t' -k2,2 -k4,4nr
}

tarefas_abertas_n() { tarefas_raw | awk -F'\t' '$2 == "aberta"' | wc -l | tr -d ' '; }

# Identidade estável: não pode mudar quando o texto é editado, então entra a hora de criação e um
# nonce da máquina. 12 hex deixam folga no argumento range=user|X do tmux (limite de 15 bytes).
tarefas_novo_id() {
  printf '%s\0%s\0%s\0%s' "$MAQUINA" "$(date +%s%N)" "$$" "${1:-}" | sha256sum | cut -c1-12
}

# Texto numa linha só: TAB e quebras viram espaço (o formato é TAB-separado).
tarefas_limpa_texto() { printf '%s' "$1" | tr '\t\n\r' '   ' | sed 's/  */ /g; s/^ //; s/ $//'; }

# --- metadados por tarefa (6º campo, retrocompatível) ----------------------
# A linha canônica ganhou um 6º campo opcional "meta": pares chave=valor separados por "|". Linhas
# antigas de 5 campos seguem válidas (NF>=5, índices $1..$5 intactos); o campo extra viaja junto no
# registro vencente do merge. Chaves: desc (base64), prazo (epoch), pai (id da mãe), ord (ordem).
tarefas_meta_get() { # meta chave
  local meta=$1 chave=$2 par IFS='|'
  for par in $meta; do [[ $par == "$chave="* ]] && { printf '%s' "${par#*=}"; return 0; }; done
}
tarefas_meta_set() { # meta chave valor -> meta nova (ordem estável desc|prazo|hora|prio|rep|tags|pai|ord)
  local meta=$1 chave=$2 valor=$3 k out="" par; local -A M=(); local IFS='|'
  for par in $meta; do [[ $par == *=* ]] && M[${par%%=*}]=${par#*=}; done
  M[$chave]=$valor
  for k in desc prazo hora prio rep tags pai ord arq; do [[ -n ${M[$k]:-} ]] && out+="${out:+|}$k=${M[$k]}"; done
  printf '%s' "$out"
}
tarefas_b64()   { printf '%s' "$1" | base64 | tr -d '\n'; }
tarefas_unb64() { printf '%s' "$1" | base64 -d 2>/dev/null; }
tarefas_meta_de() { tarefas_raw | awk -F'\t' -v id="$1" '$1==id{print $6; exit}'; }
tarefa_set_meta() { # id meta
  local id=$1 meta=$2 now; now=$(date +%s)
  [[ -f $CONF_TAREFAS ]] || return 1
  tarefas_travar || return 1
  local tmp; tmp=$(mktemp "$CONF_TAREFAS.XXXXXX")
  awk -F'\t' -v OFS='\t' -v id="$id" -v meta="$meta" -v now="$now" '
    NF>=5 { if ($1==id) { $4=now; $6=meta } print }' "$CONF_TAREFAS" >"$tmp"
  mv "$tmp" "$CONF_TAREFAS"; marcar_tarefas
  tarefas_destravar
  atualizar_barras 2>/dev/null
  ("$EU" --tarefas-espelhar >/dev/null 2>&1 &)
}

tarefas_travar()   { local t=$CONF_TAREFAS.trava i; mkdir -p "$CONF_DIR"; for ((i=0;i<200;i++)); do mkdir "$t" 2>/dev/null && return 0; (($(idade_arquivo "$t") > 20)) && rmdir "$t" 2>/dev/null; sleep 0.05; done; return 1; }
tarefas_destravar(){ rmdir "$CONF_TAREFAS.trava" 2>/dev/null; return 0; }
versao_tarefas()   { local v; v=$(cat "$CONF_TAREFAS.v" 2>/dev/null); echo "${v:-0}"; }
marcar_tarefas()   { date +%s%N >"$CONF_TAREFAS.v"; }

# Une duas ou mais fontes de tarefas (arquivos) por id, vencendo o maior "mudada" (empate: estado
# removida ganha de feita, que ganha de aberta — a remoção não pode ser perdida). Imprime o
# conjunto unido no formato canônico, ordenado.
tarefas_merge() {
  awk -F'\t' -v OFS='\t' '
    function rank(e){ return e=="removida"?4:(e=="arquivada"?3:(e=="feita"?2:1)) }
    NF >= 5 && $1 ~ /^[0-9a-f]{6,}$/ {
      id=$1
      if (!(id in m) || $4+0 > md[id]+0 || ($4+0==md[id]+0 && rank($2) > rank(st[id]))) {
        m[id]=$0; md[id]=$4; st[id]=$2
      }
    }
    END { for (id in m) print m[id] }
  ' "$@" | sort -t$'\t' -k2,2 -k4,4nr
}

# Recebe uma lista (stdin) de outra máquina/repo e funde na local. Não re-propaga (evita eco).
receber_tarefas() {
  local tmp_in tmp_out
  tmp_in=$(mktemp) || return 1; cat >"$tmp_in"
  tarefas_travar || { rm -f "$tmp_in"; return 1; }
  mkdir -p "$CONF_DIR"; touch "$CONF_TAREFAS"
  tmp_out=$(mktemp "$CONF_TAREFAS.XXXXXX") || { tarefas_destravar; rm -f "$tmp_in"; return 1; }
  tarefas_merge "$CONF_TAREFAS" "$tmp_in" >"$tmp_out"
  if cmp -s "$tmp_out" "$CONF_TAREFAS"; then rm -f "$tmp_out"; else mv "$tmp_out" "$CONF_TAREFAS"; marcar_tarefas; fi
  tarefas_destravar; rm -f "$tmp_in"
  atualizar_barras 2>/dev/null
  return 0
}

# Poda lápides velhas (removidas há mais de TAREFAS_LAPIDE_DIAS). Mantém o resto.
tarefas_compactar() {
  [[ -f $CONF_TAREFAS ]] || return 0
  local corte; corte=$(( $(date +%s) - TAREFAS_LAPIDE_DIAS * 86400 ))
  tarefas_travar || return 1
  local tmp; tmp=$(mktemp "$CONF_TAREFAS.XXXXXX")
  awk -F'\t' -v c="$corte" 'NF>=5 && !($2=="removida" && $4+0 < c)' "$CONF_TAREFAS" >"$tmp"
  cmp -s "$tmp" "$CONF_TAREFAS" && rm -f "$tmp" || mv "$tmp" "$CONF_TAREFAS"
  tarefas_destravar
}

# --- operações de alto nível (usadas pela UI e pela CLI) ---

tarefa_add() {
  local txt id now
  txt=$(tarefas_limpa_texto "$1"); [[ -n $txt ]] || return 1
  id=$(tarefas_novo_id "$txt"); now=$(date +%s)
  tarefas_travar || return 1
  mkdir -p "$CONF_DIR"; touch "$CONF_TAREFAS"
  { cat "$CONF_TAREFAS"; printf '%s\t%s\t%s\t%s\t%s\n' "$id" aberta "$now" "$now" "$txt"; } | tarefas_merge /dev/stdin >"$CONF_TAREFAS.tmp"
  mv "$CONF_TAREFAS.tmp" "$CONF_TAREFAS"; marcar_tarefas
  tarefas_destravar
  atualizar_barras 2>/dev/null
  ("$EU" --tarefas-espelhar >/dev/null 2>&1 &)
  printf '%s\n' "$id"
}

# Captura rápida com sintaxe natural: a própria frase carrega prazo, prioridade e recorrência, que
# são extraídos e viram meta; o resto é o texto. Tokens (em qualquer posição, separados por espaço):
#   @hoje @amanha @seg..@dom @DD/MM @DD/MM/AAAA   -> prazo
#   !alta !1 !media !med !2 !baixa !3             -> prioridade (baixa limpa)
#   *d *w *m  (ou *diaria *semanal *mensal)       -> recorrência
# Ex.: "Pagar aluguel @05/01 !alta *m" -> tarefa "Pagar aluguel", prazo 05/01, alta, mensal.
# Resolve um token @... em epoch (meia-noite local). Vazio se não reconhecer.
tarefas_token_prazo() { # token-sem-@
  local t=$1
  t=${t,,}
  case $t in
    hoje)   tt_epoch_de "$(tt_fmt_epoch "$(date +%s)" +%Y-%m-%d)" ;;
    amanha|amanhã) date -d "tomorrow 00:00" +%s 2>/dev/null || date -v+1d +%s 2>/dev/null ;;
    seg|segunda) date -d "next monday" +%s 2>/dev/null ;;
    ter|terca|terça) date -d "next tuesday" +%s 2>/dev/null ;;
    qua|quarta) date -d "next wednesday" +%s 2>/dev/null ;;
    qui|quinta) date -d "next thursday" +%s 2>/dev/null ;;
    sex|sexta) date -d "next friday" +%s 2>/dev/null ;;
    sab|sabado|sábado) date -d "next saturday" +%s 2>/dev/null ;;
    dom|domingo) date -d "next sunday" +%s 2>/dev/null ;;
    [0-9][0-9]/[0-9][0-9]|[0-9]/[0-9][0-9]|[0-9][0-9]/[0-9]|[0-9]/[0-9])
      # Sem ano: a próxima vez que esse dia chega (25/12 em janeiro é deste ano; 05/01 em outubro é
      # do ano que vem).
      local d=${t%%/*} m=${t##*/} y ep hoje0; y=$(date +%Y)
      ep=$(tt_epoch_de "$(printf '%04d-%02d-%02d' "$y" "$((10#$m))" "$((10#$d))")") || return 1
      hoje0=$(tt_epoch_de "$(date +%Y-%m-%d)")
      ((ep < hoje0)) && ep=$(tt_epoch_de "$(printf '%04d-%02d-%02d' "$((y + 1))" "$((10#$m))" "$((10#$d))")")
      echo "$ep" ;;
    [0-9][0-9]/[0-9][0-9]/[0-9][0-9][0-9][0-9])
      # Em dois passos: num mesmo `local`, $rest ainda não existe quando m= e y= são expandidos
      # (com set -u o token morria em "rest: unbound variable" e ficava no texto, sem prazo).
      local d=${t%%/*} rest=${t#*/} m y
      m=${rest%%/*} y=${rest##*/}
      # 10#: "08" e "09" no printf %d seriam octais inválidos (a data virava 00-00)
      tt_epoch_de "$(printf '%04d-%02d-%02d' "$((10#$y))" "$((10#$m))" "$((10#$d))")" ;;
    *) return 1 ;;
  esac
}
# Horário de um token: "14h", "14h30", "14:30", "9h", "@14h" -> "HH:MM". Falha se não for hora.
tarefas_token_hora() {
  local t=${1,,}
  t=${t#@}
  [[ $t =~ ^([01]?[0-9]|2[0-3])(h([0-5][0-9])?|:([0-5][0-9])h?)$ ]] || return 1
  printf '%02d:%02d' "$((10#${BASH_REMATCH[1]}))" "$((10#${BASH_REMATCH[3]:-${BASH_REMATCH[4]:-0}}))"
}

# Lê uma frase nas variáveis TT_F_TXT (o texto sem os tokens), TT_F_DESC, TT_F_PRAZO (epoch),
# TT_F_HORA (1 quando o prazo tem horário), TT_F_PRIO, TT_F_REP e TT_F_TAGS. É a leitura da criação
# e da edição: a mesma frase dá a mesma tarefa pelos dois caminhos. Texto com várias linhas
# (colado, ou escrito no editor): a 1ª linha é o título (com os tokens), o resto é a descrição.
#   @sex 14h · @sex às 14:30 · @14h (hoje; amanhã se a hora já passou) -> prazo com horário
# Falha (1) quando não sobra texto.
tarefas_frase_ler() { # frase
  local frase=$1 tok prazo="" hora="" prio="" rep="" tags="" desc="" resto=() i j n hh
  if [[ $frase == *$'\n'* ]]; then
    desc=$(printf '%s\n' "${frase#*$'\n'}" | sed 's/[[:space:]]*$//' | sed '/./,$!d' | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}')
    frase=${frase%%$'\n'*}
  fi
  local -a toks; read -ra toks <<<"$frase"
  n=${#toks[@]}
  for ((i = 0; i < n; i++)); do
    tok=${toks[i]}
    case $tok in
      @?*)
        if hh=$(tarefas_token_hora "$tok"); then hora=$hh; continue; fi
        local ep; ep=$(tarefas_token_prazo "${tok#@}") && [[ -n $ep ]] && {
          prazo=$ep
          # horário logo depois do dia: "@sex 14h", "@sex às 14h"
          j=$((i + 1)); [[ ${toks[j]:-} =~ ^(às|as)$ ]] && j=$((j + 1))
          if hh=$(tarefas_token_hora "${toks[j]:-}"); then hora=$hh; i=$j; fi
          continue; }
        resto+=("$tok") ;;
      '#'?*) local tg=${tok#\#}; tg=${tg,,}; tags="${tags:+$tags,}$tg" ;;
      '!'alta|'!'1) prio=1 ;;
      '!'media|'!'méd*|'!'med|'!'2) prio=2 ;;
      '!'baixa|'!'3) prio="" ;;
      '*'d|'*'diaria|'*'diária) rep=d ;;
      '*'w|'*'semanal) rep=w ;;
      '*'m|'*'mensal) rep=m ;;
      *) resto+=("$tok") ;;
    esac
  done
  # Só a hora: hoje, ou amanhã se essa hora já passou. Dia + hora: junta os dois.
  if [[ -n $hora ]]; then
    local dia
    if [[ -z $prazo ]]; then
      dia=$(date +%Y-%m-%d); prazo=$(tt_epoch_de "$dia $hora")
      ((prazo < $(date +%s))) && prazo=$(tt_epoch_de "$(tt_fmt_epoch "$((prazo + 86400))" +%Y-%m-%d) $hora")
    else
      prazo=$(tt_epoch_de "$(tt_fmt_epoch "$prazo" +%Y-%m-%d) $hora")
    fi
  fi
  TT_F_TXT=$(tarefas_limpa_texto "${resto[*]}")
  TT_F_DESC=$desc TT_F_PRAZO=$prazo TT_F_HORA=${hora:+1} TT_F_PRIO=$prio TT_F_REP=$rep TT_F_TAGS=$tags
  [[ -n $TT_F_TXT ]]
}

# Cria uma tarefa a partir de uma frase com tokens (tarefas_frase_ler). Imprime o id criado.
tarefa_add_natural() {
  local id meta=""
  tarefas_frase_ler "$1" || return 1
  id=$(tarefa_add "$TT_F_TXT") || return 1
  [[ -n $TT_F_DESC ]] && meta=$(tarefas_meta_set "$meta" desc "$(tarefas_b64 "$TT_F_DESC")")
  [[ -n $TT_F_PRAZO ]] && meta=$(tarefas_meta_set "$meta" prazo "$TT_F_PRAZO")
  [[ -n $TT_F_HORA ]] && meta=$(tarefas_meta_set "$meta" hora 1)
  [[ -n $TT_F_PRIO ]] && meta=$(tarefas_meta_set "$meta" prio "$TT_F_PRIO")
  [[ -n $TT_F_REP ]] && meta=$(tarefas_meta_set "$meta" rep "$TT_F_REP")
  [[ -n $TT_F_TAGS ]] && meta=$(tarefas_meta_set "$meta" tags "$TT_F_TAGS")
  [[ -n $meta ]] && tarefa_set_meta "$id" "$meta"
  printf '%s\n' "$id"
}

# A frase de uma tarefa como se fosse escrita de novo: o texto e os marcadores que ela tem —
# @DD/MM (ou @DD/MM/AAAA quando esse dia não é o próximo a chegar: atrasada, ano que vem), o
# horário (14h, 9h30), !alta/!media, *diaria/*semanal/*mensal e as #etiquetas. É o que ✎ Editar
# mostra; lida de volta por tarefas_frase_ler, dá a mesma tarefa. Subtarefa: só o texto.
tarefas_frase_de() { # id
  local id=$1 txt m f prazo dia hh h mi tgs
  IFS=$'\t' read -r txt m < <(tarefas_raw | awk -F'\t' -v id="$id" '$1==id{print $5"\t"($6==""?"-":$6); exit}')
  [[ -n $txt ]] || return 1
  [[ $m == - ]] && m=""
  f=$txt
  [[ -n $(tarefas_meta_get "$m" pai) ]] && { printf '%s\n' "$f"; return 0; }
  prazo=$(tarefas_meta_get "$m" prazo)
  if [[ -n $prazo ]]; then
    dia=$(tt_fmt_epoch "$prazo" +%d/%m)
    [[ $(tarefas_token_prazo "$dia") == "$(tt_epoch_de "$(tt_fmt_epoch "$prazo" +%Y-%m-%d)")" ]] || dia=$(tt_fmt_epoch "$prazo" +%d/%m/%Y)
    f+=" @$dia"
    if [[ $(tarefas_meta_get "$m" hora) == 1 ]]; then
      hh=$(tt_fmt_epoch "$prazo" +%H:%M); h=$((10#${hh%%:*})); mi=${hh##*:}
      f+=" ${h}h"; [[ $mi != 00 ]] && f+=$mi
    fi
  fi
  case $(tarefas_meta_get "$m" prio) in 1) f+=' !alta' ;; 2) f+=' !media' ;; esac
  case $(tarefas_meta_get "$m" rep) in d) f+=' *diaria' ;; w) f+=' *semanal' ;; m) f+=' *mensal' ;; esac
  tgs=$(tarefas_meta_get "$m" tags); [[ -n $tgs ]] && f+=" #${tgs//,/ #}"
  printf '%s\n' "$f"
}

# Edita uma tarefa relendo a frase como na criação: o texto e os marcadores @prazo (com horário),
# !prioridade, *repetição e #etiquetas vêm da frase, e marcador que não está mais nela tira o
# atributo — sem @ fica sem prazo, sem ! sem prioridade, sem * deixa de repetir, sem # sem
# etiquetas. A descrição não é marcador: só muda quando a frase traz linhas além da 1ª (elas a
# substituem) ou com --desc (o editor a mostrou, então o que voltou vale, mesmo vazio); senão fica.
# Subtarefa: só o texto muda (na criação dela a frase também não é lida). Mãe, ordem, estado e
# arquivo ficam. Falha (1) sem texto.
tarefa_editar() { # id frase [--desc]
  local id=$1 frase=$2 forca_desc=${3:-} meta now tmp
  [[ -n $id && -f $CONF_TAREFAS ]] || return 1
  meta=$(tarefas_meta_de "$id")
  if [[ -n $(tarefas_meta_get "$meta" pai) ]]; then tarefa_renomear "$id" "${frase%%$'\n'*}"; return; fi
  tarefas_frase_ler "$frase" || return 1
  meta=$(tarefas_meta_set "$meta" prazo "$TT_F_PRAZO")
  meta=$(tarefas_meta_set "$meta" hora "${TT_F_PRAZO:+$TT_F_HORA}")
  meta=$(tarefas_meta_set "$meta" prio "$TT_F_PRIO")
  meta=$(tarefas_meta_set "$meta" rep "$TT_F_REP")
  meta=$(tarefas_meta_set "$meta" tags "$TT_F_TAGS")
  if [[ -n $TT_F_DESC || $forca_desc == --desc ]]; then
    meta=$(tarefas_meta_set "$meta" desc "$([[ -n $TT_F_DESC ]] && tarefas_b64 "$TT_F_DESC")")
  fi
  now=$(date +%s)
  tarefas_travar || return 1
  tmp=$(mktemp "$CONF_TAREFAS.XXXXXX")
  TT_TXT=$TT_F_TXT awk -F'\t' -v OFS='\t' -v id="$id" -v now="$now" -v meta="$meta" '
    NF>=5 { if ($1==id) { $4=now; $5=ENVIRON["TT_TXT"]; $6=meta } print }' "$CONF_TAREFAS" >"$tmp"
  mv "$tmp" "$CONF_TAREFAS"; marcar_tarefas
  tarefas_destravar
  atualizar_barras 2>/dev/null
  ("$EU" --tarefas-espelhar >/dev/null 2>&1 &)
}

# Muda o estado de uma tarefa (feita/aberta/removida), atualizando "mudada".
tarefa_estado() {
  local id=$1 novo=$2 now; now=$(date +%s)
  [[ -f $CONF_TAREFAS ]] || return 1
  tarefas_travar || return 1
  local tmp; tmp=$(mktemp "$CONF_TAREFAS.XXXXXX")
  awk -F'\t' -v OFS='\t' -v id="$id" -v e="$novo" -v now="$now" '
    NF>=5 { if ($1==id) { $2=e; $4=now } print }' "$CONF_TAREFAS" >"$tmp"
  mv "$tmp" "$CONF_TAREFAS"; marcar_tarefas
  tarefas_destravar
  # Remover uma tarefa remove junto as subtarefas dela (não deixa filha órfã na lista).
  if [[ $novo == removida ]]; then
    local f
    for f in $(tarefas_raw | awk -F'\t' '($2=="aberta"||$2=="feita"||$2=="arquivada"){print $1"\t"$6}' |
                 while IFS=$'\t' read -r fid fmeta; do [[ $(tarefas_meta_get "$fmeta" pai) == "$id" ]] && printf '%s\n' "$fid"; done); do
      tarefa_estado "$f" removida
    done
  fi
  atualizar_barras 2>/dev/null
  ("$EU" --tarefas-espelhar >/dev/null 2>&1 &)
}

tarefas_estado_de() { tarefas_raw | awk -F'\t' -v id="$1" '$1==id{print $2; exit}'; }
# Textos das subtarefas ainda abertas de uma mãe (uma por linha).
tarefas_subs_abertas() { tarefas_filhas "$1" | awk -F'\t' '$2=="aberta"{print $3}'; }

# Conclui ID. Uma mãe só conclui com TODAS as subtarefas feitas: senão não muda nada, imprime as
# que faltam e devolve 2. Concluir a última subtarefa não conclui a mãe (isso fica com você).
# Recorrente (rep + prazo): em vez de fechar, o prazo avança (mantendo a hora) e as subtarefas
# reabrem — o checklist volta no próximo ciclo.
tarefa_concluir() {
  local id=$1 falta rep prazo prox f
  falta=$(tarefas_subs_abertas "$id")
  [[ -n $falta ]] && { printf '%s\n' "$falta"; return 2; }
  rep=$(tarefa_get_rep "$id"); prazo=$(tarefa_get_prazo "$id")
  if [[ -n $rep && -n $prazo ]]; then
    prox=$(tarefas_proximo_prazo "$prazo" "$rep")
    if [[ -n $prox ]]; then
      tarefa_set_prazo "$id" "$prox" "$(tarefas_meta_get "$(tarefas_meta_de "$id")" hora)"
      while IFS=$'\t' read -r f _; do tarefa_estado "$f" aberta; done < <(tarefas_filhas "$id" | awk -F'\t' '$2=="feita"')
      return 0
    fi
  fi
  tarefa_estado "$id" feita
}

# Alterna aberta<->feita (concluir segue tarefa_concluir; devolve 2 se faltam subtarefas). Reabrir
# uma subtarefa de mãe já feita reabre a mãe: mãe feita nunca fica com subtarefa aberta.
tarefa_alternar() {
  local id=$1 pai
  if [[ $(tarefas_estado_de "$id") != feita ]]; then tarefa_concluir "$id"; return; fi
  tarefa_estado "$id" aberta
  pai=$(tarefas_meta_get "$(tarefas_meta_de "$id")" pai)
  [[ -n $pai && $(tarefas_estado_de "$pai") == feita ]] && tarefa_estado "$pai" aberta
  return 0
}

# Clique esquerdo numa linha: numa tarefa de topo o clique abre/fecha os detalhes (▸/▾: descrição,
# subtarefas e ações) — o mesmo que o clique no painel faz. Numa subtarefa, alterna feita/aberta.
tarefa_clique() {
  local id=$1
  [[ -n $id ]] || return 0
  if [[ -z $(tarefas_meta_get "$(tarefas_meta_de "$id")" pai) ]]; then tarefas_exp_alternar "$id"; else tarefa_alternar "$id"; fi
}

tarefa_remover()  { tarefa_estado "$1" removida; }

# --- arquivo ----------------------------------------------------------------
#
# Arquivar guarda a tarefa como histórico: estado "arquivada" no mesmo arquivo de tarefas, com a
# meta arq=EPOCH:a|f (quando e o estado de antes). Fica fora da lista, da agenda, das contas e
# do lembrete, aparece na aba Arquivo e sincroniza como qualquer tarefa (merge por id; arquivar e
# restaurar atualizam "mudada", então uma cópia velha noutra máquina não a devolve à lista). Só
# tarefas de topo se arquivam, sempre com as subtarefas; subtarefa feita de mãe aberta fica.
tarefas_arquivo_mudar() { # arquivar|restaurar --feitas|ID...
  local op=$1; shift
  [[ -f $CONF_TAREFAS ]] || return 1
  local now ids="" feitas="" n
  now=$(date +%s)
  if [[ ${1:-} == --feitas ]]; then feitas=1; else ids=" $* "; fi
  tarefas_travar || return 1
  local tmp; tmp=$(mktemp "$CONF_TAREFAS.XXXXXX")
  awk -F'\t' -v OFS='\t' -v op="$op" -v now="$now" -v ids="$ids" -v feitas="$feitas" '
    function mv(m, k,   n, a, i) { n = split(m, a, "|"); for (i = 1; i <= n; i++) if (index(a[i], k "=") == 1) return substr(a[i], length(k) + 2); return "" }
    function semarq(m,   n, a, i, o) { n = split(m, a, "|"); o = ""; for (i = 1; i <= n; i++) if (a[i] !~ /^arq=/) o = o (o == "" ? "" : "|") a[i]; return o }
    NR == FNR {
      if (NF >= 5) {
        pai[$1] = mv($6, "pai")
        if (pai[$1] == "") {
          if (op == "arquivar" && ($2 == "aberta" || $2 == "feita") && ((feitas && $2 == "feita") || (!feitas && index(ids, " " $1 " ")))) alvo[$1] = 1
          if (op == "restaurar" && $2 == "arquivada" && index(ids, " " $1 " ")) alvo[$1] = 1
        }
      }
      next
    }
    NF >= 5 {
      if (($1 in alvo) || (pai[$1] != "" && (pai[$1] in alvo))) {
        if (op == "arquivar" && ($2 == "aberta" || $2 == "feita")) {
          m = (NF >= 6 ? $6 : ""); $6 = (m == "" ? "" : m "|") "arq=" now ":" substr($2, 1, 1); $2 = "arquivada"; $4 = now; if ($1 in alvo) n++
        } else if (op == "restaurar" && $2 == "arquivada") {
          a = mv($6, "arq"); $2 = (a ~ /:a$/ ? "aberta" : "feita"); $6 = semarq($6); $4 = now; if ($1 in alvo) n++
        }
      }
      print
    }
    END { print n + 0 > "/dev/stderr" }' "$CONF_TAREFAS" "$CONF_TAREFAS" >"$tmp" 2>"$tmp.n"
  n=$(cat "$tmp.n" 2>/dev/null); rm -f "$tmp.n"
  mv "$tmp" "$CONF_TAREFAS"; marcar_tarefas
  tarefas_destravar
  atualizar_barras 2>/dev/null
  ("$EU" --tarefas-espelhar >/dev/null 2>&1 &)
  echo "${n:-0}"
}
tarefa_arquivar()        { tarefas_arquivo_mudar arquivar "$@" >/dev/null; }
tarefas_arquivar_feitas() { tarefas_arquivo_mudar arquivar --feitas; }
tarefa_restaurar()       { tarefas_arquivo_mudar restaurar "$@" >/dev/null; }

# Histórico em texto (CLI): data de arquivamento, ☑/☐ de antes, texto e id; mais recentes primeiro.
tarefas_arquivadas_listar() {
  [[ -s $CONF_TAREFAS ]] || return 0
  local agora tz; read -r agora tz < <(tarefas_relogio)
  LC_ALL=C awk -F'\t' -v NOW="$agora" -v TZOFF="$tz" "$TAREFAS_AWK"'
    NF >= 5 && $2 == "arquivada" && mv($6, "pai") == "" {
      a = mv($6, "arq"); e = a; sub(/:.*/, "", e); civil(dia(e + 0))
      printf "%010d\t%02d/%02d/%04d  %s  %s  [%s]\n", e, CD, CM, CY, (a ~ /:a$/ ? "☐" : "☑"), $5, substr($1, 1, 6)
    }' "$CONF_TAREFAS" | sort -t$'\t' -k1,1nr | cut -f2-
}
# Remove as tarefas feitas (com as subtarefas delas). Subtarefa feita de mãe ainda aberta fica: é
# o checklist da mãe.
tarefa_limpar_feitas() {
  local id
  while read -r id; do tarefa_estado "$id" removida; done < <(tarefas_raw | awk -F'\t' '
    function pai(m,   n, a, i) { n = split(m, a, "|"); for (i = 1; i <= n; i++) if (a[i] ~ /^pai=/) return substr(a[i], 5); return "" }
    $2 == "feita" && pai($6) == "" { print $1 }')
}

# --- descrição, prazo e subtarefas -----------------------------------------
tarefa_set_desc() { # id texto (vazio remove)
  local id=$1 txt=$2 meta
  meta=$(tarefas_meta_de "$id")
  meta=$(tarefas_meta_set "$meta" desc "$([[ -n $txt ]] && tarefas_b64 "$txt")")
  tarefa_set_meta "$id" "$meta"
}
tarefa_get_desc() { tarefas_unb64 "$(tarefas_meta_get "$(tarefas_meta_de "$1")" desc)"; }

tarefa_set_prazo() { # id epoch [1 = com horário] (epoch vazio remove o prazo)
  local id=$1 ep=$2 hora=${3:-} meta
  meta=$(tarefas_meta_de "$id")
  meta=$(tarefas_meta_set "$meta" prazo "$ep")
  meta=$(tarefas_meta_set "$meta" hora "$([[ -n $ep && $hora == 1 ]] && echo 1)")
  tarefa_set_meta "$id" "$meta"
}
tarefa_get_prazo() { tarefas_meta_get "$(tarefas_meta_de "$1")" prazo; }

# Prioridade: 1 alta (🔴), 2 média (🟡), vazio/3 baixa (⚪). O ícone usa forma distinta além da cor
# (acessibilidade). Ciclar: nenhuma -> alta -> média -> baixa(limpa) -> alta...
tarefa_get_prio() { tarefas_meta_get "$(tarefas_meta_de "$1")" prio; }
tarefa_set_prio() { # id 1|2|3|'' (vazio remove)
  local id=$1 p=$2 meta
  meta=$(tarefas_meta_de "$id")
  meta=$(tarefas_meta_set "$meta" prio "$p")
  tarefa_set_meta "$id" "$meta"
}
tarefa_prio_ciclar() { # id -> alta -> media -> (sem) -> alta
  local id=$1 p; p=$(tarefa_get_prio "$id")
  case $p in
    1) tarefa_set_prio "$id" 2 ;;
    2) tarefa_set_prio "$id" "" ;;
    *) tarefa_set_prio "$id" 1 ;;
  esac
}
# Peso para ordenação: alta primeiro (menor número ordena antes).
tarefas_prio_peso() { case $1 in 1) echo 0 ;; 2) echo 1 ;; *) echo 2 ;; esac; }

# Recorrência: d (diária), w (semanal), m (mensal). Precisa de prazo (âncora); ao concluir uma
# tarefa recorrente, o prazo avança para o próximo período e ela renasce aberta em vez de fechar.
tarefa_get_rep() { tarefas_meta_get "$(tarefas_meta_de "$1")" rep; }
tarefa_set_rep() { # id d|w|m|'' (vazio remove)
  local id=$1 r=$2 meta
  meta=$(tarefas_meta_de "$id")
  meta=$(tarefas_meta_set "$meta" rep "$r")
  tarefa_set_meta "$id" "$meta"
}
tarefa_rep_ciclar() { # id -> sem -> d -> w -> m -> sem
  local id=$1 r; r=$(tarefa_get_rep "$id")
  case $r in
    d) tarefa_set_rep "$id" w ;;
    w) tarefa_set_rep "$id" m ;;
    m) tarefa_set_rep "$id" "" ;;
    *) tarefa_set_rep "$id" d ;;
  esac
}
# Próximo epoch de um prazo conforme a recorrência (um período à frente). Portável: GNU date -d
# "data +N" ou BSD date -v. Devolve vazio se não souber calcular.
tarefas_proximo_prazo() { # epoch rep -> epoch (mantém a hora do dia)
  local ep=$1 rep=$2 base inc_gnu inc_bsd
  base=$(tt_fmt_epoch "$ep" '+%Y-%m-%d %H:%M') || return 1
  case $rep in
    d) inc_gnu="+1 day";   inc_bsd="-v+1d" ;;
    w) inc_gnu="+7 day";   inc_bsd="-v+7d" ;;
    m) inc_gnu="+1 month"; inc_bsd="-v+1m" ;;
    *) return 1 ;;
  esac
  date -d "$base $inc_gnu" +%s 2>/dev/null || date "$inc_bsd" -j -f '%Y-%m-%d %H:%M' "$base" +%s 2>/dev/null
}

# Subtarefa de PAI: tarefa normal com meta pai=<id> e ord no fim do grupo.
tarefa_add_sub() { # pai texto
  local pai=$1 txt id meta ord
  txt=$(tarefas_limpa_texto "$2"); [[ -n $txt && -n $pai ]] || return 1
  id=$(tarefa_add "$txt") || return 1
  ord=$(tarefas_sub_proxima_ord "$pai")
  meta=$(tarefas_meta_set "" pai "$pai"); meta=$(tarefas_meta_set "$meta" ord "$ord")
  tarefa_set_meta "$id" "$meta"
  # Subtarefa nova numa mãe já feita: a mãe volta a ficar aberta (ainda há o que fazer).
  [[ $(tarefas_estado_de "$pai") == feita ]] && tarefa_estado "$pai" aberta
  printf '%s\n' "$id"
}

tarefas_sub_proxima_ord() { # pai -> max(ord)+1
  local pai=$1 maior=0 i mm o
  while IFS=$'\t' read -r i mm; do
    [[ $(tarefas_meta_get "$mm" pai) == "$pai" ]] || continue
    o=$(tarefas_meta_get "$mm" ord); o=${o:-0}; ((o > maior)) && maior=$o
  done < <(tarefas_raw | awk -F'\t' '($2=="aberta"||$2=="feita"){print $1"\t"$6}')
  echo $((maior + 1))
}

# Subtarefas vivas de um pai, ordenadas por "ord". Imprime: id<TAB>estado<TAB>texto.
tarefas_filhas() { # pai
  local pai=$1 i est mm txt o
  while IFS=$'\t' read -r i est txt mm; do
    [[ $(tarefas_meta_get "$mm" pai) == "$pai" ]] || continue
    o=$(tarefas_meta_get "$mm" ord); printf '%s\t%s\t%s\t%s\n' "${o:-0}" "$i" "$est" "$txt"
  done < <(tarefas_raw | awk -F'\t' '($2=="aberta"||$2=="feita"){print $1"\t"$2"\t"$5"\t"$6}') |
    sort -t$'\t' -k1,1n | cut -f2-
}

# Sobe/desce uma subtarefa dentro do grupo do pai (troca o "ord" com a vizinha).
tarefa_sub_mover() { # id cima|baixo
  local id=$1 dir=$2 pai linhas i n vizinho m1 m2 o1 o2
  pai=$(tarefas_meta_get "$(tarefas_meta_de "$id")" pai); [[ -n $pai ]] || return 0
  mapfile -t linhas < <(tarefas_filhas "$pai" | cut -f1)
  n=${#linhas[@]}
  for i in "${!linhas[@]}"; do [[ ${linhas[$i]} == "$id" ]] && break; done
  if [[ $dir == cima ]]; then ((i > 0)) && vizinho=${linhas[$((i-1))]} || return 0
  else ((i < n-1)) && vizinho=${linhas[$((i+1))]} || return 0; fi
  m1=$(tarefas_meta_de "$id"); m2=$(tarefas_meta_de "$vizinho")
  o1=$(tarefas_meta_get "$m1" ord); o2=$(tarefas_meta_get "$m2" ord)
  tarefa_set_meta "$id" "$(tarefas_meta_set "$m1" ord "${o2:-0}")"
  tarefa_set_meta "$vizinho" "$(tarefas_meta_set "$m2" ord "${o1:-0}")"
}

# Tarefas de TOPO na mesma ordem do painel (chave_ordem). Emite "id<TAB>estado".
tarefas_topo_ordenadas() {
  tarefas_raw | LC_ALL=C awk -F'\t' "$TAREFAS_AWK"'
    valida($1, $2) && mv($6, "pai") == "" && !($1 in v) { v[$1] = 1; print chave_ordem($1, $2, $3, $6) "\t" $1 "\t" $2 }' |
    LC_ALL=C sort | cut -f2-
}

# Move uma tarefa para cima/baixo. Subtarefa: reordena entre as irmãs (tarefa_sub_mover). Tarefa de
# topo: reordena entre as mães de topo trocando "ord"; como nem toda mãe tem ord, normaliza a ordem
# atual (1..n na ordem exibida) antes de trocar, para a troca ter efeito visível e estável.
tarefa_mover() { # id cima|baixo
  local id=$1 dir=$2 pai
  pai=$(tarefas_meta_get "$(tarefas_meta_de "$id")" pai)
  if [[ -n $pai ]]; then tarefa_sub_mover "$id" "$dir"; return; fi
  local -a topo; mapfile -t topo < <(tarefas_topo_ordenadas | awk -F'\t' '$2=="aberta"{print $1}')
  local n=${#topo[@]} i
  ((n > 1)) || return 0
  for i in "${!topo[@]}"; do [[ ${topo[$i]} == "$id" ]] && break; done
  [[ ${topo[$i]:-} == "$id" ]] || return 0
  local alvo
  if [[ $dir == cima ]]; then ((i > 0)) && alvo=$((i - 1)) || return 0
  else ((i < n - 1)) && alvo=$((i + 1)) || return 0; fi
  # Normaliza: atribui ord 1..n na ordem atual, já com a troca de posição entre i e alvo.
  local tmp=${topo[$i]}; topo[$i]=${topo[$alvo]}; topo[$alvo]=$tmp
  local pos=1 t mt
  for t in "${topo[@]}"; do
    mt=$(tarefas_meta_de "$t")
    tarefa_set_meta "$t" "$(tarefas_meta_set "$mt" ord "$pos")"
    pos=$((pos + 1))
  done
}

# --- sincronização ---------------------------------------------------------

# P2P: empurra a lista para as máquinas cadastradas (como as fixadas), em segundo plano.
propagar_tarefas() {
  [[ -f $CONF_TAREFAS ]] || return 0
  local dest rot
  while read -r dest rot; do
    (timeout 8 ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --receber-tarefas" <"$CONF_TAREFAS" >/dev/null 2>&1 &)
  done < <(maquinas)
}

# P2P: puxa de todas e funde (o vigia chama ao iniciar e a cada 5 min).
puxar_tarefas() {
  local dest rot
  while read -r dest rot; do
    timeout 6 ssh "${SSH_OPC[@]}" "$dest" 'cat ~/.config/tt/tarefas 2>/dev/null' </dev/null 2>/dev/null
  done < <(maquinas) | receber_tarefas
}

# Diretório do clone git do repositório pessoal de tarefas (quando configurado).
tarefas_git_dir() { echo "$ESTADO_DIR/tarefas-git"; }

# Garante o clone local do repositório pessoal; ecoa o diretório pronto, ou nada em caso de falha.
tarefas_git_prep() {
  local url dir; url=$(tarefas_repo_url); [[ -n $url ]] || return 1
  command -v git >/dev/null || return 1
  dir=$(tarefas_git_dir)
  if [[ ! -d $dir/.git ]]; then
    mkdir -p "$ESTADO_DIR"
    timeout 30 git clone --depth 1 "$url" "$dir" >/dev/null 2>&1 || return 1
  fi
  printf '%s\n' "$dir"
}

# Git: puxa o arquivo do repositório pessoal e funde na lista local.
puxar_tarefas_git() {
  local dir; dir=$(tarefas_git_prep) || return 1
  ( cd "$dir" && timeout 30 git pull --ff-only >/dev/null 2>&1 )
  [[ -f $dir/tarefas ]] && receber_tarefas <"$dir/tarefas"
}

# Git: funde a lista local no arquivo do repo pessoal e empurra (merge por tarefa, nunca perde).
empurrar_tarefas_git() {
  local dir; dir=$(tarefas_git_prep) || return 1
  [[ -f $CONF_TAREFAS ]] || return 0
  ( cd "$dir" && timeout 30 git pull --ff-only >/dev/null 2>&1 )
  local merged; merged=$(mktemp)
  tarefas_merge "$dir/tarefas" "$CONF_TAREFAS" 2>/dev/null >"$merged"
  if ! cmp -s "$merged" "$dir/tarefas" 2>/dev/null; then
    cp "$merged" "$dir/tarefas"
    ( cd "$dir" && git add tarefas &&
      git -c user.name="${TT_GIT_NAME:-tt}" -c user.email="${TT_GIT_EMAIL:-tt@localhost}" commit -q -m "tarefas: sync de $MAQUINA" >/dev/null 2>&1 &&
      timeout 30 git push >/dev/null 2>&1 )
  fi
  rm -f "$merged"
}

# Espelha a lista local conforme o modo configurado (chamado em segundo plano após cada mudança).
tarefas_espelhar() {
  case $(tarefas_sync_modo) in
    off) : ;;
    p2p) propagar_tarefas ;;
    git) empurrar_tarefas_git ;;
    ambos) propagar_tarefas; empurrar_tarefas_git ;;
  esac
}

# Puxa de todas as fontes conforme o modo (chamado pelo vigia).
tarefas_puxar_tudo() {
  case $(tarefas_sync_modo) in
    off) : ;;
    p2p) puxar_tarefas ;;
    git) puxar_tarefas_git ;;
    ambos) puxar_tarefas; puxar_tarefas_git ;;
  esac
  tarefas_compactar
}

# --- lembrete de prazo (notificação do sistema, disparado pelo vigia) ------
#
# Avisa uma vez por dia por tarefa aberta vencida ou de hoje, via notificação nativa da plataforma
# (notify-send no Linux, termux-notification no Termux). Sem notificador disponível, não faz nada.
# A deduplicação é por "id|AAAAMMDD" num arquivo de estado, para não repetir no mesmo dia nem a
# cada ciclo do vigia. TT_TAREFAS_LEMBRETE=0 desliga.
tarefas_lembrete_arq() { echo "$ESTADO_DIR/tt-tarefas-avisadas"; }

# --- Faixa de notificações (3ª linha da barra, abaixo das fixadas) ---------------------------
#
# Avisos curtos passam na faixa por alguns minutos e expiram sozinhos: e-mail que chegou, lembrete
# de prazo, transferência, o que vier (tt --notificar "texto" [segundos]). Fica tudo em
# ~/.local/state/tt/notifs (um arquivo por aviso: "expira<TAB>texto"), as 30 mais recentes; o
# clique na faixa abre o histórico. faixa_notif=0 no config desliga a linha (padrão: ligada;
# desligada no Termux, onde a tela é baixa). tarefas_notificar espelha aqui, então lembretes de
# prazo e e-mails novos entram na faixa de graça.
DIR_NOTIFS=$ESTADO_DIR/notifs

# Quantas linhas a barra tem: 3 (margem, janelas, fixadas), ou 4 com a faixa de notificações. Sem réguas:
# as faixas se distinguem só pelo fundo. TODO caminho que mexe no número de linhas passa por aqui — dois
# pontos discordando faziam a faixa piscar.
barra_status_linhas() { if faixa_notif_ativa; then echo 4; else echo 3; fi; }

faixa_notif_ativa() {
  local v; v=$(conf faixa_notif)
  [[ -n $v ]] && { [[ $v != 0 ]]; return; }
  ! command -v termux-open-url >/dev/null
}

notificar() { # texto [segundos (padrão 300)] [ação: email|tarefas|calendario|cmd:...]
  local txt=${1:-} dura=${2:-300} acao=${3:-}
  [[ -n $txt ]] || return 0
  mkdir -p "$DIR_NOTIFS"
  printf '%s\t%s\t%s\n' "$(( $(date +%s) + dura ))" "${txt//$'\n'/ }" "$acao" >"$DIR_NOTIFS/$(date +%s%N)"
  ls -1 "$DIR_NOTIFS" 2>/dev/null | sort | head -n -30 | while read -r f; do rm -f "$DIR_NOTIFS/$f"; done
  atualizar_barras
}

# O slot dos avisos é o segmento CENTRAL da faixa, delimitado por │ │: ancorado no meio, nunca
# cola nos chips da esquerda nem foge do relógio — e nunca os cobre: o texto é orçado pela janela
# mais estreita (sobra dos vizinhos: ~16 à esquerda, ~30 à direita) e truncado com …; abaixo de
# 90 colunas vira só o crachá 🔔 N. TT_FAIXA_LARGURA força a largura (testes).
# Só os avisos vigentes (para o fmt e para o letreiro ceder a vez).
# No slot, só os avisos FRESCOS (nascidos há < TT_NOTIF_SLOT s; padrão 10): piscam ali e depois
# vivem só na central (🔔), em negrito até serem abertos (marca <id>.lida).
barra_notifs_avisos() {
  local agora exp txt _a f itens="" n=0 ns
  agora=$(date +%s)
  for f in $(ls -1r "$DIR_NOTIFS" 2>/dev/null | grep -v '\.lida$' | head -6); do
    IFS=$'\t' read -r exp txt _a <"$DIR_NOTIFS/$f" || continue
    [[ $exp =~ ^[0-9]+$ ]] && ((exp > agora)) || continue
    ns=${f:0:10}; [[ $ns =~ ^[0-9]+$ ]] || continue
    (( agora - ns < ${TT_NOTIF_SLOT:-10} )) || continue
    n=$((n + 1)); itens+="${itens:+  ·  }${txt}"
  done
  printf '%s\t%s' "$n" "$itens"
}

barra_notifs_fmt() {
  # O miolo da faixa (letreiro, aviso fresco, transferência) é desenhado por UM processo leve por
  # cliente — letreiro-tt.py fluxo — ligado aqui como #() da status line. É a única via que atualiza
  # a barra sem redesenhar a tela inteira: o tmux lê cada linha que ele imprime e redesenha só a
  # status line daquele cliente (no máximo 1 vez/s); já qualquer set-option, até de @opção, redesenha
  # tudo em todos os clientes (era o flicker do laço antigo, que gravava @barra_ticker a cada passo).
  # O comando só muda quando a pasta do tt muda; o tmux cria um processo por cliente, passa o terminal
  # dele (largura por ioctl: redimensionar não reinicia nada) e o encerra quando o cliente sai. Um
  # refresh-client recria esses processos — por isso ninguém força refresh em regime. Sem python3,
  # ou com a faixa desligada, o slot fica vazio.
  faixa_notif_ativa || return 0
  command -v python3 >/dev/null || return 0
  # O 3º argumento é a largura que o tmux mede (#{w:}) das partes esquerda e direita da mesma linha:
  # o slot ocupa exatamente o que sobra. Só muda com o nº de dígitos do 📧 ou do relógio/versão.
  # O 4º é #{client_width}: o tty de um cliente por ssh (Tailscale SSH) é do root e o ioctl falha. Ao
  # redimensionar o tmux cria um processo novo; o antigo percebe que foi substituído e sai.
  # ticker_fps (1 a 6, padrão 4) = quadros por segundo do letreiro. Cada #() redesenha a barra no
  # máximo 1 vez/s, mas o tmux guarda a última linha lida de cada um: o pintor (fluxo) imprime um
  # quadro novo a cada 1/fps s e fps-1 gatilhos (linhas vazias, 1/s, defasadas) provocam os
  # redesenhos entre os segundos, cada um logo depois de um quadro novo.
  local fps k; fps=$(conf ticker_fps); [[ $fps =~ ^[1-6]$ ]] || fps=4
  printf '#(python3 -I %s fluxo #{client_tty} #{client_pid} #{e|+:#{w:#{E:@barra_faixa}},#{w:#{E:@barra_faixa_dir}}} #{client_width} %s)' "$DIR_TT/letreiro-tt.py" "$fps"
  for ((k = 1; k < fps; k++)); do printf '#(python3 -I %s gatilho #{client_pid} %s %s)' "$DIR_TT/letreiro-tt.py" "$k" "$fps"; done
}

# --- Letreiro do slot (sem aviso novo, infos roladas: dólar, frases, notícias; indicadores= no config)
#
# As FONTES são atualizadas pelo vigia com cache e TTL (rede nunca no letreiro) em $DIR_TICKER, uma
# por arquivo; quem desenha é o letreiro-tt.py de cada cliente (ligado por barra_notifs_fmt), que só
# lê esses arquivos — itens separados por " • ", numa roda, em páginas ou deslizando (ticker_rolagem,
# ticker_veloc). indicadores=0 desliga. Fonte nova = um case em ticker_fonte_atualizar + uma linha
# no README.
DIR_TICKER=$HOME/.cache/tt-ticker

ticker_fontes() {
  local v; v=$(conf indicadores)
  [[ $v == 0 ]] && return 0
  [[ -n $v ]] || v="dolar,frases,noticias" # ligado de fábrica; indicadores=0 desliga
  tr ', ' '\n\n' <<<"$v" | awk 'NF'
}

ticker_fonte_atualizar() { # fonte  (escreve $DIR_TICKER/<fonte> se o TTL venceu)
  local f=$1 arq="$DIR_TICKER/$1" ttl=600 agora; agora=$(date +%s)
  [[ -f $arq ]] && (( agora - $(stat -c %Y "$arq" 2>/dev/null || echo 0) < ttl )) && return 0
  mkdir -p "$DIR_TICKER"
  case $f in
    dolar)
      curl -fsS -m 10 'https://economia.awesomeapi.com.br/json/last/USD-BRL' 2>/dev/null |
        python3 -I -c 'import json,sys
try:
    u = json.load(sys.stdin)["USDBRL"]
    v = u["bid"].replace(".", ",")[:5]; p = float(u["pctChange"])
    print(f"💵 dólar R$ {v} {chr(9650) if p >= 0 else chr(9660)}{abs(p):.1f}%")
except Exception: pass' >"$arq.tmp" 2>/dev/null && [[ -s $arq.tmp ]] && mv "$arq.tmp" "$arq" || rm -f "$arq.tmp" ;;
    frases)
      printf '%s\n' \
        '“A simplicidade é o último grau de sofisticação.” — Leonardo da Vinci' \
        '“Feito é melhor que perfeito.”' \
        '“O obstáculo é o caminho.” — Marco Aurélio' \
        '“Quem controla o passado controla o futuro.” — Orwell' \
        '“Deixe o código melhor do que o encontrou.”' \
        '“Nada é tão permanente quanto uma solução temporária.”' | shuf -n1 >"$arq" ;;
    noticias)
      ttl=900
      [[ -f $arq ]] && (( agora - $(stat -c %Y "$arq" 2>/dev/null || echo 0) < ttl )) && return 0
      { curl -fsS -m 12 'https://g1.globo.com/rss/g1/' 2>/dev/null | python3 -I -c 'import sys, xml.etree.ElementTree as ET
try:
    for i, t in enumerate(ET.fromstring(sys.stdin.read()).findall(".//item/title")[:2]):
        print("📰", t.text.strip()[:90])
except Exception: pass'
        curl -fsS -m 12 'https://feeds.bbci.co.uk/news/world/rss.xml' 2>/dev/null | python3 -I -c 'import sys, xml.etree.ElementTree as ET
try:
    for i, t in enumerate(ET.fromstring(sys.stdin.read()).findall(".//item/title")[:2]):
        print("🌍", t.text.strip()[:90])
except Exception: pass'; } >"$arq.tmp" 2>/dev/null
      [[ -s $arq.tmp ]] && mv "$arq.tmp" "$arq" || rm -f "$arq.tmp" ;;
    *)
      # Fonte do usuário: indicador_<nome>=URL ;; rótulo ;; caminho.no.json ;; ttl ;; header
      # caminho "-" = texto cru (1ª linha). header opcional (APIs com chave): "Nome: valor", e
      # "@arquivo" no valor lê ~/.secrets/arquivo (a chave não fica no config). Ex.:
      #   indicador_btc=https://api.coinbase.com/v2/prices/BTC-USD/spot ;; ₿ ;; data.amount ;; 300
      local def url rot cam h hdr
      def=$(conf "indicador_$f"); [[ -n $def ]] || return 0
      IFS='|' read -r url rot cam ttl hdr < <(sed 's/ *;; */|/g' <<<"$def")
      [[ $ttl =~ ^[0-9]+$ ]] || ttl=600
      [[ -f $arq ]] && (( agora - $(stat -c %Y "$arq" 2>/dev/null || echo 0) < ttl )) && return 0
      [[ $url == https://* ]] || return 0
      local -a hcurl=()
      if [[ -n $hdr ]]; then
        h=${hdr#*: }; [[ $h == @* ]] && h=$(cat "$HOME/.secrets/${h#@}" 2>/dev/null)
        [[ -n $h ]] && hcurl=(-H "${hdr%%:*}: $h")
      fi
      curl -fsS -m 12 "${hcurl[@]}" "$url" 2>/dev/null | CAM="$cam" ROT="$rot" python3 -I -c 'import sys, os, json
cam = os.environ["CAM"]; rot = os.environ["ROT"]
t = sys.stdin.read()
try:
    if cam == "-": v = t.strip().splitlines()[0][:60]
    else:
        d = json.loads(t)
        for parte in cam.split("."):
            d = d[int(parte)] if isinstance(d, list) else d[parte]
        v = str(d)[:60]
    if v: print((rot + " " + v).strip()[:90])
except Exception: pass' >"$arq.tmp" 2>/dev/null
      [[ -s $arq.tmp ]] && mv "$arq.tmp" "$arq" || rm -f "$arq.tmp" ;;
  esac
}

ticker_linha_montar() { # junta as fontes ativas em uma linha " item • item • "
  local f linha=""
  for f in $(ticker_fontes); do
    [[ -s $DIR_TICKER/$f ]] && while IFS= read -r l; do [[ -n $l ]] && linha+="${linha:+ • }$l"; done <"$DIR_TICKER/$f"
  done
  printf '%s' "$linha"
}

ticker_atualizar_fontes() { local f; for f in $(ticker_fontes); do ticker_fonte_atualizar "$f"; done; }

# Clique na faixa: abre o destino do aviso mais recente (📧 → e-mail, 📋 → tarefas); sem ação,
# o histórico. notif_abrir é o dicionário de destinos — novos indicadores registram os seus aqui.
notif_abrir() { # ação cliente
  local acao=$1 c=$2
  # Dentro de um popup o tmux não abre outro por cima: agenda a abertura para logo após fechar
  # (⏎ no histórico não abria o e-mail por isso).
  if em_popup; then
    local cmd="sleep 0.3; $EU --notif-abrir $(q "$acao") $(q "$c")"
    tmux run-shell -b "${cmd//#/##}" 2>/dev/null
    return 0
  fi
  case $acao in
    email:*) email_ir_novo "${acao#email:}" "$c" ;;   # aviso de e-mail novo: vai à conta e à mensagem (:check-mail vai dentro)
    email) botao_email "$c" ;;
    tarefas) abrir_tarefas "$c" ;;
    calendario) abrir_calendario "$c" ;;
    cmd:*) rodar_fora 0 "${acao#cmd:}" ;;
    *) return 1 ;;
  esac
}

notifs_clique() { # cliente
  local c=$1 f exp txt acao agora; agora=$(date +%s)
  for f in $(ls -1r "$DIR_NOTIFS" 2>/dev/null | grep -v '\.lida$' | head -6); do
    IFS=$'\t' read -r exp txt acao <"$DIR_NOTIFS/$f" || continue
    [[ $exp =~ ^[0-9]+$ ]] && ((exp > agora)) || continue
    [[ -n $acao ]] && notif_abrir "$acao" "$c" && { : >"$DIR_NOTIFS/$f.lida"; atualizar_barras; return 0; }
    break
  done
  notifs_popup "$c"
}

# Histórico num popup (clique direito na faixa ou tt --notifs): o que já passou, com hora; ⏎ abre
# o destino do aviso escolhido.
notifs_popup() {
  local c=${1:-$(tmux display-message -p '#{client_name}' 2>/dev/null)}
  [[ -n $c ]] || return 0
  tmux display-popup -c "$c" -E -w 86 -h 18 -b rounded -T ' 🔔 notificações ' "$EU --notifs-ui $(q "$c")"
}
# Quando um aviso nasceu, para a central: "Hoje 08:12", "Ontem 22:05" ou "08/10 22:05" (o ano só
# aparece quando não é o corrente) — só a hora não distinguia hoje de ontem.
notif_quando() { # epoch
  local ep=$1 dia hoje
  dia=$(date -d "@$ep" +%F 2>/dev/null) || return 0
  hoje=$(date +%F)
  if [[ $dia == "$hoje" ]]; then printf 'Hoje  %s' "$(date -d "@$ep" +%H:%M)"
  elif [[ $dia == "$(date -d yesterday +%F)" ]]; then printf 'Ontem %s' "$(date -d "@$ep" +%H:%M)"
  elif [[ ${dia:0:4} == "${hoje:0:4}" ]]; then date -d "@$ep" '+%d/%m %H:%M'
  else date -d "@$ep" '+%d/%m/%y %H:%M'; fi
}
notifs_ui() {
  local c=${1:-} f exp txt acao esc
  lista() {
    local neg=$'\033[1m' z=$'\033[0m' m
    for f in $(ls -1r "$DIR_NOTIFS" 2>/dev/null | grep -v '\.lida$'); do
      IFS=$'\t' read -r exp txt acao <"$DIR_NOTIFS/$f" || continue
      [[ -n $txt ]] || continue
      m=""; [[ -f $DIR_NOTIFS/$f.lida ]] || m=$neg # não lida em negrito
      printf '%s\t%s\t%s%s  %s%s%s\n' "${acao:-}" "$f" "$m" "$(notif_quando "${f:0:10}")" "$txt" "${acao:+  ↗}" "$z"
    done
  }
  if command -v fzf >/dev/null && [[ -t 1 ]]; then
    esc=$(lista | fzf --ansi --delimiter=$'\t' --with-nth=3 --layout=reverse --no-sort --no-input \
      --header='⏎ abre o destino (↗, e marca como lida) · Esc fecha' --bind 'q:abort') || return 0
    acao=$(cut -f1 <<<"$esc"); f=$(cut -f2 <<<"$esc")
    [[ -n $f && -f $DIR_NOTIFS/$f ]] && { : >"$DIR_NOTIFS/$f.lida"; atualizar_barras >/dev/null 2>&1; }
    [[ -n $acao ]] && notif_abrir "$acao" "${c:-$(tmux display-message -p '#{client_name}' 2>/dev/null)}"
  else lista | cut -f3-; fi
  return 0
}

tarefas_notificar() { # titulo corpo [ação para o clique na faixa]
  local t=$1 c=$2 cl ok=1
  notificar "$t · $c" 600 "${3:-}"
  # Com a faixa ligada o aviso JÁ aparece nela: o display-message por cima da 1ª linha vira
  # redundância que cobre a barra — só entra quando a faixa está desligada.
  if faixa_notif_ativa; then
    command -v notify-send >/dev/null 2>&1 && notify-send -a tt "$t" "$c" >/dev/null 2>&1
    command -v termux-notification >/dev/null 2>&1 && termux-notification --title "$t" --content "$c" >/dev/null 2>&1
    return 0
  fi
  if command -v notify-send >/dev/null 2>&1; then notify-send -a tt "$t" "$c" >/dev/null 2>&1 && ok=0
  elif command -v termux-notification >/dev/null 2>&1; then termux-notification --title "$t" --content "$c" >/dev/null 2>&1 && ok=0; fi
  # Também na tela de cada terminal aberto (no WSL não há notify-send).
  while read -r cl; do
    [[ -n $cl ]] && tmux display-message -c "$cl" -d 15000 "$t · $c" 2>/dev/null && ok=0
  done < <(tmux list-clients -F '#{client_name}' 2>/dev/null)
  return $ok
}
tarefas_lembrete() {
  [[ ${TT_TAREFAS_LEMBRETE:-1} == 0 ]] && return 0
  [[ -s $CONF_TAREFAS ]] || return 0
  local arq agora tz ant chave quando txt
  arq=$(tarefas_lembrete_arq); mkdir -p "$ESTADO_DIR"; touch "$arq"
  read -r agora tz < <(tarefas_relogio); ant=$(( ${TT_TAREFAS_ANTECEDENCIA:-10} * 60 ))
  # Com horário: avisa quando faltam ANT segundos (ou já passou), uma vez por prazo (id|epoch).
  # Sem horário: uma vez por dia enquanto vence hoje ou está atrasada (id|AAAAMMDD).
  while IFS=$'\t' read -r chave quando txt; do
    grep -qxF "$chave" "$arq" && continue
    tarefas_notificar "📋 $quando" "$txt" tarefas && printf '%s\n' "$chave" >>"$arq"
  done < <(LC_ALL=C awk -F'\t' -v NOW="$agora" -v TZOFF="$tz" -v ANT="$ant" "$TAREFAS_AWK"'
    NF >= 5 && valida($1, $2) && $2 == "aberta" && mv($6, "pai") == "" && !($1 in v) {
      v[$1] = 1; p = mv($6, "prazo"); if (p == "") next
      if (mv($6, "hora") == 1) {
        if (NOW >= p - ANT) print $1 "|" p "\t" (NOW > p + 60 ? "Venceu às " : "Às ") hhmm(p) "\t" $5
      } else if (dia(p) <= dia(NOW)) {
        civil(dia(NOW)); print $1 "|" sprintf("%04d%02d%02d", CY, CM, CD) "\t" (dia(p) < dia(NOW) ? "Tarefa atrasada" : "Tarefa de hoje") "\t" $5
      }
    }' "$CONF_TAREFAS")
  # Poda: guarda só as chaves de hoje e as de prazos dos últimos 2 dias.
  local hoje tmp; hoje=$(date +%Y%m%d); tmp=$(mktemp)
  awk -F'|' -v h="$hoje" -v lim="$((agora - 172800))" '$2 == h || ($2 ~ /^[0-9]+$/ && length($2) >= 10 && $2 + 0 >= lim)' "$arq" >"$tmp" &&
    mv "$tmp" "$arq" 2>/dev/null || rm -f "$tmp"
  return 0
}

# --- barra e UI ------------------------------------------------------------

# Botão do canto direito da 2ª linha, ao lado do relógio/versão: 📋 com a contagem de abertas.
# Quando há tarefa aberta vencida ou de hoje, o botão fica VERMELHO com ⚠ e a contagem de urgentes,
# para o prazo "trabalhar por você" sem precisar abrir o painel.
# --- painel de tarefas -------------------------------------------------------
#
# O painel é um fzf só, com três modos (lista, ajuda e o menu de ações de uma tarefa), guardados
# no arquivo de estado da UI. Toda tecla, clique e botão passa por tarefas_acao, que devolve as
# ações do fzf (transform): assim teclado, mouse e botões fazem exatamente a mesma coisa.
#
# Cada linha da lista é "chave<TAB>desenho". A chave diz o que a linha é:
#   ID            tarefa ou subtarefa
#   menu:ID       o "⋯ menu" discreto sob a tarefa aberta (e as linhas do menu de ações)
#   desc:ID/sub:ID chaves antigas das linhas de descrição/subtarefa (ainda aceitas pelo despachante)
#   criar         cria a tarefa digitada na busca
#   dia:N         título de um dia na agenda (N = dias desde 1970; clique abre o calendário nele)
#   act:AÇÃO:ID   item do menu de ações               voltar   volta para a lista
#   (vazia)       linha só informativa
#
# A renderização é uma passada de awk (rápida mesmo com centenas de tarefas): roda em LC_ALL=C,
# o texto passa intacto byte a byte e nenhuma conta depende de largura de caractere.

# Funções awk comuns: valor da meta, dia local de um epoch, data civil (sem strftime, que o mawk
# não tem) e o rótulo do prazo.
TAREFAS_AWK='
function mv(meta, k,   n, a, i) {
  n = split(meta, a, "|")
  for (i = 1; i <= n; i++) if (index(a[i], k "=") == 1) return substr(a[i], length(k) + 2)
  return ""
}
function valida(id, est) {
  return id ~ /^[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/ && (est == "aberta" || est == "feita")
}
function dia(ep) { return int((ep + TZOFF) / 86400) }
function civil(z,   era, doe, yoe, doy, mp) {
  z += 719468; era = int(z / 146097); doe = z - era * 146097
  yoe = int((doe - int(doe / 1460) + int(doe / 36524) - int(doe / 146096)) / 365)
  doy = doe - (365 * yoe + int(yoe / 4) - int(yoe / 100)); mp = int((5 * doy + 2) / 153)
  CD = doy - int((153 * mp + 2) / 5) + 1; CM = (mp < 10 ? mp + 3 : mp - 9); CY = yoe + era * 400 + (CM <= 2)
}
# Ordem das tarefas de topo: abertas antes das feitas; prioridade alta antes; ordem manual (ord, 0 =
# sem posição); a mais nova primeiro; o id desempata. Chave de largura fixa, comparada como texto.
function chave_ordem(id, est, criada, meta,   p, o) {
  p = mv(meta, "prio"); o = mv(meta, "ord") + 0
  return sprintf("%d%d%09d%010d%s", (est == "aberta" ? 0 : 1), (p == 1 ? 0 : (p == 2 ? 1 : 2)), \
                 (o == 0 ? 999999999 : o), 9999999999 - criada, id)
}
function cores() {
  Z = "\033[0m"; NEG = "\033[1m"; RISCO = "\033[9m"; ITAL = "\033[3m"
  TXT = "\033[38;2;205;214;244m"; SUB = "\033[38;2;166;173;200m"; DIM = "\033[38;2;108;112;134m"
  AZUL = "\033[38;2;137;180;250m"; VERDE = "\033[38;2;166;227;161m"; AMAR = "\033[38;2;249;226;175m"
  VERM = "\033[38;2;243;139;168m"; PESS = "\033[38;2;250;179;135m"; LILAS = "\033[38;2;203;166;247m"
  TEAL = "\033[38;2;148;226;213m"
  split("dom seg ter qua qui sex sáb", DOW, " ")
}
function hhmm(ep,   s) { s = (ep + TZOFF) % 86400; return sprintf("%02d:%02d", int(s / 3600), int(s % 3600 / 60)) }
# Com horário vence quando a hora passa; sem horário, quando o dia passa.
function vencida(p, hora) { return hora ? NOW > p : dia(p) < dia(NOW) }
# Corta em N bytes sem partir um caractere UTF-8 (roda em LC_ALL=C).
function corta(s, n,   c) {
  if (n < 8) n = 8
  if (length(s) <= n) return s
  while (n > 0 && (c = substr(s, n + 1, 1)) >= "\200" && c < "\300") n--
  return substr(s, 1, n) "…"
}
# base64 -> texto (bytes; em LC_ALL=C o %c devolve o byte, então UTF-8 passa intacto).
function b64d(s,   i, n, c, bits, nb, v, out) {
  if (!B64OK) { for (i = 0; i < 64; i++) B64[substr("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", i + 1, 1)] = i; B64OK = 1 }
  out = ""; bits = 0; nb = 0; n = length(s)
  for (i = 1; i <= n; i++) {
    c = substr(s, i, 1); if (c == "=") break
    if (!(c in B64)) continue
    bits = bits * 64 + B64[c]; nb += 6
    if (nb >= 8) { nb -= 8; v = int(bits / 2 ^ nb); bits -= v * 2 ^ nb; out = out sprintf("%c", v) }
  }
  return out
}
# "hoje", "amanhã", "ontem", "sex 10/10" (até 6 dias), "25/12" ou "25/12/27" (outro ano).
function quando(p,   d, df, s) {
  d = dia(p); df = d - HOJE; civil(d)
  s = sprintf("%02d/%02d", CD, CM); if (CY != ANO) s = s sprintf("/%02d", CY % 100)
  if (df == 0) return "hoje"
  if (df == 1) return "amanhã"
  if (df == -1) return "ontem"
  if (df > 1 && df < 7) return DOW[(d + 4) % 7 + 1] " " s
  return s
}
function rotulo_prazo(p, est, hora,   df, h) {
  if (p == "") return ""
  df = dia(p) - HOJE; h = (hora ? " " hhmm(p) : "")
  if (est == "feita") return DIM "◷ " quando(p) h Z
  if (vencida(p, hora)) return VERM NEG "◷ venceu " quando(p) h Z
  if (df == 0) return PESS NEG "◷ hoje" h Z
  if (df == 1) return AMAR "◷ amanhã" h Z
  return SUB "◷ " quando(p) h Z
}
'

tarefas_relogio() { # -> "agora deslocamento-do-fuso-em-segundos"
  local z s off; z=$(date +%z); s=${z:0:1}
  off=$(( 10#${z:1:2} * 3600 + 10#${z:3:2} * 60 )); [[ $s == - ]] && off=$((-off))
  echo "$(date +%s) $off"
}

# Contagem das tarefas de topo: "hoje abertas feitas com-prazo todas" (hoje = abertas vencidas ou
# que vencem hoje) e, no 7º campo, as ATRASADAS (já passaram do prazo: dia anterior, ou hora marcada
# que já foi). Só elas deixam o botão da barra e a aba Hoje laranja (#fab387, sem trocar o 📋); o que vence hoje e ainda
# não passou fica âmbar. Uma passada só; serve às abas do painel e ao botão da barra.
tarefas_contagens() {
  [[ -s $CONF_TAREFAS ]] || { echo "0 0 0 0 0 0 0"; return 0; }
  local agora tz; read -r agora tz < <(tarefas_relogio)
  LC_ALL=C awk -F'\t' -v NOW="$agora" -v TZOFF="$tz" "$TAREFAS_AWK"'
    NF >= 5 && valida($1, $2) && !($1 in v) && mv($6, "pai") == "" {
      v[$1] = 1; t++
      if ($2 == "aberta") a++; else f++
      p = mv($6, "prazo")
      if (p != "" && $2 == "aberta") { z++; if (dia(p) <= dia(NOW)) h++
        if (mv($6, "hora") == 1 ? p < NOW : dia(p) < dia(NOW)) x++ }
    }
    NF >= 5 && $2 == "arquivada" && !($1 in w) && mv($6, "pai") == "" { w[$1] = 1; q++ }
    END { printf "%d %d %d %d %d %d %d\n", h, a, f, z, t, q, x }' "$CONF_TAREFAS"
}
tarefas_hoje_n() { local c; read -ra c < <(tarefas_contagens); echo "${c[0]}"; }
barra_tarefas_fmt() {
  local h n a x; read -r h n a a a a x < <(tarefas_contagens)
  if ((x > 0)); then
    printf '#[range=user|tarefas]#[fg=#1e1e2e,bg=#fab387,bold] 📋 %s #[norange]#[default] ' "$x"
  elif ((n > 0)); then
    printf '#[range=user|tarefas]#[fg=#1e1e2e,bg=#f9e2af,bold] 📋 %s #[norange]#[default] ' "$n"
  else
    printf '#[range=user|tarefas]#[fg=#a6adc8] 📋 #[norange]#[default] '
  fi
}

# Abre o painel de tarefas como um slide-over ANCORADO À DIREITA (display-popup -x), altura toda.
# Recolher = sair da UI interna (esc/q), que fecha o popup. Em tela estreita (celular) ocupa tudo.
abrir_tarefas() {
