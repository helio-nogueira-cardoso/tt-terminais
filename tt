# Clique no letreiro (range user|letreiro): a ação cadastrada na fonte do item sob o mouse; sem ação,
# pausa/continua. O desenhista guardou a geometria do slot; o item é o que se vê naquela coluna.
letreiro_clique() { # cliente x
  local c=$1 x=${2:-0} pid r acao alvo
  pid=$(do_cliente "$c" '#{client_pid}')
  [[ $pid =~ ^[0-9]+$ ]] || return 0
  r=$(python3 -I "$DIR_TT/letreiro-tt.py" clique "$pid" "$x" 2>/dev/null) || return 0
  IFS=$'\t' read -r acao alvo <<<"$r"
  case $acao in
    url) [[ $alvo == http://* || $alvo == https://* ]] && link_abrir "" "$c" "$(do_cliente "$c" '#{pane_id}')" "$alvo" ;;
    copiar) [[ -n $alvo ]] && { printf '%s' "$alvo" | copiar; tmux display-message -c "$c" -d 1500 "copiado: ${alvo:0:60}" 2>/dev/null; } ;;
    painel)
      case $alvo in
        tarefas) abrir_tarefas "$c" ;;
        email) botao_email "$c" ;;
        calendario) abrir_calendario "$c" ;;
        notificacoes) notifs_popup "$c" ;;
        letreiro) eval "$(popup_tt "$c" "📰 letreiro" "$EU --letreiro-ui")" ;;
        central) tmux display-popup -c "$c" -E $(tam_popup "$c") "TT_CLIENTE=$(q "$c") $EU" ;;
      esac ;;
    pausa) TT_RT=$RT python3 -I "$DIR_TT/letreiro-tt.py" pausar >/dev/null ;;
  esac
  return 0
}

# Clique na faixa: abre o destino do aviso mais recente (📧 → e-mail, 📋 → tarefas); sem ação,
# o histórico. notif_abrir é o dicionário de destinos — novos indicadores registram os seus aqui.
notif_abrir() { # ação cliente
  local acao=$1 c=$2
  # Dentro de um popup o tmux não abre outro por cima: agenda a abertura para logo após fechar
  # (⏎ no histórico não abria o e-mail por isso).
  if em_popup; then
    # Com o e-mail (aerc) na frente nada fecharia sozinho: solta o popup do e-mail (a sessão oculta
    # segue viva) para que a tela pedida abra por cima do terminal, não por baixo de um popup preso.
    [[ $(tmux display -p -t "=$EMAIL_SESSAO:" '#{session_attached}' 2>/dev/null) =~ ^[1-9] ]] &&
      tmux detach-client -s "=$EMAIL_SESSAO" 2>/dev/null
    local cmd="sleep 0.3; $EU --notif-abrir $(q "$acao") $(q "$c")"
    tmux run-shell -b "${cmd//#/##}" 2>/dev/null
    return 0
  fi
  case $acao in
    email:*) email_ir_novo "${acao#email:}" "$c" ;;   # aviso de e-mail novo: vai à conta e à mensagem (:check-mail vai dentro)
    email) botao_email "$c" ;;
    novidades) tmux display-popup -c "$c" -E $(tam_popup "$c") -T ' 📰 novidades do tt ' "$EU --novidades" ;;
    checagem:*) tmux display-popup -c "$c" -E $(tam_popup "$c") -T ' 🩺 checagem do tt ' "$EU --checar-ver $(q "${acao#checagem:}")" ;;
    pendencias) popup_fixo -c "$c" -E $(dim_popup "$c" 92 22) -b rounded -S 'fg=#f9e2af' -T ' 📦 pendências de instalação ' "$EU --pedir-sudo" ;;
    tarefas) abrir_tarefas "$c" ;;
    demandas) tarefas_filtro_set entrada; abrir_tarefas "$c" ;;
    calendario) abrir_calendario "$c" ;;
    tarefas-sync) eval "$(popup_tt "$c" "🔄 sincronização das tarefas" "$EU --tarefas-sync-ui")" ;;
    letreiro) eval "$(popup_tt "$c" "📰 letreiro" "$EU --letreiro-ui")" ;;
    cmd:*) rodar_fora 0 "${acao#cmd:}" ;;
    sessao:*) notif_ir_sessao "${acao#sessao:}" "$c" ;;
    *) return 1 ;;
  esac
}

# Aviso de um agente (tt --notificar-daqui): o clique leva o cliente à sessão e ao painel de onde
# o aviso saiu. "sessão|painel"; sem a sessão (fechada depois do aviso), só avisa.
notif_ir_sessao() { # "sessão|painel" cliente
  local spec=$1 c=$2 origem= s p atual
  if [[ $spec == *'|'*'|'* ]]; then
    origem=${spec%%|*}; spec=${spec#*|}; s=${spec%%|*}; p=${spec#*|}
    if [[ -n $origem && $origem != "$MAQUINA" ]]; then TT_CLIENTE=$c ir_para "$origem" "$s"; return $?; fi
  else s=${spec%%|*}; p=${spec#*|}; fi
  # O nome da sessão muda (o nomeador renomeia conforme o assunto); o id do painel não. Vale o nome
  # que o painel tem AGORA; o gravado só serve se o painel já não existe.
  [[ $p == %* ]] && atual=$(tmux display-message -p -t "$p" '#{session_name}' 2>/dev/null) && [[ -n $atual ]] && s=$atual
  if ! tmux has-session -t "=$s" 2>/dev/null; then
    tmux display-message -c "$c" -d 4000 "A sessão $s não existe mais" 2>/dev/null
    return 0
  fi
  [[ -n $p && $p == %* ]] && { tmux select-window -t "$p" && tmux select-pane -t "$p"; } 2>/dev/null
  TT_CLIENTE=$c ir_para . "$s"
}

# Alguém está olhando para a janela W da sessão S: um cliente com foco (focus-events) mostrando
# S com W como janela atual. Vale para vistas aninhadas (painel do tt com outra sessão): o cliente
# de dentro só tem foco quando o painel de fora tem.
usuario_olhando() { # sessão window_id
  tmux list-clients -F '#{client_session}'$'\t''#{client_flags}'$'\t''#{window_id}' 2>/dev/null |
    awk -F'\t' -v s="$1" -v w="$2" '$1 == s && $3 == w && $2 ~ /(^|,)focused(,|$)/ { achou = 1 } END { exit !achou }'
}

# Para agentes de IA (e scripts) que rodam num painel do tt: avisa o usuário pelo 🔔 (contador na barra
# e central, com um clique que leva de volta a este painel; também na notificação do sistema, onde
# houver) — sem piscar no miolo da faixa. O aviso fica no contador até ser aberto (padrão 24 h; o
# 2º argumento troca). Se o usuário já está olhando para esta janela, não avisa (imprime "vendo");
# --sempre avisa assim mesmo. Fora do tmux, vira um aviso do 🔔 sem destino. Imprime "notificado" ou "vendo".
notificar_daqui() { # [--sempre] texto [segundos (padrão 86400)] [--sempre]
  local txt="" dura=86400 sempre=0 a p s w canal=""
  local -a args=()
  for a in "$@"; do
    if [[ $a == --sempre ]]; then sempre=1; else args+=("$a"); fi
  done
  txt=${args[0]:-}
  for a in "${args[@]:1}"; do
    case $a in ''|*[!0-9]*) ;; *) dura=$a ;; esac
  done
  [[ -n $txt ]] || { echo 'uso: tt --notificar-daqui [--sempre] "texto" [segundos] [--sempre]' >&2; return 1; }
  faixa_notif_ativa && canal=sino
  p=${TMUX_PANE:-}
  if [[ -z $p ]] || ! s=$(tmux display-message -p -t "$p" '#{session_name}' 2>/dev/null); then
    notificar "$txt" "$dura" "" "$canal"; echo notificado; return 0
  fi
  w=$(tmux display-message -p -t "$p" '#{window_id}' 2>/dev/null)
  if ((sempre == 0)) && usuario_olhando "$s" "$w"; then echo vendo; return 0; fi
  tarefas_notificar "🤖 $s" "$txt" "sessao:$MAQUINA|$s|$p" "$canal" "$dura" >/dev/null 2>&1
  echo notificado
}

# Terminal interativo permanente para agentes (tt --pty). O Bash de uma IA não tem tty: sudo, ssh, vim, instaladores e
# qualquer "Password:" ficam inalcançáveis. Aqui o agente abre uma sessão tmux própria (ia-pty-NOME), digita nela, lê a
# tela e espera por um texto; o usuário entra na mesma sessão (tt --pty entrar) para digitar o que o agente não deve
# ver, como a senha. Só usa o tmux: igual no Linux e no macOS.
pty_agente() { # ação [NOME] args…
  local acao=${1:-} nome s tela n rx seg
  case $acao in
    abrir|enviar|tecla|ler|esperar|entrar|fechar|listar) shift ;;
    *) cat >&2 <<'FIM_USO'
uso: tt --pty AÇÃO [NOME] …    (NOME padrão: padrao; a sessão se chama ia-pty-NOME)
  abrir  [NOME] [PASTA]          cria a sessão (ou reaproveita) e imprime o nome dela
  enviar [NOME] [--sem-enter] T  digita o texto T (literal) e Enter
  tecla  [NOME] TECLA…           envia teclas do tmux: C-c, Enter, Up, y …
  ler    [NOME] [LINHAS]         imprime a tela (padrão: últimas 40 linhas)
  esperar [NOME] REGEX [SEG]     espera o REGEX (egrep) aparecer na tela; 0 achou, 1 acabou o tempo (padrão 30 s)
  entrar [NOME]                  leva o seu cliente à sessão (dentro do tmux: switch-client; fora: attach)
  fechar [NOME]                  encerra a sessão          listar    sessões ia-pty-* abertas
Senha: o agente NUNCA a digita. Ao ver "Password:" (esperar 'assword'), avise com tt --notificar-daqui "preciso da senha do sudo" --sempre e peça
ao usuário para rodar "tt --pty entrar NOME".
FIM_USO
       return 1 ;;
  esac
  if [[ $acao == listar ]]; then tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^ia-pty-' || true; return 0; fi
  # o NOME é opcional, mas só quando o 1º argumento não parece ser o resto da ação
  nome=padrao
  case $acao in
    abrir|entrar|fechar|ler|enviar|tecla|esperar)
      if [[ -n ${1:-} && ${1:-} != --* ]] && { [[ $acao == abrir || $acao == entrar || $acao == fechar ]] || tmux has-session -t "=ia-pty-${1//[^A-Za-z0-9_-]/_}" 2>/dev/null; }; then nome=$1; shift; fi ;;
  esac
  s=ia-pty-${nome//[^A-Za-z0-9_-]/_}
  if [[ $acao != abrir ]] && ! tmux has-session -t "=$s" 2>/dev/null; then
    echo "tt --pty: a sessão $s não existe (tt --pty abrir $nome)" >&2; return 1
  fi
  case $acao in
    abrir)
      if ! tmux has-session -t "=$s" 2>/dev/null; then
        tmux new-session -d -s "$s" -x 200 -y 50 -c "${1:-$PWD}" || return 1
      fi
      echo "$s" ;;
    enviar)
      local enter=1; [[ ${1:-} == --sem-enter ]] && { enter=0; shift; }
      tmux send-keys -t "=$s:" -l -- "$*" || return 1
      ((enter)) && tmux send-keys -t "=$s:" Enter
      return 0 ;;
    tecla) (($#)) || { echo "tt --pty tecla: faltou a tecla" >&2; return 1; }; tmux send-keys -t "=$s:" "$@" ;;
    ler)
      n=${1:-40}; [[ $n == *[!0-9]* ]] && n=40
      tmux capture-pane -p -J -S "-$n" -t "=$s:" | awk '{ l[NR] = $0 } NF { u = NR } END { for (i = 1; i <= u; i++) print l[i] }' | sed 's/[[:space:]]*$//' ;;
    esperar)
      rx=${1:-}; seg=${2:-30}; [[ -n $rx ]] || { echo "tt --pty esperar: faltou o REGEX" >&2; return 1; }
      [[ $seg == *[!0-9]* ]] && seg=30
      local fim=$((SECONDS + seg))
      while :; do
        tela=$(tmux capture-pane -p -J -t "=$s:" 2>/dev/null) || return 1
        grep -Eq -- "$rx" <<<"$tela" && return 0
        ((SECONDS >= fim)) && return 1
        sleep 0.3
      done ;;
    entrar) if [[ -n ${TMUX:-} ]]; then tmux switch-client -t "=$s"; else tmux attach -t "=$s"; fi ;;
    fechar) tmux kill-session -t "=$s" ;;
  esac
}

notifs_clique() { # cliente
  local c=$1 f exp txt acao canal agora; agora=$(date +%s)
  for f in $(notifs_ids | sort -rn | head -6); do
    [[ -f $DIR_NOTIFS/$f.lida ]] && continue
    IFS=$'\t' read -r exp txt acao canal _ <"$DIR_NOTIFS/$f" || continue
    [[ $acao == - ]] && acao=""
    [[ $canal == sino ]] && continue   # aviso de agente não está no slot: o clique do slot não o abre
    [[ $exp =~ ^[0-9]+$ ]] && ((exp > agora)) || continue
    [[ -n $acao ]] && notif_abrir "$acao" "$c" && { : >"$DIR_NOTIFS/$f.lida"; notifs_sincronizar_em_segundo_plano; atualizar_barras; return 0; }
    break
  done
  notifs_popup "$c"
}

# Histórico num popup (clique direito na faixa ou tt --notifs): o que já passou, com hora; ⏎ abre
# o destino do aviso escolhido.
notifs_popup() {
  local c=${1:-$(tmux display-message -p '#{client_name}' 2>/dev/null)}
  [[ -n $c ]] || return 0
  # Um modal/um leitor de e-mail por cliente: não empilhe a central sobre uma janela do tt nem sobre
  # o aerc. No painel flutuante, window_modal_pane identifica a janela já aberta; o aerc é uma sessão
  # oculta anexada enquanto seu popup está visível.
  [[ -n $(do_cliente "$c" '#{window_modal_pane}' 2>/dev/null) ]] && return 0
  [[ $(tmux display -p -t "=$EMAIL_SESSAO:" '#{session_attached}' 2>/dev/null) =~ ^[1-9] ]] && return 0
  popup_exclusivo_reservar notificacoes "$c" || return 0
  tmux display-popup -c "$c" -E $(dim_popup "$c" 92 26) -b rounded -T ' 🔔 notificações · esc fecha ' "$EU --notifs-ui $(q "$c")"
  local rc=$?; popup_exclusivo_liberar "$POPUP_EXCLUSIVO"; return "$rc"
}
# Quando um aviso nasceu, para a central: "Hoje 08:12", "Ontem 22:05" ou "08/10 22:05" (o ano só
# aparece quando não é o corrente) — só a hora não distinguia hoje de ontem.
notif_quando_em() { # VAR epoch — pelo printf do bash, sem processo (a central desenha dezenas por clique)
  local -n _qd=$1; local ep=$2 dia hoje ontem agora
  _qd=""; [[ $ep =~ ^[0-9]+$ ]] || return 0
  printf -v agora '%(%s)T' -1
  printf -v dia '%(%F)T' "$ep"; printf -v hoje '%(%F)T' "$agora"; printf -v ontem '%(%F)T' "$((agora - 86400))"
  if [[ $dia == "$hoje" ]]; then printf -v _qd 'Hoje  %(%H:%M)T' "$ep"
  elif [[ $dia == "$ontem" ]]; then printf -v _qd 'Ontem %(%H:%M)T' "$ep"
  elif [[ ${dia:0:4} == "${hoje:0:4}" ]]; then printf -v _qd '%(%d/%m %H:%M)T' "$ep"
  else printf -v _qd '%(%d/%m/%y %H:%M)T' "$ep"; fi
}
notif_quando() { # epoch
  local q; notif_quando_em q "$1"; printf '%s' "$q"
}
# Marca todos os avisos como lidos (^l na central): zera o contador do 🔔.
notifs_marcar_lidas() {
  local f
  for f in $(notifs_ids); do : >"$DIR_NOTIFS/$f.lida"; done
  notifs_sincronizar_em_segundo_plano
  atualizar_barras_pedir >/dev/null 2>&1
  return 0
}
notifs_apagar() { # ID único; lápide propagada evita ressurreição por outra máquina
  local f=${1:-}
  [[ $f =~ ^[0-9]{18,20}$ && -f $DIR_NOTIFS/$f ]] || return 1
  notifs_lapide "$f"
  rm -f "$DIR_NOTIFS/$f" "$DIR_NOTIFS/$f.lida"
  notifs_sincronizar_em_segundo_plano
  atualizar_barras_pedir >/dev/null 2>&1
}
notifs_apagar_lidas() {
  local f mudou=0
  for f in $(notifs_ids); do
    [[ -f $DIR_NOTIFS/$f.lida ]] || continue
    notifs_lapide "$f"
    rm -f "$DIR_NOTIFS/$f" "$DIR_NOTIFS/$f.lida"
    mudou=1
  done
  if (( mudou )); then
    notifs_sincronizar_em_segundo_plano
    atualizar_barras_pedir >/dev/null 2>&1
  fi
}
# Os avisos em texto puro, do mais novo ao mais velho (a voz lê e conta por aqui): "id<TAB>lida(0|1)<TAB>quando<TAB>texto".
notifs_listar() { # [todas|naolidas|lidas]
  local filtro=${1:-todas} f exp txt lida quando ids
  notifs_ids_em ids
  for f in "${ids[@]}"; do
    IFS=$'\t' read -r exp txt _ <"$DIR_NOTIFS/$f" || continue
    [[ -n $txt ]] || continue
    lida=0; [[ -f $DIR_NOTIFS/$f.lida ]] && lida=1
    case $filtro in naolidas) ((lida == 0)) || continue ;; lidas) ((lida == 1)) || continue ;; esac
    notif_quando_em quando "${f:0:10}"
    printf '%s\t%s\t%s\t%s\n' "$f" "$lida" "$quando" "$txt"
  done
}
# Apaga as lidas (🧹 da central) e imprime quantas eram.
notifs_limpar_lidas_cli() {
  local f n=0
  for f in $(notifs_ids); do [[ -f $DIR_NOTIFS/$f.lida ]] && n=$((n + 1)); done
  ((n)) && notifs_apagar_lidas
  echo "$n"
}
# O letreiro pela linha de comando (e pela voz): pausar/continuar a rolagem e saber se está pausado.
letreiro_pausa_cli() { # [sim|nao|alternar|estado] -> pausado | rolando
  local pausado=0 r
  [[ -s $RT/tt-letreiro-pausa ]] && pausado=1
  case ${1:-estado} in
    estado) ;;
    sim) ((pausado)) || r=$(TT_RT=$RT python3 -I "$DIR_TT/letreiro-tt.py" pausar 2>/dev/null) ;;
    nao) ((pausado)) && r=$(TT_RT=$RT python3 -I "$DIR_TT/letreiro-tt.py" pausar 2>/dev/null) ;;
    alternar) r=$(TT_RT=$RT python3 -I "$DIR_TT/letreiro-tt.py" pausar 2>/dev/null) ;;
    *) echo "uso: tt --letreiro-pausa [sim|nao|alternar|estado]" >&2; return 2 ;;
  esac
  [[ ${r:-} == erro ]] && return 1
  if [[ -s $RT/tt-letreiro-pausa ]]; then echo pausado; else echo rolando; fi
}
# De onde veio um aviso (a aba da central que o mostra): agentes (🔔 dos agentes, tt --notificar-daqui),
# email, tarefas (lembretes, demandas, sincronização) ou outros. Grava em NOTIF_ORIGEM, sem subshell.
notif_origem() { # texto ação canal
  case $3 in sino) NOTIF_ORIGEM=agentes; return 0 ;; esac
  case $2 in
    sessao:*) NOTIF_ORIGEM=agentes ;;
    email | email:*) NOTIF_ORIGEM=email ;;
    tarefas | demandas | calendario | tarefas-sync) NOTIF_ORIGEM=tarefas ;;
    *)
      case $1 in
        🤖*) NOTIF_ORIGEM=agentes ;;
        📧*) NOTIF_ORIGEM=email ;;
        📋* | 📥*) NOTIF_ORIGEM=tarefas ;;
        *) NOTIF_ORIGEM=outros ;;
      esac ;;
  esac
}
# Linhas da central, do aviso mais novo ao mais velho: "ação<TAB>id<TAB>desenho". O filtro escolhe
# quais entram: todas (padrão), naolidas, lidas, agentes, email ou tarefas. Uma linha por aviso: só a
# etiqueta (● Não lida / ✓ Lida) tem fundo — a linha em foco fica destacada de ponta a ponta pelo fzf —,
# o ↗ (tem destino) numa coluna antes do texto e o texto por último, que o fzf corta com … se não couber;
# o texto inteiro está na prévia (notifs_previa).
notifs_render() { # [filtro]
  local filtro=${1:-todas} f exp txt acao canal lida quando cab ida
  local z=$'\033[0m' dim=$'\033[38;2;127;132;156m' seta=$'\033[38;2;137;180;250m↗\033[0m '
  local chip_nova=$'\033[1;38;2;249;226;175;48;2;81;70;38m' chip_lida=$'\033[38;2;186;194;222;48;2;49;50;68m'
  local txt_nova=$'\033[1;38;2;205;214;244m' txt_lida=$'\033[38;2;147;153;178m' ids
  notifs_ids_em ids
  for f in "${ids[@]}"; do
    IFS=$'\t' read -r exp txt acao canal _ <"$DIR_NOTIFS/$f" || continue
    [[ $acao == - ]] && acao=""
    [[ -n $txt ]] || continue
    lida=0; [[ -f $DIR_NOTIFS/$f.lida ]] && lida=1
    case $filtro in
      naolidas) ((lida == 0)) || continue ;;
      lidas) ((lida == 1)) || continue ;;
      agentes | email | tarefas) notif_origem "$txt" "$acao" "$canal"; [[ $NOTIF_ORIGEM == "$filtro" ]] || continue ;;
    esac
    notif_quando_em quando "${f:0:10}"
    if ((lida)); then cab="$chip_lida✓ Lida$z    "; txt="$txt_lida$txt"
    else cab="$chip_nova● Não lida$z"; txt="$txt_nova$txt"; fi
    ida="  "; [[ -n $acao ]] && ida=$seta
    printf '%s\t%s\t%s%s%s  %s  %s%s%s\n' "$acao" "$f" "$dim" "$quando" "$z" "$cab" "$ida" "$txt" "$z"
  done
}
# O cartão do aviso em foco (janela de prévia da central): estado, quando, de onde, o texto inteiro e
# o que ⏎ faz com ele.
notifs_previa() { # id
  local f=${1:-} exp txt acao canal quando z=$'\033[0m' dim=$'\033[38;2;127;132;156m' azul=$'\033[38;2;137;180;250m'
  [[ $f =~ ^[0-9]{18,20}$ && -f $DIR_NOTIFS/$f ]] || return 0
  IFS=$'\t' read -r exp txt acao canal _ <"$DIR_NOTIFS/$f" || true
  [[ $acao == - ]] && acao=""
  notif_quando_em quando "${f:0:10}"; quando=${quando//  / }
  notif_origem "$txt" "$acao" "$canal"
  local de
  case $NOTIF_ORIGEM in agentes) de='agente' ;; email) de='e-mail' ;; tarefas) de='tarefas' ;; *) de='tt' ;; esac
  if [[ -f $DIR_NOTIFS/$f.lida ]]; then printf '%s✓ Lida%s' $'\033[38;2;186;194;222m' "$z"
  else printf '%s● Não lida%s' $'\033[1;38;2;249;226;175m' "$z"; fi
  printf '%s · %s · %s%s\n' "$dim" "$quando" "$de" "$z"
  printf '%s\n' "$txt"
  local s m p dest
  case $acao in
    '') dest='' ;;
    email:*) dest="abre o e-mail na mensagem nova (conta ${acao#email:})" ;;
    email) dest='abre o e-mail' ;;
    tarefas) dest='abre o painel de tarefas' ;;
    demandas) dest='abre a aba Entrada das tarefas' ;;
    calendario) dest='abre a agenda' ;;
    tarefas-sync) dest='abre a sincronização das tarefas' ;;
    letreiro) dest='abre o letreiro' ;;
    novidades) dest='abre as novidades do tt' ;;
    checagem:*) dest='abre o relatório da checagem do tt' ;;
    pendencias) dest='abre as pendências de instalação' ;;
    sessao:*)
      s=${acao#sessao:}
      if [[ $s == *'|'*'|'* ]]; then m=${s%%|*}; s=${s#*|}; s=${s%%|*}; dest="vai à sessão $s ($m)"
      else dest="vai à sessão ${s%%|*}"; fi ;;
    cmd:*) dest='roda o comando do aviso' ;;
    *) dest="abre: $acao" ;;
  esac
  if [[ -n $dest ]]; then printf '%s↗ ⏎ ou duplo clique: %s%s\n' "$azul" "$dest" "$z"
  else printf '%sSem destino: ⏎ só marca como lida.%s\n' "$dim" "$z"; fi
}
# Quantos avisos há em cada aba: "todas naolidas lidas agentes email tarefas".
notifs_contagens() {
  local f exp txt acao canal t=0 nl=0 l=0 ag=0 em=0 ta=0 ids
  notifs_ids_em ids
  for f in "${ids[@]}"; do
    IFS=$'\t' read -r exp txt acao canal _ <"$DIR_NOTIFS/$f" || continue
    [[ -n $txt ]] || continue
    [[ $acao == - ]] && acao=""
    t=$((t + 1))
    if [[ -f $DIR_NOTIFS/$f.lida ]]; then l=$((l + 1)); else nl=$((nl + 1)); fi
    notif_origem "$txt" "$acao" "$canal"
    case $NOTIF_ORIGEM in agentes) ag=$((ag + 1)) ;; email) em=$((em + 1)) ;; tarefas) ta=$((ta + 1)) ;; esac
  done
  echo "$t $nl $l $ag $em $ta"
}

# --- Central de notificações (o 🔔) --------------------------------------------
# Um fzf sem campo de busca: abas de filtro e uma barra de botões no cabeçalho (como as do e-mail e do
# painel de tarefas), a lista embaixo. TODA tecla, clique e botão passa por notifs_acao, que devolve as
# ações do fzf; o cabeçalho grava o mapa de cliques (linha, colunas, ação) que o clique consulta. O
# estado da tela (filtro, modo lista/confirmar, aviso de uma vez) mora em $RT/tt-notifs-ui-UID.
# aba|rótulo|rótulo curto (tela estreita) · ação|ícone|rótulo|rótulo curto
NOTIFS_ABAS=('todas|Todas|Todas' 'naolidas|Não lidas|Não lidas' 'lidas|Lidas|Lidas' 'agentes|Agentes|🤖' 'email|E-mail|📧' 'tarefas|Tarefas|📋')
NOTIFS_BOTOES=('abrir|↗|Abrir|Abrir' 'lida|◐|Lida/não lida|Lida' 'todas_lidas|✓|Ler todas|Ler todas' 'apagar|✕|Apagar|Apagar' 'limpar|🧹|Limpar lidas|Limpar')
notifs_ui_em() { # VAR chave → o valor (vazio se não há), sem subshell
  local -n _v=$1; local _l; _v=""
  [[ -f $RT/tt-notifs-ui-$UID ]] || return 0
  while IFS= read -r _l; do [[ $_l == "$2="* ]] && _v=${_l#*=}; done <"$RT/tt-notifs-ui-$UID"
  return 0
}
notifs_ui_set() { # chave valor
  local arq=$RT/tt-notifs-ui-$UID l out=""
  mkdir -p "$RT"
  if [[ -f $arq ]]; then while IFS= read -r l; do [[ $l == "$1="* ]] || out+=$l$'\n'; done <"$arq"; fi
  printf '%s%s=%s\n' "$out" "$1" "$2" >"$arq.tmp" && mv "$arq.tmp" "$arq"
}
# A lista da aba atual; vazia, uma linha que diz isso (sem id: as ações a ignoram).
notifs_lista_ui() {
  local f saida msg
  notifs_ui_em f filtro; f=${f:-todas}
  saida=$(notifs_render "$f")
  if [[ -n $saida ]]; then printf '%s\n' "$saida"; return 0; fi
  case $f in
    naolidas) msg='Tudo lido ✓  Nenhuma notificação nova.' ;;
    lidas) msg='Nenhuma notificação lida.' ;;
    agentes) msg='Nenhum aviso de agente.' ;;
    email) msg='Nenhum aviso de e-mail.' ;;
    tarefas) msg='Nenhum aviso de tarefas.' ;;
    *) msg='Nenhuma notificação por aqui.' ;;
  esac
  printf '\t\t\033[38;2;108;112;134m  %s\033[0m\n' "$msg"
}
# Cabeçalho: 1ª linha as abas (a ativa em destaque; Agentes/E-mail/Tarefas só com avisos), 2ª os botões
# (encolhem para só o ícone antes de quebrar), um aviso de uma vez e a régua. Confirmando a limpeza das
# lidas, a pergunta e os botões ✕ Apagar / ‹ Cancelar. As colunas do mapa são as de exibição, contadas
# como o fzf conta FZF_CLICK_HEADER_COLUMN (1 = início do texto; emoji ocupa 2).
notifs_cabecalho() {
  local larg=$(( ${FZF_COLUMNS:-80} - 3 )) mapa=$RT/tt-notifs-mapa-$UID modo f av
  ((larg < 20)) && larg=20
  mkdir -p "$RT"; : >"$mapa.tmp"
  notifs_ui_em modo modo; notifs_ui_em f filtro; notifs_ui_em av aviso; f=${f:-todas}
  local z=$'\e[0m' cinza=$'\e[48;2;69;71;90m\e[38;2;205;214;244m' sub=$'\e[38;2;166;173;200m' dim=$'\e[38;2;108;112;134m'
  local amar=$'\e[38;2;249;226;175m' neg=$'\e[1m' sep=$'\e[38;2;69;71;90m'
  local ativo=$'\e[48;2;137;180;250m\e[38;2;30;30;46m\e[1m' verm=$'\e[48;2;243;139;168m\e[38;2;30;30;46m\e[1m'
  local lin=1 col=1 buf="" saida="" W
  _quebra() { saida+="$buf"$'\n'; buf=""; lin=$((lin + 1)); col=1; }
  _item() { # texto-visível desenho ação [colado: sem espaço antes]
    tt_largura "$1"; local w=$W
    if [[ -z ${4:-} ]]; then
      ((col > 1 && col + 1 + w - 1 > larg)) && _quebra
      ((col > 1)) && { buf+=" "; col=$((col + 1)); }
    elif ((col > 1 && col + w - 1 > larg)); then _quebra
    fi
    buf+=$2; printf '%s %s %s %s\n' "$lin" "$col" "$((col + w - 1))" "$3" >>"$mapa.tmp"
    col=$((col + w))
  }
  local t nl l ag em ta; read -r t nl l ag em ta < <(notifs_contagens)
  if [[ $modo == confirmar ]]; then
    local q="Apagar as $l notificações lidas, aqui e nas outras máquinas?"
    ((l == 1)) && q="Apagar a notificação lida, aqui e nas outras máquinas?"
    _item "$q" "$neg$q$z" ""
    _quebra
    _item " ✕ Apagar " "$verm ✕ Apagar $z" confirmar
    _item " ‹ Cancelar " "$cinza ‹ Cancelar $z" cancelar
  else
    local -A num=([todas]=$t [naolidas]=$nl [lidas]=$l [agentes]=$ag [email]=$em [tarefas]=$ta)
    local a k rot curto n x nivel total primeira=1
    # Abas em degraus: com separador · sem separador · origens só com o ícone (🤖 📧 📋); depois quebram.
    # Agentes, E-mail e Tarefas só aparecem com avisos (ou com a aba ativa).
    for nivel in 1 2 3; do
      total=0
      for a in "${NOTIFS_ABAS[@]}"; do
        IFS='|' read -r k rot curto <<<"$a"
        [[ $k == agentes || $k == email || $k == tarefas ]] && ((num[$k] == 0)) && [[ $f != "$k" ]] && continue
        ((nivel == 3)) && rot=$curto
        tt_largura " $rot ${num[$k]} "; total=$((total + W + (nivel == 1 ? 1 : 0)))
      done
      ((nivel == 1)) && total=$((total - 1))
      ((total <= larg)) && break
    done
    for a in "${NOTIFS_ABAS[@]}"; do
      IFS='|' read -r k rot curto <<<"$a"; n=${num[$k]:-0}
      [[ $k == agentes || $k == email || $k == tarefas ]] && ((n == 0)) && [[ $f != "$k" ]] && continue
      ((nivel == 3)) && rot=$curto
      x=" $rot $n "
      if ((primeira == 0 && nivel == 1)); then
        tt_largura "$x"; ((col + 1 + W - 1 <= larg)) && { buf+="$sep·$z"; col=$((col + 1)); }
      fi
      if [[ $k == "$f" ]]; then _item "$x" "$ativo$x$z" "filtro:$k" colado
      elif [[ $k == naolidas ]] && ((n > 0)); then _item "$x" "$sub $rot $neg$amar$n $z" "filtro:$k" colado
      else _item "$x" "$sub $rot $dim$n $z" "filtro:$k" colado; fi
      primeira=0
    done
    _quebra
    # Botões em degraus: rótulo inteiro · rótulo curto · só o ícone (sempre numa linha só).
    local b acao ic rb rc
    for nivel in 1 2 3; do
      total=-1
      for b in "${NOTIFS_BOTOES[@]}"; do
        IFS='|' read -r acao ic rb rc <<<"$b"
        case $nivel in 1) x=" $ic $rb " ;; 2) x=" $ic $rc " ;; *) x=" $ic " ;; esac
        tt_largura "$x"; total=$((total + W + 1))
      done
      ((total <= larg)) && break
    done
    for b in "${NOTIFS_BOTOES[@]}"; do
      IFS='|' read -r acao ic rb rc <<<"$b"
      case $nivel in 1) x=" $ic $rb " ;; 2) x=" $ic $rc " ;; *) x=" $ic " ;; esac
      case $acao in
        abrir) _item "$x" "$ativo$x$z" "$acao" ;;
        apagar) _item "$x" "$verm$x$z" "$acao" ;;
        *) _item "$x" "$cinza$x$z" "$acao" ;;
      esac
    done
  fi
  if [[ -n $av ]]; then
    notifs_ui_set aviso ""
    _quebra
    tt_largura "$av"; ((W > larg)) && av="${av:0:$((larg - 2))}…"
    if [[ $av == ⚠* ]]; then _item "$av" $'\e[38;2;243;139;168m'"$neg$av$z" ""
    else _item "$av" $'\e[38;2;137;180;250m'"$av$z" ""; fi
  fi
  _quebra
  local regua; printf -v regua '%*s' "$larg" ''; regua=${regua// /─}
  saida+="$dim$regua$z"
  mv "$mapa.tmp" "$mapa"
  printf '%s' "$saida"
}
# Ação do item do cabeçalho na linha/coluna clicada (FZF_CLICK_HEADER_*), ou nada.
notifs_cabecalho_acao() {
  local l=${FZF_CLICK_HEADER_LINE:-0} c=${FZF_CLICK_HEADER_COLUMN:-0} ml mi mf ma
  [[ -f $RT/tt-notifs-mapa-$UID ]] || return 0
  while read -r ml mi mf ma; do
    [[ $ml =~ ^[0-9]+$ && $mi =~ ^[0-9]+$ && $mf =~ ^[0-9]+$ ]] || continue
    ((ml == l && c >= mi && c <= mf)) && { printf '%s' "$ma"; return 0; }
  done <"$RT/tt-notifs-mapa-$UID"
  return 0
}
# Lida ⇄ não lida do aviso em foco (botão ◐, Espaço).
notifs_alternar_lida() { # id
  local f=${1:-}
  [[ $f =~ ^[0-9]{18,20}$ && -f $DIR_NOTIFS/$f ]] || return 1
  if [[ -f $DIR_NOTIFS/$f.lida ]]; then rm -f -- "${DIR_NOTIFS:?}/$f.lida"; else : >"$DIR_NOTIFS/$f.lida"; fi
  notifs_sincronizar_em_segundo_plano
  atualizar_barras_pedir >/dev/null 2>&1
  return 0
}
# O despachante da central: evento (tecla, clique, botão) + id do aviso em foco → ações do fzf.
# A lista e o cabeçalho novos vão prontos (reload-sync/transform-header de um arquivo), sem outro tt.
notifs_acao() { # evento id
  local ev=$1 id=${2:-} modo filtro recarga=1 primeiro=0 acao exp txt canal t nl l ag em ta
  notifs_ui_em modo modo; modo=${modo:-lista}
  notifs_ui_em filtro filtro; filtro=${filtro:-todas}
  if [[ $ev == cabecalho ]]; then ev=$(notifs_cabecalho_acao); [[ -n $ev ]] || { echo ignore; return 0; }; fi
  [[ $id =~ ^[0-9]{18,20}$ && -f $DIR_NOTIFS/$id ]] || id=""
  if [[ $modo == confirmar ]]; then
    case $ev in
      confirmar | enter)
        read -r t nl l ag em ta < <(notifs_contagens)
        notifs_apagar_lidas
        notifs_ui_set modo lista
        if ((l == 1)); then notifs_ui_set aviso '🧹 A notificação lida foi apagada.'
        else notifs_ui_set aviso "🧹 $l notificações lidas apagadas."; fi ;;
      cancelar | esc | q) notifs_ui_set modo lista ;;
      *) echo ignore; return 0 ;; # a pergunta está na tela: só ✕ Apagar ou ‹ Cancelar
    esac
  else
    case $ev in
      esc | q) echo abort; return 0 ;;
      enter | abrir | duplo)
        [[ -n $id ]] || { echo ignore; return 0; }
        IFS=$'\t' read -r exp txt acao canal _ <"$DIR_NOTIFS/$id"
        [[ $acao == - ]] && acao=""
        # Com destino, o fzf devolve a linha e notifs_ui abre (marca lida e vai ao destino).
        [[ -n $acao ]] && { echo accept; return 0; }
        [[ -f $DIR_NOTIFS/$id.lida ]] || notifs_alternar_lida "$id"
        notifs_ui_set aviso 'Este aviso não leva a outro lugar; ficou marcado como lido.' ;;
      lida) [[ -n $id ]] || { echo ignore; return 0; }; notifs_alternar_lida "$id" ;;
      todas_lidas)
        read -r t nl l ag em ta < <(notifs_contagens)
        if ((nl == 0)); then notifs_ui_set aviso 'Nada a marcar: tudo já estava lido.'
        elif ((nl == 1)); then notifs_marcar_lidas; notifs_ui_set aviso '✓ 1 notificação marcada como lida.'
        else notifs_marcar_lidas; notifs_ui_set aviso "✓ $nl notificações marcadas como lidas."; fi ;;
      apagar)
        [[ -n $id ]] || { echo ignore; return 0; }
        notifs_apagar "$id"; notifs_ui_set aviso '✕ Notificação apagada (aqui e nas outras máquinas).' ;;
      limpar)
        read -r t nl l ag em ta < <(notifs_contagens)
        if ((l == 0)); then notifs_ui_set aviso 'Nenhuma notificação lida para apagar.'
        else notifs_ui_set modo confirmar; recarga=0; fi ;;
      filtro:* | proximo | anterior)
        local -a vis=(); local a k i=0
        read -r t nl l ag em ta < <(notifs_contagens)
        local -A num=([todas]=$t [naolidas]=$nl [lidas]=$l [agentes]=$ag [email]=$em [tarefas]=$ta)
        for a in "${NOTIFS_ABAS[@]}"; do
          k=${a%%|*}
          [[ $k == agentes || $k == email || $k == tarefas ]] && ((num[$k] == 0)) && [[ $filtro != "$k" ]] && continue
          vis+=("$k")
        done
        if [[ $ev == filtro:* ]]; then filtro=${ev#filtro:}
        else
          for i in "${!vis[@]}"; do [[ ${vis[i]} == "$filtro" ]] && break; done
          if [[ $ev == proximo ]]; then i=$(((i + 1) % ${#vis[@]})); else i=$(((i - 1 + ${#vis[@]}) % ${#vis[@]})); fi
          filtro=${vis[i]}
        fi
        case $filtro in todas | naolidas | lidas | agentes | email | tarefas) ;; *) filtro=todas ;; esac
        notifs_ui_set filtro "$filtro"; primeiro=1 ;;
      *) echo ignore; return 0 ;;
    esac
  fi
  # Arquivos com o pid deste processo (um mktemp a menos por arquivo); o fzf os lê antes da próxima ação.
  local lst=$RT/tt-menu.notifs.$$.l hd=$RT/tt-menu.notifs.$$.h out=""
  if ((recarga)) && notifs_lista_ui >"$lst"; then
    out="reload-sync(cat '$lst'; rm -f '$lst')"
    ((primeiro)) && out+="+first"
  fi
  if notifs_cabecalho >"$hd"; then
    out+="${out:++}transform-header(cat '$hd'; rm -f '$hd')"
  fi
  printf '%s\n' "${out:-ignore}"
}
notifs_ui() {
  local c=${1:-} esc acao f cols a="$EU --notifs-acao"
  if tem_cmd fzf && [[ -t 1 ]]; then
    # Toda abertura começa em Todas, na lista.
    notifs_ui_set filtro todas; notifs_ui_set modo lista; notifs_ui_set aviso ""
    cols=$(tput cols 2>/dev/null || echo 80)
    # Uma linha por aviso; a linha em foco destacada de ponta a ponta (--highlight-line) é o alvo dos
    # botões; a prévia embaixo mostra o aviso inteiro e o que ⏎ faz.
    esc=$(notifs_lista_ui | TT_BARRA_FUNDO=1 fzf --ansi --delimiter=$'\t' --with-nth=3 --layout=reverse --no-sort --no-input \
      --height=100% --info=hidden --no-separator --pointer='▌' --highlight-line --scroll-off=2 --ellipsis='…' \
      --header="$(FZF_COLUMNS=$cols notifs_cabecalho)" \
      --color='bg:#1e1e2e,fg:#cdd6f4,header:#cdd6f4,pointer:#89b4fa,fg+:#cdd6f4,bg+:#45475a,gutter:#1e1e2e,info:#6c7086,border:#45475a,preview-bg:#181825,scrollbar:#585b70' \
      --preview="$EU --notifs-previa {2}" --preview-window='down,5,border-top,wrap' \
      --bind="enter:transform($a enter {2})" \
      --bind="double-click:transform($a duplo {2})" \
      --bind="click-header:transform($a cabecalho {2})" \
      --bind="resize:transform-header($EU --notifs-cabecalho)" \
      --bind="esc:transform($a esc {2})" \
      --bind="q:transform($a q {2})" \
      --bind="space:transform($a lida {2})" \
      --bind="ctrl-d:transform($a apagar {2})" \
      --bind="del:transform($a apagar {2})" \
      --bind="ctrl-r:transform($a limpar {2})" \
      --bind="ctrl-l:transform($a todas_lidas {2})" \
      --bind="ctrl-u:transform($a filtro:naolidas {2})" \
      --bind="ctrl-a:transform($a filtro:todas {2})" \
      --bind="tab:transform($a proximo {2})" \
      --bind="btab:transform($a anterior {2})") || return 0
    acao=$(cut -f1 <<<"$esc"); f=$(cut -f2 <<<"$esc")
    # (a barra em 2º plano: a ação do aviso, como ir à sessão do agente, não espera o contador do 🔔)
    [[ -n $f && -f $DIR_NOTIFS/$f ]] && { : >"$DIR_NOTIFS/$f.lida"; notifs_sincronizar_em_segundo_plano; atualizar_barras_fundo; }
    [[ -n $acao ]] && notif_abrir "$acao" "${c:-$(tmux display-message -p '#{client_name}' 2>/dev/null)}"
  else notifs_render | cut -f3-; fi
  return 0
}

tarefas_notificar() { # titulo corpo [ação para o clique na faixa] [canal: sino] [segundos (padrão 600)] [código]
  local t=$1 c=$2 canal=${4:-}
  # canal sino = só o 🔔 (contador e central), sem piscar no slot; sem a faixa não há 🔔: segue o caminho antigo
  faixa_notif_ativa || canal=""
  notificar "$t · $c" "${5:-600}" "${3:-}" "$canal" "${6:-}"
  notificar_aparelho "$t" "$c"
}
# A notificação do sistema (e, sem a faixa, a tela dos terminais abertos) é DESTE aparelho: cada máquina que
# percebe o evento mostra a sua, mesmo quando o aviso do 🔔 (um só na rede, pelo código) já veio de outra.
notificar_aparelho() { # titulo corpo
  local t=$1 c=$2 cl ok=1
  # Com a faixa ligada o aviso JÁ aparece nela: o display-message por cima da 1ª linha vira
  # redundância que cobre a barra — só entra quando a faixa está desligada.
  if faixa_notif_ativa; then
    tem_cmd notify-send && notify-send -a tt "$t" "$c" >/dev/null 2>&1
    tem_cmd termux-notification && termux-notification --title "$t" --content "$c" >/dev/null 2>&1
    return 0
  fi
  if tem_cmd notify-send; then notify-send -a tt "$t" "$c" >/dev/null 2>&1 && ok=0
  elif tem_cmd termux-notification; then termux-notification --title "$t" --content "$c" >/dev/null 2>&1 && ok=0; fi
  # Também na tela de cada terminal aberto (no WSL não há notify-send).
  while read -r cl; do
    [[ -n $cl ]] && tmux display-message -c "$cl" -d 15000 "$t · $c" 2>/dev/null && ok=0
  done < <(tmux list-clients -F '#{client_name}' 2>/dev/null)
  return $ok
}
tarefas_lembrete() {
  [[ ${TT_TAREFAS_LEMBRETE:-1} == 0 ]] && return 0
  [[ -s $CONF_TAREFAS ]] || return 0
  local arq agora tz ant chave quando txt
  arq=$(tarefas_lembrete_arq); mkdir -p "$ESTADO_DIR"; touch "$arq"
  read -r agora tz < <(tarefas_relogio); ant=$(( ${TT_TAREFAS_ANTECEDENCIA:-10} * 60 ))
  # Com horário: avisa quando faltam ANT segundos (ou já passou), uma vez por prazo (id|epoch).
  # Sem horário: uma vez por dia enquanto vence hoje ou está atrasada (id|AAAAMMDD).
  while IFS=$'\t' read -r chave quando txt; do
    grep -qxF "$chave" "$arq" && continue
    # A tarefa (e o prazo) são os mesmos em todas as máquinas, e todas lembram na mesma hora: o código faz do
    # lembrete um aviso só no 🔔 da rede.
    tarefas_notificar "📋 $quando" "$txt" tarefas "" "" "lembrete-$chave" && printf '%s\n' "$chave" >>"$arq"
  done < <(LC_ALL=C awk -F'\t' -v NOW="$agora" -v TZOFF="$tz" -v ANT="$ant" "$TAREFAS_AWK"'
    NF >= 5 && valida($1, $2) && $2 == "aberta" && mv($6, "pai") == "" && !($1 in v) {
      v[$1] = 1; p = mv($6, "prazo"); if (p == "") next
      if (mv($6, "hora") == 1) {
        if (NOW >= p - ANT) print $1 "|" p "\t" (NOW > p + 60 ? "Venceu às " : "Às ") hhmm(p) "\t" $5
      } else if (dia(p) <= dia(NOW)) {
        civil(dia(NOW)); print $1 "|" sprintf("%04d%02d%02d", CY, CM, CD) "\t" (dia(p) < dia(NOW) ? "Tarefa atrasada" : "Tarefa de hoje") "\t" $5
      }
    }' "$CONF_TAREFAS")
  # Poda: guarda só as chaves de hoje e as de prazos dos últimos 2 dias.
  local hoje tmp; hoje=$(date +%Y%m%d); tmp=$(mktemp)
  awk -F'|' -v h="$hoje" -v lim="$((agora - 172800))" '$2 == h || ($2 ~ /^[0-9]+$/ && length($2) >= 10 && $2 + 0 >= lim)' "$arq" >"$tmp" &&
    mv "$tmp" "$arq" 2>/dev/null || rm -f "$tmp"
  return 0
}

# --- barra e UI ------------------------------------------------------------

# Botão do canto direito da 2ª linha, ao lado do relógio/versão: 📋 com a contagem de abertas.
# Quando há tarefa aberta ATRASADA, o botão fica laranja com a contagem delas e, entre parênteses, o total de abertas (2 (23)),
# para o prazo "trabalhar por você" sem precisar abrir o painel.
# --- painel de tarefas -------------------------------------------------------
#
# O painel é um fzf só, com três modos (lista, ajuda e o menu de ações de uma tarefa), guardados
# no arquivo de estado da UI. Toda tecla, clique e botão passa por tarefas_acao, que devolve as
# ações do fzf (transform): assim teclado, mouse e botões fazem exatamente a mesma coisa.
#
# Cada linha da lista é "chave<TAB>desenho". A chave diz o que a linha é:
#   ID            tarefa ou subtarefa
#   menu:ID       o "⋯ menu" discreto sob a tarefa aberta (e as linhas do menu de ações)
#   desc:ID/sub:ID chaves antigas das linhas de descrição/subtarefa (ainda aceitas pelo despachante)
#   criar         cria a tarefa digitada na busca
#   dia:N         título de um dia na agenda (N = dias desde 1970; clique abre o calendário nele)
#   act:AÇÃO:ID   item do menu de ações               voltar   volta para a lista
#   (vazia)       linha só informativa
#
# A renderização é uma passada de awk (rápida mesmo com centenas de tarefas): roda em LC_ALL=C,
# o texto passa intacto byte a byte e nenhuma conta depende de largura de caractere.

# Funções awk comuns: valor da meta, dia local de um epoch, data civil (sem strftime, que o mawk
# não tem) e o rótulo do prazo.
TAREFAS_AWK='
function mv(meta, k,   n, a, i) {
  n = split(meta, a, "|")
  for (i = 1; i <= n; i++) if (index(a[i], k "=") == 1) return substr(a[i], length(k) + 2)
  return ""
}
function valida(id, est) {
  return id ~ /^[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/ && (est == "aberta" || est == "feita")
}
function dia(ep) { return int((ep + TZOFF) / 86400) }
# Apelido (mesma conta do tarefa_slug do bash): 8 primeiros hex do código -> CVCV + 2 dígitos.
function slug(id,   h, i, n, d) {
  h = substr(id "00000000", 1, 8); n = 0
  for (i = 1; i <= 8; i++) { d = index("0123456789abcdef", substr(h, i, 1)) - 1; n = n * 16 + (d < 0 ? 0 : d) }
  return substr("bdfgjklmnprstvz", n % 15 + 1, 1) substr("aeiou", int(n / 15) % 5 + 1, 1) \
         substr("bdfgjklmnprstvz", int(n / 75) % 15 + 1, 1) substr("aeiou", int(n / 1125) % 5 + 1, 1) sprintf("%02d", int(n / 5625) % 100)
}
function civil(z,   era, doe, yoe, doy, mp) {
  z += 719468; era = int(z / 146097); doe = z - era * 146097
  yoe = int((doe - int(doe / 1460) + int(doe / 36524) - int(doe / 146096)) / 365)
  doy = doe - (365 * yoe + int(yoe / 4) - int(yoe / 100)); mp = int((5 * doy + 2) / 153)
  CD = doy - int((153 * mp + 2) / 5) + 1; CM = (mp < 10 ? mp + 3 : mp - 9); CY = yoe + era * 400 + (CM <= 2)
}
# Ordem das tarefas de topo: abertas antes das feitas; prioridade alta antes; ordem manual (ord, 0 =
# sem posição); a mais nova primeiro; o id desempata. Chave de largura fixa, comparada como texto.
function chave_ordem(id, est, criada, meta,   p, o) {
  p = mv(meta, "prio"); o = mv(meta, "ord") + 0
  return sprintf("%d%d%09d%010d%s", (est == "aberta" ? 0 : 1), (p == 1 ? 0 : (p == 2 ? 1 : 2)), \
                 (o == 0 ? 999999999 : o), 9999999999 - criada, id)
}
function cores() {
  Z = "\033[0m"; NEG = "\033[1m"; RISCO = "\033[9m"; ITAL = "\033[3m"
  TXT = "\033[38;2;205;214;244m"; SUB = "\033[38;2;166;173;200m"; DIM = "\033[38;2;108;112;134m"
  AZUL = "\033[38;2;137;180;250m"; VERDE = "\033[38;2;166;227;161m"; AMAR = "\033[38;2;249;226;175m"
  VERM = "\033[38;2;243;139;168m"; PESS = "\033[38;2;250;179;135m"; LILAS = "\033[38;2;203;166;247m"
  TEAL = "\033[38;2;148;226;213m"; APAG = "\033[38;2;69;71;90m"
  split("dom seg ter qua qui sex sáb", DOW, " ")
}
function hhmm(ep,   s) { s = (ep + TZOFF) % 86400; return sprintf("%02d:%02d", int(s / 3600), int(s % 3600 / 60)) }
# Com horário vence quando a hora passa; sem horário, quando o dia passa.
function vencida(p, hora) { return hora ? NOW > p : dia(p) < dia(NOW) }
# Corta em N bytes sem partir um caractere UTF-8 (roda em LC_ALL=C).
function corta(s, n,   c) {
  if (n < 8) n = 8
  if (length(s) <= n) return s
  while (n > 0 && (c = substr(s, n + 1, 1)) >= "\200" && c < "\300") n--
  return substr(s, 1, n) "…"
}
# base64 -> texto (bytes; em LC_ALL=C o %c devolve o byte, então UTF-8 passa intacto).
function b64d(s,   i, n, c, bits, nb, v, out) {
  if (!B64OK) { for (i = 0; i < 64; i++) B64[substr("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", i + 1, 1)] = i; B64OK = 1 }
  out = ""; bits = 0; nb = 0; n = length(s)
  for (i = 1; i <= n; i++) {
    c = substr(s, i, 1); if (c == "=") break
    if (!(c in B64)) continue
    bits = bits * 64 + B64[c]; nb += 6
    if (nb >= 8) { nb -= 8; v = int(bits / 2 ^ nb); bits -= v * 2 ^ nb; out = out sprintf("%c", v) }
  }
  return out
}
# "hoje", "amanhã", "ontem", "sex 10/10" (até 6 dias), "25/12" ou "25/12/27" (outro ano).
function quando(p,   d, df, s) {
  d = dia(p); df = d - HOJE; civil(d)
  s = sprintf("%02d/%02d", CD, CM); if (CY != ANO) s = s sprintf("/%02d", CY % 100)
  if (df == 0) return "hoje"
  if (df == 1) return "amanhã"
  if (df == -1) return "ontem"
  if (df > 1 && df < 7) return DOW[(d + 4) % 7 + 1] " " s
  return s
}
function rotulo_prazo(p, est, hora,   df, h) {
  if (p == "") return ""
  df = dia(p) - HOJE; h = (hora ? " " hhmm(p) : "")
  if (est == "feita") return DIM "◷ " quando(p) h Z
  if (vencida(p, hora)) return VERM NEG "◷ venceu " quando(p) h Z
  if (df == 0) return PESS NEG "◷ hoje" h Z
  if (df == 1) return AMAR "◷ amanhã" h Z
  return SUB "◷ " quando(p) h Z
}
'

tarefas_relogio() { # -> "agora deslocamento-do-fuso-em-segundos"
  local z s off agora; printf -v z '%(%z)T' -1; s=${z:0:1}
  off=$(( 10#${z:1:2} * 3600 + 10#${z:3:2} * 60 )); [[ $s == - ]] && off=$((-off))
  hora__ler; printf -v agora '%(%s)T' -1
  echo "$((agora + HORA_D)) $off"
}

# Contagem das tarefas de topo: "hoje abertas feitas com-prazo todas" (hoje = abertas vencidas ou
# que vencem hoje) e, no 7º campo, as ATRASADAS (já passaram do prazo: dia anterior, ou hora marcada
# que já foi). Só elas deixam o botão da barra e a aba Hoje laranja (#fab387, sem trocar o 📋); o que vence hoje e ainda
# não passou fica âmbar. Uma passada só; serve às abas do painel e ao botão da barra.
tarefas_contagens() {
  [[ -s $CONF_TAREFAS ]] || { echo "0 0 0 0 0 0 0 0"; return 0; }
  local agora tz; read -r agora tz < <(tarefas_relogio)
  LC_ALL=C awk -F'\t' -v NOW="$agora" -v TZOFF="$tz" "$TAREFAS_AWK"'
    NF >= 5 && valida($1, $2) && !($1 in v) && mv($6, "pai") == "" {
      v[$1] = 1; t++
      if ($2 == "aberta") a++; else f++
      p = mv($6, "prazo")
      if (p != "" && $2 == "aberta") { z++; if (dia(p) <= dia(NOW)) h++
        if (mv($6, "hora") == 1 ? p < NOW : dia(p) < dia(NOW)) x++ }
    }
    NF >= 5 && $2 == "arquivada" && !($1 in w) && mv($6, "pai") == "" { w[$1] = 1; q++ }
    NF >= 5 && $2 == "pendente" && !($1 in ee) && mv($6, "pai") == "" { ee[$1] = 1; en++ }
    END { printf "%d %d %d %d %d %d %d %d\n", h, a, f, z, t, q, x, en }' "$CONF_TAREFAS"
}
tarefas_hoje_n() { local c; read -ra c < <(tarefas_contagens); echo "${c[0]}"; }
tarefas_demandas_n() { local c; read -ra c < <(tarefas_contagens); echo "${c[7]:-0}"; }
barra_tarefas_fmt() {
  local h n a x en; read -r h n a a a a x en < <(tarefas_contagens)
  if ((x > 0)); then
    # Atrasadas e, entre parênteses, quantas abertas há no total ("2 (23)"): o laranja não esconde o tamanho da fila.
    # Se todas estão atrasadas, o total seria o mesmo número de novo: fica só ele.
    local rot=$x; ((n > x)) && rot="$x ($n)"
    printf '#[range=user|tarefas]#[fg=#1e1e2e,bg=#fab387,bold] 📋 %s #[norange]#[default] ' "$rot"
  elif ((n > 0)); then
    printf '#[range=user|tarefas]#[fg=#1e1e2e,bg=#f9e2af,bold] 📋 %s #[norange]#[default] ' "$n"
  else
    printf '#[range=user|tarefas]#[fg=#a6adc8] 📋 #[norange]#[default] '
  fi
  # Demandas por e-mail esperando aprovação: um chip lilás ao lado (o clique abre o painel já na aba Entrada).
  ((${en:-0} > 0)) && printf '#[range=user|entrada]#[fg=#1e1e2e,bg=#cba6f7,bold] 📥 %s #[norange]#[default] ' "$en"
  return 0
}

# --- painel flutuante (clicar fora fecha) ---------------------------------------------------------
#
# O display-popup é modal e engole o clique fora dele (medido no tmux 3.5a: nem bind de mouse nem
# fechamento), então "clicar fora fecha o painel" não existe nele. O tmux 3.8 trouxe o painel MODAL:
# new-pane -O é um floating pane que impede o resto enquanto está aberto e, com -C, fecha ao clicar
# fora. Ligado em painel_flutuante=1 no config (menu ⋯ do painel → 🪟), e só onde o tmux sabe: a
# detecção é pela capacidade (o new-pane aceita -O -C -K), não pelo número da versão.
# Diferença para o popup: o painel é da JANELA, não do cliente — todo aparelho que olha a janela vê o
# painel (o popup aparece só na tela que clicou). Desligado (padrão) tudo segue como era.
# O -D (Esc/Ctrl+C fecham) fica de fora de propósito: o Esc é do fzf (volta do menu/ajuda).
# Enquanto o painel está aberto o tmux bloqueia a barra de status (clicar nela nem fecha nem chega aos
# binds): fecha-se por clique na janela fora do painel, por Esc, ou chamando de novo `tt --tarefas`.
flutuante_suportado() {
  # A resposta é do binário do servidor (o tt sempre fala com ele, ver tmux_alinhar): fica guardada por servidor
  # (pid + instante em que nasceu, lidos de /proc) em $RT, sem uma ida ao tmux a cada popup. Sem $TMUX ou sem
  # /proc, pergunta ao tmux como sempre.
  local uso pid st id="" arq=$RT/tt-flutuante-$UID g="" r="" ok=1
  local -a campos=()
  if [[ -n ${TMUX:-} ]]; then
    pid=${TMUX#*,}; pid=${pid%%,*}
    if [[ $pid =~ ^[0-9]+$ ]] && { read -r st <"/proc/$pid/stat"; } 2>/dev/null; then
      st=${st##*) }; read -r -a campos <<<"$st"
      [[ ${campos[19]:-} =~ ^[0-9]+$ ]] && id="$pid:${campos[19]}"
    fi
    if [[ -n $id ]] && { read -r g r <"$arq"; } 2>/dev/null && [[ $g == "$id" && $r == [01] ]]; then
      ((r)); return
    fi
  fi
  if uso=$(tmux list-commands new-pane 2>/dev/null) && [[ $uso =~ \[-([A-Za-z]+)\] ]] &&
     [[ ${BASH_REMATCH[1]} == *O* && ${BASH_REMATCH[1]} == *C* && ${BASH_REMATCH[1]} == *K* ]]; then ok=0; fi
  [[ -n $id ]] && { printf '%s %s\n' "$id" "$((1 - ok))" >"$arq"; } 2>/dev/null
  return "$ok"
}
flutuante_ativo() { [[ $(conf painel_flutuante) == 1 ]] && flutuante_suportado; }

# --- janelas flutuantes: o display-popup do tt que fecha ao clicar fora ------------------------------
#
# popup_janela recebe as MESMAS opções do `tmux display-popup` (todo `tmux display-popup` do código do tt cai
# aqui pelo wrapper tmux(); os comandos de menu, rodados por outro shell, chamam `tt --popup`). Com
# painel_flutuante=1 e tmux 3.8+ abre um painel MODAL (new-pane -O -C -K): clicar na janela fora dele o fecha,
# nada atrás recebe tecla nem clique, e o título fica na borda (pane-border-status top-floating, ver `bordas`).
# Em qualquer outro caso é o display-popup de sempre, com as opções originais: desligado, tmux velho, sem
# cliente, comando vazio, janela pequena demais ou uma janela que já tem um modal (o do painel de tarefas).
# A caixa é a mesma: -w/-h em número ou %, -x número, -y número ou S (encostado na barra de status), sem -x/-y
# centraliza; a largura e a altura incluem a borda, como no popup. Diferenças: o painel é da JANELA (todo aparelho
# que olha a janela o vê) e a borda "rounded" vira "single" (o painel não tem cantos arredondados).
# O comando recebe TT_CLIENTE (o painel não tem cliente próprio, e um switch-client sem -c pegaria a tela errada)
# e TT_EM_JANELA=1 (em_popup: "já estou numa janela, não abra outra por cima").
_janela_dim() { # valor total padrão-% → número (aceita N e N%)
  local v=$1 tot=$2 pad=$3
  if [[ $v =~ ^[0-9]+%$ ]]; then echo $((tot * ${v%\%} / 100))
  elif [[ $v =~ ^[0-9]+$ ]]; then echo "$v"
  else echo $((tot * pad / 100)); fi
}
popup_janela() {
  local -a orig=("$@") envs=() args=()
  local c="" w="" h="" x="" y="" b="" bs="" st="" t="" d="" alvo="" opt e
  local OPTIND=1
  while getopts 'BCEkNb:c:d:e:h:s:S:t:T:w:x:y:' opt; do
    case $opt in
      c) c=$OPTARG ;; w) w=$OPTARG ;; h) h=$OPTARG ;; x) x=$OPTARG ;; y) y=$OPTARG ;;
      b) b=$OPTARG ;; S) bs=$OPTARG ;; s) st=$OPTARG ;; T) t=$OPTARG ;; d) d=$OPTARG ;; t) alvo=$OPTARG ;;
      e) envs+=("$OPTARG") ;;
      B | C | E | k | N) ;;
      *) _tmux_real display-popup "${orig[@]}"; return ;;
    esac
  done
  shift $((OPTIND - 1))
  local pane="" ww="" wh="" modal="" W H X Y
  if [[ -n $c ]] && (($# > 0)) && flutuante_ativo; then
    read -r pane ww wh modal <<<"$(do_cliente "$c" '#{pane_id} #{window_width} #{window_height} #{window_modal_pane}')"
  fi
  if [[ -z $pane || ! $ww =~ ^[0-9]+$ || ! $wh =~ ^[0-9]+$ || -n $modal ]] || ((ww < 12 || wh < 6)); then
    _tmux_real display-popup "${orig[@]}"; return
  fi
  W=$(_janela_dim "$w" "$ww" 50); H=$(_janela_dim "$h" "$wh" 50)
  ((W > ww)) && W=$ww; ((H > wh)) && H=$wh; ((W < 8)) && W=8; ((H < 4)) && H=4
  if [[ $x =~ ^[0-9]+$ ]]; then X=$x; else X=$(((ww - W) / 2)); fi
  ((X + W > ww)) && X=$((ww - W)); ((X < 0)) && X=0
  case $y in
    S) Y=$((wh - H)) ;;
    '' | *[!0-9]*) Y=$(((wh - H) / 2)) ;;
    *) Y=$y ;;
  esac
  ((Y + H > wh)) && Y=$((wh - H)); ((Y < 0)) && Y=0
  case $b in single | double | heavy | simple) ;; *) b=single ;; esac
  args=(new-pane -d -W -t "$pane" -O -C -K -B "$b" -X "$X" -Y "$Y" -x "$W" -y "$H"
    -e "TT_CLIENTE=$c" -e TT_EM_JANELA=1)
  [[ -n $bs ]] && args+=(-S "$bs" -R "$bs")
  [[ -n $st ]] && args+=(-s "$st")
  args+=(-T "$t") # vazio também: sem -T o título da borda seria o nome da máquina
  [[ -n $d ]] && args+=(-c "$d")
  for e in "${envs[@]}"; do args+=(-e "$e"); done
  # -W: espera o comando terminar, como o display-popup (quem chamou só segue com a janela fechada). O código de
  # saída é o do comando; o tmux só escreve no stderr quando NÃO conseguiu abrir (aí cai no popup de sempre).
  local erro rc
  erro=$(_tmux_real "${args[@]}" -- "$@" 2>&1 >/dev/null </dev/null); rc=$?
  if [[ -n $erro ]]; then _tmux_real display-popup "${orig[@]}"; return; fi
  return $rc
}
# O popup que NÃO deve fechar com um clique perdido: o modal das pendências (apt/sudo no meio) e o navegador.
popup_fixo() { _tmux_real display-popup "$@"; }
flutuante_rotulo() {
  if [[ $(conf painel_flutuante) != 1 ]]; then echo "desligado"
  elif flutuante_suportado; then echo "ligado (fecha ao clicar fora)"
  else echo "ligado, mas este tmux ($(tmux -V 2>/dev/null | cut -d' ' -f2)) precisa ser 3.8+"; fi
}
flutuante_cmd() { # [status|on|off|alternar] [cliente]
  local acao=${1:-status} c=${2:-} novo="" msg
  case $acao in
    on|ligar)      novo=1 ;;
    off|desligar)  novo=0 ;;
    alternar)      [[ $(conf painel_flutuante) == 1 ]] && novo=0 || novo=1 ;;
    status) ;;
    *) echo "uso: tt --flutuante [status|on|off|alternar]"; return 2 ;;
  esac
  if [[ -n $novo ]]; then
    mkdir -p "$CONF_DIR"
    grep -v '^painel_flutuante=' "$CONF" 2>/dev/null >"$CONF.novo"; echo "painel_flutuante=$novo" >>"$CONF.novo"; mv "$CONF.novo" "$CONF"
  fi
  msg="🪟 janelas flutuantes: $(flutuante_rotulo)"
  if [[ -n $c ]]; then tmux display-message -c "$c" "$msg"; else echo "$msg"; fi
}
# Abre (ou, se já está aberto, fecha) o painel de tarefas como painel modal à direita, altura toda.
abrir_tarefas_flutuante() { # cliente
  local c=$1 win p ww w x ja
  read -r win p ww < <(do_cliente "$c" '#{window_id} #{pane_id} #{window_width}')
  [[ -n ${win:-} && -n ${p:-} ]] || return 1
  ja=$(tmux list-panes -t "$win" -F '#{pane_id} #{pane_floating_flag} #{pane_start_command}' 2>/dev/null |
    awk '$2 == 1 && /--tarefas-ui/ { print $1; exit }')
  if [[ -n $ja ]]; then tmux kill-pane -t "$ja"; return 0; fi
  if ((${ww:-80} < 80)); then w=$ww; x=0
  else w=$(( ww >= 120 ? 72 : 64 )); ((w > ww)) && w=$ww; x=$((ww - w)); fi
  tmux new-pane -d -t "$p" -O -C -K -B single -S 'fg=#89b4fa' -T ' 📋 tarefas · ? ajuda · esc ou clique fora fecha ' \
    -X "$x" -Y 0 -x "$w" -y 100% "TT_CLIENTE=$(q "$c") $EU --tarefas-ui"
}

# Abre o painel de tarefas como um slide-over ANCORADO À DIREITA (display-popup -x), altura toda.
# Recolher = sair da UI interna (esc/q), que fecha o popup. Em tela estreita (celular) ocupa tudo.
# Com painel_flutuante=1 e tmux 3.8+, abre como painel modal que também fecha ao clicar fora.
abrir_tarefas() {
  local c=$1 cw ch w x
  # Parado na Entrada sem nada pendente (já aprovou/recusou tudo): volta para Hoje em vez de mostrar uma aba vazia.
  [[ $(tarefas_filtro) == entrada ]] && (($(tarefas_demandas_n) == 0)) && tarefas_filtro_set hoje
  flutuante_ativo && abrir_tarefas_flutuante "$c" && return 0
  read -r cw ch < <(do_cliente "$c" '#{client_width} #{client_height}')
  if ((${cw:-80} < 80)); then
    w=$cw; x=0
  else
    w=$(( cw >= 120 ? 72 : 64 )); ((w > cw)) && w=$cw; x=$((cw - w))
  fi
  tmux display-popup -c "$c" -x "$x" -y S -w "$w" -h 100% -b rounded -S 'fg=#89b4fa' \
    -T ' 📋 tarefas · ? ajuda · esc fecha ' -E "TT_CLIENTE=$(q "$c") $EU --tarefas-ui"
}

# Estado da UI (filtro, modo e tarefas abertas) para sobreviver aos reloads do fzf.
tarefas_estado_arq() { echo "$RT/tt-tarefas-ui-$UID"; }
tarefas_mapa_arq() { echo "$RT/tt-tarefas-mapa-$UID"; }
tarefas_ui_get() { sed -n "s/^$1=//p" "$(tarefas_estado_arq)" 2>/dev/null | tail -1; }
tarefas_ui_set() { # chave valor
  local arq; arq=$(tarefas_estado_arq); mkdir -p "$RT"
  { grep -v "^$1=" "$arq" 2>/dev/null; printf '%s=%s\n' "$1" "$2"; } >"$arq.tmp" && mv "$arq.tmp" "$arq"
}
tarefas_filtro() { tarefas_ui_get filtro; }
tarefas_filtro_set() { tarefas_ui_set filtro "$1"; }
# Ciclo do filtro: hoje -> abertas -> feitas -> prazo (só com deadline) -> todas -> hoje.
tarefas_filtro_ciclar() {
  case $(tarefas_filtro) in
    hoje) tarefas_filtro_set abertas ;;
    abertas) tarefas_filtro_set feitas ;;
    feitas) tarefas_filtro_set prazo ;;
    prazo) tarefas_filtro_set todas ;;
    todas) tarefas_filtro_set arquivo ;;
    arquivo) (( $(tarefas_demandas_n) > 0 )) && tarefas_filtro_set entrada || tarefas_filtro_set hoje ;;
    *) tarefas_filtro_set hoje ;;
  esac
}
# Uma tarefa está aberta (▾, detalhes à mostra)? Estado em linhas "exp=<id>" no arquivo da UI.
tarefas_exp_tem() { grep -qxF "exp=$1" "$(tarefas_estado_arq)" 2>/dev/null; }
tarefas_exp_alternar() {
  local id=$1 arq; arq=$(tarefas_estado_arq); mkdir -p "$RT"; touch "$arq"
  if tarefas_exp_tem "$id"; then grep -vxF "exp=$id" "$arq" >"$arq.tmp" || true; mv "$arq.tmp" "$arq"
  else printf 'exp=%s\n' "$id" >>"$arq"; fi
}
tarefas_exp_definir() { # id 1|0
  tarefas_exp_tem "$1" && [[ $2 == 1 ]] && return 0
  tarefas_exp_tem "$1" || [[ $2 == 1 ]] || return 0
  tarefas_exp_alternar "$1"
}
# Há o que abrir (▸)? Tarefa de topo só abre com subtarefa viva (aberta/feita): sem elas os detalhes
# seriam só a linha "⋯ menu", que já tem botão direito, ^o e "⋯ Mais". Arquivada sempre abre: as
# linhas restaurar/apagar moram lá. O desenho da lista (linha_topo/aberto) segue a mesma regra.
tarefa_expandivel() { # id
  [[ $(tarefas_estado_de "$1") == arquivada ]] && return 0
  tarefas_raw | awk -F'\t' -v id="$1" 'BEGIN { r = 1 }
    ($2 == "aberta" || $2 == "feita") && $6 ~ ("(^|[|])pai=" id "([|]|$)") { r = 0; exit }
    END { exit r }'
}

# --- data portável (GNU date -d; BSD/macOS date -r) ------------------------
# Formata um epoch com um +FORMATO de strftime. GNU usa -d @epoch; BSD usa -r epoch.
tt_fmt_epoch() { # epoch +formato
  local ep=$1 fmt=$2
  # O printf do bash formata a data sem processo (strftime, com o TZ e o locale do momento, como o date). O que
  # só o date de GNU entende (%N, %:z, %q…) segue para ele.
  if [[ $ep =~ ^-?[0-9]+$ && $fmt == +* && $fmt != *%[-_0^#]* && $fmt != *%[0-9:EONPqs]* && $fmt != *[\)\\]* ]]; then
    printf "%(${fmt#+})T\n" "$ep"; return 0
  fi
  date -d "@$ep" "$fmt" 2>/dev/null || date -r "$ep" "$fmt" 2>/dev/null
}
# Epoch de uma data "YYYY-MM-DD[ HH:MM]". GNU aceita direto; BSD precisa de -j -f.
tt_epoch_de() { # "YYYY-MM-DD[ HH:MM]"
  local s=$1
  date -d "$s" +%s 2>/dev/null && return 0
  if [[ $s == *" "*:* ]]; then date -j -f '%Y-%m-%d %H:%M' "$s" +%s 2>/dev/null
  else date -j -f '%Y-%m-%d' "$s" +%s 2>/dev/null; fi
}
# Dias de hoje até o prazo (negativo = passou); vazio se sem prazo.
tarefas_dias_ate() { # epoch
  local ep=$1 agora tz
  [[ -n $ep ]] || return 1
  read -r agora tz < <(tarefas_relogio)
  echo $(( (ep + tz) / 86400 - (agora + tz) / 86400 ))
}

# Rótulo do prazo de uma tarefa (o mesmo da lista, sem cores): "hoje", "amanhã", "sex 10/10"...
tarefas_prazo_texto() { # epoch [1 = com horário]
  [[ -n $1 ]] || return 0
  local agora tz; read -r agora tz < <(tarefas_relogio)
  LC_ALL=C awk -v NOW="$agora" -v TZOFF="$tz" -v P="$1" -v H="${2:-}" "$TAREFAS_AWK"'
    BEGIN { HOJE = dia(NOW); civil(HOJE); ANO = CY; split("dom seg ter qua qui sex sáb", DOW, " ")
            print quando(P) (H == 1 ? " às " hhmm(P) : "") }'
}

