        [[ -n $v ]] || v="padrão ${p:-automático}"
        printf '%s\t%-25s  \033[1;37m%s\033[0m  \033[90m%s\033[0m\n' "$k" "$nome" "$v" "$r"
      done | fzf --ansi --delimiter='\t' --with-nth=2 --layout=reverse --height=100% --no-sort --prompt='  ajuste › ' \
        --header='📰 Ajustes do letreiro · escolha uma opção · vazio restaura o padrão · esc sai' --bind='left-click:accept' | cut -f1)
    [[ -n $sel ]] || return 0
    l=$(letreiro_ajuste_def "$sel"); IFS='|' read -r k t p r <<<"$l"
    case $t in
      bool) [[ $(conf "$k") == 0 || ( -z $(conf "$k") && $p == 0 ) ]] && novo=1 || novo=0 ;;
      enum:*) novo=$(printf '%s\n' "${t#enum:}" | tr / '\n' | fzf --layout=reverse --height=40% --prompt="$k › ") || continue ;;
      veloc)
        if [[ $(conf ticker_rolagem) == paginas ]]; then
          novo=$(printf '1\t⚡ 1 s · troca rápida\n2\t🏃 2 s · rápida\n4\t🚶 4 s · confortável\n6\t☕ 6 s · tranquila (padrão)\n10\t🌿 10 s · lenta\n15\t🌙 15 s · bem lenta\ncustom\t✎ definir outro valor (1–60 s)\n' |
            fzf --delimiter='\t' --with-nth=2 --layout=reverse --height=45% --prompt='  ritmo das páginas › ' --header='Tempo de exibição de cada bloco') || continue
        else
          novo=$(printf '0.1\t⚡ 0,1 s/coluna · muito rápida\n0.25\t🏃 0,25 s/coluna · rápida\n0.5\t🚶 0,5 s/coluna · confortável\n1\t☕ 1 s/coluna · tranquila\n2\t🌿 2 s/coluna · lenta\n5\t🌙 5 s/coluna · bem lenta\ncustom\t✎ definir outro valor (0,1–5 s)\n' |
            fzf --delimiter='\t' --with-nth=2 --layout=reverse --height=45% --prompt='  ritmo da rolagem › ' --header='Segundos por coluna · valores menores rolam mais rápido') || continue
        fi
        novo=${novo%%$'\t'*}
        if [[ $novo == custom ]]; then
          if [[ $(conf ticker_rolagem) == paginas ]]; then
            printf 'Tempo por página, de 1 a 60 segundos.\n'; IFS= read -erp 'segundos = ' -i "$(conf "$k")" novo || continue
          else
            printf 'Tempo por coluna, de 0,1 a 5 segundos.\n'; IFS= read -erp 'segundos = ' -i "$(conf "$k")" novo || continue
          fi
        fi ;;
      *) printf '\033[2m%s\033[0m\n' "$r"; IFS= read -erp "$k = " -i "$(conf "$k")" novo || continue ;;
    esac
    letreiro_ajuste "$k" "$novo" >/dev/null || letreiro_pausa
  done
}
letreiro_acao() { # EVENTO CHAVE → ações do fzf. Despachante único: toda tecla, clique e botão do painel passa por aqui.
  local ev=$1 k=${2:-} a="$EU" rec
  rec="+reload($EU --letreiro-lista)"
  [[ $k =~ ^[a-z0-9][a-z0-9_-]*$ ]] && local fonte=1 || local fonte=0
  case $ev in
    enter|duplo)
      case $k in
        +) echo "execute($a --letreiro-assistente)$rec" ;;
        @cat) echo "execute($a --letreiro-catalogo-ui)$rec" ;;
        @cfg) echo "execute($a --letreiro-ajustes-ui)$rec" ;;
        @pre) echo "execute($a --letreiro-previa)" ;;
        @vis) echo "execute-silent($a --letreiro-vista-ciclar)$rec" ;;
        @ord) echo "execute-silent($a --letreiro-ordem-ciclar)$rec" ;;
        *) ((fonte)) && echo "execute($a --letreiro-menu-fonte $k)$rec" ;;
      esac ;;
    menu) ((fonte)) && echo "execute($a --letreiro-menu-fonte $k)$rec" ;;
    nova) echo "execute($a --letreiro-assistente)$rec" ;;
    catalogo) echo "execute($a --letreiro-catalogo-ui)$rec" ;;
    ajustes) echo "execute($a --letreiro-ajustes-ui)$rec" ;;
    previa) echo "execute($a --letreiro-previa)" ;;
    vista) echo "execute-silent($a --letreiro-vista-ciclar)$rec" ;;
    ordem) echo "execute-silent($a --letreiro-ordem-ciclar)$rec" ;;
    editar) ((fonte)) && echo "execute($a --letreiro-editar $k)$rec" ;;
    testar) ((fonte)) && echo "execute($a --letreiro-testar-ui $k)" ;;
    log) ((fonte)) && echo "execute($a --letreiro-log-ui $k)" ;;
    duplicar) ((fonte)) && echo "execute-silent($a --letreiro-duplicar $k $(letreiro_nome_livre "$k"))$rec" ;;
    alternar) ((fonte)) && echo "execute-silent($a --letreiro-alternar $k)$rec" ;;
    cima) ((fonte)) && echo "execute-silent($a --letreiro-mover $k -1)$rec+up" ;;
    baixo) ((fonte)) && echo "execute-silent($a --letreiro-mover $k +1)$rec+down" ;;
    apagar) ((fonte)) && echo "execute($a --letreiro-rm $k)$rec" ;;
    atualizar) echo "execute-silent($a --letreiro-atualizar)$rec" ;;
    esc) echo abort ;;
  esac
}
