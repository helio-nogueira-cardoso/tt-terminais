ITENS
}

# Menu do próprio tmux: janelas, arrumação dos painéis, opções, sessão/tela atual e os outros menus.
menu_tmux() {
  local c=$1 p=${2:-} sess win sinc mouse ed p0 info ver pasta
  local _TAM_POPUP_C="" _TAM_POPUP_V=""; tam_popup_fixar "$c"
  # Janela, painel e sessão do cliente numa ida só (a sessão por último: o nome pode ter espaço); eram três.
  read -r win p0 sess < <(do_cliente "$c" '#{window_id} #{pane_id} #{session_name}')
  [[ -n $p ]] || p=$p0
  [[ $(tmux show-options -wv -t "$win" synchronize-panes) == on ]] && sinc="✓ ligado" || sinc="desligado"
  [[ $(tmux show-options -gv mouse) == on ]] && mouse="✓ ligado" || mouse="desligado"
  ed=$(editor_tt)
  if info=$(tmux display-message -p -t "$p" "#{version}"$'\x1f'"#{pane_current_path}" 2>/dev/null) && [[ $info == *$'\x1f'* ]]; then
    ver=${info%%$'\x1f'*}; pasta=${info#*$'\x1f'}
  else ver=$(tmux display-message -p '#{version}'); pasta=""; fi
  menu_popup "$c" "tmux $ver · $sess" <<ITENS
c	Nova janela nesta sessão	tmux new-window -t $(q "=$sess:") -c $(q "$pasta")
n	Próxima janela	tmux next-window -t $(q "=$sess:")
b	Janela anterior	tmux previous-window -t $(q "=$sess:")
-		
1	Painéis lado a lado	tmux select-layout -t $win even-horizontal
2	Painéis empilhados	tmux select-layout -t $win even-vertical
3	Painéis em grade	tmux select-layout -t $win tiled
4	Um grande + os outros	tmux select-layout -t $win main-vertical
y	Digitar em todos os painéis: $sinc	tmux set-option -w -t $win synchronize-panes
-		
h	Rolar / copiar o histórico	tmux copy-mode -t $p
u	Mouse: $mouse	tmux set-option -g mouse
k	Ver todos os atalhos	$(popup_tt "$c" atalhos "tmux list-keys | sed 's/^bind-key *//' | less -S")
e	Editar a configuração desta máquina	$(popup_tt "$c" "~/.tmux.conf" "$ed ~/.tmux.conf && tmux source-file ~/.tmux.conf")
t	✏ Atalhos da barra…	$(popup_tt "$c" "✏ atalhos da barra" "$EU --editar-atalhos")
l	Recarregar a configuração	tmux source-file ~/.tmux.conf \; display-message -c $(q "$c") 'configuração recarregada'
-		
r	Renomear a sessão…	$EU --popup -c $(q "$c") -E $(dim_popup "$c" 70 7) -T ' renomear ' $(q "$EU --renomear $(q "$sess")")
d	Desanexar esta tela	tmux detach-client -t $(q "$c")
D	Desanexar as outras telas	tmux detach-client -a -t $(q "$c")
X	Fechar a sessão…	tmux confirm-before -t $(q "$c") -p $(q "Fechar a sessão $sess? (y/n)") $(q "kill-session -t =$sess")
-		
s	☰ Sessões…	$EU --seletor-em $(q "$c") $(q "$MAQUINA") $p
a	🖥 Máquinas…	$EU --menu-maquinas $(q "$c") $p
ITENS
}

# --- Editor de atalhos da barra ------------------------------------------------
#
# Lista com cor, emoji, comando e origem (padrão do tt, personalizado nesta máquina, desativado).
# ⏎ edita, ^n cria, ^x exclui (um padrão fica desativado), ^r volta ao padrão, Esc fecha. Grava em
# ~/.config/tt/atalhos (mesmo formato: emoji⇥id⇥comando⇥cor⇥menu) e redesenha a barra de todos na hora.
CORES_ATALHO=$'#cba6f7\tmalva\n#fab387\tpêssego\n#f38ba8\tvermelho\n#eba0ac\tsalmão\n#f9e2af\tamarelo\n#a6e3a1\tverde\n#94e2d5\tturquesa\n#89dceb\tcéu\n#89b4fa\tazul\n#b4befe\tlavanda\n#f5c2e7\trosa\n#9399b2\tcinza'

amostra_cor() { # "#rrggbb" → bloco de cor (truecolor)
  local h=${1#\#}
  [[ $h =~ ^[[:xdigit:]]{6}$ ]] || h=cba6f7
  printf '\033[48;2;%d;%d;%dm   \033[0m' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"
}

linhas_editor_atalhos() {
  local emoji id cmd cor menu origem base loc padrao
  base=$(atalhos_base)
  printf '+\t\033[32m＋ Novo atalho…\033[0m\n'
  while IFS=$'\t' read -r emoji id cmd cor menu; do
    [[ -n $id ]] || continue
    loc=$(awk -F '\t' -v id="$id" '$2 == id { print; exit }' "$CONF_ATALHOS" 2>/dev/null)
    padrao=$(awk -F '\t' -v id="$id" '$2 == id { print; exit }' <<<"$base")
    if [[ -z $loc ]]; then
      origem=$'\033[90mpadrão\033[0m'
    elif [[ -n $padrao && $loc == "$padrao" ]]; then
      origem=$'\033[90mpadrão\033[0m'
    elif [[ -n $padrao ]]; then
      origem=$'\033[33mpersonalizado\033[0m'
    else
      origem=$'\033[36mseu\033[0m'
    fi
    printf '%s\t%s %s  %-28.28s  %s%s\n' "$id" "$(amostra_cor "$cor")" "$emoji" "$cmd" "$origem" "${menu:+  \033[90m☰ menu\033[0m}"
  done < <(atalhos_lista)
  # Padrões desativados aqui (emoji "-") continuam na lista, apagados, para poder voltar.
  while IFS=$'\t' read -r emoji id _; do
    [[ $emoji == - && -n $id ]] || continue
    IFS=$'\t' read -r emoji _ cmd cor _ < <(grep "^[^	]*	$id	" <<<"$base" | head -1)
    [[ -n $cmd ]] && printf '%s\t\033[90m    %s  %-28.28s  desativado (^r reativa)\033[0m\n' "$id" "$emoji" "$cmd"
  done 2>/dev/null <"$CONF_ATALHOS"
}

gravar_atalho() { # id emoji comando cor [menu] — substitui a linha do id (ou acrescenta)
  local id=$1 tmp
  mkdir -p "$CONF_DIR"; touch "$CONF_ATALHOS"
  tmp=$(mktemp "$CONF_ATALHOS.XXXXXX") || return 1
  awk -F'\t' -v id="$id" '$2 != id' "$CONF_ATALHOS" >"$tmp"
  [[ -n ${2:-} ]] && printf '%s\t%s\t%s\t%s%s\n' "$2" "$id" "${3:-}" "${4:-}" "${5:+$'\t'$5}" >>"$tmp"
  mv "$tmp" "$CONF_ATALHOS"
}

form_atalho() { # id (vazio = novo)
  local id=${1:-} emoji="" cmd="" cor='#cba6f7' menu="" l e c k m
  if [[ -n $id ]]; then IFS=$'\t' read -r emoji _ cmd cor menu < <(atalhos_lista | awk -F'\t' -v id="$id" '$2 == id' | head -1); fi
  [[ $cor =~ ^#[[:xdigit:]]{6}$ ]] || cor='#cba6f7'
  clear
  printf '\033[1m%s\033[0m\n\n' "$([[ -n $id ]] && echo "Editar atalho" || echo "Novo atalho")"
  printf 'Emoji ou até 3 letras do botão (ex.: 🦀, ⚡, git):\n'; read -r -e -i "$emoji" -p '› ' e || return 0
  printf '\nComando (roda numa sessão nova, na pasta do painel; ex.: claude --resume, htop):\n'; read -r -e -i "$cmd" -p '› ' c || return 0
  [[ -n $e && -n $c ]] || { printf '\nEmoji e comando são obrigatórios — nada mudou.\n'; sleep 1.5; return 0; }
  printf '\nMenu do botão direito (opcional; vazio = o botão direito só mostra o comando). Itens separados por " ;; ":\n'
  printf '  @contas (uma opção por conta de IA; o comando precisa de {conta}) · @maquinas (rodar noutra máquina)\n'
  printf '  Rótulo=comando (opção fixa) · - (separador)\n'
  read -r -e -i "$menu" -p '› ' m || return 0
  k=$(while IFS=$'\t' read -r h n; do printf '%s\t%s %s%s\n' "$h" "$(amostra_cor "$h")" "$n" "$([[ $h == "$cor" ]] && echo '  ✓ atual')"; done <<<"$CORES_ATALHO" |
    fzf --ansi --layout=reverse --delimiter=$'\t' --with-nth=2 --no-input --header="Cor do botão  (⏎ escolhe · Esc mantém a atual)" | cut -f1)
  cor=${k:-$cor}
  if [[ -z $id ]]; then
    id=$(slug "${c%% *}"); [[ -n $id ]] || id=atalho
    l=$id; n=2; while atalhos_lista | awk -F'\t' -v id="$l" '$2 == id { f = 1 } END { exit !f }'; do l="$id-$n"; n=$((n + 1)); done; id=$l
  fi
  gravar_atalho "$id" "$e" "$c" "$cor" "$m"
  redesenhar_todos
}

editar_atalhos() {
  local escolha acao id
  while true; do
    escolha=$(linhas_editor_atalhos | fzf --ansi --layout=reverse --no-sort --delimiter=$'\t' --with-nth=2 \
      --header=$'⏎ edita · ^n novo · ^x exclui · ^r volta ao padrão · Esc fecha' \
      --expect=enter,ctrl-n,ctrl-x,ctrl-r --no-input) || return 0
    acao=$(head -1 <<<"$escolha"); id=$(sed -n 2p <<<"$escolha" | cut -f1)
    case $acao in
      ctrl-n) form_atalho "" ;;
      ctrl-x)
        [[ -n $id && $id != + ]] || continue
        if atalhos_base | awk -F'\t' -v id="$id" '$2 == id { f = 1 } END { exit !f }'; then gravar_atalho "$id" - ""
        else gravar_atalho "$id"; fi
        redesenhar_todos ;;
      ctrl-r) [[ -n $id && $id != + ]] && { gravar_atalho "$id"; redesenhar_todos; } ;;
      *) if [[ $id == + ]]; then form_atalho ""; else form_atalho "$id"; fi ;;
    esac
  done
}

