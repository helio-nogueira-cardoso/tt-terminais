# Verbos de tarefa que recebem um ID aceitam também o apelido (kito47), um prefixo do código (4+ hex) e
# MÃE.N (kito47.2). Os internos da UI mandam o código inteiro e passam direto.
case "${1:-}" in
  --tarefa-ok | --tarefa-desfazer | --tarefa-abrir | --tarefa-rm | --tarefa-arquivar | --tarefa-restaurar | --tarefa-editar | --tarefa-frase | --tarefa-renomear | --tarefa-sub-add | --tarefa-desc | --tarefa-implementar | --tarefa-ia-prompt | --tarefa-email | --tarefa-codigo | --tarefa-log | --tarefa-historico)
    if [[ -n ${2:-} ]]; then
      _arg=$2; _id=$(tarefas_resolver "$2"); _rc=$?
      if ((_rc == 0)); then
        # Verbo que ALTERA, chamado por apelido/posição/prefixo: diz em qual item vai agir (stderr), para quem
        # chamou conferir. Pelo código inteiro não há o que conferir, então fica quieto.
        case $1 in
          --tarefa-ok | --tarefa-desfazer | --tarefa-abrir | --tarefa-rm | --tarefa-arquivar | --tarefa-restaurar | --tarefa-editar | --tarefa-renomear | --tarefa-sub-add | --tarefa-desc | --tarefa-log)
            [[ ${_arg,,} == "$_id" ]] || tarefas_eco_alvo "$_id" "$_arg" ;;
        esac
        set -- "$1" "$_id" "${@:3}"
      elif ((_rc == 2)); then exit 1
      elif ! [[ ${2,,} =~ ^[0-9a-f]+$ ]]; then echo "tarefa '$2' não encontrada (use o apelido ou o código: tt --tarefa-codigo)" >&2; exit 1; fi
    fi ;;
  --demanda-aprovar | --demanda-recusar)
    _a=("$1"); for _i in "${@:2}"; do _a+=("$(tarefas_id_arg "$_i")"); done; set -- "${_a[@]}" ;;
esac

