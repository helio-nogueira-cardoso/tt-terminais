  local c=$1 cw ch w h
  read -r cw ch < <(do_cliente "$c" '#{client_width} #{client_height}')
  w=76; h=36; ((w > ${cw:-80})) && w=${cw:-80}; ((h > ${ch:-24})) && h=${ch:-24}
  tmux display-popup -c "$c" -w "$w" -h "$h" -b rounded -S 'fg=#89b4fa' -T ' ▦ agenda · esc fecha ' \
    -E "TT_CLIENTE=$(q "$c") TT_BARRA_FUNDO=1 $EU --calendario-agenda"
}

# Saída texto (CLI pura): usada por `tt --tarefas` fora do tmux e como fallback sem fzf.
tarefas_listar() {
  local n; n=$(tarefas_raw | awk -F'\t' '$2 == "aberta"' | wc -l | tr -d ' ')
  printf '📋 tarefas (%s aberta%s)\n' "$n" "$( ((n==1)) || printf s )"
  local i est txt m pai ap
  while IFS=$'\t' read -r i est txt m; do
    [[ $m == - ]] && m=""; pai=$(tarefas_meta_get "$m" pai)
    [[ -n $pai ]] && continue
    printf '  %s  %s  [%s %s]\n' "$([[ $est == feita ]] && echo ☑ || echo ☐)" "$txt" "$(tarefa_slug "$i")" "$i"
    while IFS=$'\t' read -r si sest stxt; do
      printf '      %s  %s  [%s %s]\n' "$([[ $sest == feita ]] && echo ☑ || echo ☐)" "$stxt" "$(tarefa_ref "$si")" "$si"
    done < <(tarefas_filhas "$i")
  done < <(tarefas_vivas | awk -F'\t' '{ print $1 "\t" $2 "\t" $5 "\t" ($6 == "" ? "-" : $6) }')
}

