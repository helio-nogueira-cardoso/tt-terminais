-		
e	📤 Enviar arquivos daqui…	$(popup_tt "$c" "📤 enviar" "$env $EU --enviar")
t	📥 Trazer arquivos para cá…	$(popup_tt "$c" "📥 trazer" "$env $EU --trazer")$copiado
u	📥 Recebidos recentes…	$(popup_tt "$c" "📥 recebidos" "$EU --recebidos")
f	⇅ Acompanhar as transferências…	$(popup_tt "$c" "⇅ transferências" "$EU --transferencias")
d	📂 Abrir a pasta de recebidos	$EU --abrir-pasta $(q "$(pasta_recebidos)") $(q "$c")
