mac_atalhos() {
  local acao=${1:-status} term meta conf
  [[ $(uname -s) == Darwin ]] || { echo "tt --mac: só faz sentido no macOS (aqui: $(uname -s))"; [[ $acao == atalhos ]] && mac_atalhos_tabela; return 0; }
  term=$(mac_terminal)
  case $acao in
    atalhos) mac_atalhos_tabela ;;
    status)
      case $term in
        terminal) meta=$(mac_terminal_meta ler)
          [[ $meta == 1 ]] && echo "Terminal.app: Option como Meta ligado ✓" || echo "Terminal.app: Option como Meta DESLIGADO (tt --mac ativar; vale em janelas novas)" ;;
        ghostty) conf=$(mac_ghostty_conf)
          if grep -Eqs '^[[:space:]]*macos-option-as-alt[[:space:]]*=[[:space:]]*(true|left|right)' "$conf"; then echo "Ghostty: macos-option-as-alt ligado ✓ ($conf)"
          else echo "Ghostty: Option como Alt DESLIGADO (tt --mac ativar)"; fi ;;
        iterm) echo "iTerm2: ligue em Settings > Profiles > Keys > General: Left Option key = Esc+ (o tt não mexe nos perfis do iTerm2)" ;;
        wezterm) echo "WezTerm: no wezterm.lua, use send_composed_key_when_left_alt_is_pressed = false (o tt não edita o arquivo)" ;;
        *) echo "terminal não reconhecido: defina TT_MAC_TERMINAL=terminal|ghostty|iterm|wezterm ou veja tt --mac atalhos" ;;
      esac
      echo "Ctrl+clique no Mac é botão direito; use Option+clique/arrastar. Tabela completa: tt --mac atalhos" ;;
    ativar)
      case $term in
        terminal) meta=$(mac_terminal_meta gravar)
          [[ $meta == 1 ]] && echo "Terminal.app: Option como Meta ligado no perfil padrão (cópia em ~/.config/tt/backup). Abra uma janela NOVA do Terminal para valer." || { echo "não consegui gravar; ligue em Terminal > Settings > Profiles > Keyboard > Use Option as Meta key" >&2; return 1; } ;;
        ghostty) conf=$(mac_ghostty_conf)
          if grep -Eqs '^[[:space:]]*macos-option-as-alt' "$conf"; then echo "Ghostty: macos-option-as-alt já está no $conf; confira o valor (true)."
          else mkdir -p "${conf%/*}" && printf '\n# tt: Option como Alt (atalhos Alt+… do tmux)\nmacos-option-as-alt = true\n' >> "$conf" && echo "Ghostty: gravei macos-option-as-alt = true em $conf (recarregue com Cmd+Shift+,)."; fi ;;
        *) mac_atalhos status; return 1 ;;
      esac ;;
    *) echo "uso: tt --mac [status|ativar|atalhos]" >&2; return 2 ;;
  esac
}

# A instalação/atualização é a entrada normal de uma máquina nova. No macOS, além do
# zshenv e do tmux, deixa o terminal com os atalhos padrão e liga o fallback WebSocket
# versionado do Tailscale. TT_MAC_AUTO=0 é reservado para testes ou para uma instalação
# deliberadamente manual; cada operação continua idempotente.
mac_configurar_padrao() {
  [[ $(uname -s 2>/dev/null) == Darwin ]] || return 0
  [[ ${TT_MAC_AUTO:-1} == 0 ]] && return 0
  local term rc=0
  term=$(mac_terminal)
  case $term in
    terminal|ghostty) mac_atalhos ativar || rc=1 ;;
    iterm|wezterm) echo "macOS: $term preserva a configuração do terminal; veja tt --mac status." ;;
    *) echo 'macOS: terminal não reconhecido; veja tt --mac atalhos.' ;;
  esac
  if [[ ${TT_TAILSCALE_WS_AUTO:-1} != 0 ]]; then
    tailscale_ws_garantir || echo 'macOS: WebSocket pendente; o vigia tentará de novo (tt --tailscale-ws status).'
  fi
  return "$rc"
}

