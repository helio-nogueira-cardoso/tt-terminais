# tt --garantir-navegadores: baixa os navegadores de links (Carbonyl e Chrome) que ainda faltam nesta
# máquina, sem esperar o primeiro clique. Idempotente: o que já está instalado é pulado; uma instância por
# vez. Não pede nada: se faltar curl/unzip (administrador) ou o download falhar, a pendência continua no
# catálogo e o vigia avisa (📦); quem disse "não" ou "mais tarde" a um deles não é incomodado.
garantir_navegadores() {
  navegadores_graficos_ok || return 0
  local lock=$DIR_NAVEGADORES.lock id
  mkdir -p "$DIR_NAVEGADORES" 2>/dev/null
  mkdir "$lock" 2>/dev/null || { [[ -n $(find "$lock" -maxdepth 0 -mmin +60 2>/dev/null) ]] && rm -rf "$lock" && mkdir "$lock" 2>/dev/null; } || return 0
  for id in carbonyl chrome; do
    pend_avaliar "$id" || continue
    ((P_APLICA)) && [[ $P_USR == 1 && -z $P_SYS ]] || continue
    pend_recusado "$id" && continue
    pend_usuario_instalar "$id" || echo "navegadores: $P_ROTULO não instalado (tenta de novo na próxima atualização)" >&2
  done
  rmdir "$lock" 2>/dev/null
  ("$EU" --pendencias-avisar >/dev/null 2>&1 &)
  return 0
}

# Dispara garantir_navegadores em segundo plano e sem travar a instalação nem a sincronização.
garantir_navegadores_em_segundo_plano() {
  navegadores_graficos_ok || return 0
  # TT_SEM_NAVEGADORES=1 (testes): cada instalação num HOME temporário disparava o download do
  # Chrome e do Carbonyl, morto segundos depois com a pasta do teste.
  [[ -n ${TT_SEM_NAVEGADORES:-} ]] && return 0
  mkdir -p "$HOME/.cache/tt"
  setsid nice -n 10 "$HOME/.local/bin/tt" --garantir-navegadores >>"$HOME/.cache/tt/navegadores.log" 2>&1 </dev/null &
}

# Cliente tmux onde o popup deve aparecer. O e-mail já é um popup do cliente de fora, e o tmux não abre
# popup sobre popup: o certo é o cliente anexado à sessão oculta do e-mail (o de dentro do popup), que
# tem o tamanho do que o usuário está vendo. Sem ele (aerc chamado fora do tt), o cliente mais recente.
cliente_externo() {
  local l; l=$(tmux list-clients -F '#{client_activity} #{client_name} #{session_name}' 2>/dev/null | sort -rn)
  awk -v s="$EMAIL_SESSAO" '$3 == s {print $2; exit}' <<<"$l" | grep . ||
    awk 'NR==1{print $2}' <<<"$l"
}

# Rodando num popup do tmux com terminal: o tmux não abre outro popup por cima (só modifica o atual),
# então o que precisaria de um popup roda aqui mesmo. Jobs de popup têm TMUX mas não TMUX_PANE.
# Numa janela flutuante (painel modal) o TMUX_PANE existe, então vale a marca TT_EM_JANELA que a popup_janela põe.
em_popup() { [[ -t 0 && -t 1 ]] && { [[ -n ${TMUX:-} && -z ${TMUX_PANE:-} ]] || [[ -n ${TT_EM_JANELA:-} ]]; }; }

# O aerc e a central usam janelas temporárias no mesmo cliente. Um marcador por cliente impede que
# um seja empilhado sobre o outro; o PID permite limpar a reserva se a janela cair inesperadamente.
popup_exclusivo_reservar() { # tipo cliente; imprime o caminho da reserva em POPUP_EXCLUSIVO
  local tipo=$1 c=$2 chave dir velho
  if command -v sha256sum >/dev/null; then chave=$(printf '%s' "$c" | sha256sum | cut -c1-16)
  else chave=$(printf '%s' "$c" | shasum -a 256 | cut -c1-16); fi
  [[ -n $chave ]] || return 1
  dir="$RT/tt-popup-exclusivo-$UID-$chave"
  mkdir -p "$RT"
  if ! mkdir "$dir" 2>/dev/null; then
    read -r velho _ 2>/dev/null <"$dir/dono" || velho=
    if [[ $velho =~ ^[0-9]+$ ]] && kill -0 "$velho" 2>/dev/null; then return 1; fi
    rm -rf "$dir"
    mkdir "$dir" 2>/dev/null || return 1
  fi
  printf '%s %s\n' "$$" "$tipo" >"$dir/dono"
  POPUP_EXCLUSIVO=$dir
}
popup_exclusivo_liberar() { [[ -n ${1:-} ]] && rm -rf -- "$1"; }

# Roda CMD (string de shell) fora do namespace sem rede do w3m/aerc: pelo servidor do tmux.
# popup=1 abre num popup grande (para o que precisa de terminal); senão em segundo plano.
rodar_fora() {
  local popup=$1 cmd=$2 c
  # Dentro de um popup grande com terminal (o cadastro de conta: TMUX sem TMUX_PANE), roda ali mesmo.
  if [[ $popup == 1 ]] && em_popup && [[ -z ${TT_LINK_CLIENTE:-} ]]; then bash -c "$cmd"; return; fi
  if [[ -n ${TMUX:-} ]] && c=${TT_LINK_CLIENTE:-$(cliente_externo)} && [[ -n $c ]]; then
    # run-shell lê o comando como formato do tmux: um "#S" ou "#{" dentro da URL virava o nome da
    # sessão. "##" é o "#" literal. Num popup (o seletor do clique em link), outro popup não abre
    # (o tmux só modifica o atual): o navegador sobe depois que o seletor fecha.
    if [[ $popup == 1 && ${TT_LINK_POPUP:-0} == 1 ]]; then
      cmd="sleep 0.3; tmux display-popup -c $(q "$c") -E $(tam_popup "$c") -b rounded -S 'fg=#89b4fa' -T ' 🌐 navegador · Ctrl+Q (ou Ctrl+C) fecha ' $(q "$cmd")"
      tmux run-shell -b "${cmd//#/##}"
    elif [[ $popup == 1 ]]; then popup_fixo -c "$c" -E $(tam_popup "$c") -b rounded -S 'fg=#89b4fa' -T ' 🌐 navegador · Ctrl+Q (ou Ctrl+C) fecha ' "$cmd"
    else tmux run-shell -b "${cmd//#/##}"; fi
  else
    if [[ $popup == 1 ]]; then bash -c "$cmd"; else setsid bash -c "$cmd" >/dev/null 2>&1 </dev/null & fi
  fi
}

# Abre o modal das pendências (ids…) onde for possível: no próprio popup (o tmux não abre popup sobre
# popup, e o leitor de e-mail roda sem rede, onde sudo/apt não funcionam), num popup do cliente de fora ou
# no terminal de quem chamou. Devolve 1 se não há onde mostrar (vigia, script sem terminal).
pedir_pendencia_aqui() {
  local c
  if em_popup; then pedir_sudo_pendencias "$@"
  elif [[ -n ${TMUX:-} ]] && c=$(cliente_externo 2>/dev/null) && [[ -n $c ]]; then
    popup_fixo -c "$c" -E $(dim_popup "$c" 92 22) -b rounded -S 'fg=#f9e2af' -T ' 📦 pendências de instalação ' "$EU --pedir-sudo $*"
  elif [[ -t 0 ]]; then pedir_sudo_pendencias "$@"
  else return 1; fi
}

# Chrome/Carbonyl sem as bibliotecas do sistema: oferece instalar (modal). Devolve 0 se ficou utilizável.
garantir_chrome_libs() {
  [[ -n $(chrome_libs_faltando) ]] || return 0
  pedir_pendencia_aqui chrome-libs
  [[ -z $(chrome_libs_faltando) ]]
}

# O navegador de links (chromium|carbonyl) está pronto? Baixa se faltar; se faltar curl/unzip (administrador),
# oferece instalar pelo modal e tenta de novo.
garantir_navegador() {
  local id=$1; [[ $id == chromium ]] && id=chrome
  pend_avaliar "$id" 2>/dev/null
  if [[ $P_USR == 1 && -n $P_SYS ]]; then pedir_pendencia_aqui "$id" || true; fi
  navegador_instalar "$1"
}

# Tela gráfica para o Chrome interno. A sessão do tmux pode estar com DISPLAY/WAYLAND_DISPLAY
# removidos (a última anexação veio de um terminal sem eles: ssh, mosh, outro aparelho), e tudo o
# que roda nela herda isso: o Chrome morria calado com "Missing X server or $DISPLAY". Procura no
# ambiente, no ambiente global do tmux e nos sockets (WSLg, X11, Wayland). Uma linha para cada.
tela_grafica() { # → DISPLAY, WAYLAND_DISPLAY, XDG_RUNTIME_DIR
  local d=${DISPLAY:-} w=${WAYLAND_DISPLAY:-} x=${XDG_RUNTIME_DIR:-} s
  [[ -n $x ]] || x=/run/user/$(id -u)
  [[ -n $d ]] || d=$(tmux show-environment -g DISPLAY 2>/dev/null | sed -n 's/^DISPLAY=//p')
  [[ -n $w ]] || w=$(tmux show-environment -g WAYLAND_DISPLAY 2>/dev/null | sed -n 's/^WAYLAND_DISPLAY=//p')
  if [[ -z $d ]]; then for s in "${TT_X11_DIR:-/tmp/.X11-unix}"/X*; do [[ -S $s ]] && { d=:${s##*/X}; break; }; done; fi
  if [[ -z $w ]]; then for s in "$x"/wayland-[0-9]*; do [[ -S $s ]] && { w=${s##*/}; break; }; done; fi
  printf '%s\n%s\n%s\n' "$d" "$w" "$x"
}

# tt --chrome-falhou CLIENTE URL: o Chrome interno não subiu. Diz por quê (a última linha de erro dele)
# e abre no navegador do sistema.
chrome_falhou() {
  local c=$1 u=$2 motivo
  motivo=$(grep -v 'CHROME_VERSION_EXTRA' "$HOME/.cache/tt/chrome.log" 2>/dev/null | grep -m1 -oE '(Missing X server[^]]*|[A-Z][^]]*failed[^]]*)$')
  [[ -n $c ]] || c=$(cliente_externo 2>/dev/null)
  tmux display-message ${c:+-c "$c"} -d 5000 "🌐 Chrome interno não abriu${motivo:+ ($motivo)} — abri no navegador do sistema. Detalhes: ~/.cache/tt/chrome.log" 2>/dev/null
  abrir_url "$u"
}

# Máquina onde está a tela do cliente C, quando não é esta: C é uma ponte vinda de outra máquina
# (TT_PONTE="máquina|ponte") ou um cliente aberto dentro de uma (o do popup do e-mail: TT_ORIGEM).
# Vazio quando a tela é desta máquina. No macOS (sem /proc) o ambiente vem do `ps eww`. No w3m do e-mail
# (user namespace do unshare) o environ do cliente é negado: aí quem lê é o servidor do tmux (run-shell).
maquina_da_tela() {
  local c=${1:-} pid o ler
  [[ -n $c ]] || return 0
  pid=$(do_cliente "$c" '#{client_pid}'); [[ $pid =~ ^[0-9]+$ ]] || return 0
  if [[ -e /proc/$pid/environ ]] && ! (exec 3<"/proc/$pid/environ") 2>/dev/null; then
    ler="tr '\\0' '\\n' </proc/$pid/environ | sed -n 's/^TT_PONTE=//p; s/^TT_ORIGEM=//p' | head -1"
    o=$(tmux run-shell "$ler" 2>/dev/null)
  else o=$(env_do_pid "$pid" TT_PONTE); [[ -n $o ]] || o=$(env_do_pid "$pid" TT_ORIGEM); fi
  o=${o%%|*}
  [[ -n $o && $o != "$MAQUINA" ]] && printf '%s\n' "$o"
  return 0
}

# Navegador gráfico (o do sistema ou o Chrome) abre na máquina em que se clicou, não na da sessão: vendo
# pelo book-hl uma sessão do PC, o link abre no book-hl. Vai pelo servidor do tmux (rodar_fora: o w3m do
# e-mail roda sem rede) e por ssh; se a de lá não responder (ou for de uma versão sem --abrir-aqui),
# abre aqui, como antes. Devolve 1 se a tela é desta máquina.
abrir_na_tela() {
  local qual=$1 u=$2 c om d
  [[ -z ${TT_ABRIR_AQUI:-} ]] || return 1
  # No Mac, tanto o navegador do sistema quanto o Chromium interno pertencem à tela local. A sessão
  # pode estar em ponte para empresa; não mande o clique de volta para a máquina que hospeda a sessão.
  [[ $(navegador_so) == macos && ( $qual == sistema || $qual == chromium ) ]] && return 1
  c=${TT_LINK_CLIENTE:-}
  [[ -n $c || -z ${TMUX:-} ]] || c=$(cliente_externo)
  om=$(maquina_da_tela "$c"); [[ -n $om ]] || return 1
  d=$(dest_ir "$om"); [[ -n $d && $d != . ]] || return 1
  [[ -n $c ]] && tmux display-message -c "$c" -d 2500 "🌐 abrindo em $om" 2>/dev/null
  rodar_fora 0 "timeout 20 ssh $(q "${SSH_OPC[@]}") $(q "$d") $(q "$TT_REMOTO --abrir-aqui $(q "$qual" "$u")") </dev/null >/dev/null 2>&1 || TT_ABRIR_AQUI=1 $(q "$EU") --abrir-aqui $(q "$qual" "$u")"
}

abrir_com() {
  local qual=$1 u=$2 disp=${DISPLAY:-} way=${WAYLAND_DISPLAY:-} xdg=${XDG_RUNTIME_DIR:-}
  case $qual in sistema|chromium) abrir_na_tela "$qual" "$u" && return 0 ;; esac
  case $qual in
    sistema) abrir_url "$u" ;;
    samsung) abrir_samsung_internet "$u" ;;
    copiar) link_copiar "${TT_LINK_CLIENTE:-}" "$u" ;;
    chromium)
      if [[ $(navegador_so) == macos ]]; then chromium_macos_abrir "$u"; return $?; fi
      garantir_navegador chromium || return 1
      garantir_chrome_libs || { echo "Sem as bibliotecas, abro no navegador do sistema."; sleep 1; abrir_url "$u"; return 0; }
      (chrome_atualizar_se_velho >/dev/null 2>&1 &)
      { read -r disp; read -r way; read -r xdg; } < <(tela_grafica)
      local log=$HOME/.cache/tt/chrome.log; mkdir -p "${log%/*}"
      # Saída 0 também quando só entrega a URL a uma janela já aberta. Erro logo na partida (sem tela,
      # perfil travado…) avisa e abre no navegador do sistema, em vez de sumir calado; um erro horas
      # depois (Chrome fechado à força) não conta.
      rodar_fora 0 "export DISPLAY=$(q "$disp") WAYLAND_DISPLAY=$(q "$way") XDG_RUNTIME_DIR=$(q "$xdg"); t0=\$(date +%s); { setsid $(q "$(bin_chromium)") --user-data-dir=$(q "$DIR_NAVEGADORES/perfil-chrome") --no-first-run --no-default-browser-check $(q "$u") >$(q "$log") 2>&1 </dev/null || { [ \$(( \$(date +%s) - t0 )) -lt 15 ] && $(q "$EU") --chrome-falhou $(q "${TT_LINK_CLIENTE:-}") $(q "$u"); }; } &" ;;
    carbonyl)
      garantir_navegador carbonyl || return 1
      garantir_chrome_libs || { echo "Sem as bibliotecas, abro no navegador do sistema."; sleep 1; abrir_url "$u"; return 0; }
      # O Carbonyl só sai com Ctrl+C; o links-tt.py com-ctrl-q faz o Ctrl+Q do título do popup valer.
      local car; car="$(q "$(bin_carbonyl)") --user-data-dir=$(q "$DIR_NAVEGADORES/perfil-carbonyl") --user-agent=$(q "$(ua_chrome)") $(q "$u")"
      command -v python3 >/dev/null && [[ -f $LINKS_PY ]] && car="python3 -I $(q "$LINKS_PY") com-ctrl-q $car"
      rodar_fora 1 "$car" ;;
  esac
}

# tt --abrir-link URL: aplica a chave navegador= ou pergunta (fzf no terminal de quem chamou; se não
# houver terminal, num popup do tmux; sem nenhum dos dois, navegador do sistema).
abrir_link() {
  local u=${1:-} esc pref ultimo c
  [[ -n $u ]] || return 0
  pref=$(conf navegador); pref=${pref:-perguntar}
  if [[ $(navegador_so) == macos ]]; then
    if tem_cmd termux-open-url; then
      [[ $pref == samsung ]] && samsung_internet_disponivel || pref=sistema
    elif [[ $pref == samsung ]]; then pref=sistema; fi
  elif ! navegadores_graficos_ok; then
    if [[ $pref == samsung || $pref == perguntar ]]; then samsung_internet_disponivel || pref=sistema
    else pref=sistema; fi
  fi
  if [[ $pref == perguntar ]]; then
    if [[ -t 0 ]]; then
      ultimo=$(cat "$ESTADO_DIR/navegador-ultimo" 2>/dev/null)
      local -a opcoes=(
        sistema "Navegador padrão do sistema"
      )
      if [[ $(navegador_so) == macos ]]; then
        if navegador_link_grafico_ok; then opcoes=(chromium "Chromium interno (Google Chrome · perfil do tt)" "${opcoes[@]}"); fi
      else
        opcoes=(chromium "Google Chrome interno (janela gráfica)"
          carbonyl "Carbonyl embutido (no terminal · Chromium de 2023, sem atualizações)" "${opcoes[@]}")
      fi
      samsung_internet_disponivel && opcoes+=(samsung "Samsung Internet")
      opcoes+=(copiar "📋 Só copiar o link (inteiro)")
      esc=$(printf '%s\t%s\n' "${opcoes[@]}" |
        awk -F'\t' -v u="$ultimo" 'BEGIN{OFS="\t"} {print $1, $2 ($1==u ? "  ← último" : "")}' |
        fzf --delimiter='\t' --with-nth=2 --no-sort --layout=reverse --height=~8 --prompt='❯ ' \
            --header="Abrir ${u:0:100}" | cut -f1) || return 0
      [[ -n $esc ]] || return 0
      mkdir -p "$ESTADO_DIR" && echo "$esc" >"$ESTADO_DIR/navegador-ultimo"
      abrir_com "$esc" "$u"; return
    elif [[ -n ${TMUX:-} ]] && c=$(cliente_externo) && [[ -n $c ]]; then
      tmux display-popup -c "$c" -E $(dim_popup "$c" 80 12) -b rounded -T ' 🌐 abrir link ' "$EU --abrir-link $(q "$u")"; return
    fi
    pref=sistema
  fi
  abrir_com "$pref" "$u"
}

# --- Links em qualquer painel ----------------------------------------------------
#
# Clique (ou Ctrl+clique) num endereço, em qualquer painel, abre a mesma escolha do e-mail (Chrome
# interno, Carbonyl ou o navegador do sistema) com a URL inteira, mesmo quando a tela a partiu em
# várias linhas — inclusive com recuo ou borda, como no Claude Code. Quem acha o link é o
# links-tt.py (chamado pelo tmux.conf no clique); fora de um link, o clique segue para o programa.
# O duplo clique num link copia o link inteiro; Ctrl+B u (e o menu do painel) lista os links da tela.
LINKS_PY=$DIR_TT/links-tt.py
[[ -f $LINKS_PY ]] || LINKS_PY=${EU%/*}/links-tt.py

# tt --link-abrir ID CLIENTE PAINEL URL (do links-tt.py). Com ID, é um clique (simples ou com Ctrl): espera o tempo
# de um duplo clique e desiste se veio o 2º clique ou um arrasto (o tmux.conf limpa @tt_link_id).
link_abrir() {
  local id=$1 c=$2 p=$3 u=$4 pref
  [[ $u == http://* || $u == https://* ]] || return 0
  if [[ -n $id ]]; then
    sleep 0.35
    [[ $(tmux show -gv @tt_link_id 2>/dev/null) == "$id" ]] || return 0
    tmux set -gu @tt_link_id 2>/dev/null
    [[ $(tmux display -p -t "$p" '#{pane_in_mode}' 2>/dev/null) == 0 ]] || return 0
  fi
  pref=$(conf navegador); pref=${pref:-perguntar}
  if [[ $(navegador_so) == macos ]]; then
    if tem_cmd termux-open-url; then
      [[ $pref == samsung ]] && samsung_internet_disponivel || pref=sistema
    elif [[ $pref == samsung ]]; then pref=sistema; fi
  elif ! navegadores_graficos_ok; then
    if [[ $pref == samsung || $pref == perguntar ]]; then samsung_internet_disponivel || pref=sistema
    else pref=sistema; fi
  fi
  if [[ $pref != perguntar ]]; then TT_LINK_CLIENTE=$c abrir_com "$pref" "$u"; return 0; fi
  tmux display-popup -c "$c" -E $(dim_popup "$c" 84 12) -b rounded -T ' 🌐 abrir link ' \
    "TT_LINK_CLIENTE=$(q "$c") TT_LINK_POPUP=1 $EU --abrir-link $(q "$u")"
}

# tt --link-copiar CLIENTE URL: o link inteiro vai para o tmux (e o terminal, por OSC 52), para a área
# de transferência e para o histórico de cópias, com o aviso de sempre.
link_copiar() {
  local c=$1 u=$2
  [[ -n $u ]] || return 0
  tmux set-buffer -w -- "$u" 2>/dev/null
  printf '%s' "$u" | copiar
  if [[ -n $c ]]; then tmux display-message -c "$c" -d 1800 "🔗 link copiado inteiro (${#u} caracteres) — cole com Ctrl+Shift+V, botão do meio ou ⋯"
  elif [[ -t 1 ]]; then echo "✓ link copiado (${#u} caracteres)."; sleep 0.8
  fi
}

# Ctrl+B u / menu do painel: os links da tela e do histórico do painel, do mais recente ao mais
# antigo. ⏎ abre (escolha do navegador), ^y copia.
links_tela() {
  local c=$1 p=$2
  tmux display-popup -c "$c" -E $(tam_popup "$c") -b rounded -T ' 🔗 links da tela ' "TT_LINK_CLIENTE=$(q "$c") $EU --links-tela-ui $(q "$p")"
}

links_tela_ui() {
  local p=$1 lista esc tecla u
  lista=$(python3 -I "$LINKS_PY" todos "$p" 2>/dev/null)
  if [[ -z $lista ]]; then echo "Nenhum link (http/https) na tela nem no histórico deste painel."; sleep 1.5; return 0; fi
  esc=$(fzf --no-sort --layout=reverse --prompt='🔗 ' --expect=ctrl-y --wrap \
    --header='⏎ abre (escolha o navegador) · ^y copia o link inteiro · esc fecha' <<<"$lista") || return 0
  tecla=$(sed -n 1p <<<"$esc"); u=$(sed -n 2p <<<"$esc")
  [[ -n $u ]] || return 0
  if [[ $tecla == ctrl-y ]]; then link_copiar "${TT_LINK_CLIENTE:-}" "$u"; else abrir_link "$u"; fi
}

# Cópia por seleção do tmux (arrasto, duplo/triplo clique, teclado): o tmux.conf passa a largura do
# painel e a seleção (copy-pipe com @tt_copiar). Endereço, caminho ou código que a tela partiu na
# borda direita volta a ser uma coisa só, sem a quebra e sem o recuo que o programa pôs na linha de
# baixo (links-tt.py desquebrar); quebras de verdade ficam. O buffer do tmux (colar) e o OSC 52
# recebem o texto corrigido também. Seleção retangular fica como está.
desquebrar_copia() {
  local t=$1 w=${2:-0} sx=${3:-0} sy=${4:-0} ex=${5:-0} ey=${6:-0} ret=${7:-0} c=${8:-} x0 novo b
  [[ $w =~ ^[0-9]+$ && $sx =~ ^[0-9]+$ && $sy =~ ^[0-9]+$ && $ex =~ ^[0-9]+$ && $ey =~ ^[0-9]+$ ]] || return 0
  ((w > 0)) && [[ $ret != 1 && -f $LINKS_PY ]] && command -v python3 >/dev/null || return 0
  if ((sy < ey || (sy == ey && sx <= ex))); then x0=$sx; else x0=$ex; fi
  novo=$(mktemp) || return 0
  if python3 -I "$LINKS_PY" desquebrar "$w" "$x0" <"$t" >"$novo" 2>/dev/null && [[ -s $novo ]] && ! cmp -s "$t" "$novo"; then
    mv "$novo" "$t"
    # Troca a cópia partida pela religada como cópia NOVA: carregar com -b NOME tornaria o buffer
    # "nomeado", e o colar do tmux (botão do meio, paste-buffer) pularia para a cópia anterior.
    b=$(tmux list-buffers -F '#{buffer_name}' 2>/dev/null); b=${b%%$'\n'*}
    [[ -n $b ]] && tmux delete-buffer -b "$b" 2>/dev/null
    tmux load-buffer -w "$t" 2>/dev/null
    [[ -n $c ]] && tmux display-message -c "$c" -d 1800 "📋 copiado ($(wc -m <"$t") caracteres) — o que a tela tinha partido em linhas voltou a ser uma coisa só"
  else
    rm -f "$novo"
  fi
}

# --- Histórico de cópias e cópia entre máquinas --------------------------------
#
# Cada cópia (desta máquina ou recebida de outra) vira um arquivo em ~/.cache/tt-copias, nome
# "NANOSSEGUNDOS_MÁQUINA"; ficam as 100 mais recentes. Toda cópia feita aqui vai também para as
# outras máquinas ligadas (tt --receber-copia), que a põem na área de transferência, no tmux (e,
# por OSC 52, no terminal de quem estiver olhando) e no histórico. copia_entre_maquinas=0 no
# config desliga o envio.
DIR_COPIAS=$HOME/.cache/tt-copias
LIMITE_COPIA=$((2 * 1024 * 1024))

copia_mais_recente() { ls -1 "$DIR_COPIAS" 2>/dev/null | sort | tail -1; }
copia_repetida() {
  local u
  u=$(copia_mais_recente); [[ -n $u ]] || return 1
  cmp -s "$1" "$DIR_COPIAS/$u"
}
registrar_copia() {
  local t=$1 origem=${2:-$MAQUINA}
  mkdir -p "$DIR_COPIAS" && chmod 700 "$DIR_COPIAS"
  cp "$t" "$DIR_COPIAS/$(date +%s%N)_${origem//[^A-Za-z0-9_-]/}"
  ls -1 "$DIR_COPIAS" | sort | head -n -100 | while read -r f; do rm -f "$DIR_COPIAS/$f"; done
}

propagar_copia() {
  local -a pids=()
  local t=$1 dest rot
  if (($(stat -c %s "$t" 2>/dev/null || echo 0) <= LIMITE_COPIA)); then
    while read -r dest rot; do
      timeout 10 ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --receber-copia $(q "$MAQUINA")" <"$t" >/dev/null 2>&1 & pids+=($!)
    done < <(maquinas)
    esperar ${pids[@]+"${pids[@]}"}
  fi
  rm -f "$t"
}

receber_copia() {
  local origem=${1:-?} t
  t=$(mktemp) || return 0
  cat >"$t"
  if [[ -s $t ]] && ! copia_repetida "$t"; then
    registrar_copia "$t" "$origem"
    copiar_local "$t"
    tmux list-sessions >/dev/null 2>&1 && tmux load-buffer -w "$t" 2>/dev/null
  fi
  rm -f "$t"
}

# --- Propagar uma conta de IA entre as máquinas -------------------------------
#
# Uma conta do ia-conta é a pasta ~/.local/share/claude-contas/<nome>. Só a credencial e os poucos
# arquivos próprios dela são da conta; projects/history/sessions/settings são links para ~/.claude
# (dados locais, compartilhados por todas as contas desta máquina). "tt --conta-propagar <nome>"
# manda os arquivos próprios para as outras máquinas; cada uma recria os links para o seu ~/.claude
# e o atalho claude-<nome>. Não vão links nem dados compartilhados: cada máquina tem os seus.
CONTAS_RAIZ=$HOME/.local/share/claude-contas
# Arquivos próprios de uma conta (o resto da pasta é link para ~/.claude e fica em cada máquina).
CONTA_ITENS=(.credentials.json .account-email .claude.json backups)

conta_propagar() {
  local nome=${1:-}; shift || true
  local -a alvos=("$@")
  local dir dest rot alvo item
  [[ -n $nome ]] || { echo "uso: tt --conta-propagar <nome> [rótulo…]" >&2; return 1; }
  dir=$CONTAS_RAIZ/$nome
  [[ -s $dir/.credentials.json && ! -L $dir/.credentials.json ]] ||
    { echo "conta '$nome' não existe aqui (sem $dir/.credentials.json)" >&2; return 1; }
  local -a presentes=()
  for item in "${CONTA_ITENS[@]}"; do
    [[ -e $dir/$item && ! -L $dir/$item ]] && presentes+=("$item")
  done
  echo "Propagando a conta '$nome' (${presentes[*]})"
  while read -r dest rot; do
    if ((${#alvos[@]})); then
      for alvo in "${alvos[@]}"; do [[ $alvo == "$rot" ]] && break; alvo=""; done
      [[ -n $alvo ]] || continue
    fi
    printf '  %-10s ' "$rot"
    tar -C "$dir" -cf - "${presentes[@]}" 2>/dev/null |
      timeout 20 ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --conta-receber $(q "$nome")" 2>&1 |
      tail -1 | sed 's/^[^:]*: //' || echo "✗ sem resposta"
  done < <(maquinas)
}

# tt --conta-receber <nome>: recebe pelo stdin o tar com os itens próprios da conta e a instala
# aqui, transacional. Exige ~/.claude (onde não há Claude Code — por exemplo um celular — a conta
# não faz sentido e a função sai avisando, sem erro fatal para a propagação).
conta_receber() {
  local nome=${1:-}
  local dir tmp item
  [[ -n $nome ]] || { echo ": nome ausente" >&2; return 0; }
  if [[ ! -d $HOME/.claude ]]; then echo "· sem Claude Code aqui, pulada"; cat >/dev/null; return 0; fi
  dir=$CONTAS_RAIZ/$nome
  mkdir -p "$CONTAS_RAIZ"
  tmp=$(mktemp -d "$CONTAS_RAIZ/.$nome.novo.XXXXXX") 2>/dev/null ||
    { echo "✗ sem onde gravar"; cat >/dev/null; return 0; }
  if ! tar -C "$tmp" -xf - 2>/dev/null; then
    rm -rf "$tmp"; echo "✗ pacote inválido"; return 0
  fi
  if [[ ! -s $tmp/.credentials.json ]]; then
    rm -rf "$tmp"; echo "✗ sem credencial no pacote"; return 0
  fi
  mkdir -p "$dir"
  for item in "${CONTA_ITENS[@]}"; do
    [[ -e $tmp/$item ]] || continue
    rm -rf "$dir/$item"
    mv "$tmp/$item" "$dir/$item"
  done
  rm -rf "$tmp"
  chmod 700 "$dir" 2>/dev/null
  [[ -f $dir/.credentials.json ]] && chmod 600 "$dir/.credentials.json" 2>/dev/null
  rm -f "$dir/.account-email" 2>/dev/null
  conta_vincular_dados "$nome"
  echo "✓ conta '$nome' instalada"
}

# Recria, para a conta <nome>, os links de dados compartilhados apontando para o ~/.claude DESTA
# máquina e o atalho claude-<nome>. Espelha compartilhar_dados/criar_atalho do ia-conta, sem tocar
# na credencial (que já foi gravada). Idempotente.
conta_vincular_dados() {
  local nome=$1 base=$HOME/.claude dir item atalho
  dir=$CONTAS_RAIZ/$nome # fora do `local` acima: lá, $nome ainda seria o de quem chamou
  local -a compart=(projects history.jsonl file-history sessions settings.json settings.local.json plugins skills commands cache)
  mkdir -p "$dir"
  for item in "${compart[@]}"; do
    [[ -e $base/$item || -L $base/$item ]] || continue
    if [[ -L $dir/$item ]]; then
      [[ $(readlink -f "$dir/$item") == "$(readlink -f "$base/$item")" ]] || continue
    elif [[ -e $dir/$item ]]; then
      continue
    else
      ln -s "$base/$item" "$dir/$item"
    fi
  done
  atalho=$HOME/.local/bin/claude-$nome
  if [[ ! -e $atalho && ! -L $atalho ]]; then
    printf '#!/usr/bin/env bash\nexec %q %q "$@"' "$HOME/.local/bin/claude-conta" "$nome" >"$atalho"
    chmod 700 "$atalho"
  fi
}

# Lista do histórico (popup): Enter cola no painel (e vira a cópia atual), ^y só copia, ^x apaga
# o item, Esc fecha. Prévia com o texto inteiro.
historico_copias() {
  local escolha acao id pane=${TT_PANE:-}
  [[ -d $DIR_COPIAS ]] && [[ -n $(ls -A "$DIR_COPIAS") ]] || { echo "Nenhuma cópia ainda."; read -rsn1 -t 3; return 0; }
  while true; do
    # {1} vem com o TAB do separador: a prévia o tira antes de abrir o arquivo.
    escolha=$(listar_copias | fzf --ansi --no-sort --layout=reverse --delimiter=$'\t' --with-nth=2 --no-multi \
      --header=$'⏎ cola aqui · ^y só copia · ^x apaga · Esc fecha' \
      --preview "f={1}; cat $(printf %q "$DIR_COPIAS")/\"\${f%%[[:space:]]*}\"" --preview-window='down,60%,wrap' \
      --expect=enter,ctrl-y,ctrl-x --bind 'click-header:abort') || return 0
    acao=$(head -1 <<<"$escolha"); id=$(sed -n 2p <<<"$escolha" | cut -f1)
    [[ -n $id && -f $DIR_COPIAS/$id ]] || return 0
    case $acao in
      ctrl-x) rm -f "$DIR_COPIAS/$id"; continue ;;
      *)
        # Reusar move o item para o topo (sai o antigo, entra como cópia nova) e o manda às outras.
        local t; t=$(mktemp); cp "$DIR_COPIAS/$id" "$t"; rm -f "$DIR_COPIAS/$id"
        "$EU" --copiar <"$t"; tmux load-buffer -w "$t" 2>/dev/null; rm -f "$t"
        [[ $acao == ctrl-y || -z $pane ]] || tmux paste-buffer -p -t "$pane"
        return 0 ;;
    esac
  done
}

listar_copias() {
  local f ts origem hora texto
  ls -1 "$DIR_COPIAS" | sort -r | while read -r f; do
    ts=${f%%_*}; origem=${f#*_}
    hora=$(date -d "@$((ts / 1000000000))" '+%d/%m %H:%M' 2>/dev/null)
    texto=$(head -c 300 "$DIR_COPIAS/$f" | sed 's/\x1b\[[0-9;]*m//g' | awk 'NR > 1 { printf " ⏎ " } { gsub(/\t/, " "); printf "%s", $0 }')
    printf '%s\t\033[90m%s\033[0m \033[36m%-8.8s\033[0m %s\n' "$f" "$hora" "$origem" "$texto"
  done
}

# Aviso de cópia feita, no cliente C: "📋 copiado (N caracteres)". Cópia vazia não avisa.
copiado() {
  local n
  n=$(tmux show-buffer 2>/dev/null | wc -m)
  ((n > 0)) || return 0
  tmux display-message -c "$1" -d 1800 "📋 copiado ($n caractere$( ((n > 1)) && echo s)) — cole com Ctrl+Shift+V, botão do meio ou ⋯ · histórico: Ctrl+B y"
}

# Copia o texto visível do painel P (linhas quebradas juntadas) — útil no celular, onde arrastar
# rola a tela. Vai para o buffer do tmux, para os terminais por OSC 52 (load-buffer -w) e para a
# área de transferência desta máquina.
copiar_tela() {
  local c=$1 p=$2 w
  w=$(tmux display -p -t "$p" '#{pane_width}' 2>/dev/null)
  tmux capture-pane -p -J -t "$p" | awk '{ l[NR] = $0 } NF { u = NR } END { for (i = 1; i <= u; i++) print l[i] }' |
    sed 's/[[:space:]]*$//' | { python3 -I "$LINKS_PY" desquebrar "${w:-0}" 0 2>/dev/null || cat; } | tmux load-buffer -w - || return 0
  tmux save-buffer - | copiar
  copiado "$c"
}

# Tamanho dinâmico entre aparelhos: com window-size latest, o próprio tmux dá a janela ao
# cliente que teclou, clicou (inclusive na barra), ganhou foco, anexou ou mudou de tamanho por
# último — o aparelho em uso fica sempre do tamanho certo, e o outro, ao ser usado, toma de volta.
# Nunca usar resize-window aqui: ele congela a janela (window-size manual) e ela para de seguir
# os aparelhos. ajustar só descongela janelas presas assim (versões antigas do tt, menus do tmux)
# e redesenha; quem decide o tamanho é o tmux, pelo cliente que acabou de agir.
descongelar() {
  local w
  if [[ -n ${1:-} ]]; then tmux list-windows -t "=$1" -F '#{window_id}'; else tmux list-windows -a -F '#{window_id}'; fi 2>/dev/null |
    while read -r w; do
      [[ $(tmux show -wqv -t "$w" window-size 2>/dev/null) == manual ]] && tmux set -wu -t "$w" window-size && echo x
    done | wc -l
}

ajustar() {
  local c=$1 s
  s=$(do_cliente "$c" '#{session_name}')
  [[ -n $s ]] || return 1
  # Só redesenha se havia janela presa (redesenhar a cada foco fazia o cursor piscar, ainda mais
  # em subtelas, onde o tmux de dentro também recebe foco a cada clique entre painéis).
  (($(descongelar "$s"))) && tmux refresh-client -t "$c"
  # A paleta vai direto ao terminal (fora do tmux) e pode se intercalar com um quadro que o tmux
  # está desenhando: no foco, no máximo a cada 10 min por cliente (ao anexar, sempre).
  local marca="$RT/tt-tema-${c//\//_}"
  if [[ ! -e $marca ]] || (($(idade_arquivo "$marca") > 600)); then
    touch "$marca"; tema_cliente "$c"
  fi
}

# As cores padrão do tmux também precisam ser escuras: o Codex consulta o fundo do painel.
# Remove desvios locais só das opções visuais deste padrão, preservando sessões e processos.
reforcar_visual() {
  VISUAL_MUDOU=0
  [[ -r $DIR_TT/tema-tmux.conf ]] || return 0
  # Todo set-option redesenha a tela inteira de todos os clientes: só grava o que está diferente.
  # O tema global só é recarregado quando o arquivo muda (hash em @tema_hash).
  local h id opt linha
  h=$(sha256sum <"$DIR_TT/tema-tmux.conf" | cut -c1-16)
  if [[ $(tmux show -gqv @tema_hash 2>/dev/null) != "$h" ]]; then
    tmux source-file "$DIR_TT/tema-tmux.conf" || return 1
    tmux set -g @tema_hash "$h"
    VISUAL_MUDOU=1
  fi
  local -a cmds=()
  local so='^(status-position|status-interval|status-format|status-style|status-left-length|status-left|status-right-length|status-right|message-style)(\[[0-9]+\])? '
  local wo='^(window-style|window-active-style|pane-colours|window-status-format|window-status-current-format|pane-border-style|pane-active-border-style|pane-border-format|mode-style|popup-style|popup-border-style|popup-border-lines)(\[[0-9]+\])? '
  local po='^(window-style|window-active-style|pane-colours|pane-border-style|pane-active-border-style|mode-style)(\[[0-9]+\])? '
  # Sem -g, show-options lista só o que foi definido localmente naquele alvo (o desvio).
  while read -r id; do
    while read -r linha; do opt=${linha%% *}; opt=${opt%%\[*}; cmds+=(set-option -su -t "$id" "$opt" ';')
    done < <(tmux show-options -t "$id" 2>/dev/null | grep -E "$so" | sort -u -k1,1)
  done < <(tmux list-sessions -F '#{session_id}' 2>/dev/null)
  while read -r id; do
    while read -r linha; do opt=${linha%% *}; opt=${opt%%\[*}; cmds+=(set-option -wu -t "$id" "$opt" ';')
    done < <(tmux show-options -w -t "$id" 2>/dev/null | grep -E "$wo" | sort -u -k1,1)
  done < <(tmux list-windows -a -F '#{window_id}' 2>/dev/null | sort -u)
  while read -r id; do
    while read -r linha; do opt=${linha%% *}; opt=${opt%%\[*}; cmds+=(set-option -pu -t "$id" "$opt" ';')
    done < <(tmux show-options -p -t "$id" 2>/dev/null | grep -E "$po" | sort -u -k1,1)
  done < <(tmux list-panes -a -F '#{pane_id}' 2>/dev/null)
  if ((${#cmds[@]})); then tmux "${cmds[@]}" 2>/dev/null; VISUAL_MUDOU=1; fi
  return 0
}

# Reaplica a paleta comum (tema-terminal.sh) no terminal de fora do cliente C — ou de todos, sem C.
# Ela é mandada por sequências OSC quando o terminal abre, e se perde quando algum programa manda
# "restaurar as cores padrão" (TUIs ao sair, reset): o fundo do Windows Terminal/Termux voltava ao
# do perfil. Nos clientes aninhados, o OSC atualiza o painel do tmux de fora também.
# Depois de escrever direto no terminal, redesenha o cliente (caso a escrita caia no meio de um quadro).
tema_cliente() {
  local alvo=${1:-} c term tty
  [[ -r $DIR_TT/tema-terminal.sh ]] || return 0
  while read -r c term tty; do
    [[ -z $alvo || $c == "$alvo" ]] || continue
    [[ ! -w $tty ]] && continue
    # Só a paleta (OSC), sem redesenhar: as cores não mudam nada na tela se já estavam certas.
    env -u TMUX TERM="$term" bash -c 'source "$1"' _ "$DIR_TT/tema-terminal.sh" >"$tty" 2>/dev/null
  done < <(tmux list-clients -F '#{client_name} #{client_termname} #{client_tty}' 2>/dev/null)
  return 0
}


# --- Menus em popup ----------------------------------------------------------
#
# No lugar do display-menu do tmux: ele fecha quando o ponteiro se mexe fora do menu (o terminal
# relata movimento, e o tmux trata como "soltar fora"), então mal dava para chegar a um item.
# Popups não fecham assim. Itens no stdin: "tecla<TAB>rótulo<TAB>comando shell"; tecla "-" é
# separador; comando vazio deixa o item apagado. Um clique ou a tecla escolhe; Esc fecha.

menu_popup() {
  local c=$1 titulo=$2 arq w h x cw ch
  arq=$(mktemp "$RT/tt-menu-itens.XXXXXX")
  cat >"$arq"
  read -r cw ch < <(do_cliente "$c" '#{client_width} #{client_height}')
  cw=${cw:-80} ch=${ch:-24}
  w=$(cut -f2 "$arq" | sed 's/\x1b\[[0-9;]*m//g' | wc -L)
  w=$((w + 12)); ((w < 32)) && w=32; ((w > cw)) && w=$cw
  h=$(($(wc -l <"$arq") + 2)); ((h > ch - 1)) && h=$((ch - 1))
  x=${TT_X:-0}; ((x + w > cw)) && x=$((cw - w)); ((x < 0)) && x=0
  # display-popup volta na hora (não espera o popup): quem apaga o arquivo é o menu, depois de ler.
  tmux display-popup -c "$c" -x "$x" -y S -w "$w" -h "$h" -T " $titulo " -E "$EU --menu-popup-ui $(q "$arq")"
}

menu_popup_ui() {
  local itens binds="" i=0 k r cmd escolha
  itens=$(cat "$1"); rm -f "$1"
  while IFS=$'\t' read -r k r cmd; do
    i=$((i + 1))
    [[ ${#k} == 1 && $k =~ [[:alnum:]] && -n $cmd ]] && binds+="$k:pos($i)+accept,"
  done <<<"$itens"
  escolha=$(awk -F'\t' '{
      if ($1 == "-") printf "%d\t\033[90m%s\033[0m\n", NR, "────────────────────────"
      else if ($3 == "") printf "%d\t\033[90m %s\033[0m\n", NR, $2
      else printf "%d\t %s%s\n", NR, $2, ($1 == "" ? "" : "  \033[90m" $1 "\033[0m")
    }' <<<"$itens" |
    fzf --ansi --delimiter='\t' --with-nth=2 --no-input --no-info --no-separator --layout=reverse --no-sort \
      --pointer='▶' --color='bg:#282a36,fg:#f8f8f2,pointer:#ff79c6,fg+:#f8f8f2,bg+:#44475a' --bind='left-click:accept' \
      ${binds:+--bind="${binds%,}"} | cut -f1)
  # Esc/fora: escolha vazia. Sem esta checagem, `sed -n "p"` pegava TODAS as linhas e o menu
  # executava todas as ações de uma vez (abria janelas, desanexava a tela…).
  [[ $escolha =~ ^[0-9]+$ ]] || return 0
  cmd=$(sed -n "${escolha}p" <<<"$itens" | cut -f3)
  # Calado e sempre com sucesso: senão o tmux mostra a saída/erro por cima do painel.
  [[ -n $cmd ]] && tmux run-shell -b "sleep 0.1; ( $cmd ) >/dev/null 2>&1; true"
  return 0
}

# Tamanho dos popups grandes: tela cheia em tela pequena (celular), 90%x85% nas outras.
tam_popup() {
  # Menus que montam muitos itens (menu_painel, menu_admin…) medem o cliente uma vez (tam_popup_fixar) e os
  # popup_tt dos itens usam essa medida: era uma ida ao tmux e um awk por item, ~14 por menu.
  if [[ -n ${_TAM_POPUP_V:-} && ${_TAM_POPUP_C:-} == "$1" ]]; then printf '%s\n' "$_TAM_POPUP_V"; return 0; fi
  local cw ch
  read -r cw ch < <(do_cliente "$1" '#{client_width} #{client_height}')
  if ((${cw:-80} < 80 || ${ch:-30} < 30)); then echo "-w 100% -h 100%"; else echo "-w 90% -h 85%"; fi
}
# Mede uma vez para os popup_tt seguintes. Quem chama declara antes: local _TAM_POPUP_C="" _TAM_POPUP_V=""
# (assim a medida morre com a função que montou o menu).
tam_popup_fixar() { _TAM_POPUP_V=$(tam_popup "$1"); _TAM_POPUP_C=$1; }

# Popup de tamanho fixo que cabe na tela: o tmux recusa popup maior que a tela do cliente ("width
# too large") e o clique não fazia nada no celular (63 colunas: +N das fixadas, 🔔, renomear…).
dim_popup() { # cliente largura altura → "-w L -h A", sem passar do tamanho do cliente
  local w=$2 h=$3 cw ch
  read -r cw ch < <(do_cliente "$1" '#{client_width} #{client_height}')
  [[ $cw =~ ^[0-9]+$ ]] && ((cw < w)) && w=$cw
  [[ $ch =~ ^[0-9]+$ ]] && ((ch < h)) && h=$ch
  echo "-w $w -h $h"
}

popup_tt() { # cliente título args… → comando que abre o tt num popup grande
  local c=$1 t=$2; shift 2
  echo "$EU --popup -c $(q "$c") -E $(tam_popup "$c") -T $(q " $t ") $(q "$*")"
}

# Tela pequena (celular, ou janela estreita/baixa): modo compacto nos menus grandes.
compacto() { (($(tput cols 2>/dev/null || echo 80) < 80 || $(tput lines 2>/dev/null || echo 30) < 30)); }

# Menu do painel (botão ⋯, Ctrl+B m, botão direito no painel).
menu_painel() {
  local c=$1 p=$2 pasta env troca="" _info painel_tt idx
  local _TAM_POPUP_C="" _TAM_POPUP_V=""; tam_popup_fixar "$c"
  # Pasta, marca de painel do tt (@tt_painel só existe no nível do painel) e índice numa ida só (eram três).
  _info=$(tmux display-message -p -t "$p" "#{pane_current_path}"$'\x1f'"#{@tt_painel}"$'\x1f'"#{pane_index}")
  pasta=${_info%%$'\x1f'*}; _info=${_info#*$'\x1f'}; painel_tt=${_info%%$'\x1f'*}; idx=${_info#*$'\x1f'}
  env="TT_CLIENTE=$c TT_PANE=$p"
  [[ -n $painel_tt ]] && troca="$(popup_tt "$c" trocar "$env TT_MODO=aqui $EU")"
  # Se a última cópia é o caminho de um arquivo/pasta que existe (a partir da pasta do painel), oferece enviar.
  local copiado="" cam
  cam=$(tmux show-buffer 2>/dev/null | head -n1 | head -c 400 | sed -e 's/^[[:space:]"'"'"']*//' -e 's/[[:space:]"'"'"']*$//')
  if [[ -n $cam ]]; then
    [[ $cam == /* || $cam == '~'* ]] || cam=$pasta/$cam
    cam=$(expandir "$cam")
    [[ -e $cam ]] && copiado=$'\n'"i	📤 Enviar “$(basename "$cam")” (caminho copiado)…	$(popup_tt "$c" "📤 enviar" "$env $EU --enviar $(q "$cam")")"
  fi
  menu_popup "$c" "painel $idx" <<ITENS
l	Dividir ao lado (terminal novo)	tmux split-window -h -t $p -c $(q "$pasta")
b	Dividir embaixo (terminal novo)	tmux split-window -v -t $p -c $(q "$pasta")
-		
v	Abrir outra sessão ao lado…	$(popup_tt "$c" "ao lado" "$env TT_MODO=lado $EU")
o	Abrir outra sessão embaixo…	$(popup_tt "$c" embaixo "$env TT_MODO=embaixo $EU")
p	Trocar a sessão deste painel…	$troca
-		
c	📋 Colar a última cópia	tmux paste-buffer -p -t $p
y	📋 Copiar o texto da tela	$EU --copiar-tela $(q "$c") $p
u	🔗 Links da tela (abrir ou copiar)…	$EU --links-tela $(q "$c") $p
h	📋 Histórico de cópias…	$(popup_tt "$c" "📋 cópias" "$env $EU --copias")
a	✏ Atalhos da barra…	$(popup_tt "$c" "✏ atalhos da barra" "$EU --editar-atalhos")
k	⏱ Sessões paradas: $( (($(minutos_paradas))) && echo "fecham após $(minutos_paradas) min" || echo desativado)…	$EU --config-paradas $(q "$c")
n	🧠 Nomeador de abas: $(modo_nomeador)…	$(popup_tt "$c" "🧠 nomeador de abas" "$EU --nomeador-ui")
g	🪟 Janelas flutuantes (clicar fora fecha): $(flutuante_rotulo)…	$EU --flutuante alternar $(q "$c")
S	🔄 Sincronização das tarefas: $(tarefas_sync_rotulo)…	$(popup_tt "$c" "🔄 sincronização das tarefas" "$EU --tarefas-sync-ui")
w	✉ Demandas por e-mail (remetentes autorizados)…	$(popup_tt "$c" "✉ demandas por e-mail" "$EU --demandas-ui")
j	📰 Letreiro (fontes e ajustes)…	$(popup_tt "$c" "📰 letreiro" "$EU --letreiro-ui")
-		
r	Renomear painel	tmux command-prompt -t $(q "$c") -p 'nome do painel:' "set-option -p -t $p @nome_painel '%%'"
z	Maximizar / restaurar	tmux resize-pane -Z -t $p
s	Virar sessão própria	$EU --soltar $p
-		
e	📤 Enviar arquivos daqui…	$(popup_tt "$c" "📤 enviar" "$env $EU --enviar")
t	📥 Trazer arquivos para cá…	$(popup_tt "$c" "📥 trazer" "$env $EU --trazer")$copiado
u	📥 Recebidos recentes…	$(popup_tt "$c" "📥 recebidos" "$EU --recebidos")
f	⇅ Acompanhar as transferências…	$(popup_tt "$c" "⇅ transferências" "$EU --transferencias")
d	📂 Abrir a pasta de recebidos	$EU --abrir-pasta $(q "$(pasta_recebidos)") $(q "$c")
m	⚙ tmux…	$EU --menu-tmux $(q "$c") $p
-		
