# Instala o pacote que está na pasta deste tt (chamado como <pasta>/tt --instalar-aqui).
# Troca a pasta de uma vez (nunca sobrescreve o arquivo de um tt que esteja rodando, como o vigia),
# aponta ~/.local/bin/tt para ela, faz o ~/.tmux.conf carregar o tmux.conf dela e recarrega o tmux.
# Partida rápida. O bash lê um script comando a comando, então o desvio no topo do tt evita ler as ~15 mil
# linhas (~850 KB, de 60 a 90 ms) a cada clique, tecla e recarga do fzf. A instalação gera PASTA/rapido/:
# nucleo.sh — o código de topo do tt, na mesma ordem, com cada função de várias linhas trocada por um stub
# de uma linha que carrega o corpo na 1ª chamada (_tt_f); f/NOME.sh — o texto original de cada uma;
# todas.sh — todas (rede de segurança, e a carga de uma vez dos processos longos, que assim não misturam
# versões se uma instalação acontecer no meio). Função definida mais de uma vez fica inteira no núcleo.
# Só passa a valer depois de conferido: cada corpo, lido sozinho, dá a mesma definição que o tt inteiro, e
# o núcleo carregado dá as mesmas funções e as mesmas variáveis de topo (TT_SO_CARREGAR=1 para antes do
# verbo). Qualquer diferença: nada é instalado e o tt segue inteiro, como sempre. tt --rapido mostra o estado.
RAPIDO_LONGOS='--vigia | --transferir-fundo | --email-sync | --sessoes-ia-sync | --ticker-loop | --malha-vigia | --instalar-aqui'
gerar_rapido() { # pasta-do-pacote (com o tt dentro) — 0 se gerou e conferiu
  local pasta=${1%/} orig tmp ref rap cmp1 cmp2 filtro n
  orig=$pasta/tt
  [[ -f $orig ]] || { echo "sem $orig" >&2; return 1; }
  tmp=$(mktemp -d "$pasta/.rapido.XXXXXX") || return 1
  # 1) divide: núcleo + um arquivo por função (texto original) + a lista dos nomes trocados por stub
  if ! python3 -I - "$orig" "$tmp" "$RAPIDO_LONGOS" <<'PY'; then rm -rf "$tmp"; return 1; fi
import os, re, sys
orig, dest, longos = sys.argv[1:4]
linhas = open(orig, encoding="utf-8", errors="surrogateescape").read().split("\n")
ini = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*)\(\) *\{ *(#.*)?$")
qualquer = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*)\(\) *\{")
cont = {}
for l in linhas:
    m = qualquer.match(l)
    if m:
        cont[m.group(1)] = cont.get(m.group(1), 0) + 1
blocos, i = [], 0
while i < len(linhas):
    m = ini.match(linhas[i])
    if m:
        j = i + 1
        while j < len(linhas) and not linhas[j].startswith("}"):
            j += 1
        if j >= len(linhas):
            sys.exit("fim da função %s não achado" % m.group(1))
        blocos.append((m.group(1), i, j))
        i = j + 1
        continue
    i += 1
stub = [n for n, a, b in blocos if cont.get(n) == 1]
trocar = set(stub)
guarda = "[[ -n ${TT_SO_CARREGAR:-} ]] && { return 0 2>/dev/null || exit 0; }"
nuc = ['_tt_f() { source "$_TT_RAPIDO/f/$1.sh" 2>/dev/null || source "$_TT_RAPIDO/todas.sh" 2>/dev/null ||'
       ' { printf "tt: partida rápida incompleta (%s): rode tt --rapido gerar (ou TT_COMPLETO=1)\\n" "$1" >&2; return 127; }; }']
pos, achou, doc = 0, 0, {}
for n, a, b in blocos:
    c = a  # os comentários colados acima da função vão com ela para o corpo (o núcleo fica menor de ler)
    while n in trocar and c > pos and linhas[c - 1].lstrip().startswith("#"):
        c -= 1
    nuc.extend(linhas[pos:c])
    if n in trocar:
        doc[n] = c
        nuc.append('%s() { _tt_f %s || return; %s "$@"; }' % (n, n, n))
    else:
        nuc.extend(linhas[c:b + 1])
    pos = b + 1
for l in linhas[pos:]:
    nuc.append(l)
    if l.strip() == guarda:
        achou += 1
        nuc.append('case ${1:-} in %s) source "$_TT_RAPIDO/todas.sh" ;; esac # processo longo: tudo de uma vez' % longos)
if achou != 1:
    sys.exit("guarda TT_SO_CARREGAR achada %d vezes depois da última função" % achou)
os.makedirs(os.path.join(dest, "f"))
def grava(nome, texto):
    with open(os.path.join(dest, nome), "w", encoding="utf-8", errors="surrogateescape") as f:
        f.write(texto)
grava("nucleo.sh", "\n".join(nuc))
todas = []
for n, a, b in blocos:
    if n in trocar:
        t = "\n".join(linhas[doc[n]:b + 1]) + "\n"
        grava(os.path.join("f", n + ".sh"), t)
        todas.append(t)
grava("todas.sh", "".join(todas))
grava("nomes", "".join(n + "\n" for n in stub))
PY
  # 2) referência: o tt inteiro, carregado só até antes do verbo
  filtro='^declare -[-a-zA-Z]* (BASH[A-Z_0-9]*|EPOCH[A-Z]*|S?RANDOM|SECONDS|LINENO|_|FUNCNAME|PIPESTATUS|BASHPID|COLUMNS|LINES|HISTCMD|SHLVL|PPID|_TT_RAPIDO|TT_COMPLETO)='
  ref=$(cd / && TT_COMPLETO=1 TT_SO_CARREGAR=1 "$BASH" -c '
    source "$0" </dev/null >/dev/null 2>&1
    while IFS= read -r _tt_n; do declare -f "$_tt_n"; done <"$1/nomes" >"$1/.ref-corpos"; unset _tt_n
    declare -F | grep -vx "declare -f _tt_f" >"$1/.ref-nomes"; declare -p >"$1/.ref-vars"; echo pronto' "$orig" "$tmp" 2>/dev/null)
  [[ $ref == pronto ]] || { echo "o tt inteiro não carregou" >&2; rm -rf "$tmp"; return 1; }
  # 3) cada corpo, lido sozinho (só define a função: nada roda), dá a mesma definição
  "$BASH" -c 'for f in "$0"/f/*.sh; do source "$f" || exit 1; done; while IFS= read -r n; do declare -f "$n"; done <"$0/nomes"' "$tmp" \
    >"$tmp/.corpos" 2>/dev/null && cmp -s "$tmp/.ref-corpos" "$tmp/.corpos" ||
    { echo "um corpo não confere com o tt inteiro: $(diff "$tmp/.ref-corpos" "$tmp/.corpos" 2>/dev/null | head -2 | tr '\n' ' ')" >&2; rm -rf "$tmp"; return 1; }
  # 4) o núcleo carregado dá as mesmas funções e as mesmas variáveis de topo
  rap=$(cd / && TT_SO_CARREGAR=1 _TT_RAPIDO=$tmp "$BASH" -c '
    source "$_TT_RAPIDO/nucleo.sh" </dev/null >/dev/null 2>&1
    declare -F | grep -vx "declare -f _tt_f" >"$_TT_RAPIDO/.rap-nomes"; declare -p >"$_TT_RAPIDO/.rap-vars"; echo pronto' "$orig" 2>/dev/null)
  [[ $rap == pronto ]] || { echo "o núcleo não carregou" >&2; rm -rf "$tmp"; return 1; }
  cmp -s "$tmp/.ref-nomes" "$tmp/.rap-nomes" || { echo "funções diferentes no núcleo" >&2; rm -rf "$tmp"; return 1; }
  cmp1=$(grep -Ev "$filtro" "$tmp/.ref-vars"); cmp2=$(grep -Ev "$filtro" "$tmp/.rap-vars")
  [[ $cmp1 == "$cmp2" ]] || { echo "variáveis de topo diferentes: $(diff <(echo "$cmp1") <(echo "$cmp2") | head -3 | tr '\n' ' ')" >&2; rm -rf "$tmp"; return 1; }
  # 5) instala de uma vez (o núcleo fica mais novo que o tt: é o que o desvio do topo confere)
  n=$(wc -l <"$tmp/nomes")
  rm -f "$tmp"/.ref-* "$tmp"/.rap-* "$tmp/.corpos"
  printf 'funcoes=%s\ngerado=%s\n' "$n" "$(date +%s)" >"$tmp/estado"
  rm -rf "$pasta/rapido.velho"; [[ -d $pasta/rapido ]] && mv "$pasta/rapido" "$pasta/rapido.velho"
  mv "$tmp" "$pasta/rapido" || { rm -rf "$tmp"; return 1; }
  rm -rf "$pasta/rapido.velho"; touch "$pasta/rapido/nucleo.sh"
  echo "partida rápida: $n funções carregadas sob demanda"
}
# tt --rapido [status|gerar|remover]
rapido_cmd() {
  local d=$DIR_TT/rapido n=0 k1 k2
  case ${1:-status} in
    status)
      if [[ -r $d/nucleo.sh && ! $DIR_TT/tt -nt $d/nucleo.sh ]]; then
        n=$(sed -n 's/^funcoes=//p' "$d/estado" 2>/dev/null)
        k1=$(($(wc -c <"$d/nucleo.sh") / 1024)); k2=$(($(wc -c <"$DIR_TT/tt") / 1024))
        printf '⚡ partida rápida: ligada — o tt lê um núcleo de %s KB (o arquivo inteiro tem %s KB) e %s funções na 1ª chamada%s\n' \
          "$k1" "$k2" "${n:-?}" "$([[ -n ${TT_COMPLETO:-} ]] && echo ' (TT_COMPLETO=1: desligada neste ambiente)')"
      else
        echo '⚡ partida rápida: desligada (sem núcleo gerado para esta instalação; tt --rapido gerar)'
      fi ;;
    gerar) gerar_rapido "$DIR_TT" ;;
    remover) rm -rf "$d" && echo '⚡ partida rápida: removida (o tt lê o arquivo inteiro; tt --rapido gerar religa)' ;;
    *) echo 'uso: tt --rapido [status|gerar|remover]' >&2; return 2 ;;
  esac
}
# Uma troca de pacote por vez. A troca usa nomes fixos (tt.novo, tt.velho) e apaga os dois no começo: o vigia que se atualiza sozinho e um
# --atualizar/--sincronizar chamado de fora (ssh) ao mesmo tempo apagavam a cópia um do outro e deixavam ~/.local/share/tt SEM O PACOTE
# (a empresa ficou com o tt quebrado às 12:28 do dia 21/10/2026). mkdir é atômico em qualquer sistema; trava de processo morto ou com
# mais de 10 min é retomada.
instalar_travar() {
  local t="$DIR_TT.trava" i p
  mkdir -p "$(dirname "$DIR_TT")"
  for ((i = 0; i < ${TT_INSTALAR_TRAVA_TENTATIVAS:-240}; i++)); do
    mkdir "$t" 2>/dev/null && { echo $$ >"$t/pid"; return 0; }
    p=$(cat "$t/pid" 2>/dev/null)
    if [[ -n $p ]] && ! kill -0 "$p" 2>/dev/null; then rm -rf "$t"; continue; fi        # o dono morreu
    [[ -n $(find "$t" -maxdepth 0 -mmin +10 2>/dev/null) ]] && { rm -rf "$t"; continue; }
    sleep 0.5
  done
  echo "tt: outra instalação não terminou em $(( ${TT_INSTALAR_TRAVA_TENTATIVAS:-240} / 2 )) s; nada foi trocado" >&2
  return 1
}
instalar_destravar() { rm -rf "$DIR_TT.trava"; }

instalar_aqui() {
  local origem nome=${TT_NOME:-} pidf pid
  origem=${EU%/*}
  # Nunca troca uma pasta que é um repositório git (TT_DIR apontado para um clone num teste apagou
  # o clone inteiro, .git inclusive): a instalação só substitui pastas que são instalações.
  if [[ -e $DIR_TT/.git ]]; then
    echo "$(conf nome): ✗ $DIR_TT é um repositório git, não uma instalação; nada foi trocado" >&2
    return 1
  fi
  # Mesmo pacote já instalado (sincronizar repetido, ou outra máquina reenviando): não recarrega o
  # tmux nem redesenha. Recarregar regrava dezenas de opções, e cada gravação redesenha a tela
  # inteira de todos os aparelhos — o cursor corria pela tela a cada sincronização.
  local mesmo=""
  if [[ $origem != "$DIR_TT" && -f $DIR_TT/VERSAO ]] && cmp -s "$origem/VERSAO" "$DIR_TT/VERSAO"; then
    mesmo=1; local f
    for f in "${ARQUIVOS_FONTE[@]}"; do cmp -s "$origem/$f" "$DIR_TT/$f" || { mesmo=""; break; }; done
  fi
  if [[ -n $mesmo ]]; then
    [[ -r $DIR_TT/rapido/nucleo.sh && ! $DIR_TT/tt -nt $DIR_TT/rapido/nucleo.sh ]] || gerar_rapido "$DIR_TT" >/dev/null 2>&1
    mac_configurar_padrao || return 1
    garantir_navegadores_em_segundo_plano; echo "$(conf nome): $(versao) (já instalada)"; return 0
  fi
  if [[ $origem != "$DIR_TT" ]]; then
    completar_pacote "$origem"
    pacote_valido "$origem" || return 1
    pode_instalar "$(cat "$origem/VERSAO")" || return 1
    instalar_travar || return 1
    # Com a trava na mão: outra instalação pode ter acabado enquanto esperávamos (mesmo pacote: nada a trocar; uma mais nova: não rebaixa).
    if [[ -f $DIR_TT/VERSAO ]] && cmp -s "$origem/VERSAO" "$DIR_TT/VERSAO" && [[ -x $DIR_TT/tt ]]; then :
    elif pode_instalar "$(cat "$origem/VERSAO")"; then
      rm -rf "$DIR_TT.novo" "$DIR_TT.velho"
      mkdir -p "$(dirname "$DIR_TT")"
      cp -a "$origem" "$DIR_TT.novo" || { instalar_destravar; return 1; }
      gerar_rapido "$DIR_TT.novo" >/dev/null 2>&1 # sem núcleo conferido, o tt novo roda inteiro (como sempre)
      [[ -d $DIR_TT ]] && migrar_dados_do_pacote "$DIR_TT" && mv "$DIR_TT" "$DIR_TT.velho"
      mv "$DIR_TT.novo" "$DIR_TT" || { [[ -d $DIR_TT.velho && ! -d $DIR_TT ]] && mv "$DIR_TT.velho" "$DIR_TT"; instalar_destravar; return 1; }
      rm -rf "$DIR_TT.velho"
    else instalar_destravar; return 1; fi
    instalar_destravar
  fi
  chmod +x "$DIR_TT/tt" "$DIR_TT/tema-agentes.sh" "$DIR_TT/memoria-agentes.sh"
  instalar_politica_aidlc || return 1
  instalar_contas_ia
  mkdir -p "$HOME/.local/bin"
  if [[ -f $HOME/.local/bin/tt && ! -L $HOME/.local/bin/tt ]]; then
    mv "$HOME/.local/bin/tt" "$HOME/.local/bin/tt.antes-instalacao"
  fi
  ln -sfn "$DIR_TT/tt" "$HOME/.local/bin/tt"
  instalar_voz
  if ! grep -q '^source-file ~/.local/share/tt/tmux.conf' "$HOME/.tmux.conf" 2>/dev/null; then
    [[ -f $HOME/.tmux.conf && ! -f $HOME/.tmux.conf.antes-tt ]] && cp "$HOME/.tmux.conf" "$HOME/.tmux.conf.antes-tt"
    cat >"$HOME/.tmux.conf" <<'CONF'
# ~/.tmux.conf — a configuração vem do tt (~/.local/share/tt/tmux.conf), atualizada por
# `tt --sincronizar`. Ajustes só desta máquina vão abaixo da linha do source-file.
source-file ~/.local/share/tt/tmux.conf
CONF
  fi
  mkdir -p "$(dirname "$CONF")"
  if [[ -n $nome ]]; then
    grep -v '^nome=' "$CONF" 2>/dev/null >"$CONF.novo"; echo "nome=$nome" >>"$CONF.novo"; mv "$CONF.novo" "$CONF"
  elif [[ -z $(conf nome) ]]; then
    echo "nome=$(hostname -s)" >>"$CONF"
  fi
  # Chave de estado que versões antigas gravavam no perfil.
  grep -q '^avisado=' "$CONF" 2>/dev/null && { grep -v '^avisado=' "$CONF" >"$CONF.novo"; mv "$CONF.novo" "$CONF"; }
  limpar_cache_maquinas
  atualizar_bashrc
  configurar_zshenv
  mac_configurar_padrao || return 1
  configurar_aerc
  "$DIR_TT/tema-agentes.sh" --aplicar
  "$DIR_TT/memoria-agentes.sh" --aplicar
  if tmux list-sessions >/dev/null 2>&1; then
    tmux source-file "$HOME/.tmux.conf"
    # source-file atualiza as opções, mas clientes já desenhados nem sempre redesenham a
    # barra imediatamente. Força todas as telas/abas ativas a adotarem o padrão novo.
    redesenhar_todos
    # O laço do letreiro de versões antigas (gravava @barra_ticker a cada passo: tela inteira
    # redesenhada, cursor dançando) morre aqui; o letreiro agora é o #() da barra, recriado pelo
    # redesenho acima. As opções que o laço gravava saem do servidor.
    pkill -f 'tt --ticker-loop$' 2>/dev/null # âncora: só o processo do laço, nunca quem cita o texto
    tmux set -gqu @barra_ticker \; set -gqu @barra_aviso 2>/dev/null
    # O vigia em execução é da versão antiga: troca por um novo.
    # (versões antigas gravavam o pidfile onde o XDG_RUNTIME_DIR do momento apontasse: procura em todos)
    # Com TT_RT explícito (testes, instalação isolada) o runtime é só esse: os outros diretórios são de OUTRO tt. No macOS o
    # pidfile do vigia de verdade mora no $TMPDIR (não há /run/user): sem esta guarda, instalar num HOME isolado matava o
    # vigia de quem rodava a suíte e apagava o pidfile dele.
    local -a pidfs=("$RT" "${XDG_RUNTIME_DIR:-$RT}" "${TMPDIR:-/tmp}" /tmp)
    [[ -n ${TT_RT:-} ]] && pidfs=("$RT")
    for pidf in "${pidfs[@]}"; do
      pidf="$pidf/tt-vigia-$UID.pid"
      pid=$(cat "$pidf" 2>/dev/null)
      if [[ -n $pid ]] && cmdline_do_pid "$pid" | grep -q -- '--vigia'; then kill "$pid"; fi
      rm -f "$pidf"
    done
    tmux run-shell -b -c "$HOME" "$HOME/.local/bin/tt --vigia"
  fi
  garantir_navegadores_em_segundo_plano
  echo "$(conf nome): $(versao)"
}

# O 🎤 (voz): o utilitário vai para o PATH. No celular o ~/.local/bin/voz é do termux/celular.sh (aponta para o clone e
# roda pelo bash do Termux, que o cron acha); um voz que não é link (escrito à mão) também fica.
