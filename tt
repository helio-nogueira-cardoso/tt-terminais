# A configuração local sobrescreve pelo ID (2ª coluna). Emoji '-' desativa um padrão; um ID
# novo adiciona um atalho. Assim o arquivo versionado continua recebendo melhorias sem apagar a
# personalização de cada máquina.
atalhos_lista() {
  local base localf
  base=$(mktemp "${RT:-/tmp}/tt-atalhos.XXXXXX") || return 1
  atalhos_base >"$base"
  localf=$CONF_ATALHOS
  e_mobile && localf=/dev/null
  [[ -f $localf ]] || localf=/dev/null
  # Padrões na ordem do pacote (trocados pela versão local do mesmo id; emoji "-" some), depois os
  # atalhos só locais, na ordem do arquivo.
  awk -F '\t' -v b="$base" '
    FILENAME == b { if ($2 != "" && !($2 in base)) { base[$2] = $0; ob[++nb] = $2 }; next }
    $2 != "" { if (!($2 in loc)) ol[++nl] = $2; loc[$2] = $0; em[$2] = $1 }
    END {
      for (i = 1; i <= nb; i++) { id = ob[i]; if (id in loc) { if (em[id] != "-") print loc[id] } else print base[id] }
      for (i = 1; i <= nl; i++) { id = ol[i]; if (!(id in base) && em[id] != "-") print loc[id] }
    }
  ' "$base" "$localf"
  rm -f "$base"
}

atalhos_barra() {
  local emoji id cmd cor i=0
  while IFS=$'\t' read -r emoji id cmd cor; do
    [[ -n $emoji && -n $cmd ]] || continue
    [[ $cor =~ ^#[[:xdigit:]]{6}$ ]] || cor='#cba6f7'
    i=$((i + 1))
    printf '#[range=user|at%d]#[fg=#1e1e2e,bg=%s,bold] %s #[norange]#[default] ' "$i" "$cor" "$emoji"
  done < <(atalhos_lista)
}

# Script que um atalho roda: em bash -lc para que comandos editados com argumentos, pipes ou
# variáveis tenham o mesmo comportamento em qualquer máquina. Mantém o shell aberto e deixa o erro
# visível quando o programa não existe ou termina imediatamente.
# O Codex guarda as cores do terminal ao iniciar; o fundo precisa estar correto ANTES dele.
script_atalho() {
  local script quoted
  script="$(q "$EU") --reforcar-padrao >/dev/null 2>&1"$'\n'$1$'\nrc=$?\nif (( rc != 0 )); then printf "\\natalho terminou com código %d; shell mantido aberto\\n" "$rc"; fi\nexec "${SHELL:-bash}"'
  printf -v quoted '%q' "$script"
  printf 'bash -lc %s' "$quoted"
}

# Atalho "@aqui CMD": troca o que roda no painel (um agente, que é fechado, ou o shell) por CMD,
# no mesmo painel. {retomar} no CMD vira "--retomar ID" quando o painel tinha uma conversa do
# Claude (o ia-conta abrir a continua se a próxima conta também for do Claude), ou some.
atalho_aqui() {
  local cliente=$1 pane=$2 pasta=$3 cmd=$4 id=$5 sessao pid conversa=""
  [[ -n $pane ]] || pane=$(tmux display-message -p -c "$cliente" '#{pane_id}' 2>/dev/null)
  [[ -n $pane ]] || { botao_aviso "$cliente" "atalho: nenhum painel ativo"; return; }
  sessao=$(tmux display-message -p -t "$pane" '#{session_name}' 2>/dev/null)
  if [[ -n $(tmux show-options -qv -t "=$sessao:" @ponte 2>/dev/null) ]]; then
    botao_aviso "$cliente" "este painel é de outra máquina: use o atalho da barra de lá"; return
  fi
  pasta=$(tmux display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null || echo "$pasta")
  if pid=$(claude_no_painel "$pane") && [[ -n $pid ]]; then
    conversa=$(claude_info "$pid" 2>/dev/null | awk '{print $1}')
  fi
  [[ $conversa =~ ^[0-9a-fA-F-]{8,}$ ]] || conversa=""
  cmd=${cmd//\{retomar\}/${conversa:+--retomar $conversa}}
  # respawn -k fecha tudo o que roda no painel (agente e shell) e começa o novo ali mesmo.
  tmux respawn-pane -k -t "$pane" -c "$pasta" "$(script_atalho "$cmd")" || {
    botao_aviso "$cliente" "atalho: não consegui reabrir o painel"; return
  }
  tmux set-option -w -t "$pane" @tt_atalho "$id" 2>/dev/null || true # (o set já redesenha o cliente)
}

atalho_executar() {
  local i=$1 cliente=$2 pane=$3 pasta=${4:-$HOME} emoji id cmd cor nome
  IFS=$'\t' read -r emoji id cmd cor < <(atalhos_lista | sed -n "${i}p")
  [[ -n $cmd ]] || { tmux display-message -c "$cliente" "atalho indisponível" 2>/dev/null || true; return 0; }
  if [[ $cmd == '@aqui '* ]]; then atalho_aqui "$cliente" "$pane" "$pasta" "${cmd#@aqui }" "$id"; return; fi
  nome=$(proximo_nome atalho)
  tmux new-session -d -s "$nome" -c "$pasta" "$(script_atalho "$cmd")" || {
    botao_aviso "$cliente" "atalho: não consegui abrir a sessão"; return
  }
  tmux set-option -w -t "=$nome:" @tt_papel atalho
  tmux set-option -w -t "=$nome:" @tt_atalho "$id"
  tmux switch-client -c "$cliente" -t "=$nome" # (a troca de sessão já redesenha o cliente)
}

clique() {
  export TT_X=$(( ${5:-0} > 4 ? ${5:-0} - 4 : 0 ))
  # Algumas versões/configurações do tmux devolvem o tipo junto no range (user|at1).
  # Normalizar aqui evita que um clique válido seja descartado silenciosamente.
  local faixa=${1#user|}
  local marca="$RT/tt-clique-$UID" agora anterior cliente_anterior faixa_anterior
  agora=$(date +%s%N)
  if read -r anterior cliente_anterior faixa_anterior <"$marca" 2>/dev/null &&
     [[ $cliente_anterior == "$2" && $faixa_anterior == "$faixa" ]] &&
     ((agora - anterior < 500000000)); then
    return 0
  fi
  printf '%s %s %s\n' "$agora" "$2" "$faixa" >"$marca"
  case $faixa in
    window) tmux select-window -t = ;;
    maquina) menu_maquinas "$2" "$3" ;;
    arquivos) menu_arquivos "$2" "$3" ;;
    email) botao_email "$2" ;;
    transferencias) eval "$(popup_tt "$2" "⇅ transferências" "$EU --transferencias")" ;;
    copias) eval "$(popup_tt "$2" "📋 cópias" "TT_CLIENTE=$2 TT_PANE=$3 $EU --copias")" ;;
    at[0-9]*) atalho_executar "${faixa#at}" "$2" "$3" "${4:-$HOME}" ;;
    ajustar) ajustar "$2" ;;
    sessao) seletor_em "$2" "$MAQUINA" "$3" ;;
    fxx*) desafixar_item "$2" "${faixa#fxx}" ;;
    fixprev | fixnext | fixmais) fixadas_popup "$2" ;;
    fixar) fixar_atual "$2" ;;
    fx*) ir_fixada "$2" "$faixa" ;;
    tarefas) abrir_tarefas "$2" ;;
    em_*) email_botao_acao "${faixa#em_}" ;;
    notifs) notifs_popup "$2" ;;
    notifx) notifs_clique "$2" ;;
    relogio) abrir_calendario "$2" ;;
    tt) tmux display-popup -c "$2" -E $(tam_popup "$2") "TT_CLIENTE=$(q "$2") TT_PANE=$3 $EU" ;;
    lado) tmux split-window -h -t "$3" -c "$4" ;;
    baixo) tmux split-window -v -t "$3" -c "$4" ;;
    painel) menu_painel "$2" "$3" ;;
  esac
}

# --- Arquivos entre máquinas -----------------------------------------------
#
# Navegador de pastas (→ entra, ← sobe, Tab marca arquivos ou pastas inteiras, ⏎ confirma) numa
# máquina, escolha da máquina e da pasta de destino, e cópia por tar+ssh (de/para qualquer máquina,
# inclusive entre duas outras). Pastas são empacotadas recursivamente. Nada é sobrescrito: se já
# existe, chega como "nome (2)". Quem recebe vê um aviso na tela.

# wsl | termux | linux
tipo_maquina() {
  # Termux primeiro: o PREFIX do Termux é sinal explícito e nunca existe no WSL; testar o WSL
  # antes fazia PREFIX=…com.termux não valer lá (perfil mobile nunca escolhido).
  if [[ ${PREFIX:-} == *com.termux* ]]; then echo termux
  elif grep -qi microsoft /proc/version 2>/dev/null; then echo wsl
  else echo linux; fi
}

# Esta maquina e um ambiente mobile (celular com Termux)? Vale para o perfil de atalhos:
# no Termux os agentes rodam dentro de um Debian via proot, nao direto no shell, e nao ha
# o diretorio de contas do claude-conta local. Detecta pela plataforma, sem fixar o nome.
e_mobile() { [[ $(tipo_maquina) == termux ]]; }

# Como a pasta aparece para quem usa esta máquina: no WSL, o caminho do Windows (C:\… ou
# \\wsl.localhost\…, que o Explorer não mostra sozinho); no Termux, se está no armazenamento do
# Android (visível no app de arquivos) ou só dentro do Termux.
caminho_visivel() {
  local d
  d=$(expandir "$1")
  case $(tipo_maquina) in
    wsl)
      if [[ $d == /mnt/[a-z]/* ]]; then echo "$(wslpath -w "$d" 2>/dev/null || echo "$d")  (aparece no Explorer)"
      else echo "$(wslpath -w "$d" 2>/dev/null || echo "$d")  (só dentro do WSL, fora das pastas do Windows)"; fi ;;
    termux)
      local r; r=$(readlink -f "$d" 2>/dev/null || echo "$d")
      if [[ $r == /storage/emulated/0/* ]]; then echo "Armazenamento interno/${r#/storage/emulated/0/}  (aparece no app de arquivos)"
      else echo "$d  (só dentro do Termux)"; fi ;;
    *) echo "$d" ;;
  esac
}

# Pasta padrão onde ESTA máquina recebe arquivos: "recebidos=" no config. Sem ele: no WSL, a pasta
# Downloads\Recebidos do Windows (aparece no Explorer; descoberta uma vez e gravada no config);
# nas outras, ~/Recebidos.
pasta_recebidos() {
  local p u
  p=$(conf recebidos)
  if [[ -z $p ]] && grep -qi microsoft /proc/version 2>/dev/null; then
    u=$(cd /mnt/c 2>/dev/null && timeout 5 /mnt/c/Windows/System32/cmd.exe /c 'echo %USERNAME%' 2>/dev/null | tr -d '\r')
    if [[ -n $u && -d /mnt/c/Users/$u/Downloads ]]; then
      p="/mnt/c/Users/$u/Downloads/Recebidos"
      mkdir -p "$CONF_DIR"; echo "recebidos=$p" >>"$CONF"
    fi
  fi
  if [[ -z $p && $(tipo_maquina) == termux && -d $HOME/storage/downloads ]]; then
    p='~/storage/downloads/Recebidos'
  fi
  echo "${p:-~/Recebidos}"
}

# Grava a pasta padrão de recebidos desta máquina (sem argumento: escolhe navegando).
definir_recebidos() {
  local p=${1:-}
  if [[ -z $p ]]; then
    p=$(escolher_arquivos . "$(pasta_recebidos)" "pasta padrão de recebidos" pasta) || return 0
  fi
  [[ -n $p ]] || return 0
  mkdir -p "$(expandir "$p")" || { echo "Não consegui criar $p"; return 1; }
  mkdir -p "$CONF_DIR"
  grep -v '^recebidos=' "$CONF" 2>/dev/null >"$CONF.novo"; echo "recebidos=$p" >>"$CONF.novo"; mv "$CONF.novo" "$CONF"
  echo "✓ Os arquivos enviados para $MAQUINA passam a chegar em: $(caminho_visivel "$p")"
}

# tt --pasta-padrao [caminho | máquina:caminho | máquina]
pasta_padrao_cli() {
  local a=${1:-} maq dest p
  if [[ -z $a ]]; then definir_recebidos; return; fi
  maq=${a%%:*}; dest=$(dest_de "$maq")
  if [[ -n $dest && $dest != . && ( $a == *:* || $a == "$maq" ) ]]; then
    [[ $a == *:* ]] && p=${a#*:} || p=$(escolher_arquivos "$dest" "$(rodar "$dest" --pasta-recebidos)" "pasta padrão de $maq" pasta) || return 0
    rodar "$dest" --definir-recebidos "$p"
  else
    definir_recebidos "${a#*:}"
  fi
}

# Destinos possíveis nesta máquina (para quem envia escolher): "pasta<TAB>descrição".
destinos() {
  local p v s
  p=$(pasta_recebidos)
  printf '%s\t\033[1m%s\033[0m \033[32m(padrão: recebidos)\033[0m \033[90m%s\033[0m\n' "$p" "$p" "$(caminho_visivel "$p" | sed 's/^[^(]*//')"
  while IFS=$'\t' read -r v s; do
    printf '%s\t\033[1m%s\033[0m \033[90m(sessão %s) %s\033[0m\n' "$v" "$v" "$s" "$(caminho_visivel "$v" | sed 's/^[^(]*//')"
  done < <(pastas_sessoes)
  printf '~\t\033[1m~\033[0m \033[90m(pasta pessoal) %s\033[0m\n' "$(caminho_visivel '~' | sed 's/^[^(]*//')"
}

# Abre a pasta no gerenciador de arquivos (Explorer no WSL; o da área de trabalho no Linux).
# Sem nenhum, abre uma janela do tmux nela (no cliente C).
abrir_pasta() {
  local dir c=${2:-} sess
  dir=$(expandir "$1"); mkdir -p "$dir"
  if grep -qi microsoft /proc/version 2>/dev/null && [[ -x /mnt/c/Windows/explorer.exe ]]; then
    (cd /mnt/c && /mnt/c/Windows/explorer.exe "$(wslpath -w "$dir")") && return
  fi
  if [[ -n ${WAYLAND_DISPLAY:-}${DISPLAY:-} ]] || [[ -S ${XDG_RUNTIME_DIR:-/run/user/$UID}/wayland-0 ]]; then
    WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-0} setsid xdg-open "$dir" >/dev/null 2>&1 </dev/null && return
  fi
  sess=$( [[ -n $c ]] && do_cliente "$c" '#{session_name}')
  tmux new-window ${sess:+-t "=$sess:"} -c "$dir" -n recebidos
}

# "~" e "~/x" → caminho absoluto nesta máquina (as funções de arquivos sempre rodam na máquina
# dona da pasta, via tt de lá).
expandir() {
  case $1 in
    '~') echo "$HOME" ;;
    '~/'*) echo "$HOME/${1#\~/}" ;;
    *) echo "$1" ;;
  esac
}

# Roda um subcomando do tt em DEST repassando stdin/stdout (para os fluxos de tar).
rodar_io() {
  local dest=$1; shift
  if [[ $dest == . ]]; then (cd && "$EU" "$@")
  else ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO $(q "$@")"; fi
}

# Lista uma pasta (desta máquina) para o navegador: "tipo<TAB>nome<TAB>texto". Pastas primeiro.
listar_pasta() {
  local dir=$1 ocultos=${2:-} so_pastas=${3:-}
  cd "$(expandir "$dir")" 2>/dev/null || { printf 'x\t\t\033[31mpasta não encontrada: %s\033[0m\n' "$dir"; return; }
  printf 'u\t..\t\033[36m⬆ ..\033[0m \033[90m(%s)\033[0m\n' "$(encurtar "$(dirname "$PWD")")"
  local -a filtro=()
  [[ -n $ocultos ]] || filtro=(-not -name '.*')
  [[ -n $so_pastas ]] && filtro+=(-type d)
  find . -mindepth 1 -maxdepth 1 "${filtro[@]}" \
    -printf '%y\t%f\t%s\t%TY-%Tm-%Td %TH:%TM\n' 2>/dev/null |
    sort -t$'\t' -k1,1 -k2,2f |
    awk -F'\t' '{
      if ($1 == "d") printf "d\t%s\t\033[1;34m▸ %s/\033[0m\n", $2, $2
      else {
        t = $3; u = "B"
        if (t >= 1073741824) { t = t / 1073741824; u = "G" } else if (t >= 1048576) { t = t / 1048576; u = "M" } else if (t >= 1024) { t = t / 1024; u = "K" }
        printf "f\t%s\t  %-40s \033[90m%6.1f%s  %s\033[0m\n", $2, $2, t, u, $4
      }
    }'
}

# Prévia de um item: pasta → conteúdo; texto → começo; binário → tipo e tamanho.
previa_item() {
  local dir=$1 nome=$2 alvo
  alvo="$(expandir "$dir")/$nome"
  [[ $nome == .. ]] && alvo=$(dirname "$(expandir "$dir")")
  if [[ -d $alvo ]]; then ls -la --color=always "$alvo" 2>/dev/null | head -60
  elif file -b --mime "$alvo" 2>/dev/null | grep -q 'charset=binary'; then
    echo "$(file -b "$alvo")"; du -h "$alvo" | cut -f1
  else head -c 20000 "$alvo" 2>/dev/null | head -80; fi
}

# Pasta absoluta (resolvida nesta máquina) de "~/x", "..", relativos.
resolver_pasta() { (cd "$(expandir "$1")" 2>/dev/null && encurtar "$(pwd -P)"); }

# Navegador: imprime a pasta final na 1ª linha e os nomes escolhidos nas seguintes.
escolher_arquivos() {
  local dest=$1 dir=$2 titulo=${3:-escolha} modo=${4:-} saida
  estado_por arq_modo "$modo"
  estado_por arq_dest "$dest"
  estado_por arq_dir "$(rodar "$dest" --resolver-pasta "$dir" || echo "$dir")"
  estado_por arq_ocultos ""
  saida=$(rodar "$dest" --listar-pasta "$(estado arq_dir)" "" "$modo" | fzf --ansi $([[ -z $modo ]] && echo --multi) --delimiter='\t' --with-nth=3 \
    --layout=reverse --no-sort --exact --prompt='❯ ' --pointer='▶' --marker='✓' \
    --border=rounded --border-label=" 📁 $titulo · $(rotulo "$dest") " --border-label-pos=3 \
    --header="$(cabecalho_arquivos)" \
    --color='bg:#282a36,fg:#f8f8f2,border:#bd93f9,label:#bd93f9:bold,header:#f8f8f2,pointer:#ff79c6,marker:#50fa7b,prompt:#bd93f9,hl:#f1fa8c,hl+:#ffb86c,fg+:#f8f8f2,bg+:#44475a' \
    --preview="$EU --previa-item-em {1} {2}" --preview-window="$(compacto && echo 'down,40%,border-top,hidden' || echo 'right,45%,border-left')" \
    --bind='ctrl-/:toggle-preview' \
    --bind="right:transform($EU --arq-acao entrar {1} {2})" \
    --bind="left:transform($EU --arq-acao subir)" \
    --bind="enter:transform($EU --arq-acao enter {1} {2})" \
    --bind="double-click:transform($EU --arq-acao enter {1} {2})" \
    --bind="click-header:transform($EU --arq-acao clique)" \
    --bind="alt-h:transform($EU --arq-acao ocultos)" \
    --bind="ctrl-s:accept") || return 1
  estado arq_dir
  [[ -n $modo ]] && return 0
  cut -f2 <<<"$saida" | grep -v '^\.\.$' | grep -v '^$'
}

cabecalho_arquivos() {
  printf '\033[1m%s\033[0m\n' "$(estado arq_dir)"
  if [[ -n $(estado arq_modo) ]]; then
    echo "✓ usar-esta-pasta   ⬆ subir   ⌂ início   ◌ ocultos"
    printf '\033[90m%s\033[0m\n' "→ ou ⏎ entra na pasta · ← sobe · ^s ou ✓ usa a pasta mostrada acima"
  else
    echo "⬆ subir   ⌂ início   ✓ confirmar   ◌ ocultos"
    printf '\033[90m%s\033[0m\n' "Tab marca arquivos ou pastas inteiras · →/⏎ entra · ← sobe · ⏎ confirma marcados"
  fi
}

# Ações do navegador (devolvem ações do fzf).
arq_acao() {
  local a=$1 tipo=${2:-} nome=${3:-} dir dest w recarga
  dir=$(estado arq_dir); dest=$(estado arq_dest)
  recarga="reload-sync($EU --listar-pasta-em)+transform-header($EU --cabecalho-arquivos)+clear-query+first"
  case $a in
    clique)
      w=$(palavra_em "$(cabecalho_arquivos | sed -n "${FZF_CLICK_HEADER_LINE:-0}p" | sed 's/\x1b\[[0-9;]*m//g')" "${FZF_CLICK_HEADER_COLUMN:-0}")
      case $w in
        ⬆ | subir) arq_acao subir ;;
        ⌂ | início) estado_por arq_dir '~'; echo "$recarga" ;;
        ✓ | confirmar | usar-esta-pasta) echo accept ;;
        ◌ | ocultos) arq_acao ocultos ;;
      esac ;;
    subir)
      [[ -n ${FZF_QUERY:-} ]] && { echo backward-char; return; }
      estado_por arq_dir "$(rodar "$dest" --resolver-pasta "$dir/..")"; echo "$recarga" ;;
    entrar)
      [[ -n ${FZF_QUERY:-} ]] && { echo forward-char; return; }
      case $tipo in
        d) estado_por arq_dir "$(rodar "$dest" --resolver-pasta "$dir/$nome")"; echo "$recarga" ;;
        u) arq_acao subir ;;
      esac ;;
    enter)
      if ((${FZF_SELECT_COUNT:-0} > 0)); then echo accept
      elif [[ $tipo == d ]]; then estado_por arq_dir "$(rodar "$dest" --resolver-pasta "$dir/$nome")"; echo "$recarga"
      elif [[ $tipo == u ]]; then FZF_QUERY="" arq_acao subir
      elif [[ $tipo == f ]]; then echo accept; fi ;;
    ocultos)
      [[ -n $(estado arq_ocultos) ]] && estado_por arq_ocultos "" || estado_por arq_ocultos 1
      echo "$recarga" ;;
  esac
}

# Pastas de destino possíveis em DEST: a de cada sessão de lá (mais usadas primeiro), Recebidos, início.
pastas_sessoes() {
  tmux list-sessions -F '#{window_activity}|#{@ponte}|#{pane_current_path}|#{session_name}' 2>/dev/null |
    sort -t'|' -k1,1nr | awk -F'|' '$2 == "" && !v[$3]++ { print $3 "|" $4 }' |
    while IFS='|' read -r p s; do printf '%s\t%s\n' "$(encurtar "$p")" "$s"; done
}

escolher_destino() {
  local dest=$1 aqui=${2:-} titulo=${3:-Para qual pasta?} escolha p
  escolha=$( {
      [[ -n $aqui ]] && printf '%s\t\033[1m%s\033[0m \033[90m(pasta deste painel)\033[0m\n' "$aqui" "$aqui"
      rodar "$dest" --destinos
      printf '!padrao\t\033[36m⚙ mudar a pasta padrão de %s…\033[0m\n' "$(rotulo "$dest")"
      printf '!outra\t\033[36m✎ outra pasta…\033[0m\n'
    } | awk -F'\t' '!v[$1]++' | fzf --ansi --delimiter='\t' --with-nth=2 --layout=reverse --no-sort \
      --border=rounded --border-label=" $titulo · $(rotulo "$dest") " --border-label-pos=3 \
      --prompt='❯ ' --pointer='▶' --color='bg:#282a36,fg:#f8f8f2,border:#bd93f9,label:#bd93f9:bold,pointer:#ff79c6,fg+:#f8f8f2,bg+:#44475a' \
      --bind='left-click:accept' | cut -f1) || return 1
  if [[ $escolha == !outra ]]; then read -rep "Pasta em $(rotulo "$dest"): " -i "~/" p; escolha=$p; fi
  if [[ $escolha == !padrao ]]; then
    escolha=$(escolher_arquivos "$dest" "$(rodar "$dest" --pasta-recebidos)" "nova pasta padrão de $(rotulo "$dest")" pasta) || return 1
    rodar "$dest" --definir-recebidos "$escolha" >&2
  fi
  [[ -n $escolha ]] && echo "$escolha"
}

escolher_maquina() {
  local titulo=$1 exceto=${2:-}
  { [[ $exceto != . ]] && printf '.\t\033[1m%s\033[0m \033[90m(esta)\033[0m\n' "$MAQUINA"
    maquinas | awk -v x="$exceto" '$1 != x { printf "%s\t\033[1m%s\033[0m\n", $1, $2 }'; } |
    fzf --ansi --delimiter='\t' --with-nth=2 --layout=reverse --no-sort --height=~12 \
      --border=rounded --border-label=" $titulo " --prompt='❯ ' --pointer='▶' \
      --color='bg:#282a36,fg:#f8f8f2,border:#bd93f9,label:#bd93f9:bold,pointer:#ff79c6,fg+:#f8f8f2,bg+:#44475a' --bind='left-click:accept' | cut -f1
}

# Lado de lá da cópia: lê um tar do stdin e põe os itens em DIR sem sobrescrever. Imprime os nomes.
receber() {
  local dir tmp f n base ext i alvo
  dir=$(expandir "$1")
  mkdir -p "$dir" || return 1
  # Restos de cópias que morreram no meio (máquina suspensa) somem depois de 6 h sem mudança.
  local velho
  for velho in "$dir"/.tt-recebendo.*; do
    [[ -d $velho ]] && (($(idade_arquivo "$velho") > 21600)) && rm -rf "$velho"
  done
  tmp=$(mktemp -d "$dir/.tt-recebendo.XXXXXX") || return 1
  # Cancelada (TERM) ou conexão caída (HUP/PIPE): nada pela metade fica na pasta.
  trap 'rm -rf "$tmp"; exit 1' TERM INT HUP PIPE
  # -m: o arquivo ganha a data de chegada (senão fica com a data original e some no meio da pasta).
  tar -C "$tmp" -xmf - || { rm -rf "$tmp"; return 1; }
  shopt -s dotglob nullglob
  for f in "$tmp"/*; do
    n=$(basename "$f"); alvo="$dir/$n"
    if [[ -e $alvo ]]; then
      base=$n ext=""
      [[ -f $f && $n == ?*.* ]] && base=${n%.*} ext=".${n##*.}"
      i=2; while [[ -e "$dir/$base ($i)$ext" ]]; do i=$((i + 1)); done
      alvo="$dir/$base ($i)$ext"
    fi
    mv "$f" "$alvo" && basename "$alvo"
  done
  rmdir "$tmp"
}

empacotar() { local dir; dir=$(expandir "$1"); shift; tar -C "$dir" -cf - -- "$@"; }
tamanho() { local dir; dir=$(expandir "$1"); shift; (cd "$dir" && du -scb -- "$@" 2>/dev/null | tail -1 | cut -f1); }

avisar() {
  local c
  for c in $(tmux list-clients -F '#{client_name}' 2>/dev/null); do tmux display-message -c "$c" -d 6000 "$1"; done
}

# ---- Botões --------------------------------------------------------------------------------
# Os botões da barra de teclas extras do Termux (e qualquer teclado) mandam Ctrl+B F1…F10; o tmux
# chama `tt --botao <ação> <cliente> <painel> <pasta>` e a ação decide pelo estado do momento.

botao_aviso() { tmux display-message -c "$1" -d 3000 "$2"; }

# Descendentes de um PID (um por linha, "pid args"), lendo a árvore de processos.
descendentes() {
  ps -A -o pid= -o ppid= -o args= 2>/dev/null | awk -v raiz="$1" '
    { pid = $1; pai[pid] = $2; $1 = $2 = ""; sub(/^ +/, ""); arg[pid] = $0 }
    END { for (p in pai) { q = p; while (q != "" && q != 0 && q != raiz) q = pai[q]; if (q == raiz && p != raiz) print p, arg[p] } }'
}

# Linux do proot-distro (Termux) a usar: distro= no config; senão o Debian; senão o primeiro
# instalado (aceita o layout novo, containers/, e o antigo, installed-rootfs/).
distro_proot() {
  local base=${PREFIX:-/nonexistent}/var/lib/proot-distro d
  command -v proot-distro >/dev/null || return 1
  for d in "$(conf distro)" debian $(ls "$base"/containers "$base"/installed-rootfs 2>/dev/null); do
    [[ -n $d && ( -d $base/containers/$d/rootfs || -d $base/installed-rootfs/$d ) ]] && { echo "$d"; return; }
  done
  return 1
}

# Comando que abre o Linux do proot-distro (Termux) na pasta dada, ou nada se não houver.
debian_comando() {
  local d
  d=$(distro_proot) || return 1
  printf 'proot-distro login %q --shared-tmp --work-dir %q' "$d" "$1"
}

# Caminho do claude desta máquina (também em ~/.local/bin, que pode não estar no PATH do tmux).
claude_local() {
  if [[ -x $HOME/.local/bin/claude ]]; then echo "$HOME/.local/bin/claude"; else command -v claude; fi
}

# Comando do Claude Code: o claude local, ou o do Debian do Termux; falha se nenhum existe.
# Opções extras desta máquina vêm de claude_flags= e variáveis de ambiente de claude_env=
# (ex.: IS_SANDBOX=1) no ~/.config/tt/config.
claude_comando() {
  local pasta=$1 a e c; shift
  a="$(conf claude_flags) $(printf '%q ' "$@")"
  e=$(conf claude_env); e=${e:+$e }
  if c=$(claude_local); then printf '%s%q %s' "$e" "$c" "$a"
  elif debian_comando "$pasta" >/dev/null; then printf '%s -- bash -lc %q' "$(debian_comando "$pasta")" "${e}claude $a"
  else return 1; fi
}

# Vai para a janela marcada com o papel (claude, debian…) naquela pasta, ou cria uma sessão nova.
# Se o painel atual já é desse papel, o botão alterna de volta para a sessão anterior.
ir_papel() {
  local papel=$1 cmd=$2 cliente=$3 pane=$4 pasta=$5 sess jan p dir nome
  if [[ $(tmux show-options -wqv -t "$pane" @tt_papel) == "$papel" ]]; then
    tmux switch-client -c "$cliente" -l 2>/dev/null || botao_aviso "$cliente" "$papel: não há outra sessão para onde voltar"
    return
  fi
  while IFS=$'\t' read -r sess jan p dir; do
    if [[ $p == "$papel" && $dir == "$pasta" ]]; then
      tmux select-window -t "$jan" && tmux switch-client -c "$cliente" -t "=$sess"; return
    fi
  done < <(tmux list-windows -a -F '#{session_name}'$'\t''#{window_id}'$'\t''#{@tt_papel}'$'\t''#{@tt_pasta}')
  nome=$(proximo_nome "$papel")
  tmux new-session -d -s "$nome" -c "$pasta" "$cmd; exec \${SHELL:-bash}" || { botao_aviso "$cliente" "$papel: não consegui abrir a sessão"; return; }
  tmux set-option -w -t "=$nome:" @tt_papel "$papel"
  tmux set-option -w -t "=$nome:" @tt_pasta "$pasta"
  tmux switch-client -c "$cliente" -t "=$nome"
}

# Túnel da tela remota (Guacamole): liga se está desligado, desliga se está ligado.
botao_tela() {
  local cliente=$1 dest porta url
  dest=$(conf tela_destino); porta=$(conf tela_porta); porta=${porta:-8089}
  url=$(conf tela_url); url=${url:-http://localhost:$porta/guacamole/}
  [[ -n $dest ]] || { botao_aviso "$cliente" "tela: defina tela_destino=usuario@host em ~/.config/tt/config"; return; }
  if pgrep -f "L $porta:127.0.0.1:$porta" >/dev/null; then
    pkill -f "L $porta:127.0.0.1:$porta"; botao_aviso "$cliente" "tela: túnel desligado"
  elif ssh -f -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ConnectTimeout=6 -L "$porta:127.0.0.1:$porta" "$dest"; then
    command -v termux-open-url >/dev/null && termux-open-url "$url"
    botao_aviso "$cliente" "tela: túnel ligado em $url"
  else botao_aviso "$cliente" "tela: não consegui conectar em $dest"; fi
}

# Cliente de e-mail desta máquina: do config (email=), senão aerc. Falha se não existe.
email_comando() {
  local c; c=$(conf email); c=${c:-aerc}
  command -v "${c%% *}" >/dev/null || return 1
  printf '%s' "$c"
}

# E-mail numa subjanela (display-popup), como a central ☰ — não uma sessão tmux comum: não
# aparece na lista/central nem vira "sessão de trabalho". O popup abre o cliente (aerc) sobre a
# tela atual; ao sair do cliente o popup fecha e não sobra nada (nem sessão, nem shell órfão), então
# o botão sempre reabre limpo. Se o cliente falhar ao abrir, cai num shell com a mensagem para o
# erro ficar visível, em vez de o popup sumir num piscar.
botao_email() {
  local cliente=$1 cmd prog dica
  # Sem nenhuma conta ainda: o aerc abriria o próprio assistente em inglês; vai direto ao cadastro do tt.
  if [[ ! -s $HOME/.config/aerc/accounts.conf ]] || ! grep -q '^\[' "$HOME/.config/aerc/accounts.conf"; then
    botao_email_contas "$cliente"; return
  fi
  cmd=$(email_comando) || { botao_aviso "$cliente" "e-mail: instale o aerc (ou defina email=<cliente> em ~/.config/tt/config)"; return; }
  # Auto-reparo: se o aerc foi instalado depois do tt ou perdeu o conversor HTML, corrige somente
  # o filtro text/html. Quando houve reparo, reinicia a sessão oculta para carregar a configuração.
  if [[ ${cmd%% *} == */aerc || ${cmd%% *} == aerc ]] && aerc_reparar_se_preciso; then
    tmux kill-session -t "=$EMAIL_SESSAO" 2>/dev/null
  fi
  # Dica de como fechar: display-popup não tem X clicável, então o popup só some quando o
  # cliente sai. Mostra no título a tecla de saída do cliente para quem não a conhece.
  prog=${cmd%% *}
  case ${prog##*/} in
    aerc)        dica="q fecha" ;; # o resto está nos botões do rodapé
    mutt|neomutt) dica="q fecha" ;;
    *)           dica="feche o cliente p/ sair" ;;
  esac
  # A prévia da mensagem acompanha a tela: estreita (< 100: lado a lado, celular) — sem prévia e
  # sem a barra de pastas (J/K trocam de pasta); média — prévia EMBAIXO, com a largura toda (HTML
  # lê melhor); muito larga (≥ 180) — prévia AO LADO. As variantes são cópias da configuração em
  # ~/.cache; a normal não muda.
  local larg modo=largo; larg=$(do_cliente "$cliente" '#{client_width}')
  if [[ ${prog##*/} == aerc && -f $HOME/.config/aerc/aerc.conf ]]; then
    local copia=""
    if ((${larg:-200} < 100)); then
      modo=estreito; copia="$HOME/.cache/tt-aerc-estreito.conf"; mkdir -p "$HOME/.cache"
      cp "$HOME/.config/aerc/aerc.conf" "$copia"
      aerc_definir "$copia" ui sidebar-width 0 forcar
      aerc_definir "$copia" ui index-columns 'flags:3,name<12%,subject,date>=' forcar
      sed -i '/^[[:space:]]*message-list-split[[:space:]]*=/d' "$copia"
    elif ((${larg:-200} >= 180)); then
      modo=amplo; copia="$HOME/.cache/tt-aerc-amplo.conf"; mkdir -p "$HOME/.cache"
      cp "$HOME/.config/aerc/aerc.conf" "$copia"
      aerc_definir "$copia" ui message-list-split 'vertical 70' forcar
    fi
    [[ -n $copia ]] && cmd+=" -C $(printf %q "$copia")"
  fi
  # Subjanela por cima da tela, com borda arredondada na cor do tema e título. (O tmux deixa arrastar
  # um popup pela linha da borda e não tem opção para desligar isso; o dono prefere a borda.)
  local geo=($(tam_popup "$cliente") -b rounded -S 'fg=#89b4fa' -T " 📧 e-mail · $dica ")
  if [[ ${prog##*/} == aerc ]]; then
    # aerc fica aberto e conectado numa sessão oculta: abrir de novo é instantâneo (antes, ~6 s
    # reconectando às contas a cada vez), e e-mail novo chega com ele fechado. q só esconde a
    # subjanela; Ctrl+q encerra o aerc de verdade.
    email_sessao "$cmd" "$modo" || { botao_aviso "$cliente" "e-mail: não consegui abrir o aerc"; return; }
    # Se o aerc morrer logo ao abrir (tema/config/conta inválidos), a sessão fica num shell com o
    # erro em vez de o popup abrir e sumir vazio. Dá um instante para ele iniciar e checa o estado.
    sleep 0.4
    if ! tmux has-session -t "=$EMAIL_SESSAO" 2>/dev/null; then
      botao_aviso "$cliente" "e-mail: o aerc fechou sozinho ao abrir. Rode: aerc  (fora do tt) para ver o erro, ou 📧 → contas para corrigir."
      return
    fi
    local pane_cmd; pane_cmd=$(tmux display -p -t "=$EMAIL_SESSAO:" '#{pane_current_command}' 2>/dev/null)
    if [[ $pane_cmd != aerc* ]]; then
      # O aerc saiu e o shell da sessão mostra o erro: anexa o popup a ele para o erro ficar visível.
      tmux display-popup -c "$cliente" -E "${geo[@]}" "env -u TMUX tmux attach -t =$EMAIL_SESSAO"
      tmux kill-session -t "=$EMAIL_SESSAO" 2>/dev/null
      botao_aviso "$cliente" "e-mail: o aerc não abriu. Verifique a conta em 📧 → contas (ou rode: aerc)."
      return
    fi
    tmux display-popup -c "$cliente" -E "${geo[@]}" "env -u TMUX tmux attach -t =$EMAIL_SESSAO"
    return
  fi
  tmux display-popup -c "$cliente" -E "${geo[@]}" \
    "cd ${HOME@Q}; VAXIS_FORCE_UNICODE=1 $cmd || { printf '\\n[e-mail] o cliente saiu com erro (código %s). Enter fecha.' \"\$?\"; read -r _; }"
}

# Sessão oculta com o aerc aberto. Marcada como "ponte" do tipo email: fica fora da central, do
# seletor, do vigia e da limpeza de sessões paradas/vazias. Recriada se o aerc saiu ou se o modo
# (largo/estreito) mudou. Nela, q desanexa em vez de sair (binds próprios, gerados do binds.conf).
EMAIL_SESSAO=_tt-email
email_sessao() {
  local cmd=$1 modo=$2 b="$HOME/.config/aerc/binds.conf" bo="$HOME/.cache/tt-aerc-binds-oculto.conf" pane_cmd
  # Versão dos binds da sessão: a do tt + a soma do binds.conf (um cadastro de conta Gmail muda os
  # binds por conta; a sessão de antes, com o aerc de antes, é recriada na próxima abertura).
  local ver="$EMAIL_BINDS_VER:$( [[ -f $b ]] && cksum <"$b" | cut -d' ' -f1 || echo 0)"
  if tmux has-session -t "=$EMAIL_SESSAO" 2>/dev/null; then
    pane_cmd=$(tmux display -p -t "=$EMAIL_SESSAO:" '#{pane_current_command}' 2>/dev/null)
    if [[ $(tmux show -qv -t "=$EMAIL_SESSAO:" @tt_email_modo) == "$modo" && $pane_cmd == aerc* &&
          $(tmux show -qv -t "=$EMAIL_SESSAO:" @tt_email_binds) == "$ver" &&
          $(tmux show-environment -t "=$EMAIL_SESSAO" VAXIS_FORCE_UNICODE 2>/dev/null) == VAXIS_FORCE_UNICODE=1 ]]; then email_sessao_botoes; return 0; fi
    tmux kill-session -t "=$EMAIL_SESSAO" 2>/dev/null
  fi
  mkdir -p "$HOME/.cache"
  if [[ -f $b ]]; then
    # Na sessão oculta: q/Q desanexam; ? e F2 abrem as telas do tt como janelas da sessão (não como
    # abas do aerc, que deixavam os botões sem alvo); e as teclas de função dos botões (F3–F10).
    sed -e 's/^\([[:space:]]*\)\(q\|Q\)[[:space:]]*=[[:space:]]*:quit<Enter>[[:space:]]*$/\1\2 = :exec tmux detach-client<Enter>/' \
        -e "s/^<C-q>[[:space:]]*=.*/<C-q> = :quit<Enter>/" \
        -e "s|:term $HOME/.local/bin/tt --email-atalhos<Enter>|:exec $HOME/.local/bin/tt --email-tela atalhos<Enter>|" \
        -e "s|:term $HOME/.local/bin/tt --email-contas-ui<Enter>|:exec $HOME/.local/bin/tt --email-tela contas<Enter>|" "$b" >"$bo"
    { echo '[messages]'; email_binds_botoes messages; echo '[view]'; email_binds_botoes view; email_binds_botoes_contas; } >>"$bo"
    cmd+=" -B $(printf %q "$bo")"
  fi
  email_sessao_criar "$cmd" "$modo" "$ver" || return 1
  email_sessao_botoes
  return 0
}
# Versão dos binds da sessão oculta: uma sessão criada com binds antigos é recriada (os botões
# mandam F3–F10, que o aerc de antes não conhecia).
EMAIL_BINDS_VER=3
email_sessao_criar() {
  local cmd=$1 modo=$2 ver=${3:-$EMAIL_BINDS_VER:0}
  # VAXIS_FORCE_UNICODE: o aerc mede emoji com seletor de variação (🕸️, ⚠️) como 2 colunas, igual ao
  # tmux (3.5 e 3.6) e aos terminais. Sem isso ele contava 1, a linha ficava com uma coluna a mais e o
  # fim dela (o horário) transbordava para a linha de baixo: dígitos soltos na coluna de pastas.
  tmux new-session -d -s "$EMAIL_SESSAO" -x 150 -y 40 -c "$HOME" -e VAXIS_FORCE_UNICODE=1 "$cmd" || return 1
  tmux set -q -t "=$EMAIL_SESSAO:" @ponte email
  tmux set -q -t "=$EMAIL_SESSAO:" @tt_oculta 1
  tmux set -q -t "=$EMAIL_SESSAO:" @nome_auto 0
  tmux set -q -t "=$EMAIL_SESSAO:" @tt_email_modo "$modo"
  tmux set -q -t "=$EMAIL_SESSAO:" @tt_email_binds "$ver"
  return 0
}

# Barra de botões do e-mail: a linha de status da sessão oculta (aparece no rodapé do popup). Cada
# botão é um range user|em_<ação>; o clique chega pelo mesmo caminho dos botões da barra principal
# (MouseDown1Status → tt --clique) e vira a tecla do aerc (email_botao_acao). Em tela estreita
# (< 100) ficam só os ícones. Aplicada toda vez que o popup abre (a sessão pode ser antiga).
email_sessao_botoes() {
  tmux set -q -t "=$EMAIL_SESSAO:" status on
  tmux set -q -t "=$EMAIL_SESSAO:" status-position bottom
  tmux set -q -t "=$EMAIL_SESSAO:" status-style 'bg=#181825,fg=#cdd6f4'
  tmux set -q -t "=$EMAIL_SESSAO:" 'status-format[0]' "$(email_barra_fmt)"
}
# Os botões: ação, ícone, rótulo, tecla de função mandada ao aerc (cor de fundo própria para os
# destrutivos). As ações do aerc vão por F3–F10, não pelas letras: uma letra cairia no que estiver
# na frente (o editor de uma mensagem, um terminal), enquanto a tecla de função só faz algo nos
# contextos em que o tt a ligou (lista e leitura; ver email_binds_botoes). Contas e atalhos são
# telas do tt (email_tela), sem passar pelo aerc.
EMAIL_BOTOES=(
  'abrir|📖|Abrir|F3'
  'nova|+|Nova|F4'
  'resp|↩|Responder|F5'
  'todos|↩↩|Todos|F6'
  'enc|↪|Encaminhar|F7'
  'arq|▤|Arquivar|F8'
  'apagar|✕|Apagar|F9'
  'pasta|📁|Pasta|F10'
  'sync|⟳|Sincronizar|'
  'contas|👤|Contas|'
  'atalhos|?|Atalhos|'
)
# Apagar e arquivar CERTOS no Gmail. No IMAP do Gmail as pastas são rótulos: tirar a mensagem do
# INBOX (o que :delete faz, direto ou pelo mbsync) só a ARQUIVA — ela segue em "Todos os e-mails";
# apagar de verdade é mandá-la para a Lixeira. Então, nas contas Gmail do tt: d/D (e o botão ✕)
# movem para a lixeira da conta, com pergunta; a (e ▤) tira do INBOX (= arquivar no Gmail, sem
# subir cópia nenhuma; ela já está em Todos os e-mails); e dentro da Lixeira/Spam, d/D apagam de
# vez. Seções por conta ([messages:account=^Nome$]) e por pasta (a pasta ganha da conta). As
# outras contas ficam com os binds de fábrica (lá :delete apaga mesmo). Lista: "nome⇥lixeira⇥spam⇥todos".
email_contas_gmail() {
  local s nome re mae l sp td; local -A E=()
  declare -F email_slugs >/dev/null || return 0
  for s in $(email_slugs 2>/dev/null); do
    E=(); email_ler "$s" 2>/dev/null || continue
    [[ ${E[provedor]:-} == gmail || ${E[imap_host]:-} == imap.gmail.com ]] || continue
    [[ -n ${E[pasta_lixeira]:-} ]] || continue
    mae=${E[pasta_naoabre]:-}; l=${E[pasta_lixeira]}; sp=${E[pasta_spam]:-}; td=${E[pasta_todos]:-}
    [[ -n $mae ]] && { l=${l#"$mae"/}; sp=${sp#"$mae"/}; td=${td#"$mae"/}; }
    printf '%s\t%s\t%s\t%s\n' "${E[nome]}" "$l" "$sp" "$td"
  done
}
re_escapar() { printf '%s' "$1" | sed 's/[][\\.*^$+?(){}|]/\\&/g'; }
# As seções, com as teclas pedidas: APAGAR (pergunta), APAGAR_DIRETO e ARQUIVAR (vazia = não gera).
# Para o binds.conf são d, D e a; para a sessão oculta, os botões ✕ (F9) e ▤ (F8).
email_binds_contas_gerar() { # tecla_apagar tecla_apagar_direto tecla_arquivar
  local ka=$1 kd=$2 kq=$3 nome l sp td re p ctx; local -A vistas=()
  while IFS=$'\t' read -r nome l sp td; do
    [[ -n $nome ]] || continue
    re=$(re_escapar "$nome")
    for ctx in messages view; do
      printf '[%s:account=^%s$]\n' "$ctx" "$re"
      [[ -n $ka ]] && printf '%s = :choose -o y '"'"'Apagar (vai para a lixeira)'"'"' '"'"'move %s'"'"'<Enter>\n' "$ka" "$l"
      [[ -n $kd ]] && printf '%s = :move %s<Enter>\n' "$kd" "$l"
      [[ -n $kq ]] && printf '%s = :delete<Enter>\n' "$kq" # arquivar no Gmail = tirar do INBOX (segue em Todos os e-mails)
    done
    # Na lixeira e no spam, apagar é de vez; lá e em "Todos os e-mails", arquivar não faz sentido.
    for p in "$l" "$sp" "$td"; do
      [[ -n $p && -z ${vistas[$p]:-} ]] || continue; vistas[$p]=1
      for ctx in messages view; do
        printf '[%s:folder=^%s$]\n' "$ctx" "$(re_escapar "$p")"
        if [[ $p != "$td" ]]; then
          [[ -n $ka ]] && printf '%s = :choose -o y '"'"'Apagar de vez (não volta)'"'"' delete-message<Enter>\n' "$ka"
          [[ -n $kd ]] && printf '%s = :delete<Enter>\n' "$kd"
        fi
        [[ -n $kq ]] && printf '%s =\n' "$kq"
      done
    done
  done < <(email_contas_gmail)
  return 0
}
email_binds_contas() { email_binds_contas_gerar d D a; }                    # → binds.conf
email_binds_botoes_contas() { email_binds_contas_gerar '<F9>' '' '<F8>'; }   # → binds da sessão oculta

# O que cada tecla de função faz no aerc, por contexto (vai para os binds da sessão oculta).
email_binds_botoes() { # messages|view
  [[ $1 == messages ]] && echo '<F3> = :view<Enter>'
  echo '<F4> = :compose<Enter>'
  echo '<F5> = :reply<Enter>'
  echo '<F6> = :reply -a<Enter>'
  echo '<F7> = :forward<Enter>'
  echo '<F8> = :archive flat<Enter>'
  echo '<F9> = :choose -o y '"'"'Apagar esta mensagem'"'"' delete-message<Enter>'
  echo '<F10> = :move<space>'
  echo '<F11> = :check-mail<Enter>' # depois do ⟳: as contas só IMAP conferem também
}
email_barra_fmt() {
  local b acao ic rot tecla est out=""
  for b in "${EMAIL_BOTOES[@]}"; do
    IFS='|' read -r acao ic rot tecla <<<"$b"
    case $acao in
      abrir) est='#[fg=#1e1e2e,bg=#89b4fa,bold]' ;;
      apagar) est='#[fg=#1e1e2e,bg=#f38ba8,bold]' ;;
      *) est='#[fg=#cdd6f4,bg=#45475a]' ;;
    esac
    if [[ $acao == sync ]]; then
      # Enquanto consulta (e logo depois), o botão mostra o estado (@tt_email_sync: "consultando…", "✓ 2 novos").
      out+="#[range=user|em_$acao]$est $ic#{?#{@tt_email_sync}, #{@tt_email_sync},#{?#{e|<:#{client_width},100},, $rot}} #[norange]#[default] "
      continue
    fi
    out+="#[range=user|em_$acao]$est $ic#{?#{e|<:#{client_width},100},, $rot} #[norange]#[default] "
  done
  printf '%s' "$out"
}
# Clique num botão do popup do e-mail. Funciona de qualquer lugar: contas e atalhos abrem/fecham a
# tela do tt (email_tela); as ações do aerc fecham antes a tela do tt que estiver na frente e só
# então mandam a tecla de função à janela do aerc.
email_botao_acao() { # ação
  tmux has-session -t "=$EMAIL_SESSAO" 2>/dev/null || return 0
  local b acao ic rot tecla=""
  case $1 in
    contas | atalhos) email_tela "$1"; return 0 ;;
    sync) (email_sync_agora >/dev/null 2>&1 &); return 0 ;; # consulta as contas agora, sem travar o clique
  esac
  for b in "${EMAIL_BOTOES[@]}"; do IFS='|' read -r acao ic rot tecla <<<"$b"; [[ $acao == "$1" ]] && break; tecla=""; done
  [[ -n $tecla ]] || return 0
  email_tela_fechar
  tmux send-keys -t "=$EMAIL_SESSAO:" "$tecla"
}

# Telas do tt por cima do aerc (⌨ atalhos, 👤 contas — e dentro dela cadastro, edição, propagar):
# janelas da própria sessão oculta, com a barra de botões visível; a tela fecha com q/Esc, com o
# mesmo botão de novo, ou quando outro botão age (fecha e age). Abrir uma com outra aberta troca.
# Vale de qualquer lugar: botão, tecla do aerc (? e F2 na sessão oculta) ou tt --email-tela.
email_tela() { # atalhos|contas
  local nome cmd tela id
  case $1 in
    atalhos) nome='⌨ atalhos'; cmd="$HOME/.local/bin/tt --email-atalhos" ;;
    contas)  nome='👤 contas';  cmd="cd ${HOME@Q}; $HOME/.local/bin/tt --email-contas-ui" ;;
    *) return 0 ;;
  esac
  [[ -x $HOME/.local/bin/tt ]] || cmd=${cmd//"$HOME/.local/bin/tt"/"$EU"}
  tmux has-session -t "=$EMAIL_SESSAO" 2>/dev/null || return 0
  tela=$(tmux show -wqv -t "=$EMAIL_SESSAO:" @tt_email_tela)
  [[ -n $tela ]] && email_tela_fechar
  [[ $tela == "$1" ]] && return 0 # o mesmo botão de novo: só fecha
  id=$(tmux new-window -P -F '#{window_id}' -t "=$EMAIL_SESSAO:" -n "$nome" -c "$HOME" "$cmd") || return 0
  tmux set -wq -t "$id" @tt_email_tela "$1"
  tmux set -wq -t "$id" remain-on-exit off
  return 0
}
# Fecha a tela do tt que estiver na frente (a janela corrente da sessão oculta); o aerc nunca.
email_tela_fechar() {
  [[ -n $(tmux show -wqv -t "=$EMAIL_SESSAO:" @tt_email_tela 2>/dev/null) ]] && tmux kill-window -t "=$EMAIL_SESSAO:"
  return 0
}

# ─── Escrever e-mails (compose do aerc) ──────────────────────────────────────
#
# O aerc chama o tt em três pontos do compose (aerc.conf [compose], posto por configurar_aerc):
#   editor            tt --email-editor ARQ        o editor padronizado (abaixo)
#   address-book-cmd  tt --email-contatos TEXTO    destinatários a partir dos e-mails já trocados
#   file-picker-cmd   tt --email-anexos-escolher F  seletor de anexos (tecla a na revisão)
# e ganha, por conta, a assinatura (signature-file no bloco do accounts.conf, arquivo
# ~/.config/tt/email/<slug>.assinatura) e os avisos de assunto vazio e de anexo esquecido.

# Editor das mensagens: o editor_tt (VISUAL/EDITOR do dono mandam; senão o vim com a configuração
# do tt) mais o jeito de e-mail quando é o vim — largura 72 com format=flowed (fo+=w: o vim deixa
# o espaço no fim da linha quebrada, e o aerc manda text/plain; format=flowed, que o leitor do
# outro lado reflui à largura dele), ortografia em português e inglês (z= sugere), sem números de
# linha, começa escrevendo acima da citação. Sem vim: vi ou nano, como estão.
email_editor() { # [arquivo…]
  local -a ed; read -ra ed <<<"$(editor_tt)"
  case ${ed[0]##*/} in
    vim|nvim)
      local spell=en
      if email_vim_spell_tem; then spell=pt_br,en
      elif [[ -z ${TT_EMAIL_SEM_REDE:-} ]]; then (email_vim_spell_garantir >/dev/null 2>&1 &); fi
      email_vimrc_garantir
      ed+=(--cmd "let g:tt_spelllang='$spell'" -S "$DIR_TT/vimrc-tt-email") ;;
    nano) ed+=(-r 72) ;;
  esac
  if [[ -n ${TT_EMAIL_EDITOR_MOSTRAR:-} ]]; then printf '%q ' "${ed[@]}" "$@"; echo; return 0; fi
  exec "${ed[@]}" "$@"
}
# O trecho de e-mail do vim (vim -S ele, depois do vimrc que estiver valendo).
email_vimrc_garantir() {
  local f=$DIR_TT/vimrc-tt-email tmp
  tmp=$(mktemp) || return 0
  cat >"$tmp" <<'VIMRC'
" E-mail no editor do tt: largura 72 em format=flowed, ortografia pt/en, sem números de linha.
setlocal filetype=mail
setlocal textwidth=72 formatoptions+=w formatoptions+=q formatoptions-=l
setlocal nonumber norelativenumber
execute 'setlocal spelllang=' . get(g:, 'tt_spelllang', 'en')
setlocal spell
let &l:statusline = ' ✉ %m%=Ctrl+S salva e volta à revisão · :q! cancela · z= corrige a palavra  %l/%L '
" Começa escrevendo no alto; se já há texto (a citação da resposta), numa linha nova acima dele.
if !(line('$') == 1 && empty(getline(1))) | call append(0, '') | endif
call cursor(1, 1)
startinsert
VIMRC
  mkdir -p "$DIR_TT" 2>/dev/null
  cmp -s "$tmp" "$f" 2>/dev/null || cat "$tmp" >"$f"
  rm -f "$tmp"
}
# Dicionário de português do vim (~/.vim/spell/pt.utf-8.spl, de onde o próprio vim o leria).
EMAIL_VIM_SPELL="$HOME/.vim/spell/pt.utf-8.spl"
EMAIL_VIM_SPELL_URL=${TT_VIM_SPELL_URL:-https://ftp.nluug.nl/pub/vim/runtime/spell/pt.utf-8.spl}
email_vim_spell_tem() { [[ -s $EMAIL_VIM_SPELL ]]; }
email_vim_spell_garantir() {
  email_vim_spell_tem && return 0
  command -v curl >/dev/null || return 1
  mkdir -p "${EMAIL_VIM_SPELL%/*}" || return 1
  curl -sfL --max-time 120 -o "$EMAIL_VIM_SPELL.tmp" "$EMAIL_VIM_SPELL_URL" && [[ -s $EMAIL_VIM_SPELL.tmp ]] &&
    mv "$EMAIL_VIM_SPELL.tmp" "$EMAIL_VIM_SPELL" || { rm -f "$EMAIL_VIM_SPELL.tmp"; return 1; }
}

# Destinatários: índice "endereço<TAB>nome<TAB>vezes" dos remetentes e destinatários de todos os
# e-mails nos maildirs (contas com sync local), refeito ao fim de cada volta completa do sync e,
# se está velho (> 1 h) quando o aerc pede, em segundo plano. Contatos escritos à mão em
# ~/.config/tt/email/contatos.tsv (endereço<TAB>nome) vêm primeiro. (EMAIL_CONTATOS_* ficam junto
# de EMAIL_DIR, na seção de cadastro.)
email_contatos_indexar() {
  local -a mds=(); local s meus=""; local -A E=()
  for s in $(email_slugs); do
    [[ -d $(email_maildir "$s") ]] && mds+=("$(email_maildir "$s")")
    E=(); email_ler "$s" 2>/dev/null && [[ -n ${E[endereco]:-} ]] && meus+="${meus:+,}${E[endereco]}" # os próprios endereços ficam de fora
  done
  mkdir -p "${EMAIL_CONTATOS_CACHE%/*}"
  ((${#mds[@]})) || { : >"$EMAIL_CONTATOS_CACHE"; return 0; }
  python3 -I "$EMAIL_PY" contatos-indexar "--sem=$meus" "${mds[@]}" >"$EMAIL_CONTATOS_CACHE.tmp" 2>/dev/null &&
    mv "$EMAIL_CONTATOS_CACHE.tmp" "$EMAIL_CONTATOS_CACHE" || rm -f "$EMAIL_CONTATOS_CACHE.tmp"
}
# tt --email-contatos TEXTO (address-book-cmd): "endereço<TAB>nome" dos que casam com TEXTO (no
# nome ou no endereço, sem distinguir maiúsculas), manuais primeiro, depois os mais frequentes.
email_contatos() {
  local q=${1:-}
  if [[ ! -f $EMAIL_CONTATOS_CACHE ]] || (( $(date +%s) - $(stat -c %Y "$EMAIL_CONTATOS_CACHE" 2>/dev/null || echo 0) > 3600 )); then
    mkdir -p "${EMAIL_CONTATOS_CACHE%/*}"; touch "$EMAIL_CONTATOS_CACHE" # a idade zera já: uma indexação por vez
    ("$EU" --email-contatos-indexar >/dev/null 2>&1 &)
  fi
  { [[ -f $EMAIL_CONTATOS_MANUAL ]] && grep -v '^#' "$EMAIL_CONTATOS_MANUAL"; cut -f1,2 "$EMAIL_CONTATOS_CACHE"; } 2>/dev/null |
    awk -F'\t' -v q="${q,,}" 'NF && $1 != "" { l = tolower($0); if (q == "" || index(l, q)) { k = tolower($1); if (!(k in v)) { v[k] = 1; print $1 "\t" $2; if (++n >= 50) exit } } }'
}

# Seletor de anexos (file-picker-cmd; tecla a na revisão): os arquivos da pasta de recebidos e da
# pasta pessoal, os mais recentes primeiro, Tab marca vários; grava os escolhidos no arquivo que
# o aerc indica (%f). Sem terminal, lê os caminhos da entrada padrão.
email_anexos_escolher() { # arquivo-de-saída
  local saida=${1:?uso: tt --email-anexos-escolher ARQUIVO} esc rec; local -a raizes=()
  rec=$(pasta_recebidos </dev/null 2>/dev/null); [[ -n $rec && -d $rec ]] && raizes+=("$rec") # (</dev/null: no WSL o cmd.exe de pasta_recebidos comeria a entrada)
  raizes+=("$HOME")
  if [[ -t 0 && -t 1 ]] && command -v fzf >/dev/null; then
    esc=$(find "${raizes[@]}" -maxdepth 4 -type f ! -path '*/.*' ! -path '*/node_modules/*' -printf '%T@\t%p\n' 2>/dev/null |
      sort -rn | cut -f2 | awk '!s[$0]++' | head -20000 |
      fzf --multi --layout=reverse --prompt='📎 ' --header='Tab marca vários · ⏎ anexa · Esc cancela' \
        --preview 'ls -lh {} 2>/dev/null | cut -d" " -f5-' --preview-window=down,3,wrap) || esc=""
  else esc=$(cat); fi
  printf '%s\n' "$esc" | sed '/^$/d' >"$saida"
  return 0
}

# Assinatura da conta: ~/.config/tt/email/<slug>.assinatura (texto livre, várias linhas); o bloco
# do aerc ganha signature-file quando o arquivo tem conteúdo. tt --email-assinatura CONTA abre o
# editor_tt nele (sem terminal: lê a entrada padrão); vazio = sem assinatura.
email_assinatura_arq() { echo "$EMAIL_DIR/$1.assinatura"; }
email_assinatura_editar() { # slug
  local slug=$1 f; f=$(email_assinatura_arq "$slug")
  mkdir -p "$EMAIL_DIR"
  if [[ -t 0 ]] && { : >/dev/tty; } 2>/dev/null; then
    local -a ed; read -ra ed <<<"$(editor_tt)"; [[ ${ed[0]##*/} == nano ]] && ed+=(-t)
    "${ed[@]}" "$f" </dev/tty >/dev/tty 2>&1 || true
  else cat >"$f"; fi
  [[ -s $f ]] || rm -f "$f"
  local -A E=(); email_ler "$slug" && email_regerar "$slug"
  if [[ -s $f ]]; then echo "✓ assinatura de ${E[nome]:-$slug} gravada ($(wc -l <"$f") linha$( (($(wc -l <"$f") > 1)) && echo s))"
  else echo "· ${E[nome]:-$slug} fica sem assinatura"; fi
}

# ─── Cadastro e gerência de contas de e-mail (aerc) ────────────────────────────
# Cada conta do tt tem um arquivo chave=valor em ~/.config/tt/email/<slug>.conf (nada secreto:
# provedor, servidores, portas, segurança, autenticação) e o segredo em ~/.secrets/aerc-<slug>.txt
# (600): a senha, ou o token de renovação do OAuth2. O accounts.conf do aerc é GERADO: cada conta do
# tt vira um bloco entre marcadores "# >>> tt e-mail: <slug> >>>"; blocos escritos à mão ficam
# intactos. Nenhuma função aqui imprime, versiona ou copia o segredo.
AERC_DIR="$HOME/.config/aerc"
AERC_CONTAS="$AERC_DIR/accounts.conf"
SECRETS_DIR="$HOME/.secrets"
EMAIL_DIR="$CONF_DIR/email"
EMAIL_PY="$DIR_TT/email-tt.py"
[[ -f $EMAIL_PY ]] || EMAIL_PY="${EU%/*}/email-tt.py"
EMAIL_CONTATOS_CACHE="$HOME/.cache/tt/email-contatos.tsv" # índice de destinatários (email_contatos_indexar)
EMAIL_CONTATOS_MANUAL="$EMAIL_DIR/contatos.tsv"            # contatos escritos à mão: endereço<TAB>nome
declare -A E=() # conta em edição (as funções declaram a sua cópia local com local -A E)
# Chaves de uma conta, na ordem em que são gravadas.
EMAIL_CHAVES=(nome endereco usuario nome_exibicao provedor auth imap_host imap_porta imap_seg smtp_host smtp_porta smtp_seg
  pasta cred_cmd oauth_client_id oauth_auth_endpoint oauth_token_endpoint oauth_device_endpoint oauth_scope
  pasta_todos pasta_enviados pasta_lixeira pasta_rascunhos pasta_spam pasta_naoabre pasta_importantes pasta_estrela sync_local
  extra_1 extra_2 extra_3 extra_4 extra_5 extra_6 extra_7 extra_8)

# Nome de conta → slug seguro para nome de arquivo (minúsculas, só [a-z0-9_-]).
email_slug() {
  local s=${1,,}; s=${s//[^a-z0-9]/-}; s=${s//--/-}; s=${s#-}; s=${s%-}; printf '%s' "${s:-conta}"
}

# Lista os nomes de conta já cadastrados (cabeçalhos [Nome] do accounts.conf), um por linha.
email_contas_nomes() {
  [[ -f $AERC_CONTAS ]] || return 0
  sed -n 's/^\[\(.*\)\]$/\1/p' "$AERC_CONTAS"
}

# Provedores conhecidos: "chave|rótulo|imap host porta seg|smtp host porta seg|autenticações|dica".
EMAIL_PROVEDORES='gmail|Gmail / Google Workspace|imap.gmail.com 993 tls|smtp.gmail.com 465 tls|oauth senha comando|OAuth2 é recomendado. Senha de app continua disponível: https://myaccount.google.com/apppasswords
microsoft|Outlook / Hotmail / Microsoft 365|outlook.office365.com 993 tls|smtp.office365.com 587 starttls|oauth senha comando|A Microsoft desligou a senha comum: use OAuth2 (SSO). Contas de empresa podem exigir aprovação do administrador.
yahoo|Yahoo Mail|imap.mail.yahoo.com 993 tls|smtp.mail.yahoo.com 465 tls|senha comando|Senha de app: Segurança da conta → Gerar senha de app
icloud|iCloud Mail|imap.mail.me.com 993 tls|smtp.mail.me.com 587 starttls|senha comando|Senha específica de app: appleid.apple.com → Iniciar sessão e segurança
fastmail|Fastmail|imap.fastmail.com 993 tls|smtp.fastmail.com 465 tls|senha comando|Senha de app: Configurações → Privacidade e segurança → Integrações
zoho|Zoho Mail|imap.zoho.com 993 tls|smtp.zoho.com 465 tls|senha comando|Habilite o IMAP nas configurações do Zoho; com 2 etapas, use senha de app
proton|Proton Mail (via Proton Bridge)|127.0.0.1 1143 nenhuma|127.0.0.1 1025 nenhuma|senha comando|Use o usuário e a senha que o Proton Bridge mostra (não a senha da conta)
outro|Outro (descobrir pelo domínio ou configurar à mão)|||senha oauth comando|Os servidores são descobertos pelo domínio do endereço; confira e ajuste se preciso'

email_provedor() { awk -F'|' -v k="$1" '$1 == k' <<<"$EMAIL_PROVEDORES"; }

# Padrões de OAuth2 por provedor (o ID do app é do usuário; para a Microsoft há a opção do ID
# público do Thunderbird, que muitos clientes livres usam).
EMAIL_THUNDERBIRD_ID=9e5f94bc-e8a4-4e73-b8be-63364c29d753

# App OAuth "Desktop" do próprio tt no Google: contas Gmail com auth=oauth funcionam de fábrica,
# sem criar projeto no console. Num app instalado o client_secret NÃO é confidencial (o Google
# assume isso no fluxo de apps nativos; rclone e Thunderbird embutem os seus) — ele só está em
# partes para não disparar os scanners de segredo. Dá para revogar/trocar no Google Cloud Console;
# quem preferir o próprio app continua podendo informar o client_id dele.
EMAIL_GMAIL_ID=647119475915-epqt1iu158sq5b5jjv8a7v32qgpru0be.apps.googleusercontent.com
email_gmail_secret() { printf 'GOCSPX-%s%s' 'vtcInea5Jcu3w6' 'ufZpm9b2WM_VOm'; }

# Aplica o app do tt quando a conta Gmail OAuth não traz um client_id próprio; e garante o
# arquivo do client_secret (que o email-tt.py já lê) quando o app em uso é o do tt.
email_gmail_padrao_id() {
  [[ ${E[provedor]:-} == gmail && ${E[auth]:-} == oauth && -z ${E[oauth_client_id]:-} ]] || return 0
  E[oauth_client_id]=$EMAIL_GMAIL_ID
}
email_gmail_padrao_secret() {
  [[ ${E[auth]:-} == oauth && ${E[oauth_client_id]:-} == "$EMAIL_GMAIL_ID" && -n ${E[_slug]:-} ]] || return 0
  local f=$SECRETS_DIR/aerc-${E[_slug]}.client_secret
  [[ -s $f ]] && return 0
  mkdir -p "$SECRETS_DIR"; chmod 700 "$SECRETS_DIR" 2>/dev/null
  ( umask 077; email_gmail_secret >"$f" )
}
email_oauth_padrao() { # provedor → atribui em E[...]
  case $1 in
    microsoft)
      E[oauth_device_endpoint]=https://login.microsoftonline.com/common/oauth2/v2.0/devicecode
      E[oauth_token_endpoint]=https://login.microsoftonline.com/common/oauth2/v2.0/token
      E[oauth_auth_endpoint]=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
      E[oauth_scope]="offline_access https://outlook.office.com/IMAP.AccessAsUser.All https://outlook.office.com/SMTP.Send" ;;
    gmail)
      E[oauth_auth_endpoint]=https://accounts.google.com/o/oauth2/auth
      E[oauth_token_endpoint]=https://oauth2.googleapis.com/token
      E[oauth_device_endpoint]=""
      E[oauth_scope]=https://mail.google.com/ ;;
  esac
}

email_conf_arq() { echo "$EMAIL_DIR/$1.conf"; }
email_cred_arq() { echo "$SECRETS_DIR/aerc-$1.txt"; }

# Carrega a conta SLUG no array associativo global E.
email_ler() {
  local f k v; f=$(email_conf_arq "$1"); [[ -r $f ]] || return 1
  E=(); E[_slug]=$1
  while IFS= read -r l; do [[ $l == *=* && $l != \#* ]] || continue; k=${l%%=*}; v=${l#*=}; E[$k]=$v; done <"$f"
}

email_gravar() {
  local slug=${E[_slug]} f k
  email_gmail_padrao_secret
  mkdir -p "$EMAIL_DIR"; f=$(email_conf_arq "$slug")
  { echo "# conta de e-mail do tt (sem segredos; o segredo fica em $(email_cred_arq "$slug"))"
    for k in "${EMAIL_CHAVES[@]}"; do [[ -z ${E[$k]:-} ]] || printf '%s=%s\n' "$k" "${E[$k]}"; done; } >"$f.tmp" && mv "$f.tmp" "$f"
}

# Snapshot privado para cadastro/edição transacional. Se autorização ou teste falhar, todos os
# arquivos locais voltam exatamente ao estado anterior; conta nova inválida não deixa resíduos.
email_snapshot_criar() { # slug
  local slug=$1 d nome arq
  d=$(mktemp -d "${TMPDIR:-/tmp}/tt-email-snapshot.XXXXXX") || return 1
  chmod 700 "$d"
  while IFS='|' read -r nome arq; do
    if [[ -e $arq ]]; then cp -p "$arq" "$d/$nome" || { rm -rf "$d"; return 1; }; : >"$d/$nome.existe"; fi
  done <<EOF
conf|$(email_conf_arq "$slug")
cred|$(email_cred_arq "$slug")
client_secret|$SECRETS_DIR/aerc-$slug.client_secret
accounts|$AERC_CONTAS
pastas|$AERC_DIR/tt-pastas-$slug.map
mbsyncrc|$EMAIL_MBSYNC_DIR/$slug.mbsyncrc
assinatura|$EMAIL_DIR/$slug.assinatura
EOF
  printf '%s' "$d"
}

email_snapshot_restaurar() { # snapshot slug
  local d=$1 slug=$2 nome arq
  while IFS='|' read -r nome arq; do
    if [[ -e $d/$nome.existe ]]; then mkdir -p "$(dirname "$arq")"; cp -p "$d/$nome" "$arq"
    else rm -f "$arq"; fi
  done <<EOF
conf|$(email_conf_arq "$slug")
cred|$(email_cred_arq "$slug")
client_secret|$SECRETS_DIR/aerc-$slug.client_secret
accounts|$AERC_CONTAS
pastas|$AERC_DIR/tt-pastas-$slug.map
mbsyncrc|$EMAIL_MBSYNC_DIR/$slug.mbsyncrc
assinatura|$EMAIL_DIR/$slug.assinatura
EOF
  rm -rf "$d"
}

email_salvar_validado() { # snapshot autorizar_oauth(0|1)
  local snap=$1 autorizar=${2:-0} slug=${E[_slug]}
  email_gmail_padrao_id
  # Sync local exige mbsync instalado: recusa antes de gravar, sem fingir que ligou.
  if [[ ${E[sync_local]:-} == 1 ]] && ! command -v "$(mbsync_bin)" >/dev/null; then
    email_snapshot_restaurar "$snap" "$slug"
    echo "✗ Sync local pede o mbsync (isync) instalado. Instale-o ou deixe sync_local vazio."; return 1
  fi
  if ! email_gravar || ! email_regerar "$slug"; then
    email_snapshot_restaurar "$snap" "$slug"
    echo "✗ Não consegui gravar a conta. Nada foi alterado."; return 1
  fi
  if [[ -z ${TT_EMAIL_SEM_REDE:-} ]]; then
    if [[ ${E[auth]} == oauth && $autorizar == 1 ]] && ! email_autorizar_slug "$slug"; then
      email_snapshot_restaurar "$snap" "$slug"
      echo "✗ Autorização cancelada ou recusada. A configuração anterior foi restaurada."; return 1
    fi
    if ! email_testar_slug "$slug"; then
      email_snapshot_restaurar "$snap" "$slug"
      echo "✗ IMAP/SMTP não foram validados. Nada inválido foi salvo; corrija e tente novamente."; return 1
    fi
  fi
  case ${E[auth]} in
    comando) rm -f "$(email_cred_arq "$slug")" "$SECRETS_DIR/aerc-$slug.client_secret" ;;
    senha) rm -f "$SECRETS_DIR/aerc-$slug.client_secret" ;;
  esac
  rm -rf "$snap"
  tmux kill-session -t "=$EMAIL_SESSAO" 2>/dev/null || true
  # Primeiro espelho em segundo plano, para o maildir já ter conteúdo quando o aerc abrir.
  [[ ${E[sync_local]:-} == 1 && -z ${TT_EMAIL_SEM_REDE:-} ]] && ("$EU" --email-sync "$slug" --completo >/dev/null 2>&1 &)
  return 0
}

email_slugs() { local f; for f in "$EMAIL_DIR"/*.conf; do [[ -e $f ]] && basename "$f" .conf; done; }

# URL do aerc: segurança → esquema; OAuth2 → +xoauth2 e parâmetros para o aerc renovar o token.
# Com sync_local=1, o IMAP de entrada vira um maildir local (espelho mantido pelo mbsync): o aerc lê
# do disco (abertura instantânea, busca local, offline parcial). O envio (smtp) permanece online.
EMAIL_MAILDIR_BASE="$HOME/.cache/tt/maildir"
email_maildir() { echo "$EMAIL_MAILDIR_BASE/$1"; }
email_url() { # imap|smtp
  local t=$1 host porta seg usuario esq q=""
  if [[ $t == imap && ${E[sync_local]:-} == 1 ]]; then printf 'maildir://%s' "$(email_maildir "${E[_slug]}")"; return; fi
  host=${E[${t}_host]}; porta=${E[${t}_porta]}; seg=${E[${t}_seg]:-tls}
  usuario=${E[usuario]:-${E[endereco]}}; usuario=$(email_urlenc "$usuario")
  case $t:$seg in
    imap:tls) esq=imaps ;; imap:starttls) esq=imap ;; imap:*) esq=imap+insecure ;;
    smtp:tls) esq=smtps ;; smtp:starttls) esq=smtp ;; smtp:*) esq=smtp+insecure ;;
  esac
  if [[ ${E[auth]} == oauth ]]; then
    esq+=+xoauth2
    q="?token_endpoint=$(email_urlenc "${E[oauth_token_endpoint]}")&client_id=$(email_urlenc "${E[oauth_client_id]}")"
    [[ -s $SECRETS_DIR/aerc-${E[_slug]}.client_secret ]] && q+="&client_secret=$(email_urlenc "$(cat "$SECRETS_DIR/aerc-${E[_slug]}.client_secret")")"
    [[ -n ${E[oauth_scope]} ]] && q+="&scope=$(email_urlenc "${E[oauth_scope]}")"
  fi
  printf '%s://%s@%s:%s%s' "$esq" "$usuario" "$host" "$porta" "$q"
}
email_urlenc() { python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1"; }

email_bloco() {
  local cred; cred=$(email_cred_arq "${E[_slug]}")
  local cmd; if [[ ${E[auth]} == comando ]]; then cmd=${E[cred_cmd]}; else cmd="cat $(printf %q "$cred")"; fi
  echo "# >>> tt e-mail: ${E[_slug]} >>>"
  printf '[%s]\n' "${E[nome]}"
  printf 'source            = %s\n' "$(email_url imap)"
  # Entrada por maildir (sync_local) não autentica: o mbsync é quem fala IMAP. Só o envio usa a credencial.
  [[ ${E[sync_local]:-} == 1 ]] || printf 'source-cred-cmd   = %s\n' "$cmd"
  printf 'outgoing          = %s\n' "$(email_url smtp)"
  printf 'outgoing-cred-cmd = %s\n' "$cmd"
  if [[ -n ${E[nome_exibicao]:-} ]]; then printf 'from              = %s <%s>\n' "${E[nome_exibicao]}" "${E[endereco]}"
  else printf 'from              = %s\n' "${E[endereco]}"; fi
  printf 'default           = %s\n' "${E[pasta]:-INBOX}"
  # Pastas: a pasta-mãe que não abre (ex.: [Gmail]) sai da lista e as de dentro sobem para o 1º
  # nível; arquivar e rascunhos vão para as pastas especiais que o servidor indicou (o nome muda
  # com o idioma da conta). O Gmail guarda sozinho o que se envia: sem copy-to (duplicaria).
  local mae=${E[pasta_naoabre]:-} gmail=""; [[ ${E[imap_host]} == imap.gmail.com ]] && gmail=1
  if [[ -n $mae ]]; then
    printf '%s = %s/*\n' '*' "$mae" >"$AERC_DIR/tt-pastas-${E[_slug]}.map"
    printf 'folder-map        = %s\n' "$AERC_DIR/tt-pastas-${E[_slug]}.map"
    printf 'folders-exclude   = %s\n' "$mae"
  fi
  local pt; for pt in todos:archive rascunhos:postpone; do
    local v=${E[pasta_${pt%%:*}]:-}; [[ -n $v ]] || continue
    [[ -n $mae ]] && v=${v#"$mae"/}
    printf '%-17s = %s\n' "${pt#*:}" "$v"
  done
  if [[ -z $gmail && -n ${E[pasta_enviados]:-} ]]; then
    local v=${E[pasta_enviados]}; [[ -n $mae ]] && v=${v#"$mae"/}; printf 'copy-to           = %s\n' "$v"
  fi
  # Assinatura da conta (arquivo do tt), a não ser que o dono já tenha a dele nas linhas extras.
  local ass i; ass=$(email_assinatura_arq "${E[_slug]}")
  if [[ -s $ass ]]; then
    for i in 1 2 3 4 5 6 7 8; do [[ ${E[extra_$i]:-} =~ ^[[:space:]]*signature- ]] && ass=""; done
    [[ -n $ass ]] && printf 'signature-file    = %s\n' "$ass"
  fi
  for i in 1 2 3 4 5 6 7 8; do
    [[ -n ${E[extra_$i]:-} ]] || continue
    # chaves que o tt agora define (ou que não valem para o Gmail) não são repetidas
    if [[ ${E[extra_$i]} =~ ^[[:space:]]*([a-z-]+)[[:space:]]*= ]]; then
      case ${BASH_REMATCH[1]} in
        copy-to) [[ -n $gmail || -n ${E[pasta_enviados]:-} ]] && continue ;;
        archive) [[ -n ${E[pasta_todos]:-} ]] && continue ;;
        postpone) [[ -n ${E[pasta_rascunhos]:-} ]] && continue ;;
        folder-map|folders-exclude) [[ -n $mae ]] && continue ;;
      esac
    fi
    printf '%s\n' "${E[extra_$i]}"
  done
  echo "# <<< tt e-mail: ${E[_slug]} <<<"
}

# Regrava o bloco gerenciado da conta SLUG (ou o remove, com "remover") no accounts.conf.
email_regerar() {
  local slug=$1 modo=${2:-} tmp
  mkdir -p "$AERC_DIR"; [[ -f $AERC_CONTAS ]] || : >"$AERC_CONTAS"; chmod 600 "$AERC_CONTAS" 2>/dev/null
  tmp=$(mktemp) || return 1
  awk -v i="# >>> tt e-mail: $slug >>>" -v f="# <<< tt e-mail: $slug <<<" '$0 == i { p = 1 } !p { print } $0 == f { p = 0 }' "$AERC_CONTAS" >"$tmp"
  if [[ $modo != remover ]]; then
    [[ -s $tmp && $(tail -c1 "$tmp" | od -An -c | tr -d ' ') != '\n' ]] && echo >>"$tmp"
    email_bloco >>"$tmp"
  fi
  cat "$tmp" >"$AERC_CONTAS"; rm -f "$tmp"
  # Os binds por conta (apagar/arquivar certos no Gmail) acompanham o cadastro.
  aerc_binds_gravar 2>/dev/null || true
  # O .mbsyncrc acompanha a conta: criado/atualizado quando sync_local=1, removido caso contrário.
  email_mbsyncrc_gerar "$modo"
}

# Liga/desliga o sync local de uma conta já cadastrada (tt --email-sync-local CONTA 0|1; é o que
# o botão 🔄 da tela de contas chama). Desligar volta o aerc ao IMAP direto e remove o .mbsyncrc;
# o maildir fica (nada é apagado; religar só retoma).
email_sync_local_definir() {
  local slug valor=$2; local -A E=()
  slug=$(email_achar "$1") || { echo "Conta não encontrada: $1"; return 1; }
  email_ler "$slug" || return 1
  if [[ $valor == 1 ]]; then
    command -v "$(mbsync_bin)" >/dev/null || { echo "✗ Sync local pede o mbsync (isync) instalado."; return 1; }
    E[sync_local]=1
  else
    E[sync_local]=
  fi
  email_gravar && email_regerar "$slug" || return 1
  if [[ $valor == 1 ]]; then
    echo "✓ Sync local ligado em $slug; primeira sincronização em segundo plano."
    [[ -n ${TT_EMAIL_SEM_REDE:-} ]] || ("$EU" --email-sync "$slug" --completo >/dev/null 2>&1 &)
  else
    echo "✓ Sync local desligado em $slug; o aerc volta a ler direto do servidor."
  fi
}

# ---- Sync local opcional (mbsync/isync) --------------------------------------------------------
#
# Opt-in estrito por conta (sync_local=1): o mbsync espelha o IMAP num maildir em
# ~/.cache/tt/maildir/<slug> e o aerc lê de lá (abertura instantânea, busca local, offline
# parcial). O envio continua pelo SMTP online. Desligado por padrão; sem o flag, nada muda
# (a conta segue com source=imaps:// e o cache-headers do aerc). As flags (lido, arquivado,
# apagado) e a chegada de mensagens novas sobem/descem no próximo sync (vigia ou --email-sync).
EMAIL_MBSYNC_DIR="$CONF_DIR/mbsync"
email_mbsyncrc() { echo "$EMAIL_MBSYNC_DIR/$1.mbsyncrc"; }
# O executável do mbsync (TT_MBSYNC troca, para os testes simularem uma máquina sem ele).
mbsync_bin() { echo "${TT_MBSYNC:-mbsync}"; }
# A chave do modo TLS no .mbsyncrc: o isync 1.5 renomeou SSLType para TLSType (a antiga ainda vale,
# com um aviso a cada rodada); versões anteriores só conhecem SSLType.
mbsync_chave_tls() {
  local v; v=$("$(mbsync_bin)" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+' | head -1)
  [[ -n $v && ${v%%.*} -ge 1 && ${v#*.} -ge 5 ]] && echo TLSType || echo SSLType
}

# PassCmd do mbsync para a conta em E: senha de app (arquivo em ~/.secrets), comando externo do
# usuário, ou, no OAuth2, o access token renovado pelo email-tt.py. Nunca grava o segredo no .mbsyncrc.
email_mbsync_passcmd() {
  local slug=${E[_slug]} conf; conf=$(email_conf_arq "$slug")
  case ${E[auth]} in
    comando) printf '%s' "${E[cred_cmd]}" ;;
    oauth)   printf 'python3 %s oauth-token %s' "$(printf %q "$EMAIL_PY")" "$(printf %q "$conf")" ;;
    *)       printf 'cat %s' "$(printf %q "$(email_cred_arq "$slug")")" ;;
  esac
}

# Quantas mensagens do "Todos os e-mails" (o arquivo do Gmail) ficam no espelho local.
EMAIL_ARQUIVO_MAX=${TT_EMAIL_ARQUIVO_MAX:-500}

# Gera (ou remove, com "remover") o ~/.config/tt/mbsync/<slug>.mbsyncrc da conta em E. O arquivo não
# tem segredo: a senha vem por PassCmd em tempo de execução. Três canais e um grupo:
#   <slug>-inbox    só o INBOX — leva segundos; é o que o vigia roda a cada TT_EMAIL_SYNC;
#   <slug>-pastas   as outras pastas, SEM as pastas-rótulo do Gmail (Todos os e-mails, Importantes e
#                   Com estrela são visões do que já está nas demais; baixá-las duplicava tudo, e a
#                   volta inteira nunca cabia no tempo);
#   <slug>-arquivo  o "Todos os e-mails" (destino do arquivar), só as últimas EMAIL_ARQUIVO_MAX
#                   mensagens no espelho (MaxMessages/ExpireUnread só podam o lado local; o servidor
#                   segue com tudo);
#   Group <slug>    os três: a volta completa (TT_EMAIL_SYNC_COMPLETO) e `mbsync <slug>`.
# Os nomes especiais vêm das marcas do servidor (pasta_*), então valem em qualquer idioma; sem elas
# (conta antiga, ainda sem descobrir), fica só INBOX + pastas.
email_mbsyncrc_gerar() {
  local slug=${E[_slug]} modo=${1:-} rc; rc=$(email_mbsyncrc "$slug")
  if [[ $modo == remover || ${E[sync_local]:-} != 1 ]]; then rm -f "${rc:?}"; return 0; fi
  mkdir -p "$EMAIL_MBSYNC_DIR"; chmod 700 "$EMAIL_MBSYNC_DIR" 2>/dev/null
  local host=${E[imap_host]} porta=${E[imap_porta]:-993} seg=${E[imap_seg]:-tls}
  local usuario=${E[usuario]:-${E[endereco]}} maildir; maildir=$(email_maildir "$slug")
  local sslt="IMAPS"; case $seg in starttls) sslt="STARTTLS" ;; nenhuma) sslt="None" ;; esac
  local authmech=""; [[ ${E[auth]} == oauth ]] && authmech=$'AuthMechs XOAUTH2\n'
  local todos=${E[pasta_todos]:-} fora="" p canais="$slug-inbox $slug-pastas"
  for p in "$todos" "${E[pasta_importantes]:-}" "${E[pasta_estrela]:-}"; do [[ -n $p && $p != INBOX ]] && fora+=" \"!$p\""; done
  [[ -n $todos && $todos != INBOX ]] && canais+=" $slug-arquivo"
  mkdir -p "$maildir"
  { printf 'IMAPAccount %s\n' "$slug"
    printf 'Host %s\n' "$host"
    printf 'Port %s\n' "$porta"
    printf 'User %s\n' "$usuario"
    printf 'PassCmd "%s"\n' "$(email_mbsync_passcmd)"
    printf '%s' "$authmech"
    printf '%s %s\n' "$(mbsync_chave_tls)" "$sslt"
    # O Gmail às vezes demora mais que os 20 s padrão para responder (autenticação, pastas grandes);
    # sem isto a rodada morria em "Socket error: timeout" já perto do fim.
    printf 'Timeout 60\n'
    printf '\n'
    printf 'IMAPStore %s-remote\n' "$slug"
    printf 'Account %s\n' "$slug"
    printf '\n'
    printf 'MaildirStore %s-local\n' "$slug"
    printf 'Path %s/\n' "$maildir"
    printf 'Inbox %s/INBOX\n' "$maildir"
    printf 'SubFolders Verbatim\n'
    printf '\n'
    printf '# Só o INBOX: o canal rápido (o vigia roda a cada TT_EMAIL_SYNC segundos)\n'
    printf 'Channel %s-inbox\n' "$slug"
    printf 'Far :%s-remote:INBOX\n' "$slug"
    printf 'Near :%s-local:INBOX\n' "$slug"
    printf 'Create Both\nExpunge Both\nSyncState *\n\n'
    printf '# As outras pastas, sem as pastas-rótulo (visões do que já está nas demais)\n'
    printf 'Channel %s-pastas\n' "$slug"
    printf 'Far :%s-remote:\n' "$slug"
    printf 'Near :%s-local:\n' "$slug"
    printf 'Patterns * !INBOX%s\n' "$fora"
    printf 'Create Both\nExpunge Both\nSyncState *\n\n'
    if [[ -n $todos && $todos != INBOX ]]; then
      printf '# O arquivo (destino do arquivar): só as últimas %s mensagens no espelho; o resto fica no servidor\n' "$EMAIL_ARQUIVO_MAX"
      printf 'Channel %s-arquivo\n' "$slug"
      printf 'Far ":%s-remote:%s"\n' "$slug" "$todos"
      printf 'Near ":%s-local:%s"\n' "$slug" "$todos"
      printf 'MaxMessages %s\nExpireUnread yes\n' "$EMAIL_ARQUIVO_MAX"
      printf 'Create Both\nExpunge Both\nSyncState *\n\n'
    fi
    printf '# A volta completa: mbsync %s\n' "$slug"
    printf 'Group %s\n' "$slug"
    printf 'Channels %s\n' "$canais"; } >"$rc.tmp" && mv "$rc.tmp" "$rc"
  chmod 600 "$rc" 2>/dev/null
}

# Migra os .mbsyncrc do formato antigo (um canal só, Patterns *, ou sem Timeout) para o atual. A
# instalação chama; idempotente. Os .mbsyncstate das pastas continuam válidos (mesmos caminhos),
# então nada é baixado de novo. Conta antiga sem as pastas especiais no .conf: descobre em segundo
# plano (tt --email-pastas) e regrava.
email_mbsyncrc_migrar() {
  local slug rc; local -A E=()
  for slug in $(email_slugs); do
    rc=$(email_mbsyncrc "$slug"); [[ -f $rc ]] || continue
    # (rc em canais gerado antes da v202 ficou sem "Timeout 60": no padrão de 20 s o login lento
    # do Gmail estourava e a rodada falhava — era o grosso do ⚠ na barra)
    grep -q "^Group $slug\$" "$rc" && grep -q '^Timeout ' "$rc" && continue
    E=(); email_ler "$slug" || continue
    [[ ${E[sync_local]:-} == 1 ]] || continue
    email_mbsyncrc_gerar
    [[ -z ${E[pasta_importantes]:-} && -z ${TT_EMAIL_SEM_REDE:-} ]] && ("$EU" --email-pastas "$slug" >/dev/null 2>&1 &)
  done
  return 0
}

# Roda o mbsync de uma conta: MODO "inbox" (só o INBOX — segundos; teto 240 s, e a trava impede
# que a rodada seguinte comece antes de esta acabar) ou "completo" (o grupo inteiro; teto
# TT_EMAIL_SYNC_TETO=600 s). Trava por conta (nunca duas ao mesmo tempo).
# Registra cada rodada em $ESTADO_DIR/email-sync/<slug> (modo, início, fim, código; últimas 200) e
# as últimas linhas de erro em <slug>.erro — é o que --email-sync-estado e a barra leem. Silencioso.
# Rodada que encontra a trava ocupada (a volta completa segurando o INBOX) fica registrada como
# "pulada": não é parada. Depois de um erro a conta espera mais (<slug>.espera: 2×, 4×… o intervalo,
# até 15 min; zera no 1º sucesso) — o Gmail responde devagar quando é muito procurado (4 aparelhos
# na mesma conta), e insistir piorava. Só o vigia (QUEM=vigia) respeita a espera; à mão, sincroniza já.
email_sync() { # slug [inbox|completo] [vigia]
  local slug=${1:?} modo=${2:-inbox} quem=${3:-} rc lock dir alvo teto ini fim st agora k esp base
  rc=$(email_mbsyncrc "$slug")
  command -v "$(mbsync_bin)" >/dev/null || return 0
  [[ -f $rc ]] || return 0
  dir="${ESTADO_DIR:?}/email-sync"; mkdir -p "$dir"; agora=$(date +%s)
  [[ $quem == vigia ]] && ((agora < $(cat "$dir/$slug.espera" 2>/dev/null || echo 0))) && return 0
  lock="$EMAIL_MBSYNC_DIR/$slug.lock"
  exec 9>"$lock" 2>/dev/null || return 0
  if ! flock -n 9; then   # já há um sync desta conta em curso
    printf 'pulada\t%s\t%s\t0\n' "$agora" "$agora" >>"$dir/$slug"; return 0
  fi
  if [[ $modo == completo ]]; then alvo=$slug; teto=${TT_EMAIL_SYNC_TETO:-600}
  else alvo="$slug-inbox"; teto=${TT_EMAIL_SYNC_TETO_INBOX:-240}; grep -q "^Channel $slug-inbox\$" "$rc" || alvo=$slug; fi   # rc antigo: canal único
  ini=$(date +%s); printf '%s\t%s\n' "$modo" "$ini" >"$dir/$slug.andamento"
  timeout "$teto" "$(mbsync_bin)" -c "$rc" "$alvo" >/dev/null 2>"$dir/$slug.erro.tmp"; st=$?
  fim=$(date +%s)
  # Volta completa derrubada pelo ⟳ sincronizar agora (marca de email_sync_manual, ou morte por
  # SIGTERM): não é erro — fica registrada como "interrompida", sem .erro nem espera; o vigia a
  # refaz na próxima vez, e o INBOX que o dono pediu vem logo em seguida (é ele quem avisa).
  if [[ $modo == completo && $st != 0 ]] && { [[ -e $dir/$slug.interrompida ]] || ((st == 15 || st == 143)); }; then
    rm -f "${dir:?}/${slug:?}.interrompida" "${dir:?}/${slug:?}.erro.tmp" "${dir:?}/${slug:?}.andamento"
    printf 'interrompida\t%s\t%s\t%s\n' "$ini" "$fim" "$st" >>"$dir/$slug"
    tail -n 200 "$dir/$slug" >"$dir/$slug.tmp" 2>/dev/null && mv "$dir/$slug.tmp" "$dir/$slug"
    return 0
  fi
  printf '%s\t%s\t%s\t%s\n' "$modo" "$ini" "$fim" "$st" >>"$dir/$slug"
  tail -n 200 "$dir/$slug" >"$dir/$slug.tmp" 2>/dev/null && mv "$dir/$slug.tmp" "$dir/$slug"
  if ((st == 0)); then rm -f "${dir:?}/${slug:?}.erro" "${dir:?}/${slug:?}.erro.tmp" "${dir:?}/${slug:?}.espera" "${dir:?}/${slug:?}.falhas"
  else
    { ((st == 124)) && echo "tempo esgotado ($teto s)"; tail -n 5 "$dir/$slug.erro.tmp" 2>/dev/null; } >"$dir/$slug.erro"; rm -f "${dir:?}/${slug:?}.erro.tmp"
    # Volta completa que só estourou o teto (caixa grande, 1ª vez) não é o Gmail recusando: não
    # empurra o INBOX para a espera.
    if [[ $modo != completo || $st != 124 ]]; then
      k=$(( $(cat "$dir/$slug.falhas" 2>/dev/null || echo 0) + 1 )); echo "$k" >"$dir/$slug.falhas"
      base=${TT_EMAIL_SYNC:-120}; ((base > 0)) || base=120
      esp=$((base << (k < 4 ? k : 4))); ((esp > 900)) && esp=900
      echo $((fim + esp)) >"$dir/$slug.espera"
    fi
  fi
  rm -f "${dir:?}/${slug:?}.andamento"
  email_novos_avisar "$slug"
  atualizar_barras 2>/dev/null
  # Volta completa boa: refaz o índice de destinatários (quem já escreveu / para quem já se escreveu).
  [[ $modo == completo && $st == 0 ]] && email_contatos_indexar
  return $st
}

# Depois de uma rodada: avisa dos e-mails que CHEGARAM no INBOX — na tela de cada terminal aberto e
# na notificação do sistema. "Chegou" = mensagem não lida cujo identificador (a parte do nome do
# arquivo antes de ":2,") não existia na rodada anterior; o conjunto anterior fica em
# email-sync/<slug>.vistas. Assim funciona com o aerc aberto (que move new/ → cur/ na hora) ou
# fechado. Na primeira rodada só memoriza (senão avisaria a caixa inteira). Até 3 remetentes e
# assuntos; o resto vira "e mais N". email_aviso=0 no ~/.config/tt/config desliga.
email_novos_avisar() { # slug
  local slug=${1:?} md dir vistas novas u arq n=0 corpo="" de assunto nome
  [[ $(conf email_aviso) == 0 ]] && return 0
  md=$(email_maildir "$slug")/INBOX; dir="$ESTADO_DIR/email-sync"; vistas="$dir/$slug.vistas"
  [[ -d $md/new || -d $md/cur ]] || return 0
  mkdir -p "$dir"
  local todas; todas=$(find "$md/new" "$md/cur" -type f -printf '%f\n' 2>/dev/null | sed 's/:2,.*//' | sort -u)
  if [[ ! -f $vistas ]]; then printf '%s\n' "$todas" >"$vistas"; return 0; fi
  # não lidas agora: tudo em new/ e, em cur/, o que não tem a marca S
  novas=$(comm -13 <(sort -u "$vistas") <(find "$md/new" "$md/cur" -type f \( -path '*/new/*' -o ! -name '*:2,*S*' \) -printf '%f\n' 2>/dev/null | sed 's/:2,.*//' | sort -u))
  printf '%s\n' "$todas" >"$vistas.tmp" && mv "$vistas.tmp" "$vistas"
  [[ -n $novas ]] || return 0
  while IFS= read -r u; do
    [[ -n $u ]] || continue
    n=$((n + 1)); ((n <= 3)) || continue
    arq=$(find "$md/new" "$md/cur" -type f -name "$u*" 2>/dev/null | head -1)
    IFS=$'\t' read -r de assunto < <(python3 -I "$EMAIL_PY" cabecalho "$arq" 2>/dev/null)
    corpo+="${corpo:+ · }${de:-?} — ${assunto:-(sem assunto)}"
  done <<<"$novas"
  ((n > 3)) && corpo+=" · e mais $((n - 3))"
  local -A E=(); email_ler "$slug" 2>/dev/null; nome=${E[nome]:-$slug}
  # ação email:SLUG: o clique no aviso vai à conta e à mensagem nova (email_ir_novo)
  tarefas_notificar "📧 $nome: $n e-mail$( ((n > 1)) && echo s) novo$( ((n > 1)) && echo s)" "$corpo" "email:$slug"
  return 0
}

# ⟳ Sincronizar agora (botão do popup, Ctrl+s no aerc, item do menu do 📧, tt --email-sync-agora
# [cliente]): consulta o INBOX de todas as contas com espelho, já — sem esperar a vez do vigia nem
# a espera que ele faz depois de um erro (quem está esperando um código com validade não pode
# esperar). As contas vão em paralelo. Retorno: o botão mostra "consultando…" e depois "✓ N
# novos" por uns segundos (@tt_email_sync na sessão oculta), a mensagem na tela do cliente que pediu
# e, se chegou algo, o aviso de e-mail novo (email_novos_avisar, dentro de cada rodada). No fim,
# F11 (:check-mail) ao aerc, para as contas só IMAP conferirem também.
email_sync_agora() { # [cliente]
  local c=${1:-} s n0=0 n1=0 novos msg curta falhas="" pid; local -a slugs=() pids=() nomes=(); local -A E=()
  for s in $(email_slugs 2>/dev/null); do
    E=(); email_ler "$s" 2>/dev/null || continue
    [[ ${E[sync_local]:-} == 1 ]] || continue
    slugs+=("$s"); nomes+=("${E[nome]}")
  done
  if ((${#slugs[@]} == 0)); then
    msg="📧 nenhuma conta com espelho local: o aerc lê direto do servidor (F2 → conta → 🔄 liga o espelho)"
    email_avisar_cliente "$c" 4000 "$msg"
    email_aerc_conferir; echo "$msg"; return 0
  fi
  tmux set -q -t "=$EMAIL_SESSAO:" @tt_email_sync 'consultando…' 2>/dev/null || true
  email_avisar_cliente "$c" 1500 '📧 consultando as contas…'
  command -v "$(mbsync_bin)" >/dev/null || { msg="✗ sem o mbsync (isync) não há como consultar"; tmux set -q -t "=$EMAIL_SESSAO:" @tt_email_sync '' 2>/dev/null; echo "$msg"; return 1; }
  for s in "${slugs[@]}"; do n0=$((n0 + $(email_nao_lidas_inbox "$s"))); done
  for s in "${slugs[@]}"; do email_sync_manual "$s" & pids+=($!); done
  local i=0; for pid in "${pids[@]}"; do wait "$pid" || falhas+="${falhas:+, }${nomes[$i]}"; i=$((i + 1)); done
  for s in "${slugs[@]}"; do n1=$((n1 + $(email_nao_lidas_inbox "$s"))); done
  novos=$((n1 - n0)); ((novos < 0)) && novos=0
  if [[ -n $falhas ]]; then msg="✗ não consegui consultar: $falhas (botão direito no 📧 → Sync local: estado)"; curta="✗ falhou"
  elif ((novos > 0)); then msg="✓ caixa de entrada atualizada: $novos novo$( ((novos > 1)) && echo s)"; curta="✓ $novos novo$( ((novos > 1)) && echo s)"
  else msg="✓ caixa de entrada atualizada: nada novo"; curta="✓ nada novo"; fi
  email_aerc_conferir
  tmux set -q -t "=$EMAIL_SESSAO:" @tt_email_sync "$curta" 2>/dev/null || true
  # (só apaga o que ela mesma pôs: uma consulta seguinte pode já ter escrito outro resultado)
  # (stdio solto: senão quem capturou a saída — $(…), o :exec do aerc — esperaria os 6 s)
  ( sleep 6; [[ $(tmux show -qv -t "=$EMAIL_SESSAO:" @tt_email_sync 2>/dev/null) == "$curta" ]] && tmux set -q -t "=$EMAIL_SESSAO:" @tt_email_sync '' 2>/dev/null ) >/dev/null 2>&1 </dev/null &
  email_avisar_cliente "$c" 4000 "📧 $msg"
  echo "$msg"
  [[ -z $falhas ]]
}
# Mensagem na tela do cliente que pediu (nenhum cliente, ou um que já se foi: nada acontece).
email_avisar_cliente() { # cliente ms texto
  [[ -n $1 ]] || return 0
  tmux display-message -c "$1" -d "$2" "$3" 2>/dev/null || true
}
# F11 (:check-mail) ao aerc da sessão oculta — só com o aerc na frente (uma tela do tt aberta não recebe).
email_aerc_conferir() {
  tmux has-session -t "=$EMAIL_SESSAO" 2>/dev/null || return 0
  [[ -z $(tmux show -wqv -t "=$EMAIL_SESSAO:" @tt_email_tela 2>/dev/null) ]] && tmux send-keys -t "=$EMAIL_SESSAO:" F11 2>/dev/null
  return 0
}

# ─── Abrir pelo aviso: ir à mensagem nova ────────────────────────────────────
#
# O clique no aviso "📧 Conta: N e-mails novos" (ação email:SLUG → notif_abrir) e tt --email-ir-novo
# SLUG [cliente]: em vez de reabrir o popup como ficou (mensagem velha aberta, outra conta), vai à
# conta do aviso, ao INBOX dela, e foca a não lida mais recente. Tudo por comandos ao aerc pelo
# IPC (`aerc :comando` fala com a instância da sessão oculta; o socket fica em
# $XDG_RUNTIME_DIR/aerc.sock) — nunca teclas cegas: :change-tab é global e vale com compose ou
# terminal na frente (eles ficam na aba deles); :cf e :search só depois dele. Conferido com o aerc
# 0.21 real: :select 0 + :search -u foca a não lida mais recente, mesmo dentro de uma conversa, e
# sem não lida fica no topo; :clear logo depois desfaz a seleção (por isso não vem). Na tela
# estreita (sem prévia) abre a mensagem (:view). No fim, :check-mail. Sem IPC (aerc antigo, -I,
# socket ausente) abre como sempre. Sessão oculta ainda não existe: abre o popup e salta assim que
# o aerc subir. Os avisos dessa conta ficam marcados como lidos (<id>.lida na central).
email_ipc_socket() { printf '%s/aerc.sock' "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"; }
# Um comando ao aerc da sessão oculta. Falha sem instância (socket ou aerc ausentes) ou quando o
# aerc responde erro ("response: …"). O aerc sem instância abriria a interface aqui: por isso a
# guarda antes, e o timeout.
email_ipc() { # :comando [argumentos…]
  local out
  [[ -S $(email_ipc_socket) ]] || return 1
  tmux list-panes -s -t "=$EMAIL_SESSAO" -F '#{pane_current_command}' 2>/dev/null | grep -q '^aerc' || return 1
  out=$(timeout 5 aerc "$@" 2>/dev/null </dev/null) || return 1
  ! grep -q '^response:' <<<"$out"
}
# Vai à conta (nome no aerc), ao INBOX e à não lida mais recente. ESPERA (s) entre a troca de aba e
# o resto, para a lista carregar (aerc recém-aberto).
email_saltar_novo() { # nome-da-conta [espera]
  local nome=$1 espera=${2:-0.3}
  email_ipc :change-tab "$nome" || return 1
  email_ipc :cf INBOX; sleep "$espera"
  email_ipc :select 0; email_ipc ':search -u'
  [[ $(tmux show -qv -t "=$EMAIL_SESSAO:" @tt_email_modo 2>/dev/null) == estreito ]] && email_ipc :view
  email_ipc :check-mail
  return 0
}
# Marca como lidos os avisos com a ação dada (<id>.lida ao lado do arquivo do aviso): abrir a
# mensagem por aqui vale como ler o aviso na central.
email_avisos_lidos() { # ação (email:SLUG)
  local f exp txt acao n=""
  for f in $(ls -1 "$DIR_NOTIFS" 2>/dev/null); do
    [[ $f == *.lida ]] && continue
    IFS=$'\t' read -r exp txt acao <"$DIR_NOTIFS/$f" || continue
    [[ $acao == "$1" && ! -f $DIR_NOTIFS/$f.lida ]] && { : >"$DIR_NOTIFS/$f.lida"; n=1; }
  done
  [[ -n $n ]] && atualizar_barras >/dev/null 2>&1   # a central deixa de mostrá-los em negrito
  return 0
}
email_ir_novo() { # slug [cliente]
  local slug=$1 c=${2:-} nome=""; local -A E=()
  [[ -n $c ]] || c=$(tmux display-message -p '#{client_name}' 2>/dev/null)
  email_avisos_lidos "email:$slug"
  email_ler "$slug" 2>/dev/null && nome=${E[nome]:-}
  if [[ -n $nome ]]; then
    if tmux has-session -t "=$EMAIL_SESSAO" 2>/dev/null; then
      email_tela_fechar
      email_saltar_novo "$nome"
    else
      # o popup abre a sessão oculta (botao_email); o salto vai assim que o aerc subir o IPC
      ( for ((i = 0; i < 40; i++)); do sleep 0.5; email_saltar_novo "$nome" 2 && break; done ) >/dev/null 2>&1 </dev/null &
    fi
  fi
  [[ -n ${TT_EMAIL_SEM_POPUP:-} ]] && return 0   # testes: só o salto e a marca
  botao_email "$c"
}
# Uma conta, à mão: se a trava está com outra rodada, espera um pouco; se é a volta completa
# (minutos) segurando a trava, derruba o mbsync dela — o vigia refaz a completa na próxima vez,
# e o INBOX de agora vale mais. Devolve o código da rodada.
email_sync_manual() { # slug
  local slug=$1 lock rc m
  lock="$EMAIL_MBSYNC_DIR/$slug.lock"; rc=$(email_mbsyncrc "$slug")
  [[ -f $rc ]] || return 0
  if [[ -e $lock ]] && ! flock -n -w 0 "$lock" true 2>/dev/null; then
    if ! flock -w 20 "$lock" true 2>/dev/null; then
      read -r m _ <"$ESTADO_DIR/email-sync/$slug.andamento" 2>/dev/null
      if [[ ${m:-} == completo ]]; then
        # (a marca diz à rodada derrubada que ela foi interrompida de propósito, não que falhou)
        touch "$ESTADO_DIR/email-sync/$slug.interrompida" 2>/dev/null
        pkill -f "mbsync -c $rc " 2>/dev/null
        flock -w 30 "$lock" true 2>/dev/null || { rm -f "$ESTADO_DIR/email-sync/$slug.interrompida"; return 1; }
        rm -f "$ESTADO_DIR/email-sync/$slug.interrompida" # (se ninguém a consumiu)
      else flock -w 120 "$lock" true 2>/dev/null || return 1; fi
    fi
  fi
  email_sync "$slug" inbox
}
# Não lidas do INBOX de uma conta com espelho: new/ e, em cur/, sem a marca S.
email_nao_lidas_inbox() { # slug
  local md; md=$(email_maildir "$1")/INBOX
  [[ -d $md ]] || { echo 0; return 0; }
  echo $(( $(find "$md/new" -type f 2>/dev/null | wc -l) + $(find "$md/cur" -type f ! -name '*:2,*S*' 2>/dev/null | wc -l) ))
}

# Botão 📧 da barra (vai para @barra_email; recalculado por atualizar_barras — a barra não roda
# processo): as não lidas do INBOX das contas com espelho local, lidas do próprio maildir (new/ e,
# em cur/, sem a marca S), e o estado do sync — vermelho com ⚠ quando alguma conta está com erro
# persistente ou parada, âmbar com ⏳ quando só atrasou (--email-sync-estado conta o resto). Contas só IMAP não entram na soma (sem abrir o
# aerc não há como saber). Em tela estreita (< 90) some a palavra "email", como antes.
barra_email_fmt() {
  local n=0 alerta="" slug est md; local -A E=()
  for slug in $(email_slugs 2>/dev/null); do
    E=(); email_ler "$slug" 2>/dev/null || continue
    [[ ${E[sync_local]:-} == 1 ]] || continue
    md=$(email_maildir "$slug")/INBOX
    [[ -d $md ]] || continue
    n=$((n + $(find "$md/new" -type f 2>/dev/null | wc -l) + $(find "$md/cur" -type f ! -name '*:2,*S*' 2>/dev/null | wc -l)))
  done
  local atraso=""
  while IFS=$'\t' read -r slug est; do
    [[ $est == erro || $est == parado ]] && alerta=1
    [[ $est == atrasado ]] && atraso=1
  done < <(email_sync_estado curto 2>/dev/null)
  # Contagem entre parênteses e sem rótulo: "📧 (896)" (pedido do dono; mais limpo que "896 email").
  # Vermelho ⚠ só para problema que persiste; falha passageira (o Gmail lento) fica âmbar ⏳.
  if [[ -n $alerta ]]; then printf '#[fg=#1e1e2e,bg=#f38ba8,bold] 📧%s ⚠ ' "$( ((n > 0)) && echo " ($n)")"
  elif [[ -n $atraso ]]; then printf '#[fg=#1e1e2e,bg=#fab387,bold] 📧%s ⏳ ' "$( ((n > 0)) && echo " ($n)")"
  elif ((n > 0)); then printf '#[fg=#1e1e2e,bg=#f9e2af,bold] 📧 (%s) ' "$n"
  else printf '#[fg=#cdd6f4,bg=#45475a] 📧 '; fi
}

# Fim da volta completa mais antiga entre as contas com sync_local=1 (0 se alguma nunca fez): o vigia
# parte daqui, em vez de refazer a volta completa a cada reinício.
email_ultima_completa() {
  local slug f m=""; local -A E=()
  for slug in $(email_slugs 2>/dev/null); do
    E=(); email_ler "$slug" 2>/dev/null || continue
    [[ ${E[sync_local]:-} == 1 ]] || continue
    f=$(awk -F'\t' '$1 == "completo" { f = $3 } END { print f + 0 }' "$ESTADO_DIR/email-sync/$slug" 2>/dev/null); f=${f:-0}
    if [[ -z $m ]] || ((f < m)); then m=$f; fi
  done
  echo "${m:-0}"
}

# Algum terminal (cliente tmux) foi usado desde EPOCH?
cliente_ativo_desde() { tmux list-clients -F '#{client_activity}' 2>/dev/null | awk -v t="$1" '$1 >= t { a = 1 } END { exit !a }'; }

# Intervalo do INBOX em uso pelo vigia (para --email-sync-estado julgar "parado" com a régua certa).
email_intervalo_gravar() { mkdir -p "$ESTADO_DIR/email-sync" && echo "$1" >"$ESTADO_DIR/email-sync/.intervalo"; }

# Sincroniza todas as contas com sync_local=1 (vigia e --email-sync sem NOME), no MODO dado.
email_sync_todas() { # [inbox|completo] [vigia]
  local slug; local -A E=()
  for slug in $(email_slugs); do
    E=(); email_ler "$slug" || continue
    [[ ${E[sync_local]:-} == 1 ]] && email_sync "$slug" "${1:-inbox}" "${2:-}"
  done
  return 0
}

# Estado do sync local por conta (tt --email-sync-estado): a última rodada de cada modo, há quanto
# tempo, duração, se deu certo, e o erro (se houve). Com "curto": uma palavra por conta, para a barra:
#   ok · nunca · atrasado (falha passageira: 1 ou 2 seguidas, há menos de 10 min do último INBOX bom)
#   erro (persistente: 3 falhas seguidas, mais de 10 min sem INBOX bom, ou senha recusada — na hora)
#   parado (nenhuma rodada há mais de 3 intervalos; não conta rodada em andamento, rodada pulada pela
#   trava da volta completa, nem a espera proposital depois de um erro).
# Antes, uma falha só bastava para o vermelho: com o Gmail lento, a barra piscava o dia todo.
EMAIL_ERRO_SENHA='AUTHENTICATIONFAILED|Invalid credentials|login failed|authentication failed|Web login required|Application-specific password|Username and Password not accepted'
email_sync_resumo() { # slug → ok|nunca|atrasado|erro|parado
  local slug=$1 dir="$ESTADO_DIR/email-sync" agora intervalo ultimo st ok seq vivo ini esp
  agora=$(date +%s)
  read -r ultimo st ok seq vivo < <(awk -F'\t' '
    $1 == "inbox" { ultimo = $3; st = $4; if ($4 == 0) { ok = $3; seq = 0 } else seq++ }
    $1 == "completo" && $4 == 0 { ok = $3; seq = 0; st = 0 }   # o grupo inclui o INBOX
    $3 > vivo { vivo = $3 }
    END { printf "%d %d %d %d %d\n", ultimo, st, ok, seq, vivo }' "$dir/$slug" 2>/dev/null)
  if [[ -f $dir/$slug.andamento ]]; then
    read -r _ ini <"$dir/$slug.andamento"
    ((agora - ${ini:-0} < ${TT_EMAIL_SYNC_TETO:-600} + 60)) && vivo=$agora   # andamento velho = processo que morreu
  fi
  if ((${ultimo:-0} == 0 && ${vivo:-0} == 0)); then echo nunca; return; fi
  if ((${st:-0} != 0)); then
    if grep -qiE "$EMAIL_ERRO_SENHA" "$dir/$slug.erro" 2>/dev/null || ((seq >= 3 || (ok > 0 && agora - ok > 600))); then echo erro
    else echo atrasado; fi
    return
  fi
  intervalo=${TT_EMAIL_SYNC:-120}
  if ((intervalo > 0)); then
    intervalo=$(cat "$dir/.intervalo" 2>/dev/null || echo "$intervalo")
    esp=$(cat "$dir/$slug.espera" 2>/dev/null || echo 0)
    if ((agora - vivo > 3 * intervalo + 120 && agora >= esp)); then echo parado; return; fi
  fi
  echo ok
}

email_sync_estado() { # [curto]
  local dir="$ESTADO_DIR/email-sync" slug modo ini fim st agora esp; agora=$(date +%s); local -A E=()
  _dur() { local x=$1; if ((x < 60)); then echo "${x}s"; elif ((x < 3600)); then echo "$((x / 60)) min"; else echo "$((x / 3600)) h $(( (x % 3600) / 60 )) min"; fi; }
  for slug in $(email_slugs); do
    E=(); email_ler "$slug" || continue
    [[ ${E[sync_local]:-} == 1 ]] || continue
    if [[ ${1:-} == curto ]]; then printf '%s\t%s\n' "$slug" "$(email_sync_resumo "$slug")"; continue; fi
    printf '%s (%s)\n' "${E[nome]}" "$slug"
    if [[ -f $dir/$slug.andamento ]]; then read -r modo ini <"$dir/$slug.andamento"; printf '  ⏳ sincronizando agora (%s), há %s\n' "$modo" "$(_dur $((agora - ini)))"; fi
    esp=$(cat "$dir/$slug.espera" 2>/dev/null || echo 0)
    ((esp > agora)) && printf '  ⏸ %s falha(s) seguida(s): o vigia tenta de novo em %s (à mão: tt --email-sync %s)\n' "$(cat "$dir/$slug.falhas" 2>/dev/null || echo 1)" "$(_dur $((esp - agora)))" "$slug"
    for modo in inbox completo; do
      ini=""; fim=""; st=0
      read -r _ ini fim st < <(awk -F'\t' -v m="$modo" '$1 == m' "$dir/$slug" 2>/dev/null | tail -1)
      if [[ -z ${fim:-} ]]; then printf '  %-9s nunca\n' "$modo"; continue; fi
      printf '  %-9s há %s · levou %s · %s\n' "$modo" "$(_dur $((agora - fim)))" "$(_dur $((fim - ini)))" "$( ((st == 0)) && echo ok || echo "✗ erro $st")"
    done
    [[ -s $dir/$slug.erro ]] && sed 's/^/    /' "$dir/$slug.erro"
  done
  return 0
}

# Contas criadas pelo cadastro antigo (Gmail com senha de app, sem marcadores) passam a ser
# gerenciadas: cria o .conf e troca o bloco solto pelo bloco com marcadores.
email_importar_legado() {
  [[ -f $AERC_CONTAS ]] || return 0
  local nome slug end tmp; local -A E=()
  while IFS=$'\t' read -r nome end; do
    slug=$(email_slug "$nome")
    [[ -e $(email_conf_arq "$slug") || ! -f $(email_cred_arq "$slug") ]] && continue
    E=([_slug]=$slug [nome]=$nome [endereco]=$end [provedor]=gmail [auth]=senha [imap_host]=imap.gmail.com [imap_porta]=993
       [imap_seg]=tls [smtp_host]=smtp.gmail.com [smtp_porta]=465 [smtp_seg]=tls [pasta]=INBOX)
    [[ -e $AERC_CONTAS.antes-tt ]] || cp -p "$AERC_CONTAS" "$AERC_CONTAS.antes-tt" # cópia antes da 1ª importação
    tmp=$(mktemp)
    awk -v alvo="[$nome]" '$0 == alvo { pula = 1; next } pula && /^\[.*\]$|^# >>> tt e-mail:/ { pula = 0 } !pula' "$AERC_CONTAS" >"$tmp" && cat "$tmp" >"$AERC_CONTAS"
    rm -f "$tmp"; email_gravar; email_regerar "$slug"
  done < <(awk '/^# >>> tt e-mail:/ { g = 1 } /^# <<< tt e-mail:/ { g = 0; next } g { next }
    /^\[.*\]$/ { n = substr($0, 2, length($0) - 2); next }
    n != "" && /^source[ \t]*=[ \t]*imaps:\/\/[^@]*@imap\.gmail\.com/ { src[n] = 1 }
    n != "" && /^from[ \t]*=/ { sub(/^from[ \t]*=[ \t]*/, ""); fr[n] = $0 }
    END { for (k in src) print k "\t" fr[k] }' "$AERC_CONTAS")
}

# Contas escritas à mão (fora dos marcadores): "nome" por linha.
email_manuais() {
  [[ -f $AERC_CONTAS ]] || return 0
  awk '/^# >>> tt e-mail:/ { g = 1 } /^# <<< tt e-mail:/ { g = 0; next } !g && /^\[.*\]$/ { print substr($0, 2, length($0) - 2) }' "$AERC_CONTAS"
}

# Assume uma conta escrita à mão: lê o bloco [NOME] e o transforma numa conta do tt com o MESMO
# efeito (o comando de senha vira autenticação "comando"; chaves desconhecidas como copy-to são
# preservadas). Guarda accounts.conf.antes-tt na primeira vez.
email_assumir() {
  local nome=$1 slug k v url esq resto hp n=0 tmp; local -A E=()
  slug=$(email_slug "$nome")
  [[ -e $(email_conf_arq "$slug") ]] && { echo "Já existe uma conta do tt com o identificador $slug."; return 1; }
  E=([_slug]=$slug [nome]=$nome [pasta]=INBOX [provedor]=outro)
  while IFS= read -r l; do
    [[ $l =~ ^[[:space:]]*([a-z-]+)[[:space:]]*=[[:space:]]*(.*)$ ]] || continue
    k=${BASH_REMATCH[1]}; v=${BASH_REMATCH[2]}
    case $k in
      source|outgoing)
        url=$v; esq=${url%%://*}; resto=${url#*://}; [[ $resto == *@* ]] && { E[usuario]=${resto%%@*}; resto=${resto#*@}; }
        hp=${resto%%[/?]*}; local t=imap; [[ $k == outgoing ]] && t=smtp
        E[${t}_host]=${hp%%:*}; E[${t}_porta]=${hp##*:}; [[ $hp == *:* ]] || E[${t}_porta]=$([[ $t == imap ]] && echo 993 || echo 465)
        case $esq in *s|*s+*) E[${t}_seg]=tls ;; *insecure*) E[${t}_seg]=nenhuma ;; *) E[${t}_seg]=starttls ;; esac
        [[ $esq == *xoauth2* || $esq == *oauthbearer* ]] && E[auth]=oauth ;;
      source-cred-cmd) E[cred_cmd]=$v ;;
      outgoing-cred-cmd) ;;
      from) if [[ $v =~ ^(.*)\<([^>]+)\>$ ]]; then E[nome_exibicao]=$(sed 's/[[:space:]]*$//' <<<"${BASH_REMATCH[1]}"); E[endereco]=${BASH_REMATCH[2]}; else E[endereco]=$v; fi ;;
      default) E[pasta]=$v ;;
      *) n=$((n + 1)); ((n <= 8)) && E[extra_$n]=$l ;;
    esac
  done < <(awk -v alvo="[$nome]" '$0 == alvo { p = 1; next } p && /^\[.*\]$|^# >>> tt e-mail:/ { p = 0 } p' "$AERC_CONTAS")
  E[usuario]=${E[usuario]//%40/@}; [[ ${E[usuario]} == "${E[endereco]:-}" ]] && E[usuario]=""
  [[ ${E[auth]:-} == oauth ]] || { E[auth]=comando; }
  case ${E[imap_host]:-} in imap.gmail.com) E[provedor]=gmail ;; outlook.office365.com) E[provedor]=microsoft ;; imap.mail.yahoo.com) E[provedor]=yahoo ;; imap.mail.me.com) E[provedor]=icloud ;; imap.fastmail.com) E[provedor]=fastmail ;; esac
  local erro; erro=$(email_validar) || { echo "Não consegui assumir \"$nome\": $erro"; return 1; }
  [[ -e $AERC_CONTAS.antes-tt ]] || cp -p "$AERC_CONTAS" "$AERC_CONTAS.antes-tt"
  tmp=$(mktemp)
  awk -v alvo="[$nome]" '$0 == alvo { pula = 1; next } pula && /^\[.*\]$|^# >>> tt e-mail:/ { pula = 0 } !pula' "$AERC_CONTAS" >"$tmp" && cat "$tmp" >"$AERC_CONTAS"; rm -f "$tmp"
  email_gravar; email_regerar "$slug"
  [[ -n ${TT_EMAIL_SEM_REDE:-} ]] || email_detectar_pastas "$slug" || true
  echo "✔ \"$nome\" agora é gerenciada pelo tt (cópia anterior em $AERC_CONTAS.antes-tt)"
}

# Validação comum (cadastro e edição). Imprime o problema e falha.
email_validar() {
  local novo=${1:-} auths login
  [[ -n ${E[nome]:-} ]] || { echo "Nome vazio."; return 1; }
  [[ ${E[nome]} != *'['* && ${E[nome]} != *']'* && ${E[nome]} != *$'\n'* && ${E[nome]} != *$'\r'* ]] ||
    { echo "O nome não pode conter [ ], quebra de linha nem controle."; return 1; }
  [[ ${E[endereco]:-} =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] ||
    { echo "Endereço inválido: ${E[endereco]:-vazio}. Use o e-mail completo, por exemplo nome@dominio.com."; return 1; }
  login=${E[usuario]:-${E[endereco]}}
  [[ -n $login && $login != *[[:space:]]* && $login != *://* && $login != *'<'* && $login != *'>'* ]] ||
    { echo "Usuário de login inválido: use o login técnico, sem espaços. Deixe vazio para usar ${E[endereco]}."; return 1; }
  [[ -n ${E[imap_host]:-} && -n ${E[smtp_host]:-} && ${E[imap_host]} != *[[:space:]]* && ${E[smtp_host]} != *[[:space:]]* ]] ||
    { echo "Servidores IMAP/SMTP inválidos ou vazios."; return 1; }
  [[ ${E[imap_porta]:-} =~ ^[0-9]+$ && ${E[smtp_porta]:-} =~ ^[0-9]+$ ]] || { echo "Porta inválida."; return 1; }
  ((10#${E[imap_porta]} >= 1 && 10#${E[imap_porta]} <= 65535 && 10#${E[smtp_porta]} >= 1 && 10#${E[smtp_porta]} <= 65535)) ||
    { echo "Portas devem estar entre 1 e 65535."; return 1; }
  [[ ${E[imap_seg]} =~ ^(tls|starttls|nenhuma)$ && ${E[smtp_seg]} =~ ^(tls|starttls|nenhuma)$ ]] || { echo "Segurança deve ser tls, starttls ou nenhuma."; return 1; }
  if [[ ${E[imap_seg]} == nenhuma && ! ${E[imap_host]} =~ ^(127\.0\.0\.1|localhost|::1)$ ]] ||
     [[ ${E[smtp_seg]} == nenhuma && ! ${E[smtp_host]} =~ ^(127\.0\.0\.1|localhost|::1)$ ]]; then
    echo "Conexão sem criptografia só é permitida em localhost."; return 1
  fi
  [[ ${E[auth]} =~ ^(senha|oauth|comando)$ ]] || { echo "Autenticação deve ser senha, oauth ou comando."; return 1; }
  auths=$(cut -d'|' -f5 <<<"$(email_provedor "${E[provedor]}")")
  [[ " $auths " == *" ${E[auth]} "* ]] || { echo "${E[provedor]} não oferece o método de autenticação escolhido."; return 1; }
  [[ ${E[auth]} != comando || -n ${E[cred_cmd]:-} || ${2:-} == antes-do-segredo ]] || { echo "Falta o comando que imprime a senha."; return 1; }
  if [[ ${E[auth]} == oauth && ${2:-} != antes-do-segredo ]]; then
    email_gmail_padrao_id
    [[ -n ${E[oauth_client_id]:-} ]] || { echo "Falta o ID do aplicativo OAuth (client_id)."; return 1; }
    [[ ${E[oauth_token_endpoint]:-} == https://* || ${E[oauth_token_endpoint]:-} == http://127.0.0.1:* || ${E[oauth_token_endpoint]:-} == http://localhost:* ]] ||
      { echo "O endpoint de token OAuth deve usar HTTPS (HTTP só é aceito em localhost)."; return 1; }
    [[ ${E[oauth_device_endpoint]:-} == https://* || ${E[oauth_auth_endpoint]:-} == https://* ||
       ${E[oauth_device_endpoint]:-} == http://127.0.0.1:* || ${E[oauth_auth_endpoint]:-} == http://127.0.0.1:* ||
       ${E[oauth_device_endpoint]:-} == http://localhost:* || ${E[oauth_auth_endpoint]:-} == http://localhost:* ]] ||
      { echo "OAuth precisa de endpoint seguro de autorização ou de código do dispositivo."; return 1; }
  fi
  if [[ -n $novo ]]; then
    email_contas_nomes | grep -qxF "${E[nome]}" && { echo "Já existe uma conta \"${E[nome]}\"."; return 1; }
    [[ -e $(email_conf_arq "${E[_slug]}") || -e $(email_cred_arq "${E[_slug]}") ]] &&
      { echo "Já existe uma conta que usa o mesmo identificador (${E[_slug]}); escolha um nome distinto."; return 1; }
  fi
  return 0
}

# Preenche servidores e autenticação a partir do provedor. Em "outro", descobre pelo domínio; se ele é
# hospedado na Microsoft 365 ou no Google Workspace (o MX diz), a conta passa a ser desse provedor.
email_aplicar_provedor() {
  local linha imap smtp auths h p s k v achado=""
  if [[ ${E[provedor]} == outro && -z ${E[imap_host]:-} && ${E[endereco]:-} == *@* ]] && command -v python3 >/dev/null; then
    while IFS='=' read -r k v; do
      case $k in imap_* | smtp_*) E[$k]=$v ;; provedor) achado=$v ;; esac
    done < <(python3 "$EMAIL_PY" descobrir "${E[endereco]#*@}" 2>/dev/null)
    if [[ -n $achado && -n $(email_provedor "$achado") ]]; then
      E[provedor]=$achado
    fi
  fi
  linha=$(email_provedor "${E[provedor]}"); IFS='|' read -r _ _ imap smtp auths _ <<<"$linha"
  if [[ -n $imap ]]; then
    read -r h p s <<<"$imap"; E[imap_host]=${E[imap_host]:-$h}; E[imap_porta]=${E[imap_porta]:-$p}; E[imap_seg]=${E[imap_seg]:-$s}
    read -r h p s <<<"$smtp"; E[smtp_host]=${E[smtp_host]:-$h}; E[smtp_porta]=${E[smtp_porta]:-$p}; E[smtp_seg]=${E[smtp_seg]:-$s}
  fi
  [[ -n ${E[auth]:-} ]] || E[auth]=${auths%% *}
  [[ ${E[auth]} == oauth ]] && [[ -z ${E[oauth_token_endpoint]:-} ]] && email_oauth_padrao "${E[provedor]}"
  E[pasta]=${E[pasta]:-INBOX}
}

# tt --email-adicionar chave=valor… [--senha-stdin]: cadastro sem interação (scripts e testes).
# Chaves: as de EMAIL_CHAVES (nome, endereco, provedor, auth, imap_host, imap_porta, imap_seg, …).
email_adicionar_cli() {
  local -A E=() ; local a senha_stdin="" k
  for a in "$@"; do
    case $a in --senha-stdin) senha_stdin=1 ;; *=*) k=${a%%=*}; E[$k]=${a#*=} ;; *) echo "argumento inválido: $a"; return 2 ;; esac
  done
  E[provedor]=${E[provedor]:-outro}; E[nome]=${E[nome]:-${E[endereco]%@*}}; E[_slug]=$(email_slug "${E[nome]}")
  email_aplicar_provedor
  email_validar novo || return 1
  if [[ ${E[sync_local]:-} == 1 ]] && ! command -v "$(mbsync_bin)" >/dev/null; then
    echo "✗ Sync local pede o mbsync (isync) instalado. Instale-o ou deixe sync_local vazio."; return 1
  fi
  if [[ ${E[auth]} == senha ]]; then
    local senha; [[ -n $senha_stdin ]] && IFS= read -r senha
    [[ -n ${senha:-} ]] || { echo "Senha vazia (use --senha-stdin)."; return 1; }
    mkdir -p "$SECRETS_DIR"; chmod 700 "$SECRETS_DIR" 2>/dev/null
    ( umask 077; printf '%s' "$senha" >"$(email_cred_arq "${E[_slug]}")" ); chmod 600 "$(email_cred_arq "${E[_slug]}")"; unset senha
  fi
  # assinatura=texto (uma linha; várias com tt --email-assinatura CONTA). Não fica no .conf.
  if [[ -n ${E[assinatura]:-} ]]; then mkdir -p "$EMAIL_DIR"; printf '%s\n' "${E[assinatura]}" >"$(email_assinatura_arq "${E[_slug]}")"; fi
  email_gravar; email_regerar "${E[_slug]}"
  [[ -n ${TT_EMAIL_SEM_REDE:-} ]] || email_detectar_pastas "${E[_slug]}" || true
  [[ ${E[sync_local]:-} == 1 && -z ${TT_EMAIL_SEM_REDE:-} ]] && ("$EU" --email-sync "${E[_slug]}" --completo >/dev/null 2>&1 &)
  echo "✔ conta \"${E[nome]}\" cadastrada (${E[_slug]})"
  # propagar=1 manda a conta a todas as máquinas; propagar=dell,s23 só a essas. Não fica no .conf.
  if [[ -n ${E[propagar]:-} && ${E[propagar]} != 0 ]]; then
    local -a alvos=(); [[ ${E[propagar]} == 1 ]] || IFS=', ' read -r -a alvos <<<"${E[propagar]}"
    email_propagar "${E[_slug]}" "${alvos[@]}"
  fi
}

email_remover_slug() {
  local slug=$1; local -A E=()
  email_ler "$slug" || { echo "Conta não encontrada: $slug"; return 1; }
  rm -f "$(email_conf_arq "$slug")" # antes de regerar: os binds por conta são montados da lista de .conf
  email_regerar "$slug" remover
  rm -f "$(email_cred_arq "$slug")" "$SECRETS_DIR/aerc-$slug.client_secret" "$(email_assinatura_arq "$slug")"
  rm -rf "$(email_maildir "$slug")" "$EMAIL_MBSYNC_DIR/$slug.lock"
  echo "✔ conta \"${E[nome]}\" removida (bloco do aerc e segredos apagados)"
}

# ─── Propagar uma conta de e-mail entre as máquinas ───────────────────────────
#
# Credencial nunca viaja em sync automático. A propagação é um envio transacional, só por comando
# ou por pergunta respondida, por ssh direto (SSH_OPC: o canal já confiável entre as máquinas), no
# modelo do --conta-propagar das contas de IA. O pacote é um tar pelo stdin do ssh, montado direto
# dos arquivos (sem cópia intermediária, nada em pasta sincronizada): o <slug>.conf e o que existir
# em ~/.secrets da conta (senha ou token de renovação; client_secret). O mapa de pastas e o
# .mbsyncrc são regerados na chegada. Antes de mandar o segredo, o tt de lá é sondado
# (--email-receber SLUG --sonda): um tt antigo não sabe receber e nada é enviado. Na chegada:
# umask 077, segredos 600, email_regerar; sync_local=1 numa máquina sem mbsync chega desligado,
# com aviso (nada de fingir). Conta que já existe lá só é substituída com --sobrescrever.
# Nenhuma função aqui imprime, registra ou passa o segredo em linha de comando.

# Itens da conta que existem aqui: "pasta<TAB>nome" (os únicos nomes aceitos na chegada).
email_pacote_itens() { # slug
  local slug=$1 d n
  while IFS='|' read -r d n; do [[ -s $d/$n && ! -L $d/$n ]] && printf '%s\t%s\n' "$d" "$n"; done <<EOF
$EMAIL_DIR|$slug.conf
$SECRETS_DIR|aerc-$slug.txt
$SECRETS_DIR|aerc-$slug.client_secret
$EMAIL_DIR|$slug.assinatura
EOF
  return 0
}

# O tar da conta na saída padrão, montado direto dos arquivos (vários -C: nada é copiado antes).
email_pacote() { # slug
  local d n; local -a args=()
  while IFS=$'\t' read -r d n; do args+=(-C "$d" "$n"); done < <(email_pacote_itens "$1")
  ((${#args[@]})) || return 1
  tar -cf - "${args[@]}"
}

# tt --email-propagar CONTA [máquina…] [--sobrescrever]: sem máquinas, todas as cadastradas e
# acessíveis agora. Uma linha por máquina (✓ instalada · já existe lá · ✗ motivo). No terminal,
# onde a conta já existia oferece substituir; sem terminal, só com --sobrescrever.
email_propagar() {
  local nome="" sobre="" a slug dest rot r rc n=0 falhas=0
  local -a alvos=() existentes=() vistos=()
  for a in "$@"; do
    case $a in --sobrescrever) sobre=1 ;; *) if [[ -z $nome ]]; then nome=$a; else alvos+=("$a"); fi ;; esac
  done
  [[ -n $nome ]] || { echo "uso: tt --email-propagar CONTA [máquina…] [--sobrescrever]" >&2; return 1; }
  slug=$(email_achar "$nome") || { echo "Conta não encontrada: $nome" >&2; return 1; }
  local -A E=(); email_ler "$slug" || return 1
  if [[ ${E[auth]} != comando && ! -s $(email_cred_arq "$slug") ]]; then
    echo "✗ A conta '${E[nome]}' ainda não tem senha/token aqui: autorize (ou cadastre de novo) antes de propagar." >&2
    return 1
  fi
  echo "Propagando a conta '${E[nome]}' (configuração + senha/token, por ssh):"
  while read -r dest rot; do
    if ((${#alvos[@]})); then
      for a in "${alvos[@]}"; do [[ $a == "$rot" ]] && break; a=""; done
      [[ -n $a ]] || continue
    fi
    n=$((n + 1)); vistos+=("$rot")
    printf '  %-10s ' "$rot"
    r=$(email_propagar_para "$dest" "$slug" "$sobre"); rc=$?
    echo "$r"
    [[ $r == '· já existe'* ]] && existentes+=("$rot")
    ((rc == 0)) || falhas=$((falhas + 1))
  done < <(maquinas)
  for a in "${alvos[@]}"; do
    for rot in "${vistos[@]}"; do [[ $rot == "$a" ]] && continue 2; done
    printf '  %-10s ✗ não está cadastrada, ou não está acessível agora\n' "$a"; falhas=$((falhas + 1))
  done
  ((n)) || ((${#alvos[@]})) || { echo "  nenhuma máquina cadastrada e acessível agora (tt --cadastrar)"; return 1; }
  if ((${#existentes[@]})) && [[ -z $sobre && -t 0 ]]; then
    read -r -e -p "Substituir a conta que já existe em ${existentes[*]}? (s/N) " a || return 1
    [[ $a == [sSyY]* ]] && { email_propagar "$slug" "${existentes[@]}" --sobrescrever; return; }
  fi
  ((falhas == 0))
}

# Um destino: sonda o tt de lá e só então manda o pacote. Ecoa uma linha (✓ · ✗) e devolve 0 só no sucesso.
email_propagar_para() { # dest slug sobrescrever
  local dest=$1 slug=$2 sobre=$3 sonda rc r
  sonda=$(timeout 15 ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --email-receber $(q "$slug") --sonda" </dev/null 2>/dev/null); rc=$?
  case $rc:$sonda in
    0:pronto*) ;;
    255:* | 124:*) echo "✗ sem resposta"; return 1 ;;
    127:*) echo "✗ o tt não está instalado lá (tt --atualizar instala)"; return 1 ;;
    *) echo "✗ o tt de lá ainda não sabe receber contas de e-mail: atualize-o (tt --atualizar) e tente de novo"; return 1 ;;
  esac
  if [[ $sonda == *" existe=1"* && -z $sobre ]]; then echo "· já existe lá (--sobrescrever substitui)"; return 1; fi
  r=$(email_pacote "$slug" | timeout 60 ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --email-receber $(q "$slug")${sobre:+ --sobrescrever}" 2>&1 | tail -1)
  [[ -n $r ]] || r="✗ sem resposta"
  echo "$r"; [[ $r == ✓* ]]
}

# tt --email-receber SLUG [--sobrescrever] [--sonda]: recebe pelo stdin o tar da conta e a instala
# aqui, transacional (tudo é conferido antes de tocar em qualquer arquivo; se a gravação falhar, o
# estado anterior volta pelo snapshot). --sonda só responde "pronto existe=0|1 mbsync=0|1" — é o
# que o remetente confere antes de mandar o segredo.
email_receber() {
  local slug=${1:-} a sobre="" sonda="" existe=0 temm=0
  for a in "${@:2}"; do case $a in --sobrescrever) sobre=1 ;; --sonda) sonda=1 ;; esac; done
  if [[ -z $slug || $slug != "$(email_slug "$slug")" ]]; then
    [[ -n $sonda ]] || cat >/dev/null; echo "✗ identificador de conta inválido"; return 1
  fi
  [[ -e $(email_conf_arq "$slug") ]] && existe=1
  command -v "$(mbsync_bin)" >/dev/null && temm=1
  if [[ -n $sonda ]]; then echo "pronto existe=$existe mbsync=$temm"; return 0; fi
  if ((existe)) && [[ -z $sobre ]]; then cat >/dev/null; echo "· já existe aqui (--sobrescrever substitui)"; return 1; fi
  local tmp lista m conf cred cs k v l erro avisos="" snap
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/tt-email-receber.XXXXXX") || { cat >/dev/null; echo "✗ sem onde gravar"; return 1; }
  chmod 700 "$tmp"
  # Guarda o pacote e confere os membros ANTES de extrair: só os nomes esperados, na raiz.
  if ! ( umask 077; cat >"$tmp/pacote.tar" ) || ! lista=$(tar -tf "$tmp/pacote.tar" 2>/dev/null) || [[ -z $lista ]]; then
    rm -rf "$tmp"; echo "✗ pacote inválido"; return 1
  fi
  while IFS= read -r m; do
    case $m in "$slug.conf" | "aerc-$slug.txt" | "aerc-$slug.client_secret" | "$slug.assinatura") ;;
      *) rm -rf "$tmp"; echo "✗ pacote com conteúdo inesperado ($m)"; return 1 ;; esac
  done <<<"$lista"
  ( umask 077; tar -C "$tmp" -xf "$tmp/pacote.tar" ) 2>/dev/null || { rm -rf "$tmp"; echo "✗ pacote inválido"; return 1; }
  rm -f "$tmp/pacote.tar"
  conf=$tmp/$slug.conf; cred=$tmp/aerc-$slug.txt; cs=$tmp/aerc-$slug.client_secret
  [[ -s $conf ]] || { rm -rf "$tmp"; echo "✗ pacote sem a configuração da conta"; return 1; }
  # A conta recebida é lida como uma conta local (só chaves conhecidas) e validada antes de tudo.
  local -A E=(); E[_slug]=$slug
  while IFS= read -r l; do
    [[ $l == *=* && $l != \#* ]] || continue; k=${l%%=*}; v=${l#*=}
    [[ " ${EMAIL_CHAVES[*]} " == *" $k "* ]] && E[$k]=$v
  done <"$conf"
  E[provedor]=${E[provedor]:-outro}
  if [[ ${E[auth]:-} != comando && ! -s $cred ]]; then rm -rf "$tmp"; echo "✗ pacote sem a senha/token da conta"; return 1; fi
  if ! erro=$(email_validar "$( ((existe)) || echo novo)"); then rm -rf "$tmp"; echo "✗ conta recusada: $erro"; return 1; fi
  if [[ ${E[sync_local]:-} == 1 ]] && ((temm == 0)); then E[sync_local]=""; avisos+=" · sync local desligado: sem mbsync aqui"; fi
  [[ ${E[auth]} == comando ]] && avisos+=" · autenticação por comando: confira que '${E[cred_cmd]}' funciona aqui"
  snap=$(email_snapshot_criar "$slug") || { rm -rf "$tmp"; echo "✗ sem onde guardar o estado anterior"; return 1; }
  mkdir -p "$SECRETS_DIR"; chmod 700 "$SECRETS_DIR" 2>/dev/null
  # A assinatura acompanha a conta: a do pacote substitui a daqui (ou a tira, se o pacote não tem).
  local ass; ass=$(email_assinatura_arq "$slug")
  if ! { [[ ! -s $cred ]] || email_segredo_instalar "$cred" "$(email_cred_arq "$slug")"; } ||
     ! { [[ ! -s $cs ]] || email_segredo_instalar "$cs" "$SECRETS_DIR/aerc-$slug.client_secret"; } ||
     ! { mkdir -p "$EMAIL_DIR" && rm -f "$ass" && { [[ ! -s $tmp/$slug.assinatura ]] || cp "$tmp/$slug.assinatura" "$ass"; }; } ||
     ! email_gravar || ! email_regerar "$slug"; then
    email_snapshot_restaurar "$snap" "$slug"; rm -rf "$tmp"
    echo "✗ não consegui gravar a conta; nada foi alterado"; return 1
  fi
  rm -rf "$snap" "$tmp"
  [[ ${E[sync_local]:-} == 1 && -z ${TT_EMAIL_SEM_REDE:-} ]] && ("$EU" --email-sync "$slug" --completo >/dev/null 2>&1 &)
  echo "✓ conta '${E[nome]}' $( ((existe)) && echo substituída || echo instalada)$avisos"
}

# Grava um segredo recebido no lugar definitivo, só para o dono (sem herdar modo de arquivo antigo).
email_segredo_instalar() { # origem destino
  rm -f "${2:?}" && ( umask 077; cp "$1" "$2" ) && chmod 600 "$2"
}

# Ao final do cadastro (conta testada): oferece mandar a conta às máquinas da rede. Só pergunta se
# há máquinas cadastradas e acessíveis; sem resposta afirmativa, nada sai daqui.
email_propagar_oferecer() { # slug
  local slug=$1 lista c
  lista=$(maquinas | awk '{ printf "%s%s", (NR > 1 ? ", " : ""), $2 }')
  [[ -n $lista ]] || return 0
  local pergunta="Propagar esta conta para as máquinas da rede ($lista)? (S/n) "
  printf '\n'
  if [[ -t 0 ]]; then read -r -e -p "$pergunta" c || return 0
  else printf '%s\n' "$pergunta"; IFS= read -r c || return 0; fi # sem terminal, read -p não mostra a pergunta
  [[ $c == [nN]* ]] && return 0
  email_propagar "$slug"
}

# Seletor de máquinas (F2 → conta → ⇪ Propagar…): todas marcadas, Tab desmarca, ⏎ envia. Sem
# terminal, lê os rótulos (um por linha) da entrada padrão.
email_propagar_ui() { # slug
  local slug=$1 linhas esc a; local -a rots=()
  linhas=$(maquinas | awk '{ printf "%s\t⇪ %-10s \033[90m%s\033[0m\n", $2, $2, $1 }')
  [[ -n $linhas ]] || { echo "Nenhuma máquina cadastrada e acessível agora (tt --cadastrar)."; email_pausa; return 0; }
  if [[ -t 0 && -t 1 ]] && command -v fzf >/dev/null; then
    esc=$(fzf --ansi --multi --bind 'start:select-all' --delimiter=$'\t' --with-nth=2 --no-sort --layout=reverse \
      --height=~20 --border=rounded --border-label=' ⇪ propagar a conta para… (Tab marca/desmarca · ⏎ envia · Esc sai) ' \
      --prompt='❯ ' --pointer='▶' --marker='✔' <<<"$linhas" | cut -f1) || return 0
  else esc=$(cat); fi
  while IFS= read -r a; do [[ -n $a ]] && rots+=("$a"); done <<<"$esc"
  ((${#rots[@]})) || return 0
  clear 2>/dev/null
  email_propagar "$slug" "${rots[@]}"
  email_pausa
}

# Conta pelo nome ou slug → slug.
email_achar() {
  local s; s=$(email_slug "$1"); [[ -e $(email_conf_arq "$s") ]] && { echo "$s"; return 0; }
  for s in $(email_slugs); do local -A E=(); email_ler "$s" && [[ ${E[nome]} == "$1" ]] && { echo "$s"; return 0; }; done
  return 1
}

# TSV: slug, nome, endereço, provedor, autenticação, servidor IMAP.
email_listar() {
  email_importar_legado
  local s n; for s in $(email_slugs); do local -A E=(); email_ler "$s" || continue
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$s" "${E[nome]}" "${E[endereco]}" "${E[provedor]:-outro}" "${E[auth]}" "${E[imap_host]}:${E[imap_porta]}"
  done
  # Escritas à mão: aparecem com slug "!NOME" (abrir assume a conta no tt).
  while IFS= read -r n; do [[ -n $n ]] && printf '!%s\t%s\t%s\t%s\t%s\t%s\n' "$n" "$n" "-" manual "-" "-"; done < <(email_manuais)
}

# Pergunta ao servidor as pastas especiais e regrava o bloco. Sem rede/credencial: mantém o que havia.
email_detectar_pastas() {
  local slug=$1 k v saida; local -A E=()
  command -v python3 >/dev/null || return 1
  email_ler "$slug" || return 1
  saida=$(timeout 40 python3 "$EMAIL_PY" pastas "$(email_conf_arq "$slug")" 2>/dev/null) || return 1
  for k in todos enviados lixeira rascunhos spam naoabre importantes estrela; do E[pasta_$k]=""; done
  while IFS='=' read -r k v; do [[ -n $k && -z ${E[pasta_$k]:-} ]] && E[pasta_$k]=$v; done <<<"$saida"
  email_gravar; email_regerar "$slug"
}

email_testar_slug() {
  command -v python3 >/dev/null || { echo "✗ precisa do python3 para testar"; return 1; }
  [[ -e $(email_conf_arq "$1") ]] || { echo "Conta não encontrada: $1"; return 1; }
  python3 "$EMAIL_PY" testar "$(email_conf_arq "$1")" || return 1
  email_detectar_pastas "$1" && echo "✓ pastas especiais conferidas (arquivar, rascunhos, enviados)"
  return 0
}

email_autorizar_slug() {
  command -v python3 >/dev/null || { echo "✗ precisa do python3"; return 1; }
  python3 "$EMAIL_PY" oauth-autorizar "$(email_conf_arq "$1")"
}

# ─── Telas (rodam dentro do popup) ─────────────────────────────────────────────
# Pergunta com valor sugerido (Enter aceita). Sem terminal (testes, scripts), lê uma linha.
email_pergunta() { # VAR texto [padrão]
  local __v
  if [[ -t 0 ]]; then read -r -e -p "$2: " -i "${3:-}" __v || return 1
  else IFS= read -r __v || __v=""; [[ -z $__v ]] && __v=${3:-}; fi
  printf -v "$1" '%s' "$__v"
}
# Escolha numa lista "chave<TAB>rótulo": fzf no terminal; sem terminal, lê a chave (ou o padrão).
email_escolher() { # VAR título padrão "opções" (a resposta vem da entrada padrão quando não há terminal)
  local __op=$4 __v
  if [[ -t 0 && -t 1 ]] && command -v fzf >/dev/null; then
    __v=$(fzf --ansi --layout=reverse --delimiter=$'\t' --with-nth=2 --no-input --height=~20 --header="$2" <<<"$__op" | cut -f1) || return 1
  else
    IFS= read -r __v || __v=""; [[ -z $__v ]] && __v=$3
    grep -q "^$__v"$'\t' <<<"$__op" || return 1
  fi
  printf -v "$1" '%s' "$__v"
}

email_rotulo_auth() { case $1 in senha) echo "senha / senha de app" ;; oauth) echo "OAuth2 / SSO (login pelo navegador)" ;; comando) echo "comando externo (pass, secret-tool, Bitwarden…)" ;; esac; }

# Opções realmente suportadas pelo provedor. OAuth fica primeiro e marcado como recomendado nos
# provedores com endpoints prontos; a escolha atual pode vir primeiro durante uma edição.
email_auth_opcoes() { # provedor [atual]
  local prov=$1 atual=${2:-} linha auths op rot
  linha=$(email_provedor "$prov"); auths=$(cut -d'|' -f5 <<<"$linha")
  if [[ -n $atual && " $auths " == *" $atual "* ]]; then
    rot=$(email_rotulo_auth "$atual"); [[ $atual == oauth && $prov =~ ^(gmail|microsoft)$ ]] && rot+=" · recomendado"
    printf '%s\t%s\n' "$atual" "$rot"
  fi
  for op in $auths; do
    [[ -n $atual && $op == "$atual" ]] && continue
    rot=$(email_rotulo_auth "$op"); [[ $op == oauth && $prov =~ ^(gmail|microsoft)$ ]] && rot+=" · recomendado"
    printf '%s\t%s\n' "$op" "$rot"
  done
}

email_auth_padrao() {
  local linha; linha=$(email_provedor "$1"); cut -d'|' -f5 <<<"$linha" | awk '{print $1}'
}

email_auth_aplicar() {
  if [[ ${E[auth]} == oauth ]]; then
    E[cred_cmd]=""
    [[ -n ${E[oauth_token_endpoint]:-} ]] || email_oauth_padrao "${E[provedor]}"
    email_gmail_padrao_id
  else
    E[oauth_client_id]=""; E[oauth_auth_endpoint]=""; E[oauth_token_endpoint]=""
    E[oauth_device_endpoint]=""; E[oauth_scope]=""
    [[ ${E[auth]} == senha ]] && E[cred_cmd]=""
  fi
}

# Pede o segredo conforme a autenticação. Senha: lida sem eco, direto para ~/.secrets (600).
email_pedir_segredo() {
  case ${E[auth]} in
    senha)
      local senha senha2 cred; cred=$(email_cred_arq "${E[_slug]}")
      case ${E[provedor]} in
        gmail) printf 'Gmail: use uma senha de app de 16 caracteres; a senha normal costuma ser recusada.\n' ;;
        microsoft) printf 'Microsoft: OAuth2 é recomendado; muitos tenants recusam senha comum.\n' ;;
      esac
      read -r -s -p 'Senha/credencial (não aparece): ' senha; printf '\n'
      read -r -s -p 'Repita a senha: ' senha2; printf '\n'
      [[ -n $senha ]] || { echo "Senha vazia."; return 1; }
      [[ $senha == "$senha2" ]] || { echo "As senhas não conferem."; return 1; }
      mkdir -p "$SECRETS_DIR"; chmod 700 "$SECRETS_DIR" 2>/dev/null
      ( umask 077; printf '%s' "$senha" >"$cred" ); chmod 600 "$cred"; unset senha senha2 ;;
    comando)
      printf 'Comando que imprime a senha (ex.: pass email/pessoal · secret-tool lookup email %s)\n' "${E[endereco]}"
      email_pergunta 'E[cred_cmd]' 'Comando' "${E[cred_cmd]:-}" ;;
    oauth)
      printf '\nOAuth2 precisa do ID de um app registrado (client_id).\n'
      if [[ ${E[provedor]} == microsoft ]]; then
        printf 'Você pode registrar o seu (portal do Azure → Registros de aplicativo) ou usar o ID público\n'
        printf 'do Thunderbird, que vários clientes livres usam (deixe em branco para usá-lo).\n'
        email_pergunta 'E[oauth_client_id]' 'client_id' "${E[oauth_client_id]:-}"
        E[oauth_client_id]=${E[oauth_client_id]:-$EMAIL_THUNDERBIRD_ID}
      else
        [[ ${E[provedor]} == gmail ]] && printf 'Google: ⏎ usa o app do próprio tt (recomendado); ou informe o client_id de um app\n"Desktop" seu (console.cloud.google.com → APIs e serviços → Credenciais).\n'
        email_pergunta 'E[oauth_client_id]' 'client_id' "${E[oauth_client_id]:-}"
        email_gmail_padrao_id
        if [[ ${E[oauth_client_id]:-} == "${EMAIL_GMAIL_ID:-}" ]]; then
          email_gmail_padrao_secret
          printf '✓ App do tt: %s…\n' "${EMAIL_GMAIL_ID:0:24}"
        else
          local seg; read -r -s -p 'client_secret (se houver; não aparece): ' seg; printf '\n'
          if [[ -n $seg ]]; then mkdir -p "$SECRETS_DIR"; ( umask 077; printf '%s' "$seg" >"$SECRETS_DIR/aerc-${E[_slug]}.client_secret" ); fi; unset seg
        fi
        if [[ ${E[provedor]} == outro ]]; then
          email_pergunta 'E[oauth_auth_endpoint]' 'endereço de autorização' "${E[oauth_auth_endpoint]:-}"
          email_pergunta 'E[oauth_token_endpoint]' 'endereço do token' "${E[oauth_token_endpoint]:-}"
          email_pergunta 'E[oauth_device_endpoint]' 'endereço do código no aparelho (opcional)' "${E[oauth_device_endpoint]:-}"
          email_pergunta 'E[oauth_scope]' 'escopos' "${E[oauth_scope]:-}"
        fi
      fi ;;
  esac
}

email_avancado() {
  printf '\n⚙ Servidores (Enter mantém o valor)\n'
  email_pergunta 'E[imap_host]' 'IMAP (receber) — servidor' "${E[imap_host]:-}" || return 1
  email_pergunta 'E[imap_porta]' 'IMAP — porta' "${E[imap_porta]:-993}" || return 1
  email_escolher 'E[imap_seg]' 'IMAP — segurança' "${E[imap_seg]:-tls}" $'tls\tTLS (porta 993)\nstarttls\tSTARTTLS (porta 143)\nnenhuma\tnenhuma (só localhost, ex.: Proton Bridge)' || return 1
  email_pergunta 'E[smtp_host]' 'SMTP (enviar) — servidor' "${E[smtp_host]:-}" || return 1
  email_pergunta 'E[smtp_porta]' 'SMTP — porta' "${E[smtp_porta]:-465}" || return 1
  email_escolher 'E[smtp_seg]' 'SMTP — segurança' "${E[smtp_seg]:-tls}" $'tls\tTLS (porta 465)\nstarttls\tSTARTTLS (porta 587)\nnenhuma\tnenhuma (só localhost)' || return 1
  printf '\nDeixe o usuário técnico vazio para usar o endereço %s. Não use o nome da conta.\n' "${E[endereco]}"
  email_pergunta 'E[usuario]' 'Usuário técnico de login (sem espaços; opcional)' "${E[usuario]:-}" || return 1
  email_pergunta 'E[pasta]' 'Pasta inicial' "${E[pasta]:-INBOX}" || return 1
}

email_resumo() {
  printf '\n  %s  <%s>\n' "${E[nome]}" "${E[endereco]}"
  printf '  provedor: %s · autenticação: %s\n' "${E[provedor]}" "$(email_rotulo_auth "${E[auth]}")"
  printf '  IMAP: %s:%s (%s) · SMTP: %s:%s (%s)\n' "${E[imap_host]}" "${E[imap_porta]}" "${E[imap_seg]}" "${E[smtp_host]}" "${E[smtp_porta]}" "${E[smtp_seg]}"
  if [[ -n ${E[usuario]:-} ]]; then printf '  usuário técnico: %s\n' "${E[usuario]}"
  else printf '  usuário técnico: %s (igual ao endereço)\n' "${E[endereco]}"; fi
  return 0
}

# read -e (readline): setas e outras teclas especiais não viram ^[[A na tela.
email_pausa() { [[ -t 0 ]] && { printf '\n'; read -r -e -p "${1:-Enter volta.}" _; }; return 0; }

# Assistente de cadastro: provedor/endereço → descoberta → autenticação → segredo → teste obrigatório.
email_conta_nova_ui() {
  command -v aerc >/dev/null || { printf 'O aerc não está instalado nesta máquina.\nInstale o aerc e rode de novo.'; email_pausa 'Enter fecha.'; return; }
  local -A E=(); local prov linha dica erro snap
  clear 2>/dev/null
  # (no popup o título ' 📧 nova conta ' já está na borda: repeti-lo no corpo era a duplicação)
  em_popup || printf '📧 Nova conta de e-mail\n\n'
  email_escolher prov 'Qual é o seu e-mail?' gmail "$(cut -d'|' -f1,2 <<<"$EMAIL_PROVEDORES" | tr '|' '\t')" || return 0
  E[provedor]=$prov
  email_pergunta 'E[endereco]' 'Endereço (ex.: voce@exemplo.com)' || return 0
  email_pergunta 'E[nome]' 'Nome da conta no aerc' "${E[endereco]%%@*}" || return 0
  E[_slug]=$(email_slug "${E[nome]}")

  # Descobre o provedor ANTES da autenticação. A descoberta nunca anula a escolha do usuário.
  E[auth]=""; email_aplicar_provedor
  linha=$(email_provedor "${E[provedor]}"); dica=$(cut -d'|' -f6- <<<"$linha")
  email_escolher 'E[auth]' 'Como entrar? OAuth2 é recomendado quando disponível' \
    "$(email_auth_padrao "${E[provedor]}")" "$(email_auth_opcoes "${E[provedor]}")" || return 0
  email_auth_aplicar

  if [[ $prov == outro && ${E[provedor]} != outro ]]; then
    printf '\nℹ %s é hospedado em %s; servidores preenchidos. Você escolheu %s.\n' "${E[endereco]#*@}" \
      "$(cut -d'|' -f2 <<<"$linha")" "$(email_rotulo_auth "${E[auth]}")"
  fi
  [[ -n $dica ]] && printf '\nℹ %s\n' "$dica"
  if [[ ${E[provedor]} == outro ]]; then
    printf '\nServidores %s.\n' "$([[ -n ${E[imap_host]:-} ]] && echo "descobertos para ${E[endereco]#*@}" || echo "não encontrados")"
    email_avancado || return 0
  elif [[ -t 0 ]]; then
    local aj; read -r -e -p $'\nAjustar servidores, portas ou usuário técnico? (s/N) ' aj || return 0
    if [[ $aj == [sSyY]* ]]; then email_avancado || return 0; fi
  fi
  if ! erro=$(email_validar novo antes-do-segredo); then printf '\n✗ %s\nNada foi salvo.\n' "$erro"; email_pausa 'Enter volta.'; return 0; fi

  snap=$(email_snapshot_criar "${E[_slug]}") || { echo '✗ Não consegui criar o snapshot de segurança.'; email_pausa; return 0; }
  if ! email_pedir_segredo; then email_snapshot_restaurar "$snap" "${E[_slug]}"; email_pausa 'Nada foi salvo. Enter volta.'; return 0; fi
  if ! erro=$(email_validar); then
    email_snapshot_restaurar "$snap" "${E[_slug]}"; printf '\n✗ %s\nNada foi salvo.\n' "$erro"; email_pausa 'Enter volta.'; return 0
  fi
  printf '\nValidando IMAP e SMTP antes de salvar…\n'
  if ! email_salvar_validado "$snap" 1; then email_pausa 'Enter volta para corrigir.'; return 0; fi
  printf '\n✔ Conta cadastrada e validada:'; email_resumo
  # Assinatura (opcional, uma linha aqui; várias depois em F2 → conta → ✎ Assinatura).
  printf '\n'
  if email_pergunta 'E[assinatura]' 'Assinatura no fim das mensagens (opcional; Enter pula)' '' && [[ -n ${E[assinatura]:-} ]]; then
    mkdir -p "$EMAIL_DIR"; printf '%s\n' "${E[assinatura]}" >"$(email_assinatura_arq "${E[_slug]}")"; email_regerar "${E[_slug]}"
  fi
  email_propagar_oferecer "${E[_slug]}"
  email_pausa 'Enter volta.'
}

# Edição transacional: permite trocar autenticação; só substitui a conta após validar IMAP e SMTP.
email_editar_ui() {
  local slug=$1 erro t snap auth_antiga autorizar=0; local -A E=(); email_ler "$slug" || return 0
  auth_antiga=${E[auth]}
  clear 2>/dev/null; printf '✏ Editar conta'; email_resumo
  email_pergunta 'E[endereco]' 'Endereço' "${E[endereco]}" || return 0
  email_pergunta 'E[nome_exibicao]' 'Nome de exibição (no "De:"; opcional)' "${E[nome_exibicao]:-}" || return 0
  email_escolher 'E[auth]' 'Como entrar? OAuth2 é recomendado quando disponível' "$auth_antiga" \
    "$(email_auth_opcoes "${E[provedor]}" "$auth_antiga")" || return 0
  email_auth_aplicar
  email_avancado || return 0
  if ! erro=$(email_validar "" antes-do-segredo); then printf '\n✗ %s\nNada foi alterado.\n' "$erro"; email_pausa; return 0; fi

  if [[ ${E[auth]} != "$auth_antiga" ]]; then t=s
  else read -r -e -p $'\nTrocar a senha/credencial? (s/N) ' t || return 0; fi
  snap=$(email_snapshot_criar "$slug") || { echo '✗ Não consegui criar o snapshot de segurança.'; email_pausa; return 0; }
  if [[ $t == [sSyY]* ]]; then
    if ! email_pedir_segredo; then email_snapshot_restaurar "$snap" "$slug"; email_pausa 'Nada foi alterado. Enter volta.'; return 0; fi
    [[ ${E[auth]} == oauth ]] && autorizar=1
  fi
  if ! erro=$(email_validar); then
    email_snapshot_restaurar "$snap" "$slug"; printf '\n✗ %s\nA configuração anterior foi restaurada.\n' "$erro"; email_pausa; return 0
  fi
  printf '\nValidando IMAP e SMTP antes de substituir a conta…\n'
  if ! email_salvar_validado "$snap" "$autorizar"; then email_pausa 'Enter volta para corrigir.'; return 0; fi
  printf '\n✔ Conta atualizada e validada.'; email_pausa
}

# Gerência: lista navegável das contas; Enter abre as ações da conta.
email_contas_ui() {
  local escolha slug acao linhas c
  email_importar_legado
  while :; do
    linhas=$(email_listar | awk -F'\t' '$4 == "manual" { printf "%s\t📧 %-16.16s \033[33m(escrita à mão · ⏎ assume no tt)\033[0m\n", $1, $2; next }
      { printf "%s\t📧 %-16.16s %-30.30s \033[90m%s · %s · %s\033[0m\n", $1, $2, $3, $4, $5, $6 }')
    escolha=$( { printf '+\t\033[32m＋ Cadastrar conta…\033[0m\n'; [[ -n $linhas ]] && printf '%s\n' "$linhas"; } |
      fzf --ansi --layout=reverse --no-sort --delimiter=$'\t' --with-nth=2 --no-input \
        --header=$'⏎ abre · ^n nova · ^t testar · ^d descadastrar · Esc fecha' \
        --expect=enter,ctrl-n,ctrl-t,ctrl-d) || return 0
    acao=$(head -1 <<<"$escolha"); slug=$(sed -n 2p <<<"$escolha" | cut -f1)
    [[ $acao == ctrl-n || $slug == + ]] && { email_conta_nova_ui; continue; }
    [[ -n $slug ]] || continue
    if [[ $slug == !* ]]; then # conta escrita à mão: assumir (com cópia) antes de gerenciar
      clear; printf 'A conta "%s" foi escrita à mão no accounts.conf.\nO tt pode assumi-la (mesmo efeito, com cópia de segurança) para você editar e testar por aqui.\n\n' "${slug#!}"
      read -r -e -p 'Assumir agora? (S/n) ' c; [[ $c == [nN]* ]] && continue
      email_assumir "${slug#!}" || { email_pausa; continue; }
      slug=$(email_slug "${slug#!}")
    fi
    case $acao in
      ctrl-t) clear; email_testar_slug "$slug"; email_pausa ;;
      ctrl-d) email_descadastrar_ui "$slug" ;;
      *) email_conta_ui "$slug" ;;
    esac
  done
}

email_conta_ui() {
  local slug=$1 op; local -A E=(); email_ler "$slug" || return 0
  while :; do
    email_ler "$slug" || return 0
    op=$( { printf 't\t🔌 Testar conexão (receber e enviar)\n'
            printf 'e\t✏ Editar (servidores, portas, segurança, usuário, senha)\n'
            [[ ${E[auth]} == oauth ]] && printf 'a\t🔑 Autorizar de novo (OAuth2 / SSO)\n'
            if [[ ${E[sync_local]:-} == 1 ]]; then printf 's\t🔄 Sync local: ✓ ligado (espelho offline dos e-mails)\n'
            else printf 's\t🔄 Sync local: desligado (espelho offline: abre na hora e funciona sem rede)\n'; fi
            if [[ -s $(email_assinatura_arq "$slug") ]]; then printf 'g\t✎ Assinatura: %s\n' "$(head -c 60 "$(email_assinatura_arq "$slug")" | head -1)"
            else printf 'g\t✎ Assinatura (fim das mensagens): nenhuma\n'; fi
            printf 'p\t⇪ Propagar para as máquinas da rede… (configuração + senha/token, por ssh)\n'
            printf 'd\t🗑 Descadastrar\n'; printf 'v\t← Voltar\n'; } |
      fzf --ansi --layout=reverse --no-sort --delimiter=$'\t' --with-nth=2 --no-input \
        --header="$(email_resumo | sed '/^$/d')" | cut -f1) || return 0
    case $op in
      t) clear; email_testar_slug "$slug"; email_pausa ;;
      e) email_editar_ui "$slug" ;;
      a) clear; email_autorizar_slug "$slug"; email_pausa ;;
      s) clear
         if [[ ${E[sync_local]:-} == 1 ]]; then
           read -r -e -p 'Desligar o sync local (o aerc volta a ler direto do servidor)? (s/N) ' op
           [[ $op == [sSyY]* ]] && email_sync_local_definir "$slug" 0
         else
           command -v "$(mbsync_bin)" >/dev/null || pedir_sudo_pendencias email-sync
           if command -v "$(mbsync_bin)" >/dev/null; then email_sync_local_definir "$slug" 1
           else echo 'Sem o mbsync (isync), o sync local fica desligado.'; fi
         fi; email_pausa ;;
      g) clear; email_assinatura_editar "$slug"; email_pausa ;;
      p) email_propagar_ui "$slug" ;;
      d) email_descadastrar_ui "$slug" && return 0 ;;
      *) return 0 ;;
    esac
  done
}

email_descadastrar_ui() {
  local slug=$1 c; local -A E=(); email_ler "$slug" || return 1
  clear 2>/dev/null; printf '🗑 Descadastrar'; email_resumo
  read -r -e -p $'\nApaga o bloco do aerc e a senha/token desta conta (os e-mails no servidor não são tocados). Confirmar? (s/N) ' c
  [[ $c == [sSyY]* ]] || return 1
  email_remover_slug "$slug"; email_pausa; return 0
}

# Abre o gerenciador de contas numa subjanela (popup), como o próprio e-mail.
botao_email_contas() {
  local cliente=$1
  tmux display-popup -c "$cliente" -E $(tam_popup "$cliente") -T " 📧 contas de e-mail " \
    "cd ${HOME@Q}; $EU --email-contas-ui"
}

# Fecha o que está vazio; se há algo rodando, só desanexa (a sessão continua).
botao_sair() {
  local cliente=$1 pane=$2 pid cmd filhos paineis janelas
  pid=$(tmux display-message -p -t "$pane" '#{pane_pid}'); cmd=$(tmux display-message -p -t "$pane" '#{pane_current_command}')
  filhos=$(descendentes "$pid" | wc -l)
  case $cmd in
    bash|zsh|sh|dash|fish) ;;
    *) tmux detach-client -t "$cliente"; return ;;
  esac
  ((filhos == 0)) || { tmux detach-client -t "$cliente"; return; }
  paineis=$(tmux display-message -p -t "$pane" '#{window_panes}'); janelas=$(tmux display-message -p -t "$pane" '#{session_windows}')
  if ((paineis > 1)); then tmux kill-pane -t "$pane"
  elif ((janelas > 1)); then tmux kill-window -t "$pane"
  else tmux kill-session -t "$(tmux display-message -p -t "$pane" '#{session_id}')"; fi
}

botao() {
  local acao=$1 cliente=$2 pane=$3 pasta=${4:-$HOME} cmd w h
  case $acao in
    cl|clc|clr)
      local args=()
      [[ $acao == clc ]] && args=(--continue)
      [[ $acao == clr ]] && args=(--resume)
      cmd=$(claude_comando "$pasta" "${args[@]}") || { botao_aviso "$cliente" "claude não está instalado aqui"; return; }
      if [[ $acao == cl || $acao == clr ]]; then   # conversa nova e seletor de conversas são sempre uma sessão nova
        [[ $acao == clr && $(tmux show-options -wqv -t "$pane" @tt_papel) == claude ]] && { botao_aviso "$cliente" "já está no Claude: use /resume"; return; }
        local nome; nome=$(proximo_nome claude)
        tmux new-session -d -s "$nome" -c "$pasta" "$cmd; exec \${SHELL:-bash}" && tmux set-option -w -t "=$nome:" @tt_papel claude \
          && tmux set-option -w -t "=$nome:" @tt_pasta "$pasta" && tmux switch-client -c "$cliente" -t "=$nome"
      else ir_papel claude "$cmd" "$cliente" "$pane" "$pasta"; fi ;;
    dbn)
      cmd=$(debian_comando "$pasta") || { botao_aviso "$cliente" "não há Debian (proot-distro) aqui"; return; }
      ir_papel debian "$cmd" "$cliente" "$pane" "$pasta" ;;
    tela) botao_tela "$cliente" ;;
    email) botao_email "$cliente" ;;
    sair) botao_sair "$cliente" "$pane" ;;
    ant) tmux switch-client -c "$cliente" -l 2>/dev/null || botao_aviso "$cliente" "não há sessão anterior" ;;
    zm) tmux resize-pane -Z -t "$pane" ;;
    jn) tmux new-window -a -t "$(tmux display-message -p -t "$pane" "#{window_id}")" -c "$pasta" ;;
    dv) w=$(tmux display-message -p -t "$pane" '#{pane_width}'); h=$(tmux display-message -p -t "$pane" '#{pane_height}')
        # célula de terminal é ~2x mais alta que larga: divide ao lado se couber, senão embaixo
        if ((w >= 2 * h)); then tmux split-window -h -t "$pane" -c "$pasta"; else tmux split-window -v -t "$pane" -c "$pasta"; fi ;;
    *) botao_aviso "$cliente" "botão desconhecido: $acao" ;;
  esac
}

humano() { awk -v b="${1:-0}" 'BEGIN { split("B K M G T", u); i = 1; while (b >= 1024 && i < 5) { b /= 1024; i++ } printf (i == 1 ? "%d%s" : "%.1f%s"), b, u[i] }'; }

# Trabalhos de cópia persistem neste diretório até serem concluídos; o popup que os iniciou fica
# livre imediatamente para novas sessões, menus e outras operações. Por trabalho: ID.info (origem e
# destino), ID.status (estado), ID.pid (o trabalhador) e ID.log.
dir_transferencias() { echo "$RT/tt-transferencias-$UID"; }

atualizar_transferencia() {
  local id=$1 estado=$2 d
  d=$(dir_transferencias); mkdir -p "$d"
  printf '%s\n' "$estado" >"$d/$id.status"
  atualizar_barras
  return 0
}

idade_arquivo() { echo $(($(date +%s) - $(stat -c %Y "$1" 2>/dev/null || date +%s))); }

# Estado real de um trabalho: um "em andamento" cujo trabalhador já morreu (máquina suspensa,
# processo derrubado) vira "interrompida" — nada fica pendente para sempre. Concluídas, com erro
# ou interrompidas há mais de um dia são apagadas.
estado_transferencia() {
  local d=$1 id=$2 estado pid
  estado=$(cat "$d/$id.status" 2>/dev/null)
  case $estado in
    'na fila' | calculando* | transferindo*)
      pid=$(cat "$d/$id.pid" 2>/dev/null)
      # Sem pid ainda: o trabalhador acabou de ser lançado (dá alguns segundos a ele).
      [[ -z $pid ]] && (($(idade_arquivo "$d/$id.status") < 10)) && { echo "$estado"; return 0; }
      if [[ -z $pid ]] || ! kill -0 "$pid" 2>/dev/null; then
        sleep 0.3; estado=$(cat "$d/$id.status" 2>/dev/null) # pode ter acabado agora
        case $estado in 'na fila' | calculando* | transferindo*)
          estado='interrompida'; printf '%s\n' "$estado" >"$d/$id.status" ;; esac
      fi ;;
    *) (($(idade_arquivo "$d/$id.status") > 86400)) && { rm -f "$d/$id".*; return 1; } ;;
  esac
  echo "$estado"
}

transferencias_barra() {
  local d f id n=0 t f2 tx soma_t=0 soma_f=0 soma_x=0 pct txt
  d=$(dir_transferencias)
  for f in "$d"/*.status; do
    [[ -f $f ]] || continue; id=${f##*/}; id=${id%.status}
    case $(estado_transferencia "$d" "$id") in
      'na fila' | calculando* | transferindo*)
        n=$((n + 1)); t=0 f2=0 tx=0
        [[ -r $d/$id.prog ]] && read -r t f2 tx <"$d/$id.prog"
        soma_t=$((soma_t + ${t:-0})); soma_f=$((soma_f + ${f2:-0})); soma_x=$((soma_x + ${tx:-0})) ;;
    esac
  done
  ((n)) || return 0
  # Andamento somado dos trabalhos ativos: "⇅ 62% 14M/s" (um) ou "⇅ 2 · 62% 14M/s" (vários).
  txt="$n em andamento"
  if ((soma_t > 0)); then
    pct=$((soma_f * 100 / soma_t)); ((pct > 99)) && pct=99
    txt="${pct}% $(humano "$soma_x")/s"; ((n > 1)) && txt="$n · $txt"
  fi
  printf '#[range=user|transferencias]#[fg=#a6e3a1,bold] ⇅ %s #[norange]#[default] ' "$txt"
  return 0
}

# Causa provável de uma falha, em português, a partir do log do trabalho (o fim do log é ruído de tar/ssh).
causa_falha() {
  local l=$1 t
  t=$(sed 's/\x1b\[[0-9;]*m//g' "$l" 2>/dev/null)
  case $t in
    *'No space left'* | *'Disk quota'*) echo 'sem espaço no destino' ;;
    *'Permission denied'* | *'Operation not permitted'*) echo 'sem permissão (pasta de destino ou arquivo de origem)' ;;
    *'No route to host'* | *'timed out'* | *'Connection refused'* | *'Could not resolve'* | *'Network is unreachable'*) echo 'máquina inalcançável (offline, VPN ou Tailscale fora?)' ;;
    *'closed by remote host'* | *'Broken pipe'* | *'Connection reset'*) echo 'a conexão caiu no meio da cópia' ;;
    *'No such file'* | *'Cannot stat'*) echo 'um arquivo da origem não existe mais' ;;
    *'Nada chegou'*) echo 'nada chegou ao destino' ;;
    *) grep -v '^[[:space:]]*$' <<<"$t" | tail -1 ;;
  esac
}

# Tela das transferências (botão "⇅ N em andamento" e menu do painel). Redesenha no lugar a cada
# 0,5 s (sem piscar). ↑/↓ (ou j/k, ou o número) escolhem, e a rolagem acompanha quando há mais
# trabalhos que linhas. c cancela (pede confirmação passando de 50 %), l abre o log inteiro, r tenta
# de novo um que falhou/parou, o abre a pasta de destino, x limpa os já terminados; q, Esc ou Enter
# fecham (e o popup fecha junto: popup_tt usa -E).
transferencias() {
  local d f id estado tecla resto i w tela total feitos taxa pct cheio prog cor sinal nomes rota ativos marca
  local linhas cap off=0 sel=1 n pergunta="" a dst ddst
  local -a ids args
  d=$(dir_transferencias)
  if [[ ! -t 0 ]]; then
    for f in "$d"/*.status; do [[ -f $f ]] && { id=${f##*/}; id=${id%.status}; printf '%s: %s\n' "$id" "$(estado_transferencia "$d" "$id")"; }; done
    return 0
  fi
  corta() { local t=$1 n=$2; ((${#t} > n)) && t="${t:0:n-1}…"; printf '%s' "$t"; }
  printf '\033[?25l\033[2J'; trap 'printf "\033[?25h"' RETURN
  while true; do
    w=$(($(tput cols 2>/dev/null || echo 80) - 1)); linhas=$(tput lines 2>/dev/null || echo 24)
    cap=$(((linhas - 5) / 3)); ((cap < 1)) && cap=1
    ids=(); n=0
    for f in $(ls -t "$d"/*.status 2>/dev/null); do
      id=${f##*/}; id=${id%.status}
      estado_transferencia "$d" "$id" >/dev/null || continue
      n=$((n + 1)); ids[n]=$id
    done
    ((sel > n)) && sel=$n; ((sel < 1)) && sel=1
    ((sel <= off)) && off=$((sel - 1)); ((sel > off + cap)) && off=$((sel - cap))
    tela=""; ativos=""
    for ((i = off + 1; i <= n && i <= off + cap; i++)); do
      id=${ids[i]}; estado=$(cat "$d/$id.status" 2>/dev/null)
      nomes=$(paste -sd'|' "$d/$id.nomes" 2>/dev/null); nomes=${nomes//|/, }
      rota=$(awk -F'\t' '{ printf "%s:%s → %s:%s", $1, $2, $3, $4 }' "$d/$id.info" 2>/dev/null)
      total=0 feitos=0 taxa=0; [[ -r $d/$id.prog ]] && read -r total feitos taxa <"$d/$id.prog"
      case $estado in 'na fila' | calculando* | transferindo*) ativos=1 ;; esac
      case $estado in
        'na fila' | calculando*) cor=33 sinal='⋯' prog=$estado ;;
        transferindo*)
          cor=36 sinal='⇣' pct=0
          ((${total:-0} > 0)) && pct=$((${feitos:-0} * 100 / total)); ((pct > 99)) && pct=99
          cheio=$((pct / 5))
          prog="$(printf '%*s' "$cheio" '' | sed 's/ /█/g')$(printf '%*s' $((20 - cheio)) '' | sed 's/ /░/g') $(printf '%3d' "$pct")%  $(humano "${feitos:-0}") de $(humano "${total:-0}")  $(humano "${taxa:-0}")/s" ;;
        concluída*) cor=32 sinal='✓' prog="concluída  $(cat "$d/$id.resumo" 2>/dev/null)" ;;
        cancelada) cor=90 sinal='⊘' prog='cancelada  (r tenta de novo; se era arquivo grande, retoma de onde parou)' ;;
        interrompida) cor=31 sinal='✗' prog='interrompida: o processo parou (máquina suspensa ou desligada?)  (r tenta de novo)' ;;
        *) cor=31 sinal='✗' prog="falhou: $(causa_falha "$d/$id.log")  (l log · r tenta de novo)" ;;
      esac
      marca=' '; ((i == sel)) && marca='▶'
      tela+=$(printf '\033[1m%s%d\033[0m \033[%sm%s\033[0m %s' "$marca" "$i" "$cor" "$sinal" "$(corta "${nomes:-?}" $((w - 5)))")$'\033[K\n'
      tela+=$(printf '     \033[%sm%s\033[0m' "$cor" "$(corta "$prog" $((w - 5)))")$'\033[K\n'
      tela+=$(printf '     \033[90m%s\033[0m' "$(corta "$rota" $((w - 5)))")$'\033[K\n'
    done
    ((n)) || tela=$'\033[90mnenhuma transferência recente\033[0m\033[K\n'
    if [[ -n $pergunta ]]; then
      printf '\033[H\033[1m⇅ TRANSFERÊNCIAS\033[0m\033[K\n\033[K\n%s\033[K\n\033[33m%s\033[0m\033[K\033[J' "$tela" "$pergunta"
    else
      printf '\033[H\033[1m⇅ TRANSFERÊNCIAS\033[0m  \033[90m%s\033[0m\033[K\n\033[K\n%s\033[K\n\033[90m↑↓ escolhe · %sl log · r de novo · o abre destino · x limpa · q fecha\033[0m\033[K\033[J' \
        "$( ((n > cap)) && echo "$((off + 1))–$((off + cap < n ? off + cap : n)) de $n")" "$tela" "${ativos:+c cancela · }"
    fi
    tecla=""
    IFS= read -rsn1 -t 0.5 tecla || continue
    id=${ids[sel]:-}; estado=""; [[ -n $id ]] && estado=$(cat "$d/$id.status" 2>/dev/null)
    if [[ -n $pergunta ]]; then
      case $tecla in
        s | S | y | Y) kill -TERM -- "-$(cat "$d/$id.pid")" 2>/dev/null || kill -TERM "$(cat "$d/$id.pid")" 2>/dev/null
          atualizar_transferencia "$id" 'cancelada' ;;
      esac
      pergunta=""; continue
    fi
    case $tecla in
      q | Q | '') return ;;
      $'\e') resto=""; IFS= read -rsn2 -t 0.03 resto || true
        case $resto in
          '[A') ((sel > 1)) && sel=$((sel - 1)) ;;
          '[B') ((sel < n)) && sel=$((sel + 1)) ;;
          '') return ;;
        esac ;;
      k) ((sel > 1)) && sel=$((sel - 1)) ;;
      j) ((sel < n)) && sel=$((sel + 1)) ;;
      [1-9]) ((tecla >= 1 && tecla <= n)) && sel=$tecla ;;
      c)
        case $estado in 'na fila' | calculando* | transferindo*)
          total=0 feitos=0; [[ -r $d/$id.prog ]] && read -r total feitos taxa <"$d/$id.prog"; pct=0
          ((${total:-0} > 0)) && pct=$((${feitos:-0} * 100 / total))
          if ((pct >= 50)); then pergunta="Já passou de ${pct}%. Cancelar mesmo? (s/n)"
          else
            kill -TERM -- "-$(cat "$d/$id.pid")" 2>/dev/null || kill -TERM "$(cat "$d/$id.pid")" 2>/dev/null
            atualizar_transferencia "$id" 'cancelada'
          fi ;; esac ;;
      l)
        [[ -n $id && -s $d/$id.log ]] && { printf '\033[?25h'; sed 's/\x1b\[[0-9;]*m//g' "$d/$id.log" | less -R; printf '\033[?25l\033[2J'; } ;;
      r)
        case $estado in 'na fila' | calculando* | transferindo* | concluída*) ;; *)
          if [[ -s $d/$id.args ]]; then
            mapfile -d '' -t args <"$d/$id.args"
            rm -f "$d/$id".*
            printf '\033[2J\033[H'; transferir "${args[@]}"; sel=1; off=0
          fi ;; esac ;;
      o)
        if [[ -s $d/$id.args ]]; then
          mapfile -d '' -t args <"$d/$id.args"; dst=${args[2]}; ddst=${args[3]}
          if [[ $dst == . ]]; then abrir_pasta "$ddst" >/dev/null 2>&1; else rodar "$dst" --abrir-pasta "$ddst" >/dev/null 2>&1; fi
        fi ;;
      x)
        for f in "$d"/*.status; do
          [[ -f $f ]] || continue; id=${f##*/}; id=${id%.status}
          case $(estado_transferencia "$d" "$id") in 'na fila' | calculando* | transferindo*) ;; *) rm -f "$d/$id".* ;; esac
        done; sel=1; off=0; printf '\033[2J'; atualizar_barras ;;
    esac
  done
}

# Conta/soma os arquivos regulares (recursivo) de NOMES dentro de DIR: "N BYTES". Com --hash, um
# resumo sha256 independente de ordem e de nome (o destino pode renomear para "nome (2)").
conferir() {
  local hash=0 dir n; local -a lista=()
  [[ ${1:-} == --hash ]] && { hash=1; shift; }
  dir=$(expandir "$1"); shift
  for n in "$@"; do lista+=("./$n"); done
  (cd "$dir" 2>/dev/null || exit 1
   if ((hash)); then
     find "${lista[@]}" -type f -exec sha256sum {} + 2>/dev/null | cut -d' ' -f1 | sort | sha256sum | cut -d' ' -f1
   else
     find "${lista[@]}" -type f -printf '%s\n' 2>/dev/null | awk '{ n++; s += $1 } END { printf "%d %d\n", n, s }'
   fi)
}

# "LIVRE_BYTES CONFLITOS": espaço livre onde DIR está (ou estará) e quantos NOMES já existem lá.
destino_info() {
  local dir p n c=0 livre; dir=$(expandir "$1"); shift
  for n in "$@"; do [[ -e $dir/$n ]] && c=$((c + 1)); done
  p=$dir; while [[ ! -d $p && $p != / ]]; do p=$(dirname "$p"); done
  livre=$(df -Pk "$p" 2>/dev/null | awk 'NR == 2 { printf "%.0f", $4 * 1024 }')
  echo "${livre:-0} $c"
}

# Últimas rotas usadas ("envio" ou "traz"): modo, máquina e pasta. A mais recente fica em cima.
rota_lembrar() {
  local arq=$ESTADO_DIR/rotas-recentes
  mkdir -p "$ESTADO_DIR"
  { printf '%s\t%s\t%s\n' "$1" "$2" "$3"; grep -v -F -x "$(printf '%s\t%s\t%s' "$1" "$2" "$3")" "$arq" 2>/dev/null; } | head -n 20 >"$arq.tmp" && mv "$arq.tmp" "$arq"
}
rota_recente() { awk -F'\t' -v m="$1" '$1 == m { print $2 "\t" $3; exit }' "$ESTADO_DIR/rotas-recentes" 2>/dev/null; }

# Resumo antes de começar: itens, tamanho, conflitos (viram "nome (2)") e espaço no destino.
# ⏎ confirma; Esc ou q cancela; sem espaço suficiente, recusa. TT_SEM_CONFIRMAR=1 pula (scripts).
confirmar_transferencia() {
  local src=$1 dsrc=$2 dst=$3 ddst=$4; shift 4
  local bytes info livre=0 conf=0 k n=$#
  [[ ${TT_SEM_CONFIRMAR:-} == 1 || ! -t 0 ]] && return 0
  printf '\033[90mcalculando tamanho…\033[0m'
  bytes=$(rodar "$src" --tamanho "$dsrc" "$@" 2>/dev/null); bytes=${bytes//[!0-9]/}
  info=$(rodar "$dst" --destino-info "$ddst" "$@" 2>/dev/null); read -r livre conf <<<"$info"
  printf '\r\033[2K\033[1m⇅ Confirmar a transferência\033[0m\n\n  %d ite%s · %s\n  %s:%s → \033[1m%s:%s\033[0m\n' \
    "$n" "$([[ $n == 1 ]] && echo m || echo ns)" "$(humano "${bytes:-0}")" "$(rotulo "$src")" "$dsrc" "$(rotulo "$dst")" "$ddst"
  ((${conf:-0} > 0)) && printf '  \033[33m%d já existe%s lá: chega como "nome (2)"; nada é sobrescrito\033[0m\n' "$conf" "$([[ $conf == 1 ]] || echo m)"
  if [[ ${livre:-0} =~ ^[0-9]+$ ]] && ((livre > 0 && ${bytes:-0} > livre)); then
    printf '\n  \033[31m✗ não cabe: faltam %s (livre: %s)\033[0m\n\n\033[90m(tecla volta)\033[0m' "$(humano $((bytes - livre)))" "$(humano "$livre")"
    read -rsn1 k; return 1
  fi
  [[ ${livre:-0} =~ ^[0-9]+$ ]] && ((livre > 0)) && printf '  \033[90mlivre no destino: %s\033[0m\n' "$(humano "$livre")"
  printf '\n\033[90m⏎ envia · Esc cancela\033[0m'
  read -rsn1 k; [[ -z $k ]]
}

# Registro de quem chegou aqui (para a tela "Recebidos recentes"): epoch, origem, pasta, nome.
registrar_recebido() {
  local origem=$1 dir=$2 n arq=$ESTADO_DIR/recebidos.tsv; shift 2
  mkdir -p "$ESTADO_DIR"
  for n in "$@"; do printf '%s\t%s\t%s\t%s\n' "$(date +%s)" "$origem" "$dir" "$n"; done >>"$arq"
  [[ $(wc -l <"$arq") -gt 600 ]] && { tail -n 400 "$arq" >"$arq.tmp" && mv "$arq.tmp" "$arq"; }
  return 0
}

# Lista os últimos arquivos recebidos (mais novos primeiro). ⏎ abre a pasta onde chegou; ^o abre o
# próprio arquivo/pasta (xdg-open/explorer). Esc fecha.
recebidos() {
  local arq=$ESTADO_DIR/recebidos.tsv saida tecla linha dir nome
  [[ -s $arq ]] || { echo "Nada recebido ainda."; read -rsn1 -t 3; return 0; }
  saida=$(tac "$arq" | awk -F'\t' '{ printf "%s\t%s\t%s\t%s\t%s  \033[1m%s\033[0m  \033[90m← %s  %s\033[0m\n", $1, $2, $3, $4, strftime("%d/%m %H:%M", $1), $4, $2, $3 }' |
    fzf --ansi --delimiter='\t' --with-nth=5 --layout=reverse --no-sort --height=~18 --border=rounded \
      --border-label=' 📥 recebidos (⏎ abre a pasta onde chegou · ^o abre o item) ' --prompt='❯ ' --pointer='▶' \
      --expect=ctrl-o --bind='left-click:accept') || return 0
  tecla=$(sed -n 1p <<<"$saida"); linha=$(sed -n 2p <<<"$saida")
  [[ -n $linha ]] || return 0
  dir=$(cut -f3 <<<"$linha"); nome=$(cut -f4 <<<"$linha")
  if [[ $tecla == ctrl-o ]]; then
    dir=$(expandir "$dir")/$nome; [[ -d $dir ]] || dir=$(dirname "$dir")
    abrir_pasta "$dir" "${TT_CLIENTE:-}"
  else abrir_pasta "$dir" "${TT_CLIENTE:-}"; fi
}

# --- Cópia retomável de arquivo único -------------------------------------------------------
# "TAMANHO MTIME" se NOME é um arquivo regular em DIR; nada caso contrário.
info_arquivo() { local dir; dir=$(expandir "$1"); [[ -f $dir/$2 && ! -L $dir/$2 ]] && stat -c '%s %Y' -- "$dir/$2"; }

# Bytes já guardados no destino para a chave (0 se nenhum). Partes sem mudança há 3 dias somem.
parte_tamanho() {
  local dir; dir=$(expandir "$1"); mkdir -p "$dir" || return 1
  find "$dir" -maxdepth 1 -name '.tt-parte.*' -mtime +3 -delete 2>/dev/null
  if [[ -f $dir/.tt-parte.$2 ]]; then stat -c %s -- "$dir/.tt-parte.$2"; else echo 0; fi
}

# O arquivo a partir do byte OFFSET (0 = inteiro).
empacotar_de() { local dir; dir=$(expandir "$1"); tail -c "+$(($3 + 1))" -- "$dir/$2"; }

# Acrescenta o stdin à parte; quando ela chega a TAM bytes vira o arquivo final (nunca sobrescreve:
# conflito vira "nome (2)"). Fim de dados antes do tamanho (conexão caída) deixa a parte e falha.
receber_parte() {
  local dir chave=$2 nome=$3 tam=$4 parte atual base ext i alvo
  dir=$(expandir "$1"); mkdir -p "$dir" || return 1
  parte=$dir/.tt-parte.$chave
  cat >>"$parte" || return 1
  atual=$(stat -c %s -- "$parte" 2>/dev/null || echo 0)
  ((atual == tam)) || { echo "parte incompleta: $atual de $tam bytes" >&2; return 1; }
  alvo=$dir/$nome
  if [[ -e $alvo ]]; then
    base=$nome ext=""; [[ $nome == ?*.* ]] && base=${nome%.*} ext=".${nome##*.}"
    i=2; while [[ -e "$dir/$base ($i)$ext" ]]; do i=$((i + 1)); done
    alvo="$dir/$base ($i)$ext"
  fi
  mv -- "$parte" "$alvo" && basename "$alvo"
}

transferir_fundo() {
  local id=$1; shift
  printf '%s\n' "$$" >"$(dir_transferencias)/$id.pid"
  atualizar_transferencia "$id" 'calculando tamanho…'
  if transferir_bloqueante "$id" "$@"; then
    atualizar_transferencia "$id" 'concluída'
  else
    [[ $(cat "$(dir_transferencias)/$id.status" 2>/dev/null) == cancelada ]] && return
    atualizar_transferencia "$id" 'erro — veja o log'
    avisar "✗ transferência de $(rotulo "$1") falhou — ⇅ na barra mostra o log"
  fi
}

transferir() {
  local src=$1 dsrc=$2 dst=$3 ddst=$4; shift 4
  local d id
  d=$(dir_transferencias); mkdir -p "$d"; id="$(date +%H%M%S)-$RANDOM"
  printf '%s\t%s\t%s\t%s\n' "$(rotulo "$src")" "$dsrc" "$(rotulo "$dst")" "$ddst" >"$d/$id.info"
  printf '%s\n' "$@" >"$d/$id.nomes"
  printf '%s\0' "$src" "$dsrc" "$dst" "$ddst" "$@" >"$d/$id.args" # para "tentar de novo" na tela
  atualizar_transferencia "$id" 'na fila'
  # Sessão própria (setsid): o trabalho não pode depender do popup que o iniciou — ao fechar, o
  # tmux derruba o terminal do popup e, com ele, o ssh/tar de uma cópia ainda em curso.
  if command -v setsid >/dev/null; then
    setsid -f "$EU" --transferir-fundo "$id" "$src" "$dsrc" "$dst" "$ddst" "$@" >"$d/$id.log" 2>&1 </dev/null
  else
    nohup "$EU" --transferir-fundo "$id" "$src" "$dsrc" "$dst" "$ddst" "$@" >"$d/$id.log" 2>&1 </dev/null &
    printf '%s\n' "$!" >"$d/$id.pid"
  fi
  printf '\033[32m⇅ Transferência iniciada em segundo plano.\033[0m Você já pode continuar usando o tt; a barra mostra o andamento e avisa ao terminar.\n'
  sleep 1.2
}

# Repassa a entrada para a saída anotando em ARQ "total feitos bytes/s" (a tela das transferências
# lê dali o andamento). Sem python3, só repassa.
contador() {
  command -v python3 >/dev/null || { cat; return; }
  python3 -c '
import sys, time, os
arq, total = sys.argv[1], sys.argv[2]
i, o = sys.stdin.buffer, sys.stdout.buffer
feitos, t0, ult, base, tb = 0, time.time(), 0, 0, time.time()
def grava(taxa):
    tmp = arq + ".tmp"
    with open(tmp, "w") as f: f.write("%s %d %d\n" % (total, feitos, taxa))
    os.replace(tmp, arq)
taxa = 0
while True:
    b = i.read1(65536) if hasattr(i, "read1") else i.read(65536)
    if not b: break
    o.write(b); feitos += len(b)
    agora = time.time()
    if agora - ult >= 0.5:
        taxa = int((feitos - base) / max(agora - tb, 1e-3)); base, tb, ult = feitos, agora, agora
        o.flush(); grava(taxa)
o.flush(); grava(taxa)
' "$1" "$2"
}

# Copia NOMES de SRC:DIR_SRC para DST:DIR_DST (qualquer combinação de máquinas).
# Executada somente pelo trabalhador de fundo acima.
transferir_bloqueante() {
  local id=$1 src=$2 dsrc=$3 dst=$4 ddst=$5; shift 5
  local bytes t0 recebidos n
  bytes=$(rodar "$src" --tamanho "$dsrc" "$@")
  atualizar_transferencia "$id" "transferindo $(humano "$bytes")…"
  printf '\033[90m%s %s:%s → %s:%s (%s)…\033[0m\n' "$#" "$(rotulo "$src")" "$dsrc" "$(rotulo "$dst")" "$ddst" "$(humano "$bytes")"
  t0=$(date +%s)
  local h=""; [[ ${TT_CONFERIR:-} == 1 ]] && h=--hash
  local antes depois; local -a nomes_recebidos
  antes=$(rodar "$src" --conferir $h "$dsrc" "$@" 2>/dev/null)
  # Arquivo único e grande: copia por deslocamento, num ".tt-parte" no destino. Se a conexão cair, o
  # que já chegou fica lá e "r" (ou enviar de novo) continua dali, em vez de recomeçar do zero.
  # Pastas e vários itens seguem no pacote tar (sem retomada). Máquina com tt antigo cai no tar.
  local info tam mt chave off=""
  if (($# == 1)); then
    info=$(rodar "$src" --info-arquivo "$dsrc" "$1" 2>/dev/null); read -r tam mt <<<"$info"
    if [[ ${tam:-} =~ ^[0-9]+$ && ${mt:-} =~ ^[0-9]+$ ]] && ((tam >= ${TT_RETOMAR_MIN:-104857600})); then
      chave=$(printf '%s' "$(rotulo "$src"):$dsrc/$1:$tam:$mt" | sha1sum | cut -c1-16)
      off=$(rodar "$dst" --parte-tamanho "$ddst" "$chave" 2>/dev/null)
      [[ $off =~ ^[0-9]+$ ]] && ((off <= tam)) || off=""
    fi
  fi
  if [[ -n $off ]]; then
    if ((off > 0)); then printf '\033[33m↻ Retomando de %s (já chegou no destino).\033[0m\n' "$(humano "$off")"; else echo "Cópia retomável (arquivo grande)."; fi
    recebidos=$(rodar_io "$src" --empacotar-de "$dsrc" "$1" "$off" | contador "$(dir_transferencias)/$id.prog" "$((tam - off))" | rodar_io "$dst" --receber-parte "$ddst" "$chave" "$1" "$tam")
  else
    recebidos=$(rodar_io "$src" --empacotar "$dsrc" "$@" | contador "$(dir_transferencias)/$id.prog" "${bytes:-0}" | rodar_io "$dst" --receber "$ddst")
  fi
  n=$(grep -c . <<<"$recebidos")
  if ((n == 0)); then echo "✗ Nada chegou."; return 1; fi
  # Conferência: mesma contagem e bytes (ou o mesmo sha256 com TT_CONFERIR=1). Máquina com tt antigo
  # não conhece --conferir: então não há o que comparar e a cópia segue como concluída.
  mapfile -t nomes_recebidos <<<"$recebidos"
  depois=$(rodar "$dst" --conferir $h "$ddst" "${nomes_recebidos[@]}" 2>/dev/null)
  if [[ -n $antes && -n $depois && $antes != "$depois" ]]; then
    echo "⚠ Conferência: origem [$antes] e destino [$depois] diferem (algum arquivo mudou durante a cópia?)."
    printf '⚠ conferir: origem %s ≠ destino %s\n' "$antes" "$depois" >"$(dir_transferencias)/$id.aviso"
    avisar "⚠ $(rotulo "$src") → $(rotulo "$dst"): a conferência de tamanho não bateu. Veja ⇅ transferências"
  elif [[ -n $antes && $antes == "$depois" ]]; then
    echo "✓ Conferido ($([[ -n $h ]] && echo sha256 || echo "contagem e tamanho"))."
  fi
  rodar "$dst" --registrar-recebido "$(rotulo "$src")" "$ddst" "${nomes_recebidos[@]}" >/dev/null 2>&1
  printf '%s em %ss · %s\n' "$(humano "$bytes")" "$(($(date +%s) - t0))" "$(date +%H:%M)" >"$(dir_transferencias)/$id.resumo"
  printf '\033[32m✓ %d ite%s (%s) em %ss → %s:%s\033[0m\n' "$n" "$([[ $n == 1 ]] && echo m || echo ns)" "$(humano "$bytes")" "$(($(date +%s) - t0))" "$(rotulo "$dst")" "$ddst"
  sed 's/^/   /' <<<"$recebidos" | head -15
  printf '\033[36m📍 em %s: %s\033[0m\n' "$(rotulo "$dst")" "$(rodar "$dst" --caminho-visivel "$ddst")"
  avisar "✓ $n ite$([[ $n == 1 ]] && echo m || echo ns) de $(rotulo "$src") → $(rotulo "$dst"):$ddst"
  [[ $dst == . ]] || rodar "$dst" --avisar "📥 $n de $(rotulo "$src") → $(rodar "$dst" --caminho-visivel "$ddst" | sed 's/  (.*//'): $(head -3 <<<"$recebidos" | paste -sd, | cut -c1-60) · ⋯ painel → u abre" >/dev/null 2>&1
}

pasta_aqui() {
  if [[ -n ${TT_PANE:-} ]]; then tmux display-message -p -t "$TT_PANE" '#{pane_current_path}' | { read -r p; encurtar "$p"; }
  else encurtar "$PWD"; fi
}

fim_transferencia() {
  local r
  read -rsn1 -p $'\n\033[90ma: abrir a pasta lá  ·  qualquer outra tecla fecha\033[0m' r
  [[ $r == [aA] ]] && rodar "$1" --abrir-pasta "$2" >/dev/null 2>&1
  return 0
}

# Fluxo "enviar": arquivos ou pastas de SRC (navegando a partir de DIR) → máquina e pasta escolhidas.
enviar_fluxo() {
  local src=${1:-.} dir=${2:-$(pasta_aqui)} dst=${3:-} ddst=${4:-} lista pasta
  local -a nomes
  lista=$(escolher_arquivos "$src" "$dir" "arquivos ou pastas para enviar") || return 0
  pasta=$(head -1 <<<"$lista"); mapfile -t nomes < <(tail -n +2 <<<"$lista")
  ((${#nomes[@]})) || return 0
  if [[ -z $dst && -z $ddst && -t 0 ]]; then repetir_rota envio dst ddst "📤 enviar para"; fi
  [[ -n $dst ]] || dst=$(escolher_maquina "📤 enviar ${#nomes[@]} ite$([[ ${#nomes[@]} == 1 ]] && echo m || echo ns) para" "$src") || return 0
  [[ -n $dst ]] || return 0
  [[ -n $ddst ]] || ddst=$(escolher_destino "$dst" "" "📤 para qual pasta") || return 0
  confirmar_transferencia "$src" "$pasta" "$dst" "$ddst" "${nomes[@]}" || return 0
  rota_lembrar envio "$dst" "$ddst"
  transferir "$src" "$pasta" "$dst" "$ddst" "${nomes[@]}"
}

# Oferece repetir a última rota do MODO: ⏎ aceita e preenche as duas variáveis (nomes em $2 e $3);
# outra tecla segue para a escolha normal. Só oferece se a máquina ainda está cadastrada.
repetir_rota() {
  local modo=$1 v1=$2 v2=$3 rotulo_txt=$4 r m p k
  r=$(rota_recente "$modo"); [[ -n $r ]] || return 0
  m=${r%%$'\t'*}; p=${r#*$'\t'}
  [[ $m == . || -n $(maquinas | awk -v m="$m" '$1 == m') ]] || return 0
  printf '\033[2J\033[H\033[1m↻ %s\033[0m  %s:%s\n\n\033[90m⏎ repete · outra tecla escolhe\033[0m' "$rotulo_txt" "$(rotulo "$m")" "$p"
  read -rsn1 k; [[ -z $k ]] || return 0
  printf -v "$v1" '%s' "$m"; printf -v "$v2" '%s' "$p"
}

# Fluxo "trazer": escolhe máquina, pasta de partida e arquivos/pastas de lá → DST:DDST (padrão: aqui).
trazer_fluxo() {
  local src=${1:-} dir=${2:-} dst=${3:-.} ddst=${4:-$(pasta_aqui)} lista pasta
  local -a nomes
  if [[ -z $src && -z $dir && -t 0 ]]; then repetir_rota traz src dir "📥 trazer de"; fi
  [[ -n $src ]] || src=$(escolher_maquina "📥 trazer de qual máquina" "$dst") || return 0
  [[ -n $src ]] || return 0
  [[ -n $dir ]] || dir=$(escolher_destino "$src" "" "📥 começar em qual pasta") || return 0
  lista=$(escolher_arquivos "$src" "$dir" "arquivos ou pastas para trazer") || return 0
  pasta=$(head -1 <<<"$lista"); mapfile -t nomes < <(tail -n +2 <<<"$lista")
  ((${#nomes[@]})) || return 0
  confirmar_transferencia "$src" "$pasta" "$dst" "$ddst" "${nomes[@]}" || return 0
  rota_lembrar traz "$src" "$dir"
  transferir "$src" "$pasta" "$dst" "$ddst" "${nomes[@]}"
}

# Linha de comando: tt --enviar [arquivos-ou-pastas…] [máquina[:pasta]]  /
# tt --trazer máquina:caminho… [pasta]. Uma pasta é transferida inteira, recursivamente.
enviar_cli() {
  local ultimo dst="" ddst="" maq a dir pasta nome seguro
  local -a arqs=("$@") ordem=() nomes_grupo
  local -A grupo=()
  # tt --enviar --stdin NOME [máquina[:pasta]]: o que vier no stdin vira o arquivo NOME no destino
  # (ex.: `tar c pasta | tt --enviar --stdin pasta.tar dell`). Fica em ~/.cache/tt-stdin até o dia seguinte.
  if [[ ${arqs[0]:-} == --stdin ]]; then
    nome=${arqs[1]:-}; [[ -n $nome ]] || { echo "uso: ... | tt --enviar --stdin NOME [máquina[:pasta]]"; return 1; }
    [[ -t 0 ]] && { echo "--stdin espera dados pelo pipe (… | tt --enviar --stdin NOME)"; return 1; }
    seguro=$(basename -- "$nome"); pasta="$HOME/.cache/tt-stdin/$(date +%H%M%S)-$RANDOM"
    find "$HOME/.cache/tt-stdin" -mindepth 1 -maxdepth 1 -type d -mtime +1 -exec rm -rf {} + 2>/dev/null
    mkdir -p "$pasta" && cat >"$pasta/$seguro" || { echo "não consegui gravar o stdin"; return 1; }
    arqs=("$pasta/$seguro" "${arqs[@]:2}")
  fi
  if ((${#arqs[@]})); then
    ultimo=${arqs[-1]}; maq=${ultimo%%:*}
    if [[ -n $(dest_de "$maq") && ! -e $ultimo ]]; then
      dst=$(dest_de "$maq"); [[ $ultimo == *:* ]] && ddst=${ultimo#*:}
      unset 'arqs[-1]'
    fi
  fi
  if ((${#arqs[@]} == 0)); then enviar_fluxo . "$(encurtar "$PWD")" "$dst" "$ddst"; return; fi
  [[ -n $dst ]] || dst=$(escolher_maquina "📤 enviar para" .) || return 1
  [[ -n $ddst ]] || ddst=$(rodar "$dst" --pasta-recebidos)
  # Itens da mesma pasta viajam num trabalho só (um pacote, uma linha na tela das transferências).
  for a in "${arqs[@]}"; do
    [[ -e $a ]] || { echo "Não existe: $a"; return 1; }
    dir=$(cd "$(dirname "$a")" && encurtar "$PWD")
    [[ -n ${grupo[$dir]+x} ]] || ordem+=("$dir")
    grupo[$dir]+="$(basename "$a")"$'\n'
  done
  for dir in "${ordem[@]}"; do
    mapfile -t nomes_grupo <<<"${grupo[$dir]%$'\n'}"
    transferir . "$dir" "$dst" "$ddst" "${nomes_grupo[@]}"
  done
}

trazer_cli() {
  local a maq src caminho ddst
  local -a origens=()
  for a in "$@"; do
    maq=${a%%:*}
    if [[ $a == *:* && -n $(dest_de "$maq") ]]; then origens+=("$a"); else ddst=$a; fi
  done
  ddst=${ddst:-$(encurtar "$PWD")}
  if ((${#origens[@]} == 0)); then trazer_fluxo "" "" . "$ddst"; return; fi
  for a in "${origens[@]}"; do
    src=$(dest_de "${a%%:*}"); caminho=${a#*:}
    transferir "$src" "$(dirname "$caminho")" . "$ddst" "$(basename "$caminho")"
  done
}


# --- Botão ✕ nas listas -----------------------------------------------------
#
# Cada sessão (e painel) da central e do seletor tem um ✕ alinhado à direita. O fzf só informa a
# LINHA clicada, então a lista roda atrás de uma camada fina (com_mouse) que anota a coluna de cada
# clique antes de repassá-lo; o clique decide: no ✕ → "fechar? ✕" (2º toque fecha), no resto →
# abre. Sem python3, a lista roda direto (sem ✕).

# Roda CMD com o terminal passando por um pty, anotando em ARQ "coluna linha" de cada clique.
com_mouse() {
  local arq=$1; shift
  command -v python3 >/dev/null || { "$@"; return; }
  # Não deixe uma coordenada de um menu anterior decidir o próximo clique se houver resize ou
  # perda de pacote de mouse antes de o fzf receber o evento atual.
  : >"$arq"
  local codigo
  # O código vai por -c: a entrada padrão é a lista que o fzf tem de ler.
  codigo=$(cat <<'PYEOF'
import os, sys, tty, termios, select, signal, fcntl, re
arq, cmd = sys.argv[1], sys.argv[2:]  # (com -c, argv[0] é "-c")
try:
    tfd = os.open('/dev/tty', os.O_RDWR)
except OSError:
    os.execvp(cmd[0], cmd)
tam = fcntl.ioctl(tfd, termios.TIOCGWINSZ, b'\0' * 8)
mfd, sfd = os.openpty()
fcntl.ioctl(sfd, termios.TIOCSWINSZ, tam)
pid = os.fork()
if pid == 0:
    os.close(mfd); os.close(tfd)
    os.setsid()
    fcntl.ioctl(sfd, termios.TIOCSCTTY, 0)
    os.dup2(sfd, 2)
    os.close(sfd)
    os.execvp(cmd[0], cmd)
os.close(sfd)
antes = termios.tcgetattr(tfd)
tty.setraw(tfd)
clique = re.compile(rb'\x1b\[<(\d+);(\d+);(\d+)([Mm])')
pendente = b''
def winch(*_):
    try:
        fcntl.ioctl(mfd, termios.TIOCSWINSZ, fcntl.ioctl(tfd, termios.TIOCGWINSZ, b'\0' * 8))
        os.kill(pid, signal.SIGWINCH)
    except OSError:
        pass
signal.signal(signal.SIGWINCH, winch)
try:
    while True:
        try:
            r, _, _ = select.select([tfd, mfd], [], [])
        except InterruptedError:
            continue
        if tfd in r:
            d = os.read(tfd, 4096)
            if not d:
                break
            # Leituras do pty podem partir uma sequência SGR de mouse em duas chamadas.
            # Conserva apenas o começo possivelmente incompleto, sem repetir evento processado.
            dados = pendente + d
            fim = 0
            for m in clique.finditer(dados):
                fim = m.end()
                botao = int(m.group(1))
                # Esquerdo pressionado (inclusive modificadores); arrasto e soltura não mudam
                # a coordenada. Os bytes inteiros seguem para o fzf logo abaixo.
                if m.group(4) == b'M' and botao & 3 == 0 and not botao & 32:
                    with open(arq, 'w') as f:
                        f.write(m.group(2).decode() + ' ' + m.group(3).decode())
            resto = dados[fim:]
            inicio = resto.rfind(b'\x1b[<')
            pendente = resto[inicio:] if inicio >= 0 else b''
            os.write(mfd, d)
        if mfd in r:
            try:
                d = os.read(mfd, 65536)
            except OSError:
                break
            if not d:
                break
            os.write(tfd, d)
finally:
    termios.tcsetattr(tfd, termios.TCSAFLUSH, antes)
_, st = os.waitpid(pid, 0)
sys.exit(os.waitstatus_to_exitcode(st))
PYEOF
)
  python3 -c "$codigo" "$arq" "$@"
}

# Colunas da área de texto da lista e onde ela começa na tela (1 = primeira coluna), conforme o
# menu (TT_COMX: seletor | central) e o tamanho da tela.
geometria_x() {
  local cols=${FZF_COLUMNS:-0} lista ini
  # No evento "start" o fzf ainda não desenhou e FZF_COLUMNS vem 0: lê do terminal.
  ((cols > 10)) || cols=$(stty size </dev/tty 2>/dev/null | awk '{ print $2 }')
  ((${cols:-0} > 10)) || cols=80
  case ${TT_COMX:-} in
    seletor)
      lista=$cols; ini=3
      [[ -n ${TT_PREVIA:-} ]] && lista=$((cols - (cols * 55 + 99) / 100 - 1)) ;;
    central)
      if [[ -n ${TT_COMPACTO:-} ]]; then lista=$cols; ini=3; else lista=$((cols - 4)); ini=5; fi ;;
    *) return 1 ;;
  esac
  echo "$((lista - 3)) $ini" # texto útil (tira o ▶ e a barra de rolagem), início do texto
}

# Filtro: põe o ✕ no fim do campo 3 de cada linha de sessão/painel ("destino<TAB>chave<TAB>texto…").
com_x() {
  local g w ini
  g=$(geometria_x) || { cat; return; }
  read -r w ini <<<"$g"
  local fx="" r sn id d
  # fixadas() tem 3 campos (rótulo, sessão, id). Sem a 3ª variável, o id entrava em $sn (com o
  # TAB) e a chave "$d|$sn" nunca casava com "destino|sessão" da linha: o pino da central ficava
  # sempre 📍 mesmo com a sessão fixada.
  while IFS=$'\t' read -r r sn id; do
    d=$(dest_de "$r"); [[ -n $d ]] && fx+="$d|$sn"$'\n'
  done < <(fixadas)
  python3 -c '
import sys, re, unicodedata
w = int(sys.argv[1]); conf = sys.argv[2]; fix = set(sys.argv[3].split("\n"))
ansi = re.compile(r"\x1b\[[0-9;]*m")
def largura(t):
    t = ansi.sub("", t)
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in t)
def cortar(t, n):
    out, u, i = [], 0, 0
    partes = re.split(r"(\x1b\[[0-9;]*m)", t)
    for p in partes:
        if ansi.fullmatch(p or "x"):
            out.append(p); continue
        for c in p:
            cw = 0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1
            if u + cw > n: return "".join(out) + "\x1b[0m"
            out.append(c); u += cw
    return "".join(out)
for linha in sys.stdin:
    linha = linha.rstrip("\n")
    c = linha.split("\t")
    if len(c) < 3 or c[1].startswith(("!", "+")) or not c[1]:
        print(linha); continue
    if c[0] + "|" + c[1] == conf:
        x = "\x1b[1;31mfechar? ✕\x1b[0m"; xl = 9
    else:
        x = "\x1b[90m✕\x1b[0m"; xl = 1
    if c[1].startswith("%"): pino = "  "
    else: pino = "📌" if c[0] + "|" + c[1] in fix else "📍"
    x = pino + "  " + x
    alvo = w - xl - 5
    t = c[2]
    if largura(t) > alvo: t = cortar(t, alvo - 1) + "…"
    c[2] = t + " " * (alvo - largura(t)) + " " + x
    print("\t".join(c))
' "$w" "$(estado confirmar)" "$fx" 2>/dev/null || cat
}

# Clique numa linha (MODO: seletor | central). No ✕: 1º toque pede confirmação, 2º fecha.
# Fora dele: abre (e esquece uma confirmação pendente).
clique_linha() {
  local dest=$1 chave=$2 g w ini xc yc lista
  [[ $TT_COMX == central ]] && lista="$EU --listar-tudo" || lista="$EU --lista-seletor"
  # TT_CLIQUE_LOG=arquivo registra cada decisão (diagnóstico de cliques que caem no lugar errado).
  [[ -n ${TT_CLIQUE_LOG:-} ]] && printf '%s dest=%s chave=%s cols=%s mouse=[%s] confirmar=%s\n' "$(date +%T.%N)" "$dest" "$chave" "${FZF_COLUMNS:-?}" "$(cat "${TT_MOUSE:-/dev/null}" 2>/dev/null)" "$(estado confirmar)" >>"$TT_CLIQUE_LOG"
  if [[ -z $chave || $chave == '!'* || $chave == '+'* ]] || ! g=$(geometria_x) || [[ ! -s ${TT_MOUSE:-} ]]; then
    [[ -n ${TT_CLIQUE_LOG:-} ]] && echo "  -> accept (chave especial, sem geometria ou sem coordenada do mouse)" >>"$TT_CLIQUE_LOG"
    estado_por confirmar ""; echo accept; return
  fi
  read -r w ini <<<"$g"
  read -r xc yc <"$TT_MOUSE"
  local xl=1 x_ini pino_ini
  [[ $(estado confirmar) == "$dest|$chave" ]] && xl=9
  x_ini=$((ini + w - xl))          # 1ª coluna do ✕ (ou de "fechar? ✕")
  pino_ini=$((x_ini - 4))          # o pino ocupa 2 colunas, seguido de 2 espaços
  [[ -n ${TT_CLIQUE_LOG:-} ]] && echo "  w=$w ini=$ini xc=$xc x_ini=$x_ini pino_ini=$pino_ini" >>"$TT_CLIQUE_LOG"
  if [[ $chave != %* ]] && ((xc >= pino_ini - 1 && xc <= pino_ini + 2)); then
    estado_por confirmar ""
    "$EU" --alternar-fixada "$dest" "$chave" >/dev/null 2>&1
    echo "reload($lista)"
    return
  fi
  if ((xc >= x_ini - 1)); then
    if [[ $(estado confirmar) == "$dest|$chave" ]]; then
      estado_por confirmar ""
      "$EU" --fechar "$dest" "$chave" >/dev/null 2>&1
    else
      estado_por confirmar "$dest|$chave"
    fi
    echo "reload($lista)"
  else
    estado_por confirmar ""
    echo accept
  fi
}

escolher() {
  local rotulo_borda=" 🖥  terminais · $MAQUINA " borda=rounded prev_janela='down,55%,border-top,follow'
  if compacto; then
    export TT_COMPACTO=1
    borda=none prev_janela='down,50%,border-top,follow,hidden'
  else
    unset TT_COMPACTO
  fi
  case ${TT_MODO:-} in
    lado) rotulo_borda+="· ⏎ abre ao lado " ;;
    embaixo) rotulo_borda+="· ⏎ abre embaixo " ;;
    aqui) rotulo_borda+="· ⏎ troca o painel " ;;
  esac
  export TT_COMX=central TT_MOUSE="$TT_ESTADO.mouse"
  # <(…) e não "listar_tudo |": o bash espera todos os estágios de um pipeline, então depois do Esc
  # ele ficava esperando a consulta às outras máquinas (ssh) acabar, e o quadro do popup não fechava.
  com_mouse "$TT_MOUSE" fzf --ansi --delimiter='\t' --with-nth=3,4 --nth="$(nth_atual)" --exact --no-hscroll --ellipsis='' \
    --tiebreak=begin,index --layout=reverse \
