}

sair_menu() { [[ -n ${TT_ESTADO:-} ]] && rm -f "$TT_ESTADO" "$TT_ESTADO.lista" "$TT_ESTADO.pos"; }

# Chamados por cliques, menus e ganchos do tmux (run-shell): calados e sempre com sucesso — se
# imprimem algo ou falham, o tmux abre por cima do painel um modo de leitura com a mensagem, que
# esconde o menu/popup (parecia que o menu "sumia").
case "${1:-}" in
  --ir-fixada | --mover-fixada | --aplicar-fixadas | --clique | --menu-painel | --menu-tmux | --menu-arquivos | --menu-maquinas | --menu-admin | --menu-sessao | --clique-direito | --nova-e-ir | --seletor-em | --bordas | --guarda-tamanho | --ajustar | --soltar | --vigia)
    exec >/dev/null 2>&1
    trap 'exit 0' EXIT
    trap 'exit 0' TERM INT HUP ;; # o vigia é encerrado com TERM a cada atualização
esac

case "${1:-}" in
  --listar) listar; exit ;;
  --nome) echo "$MAQUINA"; exit ;;
  --copiar) copiar; exit 0 ;;
  --copiar-buffer) tmux save-buffer - 2>/dev/null | copiar; exit 0 ;;
  --versao) versao; exit ;;
  --sincronizar) shift; sincronizar "$@"; exit ;;
  --atualizar) atualizar "${2:-}"; exit ;;
  --tema-agentes) "$DIR_TT/tema-agentes.sh" --aplicar; exit ;;
  --verificar-atualizacao) verificar_atualizacao; exit ;;
  --cadastrar) shift; cadastrar "$@"; exit ;;
  --descadastrar) shift; descadastrar "$@"; exit ;;
  --registrar) registrar "$2" "$3" "$4"; exit ;;
  --desregistrar) desregistrar "$2"; exit ;;
  --candidatas) candidatas; exit ;;
  --instalar-aqui) instalar_aqui; exit ;;
  --instalar)
    # Primeira instalação a partir de um clone: grava o repositório como origem e instala aqui.
    [[ -d $REPO_TT/.git ]] || { echo "Rode de dentro do clone do repositório (./tt --instalar)."; exit 1; }
    mkdir -p "$CONF_DIR"; grep -v '^repo=' "$CONF" 2>/dev/null >"$CONF.novo"; echo "repo=$REPO_TT" >>"$CONF.novo"; mv "$CONF.novo" "$CONF"
    instalar_em . "${2:-}" || { echo "A instalação falhou."; exit 1; }
    [[ -n ${TT_SEM_BASHRC:-} ]] || configurar_bashrc
    echo "Pronto. Abra um terminal novo e rode: tt   (ou, no tmux, Ctrl+B s)"
    exit ;;
  --botao) botao "$2" "$3" "$4" "${5:-}"; exit ;;
  --configurar-bashrc) configurar_bashrc; exit ;;
  --remover-bashrc) remover_bashrc; exit ;;
  --desinstalar-aqui) desinstalar_aqui; exit ;;
  --pacote) pacote; exit ;;
  --listar-pasta) listar_pasta "$2" "${3:-}" "${4:-}"; exit ;;
  --listar-pasta-em) rodar "$(estado arq_dest)" --listar-pasta "$(estado arq_dir)" "$(estado arq_ocultos)" "$(estado arq_modo)"; exit ;;
  --previa-item) previa_item "$2" "$3"; exit ;;
  --previa-item-em) [[ $2 == x ]] || rodar "$(estado arq_dest)" --previa-item "$(estado arq_dir)" "$3"; exit ;;
  --resolver-pasta) resolver_pasta "$2"; exit ;;
  --arq-acao) arq_acao "$2" "${3:-}" "${4:-}"; exit ;;
  --cabecalho-arquivos) cabecalho_arquivos; exit ;;
  --pastas-sessoes) pastas_sessoes; exit ;;
  --pasta-de) [[ $2 == %* ]] && t=$2 || t="=$2:"; tmux display-message -p -t "$t" '#{pane_current_path}' | { read -r x; encurtar "$x"; }; exit ;;
  --receber) receber "$2"; exit ;;
  --transferir-fundo) shift; transferir_fundo "$@"; exit ;;
  --transferencias-barra) transferencias_barra; exit ;;
  --transferencias) transferencias; exit ;;
  --empacotar) shift; empacotar "$@"; exit ;;
  --tamanho) shift; tamanho "$@"; exit ;;
  --avisar) avisar "$2"; exit ;;
  --pasta-recebidos) pasta_recebidos; exit ;;
  --destinos) destinos; exit ;;
  --definir-recebidos) definir_recebidos "$2"; exit ;;
  --pasta-padrao)
    TT_ESTADO=$(mktemp "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/tt-menu.XXXXXX"); export TT_ESTADO
    trap 'rm -f "$TT_ESTADO"' EXIT
    pasta_padrao_cli "${2:-}"; exit ;;
  --caminho-visivel) caminho_visivel "$2"; exit ;;
  --abrir-pasta) abrir_pasta "$2" "${3:-}"; exit ;;
  --menu-arquivos) menu_arquivos "$2" "${3:-}"; exit ;;
  --menu-maquinas) menu_maquinas "$2" "${3:-}"; exit ;;
  --menu-admin) menu_admin "$2" "${3:-}"; exit ;;
  --menu-sessao) menu_sessao "$2" "${3:-}"; exit ;;
  --clique-direito) clique_direito "$2" "$3" "$4" "${5:-0}"; exit ;;
  --nova-e-ir) nova_e_ir "$2"; exit ;;
  --atualizar-info) atualizar_info; exit ;;
  --menu-popup-ui) menu_popup_ui "$2"; exit ;;
  --enviar | --trazer)
    TT_ESTADO=$(mktemp "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/tt-menu.XXXXXX"); export TT_ESTADO
    trap 'rm -f "$TT_ESTADO"' EXIT
    a=$1; shift
    if [[ $a == --enviar ]]; then enviar_cli "$@"; else trazer_cli "$@"; fi
    exit ;;
  --listar-tudo) listar_tudo; exit ;;
  --previa) previa "$2" "${3:-}"; exit ;;
  --previa-em) previa_em "$2" "$3" "${4:-}"; exit ;;
  --fechar) fechar_em "$2" "$3"; exit ;;
  --cabecalho) cabecalho; exit ;;
  --clique-cabecalho) clique_cabecalho "${2:-}"; exit ;;
  --clique) clique "$2" "$3" "$4" "${5:-$HOME}" "${6:-0}"; exit ;;
  --menu-painel) menu_painel "$2" "$3"; exit ;;
  --menu-tmux) menu_tmux "$2" "${3:-}"; exit ;;
  --listar-leve) listar_leve; exit ;;
  --ajustar) ajustar "$2"; exit ;;
  --fechar-vazias) fechar_vazias "${2:-}"; exit ;;
  --bordas) bordas; exit ;;
  --clique-linha) clique_linha "${2:-}" "${3:-}"; exit ;;
  --barra-fixadas) barra_fixadas "${2:-}"; exit ;;
  --aplicar-fixadas) aplicar_fixadas; exit ;;
  --receber-fixadas) receber_fixadas "${2:-0}"; exit ;;
  --puxar-fixadas) puxar_fixadas; exit ;;
  --marcar-fixadas) marcar_fixadas; exit ;;
  --propagar-fixadas) propagar_fixadas; exit ;;
  --ir-fixada) ir_fixada "$2" "$3"; exit ;;
  --mover-fixada) mover_fixada "$2" "$3"; exit ;;
  --alternar-fixada-rotulo) alternar_fixada "$2" "$3"; exit ;;
  --alternar-fixada) # DEST CHAVE (do seletor)
    [[ -n $3 && $3 != '!'* && $3 != '+'* && $3 != '%'* ]] && alternar_fixada "$(rotulo "$2")" "$3" >/dev/null; exit ;;
  --fixar) # [máquina:]sessão
    a=${2:?uso: tt --fixar [máquina:]sessão}; [[ $a == *:* ]] && alternar_fixada "${a%%:*}" "${a#*:}" || alternar_fixada "$MAQUINA" "$a"; exit ;;
  --fixadas) fixadas; exit ;;
  --guarda-tamanho) guarda_tamanho; exit ;;
  --ciclo) fecha_ciclo "$2" "$3" && echo "fecha ciclo" || echo "ok, sem ciclo"; exit ;;
  --lista-seletor) lista_seletor_salva | com_x; exit ;;
  --lista-rapida) lista_rapida_salva; exit ;;
  --pos-atual) pos_atual; exit ;;
  --cabecalho-seletor) cabecalho_seletor; exit ;;
  --clique-seletor) clique_seletor "${2:-}"; exit ;;
  --seletor-em) seletor_em "$2" "${3:-}" "${4:-}"; exit ;;
  --seletor) TT_ESTADO=$(mktemp "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/tt-menu.XXXXXX"); export TT_ESTADO
             trap 'rm -f "$TT_ESTADO" "$TT_ESTADO.lista" "$TT_ESTADO.pos"' EXIT; seletor; exit ;;
  --ir-ponte) ir_ponte "$2" "$3" "$4"; exit ;;
  --ponte) ponte "$2" "$3" "$4"; exit ;;
  --focar) focar "$2"; exit ;;
  --soltar) soltar_painel "$2"; exit ;;
  --renomear-painel) renomear_painel "$2"; exit ;;
  --maquinas) maquinas; exit ;;
  --nova) nome=$(limpar "${2:-}"); nome=${nome:-$(proximo_nome)}
          tmux new-session -d -s "$nome" -c "$HOME" && echo "$nome"; exit ;;
  --adotar) adotar "$2"; exit ;;
  --sugerir) sugerir_nome "$2"; exit ;;
  --renomear) renomear_interativo "${2:-$(tmux display-message -p '#{session_name}')}"; exit ;;
  --nomear-todas) nomear_todas; exit ;;
  --vigia) vigiar; exit ;;
  --janela) exec tmux new-session -s "$(proximo_nome)" ;;
esac

TT_ESTADO=$(mktemp "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/tt-menu.XXXXXX")
export TT_ESTADO
trap sair_menu EXIT

while true; do
  saida=$(escolher) || [ -n "$saida" ] || exit 0
  # Saída do fzf: [ação impressa por print(...)] e a linha escolhida (pode faltar).
  linha=$(tail -1 <<<"$saida")
  acao=""
  if [[ $linha != *$'\t'* ]]; then acao=$linha; linha=$(sed -n 1p <<<"$saida" | grep $'\t')
  elif (($(wc -l <<<"$saida") > 1)); then acao=$(head -1 <<<"$saida"); fi
  dest=$(cut -f1 <<<"$linha"); dest=${dest:-.}
  alvo=$(cut -f2 <<<"$linha")
  [[ -z $acao ]] && acao=${TT_MODO:-}

  case $alvo in
    !autorizar)
      echo "Abra o link abaixo e aprove; o menu volta sozinho em seguida."
      ssh "${SSH_OPC[@]}" -o ConnectTimeout=300 "$dest" true </dev/null || read -rp "Não deu certo. Enter para voltar."
      continue ;;
    !instalar)
      ssh "${SSH_OPC[@]}" "$dest" 'mkdir -p ~/.local/bin && cat >~/.local/bin/tt && chmod +x ~/.local/bin/tt' <"$EU" &&
        echo "Instalado em $dest." || read -rp "Falhou. Enter para voltar."
      sleep 1; continue ;;
    !erro) continue ;;
    !vazias) confirmar_vazias "$dest"; continue ;;
    !nova) acao=nova ;;
  esac

  case $acao in
    tmux | maquinas)
      # Menus do tmux não abrem por cima deste popup: agenda e fecha a central.
      tmux run-shell -b "sleep 0.15; $EU --menu-$([[ $acao == tmux ]] && echo tmux || echo maquinas) '${TT_CLIENTE:-}' '${TT_PANE:-}'"
      exit 0 ;;
    enviar | trazer)
      [[ -n $alvo && $alvo != [!+]* ]] || { read -rp "Escolha uma sessão (ou painel): os arquivos vão para a pasta dela / vêm de lá. Enter."; continue; }
      pasta=$(rodar "$dest" --pasta-de "$alvo")
      if [[ $acao == enviar ]]; then enviar_fluxo . "$(pasta_aqui)" "$dest" "$pasta"
      else trazer_fluxo "$dest" "$pasta" . "$(pasta_aqui)"; fi
      continue ;;
    nomear)
      printf '\033[90mDando nome às sessões genéricas de %s…\033[0m\n' "$(rotulo "$dest")"
      rodar_tty "$dest" --nomear-todas; sleep 1
      continue ;;
    renomear)
      case $alvo in
        '' | +*) ;;
        %*) rodar_tty "$dest" --renomear-painel "$alvo" ;;
        *) rodar_tty "$dest" --renomear "$alvo" ;;
      esac
      continue ;;
    soltar)
      if [[ $alvo == %* ]]; then rodar "$dest" --soltar "$alvo" >/dev/null
      else read -rp "^t solta um painel (as linhas ├ └ embaixo de uma sessão) como sessão própria. Enter."; fi
      continue ;;
    nova)
      read -rp "Nome da nova sessão em $(rotulo "$dest") [automático]: " nome
      alvo=$(rodar "$dest" --nova "$nome") || continue
      acao="" ;;
  esac
  [[ -n $alvo ]] || continue

  if [[ $alvo == +* ]]; then
    echo "Adotando a janela em $(rotulo "$dest")..."
    if ! alvo=$(rodar "$dest" --adotar "${alvo#+}"); then
      read -rp "Enter para voltar ao menu."
      continue
    fi
  fi
  # Painel: põe ele em foco e passa a tratar da sessão dele.
  [[ $alvo == %* ]] && { alvo=$(rodar "$dest" --focar "$alvo") || continue; }

  case $acao in
    lado | embaixo | aqui) abrir_painel "$acao" "$dest" "$alvo" && exit 0; continue ;;
  esac

  ir_para "$dest" "$alvo"
  # Dentro do tmux (popup), entrou: fecha. Quem trocou a tela pode ter sido a máquina de origem
  # (ponte), e aí ir_para volta aqui em vez de substituir este processo. Fora do tmux (celular),
  # voltar ao menu ao sair da sessão é o esperado.
  [[ -n ${TMUX:-} ]] && exit 0
done
