email_conf_arq() { echo "$EMAIL_DIR/$1.conf"; }
email_cred_arq() { echo "$SECRETS_DIR/aerc-$1.txt"; }

# Carrega a conta SLUG no array associativo global E.
email_ler() {
  local f k v; f=$(email_conf_arq "$1"); [[ -r $f ]] || return 1
  E=(); E[_slug]=$1
  while IFS= read -r l; do [[ $l == *=* && $l != \#* ]] || continue; k=${l%%=*}; v=${l#*=}; E[$k]=$v; done <"$f"
}

email_gravar() {
  local slug=${E[_slug]} f k
  mkdir -p "$EMAIL_DIR"; f=$(email_conf_arq "$slug")
  { echo "# conta de e-mail do tt (sem segredos; o segredo fica em $(email_cred_arq "$slug"))"
    for k in "${EMAIL_CHAVES[@]}"; do [[ -z ${E[$k]:-} ]] || printf '%s=%s\n' "$k" "${E[$k]}"; done; } >"$f.tmp" && mv "$f.tmp" "$f"
}

# Snapshot privado para cadastro/edição transacional. Se autorização ou teste falhar, todos os
# arquivos locais voltam exatamente ao estado anterior; conta nova inválida não deixa resíduos.
email_snapshot_criar() { # slug
  local slug=$1 d nome arq
  d=$(mktemp -d "${TMPDIR:-/tmp}/tt-email-snapshot.XXXXXX") || return 1
  chmod 700 "$d"
  while IFS='|' read -r nome arq; do
    if [[ -e $arq ]]; then cp -p "$arq" "$d/$nome" || { rm -rf "$d"; return 1; }; : >"$d/$nome.existe"; fi
  done <<EOF
conf|$(email_conf_arq "$slug")
cred|$(email_cred_arq "$slug")
client_secret|$SECRETS_DIR/aerc-$slug.client_secret
accounts|$AERC_CONTAS
pastas|$AERC_DIR/tt-pastas-$slug.map
mbsyncrc|$EMAIL_MBSYNC_DIR/$slug.mbsyncrc
EOF
  printf '%s' "$d"
}

email_snapshot_restaurar() { # snapshot slug
  local d=$1 slug=$2 nome arq
  while IFS='|' read -r nome arq; do
    if [[ -e $d/$nome.existe ]]; then mkdir -p "$(dirname "$arq")"; cp -p "$d/$nome" "$arq"
    else rm -f "$arq"; fi
  done <<EOF
conf|$(email_conf_arq "$slug")
cred|$(email_cred_arq "$slug")
client_secret|$SECRETS_DIR/aerc-$slug.client_secret
accounts|$AERC_CONTAS
pastas|$AERC_DIR/tt-pastas-$slug.map
mbsyncrc|$EMAIL_MBSYNC_DIR/$slug.mbsyncrc
EOF
  rm -rf "$d"
}

email_salvar_validado() { # snapshot autorizar_oauth(0|1)
  local snap=$1 autorizar=${2:-0} slug=${E[_slug]}
  # Sync local exige mbsync instalado: recusa antes de gravar, sem fingir que ligou.
  if [[ ${E[sync_local]:-} == 1 ]] && ! command -v mbsync >/dev/null; then
    email_snapshot_restaurar "$snap" "$slug"
    echo "✗ Sync local pede o mbsync (isync) instalado. Instale-o ou deixe sync_local vazio."; return 1
  fi
  if ! email_gravar || ! email_regerar "$slug"; then
    email_snapshot_restaurar "$snap" "$slug"
    echo "✗ Não consegui gravar a conta. Nada foi alterado."; return 1
  fi
  if [[ -z ${TT_EMAIL_SEM_REDE:-} ]]; then
    if [[ ${E[auth]} == oauth && $autorizar == 1 ]] && ! email_autorizar_slug "$slug"; then
      email_snapshot_restaurar "$snap" "$slug"
      echo "✗ Autorização cancelada ou recusada. A configuração anterior foi restaurada."; return 1
    fi
    if ! email_testar_slug "$slug"; then
      email_snapshot_restaurar "$snap" "$slug"
      echo "✗ IMAP/SMTP não foram validados. Nada inválido foi salvo; corrija e tente novamente."; return 1
    fi
  fi
  case ${E[auth]} in
    comando) rm -f "$(email_cred_arq "$slug")" "$SECRETS_DIR/aerc-$slug.client_secret" ;;
    senha) rm -f "$SECRETS_DIR/aerc-$slug.client_secret" ;;
  esac
  rm -rf "$snap"
  tmux kill-session -t "=$EMAIL_SESSAO" 2>/dev/null || true
  # Primeiro espelho em segundo plano, para o maildir já ter conteúdo quando o aerc abrir.
  [[ ${E[sync_local]:-} == 1 && -z ${TT_EMAIL_SEM_REDE:-} ]] && ("$EU" --email-sync "$slug" >/dev/null 2>&1 &)
  return 0
}

email_slugs() { local f; for f in "$EMAIL_DIR"/*.conf; do [[ -e $f ]] && basename "$f" .conf; done; }

# URL do aerc: segurança → esquema; OAuth2 → +xoauth2 e parâmetros para o aerc renovar o token.
# Com sync_local=1, o IMAP de entrada vira um maildir local (espelho mantido pelo mbsync): o aerc lê
# do disco (abertura instantânea, busca local, offline parcial). O envio (smtp) permanece online.
EMAIL_MAILDIR_BASE="$HOME/.cache/tt/maildir"
email_maildir() { echo "$EMAIL_MAILDIR_BASE/$1"; }
email_url() { # imap|smtp
  local t=$1 host porta seg usuario esq q=""
  if [[ $t == imap && ${E[sync_local]:-} == 1 ]]; then printf 'maildir://%s' "$(email_maildir "${E[_slug]}")"; return; fi
  host=${E[${t}_host]}; porta=${E[${t}_porta]}; seg=${E[${t}_seg]:-tls}
  usuario=${E[usuario]:-${E[endereco]}}; usuario=$(email_urlenc "$usuario")
  case $t:$seg in
    imap:tls) esq=imaps ;; imap:starttls) esq=imap ;; imap:*) esq=imap+insecure ;;
    smtp:tls) esq=smtps ;; smtp:starttls) esq=smtp ;; smtp:*) esq=smtp+insecure ;;
  esac
  if [[ ${E[auth]} == oauth ]]; then
    esq+=+xoauth2
    q="?token_endpoint=$(email_urlenc "${E[oauth_token_endpoint]}")&client_id=$(email_urlenc "${E[oauth_client_id]}")"
    [[ -s $SECRETS_DIR/aerc-${E[_slug]}.client_secret ]] && q+="&client_secret=$(email_urlenc "$(cat "$SECRETS_DIR/aerc-${E[_slug]}.client_secret")")"
    [[ -n ${E[oauth_scope]} ]] && q+="&scope=$(email_urlenc "${E[oauth_scope]}")"
  fi
  printf '%s://%s@%s:%s%s' "$esq" "$usuario" "$host" "$porta" "$q"
}
email_urlenc() { python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1"; }

email_bloco() {
  local cred; cred=$(email_cred_arq "${E[_slug]}")
  local cmd; if [[ ${E[auth]} == comando ]]; then cmd=${E[cred_cmd]}; else cmd="cat $(printf %q "$cred")"; fi
  echo "# >>> tt e-mail: ${E[_slug]} >>>"
  printf '[%s]\n' "${E[nome]}"
  printf 'source            = %s\n' "$(email_url imap)"
  # Entrada por maildir (sync_local) não autentica: o mbsync é quem fala IMAP. Só o envio usa a credencial.
  [[ ${E[sync_local]:-} == 1 ]] || printf 'source-cred-cmd   = %s\n' "$cmd"
  printf 'outgoing          = %s\n' "$(email_url smtp)"
  printf 'outgoing-cred-cmd = %s\n' "$cmd"
  if [[ -n ${E[nome_exibicao]:-} ]]; then printf 'from              = %s <%s>\n' "${E[nome_exibicao]}" "${E[endereco]}"
  else printf 'from              = %s\n' "${E[endereco]}"; fi
  printf 'default           = %s\n' "${E[pasta]:-INBOX}"
  # Pastas: a pasta-mãe que não abre (ex.: [Gmail]) sai da lista e as de dentro sobem para o 1º
  # nível; arquivar e rascunhos vão para as pastas especiais que o servidor indicou (o nome muda
  # com o idioma da conta). O Gmail guarda sozinho o que se envia: sem copy-to (duplicaria).
  local mae=${E[pasta_naoabre]:-} gmail=""; [[ ${E[imap_host]} == imap.gmail.com ]] && gmail=1
  if [[ -n $mae ]]; then
    printf '%s = %s/*\n' '*' "$mae" >"$AERC_DIR/tt-pastas-${E[_slug]}.map"
    printf 'folder-map        = %s\n' "$AERC_DIR/tt-pastas-${E[_slug]}.map"
    printf 'folders-exclude   = %s\n' "$mae"
  fi
  local pt; for pt in todos:archive rascunhos:postpone; do
    local v=${E[pasta_${pt%%:*}]:-}; [[ -n $v ]] || continue
    [[ -n $mae ]] && v=${v#"$mae"/}
    printf '%-17s = %s\n' "${pt#*:}" "$v"
  done
  if [[ -z $gmail && -n ${E[pasta_enviados]:-} ]]; then
    local v=${E[pasta_enviados]}; [[ -n $mae ]] && v=${v#"$mae"/}; printf 'copy-to           = %s\n' "$v"
  fi
  local i; for i in 1 2 3 4 5 6 7 8; do
    [[ -n ${E[extra_$i]:-} ]] || continue
    # chaves que o tt agora define (ou que não valem para o Gmail) não são repetidas
    if [[ ${E[extra_$i]} =~ ^[[:space:]]*([a-z-]+)[[:space:]]*= ]]; then
      case ${BASH_REMATCH[1]} in
        copy-to) [[ -n $gmail || -n ${E[pasta_enviados]:-} ]] && continue ;;
        archive) [[ -n ${E[pasta_todos]:-} ]] && continue ;;
        postpone) [[ -n ${E[pasta_rascunhos]:-} ]] && continue ;;
        folder-map|folders-exclude) [[ -n $mae ]] && continue ;;
      esac
    fi
    printf '%s\n' "${E[extra_$i]}"
  done
  echo "# <<< tt e-mail: ${E[_slug]} <<<"
}

# Regrava o bloco gerenciado da conta SLUG (ou o remove, com "remover") no accounts.conf.
email_regerar() {
  local slug=$1 modo=${2:-} tmp
  mkdir -p "$AERC_DIR"; [[ -f $AERC_CONTAS ]] || : >"$AERC_CONTAS"; chmod 600 "$AERC_CONTAS" 2>/dev/null
  tmp=$(mktemp) || return 1
  awk -v i="# >>> tt e-mail: $slug >>>" -v f="# <<< tt e-mail: $slug <<<" '$0 == i { p = 1 } !p { print } $0 == f { p = 0 }' "$AERC_CONTAS" >"$tmp"
  if [[ $modo != remover ]]; then
    [[ -s $tmp && $(tail -c1 "$tmp" | od -An -c | tr -d ' ') != '\n' ]] && echo >>"$tmp"
    email_bloco >>"$tmp"
  fi
  cat "$tmp" >"$AERC_CONTAS"; rm -f "$tmp"
  # O .mbsyncrc acompanha a conta: criado/atualizado quando sync_local=1, removido caso contrário.
  email_mbsyncrc_gerar "$modo"
}

# ---- Sync local opcional (mbsync/isync) --------------------------------------------------------
#
# Opt-in estrito por conta (sync_local=1): o mbsync espelha o IMAP num maildir em
# ~/.cache/tt/maildir/<slug> e o aerc lê de lá (abertura instantânea, busca local, offline
# parcial). O envio continua pelo SMTP online. Desligado por padrão; sem o flag, nada muda
# (a conta segue com source=imaps:// e o cache-headers do aerc). As flags (lido, arquivado,
# apagado) e a chegada de mensagens novas sobem/descem no próximo sync (vigia ou --email-sync).
EMAIL_MBSYNC_DIR="$CONF_DIR/mbsync"
email_mbsyncrc() { echo "$EMAIL_MBSYNC_DIR/$1.mbsyncrc"; }

# PassCmd do mbsync para a conta em E: senha de app (arquivo em ~/.secrets), comando externo do
# usuário, ou, no OAuth2, o access token renovado pelo email-tt.py. Nunca grava o segredo no .mbsyncrc.
email_mbsync_passcmd() {
  local slug=${E[_slug]} conf; conf=$(email_conf_arq "$slug")
  case ${E[auth]} in
    comando) printf '%s' "${E[cred_cmd]}" ;;
    oauth)   printf 'python3 %s oauth-token %s' "$(printf %q "$EMAIL_PY")" "$(printf %q "$conf")" ;;
    *)       printf 'cat %s' "$(printf %q "$(email_cred_arq "$slug")")" ;;
  esac
}

# Gera (ou remove, com "remover") o ~/.config/tt/mbsync/<slug>.mbsyncrc da conta em E. O arquivo não
# tem segredo: a senha vem por PassCmd em tempo de execução. Espelha todas as pastas nos dois sentidos.
email_mbsyncrc_gerar() {
  local slug=${E[_slug]} modo=${1:-} rc; rc=$(email_mbsyncrc "$slug")
  if [[ $modo == remover || ${E[sync_local]:-} != 1 ]]; then rm -f "$rc"; return 0; fi
  mkdir -p "$EMAIL_MBSYNC_DIR"; chmod 700 "$EMAIL_MBSYNC_DIR" 2>/dev/null
  local host=${E[imap_host]} porta=${E[imap_porta]:-993} seg=${E[imap_seg]:-tls}
  local usuario=${E[usuario]:-${E[endereco]}} maildir; maildir=$(email_maildir "$slug")
  local sslt="IMAPS"; case $seg in starttls) sslt="STARTTLS" ;; nenhuma) sslt="None" ;; esac
  local authmech=""; [[ ${E[auth]} == oauth ]] && authmech=$'AuthMechs XOAUTH2\n'
  mkdir -p "$maildir"
  { printf 'IMAPAccount %s\n' "$slug"
    printf 'Host %s\n' "$host"
    printf 'Port %s\n' "$porta"
    printf 'User %s\n' "$usuario"
    printf 'PassCmd "%s"\n' "$(email_mbsync_passcmd)"
    printf '%s' "$authmech"
    case $sslt in None) printf 'SSLType None\n' ;; STARTTLS) printf 'SSLType STARTTLS\n' ;; *) printf 'SSLType IMAPS\n' ;; esac
    printf '\n'
    printf 'IMAPStore %s-remote\n' "$slug"
    printf 'Account %s\n' "$slug"
    printf '\n'
    printf 'MaildirStore %s-local\n' "$slug"
    printf 'Path %s/\n' "$maildir"
    printf 'Inbox %s/INBOX\n' "$maildir"
    printf 'SubFolders Verbatim\n'
    printf '\n'
    printf 'Channel %s\n' "$slug"
    printf 'Far :%s-remote:\n' "$slug"
    printf 'Near :%s-local:\n' "$slug"
    printf 'Patterns *\n'
    printf 'Create Both\n'
    printf 'Expunge Both\n'
    printf 'SyncState *\n'; } >"$rc.tmp" && mv "$rc.tmp" "$rc"
  chmod 600 "$rc" 2>/dev/null
}

# Roda o mbsync de uma conta, com trava por slug (sem duas sincronizações simultâneas da mesma
# conta). Silencioso; o vigia chama em segundo plano. Sem mbsync instalado ou sem o flag, não faz nada.
email_sync() {
  local slug=$1 rc lock; rc=$(email_mbsyncrc "$slug")
  command -v mbsync >/dev/null || return 0
  [[ -f $rc ]] || return 0
  lock="$EMAIL_MBSYNC_DIR/$slug.lock"
  exec 9>"$lock" 2>/dev/null || return 0
  flock -n 9 || return 0   # já há um sync desta conta em curso
  timeout 120 mbsync -c "$rc" "$slug" >/dev/null 2>&1
}

# Sincroniza todas as contas com sync_local=1 (chamado pelo vigia e por --email-sync sem argumento).
email_sync_todas() {
  local slug; local -A E=()
  for slug in $(email_slugs); do
    E=(); email_ler "$slug" || continue
    [[ ${E[sync_local]:-} == 1 ]] && email_sync "$slug"
  done
}

# Contas criadas pelo cadastro antigo (Gmail com senha de app, sem marcadores) passam a ser
# gerenciadas: cria o .conf e troca o bloco solto pelo bloco com marcadores.
email_importar_legado() {
  [[ -f $AERC_CONTAS ]] || return 0
  local nome slug end tmp; local -A E=()
  while IFS=$'\t' read -r nome end; do
    slug=$(email_slug "$nome")
    [[ -e $(email_conf_arq "$slug") || ! -f $(email_cred_arq "$slug") ]] && continue
    E=([_slug]=$slug [nome]=$nome [endereco]=$end [provedor]=gmail [auth]=senha [imap_host]=imap.gmail.com [imap_porta]=993
       [imap_seg]=tls [smtp_host]=smtp.gmail.com [smtp_porta]=465 [smtp_seg]=tls [pasta]=INBOX)
    [[ -e $AERC_CONTAS.antes-tt ]] || cp -p "$AERC_CONTAS" "$AERC_CONTAS.antes-tt" # cópia antes da 1ª importação
    tmp=$(mktemp)
    awk -v alvo="[$nome]" '$0 == alvo { pula = 1; next } pula && /^\[.*\]$|^# >>> tt e-mail:/ { pula = 0 } !pula' "$AERC_CONTAS" >"$tmp" && cat "$tmp" >"$AERC_CONTAS"
    rm -f "$tmp"; email_gravar; email_regerar "$slug"
  done < <(awk '/^# >>> tt e-mail:/ { g = 1 } /^# <<< tt e-mail:/ { g = 0; next } g { next }
    /^\[.*\]$/ { n = substr($0, 2, length($0) - 2); next }
    n != "" && /^source[ \t]*=[ \t]*imaps:\/\/[^@]*@imap\.gmail\.com/ { src[n] = 1 }
    n != "" && /^from[ \t]*=/ { sub(/^from[ \t]*=[ \t]*/, ""); fr[n] = $0 }
    END { for (k in src) print k "\t" fr[k] }' "$AERC_CONTAS")
}

# Contas escritas à mão (fora dos marcadores): "nome" por linha.
email_manuais() {
  [[ -f $AERC_CONTAS ]] || return 0
  awk '/^# >>> tt e-mail:/ { g = 1 } /^# <<< tt e-mail:/ { g = 0; next } !g && /^\[.*\]$/ { print substr($0, 2, length($0) - 2) }' "$AERC_CONTAS"
}

# Assume uma conta escrita à mão: lê o bloco [NOME] e o transforma numa conta do tt com o MESMO
# efeito (o comando de senha vira autenticação "comando"; chaves desconhecidas como copy-to são
# preservadas). Guarda accounts.conf.antes-tt na primeira vez.
email_assumir() {
  local nome=$1 slug k v url esq resto hp n=0 tmp; local -A E=()
  slug=$(email_slug "$nome")
  [[ -e $(email_conf_arq "$slug") ]] && { echo "Já existe uma conta do tt com o identificador $slug."; return 1; }
  E=([_slug]=$slug [nome]=$nome [pasta]=INBOX [provedor]=outro)
  while IFS= read -r l; do
    [[ $l =~ ^[[:space:]]*([a-z-]+)[[:space:]]*=[[:space:]]*(.*)$ ]] || continue
    k=${BASH_REMATCH[1]}; v=${BASH_REMATCH[2]}
    case $k in
      source|outgoing)
        url=$v; esq=${url%%://*}; resto=${url#*://}; [[ $resto == *@* ]] && { E[usuario]=${resto%%@*}; resto=${resto#*@}; }
        hp=${resto%%[/?]*}; local t=imap; [[ $k == outgoing ]] && t=smtp
        E[${t}_host]=${hp%%:*}; E[${t}_porta]=${hp##*:}; [[ $hp == *:* ]] || E[${t}_porta]=$([[ $t == imap ]] && echo 993 || echo 465)
        case $esq in *s|*s+*) E[${t}_seg]=tls ;; *insecure*) E[${t}_seg]=nenhuma ;; *) E[${t}_seg]=starttls ;; esac
        [[ $esq == *xoauth2* || $esq == *oauthbearer* ]] && E[auth]=oauth ;;
      source-cred-cmd) E[cred_cmd]=$v ;;
      outgoing-cred-cmd) ;;
      from) if [[ $v =~ ^(.*)\<([^>]+)\>$ ]]; then E[nome_exibicao]=$(sed 's/[[:space:]]*$//' <<<"${BASH_REMATCH[1]}"); E[endereco]=${BASH_REMATCH[2]}; else E[endereco]=$v; fi ;;
      default) E[pasta]=$v ;;
      *) n=$((n + 1)); ((n <= 8)) && E[extra_$n]=$l ;;
    esac
  done < <(awk -v alvo="[$nome]" '$0 == alvo { p = 1; next } p && /^\[.*\]$|^# >>> tt e-mail:/ { p = 0 } p' "$AERC_CONTAS")
  E[usuario]=${E[usuario]//%40/@}; [[ ${E[usuario]} == "${E[endereco]:-}" ]] && E[usuario]=""
  [[ ${E[auth]:-} == oauth ]] || { E[auth]=comando; }
  case ${E[imap_host]:-} in imap.gmail.com) E[provedor]=gmail ;; outlook.office365.com) E[provedor]=microsoft ;; imap.mail.yahoo.com) E[provedor]=yahoo ;; imap.mail.me.com) E[provedor]=icloud ;; imap.fastmail.com) E[provedor]=fastmail ;; esac
  local erro; erro=$(email_validar) || { echo "Não consegui assumir \"$nome\": $erro"; return 1; }
  [[ -e $AERC_CONTAS.antes-tt ]] || cp -p "$AERC_CONTAS" "$AERC_CONTAS.antes-tt"
  tmp=$(mktemp)
  awk -v alvo="[$nome]" '$0 == alvo { pula = 1; next } pula && /^\[.*\]$|^# >>> tt e-mail:/ { pula = 0 } !pula' "$AERC_CONTAS" >"$tmp" && cat "$tmp" >"$AERC_CONTAS"; rm -f "$tmp"
  email_gravar; email_regerar "$slug"
  [[ -n ${TT_EMAIL_SEM_REDE:-} ]] || email_detectar_pastas "$slug" || true
  echo "✔ \"$nome\" agora é gerenciada pelo tt (cópia anterior em $AERC_CONTAS.antes-tt)"
}

# Validação comum (cadastro e edição). Imprime o problema e falha.
email_validar() {
  local novo=${1:-} auths login
  [[ -n ${E[nome]:-} ]] || { echo "Nome vazio."; return 1; }
  [[ ${E[nome]} != *'['* && ${E[nome]} != *']'* && ${E[nome]} != *$'\n'* && ${E[nome]} != *$'\r'* ]] ||
    { echo "O nome não pode conter [ ], quebra de linha nem controle."; return 1; }
  [[ ${E[endereco]:-} =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] ||
    { echo "Endereço inválido: ${E[endereco]:-vazio}. Use o e-mail completo, por exemplo nome@dominio.com."; return 1; }
  login=${E[usuario]:-${E[endereco]}}
  [[ -n $login && $login != *[[:space:]]* && $login != *://* && $login != *'<'* && $login != *'>'* ]] ||
    { echo "Usuário de login inválido: use o login técnico, sem espaços. Deixe vazio para usar ${E[endereco]}."; return 1; }
  [[ -n ${E[imap_host]:-} && -n ${E[smtp_host]:-} && ${E[imap_host]} != *[[:space:]]* && ${E[smtp_host]} != *[[:space:]]* ]] ||
    { echo "Servidores IMAP/SMTP inválidos ou vazios."; return 1; }
  [[ ${E[imap_porta]:-} =~ ^[0-9]+$ && ${E[smtp_porta]:-} =~ ^[0-9]+$ ]] || { echo "Porta inválida."; return 1; }
  ((10#${E[imap_porta]} >= 1 && 10#${E[imap_porta]} <= 65535 && 10#${E[smtp_porta]} >= 1 && 10#${E[smtp_porta]} <= 65535)) ||
    { echo "Portas devem estar entre 1 e 65535."; return 1; }
  [[ ${E[imap_seg]} =~ ^(tls|starttls|nenhuma)$ && ${E[smtp_seg]} =~ ^(tls|starttls|nenhuma)$ ]] || { echo "Segurança deve ser tls, starttls ou nenhuma."; return 1; }
  if [[ ${E[imap_seg]} == nenhuma && ! ${E[imap_host]} =~ ^(127\.0\.0\.1|localhost|::1)$ ]] ||
     [[ ${E[smtp_seg]} == nenhuma && ! ${E[smtp_host]} =~ ^(127\.0\.0\.1|localhost|::1)$ ]]; then
    echo "Conexão sem criptografia só é permitida em localhost."; return 1
  fi
  [[ ${E[auth]} =~ ^(senha|oauth|comando)$ ]] || { echo "Autenticação deve ser senha, oauth ou comando."; return 1; }
  auths=$(cut -d'|' -f5 <<<"$(email_provedor "${E[provedor]}")")
  [[ " $auths " == *" ${E[auth]} "* ]] || { echo "${E[provedor]} não oferece o método de autenticação escolhido."; return 1; }
  [[ ${E[auth]} != comando || -n ${E[cred_cmd]:-} || ${2:-} == antes-do-segredo ]] || { echo "Falta o comando que imprime a senha."; return 1; }
  if [[ ${E[auth]} == oauth && ${2:-} != antes-do-segredo ]]; then
    [[ -n ${E[oauth_client_id]:-} ]] || { echo "Falta o ID do aplicativo OAuth (client_id)."; return 1; }
    [[ ${E[oauth_token_endpoint]:-} == https://* || ${E[oauth_token_endpoint]:-} == http://127.0.0.1:* || ${E[oauth_token_endpoint]:-} == http://localhost:* ]] ||
      { echo "O endpoint de token OAuth deve usar HTTPS (HTTP só é aceito em localhost)."; return 1; }
    [[ ${E[oauth_device_endpoint]:-} == https://* || ${E[oauth_auth_endpoint]:-} == https://* ||
       ${E[oauth_device_endpoint]:-} == http://127.0.0.1:* || ${E[oauth_auth_endpoint]:-} == http://127.0.0.1:* ||
       ${E[oauth_device_endpoint]:-} == http://localhost:* || ${E[oauth_auth_endpoint]:-} == http://localhost:* ]] ||
      { echo "OAuth precisa de endpoint seguro de autorização ou de código do dispositivo."; return 1; }
  fi
  if [[ -n $novo ]]; then
    email_contas_nomes | grep -qxF "${E[nome]}" && { echo "Já existe uma conta \"${E[nome]}\"."; return 1; }
    [[ -e $(email_conf_arq "${E[_slug]}") || -e $(email_cred_arq "${E[_slug]}") ]] &&
      { echo "Já existe uma conta que usa o mesmo identificador (${E[_slug]}); escolha um nome distinto."; return 1; }
  fi
  return 0
}

# Preenche servidores e autenticação a partir do provedor. Em "outro", descobre pelo domínio; se ele é
# hospedado na Microsoft 365 ou no Google Workspace (o MX diz), a conta passa a ser desse provedor.
email_aplicar_provedor() {
  local linha imap smtp auths h p s k v achado=""
  if [[ ${E[provedor]} == outro && -z ${E[imap_host]:-} && ${E[endereco]:-} == *@* ]] && command -v python3 >/dev/null; then
    while IFS='=' read -r k v; do
      case $k in imap_* | smtp_*) E[$k]=$v ;; provedor) achado=$v ;; esac
    done < <(python3 "$EMAIL_PY" descobrir "${E[endereco]#*@}" 2>/dev/null)
    if [[ -n $achado && -n $(email_provedor "$achado") ]]; then
      E[provedor]=$achado
    fi
  fi
  linha=$(email_provedor "${E[provedor]}"); IFS='|' read -r _ _ imap smtp auths _ <<<"$linha"
  if [[ -n $imap ]]; then
    read -r h p s <<<"$imap"; E[imap_host]=${E[imap_host]:-$h}; E[imap_porta]=${E[imap_porta]:-$p}; E[imap_seg]=${E[imap_seg]:-$s}
    read -r h p s <<<"$smtp"; E[smtp_host]=${E[smtp_host]:-$h}; E[smtp_porta]=${E[smtp_porta]:-$p}; E[smtp_seg]=${E[smtp_seg]:-$s}
  fi
  [[ -n ${E[auth]:-} ]] || E[auth]=${auths%% *}
  [[ ${E[auth]} == oauth ]] && [[ -z ${E[oauth_token_endpoint]:-} ]] && email_oauth_padrao "${E[provedor]}"
  E[pasta]=${E[pasta]:-INBOX}
}

# tt --email-adicionar chave=valor… [--senha-stdin]: cadastro sem interação (scripts e testes).
# Chaves: as de EMAIL_CHAVES (nome, endereco, provedor, auth, imap_host, imap_porta, imap_seg, …).
email_adicionar_cli() {
  local -A E=() ; local a senha_stdin="" k
  for a in "$@"; do
    case $a in --senha-stdin) senha_stdin=1 ;; *=*) k=${a%%=*}; E[$k]=${a#*=} ;; *) echo "argumento inválido: $a"; return 2 ;; esac
  done
  E[provedor]=${E[provedor]:-outro}; E[nome]=${E[nome]:-${E[endereco]%@*}}; E[_slug]=$(email_slug "${E[nome]}")
  email_aplicar_provedor
  email_validar novo || return 1
  if [[ ${E[sync_local]:-} == 1 ]] && ! command -v mbsync >/dev/null; then
    echo "✗ Sync local pede o mbsync (isync) instalado. Instale-o ou deixe sync_local vazio."; return 1
  fi
  if [[ ${E[auth]} == senha ]]; then
    local senha; [[ -n $senha_stdin ]] && IFS= read -r senha
    [[ -n ${senha:-} ]] || { echo "Senha vazia (use --senha-stdin)."; return 1; }
    mkdir -p "$SECRETS_DIR"; chmod 700 "$SECRETS_DIR" 2>/dev/null
    ( umask 077; printf '%s' "$senha" >"$(email_cred_arq "${E[_slug]}")" ); chmod 600 "$(email_cred_arq "${E[_slug]}")"; unset senha
  fi
  email_gravar; email_regerar "${E[_slug]}"
  [[ -n ${TT_EMAIL_SEM_REDE:-} ]] || email_detectar_pastas "${E[_slug]}" || true
  [[ ${E[sync_local]:-} == 1 && -z ${TT_EMAIL_SEM_REDE:-} ]] && ("$EU" --email-sync "${E[_slug]}" >/dev/null 2>&1 &)
  echo "✔ conta \"${E[nome]}\" cadastrada (${E[_slug]})"
}

email_remover_slug() {
  local slug=$1; local -A E=()
  email_ler "$slug" || { echo "Conta não encontrada: $slug"; return 1; }
  email_regerar "$slug" remover
  rm -f "$(email_conf_arq "$slug")" "$(email_cred_arq "$slug")" "$SECRETS_DIR/aerc-$slug.client_secret"
  rm -rf "$(email_maildir "$slug")" "$EMAIL_MBSYNC_DIR/$slug.lock"
  echo "✔ conta \"${E[nome]}\" removida (bloco do aerc e segredos apagados)"
}

# Conta pelo nome ou slug → slug.
email_achar() {
  local s; s=$(email_slug "$1"); [[ -e $(email_conf_arq "$s") ]] && { echo "$s"; return 0; }
  for s in $(email_slugs); do local -A E=(); email_ler "$s" && [[ ${E[nome]} == "$1" ]] && { echo "$s"; return 0; }; done
  return 1
}

# TSV: slug, nome, endereço, provedor, autenticação, servidor IMAP.
email_listar() {
  email_importar_legado
  local s n; for s in $(email_slugs); do local -A E=(); email_ler "$s" || continue
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$s" "${E[nome]}" "${E[endereco]}" "${E[provedor]:-outro}" "${E[auth]}" "${E[imap_host]}:${E[imap_porta]}"
  done
  # Escritas à mão: aparecem com slug "!NOME" (abrir assume a conta no tt).
  while IFS= read -r n; do [[ -n $n ]] && printf '!%s\t%s\t%s\t%s\t%s\t%s\n' "$n" "$n" "-" manual "-" "-"; done < <(email_manuais)
}

# Pergunta ao servidor as pastas especiais e regrava o bloco. Sem rede/credencial: mantém o que havia.
email_detectar_pastas() {
  local slug=$1 k v saida; local -A E=()
  command -v python3 >/dev/null || return 1
  email_ler "$slug" || return 1
  saida=$(timeout 40 python3 "$EMAIL_PY" pastas "$(email_conf_arq "$slug")" 2>/dev/null) || return 1
  for k in todos enviados lixeira rascunhos spam naoabre; do E[pasta_$k]=""; done
  while IFS='=' read -r k v; do [[ -n $k && -z ${E[pasta_$k]:-} ]] && E[pasta_$k]=$v; done <<<"$saida"
  email_gravar; email_regerar "$slug"
}

email_testar_slug() {
  command -v python3 >/dev/null || { echo "✗ precisa do python3 para testar"; return 1; }
  [[ -e $(email_conf_arq "$1") ]] || { echo "Conta não encontrada: $1"; return 1; }
  python3 "$EMAIL_PY" testar "$(email_conf_arq "$1")" || return 1
  email_detectar_pastas "$1" && echo "✓ pastas especiais conferidas (arquivar, rascunhos, enviados)"
  return 0
}

email_autorizar_slug() {
  command -v python3 >/dev/null || { echo "✗ precisa do python3"; return 1; }
  python3 "$EMAIL_PY" oauth-autorizar "$(email_conf_arq "$1")"
}

# ─── Telas (rodam dentro do popup) ─────────────────────────────────────────────
# Pergunta com valor sugerido (Enter aceita). Sem terminal (testes, scripts), lê uma linha.
email_pergunta() { # VAR texto [padrão]
  local __v
  if [[ -t 0 ]]; then read -r -e -p "$2: " -i "${3:-}" __v || return 1
  else IFS= read -r __v || __v=""; [[ -z $__v ]] && __v=${3:-}; fi
  printf -v "$1" '%s' "$__v"
}
# Escolha numa lista "chave<TAB>rótulo": fzf no terminal; sem terminal, lê a chave (ou o padrão).
email_escolher() { # VAR título padrão "opções" (a resposta vem da entrada padrão quando não há terminal)
  local __op=$4 __v
  if [[ -t 0 && -t 1 ]] && command -v fzf >/dev/null; then
    __v=$(fzf --ansi --layout=reverse --delimiter=$'\t' --with-nth=2 --no-input --height=~20 --header="$2" <<<"$__op" | cut -f1) || return 1
  else
    IFS= read -r __v || __v=""; [[ -z $__v ]] && __v=$3
    grep -q "^$__v"$'\t' <<<"$__op" || return 1
  fi
  printf -v "$1" '%s' "$__v"
}

email_rotulo_auth() { case $1 in senha) echo "senha / senha de app" ;; oauth) echo "OAuth2 / SSO (login pelo navegador)" ;; comando) echo "comando externo (pass, secret-tool, Bitwarden…)" ;; esac; }

# Opções realmente suportadas pelo provedor. OAuth fica primeiro e marcado como recomendado nos
# provedores com endpoints prontos; a escolha atual pode vir primeiro durante uma edição.
email_auth_opcoes() { # provedor [atual]
  local prov=$1 atual=${2:-} linha auths op rot
  linha=$(email_provedor "$prov"); auths=$(cut -d'|' -f5 <<<"$linha")
  if [[ -n $atual && " $auths " == *" $atual "* ]]; then
    rot=$(email_rotulo_auth "$atual"); [[ $atual == oauth && $prov =~ ^(gmail|microsoft)$ ]] && rot+=" · recomendado"
    printf '%s\t%s\n' "$atual" "$rot"
  fi
  for op in $auths; do
    [[ -n $atual && $op == "$atual" ]] && continue
    rot=$(email_rotulo_auth "$op"); [[ $op == oauth && $prov =~ ^(gmail|microsoft)$ ]] && rot+=" · recomendado"
    printf '%s\t%s\n' "$op" "$rot"
  done
}

email_auth_padrao() {
  local linha; linha=$(email_provedor "$1"); cut -d'|' -f5 <<<"$linha" | awk '{print $1}'
}

email_auth_aplicar() {
  if [[ ${E[auth]} == oauth ]]; then
    E[cred_cmd]=""
    [[ -n ${E[oauth_token_endpoint]:-} ]] || email_oauth_padrao "${E[provedor]}"
  else
    E[oauth_client_id]=""; E[oauth_auth_endpoint]=""; E[oauth_token_endpoint]=""
    E[oauth_device_endpoint]=""; E[oauth_scope]=""
    [[ ${E[auth]} == senha ]] && E[cred_cmd]=""
  fi
}

# Pede o segredo conforme a autenticação. Senha: lida sem eco, direto para ~/.secrets (600).
email_pedir_segredo() {
  case ${E[auth]} in
    senha)
      local senha senha2 cred; cred=$(email_cred_arq "${E[_slug]}")
      case ${E[provedor]} in
        gmail) printf 'Gmail: use uma senha de app de 16 caracteres; a senha normal costuma ser recusada.\n' ;;
        microsoft) printf 'Microsoft: OAuth2 é recomendado; muitos tenants recusam senha comum.\n' ;;
      esac
      read -r -s -p 'Senha/credencial (não aparece): ' senha; printf '\n'
      read -r -s -p 'Repita a senha: ' senha2; printf '\n'
      [[ -n $senha ]] || { echo "Senha vazia."; return 1; }
      [[ $senha == "$senha2" ]] || { echo "As senhas não conferem."; return 1; }
      mkdir -p "$SECRETS_DIR"; chmod 700 "$SECRETS_DIR" 2>/dev/null
      ( umask 077; printf '%s' "$senha" >"$cred" ); chmod 600 "$cred"; unset senha senha2 ;;
    comando)
      printf 'Comando que imprime a senha (ex.: pass email/pessoal · secret-tool lookup email %s)\n' "${E[endereco]}"
      email_pergunta 'E[cred_cmd]' 'Comando' "${E[cred_cmd]:-}" ;;
    oauth)
      printf '\nOAuth2 precisa do ID de um app registrado (client_id).\n'
      if [[ ${E[provedor]} == microsoft ]]; then
        printf 'Você pode registrar o seu (portal do Azure → Registros de aplicativo) ou usar o ID público\n'
        printf 'do Thunderbird, que vários clientes livres usam (deixe em branco para usá-lo).\n'
        email_pergunta 'E[oauth_client_id]' 'client_id' "${E[oauth_client_id]:-}"
        E[oauth_client_id]=${E[oauth_client_id]:-$EMAIL_THUNDERBIRD_ID}
      else
        [[ ${E[provedor]} == gmail ]] && printf 'Google: crie um app do tipo "Desktop" em console.cloud.google.com (APIs e serviços → Credenciais).\n'
        email_pergunta 'E[oauth_client_id]' 'client_id' "${E[oauth_client_id]:-}"
        local seg; read -r -s -p 'client_secret (se houver; não aparece): ' seg; printf '\n'
        if [[ -n $seg ]]; then mkdir -p "$SECRETS_DIR"; ( umask 077; printf '%s' "$seg" >"$SECRETS_DIR/aerc-${E[_slug]}.client_secret" ); fi; unset seg
        if [[ ${E[provedor]} == outro ]]; then
          email_pergunta 'E[oauth_auth_endpoint]' 'endereço de autorização' "${E[oauth_auth_endpoint]:-}"
          email_pergunta 'E[oauth_token_endpoint]' 'endereço do token' "${E[oauth_token_endpoint]:-}"
          email_pergunta 'E[oauth_device_endpoint]' 'endereço do código no aparelho (opcional)' "${E[oauth_device_endpoint]:-}"
          email_pergunta 'E[oauth_scope]' 'escopos' "${E[oauth_scope]:-}"
        fi
      fi ;;
  esac
}

email_avancado() {
  printf '\n⚙ Servidores (Enter mantém o valor)\n'
  email_pergunta 'E[imap_host]' 'IMAP (receber) — servidor' "${E[imap_host]:-}" || return 1
  email_pergunta 'E[imap_porta]' 'IMAP — porta' "${E[imap_porta]:-993}" || return 1
  email_escolher 'E[imap_seg]' 'IMAP — segurança' "${E[imap_seg]:-tls}" $'tls\tTLS (porta 993)\nstarttls\tSTARTTLS (porta 143)\nnenhuma\tnenhuma (só localhost, ex.: Proton Bridge)' || return 1
  email_pergunta 'E[smtp_host]' 'SMTP (enviar) — servidor' "${E[smtp_host]:-}" || return 1
  email_pergunta 'E[smtp_porta]' 'SMTP — porta' "${E[smtp_porta]:-465}" || return 1
  email_escolher 'E[smtp_seg]' 'SMTP — segurança' "${E[smtp_seg]:-tls}" $'tls\tTLS (porta 465)\nstarttls\tSTARTTLS (porta 587)\nnenhuma\tnenhuma (só localhost)' || return 1
  printf '\nDeixe o usuário técnico vazio para usar o endereço %s. Não use o nome da conta.\n' "${E[endereco]}"
  email_pergunta 'E[usuario]' 'Usuário técnico de login (sem espaços; opcional)' "${E[usuario]:-}" || return 1
  email_pergunta 'E[pasta]' 'Pasta inicial' "${E[pasta]:-INBOX}" || return 1
}

email_resumo() {
  printf '\n  %s  <%s>\n' "${E[nome]}" "${E[endereco]}"
  printf '  provedor: %s · autenticação: %s\n' "${E[provedor]}" "$(email_rotulo_auth "${E[auth]}")"
  printf '  IMAP: %s:%s (%s) · SMTP: %s:%s (%s)\n' "${E[imap_host]}" "${E[imap_porta]}" "${E[imap_seg]}" "${E[smtp_host]}" "${E[smtp_porta]}" "${E[smtp_seg]}"
  if [[ -n ${E[usuario]:-} ]]; then printf '  usuário técnico: %s\n' "${E[usuario]}"
  else printf '  usuário técnico: %s (igual ao endereço)\n' "${E[endereco]}"; fi
  return 0
}

email_pausa() { [[ -t 0 ]] && { printf '\n%s' "${1:-Enter volta.}"; read -r _; }; return 0; }

# Assistente de cadastro: provedor/endereço → descoberta → autenticação → segredo → teste obrigatório.
email_conta_nova_ui() {
  command -v aerc >/dev/null || { printf 'O aerc não está instalado nesta máquina.\nInstale o aerc e rode de novo.'; email_pausa 'Enter fecha.'; return; }
  local -A E=(); local prov linha dica erro snap
  clear 2>/dev/null; printf '📧 Nova conta de e-mail\n\n'
  email_escolher prov 'Qual é o seu e-mail?' gmail "$(cut -d'|' -f1,2 <<<"$EMAIL_PROVEDORES" | tr '|' '\t')" || return 0
  E[provedor]=$prov
  email_pergunta 'E[endereco]' 'Endereço (ex.: voce@exemplo.com)' || return 0
  email_pergunta 'E[nome]' 'Nome da conta no aerc' "${E[endereco]%%@*}" || return 0
  E[_slug]=$(email_slug "${E[nome]}")

  # Descobre o provedor ANTES da autenticação. A descoberta nunca anula a escolha do usuário.
  E[auth]=""; email_aplicar_provedor
  linha=$(email_provedor "${E[provedor]}"); dica=$(cut -d'|' -f6- <<<"$linha")
  email_escolher 'E[auth]' 'Como entrar? OAuth2 é recomendado quando disponível' \
    "$(email_auth_padrao "${E[provedor]}")" "$(email_auth_opcoes "${E[provedor]}")" || return 0
  email_auth_aplicar

  if [[ $prov == outro && ${E[provedor]} != outro ]]; then
    printf '\nℹ %s é hospedado em %s; servidores preenchidos. Você escolheu %s.\n' "${E[endereco]#*@}" \
      "$(cut -d'|' -f2 <<<"$linha")" "$(email_rotulo_auth "${E[auth]}")"
  fi
  [[ -n $dica ]] && printf '\nℹ %s\n' "$dica"
  if [[ ${E[provedor]} == outro ]]; then
    printf '\nServidores %s.\n' "$([[ -n ${E[imap_host]:-} ]] && echo "descobertos para ${E[endereco]#*@}" || echo "não encontrados")"
    email_avancado || return 0
  elif [[ -t 0 ]]; then
    local aj; read -r -p $'\nAjustar servidores, portas ou usuário técnico? (s/N) ' aj || return 0
    if [[ $aj == [sSyY]* ]]; then email_avancado || return 0; fi
  fi
  if ! erro=$(email_validar novo antes-do-segredo); then printf '\n✗ %s\nNada foi salvo.\n' "$erro"; email_pausa 'Enter volta.'; return 0; fi

  snap=$(email_snapshot_criar "${E[_slug]}") || { echo '✗ Não consegui criar o snapshot de segurança.'; email_pausa; return 0; }
  if ! email_pedir_segredo; then email_snapshot_restaurar "$snap" "${E[_slug]}"; email_pausa 'Nada foi salvo. Enter volta.'; return 0; fi
  if ! erro=$(email_validar); then
    email_snapshot_restaurar "$snap" "${E[_slug]}"; printf '\n✗ %s\nNada foi salvo.\n' "$erro"; email_pausa 'Enter volta.'; return 0
  fi
  printf '\nValidando IMAP e SMTP antes de salvar…\n'
  if ! email_salvar_validado "$snap" 1; then email_pausa 'Enter volta para corrigir.'; return 0; fi
  printf '\n✔ Conta cadastrada e validada:'; email_resumo
  email_pausa 'Enter volta.'
}

# Edição transacional: permite trocar autenticação; só substitui a conta após validar IMAP e SMTP.
email_editar_ui() {
  local slug=$1 erro t snap auth_antiga autorizar=0; local -A E=(); email_ler "$slug" || return 0
  auth_antiga=${E[auth]}
  clear 2>/dev/null; printf '✏ Editar conta'; email_resumo
  email_pergunta 'E[endereco]' 'Endereço' "${E[endereco]}" || return 0
  email_pergunta 'E[nome_exibicao]' 'Nome de exibição (no "De:"; opcional)' "${E[nome_exibicao]:-}" || return 0
  email_escolher 'E[auth]' 'Como entrar? OAuth2 é recomendado quando disponível' "$auth_antiga" \
    "$(email_auth_opcoes "${E[provedor]}" "$auth_antiga")" || return 0
  email_auth_aplicar
  email_avancado || return 0
  if ! erro=$(email_validar "" antes-do-segredo); then printf '\n✗ %s\nNada foi alterado.\n' "$erro"; email_pausa; return 0; fi

  if [[ ${E[auth]} != "$auth_antiga" ]]; then t=s
  else read -r -p $'\nTrocar a senha/credencial? (s/N) ' t || return 0; fi
  snap=$(email_snapshot_criar "$slug") || { echo '✗ Não consegui criar o snapshot de segurança.'; email_pausa; return 0; }
  if [[ $t == [sSyY]* ]]; then
    if ! email_pedir_segredo; then email_snapshot_restaurar "$snap" "$slug"; email_pausa 'Nada foi alterado. Enter volta.'; return 0; fi
    [[ ${E[auth]} == oauth ]] && autorizar=1
  fi
  if ! erro=$(email_validar); then
    email_snapshot_restaurar "$snap" "$slug"; printf '\n✗ %s\nA configuração anterior foi restaurada.\n' "$erro"; email_pausa; return 0
  fi
  printf '\nValidando IMAP e SMTP antes de substituir a conta…\n'
  if ! email_salvar_validado "$snap" "$autorizar"; then email_pausa 'Enter volta para corrigir.'; return 0; fi
  printf '\n✔ Conta atualizada e validada.'; email_pausa
}

# Gerência: lista navegável das contas; Enter abre as ações da conta.
email_contas_ui() {
  local escolha slug acao linhas c
  email_importar_legado
  while :; do
    linhas=$(email_listar | awk -F'\t' '$4 == "manual" { printf "%s\t📧 %-16.16s \033[33m(escrita à mão · ⏎ assume no tt)\033[0m\n", $1, $2; next }
      { printf "%s\t📧 %-16.16s %-30.30s \033[90m%s · %s · %s\033[0m\n", $1, $2, $3, $4, $5, $6 }')
    escolha=$( { printf '+\t\033[32m＋ Cadastrar conta…\033[0m\n'; [[ -n $linhas ]] && printf '%s\n' "$linhas"; } |
      fzf --ansi --layout=reverse --no-sort --delimiter=$'\t' --with-nth=2 --no-input \
        --header=$'📧 Contas de e-mail · ⏎ abre · ^n nova · ^t testar · ^d descadastrar · Esc fecha' \
        --expect=enter,ctrl-n,ctrl-t,ctrl-d) || return 0
    acao=$(head -1 <<<"$escolha"); slug=$(sed -n 2p <<<"$escolha" | cut -f1)
    [[ $acao == ctrl-n || $slug == + ]] && { email_conta_nova_ui; continue; }
    [[ -n $slug ]] || continue
    if [[ $slug == !* ]]; then # conta escrita à mão: assumir (com cópia) antes de gerenciar
      clear; printf 'A conta "%s" foi escrita à mão no accounts.conf.\nO tt pode assumi-la (mesmo efeito, com cópia de segurança) para você editar e testar por aqui.\n\n' "${slug#!}"
      read -r -p 'Assumir agora? (S/n) ' c; [[ $c == [nN]* ]] && continue
      email_assumir "${slug#!}" || { email_pausa; continue; }
      slug=$(email_slug "${slug#!}")
    fi
    case $acao in
      ctrl-t) clear; email_testar_slug "$slug"; email_pausa ;;
      ctrl-d) email_descadastrar_ui "$slug" ;;
      *) email_conta_ui "$slug" ;;
    esac
  done
}

email_conta_ui() {
  local slug=$1 op; local -A E=(); email_ler "$slug" || return 0
  while :; do
    email_ler "$slug" || return 0
    op=$( { printf 't\t🔌 Testar conexão (receber e enviar)\n'
            printf 'e\t✏ Editar (servidores, portas, segurança, usuário, senha)\n'
            [[ ${E[auth]} == oauth ]] && printf 'a\t🔑 Autorizar de novo (OAuth2 / SSO)\n'
            printf 'd\t🗑 Descadastrar\n'; printf 'v\t← Voltar\n'; } |
      fzf --ansi --layout=reverse --no-sort --delimiter=$'\t' --with-nth=2 --no-input \
        --header="$(email_resumo | sed '/^$/d')" | cut -f1) || return 0
    case $op in
      t) clear; email_testar_slug "$slug"; email_pausa ;;
      e) email_editar_ui "$slug" ;;
      a) clear; email_autorizar_slug "$slug"; email_pausa ;;
      d) email_descadastrar_ui "$slug" && return 0 ;;
      *) return 0 ;;
    esac
  done
}

email_descadastrar_ui() {
  local slug=$1 c; local -A E=(); email_ler "$slug" || return 1
  clear 2>/dev/null; printf '🗑 Descadastrar'; email_resumo
  read -r -p $'\nApaga o bloco do aerc e a senha/token desta conta (os e-mails no servidor não são tocados). Confirmar? (s/N) ' c
  [[ $c == [sSyY]* ]] || return 1
  email_remover_slug "$slug"; email_pausa; return 0
}

# Abre o gerenciador de contas numa subjanela (popup), como o próprio e-mail.
botao_email_contas() {
  local cliente=$1
  tmux display-popup -c "$cliente" -E $(tam_popup "$cliente") -T " 📧 contas de e-mail " \
    "cd ${HOME@Q}; $EU --email-contas-ui"
}

# Fecha o que está vazio; se há algo rodando, só desanexa (a sessão continua).
botao_sair() {
  local cliente=$1 pane=$2 pid cmd filhos paineis janelas
  pid=$(tmux display-message -p -t "$pane" '#{pane_pid}'); cmd=$(tmux display-message -p -t "$pane" '#{pane_current_command}')
  filhos=$(descendentes "$pid" | wc -l)
  case $cmd in
    bash|zsh|sh|dash|fish) ;;
    *) tmux detach-client -t "$cliente"; return ;;
  esac
  ((filhos == 0)) || { tmux detach-client -t "$cliente"; return; }
  paineis=$(tmux display-message -p -t "$pane" '#{window_panes}'); janelas=$(tmux display-message -p -t "$pane" '#{session_windows}')
  if ((paineis > 1)); then tmux kill-pane -t "$pane"
  elif ((janelas > 1)); then tmux kill-window -t "$pane"
  else tmux kill-session -t "$(tmux display-message -p -t "$pane" '#{session_id}')"; fi
}

botao() {
  local acao=$1 cliente=$2 pane=$3 pasta=${4:-$HOME} cmd w h
  case $acao in
    cl|clc|clr)
      local args=()
      [[ $acao == clc ]] && args=(--continue)
      [[ $acao == clr ]] && args=(--resume)
      cmd=$(claude_comando "$pasta" "${args[@]}") || { botao_aviso "$cliente" "claude não está instalado aqui"; return; }
      if [[ $acao == cl || $acao == clr ]]; then   # conversa nova e seletor de conversas são sempre uma sessão nova
        [[ $acao == clr && $(tmux show-options -wqv -t "$pane" @tt_papel) == claude ]] && { botao_aviso "$cliente" "já está no Claude: use /resume"; return; }
        local nome; nome=$(proximo_nome claude)
        tmux new-session -d -s "$nome" -c "$pasta" "$cmd; exec \${SHELL:-bash}" && tmux set-option -w -t "=$nome:" @tt_papel claude \
          && tmux set-option -w -t "=$nome:" @tt_pasta "$pasta" && tmux switch-client -c "$cliente" -t "=$nome"
      else ir_papel claude "$cmd" "$cliente" "$pane" "$pasta"; fi ;;
    dbn)
      cmd=$(debian_comando "$pasta") || { botao_aviso "$cliente" "não há Debian (proot-distro) aqui"; return; }
      ir_papel debian "$cmd" "$cliente" "$pane" "$pasta" ;;
    tela) botao_tela "$cliente" ;;
    email) botao_email "$cliente" ;;
    sair) botao_sair "$cliente" "$pane" ;;
    ant) tmux switch-client -c "$cliente" -l 2>/dev/null || botao_aviso "$cliente" "não há sessão anterior" ;;
    zm) tmux resize-pane -Z -t "$pane" ;;
    jn) tmux new-window -a -t "$(tmux display-message -p -t "$pane" "#{window_id}")" -c "$pasta" ;;
    dv) w=$(tmux display-message -p -t "$pane" '#{pane_width}'); h=$(tmux display-message -p -t "$pane" '#{pane_height}')
        # célula de terminal é ~2x mais alta que larga: divide ao lado se couber, senão embaixo
        if ((w >= 2 * h)); then tmux split-window -h -t "$pane" -c "$pasta"; else tmux split-window -v -t "$pane" -c "$pasta"; fi ;;
    *) botao_aviso "$cliente" "botão desconhecido: $acao" ;;
  esac
}

humano() { awk -v b="${1:-0}" 'BEGIN { split("B K M G T", u); i = 1; while (b >= 1024 && i < 5) { b /= 1024; i++ } printf (i == 1 ? "%d%s" : "%.1f%s"), b, u[i] }'; }

# Trabalhos de cópia persistem neste diretório até serem concluídos; o popup que os iniciou fica
# livre imediatamente para novas sessões, menus e outras operações. Por trabalho: ID.info (origem e
# destino), ID.status (estado), ID.pid (o trabalhador) e ID.log.
dir_transferencias() { echo "$RT/tt-transferencias-$(id -u)"; }

atualizar_transferencia() {
  local id=$1 estado=$2 d
  d=$(dir_transferencias); mkdir -p "$d"
  printf '%s\n' "$estado" >"$d/$id.status"
  atualizar_barras
  return 0
}

idade_arquivo() { echo $(($(date +%s) - $(stat -c %Y "$1" 2>/dev/null || date +%s))); }

# Estado real de um trabalho: um "em andamento" cujo trabalhador já morreu (máquina suspensa,
# processo derrubado) vira "interrompida" — nada fica pendente para sempre. Concluídas, com erro
# ou interrompidas há mais de um dia são apagadas.
estado_transferencia() {
  local d=$1 id=$2 estado pid
  estado=$(cat "$d/$id.status" 2>/dev/null)
  case $estado in
    'na fila' | calculando* | transferindo*)
      pid=$(cat "$d/$id.pid" 2>/dev/null)
      # Sem pid ainda: o trabalhador acabou de ser lançado (dá alguns segundos a ele).
      [[ -z $pid ]] && (($(idade_arquivo "$d/$id.status") < 10)) && { echo "$estado"; return 0; }
      if [[ -z $pid ]] || ! kill -0 "$pid" 2>/dev/null; then
        sleep 0.3; estado=$(cat "$d/$id.status" 2>/dev/null) # pode ter acabado agora
        case $estado in 'na fila' | calculando* | transferindo*)
          estado='interrompida'; printf '%s\n' "$estado" >"$d/$id.status" ;; esac
      fi ;;
    *) (($(idade_arquivo "$d/$id.status") > 86400)) && { rm -f "$d/$id".*; return 1; } ;;
  esac
  echo "$estado"
}

transferencias_barra() {
  local d f id n=0
  d=$(dir_transferencias)
  for f in "$d"/*.status; do
    [[ -f $f ]] || continue; id=${f##*/}; id=${id%.status}
    case $(estado_transferencia "$d" "$id") in 'na fila' | calculando* | transferindo*) n=$((n + 1)) ;; esac
  done
  ((n)) && printf '#[range=user|transferencias]#[fg=#a6e3a1,bold] ⇅ %d em andamento #[norange]#[default] ' "$n"
  return 0
}

# Tela das transferências (botão "⇅ N em andamento" e menu de arquivos). Redesenha no lugar a
# cada 0,5 s (sem piscar), cada linha cortada na largura da tela. 1–9 cancela a transferência em
# andamento daquele número; q, Esc ou Enter fecham (e o popup fecha junto: popup_tt usa -E).
transferencias() {
  local d f id estado tecla resto i w tela total feitos taxa pct cheio prog cor sinal nomes rota ativos
  local -a ids
  d=$(dir_transferencias)
  if [[ ! -t 0 ]]; then
    for f in "$d"/*.status; do [[ -f $f ]] && { id=${f##*/}; id=${id%.status}; printf '%s: %s\n' "$id" "$(estado_transferencia "$d" "$id")"; }; done
    return 0
  fi
  corta() { local t=$1 n=$2; ((${#t} > n)) && t="${t:0:n-1}…"; printf '%s' "$t"; }
  printf '\033[?25l\033[2J'; trap 'printf "\033[?25h"' RETURN
  while true; do
    w=$(($(tput cols 2>/dev/null || echo 80) - 1)); tela=""; ids=(); i=0; ativos=""
    for f in $(ls -t "$d"/*.status 2>/dev/null); do
      id=${f##*/}; id=${id%.status}
      estado=$(estado_transferencia "$d" "$id") || continue
      ((i < 9)) || break
      i=$((i + 1)); ids[i]=$id
      nomes=$(paste -sd'|' "$d/$id.nomes" 2>/dev/null); nomes=${nomes//|/, }
      rota=$(awk -F'\t' '{ printf "%s:%s → %s:%s", $1, $2, $3, $4 }' "$d/$id.info" 2>/dev/null)
      total=0 feitos=0 taxa=0; read -r total feitos taxa <"$d/$id.prog" 2>/dev/null
      case $estado in 'na fila' | calculando* | transferindo*) ativos+="${ativos:+, }$i" ;; esac
      case $estado in
        'na fila' | calculando*) cor=33 sinal='⋯' prog=$estado ;;
        transferindo*)
          cor=36 sinal='⇣' pct=0
          ((${total:-0} > 0)) && pct=$((${feitos:-0} * 100 / total)); ((pct > 99)) && pct=99
          cheio=$((pct / 5))
          prog="$(printf '%*s' "$cheio" '' | sed 's/ /█/g')$(printf '%*s' $((20 - cheio)) '' | sed 's/ /░/g') $(printf '%3d' "$pct")%  $(humano "${feitos:-0}") de $(humano "${total:-0}")  $(humano "${taxa:-0}")/s" ;;
        concluída*) cor=32 sinal='✓' prog="concluída  $(cat "$d/$id.resumo" 2>/dev/null)" ;;
        cancelada) cor=90 sinal='⊘' prog='cancelada' ;;
        interrompida) cor=31 sinal='✗' prog='interrompida: o processo parou (máquina suspensa ou desligada?)' ;;
        *) cor=31 sinal='✗' prog="falhou: $(grep -v '^[[:space:]]*$' "$d/$id.log" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | tail -1)" ;;
      esac
      tela+=$(printf '\033[1m%d\033[0m \033[%sm%s\033[0m %s' "$i" "$cor" "$sinal" "$(corta "${nomes:-?}" $((w - 4)))")$'\033[K\n'
      tela+=$(printf '    \033[%sm%s\033[0m' "$cor" "$(corta "$prog" $((w - 4)))")$'\033[K\n'
      tela+=$(printf '    \033[90m%s\033[0m' "$(corta "$rota" $((w - 4)))")$'\033[K\n'
    done
    ((i)) || tela=$'\033[90mnenhuma transferência recente\033[0m\033[K\n'
    printf '\033[H\033[1m⇅ TRANSFERÊNCIAS\033[0m\033[K\n\033[K\n%s\033[K\n\033[90m%sq, Esc ou Enter fecha\033[0m\033[K\033[J' \
      "$tela" "${ativos:+$ativos cancela · }"
    tecla=""
    IFS= read -rsn1 -t 0.5 tecla || continue
    case $tecla in
      q | Q | '') return ;;
      $'\e') resto=""; IFS= read -rsn5 -t 0.03 resto || true; [[ -z $resto ]] && return ;;
      [1-9])
        id=${ids[tecla]:-}
        [[ -n $id ]] || continue
        case $(cat "$d/$id.status" 2>/dev/null) in 'na fila' | calculando* | transferindo*)
          kill -TERM -- "-$(cat "$d/$id.pid")" 2>/dev/null || kill -TERM "$(cat "$d/$id.pid")" 2>/dev/null
          atualizar_transferencia "$id" 'cancelada' ;; esac ;;
    esac
  done
}

transferir_fundo() {
  local id=$1; shift
  printf '%s\n' "$$" >"$(dir_transferencias)/$id.pid"
  atualizar_transferencia "$id" 'calculando tamanho…'
  if transferir_bloqueante "$id" "$@"; then
    atualizar_transferencia "$id" 'concluída'
  else
    [[ $(cat "$(dir_transferencias)/$id.status" 2>/dev/null) == cancelada ]] && return
    atualizar_transferencia "$id" 'erro — veja o log'
    avisar "✗ transferência de $(rotulo "$1") falhou — ⇅ na barra mostra o log"
  fi
}

transferir() {
  local src=$1 dsrc=$2 dst=$3 ddst=$4; shift 4
  local d id
  d=$(dir_transferencias); mkdir -p "$d"; id="$(date +%H%M%S)-$RANDOM"
  printf '%s\t%s\t%s\t%s\n' "$(rotulo "$src")" "$dsrc" "$(rotulo "$dst")" "$ddst" >"$d/$id.info"
  printf '%s\n' "$@" >"$d/$id.nomes"
  atualizar_transferencia "$id" 'na fila'
  # Sessão própria (setsid): o trabalho não pode depender do popup que o iniciou — ao fechar, o
  # tmux derruba o terminal do popup e, com ele, o ssh/tar de uma cópia ainda em curso.
  if command -v setsid >/dev/null; then
    setsid -f "$EU" --transferir-fundo "$id" "$src" "$dsrc" "$dst" "$ddst" "$@" >"$d/$id.log" 2>&1 </dev/null
  else
    nohup "$EU" --transferir-fundo "$id" "$src" "$dsrc" "$dst" "$ddst" "$@" >"$d/$id.log" 2>&1 </dev/null &
    printf '%s\n' "$!" >"$d/$id.pid"
  fi
  printf '\033[32m⇅ Transferência iniciada em segundo plano.\033[0m Você já pode continuar usando o tt; a barra mostra o andamento e avisa ao terminar.\n'
  sleep 1.2
}

# Repassa a entrada para a saída anotando em ARQ "total feitos bytes/s" (a tela das transferências
# lê dali o andamento). Sem python3, só repassa.
contador() {
  command -v python3 >/dev/null || { cat; return; }
  python3 -c '
import sys, time, os
arq, total = sys.argv[1], sys.argv[2]
i, o = sys.stdin.buffer, sys.stdout.buffer
feitos, t0, ult, base, tb = 0, time.time(), 0, 0, time.time()
def grava(taxa):
    tmp = arq + ".tmp"
    with open(tmp, "w") as f: f.write("%s %d %d\n" % (total, feitos, taxa))
    os.replace(tmp, arq)
taxa = 0
while True:
    b = i.read1(65536) if hasattr(i, "read1") else i.read(65536)
    if not b: break
    o.write(b); feitos += len(b)
    agora = time.time()
    if agora - ult >= 0.5:
        taxa = int((feitos - base) / max(agora - tb, 1e-3)); base, tb, ult = feitos, agora, agora
        o.flush(); grava(taxa)
o.flush(); grava(taxa)
' "$1" "$2"
}

# Copia NOMES de SRC:DIR_SRC para DST:DIR_DST (qualquer combinação de máquinas).
# Executada somente pelo trabalhador de fundo acima.
transferir_bloqueante() {
  local id=$1 src=$2 dsrc=$3 dst=$4 ddst=$5; shift 5
  local bytes t0 recebidos n
  bytes=$(rodar "$src" --tamanho "$dsrc" "$@")
  atualizar_transferencia "$id" "transferindo $(humano "$bytes")…"
  printf '\033[90m%s %s:%s → %s:%s (%s)…\033[0m\n' "$#" "$(rotulo "$src")" "$dsrc" "$(rotulo "$dst")" "$ddst" "$(humano "$bytes")"
  t0=$(date +%s)
  recebidos=$(rodar_io "$src" --empacotar "$dsrc" "$@" | contador "$(dir_transferencias)/$id.prog" "${bytes:-0}" | rodar_io "$dst" --receber "$ddst")
  n=$(grep -c . <<<"$recebidos")
  if ((n == 0)); then echo "✗ Nada chegou."; return 1; fi
  printf '%s em %ss · %s\n' "$(humano "$bytes")" "$(($(date +%s) - t0))" "$(date +%H:%M)" >"$(dir_transferencias)/$id.resumo"
  printf '\033[32m✓ %d ite%s (%s) em %ss → %s:%s\033[0m\n' "$n" "$([[ $n == 1 ]] && echo m || echo ns)" "$(humano "$bytes")" "$(($(date +%s) - t0))" "$(rotulo "$dst")" "$ddst"
  sed 's/^/   /' <<<"$recebidos" | head -15
  printf '\033[36m📍 em %s: %s\033[0m\n' "$(rotulo "$dst")" "$(rodar "$dst" --caminho-visivel "$ddst")"
  avisar "✓ $n ite$([[ $n == 1 ]] && echo m || echo ns) de $(rotulo "$src") → $(rotulo "$dst"):$ddst"
  [[ $dst == . ]] || rodar "$dst" --avisar "📥 $n de $(rotulo "$src") → $(rodar "$dst" --caminho-visivel "$ddst" | sed 's/  (.*//'): $(head -3 <<<"$recebidos" | paste -sd, | cut -c1-60)" >/dev/null 2>&1
}

pasta_aqui() {
  if [[ -n ${TT_PANE:-} ]]; then tmux display-message -p -t "$TT_PANE" '#{pane_current_path}' | { read -r p; encurtar "$p"; }
  else encurtar "$PWD"; fi
}

fim_transferencia() {
  local r
  read -rsn1 -p $'\n\033[90ma: abrir a pasta lá  ·  qualquer outra tecla fecha\033[0m' r
  [[ $r == [aA] ]] && rodar "$1" --abrir-pasta "$2" >/dev/null 2>&1
  return 0
}

# Fluxo "enviar": arquivos ou pastas de SRC (navegando a partir de DIR) → máquina e pasta escolhidas.
enviar_fluxo() {
  local src=${1:-.} dir=${2:-$(pasta_aqui)} dst=${3:-} ddst=${4:-} lista pasta
  local -a nomes
  lista=$(escolher_arquivos "$src" "$dir" "arquivos ou pastas para enviar") || return 0
  pasta=$(head -1 <<<"$lista"); mapfile -t nomes < <(tail -n +2 <<<"$lista")
  ((${#nomes[@]})) || return 0
  [[ -n $dst ]] || dst=$(escolher_maquina "📤 enviar ${#nomes[@]} ite$([[ ${#nomes[@]} == 1 ]] && echo m || echo ns) para" "$src") || return 0
  [[ -n $dst ]] || return 0
  [[ -n $ddst ]] || ddst=$(escolher_destino "$dst" "" "📤 para qual pasta") || return 0
  transferir "$src" "$pasta" "$dst" "$ddst" "${nomes[@]}"
}

# Fluxo "trazer": escolhe máquina, pasta de partida e arquivos/pastas de lá → DST:DDST (padrão: aqui).
trazer_fluxo() {
  local src=${1:-} dir=${2:-} dst=${3:-.} ddst=${4:-$(pasta_aqui)} lista pasta
  local -a nomes
  [[ -n $src ]] || src=$(escolher_maquina "📥 trazer de qual máquina" "$dst") || return 0
  [[ -n $src ]] || return 0
  [[ -n $dir ]] || dir=$(escolher_destino "$src" "" "📥 começar em qual pasta") || return 0
  lista=$(escolher_arquivos "$src" "$dir" "arquivos ou pastas para trazer") || return 0
  pasta=$(head -1 <<<"$lista"); mapfile -t nomes < <(tail -n +2 <<<"$lista")
  ((${#nomes[@]})) || return 0
  transferir "$src" "$pasta" "$dst" "$ddst" "${nomes[@]}"
}

# Linha de comando: tt --enviar [arquivos-ou-pastas…] [máquina[:pasta]]  /
# tt --trazer máquina:caminho… [pasta]. Uma pasta é transferida inteira, recursivamente.
enviar_cli() {
  local ultimo dst="" ddst="" maq a dir
  local -a arqs=("$@")
  if ((${#arqs[@]})); then
    ultimo=${arqs[-1]}; maq=${ultimo%%:*}
    if [[ -n $(dest_de "$maq") && ! -e $ultimo ]]; then
      dst=$(dest_de "$maq"); [[ $ultimo == *:* ]] && ddst=${ultimo#*:}
      unset 'arqs[-1]'
    fi
  fi
  if ((${#arqs[@]} == 0)); then enviar_fluxo . "$(encurtar "$PWD")" "$dst" "$ddst"; return; fi
  [[ -n $dst ]] || dst=$(escolher_maquina "📤 enviar para" .) || return 1
  [[ -n $ddst ]] || ddst=$(rodar "$dst" --pasta-recebidos)
  for a in "${arqs[@]}"; do
    [[ -e $a ]] || { echo "Não existe: $a"; return 1; }
    dir=$(cd "$(dirname "$a")" && encurtar "$PWD")
    transferir . "$dir" "$dst" "$ddst" "$(basename "$a")"
  done
}

trazer_cli() {
  local a maq src caminho ddst
  local -a origens=()
  for a in "$@"; do
    maq=${a%%:*}
    if [[ $a == *:* && -n $(dest_de "$maq") ]]; then origens+=("$a"); else ddst=$a; fi
  done
  ddst=${ddst:-$(encurtar "$PWD")}
  if ((${#origens[@]} == 0)); then trazer_fluxo "" "" . "$ddst"; return; fi
  for a in "${origens[@]}"; do
    src=$(dest_de "${a%%:*}"); caminho=${a#*:}
    transferir "$src" "$(dirname "$caminho")" . "$ddst" "$(basename "$caminho")"
  done
}


# --- Botão ✕ nas listas -----------------------------------------------------
#
# Cada sessão (e painel) da central e do seletor tem um ✕ alinhado à direita. O fzf só informa a
# LINHA clicada, então a lista roda atrás de uma camada fina (com_mouse) que anota a coluna de cada
# clique antes de repassá-lo; o clique decide: no ✕ → "fechar? ✕" (2º toque fecha), no resto →
# abre. Sem python3, a lista roda direto (sem ✕).

# Roda CMD com o terminal passando por um pty, anotando em ARQ "coluna linha" de cada clique.
com_mouse() {
  local arq=$1; shift
  command -v python3 >/dev/null || { "$@"; return; }
  # Não deixe uma coordenada de um menu anterior decidir o próximo clique se houver resize ou
  # perda de pacote de mouse antes de o fzf receber o evento atual.
  : >"$arq"
  local codigo
  # O código vai por -c: a entrada padrão é a lista que o fzf tem de ler.
  codigo=$(cat <<'PYEOF'
import os, sys, tty, termios, select, signal, fcntl, re
arq, cmd = sys.argv[1], sys.argv[2:]  # (com -c, argv[0] é "-c")
try:
    tfd = os.open('/dev/tty', os.O_RDWR)
except OSError:
    os.execvp(cmd[0], cmd)
tam = fcntl.ioctl(tfd, termios.TIOCGWINSZ, b'\0' * 8)
mfd, sfd = os.openpty()
fcntl.ioctl(sfd, termios.TIOCSWINSZ, tam)
pid = os.fork()
if pid == 0:
    os.close(mfd); os.close(tfd)
    os.setsid()
    fcntl.ioctl(sfd, termios.TIOCSCTTY, 0)
    os.dup2(sfd, 2)
    os.close(sfd)
    os.execvp(cmd[0], cmd)
os.close(sfd)
antes = termios.tcgetattr(tfd)
tty.setraw(tfd)
clique = re.compile(rb'\x1b\[<(\d+);(\d+);(\d+)([Mm])')
pendente = b''
def winch(*_):
    try:
        fcntl.ioctl(mfd, termios.TIOCSWINSZ, fcntl.ioctl(tfd, termios.TIOCGWINSZ, b'\0' * 8))
        os.kill(pid, signal.SIGWINCH)
    except OSError:
        pass
signal.signal(signal.SIGWINCH, winch)
try:
    while True:
        try:
            r, _, _ = select.select([tfd, mfd], [], [])
        except InterruptedError:
            continue
        if tfd in r:
            d = os.read(tfd, 4096)
            if not d:
                break
            # Leituras do pty podem partir uma sequência SGR de mouse em duas chamadas.
            # Conserva apenas o começo possivelmente incompleto, sem repetir evento processado.
            dados = pendente + d
            fim = 0
            for m in clique.finditer(dados):
                fim = m.end()
                botao = int(m.group(1))
                # Esquerdo pressionado (inclusive modificadores); arrasto e soltura não mudam
                # a coordenada. Os bytes inteiros seguem para o fzf logo abaixo.
                if m.group(4) == b'M' and botao & 3 == 0 and not botao & 32:
                    with open(arq, 'w') as f:
                        f.write(m.group(2).decode() + ' ' + m.group(3).decode())
            resto = dados[fim:]
            inicio = resto.rfind(b'\x1b[<')
            pendente = resto[inicio:] if inicio >= 0 else b''
            os.write(mfd, d)
        if mfd in r:
            try:
                d = os.read(mfd, 65536)
            except OSError:
                break
            if not d:
                break
            os.write(tfd, d)
finally:
    termios.tcsetattr(tfd, termios.TCSAFLUSH, antes)
_, st = os.waitpid(pid, 0)
sys.exit(os.waitstatus_to_exitcode(st))
PYEOF
)
  python3 -c "$codigo" "$arq" "$@"
}

# Colunas da área de texto da lista e onde ela começa na tela (1 = primeira coluna), conforme o
# menu (TT_COMX: seletor | central) e o tamanho da tela.
geometria_x() {
  local cols=${FZF_COLUMNS:-0} lista ini
  # No evento "start" o fzf ainda não desenhou e FZF_COLUMNS vem 0: lê do terminal.
  ((cols > 10)) || cols=$(stty size </dev/tty 2>/dev/null | awk '{ print $2 }')
  ((${cols:-0} > 10)) || cols=80
  case ${TT_COMX:-} in
    seletor)
      lista=$cols; ini=3
      [[ -n ${TT_PREVIA:-} ]] && lista=$((cols - (cols * 55 + 99) / 100 - 1)) ;;
    central)
      if [[ -n ${TT_COMPACTO:-} ]]; then lista=$cols; ini=3; else lista=$((cols - 4)); ini=5; fi ;;
    *) return 1 ;;
  esac
  echo "$((lista - 3)) $ini" # texto útil (tira o ▶ e a barra de rolagem), início do texto
}

# Filtro: põe o ✕ no fim do campo 3 de cada linha de sessão/painel ("destino<TAB>chave<TAB>texto…").
com_x() {
  local g w ini
  g=$(geometria_x) || { cat; return; }
  read -r w ini <<<"$g"
  local fx="" r sn id d
  # fixadas() tem 3 campos (rótulo, sessão, id). Sem a 3ª variável, o id entrava em $sn (com o
  # TAB) e a chave "$d|$sn" nunca casava com "destino|sessão" da linha: o pino da central ficava
  # sempre 📍 mesmo com a sessão fixada.
  while IFS=$'\t' read -r r sn id; do
    d=$(dest_de "$r"); [[ -n $d ]] && fx+="$d|$sn"$'\n'
  done < <(fixadas)
  python3 -c '
import sys, re, unicodedata
w = int(sys.argv[1]); conf = sys.argv[2]; fix = set(sys.argv[3].split("\n"))
ansi = re.compile(r"\x1b\[[0-9;]*m")
def largura(t):
    t = ansi.sub("", t)
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in t)
def cortar(t, n):
    out, u, i = [], 0, 0
    partes = re.split(r"(\x1b\[[0-9;]*m)", t)
    for p in partes:
        if ansi.fullmatch(p or "x"):
            out.append(p); continue
        for c in p:
            cw = 0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1
            if u + cw > n: return "".join(out) + "\x1b[0m"
            out.append(c); u += cw
    return "".join(out)
for linha in sys.stdin:
    linha = linha.rstrip("\n")
    c = linha.split("\t")
    if len(c) < 3 or c[1].startswith(("!", "+")) or not c[1]:
        print(linha); continue
    if c[0] + "|" + c[1] == conf:
        x = "\x1b[1;31mfechar? ✕\x1b[0m"; xl = 9
    else:
        x = "\x1b[90m✕\x1b[0m"; xl = 1
    if c[1].startswith("%"): pino = "  "
    else: pino = "📌" if c[0] + "|" + c[1] in fix else "📍"
    x = pino + "  " + x
    alvo = w - xl - 5
    t = c[2]
    if largura(t) > alvo: t = cortar(t, alvo - 1) + "…"
    c[2] = t + " " * (alvo - largura(t)) + " " + x
    print("\t".join(c))
' "$w" "$(estado confirmar)" "$fx" 2>/dev/null || cat
}

# Clique numa linha (MODO: seletor | central). No ✕: 1º toque pede confirmação, 2º fecha.
# Fora dele: abre (e esquece uma confirmação pendente).
clique_linha() {
  local dest=$1 chave=$2 g w ini xc yc lista
  [[ $TT_COMX == central ]] && lista="$EU --listar-tudo" || lista="$EU --lista-seletor"
  if [[ -z $chave || $chave == '!'* || $chave == '+'* ]] || ! g=$(geometria_x) || [[ ! -s ${TT_MOUSE:-} ]]; then
    estado_por confirmar ""; echo accept; return
  fi
  read -r w ini <<<"$g"
  read -r xc yc <"$TT_MOUSE"
  local xl=1 x_ini pino_ini
  [[ $(estado confirmar) == "$dest|$chave" ]] && xl=9
  x_ini=$((ini + w - xl))          # 1ª coluna do ✕ (ou de "fechar? ✕")
  pino_ini=$((x_ini - 4))          # o pino ocupa 2 colunas, seguido de 2 espaços
  if [[ $chave != %* ]] && ((xc >= pino_ini - 1 && xc <= pino_ini + 2)); then
    estado_por confirmar ""
    "$EU" --alternar-fixada "$dest" "$chave" >/dev/null 2>&1
    echo "reload($lista)"
    return
  fi
  if ((xc >= x_ini - 1)); then
    if [[ $(estado confirmar) == "$dest|$chave" ]]; then
      estado_por confirmar ""
      "$EU" --fechar "$dest" "$chave" >/dev/null 2>&1
    else
      estado_por confirmar "$dest|$chave"
    fi
    echo "reload($lista)"
  else
    estado_por confirmar ""
    echo accept
  fi
}

escolher() {
  local rotulo_borda=" 🖥  terminais · $MAQUINA " borda=rounded prev_janela='down,55%,border-top,follow'
  if compacto; then
    export TT_COMPACTO=1
    borda=none prev_janela='down,50%,border-top,follow,hidden'
  else
    unset TT_COMPACTO
  fi
  case ${TT_MODO:-} in
    lado) rotulo_borda+="· ⏎ abre ao lado " ;;
    embaixo) rotulo_borda+="· ⏎ abre embaixo " ;;
    aqui) rotulo_borda+="· ⏎ troca o painel " ;;
  esac
  export TT_COMX=central TT_MOUSE="$TT_ESTADO.mouse"
  # <(…) e não "listar_tudo |": o bash espera todos os estágios de um pipeline, então depois do Esc
  # ele ficava esperando a consulta às outras máquinas (ssh) acabar, e o quadro do popup não fechava.
  com_mouse "$TT_MOUSE" fzf --ansi --delimiter='\t' --with-nth=3,4 --nth="$(nth_atual)" --exact --no-hscroll --ellipsis='' \
    --tiebreak=begin,index --layout=reverse \
    --border=$borda --border-label="$rotulo_borda" --border-label-pos=3 \
    --prompt="$([[ -n ${TT_COMPACTO:-} ]] && echo "$MAQUINA ❯ " || echo '❯ ')" --pointer='▶' --info=inline-right \
    --header="$(cabecalho)" \
    --color='bg:#282a36,fg:#f8f8f2,border:#bd93f9,label:#bd93f9:bold,header:#f8f8f2,pointer:#ff79c6,prompt:#bd93f9,hl:#f1fa8c,hl+:#ffb86c,fg+:#f8f8f2,bg+:#44475a,info:#6272a4' \
    --preview="$EU --previa-em {1} {2} {q}" --preview-window="$prev_janela" \
    --bind='ctrl-/:toggle-preview' \
    --bind="ctrl-x:execute-silent($EU --fechar {1} {2})+reload($EU --listar-tudo)" \
    --bind="ctrl-n:print(nova)+accept,ctrl-r:print(renomear)+accept,ctrl-a:print(nomear)+accept" \
    --bind="ctrl-v:print(lado)+accept,ctrl-o:print(embaixo)+accept,ctrl-p:print(aqui)+accept,ctrl-t:print(soltar)+accept" \
    --bind="ctrl-s:print(enviar)+accept,ctrl-g:print(trazer)+accept" \
    --bind="ctrl-f:transform($EU --clique-cabecalho máquina),ctrl-e:transform($EU --clique-cabecalho busca)" \
    --bind="click-header:transform($EU --clique-cabecalho \"\$FZF_CLICK_HEADER_WORD\")" \
    --bind="left-click:transform($EU --clique-linha {1} {2})" \
    --track --bind="load:transform($EU --atualizar-uma-vez)" < <(lista_rapida_central)
}

# Remove o arquivo de estado do menu e todos os seus sidecars (lista, posição, marca de "fresca",
# estado do mouse). Fonte única da verdade: tanto sair_menu quanto o trap do --seletor chamam aqui,
# para não repetir a lista em dois lugares (foi assim que o .mouse escapou e vazou um arquivo por
# abertura). Novo sidecar de $TT_ESTADO entra só nesta linha.
limpar_estado() { [[ -n ${TT_ESTADO:-} ]] && rm -f "$TT_ESTADO" "$TT_ESTADO".lista "$TT_ESTADO".pos "$TT_ESTADO".fresca "$TT_ESTADO".mouse; }
sair_menu() { limpar_estado; }

# Chamados por cliques, menus e ganchos do tmux (run-shell): calados e sempre com sucesso — se
# imprimem algo ou falham, o tmux abre por cima do painel um modo de leitura com a mensagem, que
# esconde o menu/popup (parecia que o menu "sumia").
case "${1:-}" in
  --ir-fixada | --mover-fixada | --fixada-scroll | --aplicar-fixadas | --email-sync | --clique | --menu-painel | --menu-tmux | --menu-arquivos | --menu-maquinas | --menu-admin | --menu-sessao | --clique-direito | --nova-e-ir | --seletor-em | --bordas | --guarda-tamanho | --ajustar | --barras | --tema-clientes | --descongelar | --copiado | --copiar-tela | --soltar | --vigia)
    exec >/dev/null 2>&1
    trap 'exit 0' EXIT
    trap 'exit 0' TERM INT HUP ;; # o vigia é encerrado com TERM a cada atualização
esac

