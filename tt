# Reparo sob demanda do aerc (chamado por botao_email antes de abrir). A configuração completa roda na
# instalação, mas o aerc pode ter sido instalado DEPOIS do tt, ou o filtro de HTML pode apontar para
# uma ferramenta ausente; então o corpo HTML aparece VAZIO. Repara APENAS o filtro text/html, sem
# tocar binds/tema/contas. Retorna sucesso somente quando alterou o filtro, para reiniciar o aerc.
aerc_reparar_se_preciso() {
  command -v aerc >/dev/null || return 1
  local conf="$HOME/.config/aerc/aerc.conf"
  [[ -f $conf ]] || return 1   # sem config: o fluxo de cadastro cuida
  local linha_html
  linha_html=$(grep -E '^[[:space:]]*text/html[[:space:]]*=' "$conf" 2>/dev/null | tail -1)
  # (a) sem filtro text/html; (b) filtro "! html" sem w3m; (c) aponta para lynx/w3m ausente;
  # (d) usa w3m/lynx/conversor próprio mas sem o pós-filtro linkify (anterior ao OSC 8): migra.
  if [[ -z $linha_html ]] ||
     { [[ $linha_html =~ ^[[:space:]]*text/html[[:space:]]*=[[:space:]]*!*[[:space:]]*html([[:space:]]|$) ]] && ! command -v w3m >/dev/null; } ||
     { [[ $linha_html == *lynx* ]] && ! command -v lynx >/dev/null; } ||
     { [[ $linha_html == *w3m* ]] && ! command -v w3m >/dev/null; } ||
     { command -v w3m >/dev/null && [[ $linha_html == *'! html'* && ( $linha_html != *linkify* || $linha_html != *extbrowser* ) ]]; } ||
     { command -v lynx >/dev/null && [[ $linha_html == *lynx* && $linha_html != *linkify* ]]; } ||
     { ! command -v w3m >/dev/null && ! command -v lynx >/dev/null && [[ $linha_html == *email-tt.py\ html* && $linha_html != *linkify* ]]; }; then
    aerc_definir "$conf" filters text/html "$(aerc_filtro_html)" forcar
    return 0
  fi
  return 1
}

aerc_tema_suportado() {
  local v maior menor
  v=$(aerc -v 2>/dev/null | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1)
  [[ -z $v ]] && return 0   # versão não detectável: não degrada o tema (assume compatível)
  IFS=. read -r maior menor _ <<<"$v"
  ((maior > 0 || menor >= 20))
}

configurar_aerc() {
  # email= pode ser "aerc" ou um caminho para ele (ex.: ~/.local/bin/aerc); outro cliente: nada a fazer.
  local cli; cli=$(conf email); cli=${cli%% *}
  [[ -z $cli || ${cli##*/} == aerc ]] || return 0
  command -v aerc >/dev/null || return 0
  local dir="$HOME/.config/aerc" conf="$HOME/.config/aerc/aerc.conf" binds="$HOME/.config/aerc/binds.conf" tmp k v
  mkdir -p "$dir/stylesets"

  # O tema completo usa objetos disponíveis a partir do aerc 0.20. Em versões anteriores, mantém
  # tema personalizado do usuário ou troca somente o tema do tt pelo "default", evitando tela vazia.
  if aerc_tema_suportado; then
    aerc_tema >"$dir/stylesets/tt-catppuccin"
    aerc_definir "$conf" ui styleset-name tt-catppuccin
  elif ! grep -q '^[[:space:]]*styleset-name[[:space:]]*=' "$conf" 2>/dev/null ||
       grep -q '^[[:space:]]*styleset-name[[:space:]]*=[[:space:]]*tt-catppuccin[[:space:]]*$' "$conf"; then
    aerc_definir "$conf" ui styleset-name default forcar
  fi
  aerc_definir "$conf" ui mouse-enabled true forcar
  while IFS='=' read -r k v; do aerc_definir "$conf" ui "$k" "$v"; done <<'UI'
sidebar-width=24
dirlist-tree=true
dirlist-right={{if .Unread}}{{humanReadable .Unread}}{{end}}
threading-enabled=true
fuzzy-complete=true
completion-popovers=true
timestamp-format=02/01/06
this-day-time-format=15:04
this-year-time-format=02 Jan
border-char-vertical=│
border-char-horizontal=─
UI
  # Cabeçalhos em disco (~/.cache/aerc): abrir uma pasta deixa de rebaixar tudo pela rede a cada
  # vez; a consulta reusa o que já foi buscado e só pede o que mudou. É o ganho de velocidade mais
  # barato para caixas grandes ou link lento, sem store local nem dependência nova.
  aerc_definir "$conf" ui cache-headers true
  # HTML é o padrão quando o e-mail tem as duas versões (o w3m mostra tabelas, cores e links).
  aerc_definir "$conf" statusline column-right '{{.TrayInfo}}  ? atalhos · F2 contas · Ctrl+r redesenha · q fecha'
  grep -q '^column-right={{.TrayInfo}}  ? atalhos · F2 contas · q fecha$' "$conf" &&
    aerc_definir "$conf" statusline column-right '{{.TrayInfo}}  ? atalhos · F2 contas · Ctrl+r redesenha · q fecha' forcar
  aerc_definir "$conf" viewer alternatives text/html,text/plain
  grep -q '^alternatives=text/plain,text/html$' "$conf" && aerc_definir "$conf" viewer alternatives text/html,text/plain forcar
  # HTML: sem o w3m o filtro "html" do aerc falha e o e-mail aparece vazio; troca pelo melhor disponível.
  # Também migra o filtro antigo (w3m/lynx sem o pós-filtro linkify) para a versão com links OSC 8.
  local f_html; f_html=$(aerc_filtro_html)
  if ! grep -q '^[[:space:]]*text/html[[:space:]]*=' "$conf" 2>/dev/null ||
     { grep -q '^[[:space:]]*text/html[[:space:]]*=[[:space:]]*!*[[:space:]]*html[[:space:]]*$' "$conf" && ! command -v w3m >/dev/null; } ||
     { grep -q '^[[:space:]]*text/html[[:space:]]*=.*email-tt.py html' "$conf" && ! grep -q '^[[:space:]]*text/html[[:space:]]*=.*linkify' "$conf"; } ||
     { command -v w3m >/dev/null && grep -qE '^[[:space:]]*text/html[[:space:]]*=.*! *html' "$conf" && ! grep -q '^[[:space:]]*text/html[[:space:]]*=.*extbrowser' "$conf"; } ||
     { command -v w3m >/dev/null && grep -q '^[[:space:]]*text/html[[:space:]]*=[[:space:]]*lynx -assume_charset=utf-8' "$conf"; } ||
     { command -v lynx >/dev/null && grep -q '^[[:space:]]*text/html[[:space:]]*=.*lynx' "$conf" && ! grep -q '^[[:space:]]*text/html[[:space:]]*=.*linkify' "$conf"; }; then
    aerc_definir "$conf" filters text/html "$f_html" forcar
  fi

  # Abertura de link (:open-link, Ctrl+l): o tt --abrir-url escolhe o abridor da plataforma (xdg-open
  # no desktop, termux-open-url no Termux) e, sem GUI (ssh), copia a URL para a área de transferência
  # para colar em outro aparelho. {} é a URL, com aspas postas pelo aerc.
  aerc_definir "$conf" openers 'x-scheme-handler/http*' "$HOME/.local/bin/tt --abrir-url {}"
  aerc_definir "$conf" openers 'x-scheme-handler/https*' "$HOME/.local/bin/tt --abrir-url {}"

  # Sem binds.conf (ou sem os atalhos básicos), o arquivo do tt substituiria os padrões do aerc e
  # nem o Enter abriria a mensagem: começa pela cópia do binds.conf que vem com o aerc.
  if ! grep -q '^<Enter> = :view' "$binds" 2>/dev/null; then
    local pd real; real=$(readlink -f "$(command -v aerc)")
    for pd in "$HOME/.local/share/aerc" /usr/share/aerc /usr/local/share/aerc "${PREFIX:-/nonexistent}/share/aerc" "$(dirname "$real")/../share/aerc"; do
      [[ -f $pd/binds.conf ]] && { { cat "$pd/binds.conf"; [[ ! -s $binds ]] || cat "$binds"; } >"$binds.novo" && mv "$binds.novo" "$binds"; break; }
    done
  fi
  # binds.conf: bloco do tt entre marcadores. q/Q saem na hora (o título do popup diz "q fecha") e
  # ações comuns ganham teclas fáceis, na lista e na leitura da mensagem.
  [[ -f $binds ]] || : > "$binds"
  tmp=$(mktemp) || return 1
  { awk -v i="$AERC_BINDS_INI" -v f="$AERC_BINDS_FIM" '$0==i{p=1} !p{print} $0==f{p=0}' "$binds"
    echo "$AERC_BINDS_INI"
    # (nada antes do primeiro cabeçalho: o bloco fica no fim do arquivo, e linhas soltas cairiam na
    # última seção do binds.conf — em geral [terminal], onde q fecharia o aerc no meio de um terminal)
    echo '[messages]'
    echo "? = :term $HOME/.local/bin/tt --email-atalhos<Enter>"
    echo "<F2> = :term $HOME/.local/bin/tt --email-contas-ui<Enter>"
    echo '<C-r> = :redraw<Enter>'
    echo 'q = :quit<Enter>'
    echo 'Q = :quit<Enter>'
    echo 'u = :read -t<Enter>'
    echo '* = :flag -t<Enter>'
    echo 'f = :forward<Enter>'
    echo 'M = :move<space>'
    echo 'Y = :copy<space>'
    echo 'F = :filter -X Seen<Enter>'
    echo '[view]'
    echo "? = :term $HOME/.local/bin/tt --email-atalhos<Enter>"
    echo "E = :save -a -f -p $HOME/.cache/tt-anexos/atual/<Enter>:term $HOME/.local/bin/tt --anexos-enviar<Enter>"
    echo 'q = :close<Enter>'
    echo '<C-r> = :redraw<Enter>'
    echo 'u = :read -t<Enter>:close<Enter>'
    echo '* = :flag -t<Enter>'
    echo 'f = :forward<Enter>'
    echo 'M = :move<space>'
    echo 'Y = :copy<space>'
    echo 'a = :archive flat<Enter>'
    echo 'd = :choose -o y '"'"'Apagar esta mensagem'"'"' delete-message<Enter>'
    echo "$AERC_BINDS_FIM"; } > "$tmp"
  cmp -s "$tmp" "$binds" 2>/dev/null || cat "$tmp" > "$binds"; rm -f "$tmp"
}
remover_aerc() {
  local binds="$HOME/.config/aerc/binds.conf" tmp
  grep -qxF "$AERC_BINDS_INI" "$binds" 2>/dev/null || return 0
  tmp=$(mktemp) && awk -v i="$AERC_BINDS_INI" -v f="$AERC_BINDS_FIM" '$0==i{p=1} !p{print} $0==f{p=0}' "$binds" >"$tmp" && cat "$tmp" >"$binds"; rm -f "$tmp"
}

# Abertura automática no tmux: bloco no fim do ~/.bashrc, entre marcadores, para que cada janela
# de terminal vire uma sessão do tt. Idempotente (também reconhece o trecho antigo, sem marcadores)
# e com backup em ~/.bashrc.antes-tt.
BASHRC_INI='# >>> tt (terminais em tmux) >>>'
BASHRC_FIM='# <<< tt (terminais em tmux) <<<'

bashrc_bloco() {
  cat <<'BLOCO'
# A paleta comum chega antes do tmux: vale também para SSH e para terminais
# abertos diretamente nesta máquina. Em emuladores que não aceitam OSC, não faz nada.
[[ -r "$HOME/.local/share/tt/tema-terminal.sh" ]] && source "$HOME/.local/share/tt/tema-terminal.sh"
[[ -x "$HOME/.local/share/tt/tema-agentes.sh" ]] && "$HOME/.local/share/tt/tema-agentes.sh" --aplicar >/dev/null 2>&1
[[ -x "$HOME/.local/share/tt/memoria-agentes.sh" ]] && "$HOME/.local/share/tt/memoria-agentes.sh" --aplicar >/dev/null 2>&1
# Política AI-DLC: a do perfil, se o usuário tiver a própria; senão a do pacote.
for _tt_p in "$HOME/.config/tt/AI-DLC.md" "$HOME/.local/share/tt/AI-DLC.md"; do
  [[ -r $_tt_p ]] && { export TT_AIDLC_POLICY=$_tt_p; break; }
done; unset _tt_p

# Toda janela de terminal (GNOME Terminal / Windows Terminal / Termux) abre numa sessão tmux própria,
# para poder ser assumida de outro lugar pela central `tt`.
# Fica de fora: terminais de IDE, SSH e shells não interativos. Para abrir uma janela sem tmux: NOTMUX=1
if [[ $- == *i* && -t 0 && -t 1 && -z ${TMUX:-} && -z ${NOTMUX:-} && -z ${SSH_CONNECTION:-} \
      && -z ${TERM_PROGRAM:-} && -z ${TERMINAL_EMULATOR:-} \
      && ( -n ${VTE_VERSION:-} || -n ${WT_SESSION:-} || -n ${TERMUX_VERSION:-} ) ]] \
   && command -v tmux >/dev/null && [[ -x $HOME/.local/bin/tt ]]; then
  exec "$HOME/.local/bin/tt" --janela
fi
BLOCO
}

# Em atualizações, substitui somente o conteúdo do bloco gerenciado pelo tt. Assim a paleta nova
# chega às máquinas já cadastradas sem tocar no restante do ~/.bashrc.
# Trecho antigo, sem marcadores (instalações anteriores aos marcadores): o bloco "if … exec tt
# --janela … fi", com os comentários logo acima dele. Imprime "início fim" (linhas) se achar
# exatamente esse formato; senão nada (e o ~/.bashrc não é tocado).
bashrc_trecho_antigo() {
  awk '
    /^# Toda janela de terminal/ && !ini { com = NR }
    /^if \[\[ \$- == \*i\*/ && !ini { ini = (com && com >= NR - 4) ? com : NR; next }
    !ini && !/^#/ { com = 0 }
    ini && /tt" --janela$/ { exe = 1 }
    ini && /^fi$/ { if (exe && NR - ini < 16) print ini, NR; exit }
  ' "$1"
}

atualizar_bashrc() {
  local rc=$HOME/.bashrc tmp ini fim
  if ! grep -qF "$BASHRC_INI" "$rc" 2>/dev/null; then
    read -r ini fim < <(bashrc_trecho_antigo "$rc")
    [[ -n $fim ]] || return 0
    cp -p "$rc" "$rc.antes-marcadores"
    tmp=$(mktemp "${rc}.tt.XXXXXX") || return 1
    { head -n $((ini - 1)) "$rc"; echo "$BASHRC_INI"; echo "$BASHRC_FIM"; tail -n +$((fim + 1)) "$rc"; } >"$tmp" &&
      cat "$tmp" >"$rc" && rm -f "$tmp"
  fi
  tmp=$(mktemp "${rc}.tt.XXXXXX") || return 1
  {
    awk -v i="$BASHRC_INI" '$0 == i { print; exit } { print }' "$rc"
    bashrc_bloco
    awk -v f="$BASHRC_FIM" '$0 == f { mostra = 1 } mostra { print }' "$rc"
  } >"$tmp" && mv "$tmp" "$rc"
}

configurar_bashrc() {
  local rc=$HOME/.bashrc
  if grep -qF -e "$BASHRC_INI" -e 'tt" --janela' "$rc" 2>/dev/null; then
    echo "~/.bashrc: já configurado, nada a fazer."; return 0
  fi
  [[ -f $rc ]] && cp -p "$rc" "$rc.antes-tt"
  { [[ -s $rc ]] && echo; echo "$BASHRC_INI"; bashrc_bloco; echo "$BASHRC_FIM"; } >>"$rc" || return 1
  echo "~/.bashrc: configurado (backup em ~/.bashrc.antes-tt). Abra um terminal novo para valer."
}

remover_bashrc() {
  local rc=$HOME/.bashrc
  if ! grep -qF "$BASHRC_INI" "$rc" 2>/dev/null; then
    if grep -qF 'tt" --janela' "$rc" 2>/dev/null; then echo "~/.bashrc: o trecho do tt não tem marcadores; remova-o à mão."
    else echo "~/.bashrc: nada do tt para remover."; fi
    return 0
  fi
  cp -p "$rc" "$rc.antes-tt"
  awk -v i="$BASHRC_INI" -v f="$BASHRC_FIM" '$0 == i { pula = 1; next } $0 == f { pula = 0; next } !pula' "$rc.antes-tt" >"$rc"
  echo "~/.bashrc: trecho do tt removido (backup em ~/.bashrc.antes-tt)."
}

rotulo() { [[ $1 == . ]] && echo "$MAQUINA" || rotulo_de "$1"; }

# Linhas "destino<TAB>chave<TAB>texto<TAB>busca" de uma máquina (destino "." é esta).
rotular() {
  awk -F'\t' -v d="$1" -v r="$2" '{ printf "%s\t%s\t\033[34m%-8.8s\033[0m %s\t%s %s\n", d, $1, r, $2, $3, r }'
}

listar_remoto() {
  local dest=$1 rot=$2 saida err st
  err=$(mktemp)
  saida=$(timeout 6 ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --listar" 2>"$err" </dev/null)
  st=$?
  if ((st == 0)); then
    if [[ -n $saida ]]; then rotular "$dest" "$rot" <<<"$saida"
    else printf '!nova\t\033[90m+ nenhuma sessão — Enter cria uma\033[0m\n' | rotular "$dest" "$rot"; fi
  elif grep -q 'login.tailscale.com' "$err"; then
    printf '!autorizar\t\033[33m🔒 precisa autorizar o acesso (Enter mostra o link)\033[0m\n' | rotular "$dest" "$rot"
  elif ((st == 127)); then
    printf '!instalar\t\033[90m✗ não tem o tt — Enter instala\033[0m\n' | rotular "$dest" "$rot"
  else
    printf '!erro\t\033[90m✗ sem resposta (%s)\033[0m\n' "$(tail -1 "$err" | cut -c1-50)" | rotular "$dest" "$rot"
  fi
  rm -f "$err"
}

# Estado do menu aberto (filtro de máquina, escopo da busca), num arquivo temporário por menu.
estado() { [[ -n ${TT_ESTADO:-} ]] && sed -n "s/^$1=//p" "$TT_ESTADO" 2>/dev/null | tail -1; }
estado_por() { [[ -n ${TT_ESTADO:-} ]] && echo "$1=$2" >>"$TT_ESTADO"; }
nth_atual() { [[ $(estado busca) == nomes ]] && echo 1 || echo 1,2; }

# Menu completo: esta máquina primeiro, depois as outras (consultadas em paralelo).
# Com filtro de máquina, só ela.
# A consulta às máquinas não pode herdar o terminal do popup (entrada e saída de erros): o tmux só
# fecha o quadro quando todos os processos soltam aquele terminal, e um ssh ainda respondendo depois
# do Esc segurava o quadro aberto por segundos. Só a lista (stdout) vai para o fzf.
listar_tudo() { (exec </dev/null 2>/dev/null; listar_tudo_ "$@"); } # exec: sem cópias guardadas do terminal
listar_tudo_() {
  if [[ ${TT_COMX:-} == central && -z ${TT_SEM_X:-} ]]; then TT_SEM_X=1 listar_tudo_ | com_x; return; fi
  local tmp dest rot i=0 n filtro
  filtro=$(estado maquina)
  [[ $filtro == todas ]] && filtro=""
  tmp=$(mktemp -d)
  while read -r dest rot; do
    [[ -z $filtro || $filtro == "$rot" ]] || continue
    i=$((i + 1)); echo "$rot" >>"$tmp/rotulos"
    listar_remoto "$dest" "$rot" >"$tmp/$i" &
  done < <(maquinas)
  [[ -z $filtro || $filtro == "$MAQUINA" ]] && listar | rotular . "$MAQUINA"
  wait
  for ((n = 1; n <= i; n++)); do
    cat "$tmp/$n"
    # A última lista de cada máquina fica guardada: a central abre na hora com ela (lista_rapida).
    [[ -s $tmp/$n ]] && ! grep -q '^[^	]*	!erro' "$tmp/$n" && cp "$tmp/$n" "$(cache_lista "$(sed -n "${n}p" "$tmp/rotulos")")"
  done
  rm -rf "$tmp"
}
cache_lista() { echo "$RT/tt-lista-$(id -u)-$1"; }

# Mestre de obras (fase 1, só recomendar): `tt --listar-tudo --tsv|--para-ia [-n N]` descreve as
# sessões DESTA máquina para um chefe IA decidir o que podar. Nunca fecha nada. Contrato fechado no
# tt-mesh (referência: tools/mesh-sessoes), colunas fixas:
#   maquina sessao anexada ocioso_s janelas cmd_1oplano agente fixada papel rascunho titulo ultima_linha
# agente: claude/codex/… entre os DESCENDENTES do pane (o atalho roda `bash -c claude`: o cmd mente).
# rascunho: 1 = texto não enviado no prompt (›/❯); 0 = vazio, placeholder (esmaecido, SGR 2), status
# do agente ou item de menu; - = sem prompt. ultima_linha pula prompt, réguas e rodapés de TUI.
# Sem aritmética de bytes no awk: gawk em UTF-8 conta caracteres, mawk conta bytes.
SESSOES_IA_CAB='maquina	sessao	anexada	ocioso_s	janelas	cmd_1oplano	agente	fixada	papel	rascunho	titulo	ultima_linha'
sessoes_ia_agentes() {
  ps -e -o pid=,ppid=,comm= 2>/dev/null | awk -v raiz="$1" '
    { pai[$1]=$2; nome[$1]=$3 }
    END { for (p in pai) { q=p; while (q in pai && q!=raiz && q>1) q=pai[q]
            if (q==raiz && p!=raiz && nome[p] ~ /^(claude|codex|kiro|kiro-cli|aerc|node|ssh|vim|nvim|python3?)$/) v[nome[p]]=1 }
          for (k in v) printf "%s%s", (n++?",":""), k }'
}
sessoes_ia_conteudo() {
  awk '{ l=$0; t=l; gsub(/[ \t]/, "", t); r=t; gsub(/─|━|═|╭|╮|╰|╯|│|\302\240/, "", r)
         if (t=="" || r=="" || index(t,"────")==1) next
         if (index(t,"›")==1 || index(t,"❯")==1) next
         if (index(l,"for shortcuts") || index(l,"for agents") || index(l,"bypass permissions") || index(l,"auto mode") ||
             index(l,"shift+tab to cycle") || index(l,"esc to interrupt") || index(l,"esc back") || index(l,"/clear to save") ||
             index(l," · ~ · ") || index(l,"f2 to view")) next
         u=l } END { print u }'
}
sessoes_ia_rascunho() {
  awk 'BEGIN { r="-" }
       { l=$0; p=index(l,"›"); if (!p) p=index(l,"❯"); if (!p) next
         pre=substr(l,1,p-1); gsub(/\033\[[0-9;]*m|[ \t]/, "", pre); if (pre!="") next
         x=substr(l,p); sub(/^(›|❯)/, "", x); dim=0
         while (1) {
           if (substr(x,1,1)==" ") { x=substr(x,2); continue }
           if (index(x,"\302\240")==1) { x=substr(x,1+length("\302\240")); continue }
           if (match(x, /^\033\[[0-9;]*m/)) { sg=substr(x,3,RLENGTH-3)
             if (sg ~ /(^|;)2$/) dim=1; else if (sg ~ /(^|;)(0|22)?$/ || sg=="") dim=0
             x=substr(x,RLENGTH+1); continue }
           break }
         gsub(/\033\[[0-9;]*m/, "", x); gsub(/^[ \t]+|[ \t]+$/, "", x)
         if (x=="" || dim || index(x,"is working") || index(x,"esc to") || index(x,"Type to steer") || x ~ /^[0-9]+\. /) r=0; else r=1 }
       END { print r }'
}
sessoes_ia_limpa() { tr '\t\r\n' '   ' | sed 's/[[:space:]]\{1,\}/ /g; s/^ //; s/ $//' | cut -c1-160; }
sessoes_ia_linhas() {
  local maq agora fix s at act jan marca alvo cmd ag tit papel ult ras f
  maq=${TT_MACHINE:-$MAQUINA}; maq=${maq//_/-}
  agora=$(date +%s)
  fix=$(fixadas | awk -F'\t' -v m="$MAQUINA" '$1 == m { print $2 }')
  while IFS=$'\t' read -r s at act jan marca; do
    [[ $s == _tt-* ]] && continue # sessões ocultas do tt (e-mail aberto): nunca entram na poda
    alvo="=$s:"
    cmd=$(tmux display-message -p -t "$alvo" '#{pane_current_command}' 2>/dev/null | sessoes_ia_limpa)
    ag=$(sessoes_ia_agentes "$(tmux display-message -p -t "$alvo" '#{pane_pid}' 2>/dev/null)")
    tit=$(tmux display-message -p -t "$alvo" '#{pane_title}' 2>/dev/null | sessoes_ia_limpa)
    papel=$(tmux list-windows -t "$alvo" -F '#{@tt_papel}' 2>/dev/null | grep -v '^$' | sort -u | paste -sd, -)
    ult=$(tmux capture-pane -p -t "$alvo" 2>/dev/null | sessoes_ia_conteudo | sessoes_ia_limpa)
    ras=$(tmux capture-pane -p -e -t "$alvo" 2>/dev/null | sessoes_ia_rascunho)
    f=0; [[ $marca == 1 ]] || grep -qxF -- "$s" <<<"$fix" && f=1
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$maq" "$s" "$at" "$((agora - ${act:-$agora}))" "$jan" \
      "${cmd:--}" "${ag:--}" "$f" "${papel:--}" "${ras:--}" "${tit:--}" "${ult:--}"
  done < <(tmux list-sessions -F '#{session_name}'$'\t''#{session_attached}'$'\t''#{session_activity}'$'\t''#{session_windows}'$'\t''#{@tt_fixada}' 2>/dev/null)
}
sessoes_ia() { # --tsv | --para-ia [-n N]
  local modo=$1 n=5 s
  [[ ${2:-} == -n && ${3:-} =~ ^[0-9]+$ ]] && n=$3
  if [[ $modo == --tsv ]]; then echo "$SESSOES_IA_CAB"; sessoes_ia_linhas; return 0; fi
  echo "# mestre de obras — ${TT_MACHINE:-$MAQUINA} — $(date -u +%Y%m%dT%H%M%SZ)"
  echo "Regras: NUNCA fechar anexada>0, fixada=1, papel singleton (email etc.; 'atalho' não conta), nem agente!=- (processo vivo no pane), nem rascunho=1 (texto não enviado) sem ok do dono."
  echo "Só recomendar shell puro (bash/zsh/sh) ocioso >= 1800 s com prompt vazio. Em dúvida, manter."
  echo; echo '```tsv'; echo "$SESSOES_IA_CAB"; sessoes_ia_linhas; echo '```'; echo
  while read -r s; do
    echo "## $s (últimas $n linhas)"
    echo '```'; tmux capture-pane -p -t "=$s:" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -n "$n" | cut -c1-200; echo '```'
  done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)
}

# Abertura instantânea da central (lista_rapida, sem sufixo, é a do seletor): esta máquina fresca (~0,1 s) e as outras com a última lista
# conhecida (marcada como "…" até a consulta terminar). Logo depois a central troca pela lista
# fresca (listar_tudo), mantendo o item em que você está (--track).
lista_rapida_central() {
  (exec </dev/null 2>/dev/null
   if [[ ${TT_COMX:-} == central && -z ${TT_SEM_X:-} ]]; then TT_SEM_X=1 lista_rapida_central | com_x; exit; fi
   local dest rot filtro c
   filtro=$(estado maquina); [[ $filtro == todas ]] && filtro=""
   [[ -z $filtro || $filtro == "$MAQUINA" ]] && listar | rotular . "$MAQUINA"
   while read -r dest rot; do
     [[ -z $filtro || $filtro == "$rot" ]] || continue
     c=$(cache_lista "$rot"); [[ -s $c ]] && cat "$c"
   done < <(maquinas))
}

rotulos() { echo "$MAQUINA"; maquinas | awk '{ print $2 }'; }

# Cabeçalho do menu. Cada palavra é clicável (veja clique_cabecalho).
cabecalho() {
  local m b r linha="máquina:"
  m=$(estado maquina); m=${m:-todas}
  b=$(estado busca); b=${b:-tudo}
  for r in todas $(rotulos); do
    [[ $r == "$m" ]] && linha+=" \033[1;30;46m $r \033[0m" || linha+="  $r "
  done
  linha+="    busca:"
  for r in tudo nomes; do
    [[ $r == "$b" ]] && linha+=" \033[1;30;45m $r \033[0m" || linha+="  $r "
  done
  printf '%b\n' "$linha"
  if [[ -n ${TT_COMPACTO:-} && $(estado ajuda) != 1 ]]; then
    printf '\033[90m%s\033[0m\n' "toque abre · ? ajuda · prévia · esc sai"
    return
  fi
  [[ -n ${TT_COMPACTO:-} ]] && printf '\033[90m%s\033[0m\n' "? menos · prévia (^/) · esc sai"
  echo "⏎ entrar   ^n nova   ^r renomear   ^x fechar   ^t soltar   ^a nomear-todas"
  echo "^v ao-lado   ^o embaixo   ^p trocar-painel   ^s enviar   ^g trazer"
  echo "^f filtrar   ^e busca   ⚙ tmux…   🖥 máquinas…   esc sair"
}

# Palavra do texto que contém a coluna C (conta caracteres, não bytes; tolera a coluna vizinha).
palavra_em() {
  local t=$1 c=$2 i a b
  for i in $((c - 1)) "$c" $((c - 2)); do
    ((i >= 0 && i < ${#t})) && [[ ${t:i:1} != " " ]] && break
    i=-1
  done
  ((i >= 0)) || return
  a=$i; while ((a > 0)) && [[ ${t:a-1:1} != " " ]]; do a=$((a - 1)); done
  b=$i; while ((b < ${#t} - 1)) && [[ ${t:b+1:1} != " " ]]; do b=$((b + 1)); done
  echo "${t:a:b-a+1}"
}

# Clique numa palavra do cabeçalho (ou ^f/^e): devolve as ações do fzf a executar.
clique_cabecalho() {
  local w=$1 r m lista l c texto
  # Clique: o fzf 0.60 entrega a linha inteira (com cores) em vez da palavra; acha a palavra pela
  # coluna clicada na linha do cabeçalho.
  l=${FZF_CLICK_HEADER_LINE:-0} c=${FZF_CLICK_HEADER_COLUMN:-0}
  if ((l > 0)); then
    texto=$(cabecalho | sed -n "${l}p" | sed 's/\x1b\[[0-9;]*m//g')
    w=$(palavra_em "$texto" "$c")
  fi
  case $w in
    ⏎ | entrar) echo accept; return ;;
    ^n | nova) echo 'print(nova)+accept'; return ;;
    ^r | renomear) echo 'print(renomear)+accept'; return ;;
    ^t | soltar) echo 'print(soltar)+accept'; return ;;
    ^a | nomear-todas) echo 'print(nomear)+accept'; return ;;
    ^v | ao-lado) echo 'print(lado)+accept'; return ;;
    ^o | embaixo) echo 'print(embaixo)+accept'; return ;;
    ^p | trocar-painel) echo 'print(aqui)+accept'; return ;;
    ^s | enviar) echo 'print(enviar)+accept'; return ;;
    ^g | trazer) echo 'print(trazer)+accept'; return ;;
    ⚙ | tmux…) echo 'print(tmux)+accept'; return ;;
    🖥 | máquinas…) echo 'print(maquinas)+accept'; return ;;
    ^x | fechar) echo "execute-silent($EU --fechar {1} {2})+reload($EU --listar-tudo)"; return ;;
    esc | sair | sai) echo abort; return ;;
    tudo | nomes) estado_por busca "$w" ;;
    '?' | ajuda | menos) [[ $(estado ajuda) == 1 ]] && estado_por ajuda 0 || estado_por ajuda 1
      echo "transform-header($EU --cabecalho)"; return ;;
    prévia | 'prévia (^/)') echo toggle-preview; return ;;
    ^e | busca | busca:) [[ $(estado busca) == nomes ]] && estado_por busca tudo || estado_por busca nomes ;;
    ^f | filtrar | máquina:)
      # Próxima máquina na roda: todas → esta → as outras → todas.
      mapfile -t lista < <(echo todas; rotulos)
      m=$(estado maquina); m=${m:-todas}
      for ((r = 0; r < ${#lista[@]}; r++)); do [[ ${lista[r]} == "$m" ]] && break; done
      estado_por maquina "${lista[(r + 1) % ${#lista[@]}]}" ;;
    *)
      for r in todas $(rotulos); do [[ $w == "$r" ]] && estado_por maquina "$r"; done ;;
  esac
  echo "reload($EU --listar-tudo)+transform-header($EU --cabecalho)+change-nth($(nth_atual))"
}

# Cita para o shell de lá. O printf %q não escapa um "=" no começo da palavra: o bash aceita, mas o
# zsh (padrão do macOS) expande =palavra como o caminho de um comando — "tmux attach -t =sessão"
# virava "sessão not found" e a ponte fechava na hora. Por isso o "=" inicial ganha uma barra.
q() {
  local a o
  for a in "$@"; do
    printf -v o '%q' "$a"
    [[ $o == =* ]] && o="\\$o"
    printf '%s ' "$o"
  done
}

# Roda um subcomando do tt em DEST ("." = aqui). rodar_tty: interativo (pergunta algo na tela).
rodar() {
  local dest=$1; shift
  if [[ $dest == . ]]; then "$EU" "$@"
  else ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO $(q "$@")" </dev/null; fi
}
rodar_tty() {
  local dest=$1; shift
  if [[ $dest == . ]]; then "$EU" "$@"
  else ssh -t "${SSH_OPC[@]}" "$dest" "$TT_REMOTO $(q "$@")"; fi
}

previa_em() {
  local dest=$1 s=$2 qq=${3:-}
  [[ $dest == . ]] && { previa "$s" "$qq"; return; }
  case $s in
    !autorizar) echo "O Tailscale SSH desta máquina pede confirmação no navegador."
                echo "Enter mostra o link; depois de aprovar, vale por umas 12 h." ;;
    !instalar)  echo "Enter copia este tt para ~/.local/bin/tt de $dest (precisa de tmux e fzf lá)." ;;
    !nova)      echo "Enter cria uma sessão nova em $dest e entra nela." ;;
    !erro)      echo "Não consegui falar com $dest (desligada, sem rede ou sem ssh)."; echo "Saia e abra o menu de novo para tentar outra vez." ;;
    *) timeout 6 ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --previa $(q "$s" "$qq")" 2>/dev/null </dev/null ;;
  esac
}

# ^x: fecha a sessão, ou só o painel (linhas ├/└).
fechar_em() {
  local dest=$1 s=$2 cmd
  [[ $s == [+!]* || -z $s ]] && return
  [[ $s == %* ]] && cmd="kill-pane -t $(q "$s")" || cmd="kill-session -t $(q "=$s")"
  if [[ $dest == . ]]; then
    eval "tmux $cmd" || return
  else
    timeout 6 ssh "${SSH_OPC[@]}" "$dest" "$PATH_REMOTO tmux $cmd" </dev/null || return
  fi
  # Fechar uma sessão pelo tt é uma identificação imediata: não espere o próximo ciclo do vigia
  # para retirar um eventual item fixado.
  [[ $s == %* ]] || reconciliar_fixadas
}

# Painel %N: deixa ele em foco na sessão dele e imprime o nome da sessão.
focar() {
  tmux select-window -t "$1" && tmux select-pane -t "$1" && tmux display-message -p -t "$1" '#{session_name}'
}

# Painel %N vira uma sessão própria (sai da janela onde está). Imprime o nome da sessão nova.
soltar_painel() {
  local p=$1 nome
  nome=$(limpar "$(tmux show-options -pqv -t "$p" @nome_painel)")
  [[ -z $nome ]] || tmux has-session -t "=$nome" 2>/dev/null && nome=$(proximo_nome)
  tmux new-session -d -s "$nome" -n tt-temp || return 1
  tmux break-pane -d -s "$p" -t "=$nome:" && tmux kill-window -t "=$nome:tt-temp" || return 1
  tmux set-option -t "=$nome:" @nome_auto "$([[ $nome == janela-* ]] && echo 1 || echo 0)"
  echo "$nome"
}

renomear_painel() {
  local p=$1 atual novo
  atual=$(tmux show-options -pqv -t "$p" @nome_painel)
  read -rep "Nome do painel: " -i "$atual" novo || return
  tmux set-option -p -t "$p" @nome_painel "$novo"
}

# Comando que mostra a sessão S (de "." = esta máquina, ou de usuario@host) num terminal/painel.
# Nas outras máquinas, o tmux de lá fica sabendo de onde veio (TT_PONTE="máquina|sessão-ponte"),
# para devolver para cá as trocas de sessão feitas pela barra de lá (veja ir_para).
cmd_ver() {
  if [[ $1 == . ]]; then echo "env -u TMUX tmux attach -t $(q "=$2")"
  else echo "ssh -t $(q "${SSH_OPC[@]}") $(q "$1") $(q "$PATH_REMOTO exec env TT_PONTE=$(q "$MAQUINA|${3:-}") tmux attach -t $(q "=$2")")"; fi
}

# Uma ponte não pode morrer junto com o ssh: se isso acontecia enquanto uma tela estava dentro
# dela, o tmux desconectava essa tela — e a janela do terminal fechava. Este processo fica vivo
# na sessão-ponte, mostra o erro e permite tentar novamente. Ctrl+B d continua sendo a saída
# normal da ponte.
ponte() {
  local dest=$1 s=$2 ponte=$3 st
  # Uma ponte antiga pode chegar aqui sem host (ex.: o rótulo deixou de resolver). Não
  # repetir SSH com destino vazio: isso produz "Could not resolve hostname" para sempre.
  if [[ -z $dest || $dest == : ]]; then
    clear
    printf 'Destino remoto inválido para a sessão %s (host vazio).\n' "$s"
    printf 'Pressione Enter para abrir o seletor e escolher outra sessão; Ctrl+B d para voltar. '
    read -r
    exec "$EU"
  fi
  while true; do
    clear
    printf 'Conectando a %s:%s…\n' "$(rotulo_de "$dest")" "$s"
    # Alvo que não existe mais no destino não vira loop eterno de reconexão: a ponte seria uma
    # sessão fantasma (aparece viva na máquina de origem, sem par real do outro lado). Só paramos
    # quando o destino RESPONDE e confirma que a sessão sumiu; se ele não responde (rede/SSH caiu),
    # mantemos o comportamento antigo de permitir nova tentativa.
    if ! sessao_remota_existe "$dest" "$s" && alcanca_destino "$dest"; then
      printf '\n\033[33mA sessão %s:%s não existe mais no destino. Encerrando esta ponte.\033[0m\n' \
        "$(rotulo_de "$dest")" "$s"
      sleep 1
      tmux kill-session -t "=$ponte" 2>/dev/null
      return 0
    fi
    ssh -t "${SSH_OPC[@]}" "$dest" \
      "$PATH_REMOTO exec env TT_PONTE=$(q "$MAQUINA|$ponte") tmux attach -t $(q "=$s")"
    st=$?
    # O attach terminou. Se a sessão sumiu no destino (fim normal: a sessão de lá foi fechada), a
    # ponte não tem mais o que mostrar — encerra em vez de oferecer reconexão a um alvo morto.
    if ! sessao_remota_existe "$dest" "$s" && alcanca_destino "$dest"; then
      printf '\n\033[33mA sessão %s:%s foi encerrada no destino. Fechando esta ponte.\033[0m\n' \
        "$(rotulo_de "$dest")" "$s"
      sleep 1
      tmux kill-session -t "=$ponte" 2>/dev/null
      return 0
    fi
    printf '\n\033[33mA conexão com %s:%s terminou (código %s).\033[0m\n' "$(rotulo_de "$dest")" "$s" "$st"
    printf 'A janela foi preservada. Pressione Enter para tentar novamente ou Ctrl+B d para voltar. '
    read -r
  done
}

# Confere antes da troca se a sessão ainda existe. A checagem impede que um item fixado antigo
# mande a tela para uma ponte que já vai falhar; a função ponte acima cobre a corrida entre esta
# checagem e o attach.
sessao_remota_existe() {
  local dest=$1 s=$2
  timeout 5 ssh "${SSH_OPC[@]}" "$dest" "$PATH_REMOTO tmux has-session -t $(q "=$s")" </dev/null >/dev/null 2>&1
}

# O destino responde a SSH agora? Serve para distinguir "a sessão sumiu" (destino responde, mas a
# sessão não existe) de "a rede/SSH caiu" (destino mudo). Só o primeiro caso justifica encerrar uma
# ponte; o segundo é transitório e merece nova tentativa.
alcanca_destino() {
  local dest=$1
  [[ -n $dest && $dest != : ]] || return 1
  timeout 5 ssh "${SSH_OPC[@]}" "$dest" true </dev/null >/dev/null 2>&1
}

# Abre a sessão S num painel: modo lado | embaixo | aqui (troca o painel em foco, se for do tt).
abrir_painel() {
  local modo=$1 dest=$2 s=$3 painel=${TT_PANE:-} atual novo cmd
  if [[ -z ${TMUX:-} ]]; then
    read -rp "Painéis só funcionam dentro do tmux. Enter para voltar."
    return 1
  fi
  atual=$(tmux display-message -p ${painel:+-t "$painel"} '#{session_name}')
  if [[ $dest == . && $s == "$atual" ]]; then
    read -rp "Essa é a sessão em que você está; não dá para abri-la dentro dela mesma. Enter."
    return 1
  fi
  if [[ $dest == . ]] && fecha_ciclo "$s" "$atual"; then
    aviso_ciclo "$s" "$atual"; read -rp "Enter para voltar."
    return 1
  fi
  cmd=$(cmd_ver "$dest" "$s")
  case $modo in
    lado) novo=$(tmux split-window -h -P -F '#{pane_id}' ${painel:+-t "$painel"} "$cmd") ;;
    embaixo) novo=$(tmux split-window -v -P -F '#{pane_id}' ${painel:+-t "$painel"} "$cmd") ;;
    aqui)
      novo=$(tmux display-message -p ${painel:+-t "$painel"} '#{pane_id}')
      if [[ -z $(tmux show-options -pqv -t "$novo" @tt_painel) ]]; then
        read -rp "^p só troca painéis abertos pelo tt (^v/^o); este tem seu próprio programa. Enter."
        return 1
      fi
      tmux respawn-pane -k -t "$novo" "$cmd" ;;
  esac || return 1
  tmux set-option -p -t "$novo" @tt_painel "$dest $s"
  tmux set-option -p -t "$novo" @tt_rotulo "$(rotulo "$dest") · $s"
  tmux select-pane -t "$novo"
}

# --- Ciclos de painéis --------------------------------------------------------
#
# Um painel que mostra outra sessão é um cliente tmux do tamanho do painel, e o tmux dimensiona a
# janela pelo cliente que mexeu por último. Se A mostra B e B (direta ou indiretamente) mostra A,
# cada redesenho encolhe o painel, que encolhe a janela… até 1x1. Por isso:
#   - antes de abrir um painel ou trocar o que um painel mostra, recusa se fechar um ciclo;
#   - rede de segurança (ganchos de tamanho): vista aninhada minúscula é desligada.

# Arestas "sessão-que-contém → sessão-mostrada" desta máquina: painel cujo processo é um cliente
# tmux deste servidor.
arestas_paineis() {
  local -A sessao_do_cliente
  local pid s
  while read -r pid s; do sessao_do_cliente[$pid]=$s; done < <(tmux list-clients -F '#{client_pid} #{session_name}' 2>/dev/null)
  tmux list-panes -a -F '#{pane_pid} #{session_name}' 2>/dev/null | while read -r pid s; do
    [[ -n ${sessao_do_cliente[$pid]:-} ]] && echo "$s ${sessao_do_cliente[$pid]}"
  done
}

# A sessão que contém o painel onde o cliente C roda (vazio se C é um terminal de verdade).
contem_cliente() {
  local pid
  pid=$(do_cliente "$1" '#{client_pid}')
  [[ -n $pid ]] && tmux list-panes -a -F '#{pane_pid} #{session_name}' 2>/dev/null | awk -v p="$pid" '$1 == p { print $2; exit }'
}

# Verdadeiro se, a partir da sessão DE, seguindo os painéis, chega-se à sessão PARA.
alcanca() {
  local de=$1 para=$2
  [[ $de == "$para" ]] && return 0
  arestas_paineis | awk -v de="$de" -v para="$para" '
    { adj[$1] = adj[$1] " " $2 }
    END {
      fila[1] = de; visto[de] = 1; n = 1
      for (i = 1; i <= n; i++) {
        k = split(adj[fila[i]], viz, " ")
        for (j = 1; j <= k; j++) {
          if (viz[j] == para) { achou = 1; exit }
          if (!visto[viz[j]]++) fila[++n] = viz[j]
        }
      }
    }
    END { exit achou ? 0 : 1 }'
}

# Pôr a sessão S (desta máquina) dentro da sessão CONTAINER fecharia um ciclo?
fecha_ciclo() { [[ -n ${2:-} ]] && alcanca "$1" "$2"; }

aviso_ciclo() {
  echo "Não dá: a sessão \"$1\" já mostra (direta ou indiretamente) \"$2\", onde este painel está."
  echo "Abrir uma dentro da outra cria um ciclo, e a tela encolhe até sumir."
}

# Escape automático de ciclo na TROCA de sessão (ir_para): ir para S deixaria S mostrando o painel
# onde este cliente está (CONTAINER), o que fecha um ciclo e encolhe a tela. Em vez de só avisar e
# voltar ao mesmo erro, quebramos o ciclo desanexando as vistas aninhadas (clientes rodando dentro
# de um painel: TERM tmux*/screen*) que estão DENTRO de S — isto e o mesmo que a guarda_tamanho faz
# quando a tela encolhe, mas feito antes da troca para que ela possa concluir. Retorna 0 se quebrou
# algo (a troca pode prosseguir), 1 se nao havia o que desanexar (deixa o chamador decidir).
quebrar_ciclo_para() {
  local alvo=$1 n=0 c term w h s
  while read -r c term w h s; do
    [[ $term == tmux* || $term == screen* ]] || continue
    # Desanexa a vista aninhada cujo painel pertence a cadeia que leva ao alvo (inclui o proprio S).
    if [[ $s == "$alvo" ]] || alcanca "$s" "$alvo"; then
      tmux detach-client -t "$c" 2>/dev/null && {
        n=$((n + 1))
        echo "$(date '+%F %T') ciclo: desanexei a vista aninhada $c (sessao $s) para liberar a troca para $alvo" >>"$HOME/.cache/tt-vigia.log"
      }
    fi
  done < <(tmux list-clients -F '#{client_name} #{client_termname} #{client_width} #{client_height} #{session_name}' 2>/dev/null)
  ((n > 0))
}

# Rede de segurança (ganchos de tamanho): desliga vistas aninhadas (clientes que rodam dentro de um
# painel: TERM tmux*/screen*) que encolheram demais — sinal de ciclo, talvez passando por outra
# máquina, que daqui não dá para ver inteiro.
guarda_tamanho() {
  local c term w h s n=0 trava="$RT/tt-guarda-$(id -u)"
  mkdir "$trava" 2>/dev/null || return 0 # já tem uma rodando (vários ganchos disparam juntos)
  trap 'rmdir "$trava" 2>/dev/null' RETURN
  sleep 0.2
  while read -r c term w h s; do
    [[ $term == tmux* || $term == screen* ]] || continue
    if ((w < 12 || h < 4)); then
      tmux detach-client -t "$c" && n=$((n + 1))
      echo "$(date '+%F %T') guarda: desliguei a vista aninhada $c ($w x $h, sessão $s)" >>"$HOME/.cache/tt-vigia.log"
    fi
  done < <(tmux list-clients -F '#{client_name} #{client_termname} #{client_width} #{client_height} #{session_name}' 2>/dev/null)
  ((n)) && avisar "⚠ painel fechado: ele mostrava uma sessão que mostra ele mesmo (ciclo) e estava encolhendo a tela"
  return 0
}

# Sessão-ponte local que mostra a sessão S de outra máquina (cria se não existir). Imprime o nome.
criar_ponte() {
  local dest=$1 s=$2 cliente=${3:-} base ponte alvo nome anexada dono n=2
  [[ -n $dest && $dest != : ]] || {
    printf 'tt: ponte não criada para %s: destino remoto vazio ou inválido\n' "$s" >&2
    return 1
  }
  base=$(limpar "$(rotulo_de "$dest")-$s")
  alvo="$dest|$s"
  # Uma ponte por aparelho: dois aparelhos vendo a mesma sessão de outra máquina não podem dividir
  # a ponte, senão uma troca de sessão pedida por um (tt --ir-ponte) leva o outro junto. O aparelho
  # reaproveita a ponte dele, ou uma livre (ninguém anexado) do mesmo alvo; senão cria outra.
  if [[ -n $cliente ]]; then
    ponte=""
    while IFS=$'\t' read -r nome anexada dono; do
      [[ $dono == "$cliente" ]] && { ponte=$nome; break; }
      [[ -z $ponte && $anexada == 0 ]] && ponte=$nome
    done < <(tmux list-sessions -F "#{session_name}"$'\t'"#{session_attached}"$'\t'"#{@ponte_dono}"$'\t'"#{@ponte_alvo}" 2>/dev/null |
      awk -F'\t' -v a="$alvo" -v b="$base" '$4 == a || ($4 == "" && $1 == b) { print $1 "\t" $2 "\t" $3 }')
    if [[ -n $ponte ]]; then
      [[ $(tmux show-options -qv -t "=$ponte:" @ponte_dono) == "$cliente" ]] || tmux set-option -t "=$ponte:" @ponte_dono "$cliente"
      [[ -n $(tmux show-options -qv -t "=$ponte:" @ponte_alvo) ]] || tmux set-option -t "=$ponte:" @ponte_alvo "$alvo"
      echo "$ponte"; return 0
    fi
    ponte=$base
    while tmux has-session -t "=$ponte" 2>/dev/null; do ponte="$base-$n"; n=$((n + 1)); done
  else
    ponte=$base
    tmux has-session -t "=$ponte" 2>/dev/null && { echo "$ponte"; return 0; }
  fi
  tmux new-session -d -s "$ponte" "$(q "$EU" --ponte "$dest" "$s" "$ponte")" || return 1
  tmux set-option -t "=$ponte:" @ponte "$dest"
  tmux set-option -t "=$ponte:" @ponte_alvo "$alvo"
  [[ -n $cliente ]] && tmux set-option -t "=$ponte:" @ponte_dono "$cliente"
  tmux set-option -t "=$ponte:" @nome_auto 0
  tmux set-option -t "=$ponte:" status off
  echo "$ponte"
}

# Pontes que ninguém usa há mais de 30 min (TT_T_PONTE, em segundos) são fechadas: com uma ponte
# por aparelho elas se acumulariam, cada uma com uma conexão ssh aberta. A sessão da outra máquina
# continua lá; só a conexão daqui se encerra.
#
# Além das ociosas, saneia pontes órfãs: aquelas cujo alvo (sessão da outra máquina) já não existe
# mais — a sessão de lá foi fechada ou renomeada. Sem isso, a ponte vira uma sessão fantasma, viva
# aqui e sem par real no destino. Só encerramos quando o destino RESPONDE e confirma que a sessão
# sumiu; destino mudo (rede/SSH caiu) é transitório e a ponte é preservada.
fechar_pontes_ociosas() {
  local agora=$1 limite=${TT_T_PONTE:-1800} s anexada ult dest alvo rs
  while IFS='|' read -r s anexada ult dest alvo; do
    [[ $s == _tt-* ]] && continue # sessões ocultas do tt (e-mail aberto em segundo plano)
    if ((anexada == 0 && ult > 0 && agora - ult >= limite)); then
      tmux kill-session -t "=$s" 2>/dev/null
      continue
    fi
    # Órfã: o alvo é "dest|sessão"; se o destino responde e a sessão não existe lá, encerra já,
    # sem esperar o tempo de ociosidade. Pontes anexadas também: uma sessão fantasma anexada é
    # justamente o sintoma a corrigir. As sondas são opcionais: se não estiverem no escopo (ex.: a
    # função foi extraída isolada), a verificação de órfã é pulada em vez de quebrar.
    [[ -n $alvo && $alvo == *"|"* ]] || continue
    declare -F sessao_remota_existe >/dev/null && declare -F alcanca_destino >/dev/null || continue
    rs=${alvo#*|}
    if ! sessao_remota_existe "$dest" "$rs" && alcanca_destino "$dest"; then
      tmux kill-session -t "=$s" 2>/dev/null
    fi
  done < <(tmux list-sessions -F '#{session_name}|#{session_attached}|#{?session_last_attached,#{session_last_attached},#{session_created}}|#{@ponte}|#{@ponte_alvo}' -f '#{@ponte}' 2>/dev/null)
  return 0
}

# Entra na sessão S de outra máquina. Fora do tmux (celular), é um ssh direto e, ao sair
# (Ctrl+B d), volta ao menu. Dentro do tmux, vai para a sessão-ponte (a barra daqui some; vale a
# de lá). Ctrl+B fala com o tmux daqui; Ctrl+B Ctrl+B, com o de lá.
entrar_remoto() {
  local dest=$1 s=$2 ponte
  if [[ -z ${TMUX:-} ]]; then
    eval "$(cmd_ver "$dest" "$s")"
    return
  fi
  if ! sessao_remota_existe "$dest" "$s"; then
    tmux display-message ${TT_CLIENTE:+-c "$TT_CLIENTE"} "⚠ $(rotulo_de "$dest"):$s não existe mais ou está inacessível"
    return 1
  fi
  ponte=$(criar_ponte "$dest" "$s" "${TT_CLIENTE:-}") || return 1
  sair_menu
  exec tmux switch-client ${TT_CLIENTE:+-c "$TT_CLIENTE"} -t "=$ponte"
}

# Formato tmux avaliado para o cliente C (display-message -c não muda o contexto do formato).
do_cliente() {
  tmux list-clients -F "#{client_name}	$2" 2>/dev/null | awk -F'\t' -v c="$1" '$1 == c { print $2; exit }'
}

# Cliente que contém o painel desta execução. Não use a primeira tela da sessão: uma mesma
# sessão pode estar anexada em várias telas e os menus precisam trocar exatamente a tela clicada.
cliente_do_painel() {
  local p=${1:-${TMUX_PANE:-}} c
  [[ -n $p ]] || return 1
  c=$(tmux display-message -p -t "$p" '#{client_name}' 2>/dev/null)
  [[ -n $c && $c != '#{client_name}' ]] || return 1
  printf '%s\n' "$c"
}

# "máquina|ponte" se o cliente tmux atual é uma ponte vinda de outra máquina (vazio se não).
origem_ponte() {
  local pid
  if [[ -n ${1:-} ]]; then pid=$(do_cliente "$1" '#{client_pid}')
  else pid=$(tmux display-message -p '#{client_pid}' 2>/dev/null); fi
  [[ -n $pid ]] || return
  tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | sed -n 's/^TT_PONTE=//p'
}

# Vai para a sessão S de DEST no cliente atual. Se este cliente é uma ponte vinda de outra máquina
# (você está vendo esta máquina de lá), pede para a de lá fazer a troca: assim a tela que você
# usa troca de verdade, sem encadear ponte dentro de ponte.
ir_para() {
  local dest=$1 s=$2 origem om op
  origem=$(origem_ponte "${TT_CLIENTE:-}")
  om=${origem%%|*} op=${origem#*|}
  if [[ $dest != . && -n $origem && -n $op ]] && ssh "${SSH_OPC[@]}" "$(dest_de "$om")" "$TT_REMOTO --ir-ponte $(q "$op" "$(rotulo "$dest")" "$s")" </dev/null; then
    sair_menu
    return 0
  fi
  local container
  container=$( [[ -n ${TT_CLIENTE:-} ]] && contem_cliente "$TT_CLIENTE")
  if [[ -n $container && $dest == . ]] && fecha_ciclo "$s" "$container"; then
    # Escape automático: quebra o ciclo desanexando as vistas aninhadas que levam ao alvo e segue.
    # Só avisa e volta se não houve nada para desanexar (ciclo que não sabemos desfazer sozinhos).
    if ! quebrar_ciclo_para "$s"; then
      aviso_ciclo "$s" "$container"; read -rp "Enter para voltar."
      return 1
    fi
  fi
  # Dentro do tmux sem saber qual é a tela: resolve pelo painel que abriu o menu. Não escolha a
  # primeira tela da sessão: ela pode ser outra tela do mesmo computador.
  if [[ -n ${TMUX:-} && -z ${TT_CLIENTE:-} ]]; then
    TT_CLIENTE=$(cliente_do_painel) || true
    if [[ -z $TT_CLIENTE ]]; then
      echo "Não consegui identificar a tela deste menu; não troquei nada. (Use: tmux attach -t =$s)" >&2
      return 1
    fi
  fi
  if [[ $dest != . ]]; then entrar_remoto "$dest" "$s"; return; fi
  sair_menu
  if [[ -n ${TMUX:-} ]]; then exec tmux switch-client ${TT_CLIENTE:+-c "$TT_CLIENTE"} -t "=$s"; fi
  tmux attach-session -t "=$s"
}

# Roda na máquina de origem: os clientes que estão na ponte P passam a mostrar a sessão S da
# máquina de rótulo R (desta, direto; de outra, por uma ponte).
ir_ponte() {
  local p=$1 r=$2 s=$3 alvo c dest
  tmux has-session -t "=$p" 2>/dev/null || return 1
  # Com pontes por aparelho, P tem um cliente só. Pontes antigas (compartilhadas) podem ter vários:
  # aí troca só o que agiu por último (quem clicou ou teclou na barra de lá).
  c=$(tmux list-clients -t "=$p" -F '#{client_activity} #{client_name}' 2>/dev/null | sort -rn | awk 'NR == 1 { print $2 }')
  [[ -n $c ]] || return 1
  if [[ $r == "$MAQUINA" ]]; then alvo=$s
  else
    dest=$(dest_de "$r")
    if [[ -z $dest ]]; then
      tmux display-message -c "$c" "⚠ $r: máquina não cadastrada ou desligada; sessão $s não aberta"
      return 1
    fi
    alvo=$(criar_ponte "$dest" "$s" "$c") || return 1
  fi
  fecha_ciclo "$alvo" "$(contem_cliente "$c")" && return 1
  tmux switch-client -c "$c" -t "=$alvo"
}


# --- Seletor da barra (clique no nome da sessão ou numa máquina) ------------

# Lista curta desta máquina: só as sessões, "nome<TAB>texto", mais recentes primeiro.
listar_leve() {
  local ativ s anex cmd ponte uso
  tmux list-sessions -F '#{window_activity}|#{session_name}|#{session_attached}|#{pane_current_command}|#{@ponte}' 2>/dev/null |
    sort -t'|' -k1,1nr |
    {
      local -a vazias=()
      while IFS='|' read -r ativ s anex cmd ponte; do
        [[ -n $ponte ]] && continue
        if sessao_vazia "$s"; then
          ((anex > 0)) && uso='●' || uso='○'
          vazias+=("$(printf '%s\t\033[90m%s %-24.24s %-7.7s %s\033[0m' "$s" "$uso" "$s" "$cmd" "$(idade "$ativ")")")
          continue
        fi
        ((anex > 0)) && uso=$'\033[32m●\033[0m' || uso=$'\033[90m○\033[0m'
        printf '%s\t%s \033[1m%-24.24s\033[0m \033[33m%-7.7s\033[0m \033[90m%s\033[0m\n' "$s" "$uso" "$s" "$cmd" "$(idade "$ativ")"
      done
      if ((${#vazias[@]})); then
        linha_vazias "${#vazias[@]}" | cut -f1,2
        printf '%s\n' "${vazias[@]}"
      fi
    }
}

# Máquinas que entram no seletor, conforme o filtro da aba (rótulo ou "todas"): "destino rótulo".
alvos_seletor() {
  local m dest rot
  m=$(estado maquina); m=${m:-$MAQUINA}
  while read -r dest rot; do
    [[ $m == todas || $m == "$rot" ]] && echo "$dest $rot"
  done < <(echo ". $MAQUINA"; maquinas)
}

# "chave<TAB>texto" (stdin) de uma máquina → linhas do seletor "destino<TAB>chave<TAB>texto".
formatar_bloco() {
  local todas=""
  [[ $(estado maquina) == todas ]] && todas=1
  awk -F'\t' -v d="$1" -v r="$2" -v todas="$todas" -v atual="${TT_ATUAL:-}" -v fx="$(fixadas | tr '\t\n' '|\034')" '{
      marca = (r "|" $1 == atual) ? "\033[35m◆\033[0m " : "  "
      marca = marca "  "
      rot = todas ? sprintf("\033[34m%-8.8s\033[0m ", r) : ""
      printf "%s\t%s\t%s%s%s\n", d, $1, marca, rot, $2
    }'
}

# Sessões de uma máquina de fora, consultadas agora (e guardadas no cache). Se ela não responde,
# imprime a linha de erro.
bloco_vivo() {
  local dest=$1 rot=$2 saida st f
  f=$(cache_bloco "$rot")
  saida=$(timeout 4 ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --listar-leve" </dev/null 2>/dev/null)
  st=$?
  if ((st != 0)); then
    printf '!erro\t\033[90m✗ sem resposta de %s\033[0m\n' "$rot"
  elif [[ -n $saida ]]; then
    printf '%s\n' "$saida" >"$f.$$" && mv "$f.$$" "$f"
    printf '%s\n' "$saida"
  else
    rm -f "$f"
  fi
}

# Ações do fim da lista. Com uma máquina escolhida, a sessão nova nasce nela.
acoes_seletor() {
  local m nova
  m=$(estado maquina); m=${m:-$MAQUINA}
  [[ $m == todas ]] && nova=. || nova=$(dest_de "$m")
  printf '%s\t!nova\t  \033[32m＋ nova sessão em %s\033[0m\n' "${nova:-.}" "$([[ $m == todas ]] && echo "$MAQUINA" || echo "$m")"
  printf '.\t!arquivos\t  \033[33m⇅ arquivos\033[0m \033[90m(enviar / trazer entre máquinas)\033[0m\n'
  printf '.\t!tmux\t  \033[35m⚙ tmux\033[0m \033[90m(janelas, painéis, opções)\033[0m\n'
  printf '.\t!central\t  \033[36m☰ central completa\033[0m \033[90m(busca, painéis, prévia)\033[0m\n'
}

# Primeira versão da lista, sem esperar ninguém: esta máquina na hora; as outras com o que se sabia
# delas (cache) e a linha "atualizando…". A lista completa chega em seguida (reload do fzf).
lista_rapida() {
  local dest rot f
  while read -r dest rot; do
    if [[ $dest == . ]]; then listar_leve | formatar_bloco . "$rot"
    else
      f=$(cache_bloco "$rot")
      [[ -s $f ]] && formatar_bloco "$dest" "$rot" <"$f"
      printf '%s\t!erro\t  \033[90m⟳ atualizando %s…\033[0m\n' "$dest" "$rot"
    fi
  done < <(alvos_seletor)
  acoes_seletor
}
lista_rapida_salva() { lista_rapida | tee "$TT_ESTADO.lista"; }

# Linhas do seletor ("destino<TAB>chave<TAB>texto") da máquina escolhida (ou todas), com as outras
# máquinas consultadas em paralelo. No layout de baixo para cima do seletor, a primeira linha fica
# junto da barra: sessões recentes embaixo, ações (nova, central) no topo. Guarda a lista para
# pos_atual.
lista_seletor() {
  local i dest rot tmp
  local -a dests rots
  while read -r dest rot; do dests+=("$dest"); rots+=("$rot"); done < <(alvos_seletor)
  tmp=$(mktemp -d)
  for i in "${!dests[@]}"; do
    {
      if [[ ${dests[i]} == . ]]; then listar_leve; else bloco_vivo "${dests[i]}" "${rots[i]}"; fi
    } | formatar_bloco "${dests[i]}" "${rots[i]}" >"$tmp/$i" &
  done
  wait
  for ((i = 0; i < ${#dests[@]}; i++)); do cat "$tmp/$i"; done
  acoes_seletor
  rm -rf "$tmp"
}

# Ação do fzf que põe o cursor na sessão atual (◆), ou na primeira.
pos_atual() {
  local n
  [[ -e $TT_ESTADO.pos ]] && return
  : >"$TT_ESTADO.pos"
  n=$(lista_seletor_cache | grep -n $'\t.*◆' | head -1 | cut -d: -f1)
  [[ -n $n ]] && echo "pos($n)" || echo first
}
lista_seletor_cache() { cat "$TT_ESTADO.lista" 2>/dev/null; }
lista_seletor_salva() { lista_seletor | tee "$TT_ESTADO.lista"; }

cabecalho_seletor() {
  local m r linha=""
  m=$(estado maquina); m=${m:-$MAQUINA}
  for r in $(rotulos) todas; do
    [[ $r == "$m" ]] && linha+="\033[1;30;46m $r \033[0m " || linha+=" $r  "
  done
  printf '%b\n' "$linha"
  printf '\033[90m%s\033[0m\n' "clique abre · 📍 fixa · 📌 desafixa · ✕ fecha · tab: máquina · esc sai"
}

clique_seletor() {
  local w=$1 r m lista
  if ((${FZF_CLICK_HEADER_LINE:-0} == 1)); then
    w=$(palavra_em "$(cabecalho_seletor | sed -n 1p | sed 's/\x1b\[[0-9;]*m//g')" "${FZF_CLICK_HEADER_COLUMN:-0}")
  elif ((${FZF_CLICK_HEADER_LINE:-0} > 1)); then return
  fi
  if [[ $w == proxima ]]; then
    mapfile -t lista < <(rotulos; echo todas)
    m=$(estado maquina); m=${m:-$MAQUINA}
    for ((r = 0; r < ${#lista[@]}; r++)); do [[ ${lista[r]} == "$m" ]] && break; done
    w=${lista[(r + 1) % ${#lista[@]}]}
  fi
  for r in $(rotulos) todas; do
    if [[ $w == "$r" ]]; then
      estado_por maquina "$r"
      rm -f "$TT_ESTADO.pos"
      echo "reload-sync($EU --lista-rapida)+transform-header($EU --cabecalho-seletor)+reload($EU --lista-seletor)"
      return
    fi
  done
}

# O seletor em si (roda dentro do popup aberto por seletor_em).
seletor() {
  local saida dest alvo nome prev=()
  estado_por maquina "${TT_SEL_MAQ:-$MAQUINA}"
  [[ -n ${TT_PREVIA:-} ]] && prev=(--preview="$EU --previa-em {1} {2}" --preview-window='right,55%,border-left,follow')
  export TT_COMX=seletor TT_MOUSE="$TT_ESTADO.mouse"
  saida=$(lista_rapida_salva | com_x | com_mouse "$TT_MOUSE" fzf --ansi --delimiter='\t' --with-nth=3 --exact --no-sort \
    --prompt='❯ ' --pointer='▶' --info=inline-right --no-separator \
    --header="$(cabecalho_seletor)" --header-first \
    --color='bg:#282a36,fg:#f8f8f2,header:#f8f8f2,pointer:#ff79c6,prompt:#bd93f9,hl:#f1fa8c,hl+:#ffb86c,fg+:#f8f8f2,bg+:#44475a,info:#6272a4' \
    "${prev[@]}" \
    --bind="start:reload($EU --lista-seletor)" \
    --bind="load:transform($EU --pos-atual)" \
    --bind="left-click:transform($EU --clique-linha {1} {2})" \
    --bind="ctrl-x:execute-silent($EU --fechar {1} {2})+reload($EU --lista-seletor)" \
    --bind="tab:transform($EU --clique-seletor proxima)" \
    --bind="ctrl-f:execute-silent($EU --alternar-fixada {1} {2})+reload($EU --lista-seletor)" \
    --bind="click-header:transform($EU --clique-seletor x)") || return 0
  dest=$(cut -f1 <<<"$saida") alvo=$(cut -f2 <<<"$saida")
  case $alvo in
    '' | !erro) return 0 ;;
    !vazias) confirmar_vazias "$dest"; return 0 ;;
    !central) tmux run-shell -b "sleep 0.15; $EU --clique tt '${TT_CLIENTE:-}' '${TT_PANE:-}' ''"; return 0 ;;
    !tmux) tmux run-shell -b "sleep 0.15; $EU --menu-tmux '${TT_CLIENTE:-}' '${TT_PANE:-}'"; return 0 ;;
    !arquivos) tmux run-shell -b "sleep 0.15; $EU --menu-arquivos '${TT_CLIENTE:-}' '${TT_PANE:-}'"; return 0 ;;
    !nova)
      read -rp "Nome da nova sessão em $(rotulo "$dest") [automático]: " nome
      alvo=$(rodar "$dest" --nova "$nome") || return 0 ;;
  esac
  ir_para "$dest" "$alvo"
}

# Abre o seletor num popup ancorado na barra, junto do clique. M = rótulo da máquina, ou "todas".
seletor_em() {
  local c=$1 m=${2:-$MAQUINA} p=${3:-} cw ch w h x prev="" atual
  read -r cw ch < <(do_cliente "$c" '#{client_width} #{client_height}')
  if ((cw >= 140)); then w=130; prev=1; else w=$((cw < 74 ? cw : 74)); fi
  h=$((ch * 72 / 100)); ((h < 14)) && h=14; ((h > ch - 2)) && h=$((ch - 2))
  x=${TT_X:-0}
  ((x + w > cw)) && x=$((cw - w))
  atual=$(do_cliente "$c" '#{session_name}')
  tmux display-popup -c "$c" -x "$x" -y S -w "$w" -h "$h" -T " ☰ sessões " -E \
    "TT_CLIENTE=$(q "$c") TT_SEL_MAQ=$(q "$m") TT_PREVIA=$prev TT_PANE=$p TT_ATUAL=$(q "$MAQUINA|$atual") $EU --seletor"
}


# Barrinha de título dos painéis só nas janelas com 2+ painéis (chamado pelos ganchos do tmux).
bordas() {
  sleep 0.05
  tmux list-windows -a -F '#{window_id} #{window_panes} #{pane-border-status}' 2>/dev/null |
    while read -r w n atual; do
      if ((n > 1)); then [[ $atual == top ]] || tmux set-option -w -t "$w" pane-border-status top
      else [[ $atual == off ]] || tmux set-option -w -t "$w" pane-border-status off; fi
    done
}

# Confirma e fecha as vazias de DEST, poupando a sessão em uso (se for desta máquina).
confirmar_vazias() {
  local dest=$1 exceto="" r n
  [[ $dest == . && -n ${TT_CLIENTE:-} ]] && exceto=$(do_cliente "$TT_CLIENTE" '#{session_name}')
  [[ $dest == . && -z $exceto && -n ${TMUX:-} ]] && exceto=$(tmux display-message -p '#{session_name}')
  read -rp "Fechar as sessões vazias de $(rotulo "$dest")${exceto:+ (menos \"$exceto\", em uso)}? [s/N] " r
  [[ $r == [sSyY]* ]] || return 0
  n=$(rodar "$dest" --fechar-vazias "$exceto")
  echo "Fechadas: ${n:-0}."
  sleep 0.6
}

# Área de transferência do sistema para o texto da entrada (copy-command do tmux). O servidor tmux
# pode ter nascido sem o ambiente gráfico (ssh, mosh, vigia): sem WAYLAND_DISPLAY o wl-copy falhava
# calado e a seleção não chegava a lugar nenhum. Terminais que aceitam OSC 52 (Termux, Windows
# Terminal) recebem a cópia pelo próprio tmux (set-clipboard on).
copiar() {
  local t
  t=$(mktemp) || return 0
  cat >"$t"
  [[ -s $t ]] || { rm -f "$t"; return 0; }
  copiar_local "$t"
  # Repetição da última cópia (inclusive o eco de uma cópia recebida que volta por OSC 52 de uma
  # ponte): não entra de novo no histórico nem é reenviada — senão as máquinas ficariam trocando a
  # mesma cópia entre si.
  if ! copia_repetida "$t"; then
    registrar_copia "$t" "${TT_COPIA_ORIGEM:-$MAQUINA}"
    if [[ -z ${TT_COPIA_RECEBIDA:-} && $(conf copia_entre_maquinas) != 0 ]] && command -v setsid >/dev/null; then
      setsid -f "$EU" --propagar-copia "$t" >/dev/null 2>&1 </dev/null
      return 0 # o propagador apaga o arquivo
    fi
  fi
  rm -f "$t"
  return 0
}

# Só a área de transferência do sistema desta máquina.
copiar_local() {
  local t=$1 clip
  # WSL: vai direto ao Windows. Pelo ssh (cópia vinda de outra máquina) o PATH não tem as pastas do
  # Windows, então procura o clip.exe também no lugar padrão.
  clip=$(command -v clip.exe 2>/dev/null)
  [[ -z $clip && -x /mnt/c/Windows/System32/clip.exe ]] && grep -qi microsoft /proc/version 2>/dev/null && clip=/mnt/c/Windows/System32/clip.exe
  if [[ -n $clip ]]; then
    # clip.exe lê bytes na página de código do console (850/1252): UTF-8 virava "Ã§". Em UTF-16LE
    # (sem BOM, senão ele entra no texto) chega certo, inclusive emoji e ideogramas.
    if command -v iconv >/dev/null; then iconv -f utf-8 -t utf-16le <"$t" | "$clip" >/dev/null 2>&1
    else "$clip" <"$t" >/dev/null 2>&1; fi
  elif command -v wl-copy >/dev/null; then
    local run=${XDG_RUNTIME_DIR:-/run/user/$(id -u)} w=${WAYLAND_DISPLAY:-} s
    if [[ -z $w ]]; then
      for s in "$run"/wayland-*; do [[ -S $s ]] && { w=${s##*/}; break; }; done
    fi
    [[ -n $w ]] && XDG_RUNTIME_DIR=$run WAYLAND_DISPLAY=$w wl-copy <"$t" >/dev/null 2>&1
  elif command -v xclip >/dev/null; then
    DISPLAY=${DISPLAY:-:0} xclip -selection clipboard <"$t" >/dev/null 2>&1
  elif command -v termux-clipboard-set >/dev/null; then
    termux-clipboard-set <"$t" >/dev/null 2>&1
  fi
  return 0
}

# Abre uma URL de e-mail (opener do aerc, :open-link). Usa o abridor da plataforma; sem GUI (ssh),
# copia a URL para a área de transferência (mesma rota da cópia do tt, inclusive OSC 52), para
# colar em outro aparelho. Calado e sempre com sucesso: erro na tela esconderia a mensagem do aerc.
abrir_url() {
  local u=${1:-}
  [[ -n $u ]] || return 0
  if command -v xdg-open >/dev/null; then setsid xdg-open "$u" >/dev/null 2>&1 </dev/null && return 0; fi
  if command -v termux-open-url >/dev/null; then termux-open-url "$u" >/dev/null 2>&1 && return 0; fi
  if [[ -n ${BROWSER:-} ]]; then setsid "$BROWSER" "$u" >/dev/null 2>&1 </dev/null && return 0; fi
  local t; t=$(mktemp) && printf '%s' "$u" >"$t" && copiar_local "$t"; rm -f "$t"
  return 0
}

# --- Histórico de cópias e cópia entre máquinas --------------------------------
#
# Cada cópia (desta máquina ou recebida de outra) vira um arquivo em ~/.cache/tt-copias, nome
# "NANOSSEGUNDOS_MÁQUINA"; ficam as 100 mais recentes. Toda cópia feita aqui vai também para as
# outras máquinas ligadas (tt --receber-copia), que a põem na área de transferência, no tmux (e,
# por OSC 52, no terminal de quem estiver olhando) e no histórico. copia_entre_maquinas=0 no
# config desliga o envio.
DIR_COPIAS=$HOME/.cache/tt-copias
LIMITE_COPIA=$((2 * 1024 * 1024))

copia_mais_recente() { ls -1 "$DIR_COPIAS" 2>/dev/null | sort | tail -1; }
copia_repetida() {
  local u
  u=$(copia_mais_recente); [[ -n $u ]] || return 1
  cmp -s "$1" "$DIR_COPIAS/$u"
}
registrar_copia() {
  local t=$1 origem=${2:-$MAQUINA}
  mkdir -p "$DIR_COPIAS" && chmod 700 "$DIR_COPIAS"
  cp "$t" "$DIR_COPIAS/$(date +%s%N)_${origem//[^A-Za-z0-9_-]/}"
  ls -1 "$DIR_COPIAS" | sort | head -n -100 | while read -r f; do rm -f "$DIR_COPIAS/$f"; done
}

propagar_copia() {
  local t=$1 dest rot
  if (($(stat -c %s "$t" 2>/dev/null || echo 0) <= LIMITE_COPIA)); then
    while read -r dest rot; do
      timeout 10 ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --receber-copia $(q "$MAQUINA")" <"$t" >/dev/null 2>&1 &
    done < <(maquinas)
    wait
  fi
  rm -f "$t"
}

receber_copia() {
  local origem=${1:-?} t
  t=$(mktemp) || return 0
  cat >"$t"
  if [[ -s $t ]] && ! copia_repetida "$t"; then
    registrar_copia "$t" "$origem"
    copiar_local "$t"
    tmux list-sessions >/dev/null 2>&1 && tmux load-buffer -w "$t" 2>/dev/null
  fi
  rm -f "$t"
}

# --- Propagar uma conta de IA entre as máquinas -------------------------------
#
# Uma conta do ia-conta é a pasta ~/.local/share/claude-contas/<nome>. Só a credencial e os poucos
# arquivos próprios dela são da conta; projects/history/sessions/settings são links para ~/.claude
# (dados locais, compartilhados por todas as contas desta máquina). "tt --conta-propagar <nome>"
# manda os arquivos próprios para as outras máquinas; cada uma recria os links para o seu ~/.claude
# e o atalho claude-<nome>. Não vão links nem dados compartilhados: cada máquina tem os seus.
CONTAS_RAIZ=$HOME/.local/share/claude-contas
# Arquivos próprios de uma conta (o resto da pasta é link para ~/.claude e fica em cada máquina).
CONTA_ITENS=(.credentials.json .account-email .claude.json backups)

conta_propagar() {
  local nome=${1:-}; shift || true
  local -a alvos=("$@")
  local dir dest rot alvo item
  [[ -n $nome ]] || { echo "uso: tt --conta-propagar <nome> [rótulo…]" >&2; return 1; }
  dir=$CONTAS_RAIZ/$nome
  [[ -s $dir/.credentials.json && ! -L $dir/.credentials.json ]] ||
    { echo "conta '$nome' não existe aqui (sem $dir/.credentials.json)" >&2; return 1; }
  local -a presentes=()
  for item in "${CONTA_ITENS[@]}"; do
    [[ -e $dir/$item && ! -L $dir/$item ]] && presentes+=("$item")
  done
  echo "Propagando a conta '$nome' (${presentes[*]})"
  while read -r dest rot; do
    if ((${#alvos[@]})); then
      for alvo in "${alvos[@]}"; do [[ $alvo == "$rot" ]] && break; alvo=""; done
      [[ -n $alvo ]] || continue
    fi
    printf '  %-10s ' "$rot"
    tar -C "$dir" -cf - "${presentes[@]}" 2>/dev/null |
      timeout 20 ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --conta-receber $(q "$nome")" 2>&1 |
      tail -1 | sed 's/^[^:]*: //' || echo "✗ sem resposta"
  done < <(maquinas)
}

# tt --conta-receber <nome>: recebe pelo stdin o tar com os itens próprios da conta e a instala
# aqui, transacional. Exige ~/.claude (onde não há Claude Code — por exemplo um celular — a conta
# não faz sentido e a função sai avisando, sem erro fatal para a propagação).
conta_receber() {
  local nome=${1:-}
  local dir tmp item
  [[ -n $nome ]] || { echo ": nome ausente" >&2; return 0; }
  if [[ ! -d $HOME/.claude ]]; then echo "· sem Claude Code aqui, pulada"; cat >/dev/null; return 0; fi
  dir=$CONTAS_RAIZ/$nome
  mkdir -p "$CONTAS_RAIZ"
  tmp=$(mktemp -d "$CONTAS_RAIZ/.$nome.novo.XXXXXX") 2>/dev/null ||
    { echo "✗ sem onde gravar"; cat >/dev/null; return 0; }
  if ! tar -C "$tmp" -xf - 2>/dev/null; then
    rm -rf "$tmp"; echo "✗ pacote inválido"; return 0
  fi
  if [[ ! -s $tmp/.credentials.json ]]; then
    rm -rf "$tmp"; echo "✗ sem credencial no pacote"; return 0
  fi
  mkdir -p "$dir"
  for item in "${CONTA_ITENS[@]}"; do
    [[ -e $tmp/$item ]] || continue
    rm -rf "$dir/$item"
    mv "$tmp/$item" "$dir/$item"
  done
  rm -rf "$tmp"
  chmod 700 "$dir" 2>/dev/null
  [[ -f $dir/.credentials.json ]] && chmod 600 "$dir/.credentials.json" 2>/dev/null
  rm -f "$dir/.account-email" 2>/dev/null
  conta_vincular_dados "$nome"
  echo "✓ conta '$nome' instalada"
}

# Recria, para a conta <nome>, os links de dados compartilhados apontando para o ~/.claude DESTA
# máquina e o atalho claude-<nome>. Espelha compartilhar_dados/criar_atalho do ia-conta, sem tocar
# na credencial (que já foi gravada). Idempotente.
conta_vincular_dados() {
  local nome=$1 base=$HOME/.claude dir=$CONTAS_RAIZ/$nome item atalho
  local -a compart=(projects history.jsonl file-history sessions settings.json settings.local.json plugins skills commands cache)
  mkdir -p "$dir"
  for item in "${compart[@]}"; do
    [[ -e $base/$item || -L $base/$item ]] || continue
    if [[ -L $dir/$item ]]; then
      [[ $(readlink -f "$dir/$item") == "$(readlink -f "$base/$item")" ]] || continue
    elif [[ -e $dir/$item ]]; then
      continue
    else
      ln -s "$base/$item" "$dir/$item"
    fi
  done
  atalho=$HOME/.local/bin/claude-$nome
  if [[ ! -e $atalho && ! -L $atalho ]]; then
    printf '#!/usr/bin/env bash\nexec %q %q "$@"' "$HOME/.local/bin/claude-conta" "$nome" >"$atalho"
    chmod 700 "$atalho"
  fi
}

# Lista do histórico (popup): Enter cola no painel (e vira a cópia atual), ^y só copia, ^x apaga
# o item, Esc fecha. Prévia com o texto inteiro.
historico_copias() {
  local escolha acao id pane=${TT_PANE:-}
  [[ -d $DIR_COPIAS ]] && [[ -n $(ls -A "$DIR_COPIAS") ]] || { echo "Nenhuma cópia ainda."; read -rsn1 -t 3; return 0; }
  while true; do
    # {1} vem com o TAB do separador: a prévia o tira antes de abrir o arquivo.
    escolha=$(listar_copias | fzf --ansi --no-sort --layout=reverse --delimiter=$'\t' --with-nth=2 --no-multi \
      --header=$'⏎ cola aqui · ^y só copia · ^x apaga · Esc fecha' \
      --preview "f={1}; cat $(printf %q "$DIR_COPIAS")/\"\${f%%[[:space:]]*}\"" --preview-window='down,60%,wrap' \
      --expect=enter,ctrl-y,ctrl-x --bind 'click-header:abort') || return 0
    acao=$(head -1 <<<"$escolha"); id=$(sed -n 2p <<<"$escolha" | cut -f1)
    [[ -n $id && -f $DIR_COPIAS/$id ]] || return 0
    case $acao in
      ctrl-x) rm -f "$DIR_COPIAS/$id"; continue ;;
      *)
        # Reusar move o item para o topo (sai o antigo, entra como cópia nova) e o manda às outras.
        local t; t=$(mktemp); cp "$DIR_COPIAS/$id" "$t"; rm -f "$DIR_COPIAS/$id"
        "$EU" --copiar <"$t"; tmux load-buffer -w "$t" 2>/dev/null; rm -f "$t"
        [[ $acao == ctrl-y || -z $pane ]] || tmux paste-buffer -p -t "$pane"
        return 0 ;;
    esac
  done
}

listar_copias() {
  local f ts origem hora texto
  ls -1 "$DIR_COPIAS" | sort -r | while read -r f; do
    ts=${f%%_*}; origem=${f#*_}
    hora=$(date -d "@$((ts / 1000000000))" '+%d/%m %H:%M' 2>/dev/null)
    texto=$(head -c 300 "$DIR_COPIAS/$f" | sed 's/\x1b\[[0-9;]*m//g' | awk 'NR > 1 { printf " ⏎ " } { gsub(/\t/, " "); printf "%s", $0 }')
    printf '%s\t\033[90m%s\033[0m \033[36m%-8.8s\033[0m %s\n' "$f" "$hora" "$origem" "$texto"
  done
}

# Aviso de cópia feita, no cliente C: "📋 copiado (N caracteres)". Cópia vazia não avisa.
copiado() {
  local n
  n=$(tmux show-buffer 2>/dev/null | wc -m)
  ((n > 0)) || return 0
  tmux display-message -c "$1" -d 1800 "📋 copiado ($n caractere$( ((n > 1)) && echo s)) — cole com Ctrl+Shift+V, botão do meio ou ⋯ · histórico: Ctrl+B y"
}

# Copia o texto visível do painel P (linhas quebradas juntadas) — útil no celular, onde arrastar
# rola a tela. Vai para o buffer do tmux, para os terminais por OSC 52 (load-buffer -w) e para a
# área de transferência desta máquina.
copiar_tela() {
  local c=$1 p=$2
  tmux capture-pane -p -J -t "$p" | awk '{ l[NR] = $0 } NF { u = NR } END { for (i = 1; i <= u; i++) print l[i] }' |
    sed 's/[[:space:]]*$//' | tmux load-buffer -w - || return 0
  tmux save-buffer - | copiar
  copiado "$c"
}

# Tamanho dinâmico entre aparelhos: com window-size latest, o próprio tmux dá a janela ao
# cliente que teclou, clicou (inclusive na barra), ganhou foco, anexou ou mudou de tamanho por
# último — o aparelho em uso fica sempre do tamanho certo, e o outro, ao ser usado, toma de volta.
# Nunca usar resize-window aqui: ele congela a janela (window-size manual) e ela para de seguir
# os aparelhos. ajustar só descongela janelas presas assim (versões antigas do tt, menus do tmux)
# e redesenha; quem decide o tamanho é o tmux, pelo cliente que acabou de agir.
descongelar() {
  local w
  if [[ -n ${1:-} ]]; then tmux list-windows -t "=$1" -F '#{window_id}'; else tmux list-windows -a -F '#{window_id}'; fi 2>/dev/null |
    while read -r w; do
      [[ $(tmux show -wqv -t "$w" window-size 2>/dev/null) == manual ]] && tmux set -wu -t "$w" window-size && echo x
    done | wc -l
}

ajustar() {
  local c=$1 s
  s=$(do_cliente "$c" '#{session_name}')
  [[ -n $s ]] || return 1
  # Só redesenha se havia janela presa (redesenhar a cada foco fazia o cursor piscar, ainda mais
  # em subtelas, onde o tmux de dentro também recebe foco a cada clique entre painéis).
  (($(descongelar "$s"))) && tmux refresh-client -t "$c"
  # A paleta vai direto ao terminal (fora do tmux) e pode se intercalar com um quadro que o tmux
  # está desenhando: no foco, no máximo a cada 10 min por cliente (ao anexar, sempre).
  local marca="$RT/tt-tema-${c//\//_}"
  if [[ ! -e $marca ]] || (($(idade_arquivo "$marca") > 600)); then
    touch "$marca"; tema_cliente "$c"
  fi
}

# As cores padrão do tmux também precisam ser escuras: o Codex consulta o fundo do painel.
# Remove desvios locais só das opções visuais deste padrão, preservando sessões e processos.
reforcar_visual() {
  VISUAL_MUDOU=0
  [[ -r $DIR_TT/tema-tmux.conf ]] || return 0
  # Todo set-option redesenha a tela inteira de todos os clientes: só grava o que está diferente.
  # O tema global só é recarregado quando o arquivo muda (hash em @tema_hash).
  local h id opt linha
  h=$(sha256sum <"$DIR_TT/tema-tmux.conf" | cut -c1-16)
  if [[ $(tmux show -gqv @tema_hash 2>/dev/null) != "$h" ]]; then
    tmux source-file "$DIR_TT/tema-tmux.conf" || return 1
    tmux set -g @tema_hash "$h"
    VISUAL_MUDOU=1
  fi
  local -a cmds=()
  local so='^(status-position|status-interval|status-format|status-style|status-left-length|status-left|status-right-length|status-right|message-style)(\[[0-9]+\])? '
  local wo='^(window-style|window-active-style|pane-colours|window-status-format|window-status-current-format|pane-border-style|pane-active-border-style|pane-border-format|mode-style|popup-style|popup-border-style|popup-border-lines)(\[[0-9]+\])? '
  local po='^(window-style|window-active-style|pane-colours|pane-border-style|pane-active-border-style|mode-style)(\[[0-9]+\])? '
  # Sem -g, show-options lista só o que foi definido localmente naquele alvo (o desvio).
  while read -r id; do
    while read -r linha; do opt=${linha%% *}; opt=${opt%%\[*}; cmds+=(set-option -su -t "$id" "$opt" ';')
    done < <(tmux show-options -t "$id" 2>/dev/null | grep -E "$so" | sort -u -k1,1)
  done < <(tmux list-sessions -F '#{session_id}' 2>/dev/null)
  while read -r id; do
    while read -r linha; do opt=${linha%% *}; opt=${opt%%\[*}; cmds+=(set-option -wu -t "$id" "$opt" ';')
    done < <(tmux show-options -w -t "$id" 2>/dev/null | grep -E "$wo" | sort -u -k1,1)
  done < <(tmux list-windows -a -F '#{window_id}' 2>/dev/null | sort -u)
  while read -r id; do
    while read -r linha; do opt=${linha%% *}; opt=${opt%%\[*}; cmds+=(set-option -pu -t "$id" "$opt" ';')
    done < <(tmux show-options -p -t "$id" 2>/dev/null | grep -E "$po" | sort -u -k1,1)
  done < <(tmux list-panes -a -F '#{pane_id}' 2>/dev/null)
  if ((${#cmds[@]})); then tmux "${cmds[@]}" 2>/dev/null; VISUAL_MUDOU=1; fi
  return 0
}

# Reaplica a paleta comum (tema-terminal.sh) no terminal de fora do cliente C — ou de todos, sem C.
# Ela é mandada por sequências OSC quando o terminal abre, e se perde quando algum programa manda
# "restaurar as cores padrão" (TUIs ao sair, reset): o fundo do Windows Terminal/Termux voltava ao
# do perfil. Nos clientes aninhados, o OSC atualiza o painel do tmux de fora também.
# Depois de escrever direto no terminal, redesenha o cliente (caso a escrita caia no meio de um quadro).
tema_cliente() {
  local alvo=${1:-} c term tty
  [[ -r $DIR_TT/tema-terminal.sh ]] || return 0
  while read -r c term tty; do
    [[ -z $alvo || $c == "$alvo" ]] || continue
    [[ ! -w $tty ]] && continue
    # Só a paleta (OSC), sem redesenhar: as cores não mudam nada na tela se já estavam certas.
    env -u TMUX TERM="$term" bash -c 'source "$1"' _ "$DIR_TT/tema-terminal.sh" >"$tty" 2>/dev/null
  done < <(tmux list-clients -F '#{client_name} #{client_termname} #{client_tty}' 2>/dev/null)
  return 0
}


# --- Menus em popup ----------------------------------------------------------
#
# No lugar do display-menu do tmux: ele fecha quando o ponteiro se mexe fora do menu (o terminal
# relata movimento, e o tmux trata como "soltar fora"), então mal dava para chegar a um item.
# Popups não fecham assim. Itens no stdin: "tecla<TAB>rótulo<TAB>comando shell"; tecla "-" é
# separador; comando vazio deixa o item apagado. Um clique ou a tecla escolhe; Esc fecha.

menu_popup() {
  local c=$1 titulo=$2 arq w h x cw ch
  arq=$(mktemp "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/tt-menu-itens.XXXXXX")
  cat >"$arq"
  read -r cw ch < <(do_cliente "$c" '#{client_width} #{client_height}')
  cw=${cw:-80} ch=${ch:-24}
  w=$(cut -f2 "$arq" | sed 's/\x1b\[[0-9;]*m//g' | wc -L)
  w=$((w + 12)); ((w < 32)) && w=32; ((w > cw)) && w=$cw
  h=$(($(wc -l <"$arq") + 2)); ((h > ch - 1)) && h=$((ch - 1))
  x=${TT_X:-0}; ((x + w > cw)) && x=$((cw - w)); ((x < 0)) && x=0
  # display-popup volta na hora (não espera o popup): quem apaga o arquivo é o menu, depois de ler.
  tmux display-popup -c "$c" -x "$x" -y S -w "$w" -h "$h" -T " $titulo " -E "$EU --menu-popup-ui $(q "$arq")"
}

menu_popup_ui() {
  local itens binds="" i=0 k r cmd escolha
  itens=$(cat "$1"); rm -f "$1"
  while IFS=$'\t' read -r k r cmd; do
    i=$((i + 1))
    [[ ${#k} == 1 && $k =~ [[:alnum:]] && -n $cmd ]] && binds+="$k:pos($i)+accept,"
  done <<<"$itens"
  escolha=$(awk -F'\t' '{
      if ($1 == "-") printf "%d\t\033[90m%s\033[0m\n", NR, "────────────────────────"
      else if ($3 == "") printf "%d\t\033[90m %s\033[0m\n", NR, $2
      else printf "%d\t %s%s\n", NR, $2, ($1 == "" ? "" : "  \033[90m" $1 "\033[0m")
    }' <<<"$itens" |
    fzf --ansi --delimiter='\t' --with-nth=2 --no-input --no-info --no-separator --layout=reverse --no-sort \
      --pointer='▶' --color='bg:#282a36,fg:#f8f8f2,pointer:#ff79c6,fg+:#f8f8f2,bg+:#44475a' --bind='left-click:accept' \
      ${binds:+--bind="${binds%,}"} | cut -f1)
  # Esc/fora: escolha vazia. Sem esta checagem, `sed -n "p"` pegava TODAS as linhas e o menu
  # executava todas as ações de uma vez (abria janelas, desanexava a tela…).
  [[ $escolha =~ ^[0-9]+$ ]] || return 0
  cmd=$(sed -n "${escolha}p" <<<"$itens" | cut -f3)
  # Calado e sempre com sucesso: senão o tmux mostra a saída/erro por cima do painel.
  [[ -n $cmd ]] && tmux run-shell -b "sleep 0.1; ( $cmd ) >/dev/null 2>&1; true"
  return 0
}

# Tamanho dos popups grandes: tela cheia em tela pequena (celular), 90%x85% nas outras.
tam_popup() {
  local cw ch
  read -r cw ch < <(do_cliente "$1" '#{client_width} #{client_height}')
  if ((${cw:-80} < 80 || ${ch:-30} < 30)); then echo "-w 100% -h 100%"; else echo "-w 90% -h 85%"; fi
}

popup_tt() { # cliente título args… → comando que abre o tt num popup grande
  local c=$1 t=$2; shift 2
  echo "tmux display-popup -c $(q "$c") -E $(tam_popup "$c") -T $(q " $t ") $(q "$*")"
}

# Tela pequena (celular, ou janela estreita/baixa): modo compacto nos menus grandes.
compacto() { (($(tput cols 2>/dev/null || echo 80) < 80 || $(tput lines 2>/dev/null || echo 30) < 30)); }

