# Estado da UI (filtro, modo e tarefas abertas) para sobreviver aos reloads do fzf.
tarefas_estado_arq() { echo "$RT/tt-tarefas-ui-$UID"; }
tarefas_mapa_arq() { echo "$RT/tt-tarefas-mapa-$UID"; }
tarefas_ui_get() { sed -n "s/^$1=//p" "$(tarefas_estado_arq)" 2>/dev/null | tail -1; }
tarefas_ui_set() { # chave valor
  local arq; arq=$(tarefas_estado_arq); mkdir -p "$RT"
  { grep -v "^$1=" "$arq" 2>/dev/null; printf '%s=%s\n' "$1" "$2"; } >"$arq.tmp" && mv "$arq.tmp" "$arq"
}
tarefas_filtro() { tarefas_ui_get filtro; }
tarefas_filtro_set() { tarefas_ui_set filtro "$1"; }
# Ciclo do filtro: hoje -> abertas -> feitas -> prazo (só com deadline) -> todas -> hoje.
tarefas_filtro_ciclar() {
  case $(tarefas_filtro) in
    hoje) tarefas_filtro_set abertas ;;
    abertas) tarefas_filtro_set feitas ;;
    feitas) tarefas_filtro_set prazo ;;
    prazo) tarefas_filtro_set todas ;;
    todas) tarefas_filtro_set arquivo ;;
    *) tarefas_filtro_set hoje ;;
  esac
}
# Uma tarefa está aberta (▾, detalhes à mostra)? Estado em linhas "exp=<id>" no arquivo da UI.
tarefas_exp_tem() { grep -qxF "exp=$1" "$(tarefas_estado_arq)" 2>/dev/null; }
tarefas_exp_alternar() {
  local id=$1 arq; arq=$(tarefas_estado_arq); mkdir -p "$RT"; touch "$arq"
  if tarefas_exp_tem "$id"; then grep -vxF "exp=$id" "$arq" >"$arq.tmp" || true; mv "$arq.tmp" "$arq"
  else printf 'exp=%s\n' "$id" >>"$arq"; fi
}
tarefas_exp_definir() { # id 1|0
  tarefas_exp_tem "$1" && [[ $2 == 1 ]] && return 0
  tarefas_exp_tem "$1" || [[ $2 == 1 ]] || return 0
  tarefas_exp_alternar "$1"
}

# --- data portável (GNU date -d; BSD/macOS date -r) ------------------------
# Formata um epoch com um +FORMATO de strftime. GNU usa -d @epoch; BSD usa -r epoch.
tt_fmt_epoch() { # epoch +formato
  local ep=$1 fmt=$2
  date -d "@$ep" "$fmt" 2>/dev/null || date -r "$ep" "$fmt" 2>/dev/null
}
# Epoch de uma data "YYYY-MM-DD[ HH:MM]". GNU aceita direto; BSD precisa de -j -f.
tt_epoch_de() { # "YYYY-MM-DD[ HH:MM]"
  local s=$1
  date -d "$s" +%s 2>/dev/null && return 0
  if [[ $s == *" "*:* ]]; then date -j -f '%Y-%m-%d %H:%M' "$s" +%s 2>/dev/null
  else date -j -f '%Y-%m-%d' "$s" +%s 2>/dev/null; fi
}
# Dias de hoje até o prazo (negativo = passou); vazio se sem prazo.
tarefas_dias_ate() { # epoch
  local ep=$1 agora tz
  [[ -n $ep ]] || return 1
  read -r agora tz < <(tarefas_relogio)
  echo $(( (ep + tz) / 86400 - (agora + tz) / 86400 ))
}

# Rótulo do prazo de uma tarefa (o mesmo da lista, sem cores): "hoje", "amanhã", "sex 10/10"...
tarefas_prazo_texto() { # epoch [1 = com horário]
  [[ -n $1 ]] || return 0
  local agora tz; read -r agora tz < <(tarefas_relogio)
  LC_ALL=C awk -v NOW="$agora" -v TZOFF="$tz" -v P="$1" -v H="${2:-}" "$TAREFAS_AWK"'
    BEGIN { HOJE = dia(NOW); civil(HOJE); ANO = CY; split("dom seg ter qua qui sex sáb", DOW, " ")
            print quando(P) (H == 1 ? " às " hhmm(P) : "") }'
}

