# --- Escolha do navegador para links (e-mail) -----------------------------------
#
# Enter num link do w3m (e :open-link do aerc) chama tt --abrir-link: o usuário escolhe entre
#   chromium  Google Chrome interno (estável, janela gráfica pelo WSLg/X11)
#   carbonyl  Carbonyl embutido (Chromium que desenha no terminal, num popup do tmux)
#   sistema   navegador padrão do sistema (xdg-open → wslview no WSL)
# Chave navegador=chromium|carbonyl|sistema|perguntar no config (padrão: perguntar). Os dois
# primeiros são baixados sob demanda para ~/.local/share/tt-navegadores, sem sudo, com sha256
# fixado; só x86_64 (em outra arquitetura ou no Termux ficam só os do sistema).
DIR_NAVEGADORES=$HOME/.local/share/tt-navegadores
CHROME_INDICE=${TT_CHROME_INDICE:-https://dl.google.com/linux/chrome/deb/dists/stable/main/binary-amd64/Packages}
CHROME_BASE=${TT_CHROME_BASE:-https://dl.google.com/linux/chrome/deb}
CARBONYL_URL=${TT_CARBONYL_URL:-https://github.com/fathyb/carbonyl/releases/download/v0.0.3/carbonyl.linux-amd64.zip}
CARBONYL_SHA256=${TT_CARBONYL_SHA256:-46a902ea29bb32f773fb4ee341423705b92345a810422b8df93eaea6a1ec7ad2}

# User-agent do Chrome embutido (ou um atual fixo): o Carbonyl é um Chromium de 2023 e vários
# sites (login do Google à frente) barram navegador antigo só pelo anúncio; apresentar-se como o
# Chrome ajuda a passar o portão de entrada (o motor continua o que é — sem garantia em sites que
# inspecionam fundo).
ua_chrome() {
  local v; v=$(cut -d- -f1 "$DIR_NAVEGADORES/chrome/versao" 2>/dev/null); v=${v:-155.0.0.0}
  printf 'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/%s Safari/537.36' "$v"
}

navegadores_graficos_ok() {
  pacotes_lib 2>/dev/null || { [[ $(uname -m) == x86_64 && $(uname -s) == Linux ]] && ! tem_cmd termux-open-url; return; }
  [[ $(pk_so) == linux && $(pk_arch) == x86_64 && $(pk_libc) == glibc ]] && [[ $(pk_ambiente) != termux ]] && ! tem_cmd termux-open-url
}
# No macOS, o Chrome estável é um app nativo universal, não o .deb Linux que o tt baixa para WSL/Linux.
# Procuramos nos dois locais usuais de instalação (sistema e usuário); o perfil continua dentro do espaço
# do tt e separado do perfil pessoal do Chrome. A busca não inicia o app nem usa Spotlight/rede.
mac_chromium_app() {
  local app
  for app in "$HOME/Applications/Google Chrome.app" /Applications/Google\ Chrome.app \
             "$HOME/Applications/Chromium.app" /Applications/Chromium.app; do
    [[ -d $app/Contents/MacOS && -f $app/Contents/Info.plist ]] || continue
    printf '%s\n' "$app"
    return 0
  done
  return 1
}
navegador_so() { case ${TT_SO:-$(uname -s 2>/dev/null)} in Darwin|macos) echo macos ;; *) echo outro ;; esac; }
navegador_link_grafico_ok() {
  if [[ $(navegador_so) == macos ]]; then [[ -n $(mac_chromium_app) && -x $(command -v open 2>/dev/null) ]]; return; fi
  navegadores_graficos_ok
}
chromium_macos_abrir() {
  local u=$1 app log=${HOME}/.cache/tt/chrome-mac.log c=${TT_LINK_CLIENTE:-}
  app=$(mac_chromium_app) || {
    tmux display-message ${c:+-c "$c"} -d 7000 'Chromium interno: Google Chrome não encontrado no Mac; instale-o ou escolha Navegador do sistema.' 2>/dev/null || true
    echo 'Chromium interno: Google Chrome/Chromium não encontrado em /Applications ou ~/Applications.' >&2
    link_copiar "$c" "$u"
    return 1
  }
  mkdir -p "${log%/*}" 2>/dev/null || log=/dev/null
  # LaunchServices inicia/endereça o app gráfico mesmo quando o pedido veio de SSH, tmux ou do popup do e-mail.
  # Um user-data-dir próprio reproduz o Chrome interno do WSL sem tocar no perfil pessoal nem no Safari.
  if open -a "$app" --args "--user-data-dir=$DIR_NAVEGADORES/perfil-chrome-macos" \
      --no-first-run --no-default-browser-check "$u" >>"$log" 2>&1; then
    return 0
  fi
  tmux display-message ${c:+-c "$c"} -d 7000 'Chromium interno: o Google Chrome do Mac não abriu; consulte ~/.cache/tt/chrome-mac.log. O link foi copiado.' 2>/dev/null || true
  echo "Chromium interno: falha ao abrir $app; consulte $log." >&2
  link_copiar "$c" "$u"
  return 1
}
bin_chromium() { echo "$DIR_NAVEGADORES/chrome/opt/google/chrome/chrome"; }
bin_carbonyl() { echo "$DIR_NAVEGADORES/carbonyl/carbonyl-0.0.3/carbonyl"; }

# extrair_deb ARQUIVO.deb DESTINO: extrai o data.tar.* de dentro do .deb (formato ar) com python3.
extrair_deb() {
  python3 -I - "$1" "$2" <<'PY'
import sys, tarfile, io
deb, dest = sys.argv[1], sys.argv[2]
b = open(deb, "rb").read()
if b[:8] != b"!<arch>\n":
    sys.exit("não é um .deb")
i = 8
while i + 60 <= len(b):
    nome = b[i:i+16].decode().strip().rstrip("/")
    tam = int(b[i+48:i+58].decode().strip())
    dados = b[i+60:i+60+tam]
    i += 60 + tam + (tam % 2)
    if nome.startswith("data.tar"):
        with tarfile.open(fileobj=io.BytesIO(dados)) as t:
            # Só o que está em opt/ (o navegador). O resto do .deb (cron, menus, links absolutos como
            # /etc/cron.daily/google-chrome) é do sistema e o filtro "data" do Python novo o recusa.
            ms = [m for m in t.getmembers() if m.name.lstrip("./").startswith("opt/")
                  and not (m.issym() and m.linkname.startswith("/"))]
            try: t.extractall(dest, members=ms, filter="data")
            except TypeError: t.extractall(dest, members=ms)
        sys.exit(0)
sys.exit("sem data.tar no .deb")
PY
}

# Google Chrome estável, sem sudo: baixa o .deb do repositório oficial do Google, confere o sha256 com o
# índice do próprio repositório (Packages, por HTTPS) e extrai em ~/.local com python3 (ar + tar, sem
# depender de dpkg-deb, então funciona em qualquer distribuição).
# (O Chrome for Testing avisa que é só para desenvolvimento; o estável não.)
chrome_instalar() {
  local idx pacote versao arq sha deb dir=$DIR_NAVEGADORES/chrome rc
  pacotes_lib || return 1
  idx=$(curl -fsS --connect-timeout 15 --retry 2 -m 60 "$CHROME_INDICE") || { echo "✗ não consegui o índice do Chrome (sem rede?)." >&2; return 1; }
  pacote=$(awk -v RS= '/(^|\n)Package: google-chrome-stable(\n|$)/ {print; exit}' <<<"$idx")
  versao=$(sed -n 's/^Version: //p' <<<"$pacote"); arq=$(sed -n 's/^Filename: //p' <<<"$pacote"); sha=$(sed -n 's/^SHA256: //p' <<<"$pacote")
  [[ -n $versao && -n $arq && -n $sha ]] || { echo "✗ índice do Chrome sem o pacote estável." >&2; return 1; }
  mkdir -p "$DIR_NAVEGADORES" || return 1
  deb=$DIR_NAVEGADORES/chrome.deb.$$
  echo "Baixando o Google Chrome $versao (sem sudo, em $dir)…" >&2
  pk_baixar "$CHROME_BASE/$arq" "$deb" "$sha" 400 || { rm -f "$deb"; return 1; }
  rm -rf "$dir.novo"; mkdir -p "$dir.novo" && extrair_deb "$deb" "$dir.novo"; rc=$?; rm -f "$deb"
  [[ $rc == 0 && -x $dir.novo/opt/google/chrome/chrome ]] || { echo "✗ falha ao extrair o Chrome." >&2; rm -rf "$dir.novo"; return 1; }
  rm -rf "$dir" "$DIR_NAVEGADORES/chromium"; mv "$dir.novo" "$dir" && echo "$versao" >"$dir/versao"
}

# navegador_instalar chromium|carbonyl: instala sob demanda. Mensagens no stderr.
navegador_instalar() {
  local qual=$1 dir zip
  pacotes_lib || return 1
  case $qual in
    chromium) command -v curl >/dev/null || { echo "precisa do curl (tt --pedir-sudo chrome)" >&2; return 1; }
              [[ -x $(bin_chromium) ]] && return 0; chrome_instalar; return ;;
    carbonyl) [[ -x $(bin_carbonyl) ]] && return 0 ;;
    *) return 1 ;;
  esac
  command -v curl >/dev/null || { echo "precisa do curl (tt --pedir-sudo carbonyl)" >&2; return 1; }
  command -v unzip >/dev/null || { echo "precisa do unzip (tt --pedir-sudo carbonyl)" >&2; return 1; }
  dir=$DIR_NAVEGADORES/carbonyl; mkdir -p "$DIR_NAVEGADORES" || return 1
  zip=$DIR_NAVEGADORES/carbonyl.zip.$$
  echo "Baixando o Carbonyl (sem sudo, em $dir)…" >&2
  pk_baixar "$CARBONYL_URL" "$zip" "$CARBONYL_SHA256" 250 || { rm -f "$zip"; return 1; }
  rm -rf "$dir"; mkdir -p "$dir" && unzip -q -o "$zip" -d "$dir"; local rc=$?; rm -f "$zip"
  [[ $rc == 0 && -x $(bin_carbonyl) ]] || { echo "✗ falha ao extrair o Carbonyl." >&2; rm -rf "$dir"; return 1; }
}

# Atualiza o Chrome em segundo plano, no máximo uma vez por dia (o .deb novo só troca se o sha256 bater).
chrome_atualizar_se_velho() {
  local marca=$DIR_NAVEGADORES/chrome/ultima-checagem agora; agora=$(date +%s)
  [[ -x $(bin_chromium) ]] || return 0
  (( agora - $(cat "$marca" 2>/dev/null || echo 0) > 86400 )) || return 0
  echo "$agora" >"$marca"
  local novo; novo=$(curl -fsS -m 20 "$CHROME_INDICE" 2>/dev/null | awk -v RS= '/(^|\n)Package: google-chrome-stable(\n|$)/ {print; exit}' | sed -n 's/^Version: //p')
  [[ -n $novo && $novo != "$(cat "$DIR_NAVEGADORES/chrome/versao" 2>/dev/null)" ]] || return 0
  chrome_instalar >/dev/null 2>&1
}

# --- Plataforma, gerenciador de pacotes e pendências de instalação -------------------------------
#
# A camada de plataforma (gerenciador de pacotes, privilégio, nomes de pacote por distro e instalação
# robusta) vive no pacotes-tt.sh, que o instalar.sh também usa; aqui ficam o catálogo do que o tt pode
# precisar, o modal (tt --pedir-sudo) e os instaladores que não pedem administrador.
PACOTES_LIB=$DIR_TT/pacotes-tt.sh
[[ -f $PACOTES_LIB ]] || PACOTES_LIB=${EU%/*}/pacotes-tt.sh
pacotes_lib() { # carrega a biblioteca uma vez: só quem precisa dela paga o custo
  [[ -n ${PK_CARREGADA:-} ]] && return 0
  [[ -f $PACOTES_LIB ]] || { echo "tt: não achei $PACOTES_LIB" >&2; return 1; }
  # shellcheck disable=SC1090
  source "$PACOTES_LIB" && PK_CARREGADA=1
}

# Compatibilidade: nomes antigos, agora sobre a biblioteca.
gerenciador_pacotes() { pacotes_lib && pk_gerenciador; }
cmd_instalar_do_gerenciador() { pacotes_lib && pk_cmd_instalar "$1"; }
sudo_do_gerenciador() { # "sudo", "doas" ou "su"; nada se já é root ou o gerenciador roda como usuário
  pacotes_lib || return 0
  local p; p=$(pk_privilegio "${1:-}")
  case $p in nenhum|indisponivel) ;; *) echo "$p" ;; esac
}
instalar_pacotes_cmd() { cmd_instalar_do_gerenciador "$(gerenciador_pacotes)"; }

# pend_resolver GER item… — preenche PK_PACOTES (nomes finais de pacote) e PK_SEM_PACOTE (itens sem
# pacote neste gerenciador). Item = nome lógico (tmux, mbsync…), arquivo de biblioteca (libnss3.so) ou
# um destes grupos: xoauth2-build (compilador + cabeçalhos do SASL), isync-build (para compilar o isync),
# tmux-build (para compilar o tmux: compilador, make, pkg-config, yacc, libevent e ncurses).
pend_resolver() {
  pacotes_lib || return 1
  local ger=$1 t n; shift
  local -a logicos=() libs=() sem=()
  for t in "$@"; do
    case $t in
      xoauth2-build) logicos+=(cc libc-dev sasl-dev ssl-dev) ;;
      isync-build) logicos+=(cc libc-dev make perl sasl-dev ssl-dev zlib-dev pkg-config) ;;
      tmux-build) logicos+=(cc libc-dev make pkg-config yacc libevent-dev ncurses-dev) ;;
      -|plugin-xoauth2|'') ;;
      *.so|*.so.*) if n=$(pk_pacote_lib "$ger" "$t"); then libs+=("$n"); else sem+=("$t"); fi ;;
      *) logicos+=("$t") ;;
    esac
  done
  pk_resolver "$ger" ${logicos[@]+"${logicos[@]}"}
  for n in ${libs[@]+"${libs[@]}"}; do
    case " ${PK_PACOTES[*]-} " in *" $n "*) ;; *) PK_PACOTES+=("$n") ;; esac
  done
  PK_SEM_PACOTE+=(${sem[@]+"${sem[@]}"})
}

pacotes_do_gerenciador() { # GER item… → nomes de pacote, um por linha (compatibilidade)
  pend_resolver "$@" || return 1
  printf '%s\n' ${PK_PACOTES[@]+"${PK_PACOTES[@]}"}
}

# TT_FINGE_FALTA lista comandos tratados como ausentes (testes); TT_FINGE_FALTA_ARQ aponta para um arquivo
# com a mesma lista, que um gerenciador de mentira esvazia ao "instalar".
finge_falta() { # nome → 0 se os testes mandam tratá-lo como ausente
  local f=${TT_FINGE_FALTA:-}
  [[ -n ${TT_FINGE_FALTA_ARQ:-} && -r $TT_FINGE_FALTA_ARQ ]] && f+=" $(cat "$TT_FINGE_FALTA_ARQ")"
  case " $f " in *" $1 "*) return 0 ;; esac
  return 1
}
falta_cmd() {
  finge_falta "$1" && return 0
  ! command -v "$1" >/dev/null 2>&1
}
pend_faltam() { local c; for c in "$@"; do falta_cmd "$c" && printf '%s ' "$c"; done | sed 's/ $//'; }

# Resposta do usuário por pendência: arquivo com a hora da recusa (vale 7 dias), "nunca" (não instalar e
# não avisar de novo) ou uma hora no passado que faz o aviso voltar em 1 dia ("mais tarde").
sudo_recusa_nunca() { [[ $(cat "$(sudo_recusa_arq "$1")" 2>/dev/null) == nunca ]]; }
sudo_recusa_gravar() { # id nunca|tarde|semana
  mkdir -p "$ESTADO_DIR"
  local modo=$2; pend_sempre "$1" && modo=tarde   # sem "nunca" nem semana: volta a perguntar amanhã
  case $modo in
    nunca) echo nunca ;;
    tarde) echo $(( $(date +%s) - 604800 + 86400 )) ;;
    *) date +%s ;;
  esac >"$(sudo_recusa_arq "$1")"
}
sudo_recusa_arq() {
  case $1 in
    navegadores) echo "$ESTADO_DIR/navegadores-sudo-recusado" ;; # nome antigo: recusas já dadas seguem valendo
    *) echo "$ESTADO_DIR/sudo-recusado-$1" ;;
  esac
}
pend_recusado() { # id → 0 se o usuário recusou ou adiou (não perguntar agora)
  local id=$1 v agora; agora=$(date +%s)
  if sudo_recusa_nunca "$id"; then pend_sempre "$id" || return 0; v=0; fi
  v=$(cat "$(sudo_recusa_arq "$id")" 2>/dev/null || echo 0); [[ $v =~ ^[0-9]+$ ]] || v=0
  (( agora - v < 604800 )) && return 0
  case $id in   # a pendência "navegadores" de antes valia para os dois
    chrome|carbonyl)
      sudo_recusa_nunca navegadores && return 0
      v=$(cat "$(sudo_recusa_arq navegadores)" 2>/dev/null || echo 0); [[ $v =~ ^[0-9]+$ ]] || v=0
      (( agora - v < 604800 )) && return 0 ;;
  esac
  return 1
}

tem_conta_email() { compgen -G "$EMAIL_DIR/*.conf" >/dev/null 2>&1; }

# Pendências que não aceitam "nunca": a pessoa pode adiar, mas o tt volta a perguntar no dia seguinte. O espelho
# local do e-mail é uma delas: sem ele os e-mails [tt] (tarefas compartilhadas, demandas, atualizações) não viram
# tarefa, porque as demandas só são lidas do INBOX espelhado.
PEND_SEMPRE=" email-espelho "
pend_sempre() { [[ $PEND_SEMPRE == *" $1 "* ]]; }

# Contas com entrada IMAP e sync_local desligado, uma por linha (o slug); com "oauth", só as de login OAuth.
email_sem_espelho() { # [oauth]
  local slug; local -A E=()
  for slug in $(email_slugs 2>/dev/null); do
    E=(); email_ler "$slug" 2>/dev/null || continue
    [[ -n ${E[imap_host]:-} && ${E[sync_local]:-} != 1 ]] || continue
    [[ ${1:-} == oauth && ${E[auth]:-} != oauth ]] && continue
    printf '%s\n' "$slug"
  done
}

# Passo da pendência email-espelho: prepara o mbsync com SASL e o plugin XOAUTH2 (se alguma conta é OAuth) e
# liga o sync local em cada conta que ainda não tem. A primeira sincronização de cada uma vai em 2º plano.
email_espelho_ligar() {
  local slug rc=0; local -a contas
  mapfile -t contas < <(email_sem_espelho)
  ((${#contas[@]})) || return 0
  if [[ -n $(email_sem_espelho oauth) ]]; then
    mbsync_tem_sasl || isync_sasl_construir || rc=1
    xoauth2_presente || xoauth2_construir || rc=1
  fi
  for slug in "${contas[@]}"; do
    echo "  → espelho local: $slug"
    email_sync_local_definir "$slug" 1 || rc=1
  done
  return $rc
}

# 1.2 < 1.10: compara versões numéricas pontuadas. Versão vazia (não deu para ler) nunca é "velha".
versao_de() { "$@" 2>/dev/null | grep -oE '[0-9]+(\.[0-9]+)+' | head -1; }
versao_menor() { # A B → 0 se A < B
  [[ -n $1 ]] || return 1
  awk -v a="$1" -v b="$2" 'BEGIN { na = split(a, x, "."); nb = split(b, y, "."); n = (na > nb ? na : nb)
    for (i = 1; i <= n; i++) { if ((x[i]+0) < (y[i]+0)) exit 0; if ((x[i]+0) > (y[i]+0)) exit 1 } exit 1 }'
}

# Biblioteca presente no sistema? (o ldd não vê o que o navegador carrega em tempo de execução)
lib_presente() {
  local l
  for l in ldconfig /sbin/ldconfig /usr/sbin/ldconfig; do
    command -v "$l" >/dev/null 2>&1 || continue
    "$l" -p 2>/dev/null | grep -qF "$1" && return 0
  done
  compgen -G "/usr/lib*/$1" >/dev/null 2>&1 || compgen -G "/usr/lib/*/$1" >/dev/null 2>&1 || compgen -G "/lib*/$1" >/dev/null 2>&1
}

# Bibliotecas que faltam ao Chrome e ao Carbonyl baixados: o que o ldd acusa ("not found"), mais as que o
# Chrome carrega depois, e fontes (sem nenhuma, a tela do navegador sai em quadradinhos). Imprime
# nomes de arquivo (libnss3.so…) e o lógico fonts-liberation; o pk_pacote_lib traduz por distro.
chrome_libs_faltando() {
  [[ -n ${TT_FINGE_CHROME_LIBS_ARQ:-} ]] && { tr '\n' ' ' 2>/dev/null <"$TT_FINGE_CHROME_LIBS_ARQ" | sed 's/ *$//'; return 0; }
  [[ -n ${TT_FINGE_CHROME_LIBS:-} ]] && { echo "$TT_FINGE_CHROME_LIBS"; return 0; }
  local alvo so out=""
  for alvo in "$(bin_chromium)" "$(bin_carbonyl)"; do
    [[ -x $alvo ]] || continue
    out+=$'\n'$(ldd "$alvo" 2>/dev/null | awk '/not found/ {print $1}')
  done
  if [[ -x $(bin_chromium) ]]; then
    for so in libgtk-3.so.0 libvulkan.so.1 libudev.so.1; do lib_presente "$so" || out+=$'\n'$so; done
    [[ -z $(fc-list 2>/dev/null | head -1) ]] && out+=$'\n'fonts-liberation
  fi
  printf '%s\n' "$out" | awk 'NF && !v[$0]++' | tr '\n' ' ' | sed 's/ $//'
}

# --- Plugin XOAUTH2 do Cyrus SASL (contas Google com auth=oauth e sync local) ---------------------
# O mbsync só entra por OAuth com o plugin XOAUTH2 do SASL, que a maioria das distribuições não
# empacota. O tt baixa o código (cyrus-sasl-xoauth2, MIT, 4 arquivos C), confere o sha256, compila
# com cc em ~1 s e deixa a libxoauth2.so em DIR_SASL — sem root. O mbsync a enxerga por SASL_PATH
# (xoauth2_ambiente). Só o compilador e os cabeçalhos do SASL precisam de administrador.
DIR_SASL=$HOME/.local/share/tt-sasl2
XOAUTH2_URL=${TT_XOAUTH2_URL:-https://github.com/moriyoshi/cyrus-sasl-xoauth2/archive/refs/tags/v0.2.tar.gz}
XOAUTH2_SHA256=${TT_XOAUTH2_SHA256:-a62c26566098100d30aa254e4c1aa4309876b470f139e1019bb9032b6e2ee943}

sasl_dirs_sistema() {
  local d
  for d in /usr/lib/*/sasl2 /usr/lib64/sasl2 /usr/lib/sasl2 /usr/local/lib/sasl2 /usr/pkg/lib/sasl2 /opt/homebrew/lib/sasl2 \
           /opt/homebrew/opt/cyrus-sasl/lib/sasl2 /usr/local/opt/cyrus-sasl/lib/sasl2 "${PREFIX:-/nonexistent}/lib/sasl2"; do
    [[ -d $d ]] && echo "$d"
  done | awk '!v[$0]++'
}

xoauth2_necessario() { # há conta com login OAuth e sync local?
  local slug; local -A E=()
  for slug in $(email_slugs 2>/dev/null); do
    E=(); email_ler "$slug" 2>/dev/null || continue
    [[ ${E[auth]:-} == oauth && ${E[sync_local]:-} == 1 ]] && return 0
  done
  return 1
}

xoauth2_presente() {
  finge_falta xoauth2 && return 1
  [[ -e $DIR_SASL/libxoauth2.so ]] && return 0
  local d
  for d in $(sasl_dirs_sistema); do compgen -G "$d/libxoauth2.*" >/dev/null && return 0; done
  return 1
}

# Pasta que contém ARQUIVO (sasl/sasl.h, openssl/ssl.h, zlib.h…). TT_SASL_INCLUDE vale para os testes e
# para quem tem os cabeçalhos num lugar incomum.
cabecalho_dir() { # arquivo → pasta
  local d b
  b=$(command -v brew 2>/dev/null) && b=$(brew --prefix 2>/dev/null)
  for d in ${TT_SASL_INCLUDE:-} /usr/include /usr/local/include "${PREFIX:-/nonexistent}/include" /usr/pkg/include /opt/homebrew/include \
           ${b:+$b/include} /opt/homebrew/opt/cyrus-sasl/include /opt/homebrew/opt/openssl@3/include /usr/local/opt/cyrus-sasl/include \
           /usr/local/opt/openssl@3/include /usr/include/"$(uname -m)"-linux-gnu; do
    [[ -f $d/$1 ]] && { echo "$d"; return 0; }
  done
  return 1
}
sasl_cabecalho_dir() { cabecalho_dir sasl/sasl.h; }

xoauth2_deps_faltam() { # falta o compilador ou os cabeçalhos do SASL (e do OpenSSL, que o saslplug.h puxa)?
  falta_cmd cc && falta_cmd gcc && falta_cmd clang && return 0
  finge_falta xoauth2-build && return 0
  sasl_cabecalho_dir >/dev/null || return 0
  cabecalho_dir openssl/md5.h >/dev/null || return 0
  return 1
}

# SASL_PATH para o mbsync: a pasta do tt primeiro, depois as do sistema (a variável SUBSTITUI a
# lista padrão; sem as do sistema o mbsync perderia PLAIN, LOGIN…). Vazio se não há plugin do tt.
xoauth2_ambiente() {
  [[ -e $DIR_SASL/libxoauth2.so ]] || return 0
  local d p=$DIR_SASL
  for d in $(sasl_dirs_sistema); do p+=":$d"; done
  echo "$p"
}

xoauth2_construir() {
  local tmp inc inc2 cc rc=0 flags
  [[ -e $DIR_SASL/libxoauth2.so ]] && return 0
  pacotes_lib || return 1
  cc=$(command -v cc || command -v gcc || command -v clang) || { echo "✗ sem compilador (cc/gcc/clang)." >&2; return 1; }
  inc=$(sasl_cabecalho_dir) || { echo "✗ sem os cabeçalhos do Cyrus SASL (sasl/sasl.h)." >&2; return 1; }
  inc2=$(cabecalho_dir openssl/md5.h) || { echo "✗ sem os cabeçalhos do OpenSSL (openssl/md5.h)." >&2; return 1; }
  tmp=$(mktemp -d) || return 1
  echo "  Baixando e compilando o plugin XOAUTH2…"
  case $(pk_so) in macos) flags=(-dynamiclib -undefined dynamic_lookup) ;; *) flags=(-shared) ;; esac
  if pk_baixar "$XOAUTH2_URL" "$tmp/x.tgz" "$XOAUTH2_SHA256" 5 &&
     tar xzf "$tmp/x.tgz" -C "$tmp" --strip-components=1 &&
     (cd "$tmp" && "$cc" -O2 -fPIC "${flags[@]}" -I"$inc" -I"$inc2" -o libxoauth2.so xoauth2_str.c xoauth2_init.c xoauth2_server.c xoauth2_client.c 2>"$tmp/erro.txt") &&
     mkdir -p "$DIR_SASL" && cp "$tmp/libxoauth2.so" "$DIR_SASL/libxoauth2.so.new" && mv -f "$DIR_SASL/libxoauth2.so.new" "$DIR_SASL/libxoauth2.so"; then
    echo "  ✓ Plugin XOAUTH2 pronto em $DIR_SASL"
  else
    rc=1; echo "  ✗ Não consegui montar o plugin XOAUTH2 (rede, sha256 ou compilação)." >&2
    [[ -s $tmp/erro.txt ]] && grep -E 'error|Error' "$tmp/erro.txt" | head -5 >&2
  fi
  rm -rf "$tmp"; return $rc
}

# --- isync (mbsync) com suporte a SASL ------------------------------------------------------------
# Várias distribuições empacotam o isync SEM LibSASL (o do Termux, por exemplo): com ele o mbsync só sabe
# LOGIN e as contas OAuth falham com "built without LibSASL". Nesse caso o tt compila o isync com SASL em
# DIR_ISYNC (sem administrador; só o compilador e os cabeçalhos vêm do gerenciador) e o mbsync_bin o usa.
DIR_ISYNC=$HOME/.local/share/tt-isync
ISYNC_URL=${TT_ISYNC_URL:-https://downloads.sourceforge.net/project/isync/isync/1.5.1/isync-1.5.1.tar.gz}
ISYNC_SHA256=${TT_ISYNC_SHA256:-28cc90288036aa5b6f5307bfc7178a397799003b96f7fd6e4bd2478265bb22fa}

mbsync_bin() {
  if [[ -n ${TT_MBSYNC:-} ]]; then echo "$TT_MBSYNC"
  elif [[ -x $DIR_ISYNC/bin/mbsync ]]; then echo "$DIR_ISYNC/bin/mbsync"
  else echo mbsync; fi
}
mbsync_presente() { [[ -x $DIR_ISYNC/bin/mbsync ]] || ! falta_cmd "$(mbsync_bin)"; }

# O mbsync em uso sabe SASL? Sonda sem rede: uma conta fictícia com AuthMechs XOAUTH2; a versão sem SASL
# recusa a configuração na hora ("built without LibSASL"), a com SASL só tenta conectar (e falha à toa).
mbsync_tem_sasl() {
  finge_falta isync-sem-sasl && return 1
  local bin d out rc; bin=$(mbsync_bin)
  command -v "$bin" >/dev/null 2>&1 || return 0
  d=$(mktemp -d) || return 0
  printf 'IMAPAccount p\nHost 127.0.0.1\nPort 1\nUser x\nPass x\nAuthMechs XOAUTH2\nTLSType None\nIMAPStore p-r\nAccount p\nMaildirStore p-l\nPath %s/m/\nChannel p\nFar :p-r:\nNear :p-l:\n' "$d" >"$d/rc"
  if command -v timeout >/dev/null 2>&1; then out=$(timeout 10 "$bin" -c "$d/rc" -l p 2>&1); rc=$?
  else out=$("$bin" -c "$d/rc" -l p 2>&1); rc=$?; fi
  rm -rf "$d"
  grep -qiE 'without LibSASL|LibSASL' <<<"$out" && return 1
  return 0
}

isync_deps_faltam() { # faltam compilador, make, perl, tar, curl ou cabeçalhos (SASL, OpenSSL, zlib)?
  finge_falta isync-build && return 0
  falta_cmd cc && falta_cmd gcc && falta_cmd clang && return 0
  falta_cmd make && falta_cmd gmake && return 0
  falta_cmd perl && return 0
  falta_cmd curl && return 0
  falta_cmd tar && return 0
  cabecalho_dir sasl/sasl.h >/dev/null || return 0
  cabecalho_dir openssl/ssl.h >/dev/null || return 0
  cabecalho_dir zlib.h >/dev/null || return 0
  return 1
}

isync_sasl_construir() {
  local tmp mk jobs inc_s inc_o inc_z lib extra="" b rc=0
  [[ -x $DIR_ISYNC/bin/mbsync ]] && "$DIR_ISYNC/bin/mbsync" -V >/dev/null 2>&1 && return 0
  pacotes_lib || return 1
  mk=$(command -v gmake || command -v make) || { echo "✗ sem make." >&2; return 1; }
  inc_s=$(cabecalho_dir sasl/sasl.h) || { echo "✗ sem os cabeçalhos do Cyrus SASL." >&2; return 1; }
  inc_o=$(cabecalho_dir openssl/ssl.h) || { echo "✗ sem os cabeçalhos do OpenSSL." >&2; return 1; }
  inc_z=$(cabecalho_dir zlib.h) || { echo "✗ sem os cabeçalhos do zlib." >&2; return 1; }
  tmp=$(mktemp -d) || return 1
  jobs=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 2)
  echo "  Baixando e compilando o isync com SASL (alguns minutos)…"
  # Cabeçalhos/bibliotecas fora do lugar padrão (Homebrew, pkgsrc): o configure os acha por estas variáveis.
  local ldf=""
  for b in "$inc_s" "$inc_o" "$inc_z"; do
    case $b in /usr/include|/usr/local/include) ;; *) extra+=" -I$b"; [[ -d ${b%/include}/lib ]] && ldf+=" -L${b%/include}/lib" ;; esac
  done
  if pk_baixar "$ISYNC_URL" "$tmp/i.tgz" "$ISYNC_SHA256" 60 &&
     tar xzf "$tmp/i.tgz" -C "$tmp" --strip-components=1 &&
     (cd "$tmp" && CPPFLAGS="${CPPFLAGS:-}$extra" LDFLAGS="${LDFLAGS:-}$ldf" ./configure --prefix="$DIR_ISYNC" >"$tmp/configure.log" 2>&1 &&
        grep -q '^Using SASL' "$tmp/configure.log" && "$mk" -j"$jobs" >"$tmp/make.log" 2>&1 && "$mk" install >>"$tmp/make.log" 2>&1) &&
     [[ -x $DIR_ISYNC/bin/mbsync ]]; then
    echo "  ✓ isync com SASL pronto em $DIR_ISYNC"
  else
    rc=1; echo "  ✗ Não consegui compilar o isync com SASL." >&2
    if [[ -s $tmp/configure.log ]] && ! grep -q '^Using SASL' "$tmp/configure.log"; then echo "    (o configure não achou o LibSASL; faltam os cabeçalhos?)" >&2; fi
    [[ -s $tmp/make.log ]] && grep -E 'error|Error' "$tmp/make.log" | head -5 >&2
    rm -rf "$DIR_ISYNC"
  fi
  rm -rf "$tmp"; return $rc
}

# --- tmux 3.8, sem administrador -----------------------------------------------------------------
# Debian/Ubuntu estáveis trazem o tmux 3.5/3.6; o painel flutuante do tt pede o 3.8. O tt baixa o código
# oficial (confere o sha256), compila em DIR_TMUX e põe o executável na frente do PATH do tt (DIR_BIN_TT) e,
# se não houver outro, em ~/.local/bin. O servidor tmux que já está rodando NÃO é tocado: o novo vale a
# partir do próximo servidor (depois de fechar as sessões ou reiniciar a máquina).
TMUX_ALVO=3.8
DIR_TMUX=$HOME/.local/share/tt-tmux
TMUX_URL=${TT_TMUX_URL:-https://github.com/tmux/tmux/releases/download/$TMUX_ALVO/tmux-$TMUX_ALVO.tar.gz}
TMUX_SHA256=${TT_TMUX_SHA256:-e79c699c7e949dccd0a4a125e17b8d1261e311b16979dbc8eb34542f3966d82e}

tmux_compilavel() { # há como compilar aqui (Linux/macOS/Termux)? Em outras plataformas fica só o manual do tmux-antigo
  case $(pk_so 2>/dev/null) in linux | macos) return 0 ;; esac
  [[ $(pk_ambiente 2>/dev/null) == termux ]]
}
tmux_deps_faltam() { # faltam compilador, make, pkg-config, yacc, tar, curl ou cabeçalhos (libevent, ncurses)?
  finge_falta tmux-build && return 0
  falta_cmd cc && falta_cmd gcc && falta_cmd clang && return 0
  falta_cmd make && falta_cmd gmake && return 0
  # o configure do tmux 3.8 para em "yacc not found": o pacote traz o cmd-parse.c pronto, mas o configure.ac
  # exige um yacc assim mesmo (AC_CHECK_PROG found_yacc)
  falta_cmd yacc && falta_cmd bison && falta_cmd byacc && return 0
  falta_cmd pkg-config && falta_cmd pkgconf && return 0
  falta_cmd curl && return 0
  falta_cmd tar && return 0
  cabecalho_dir event2/event.h >/dev/null || return 0
  cabecalho_dir ncurses.h >/dev/null || cabecalho_dir curses.h >/dev/null || return 0
  return 1
}
tmux_deps_quais() { # o que falta para compilar o tmux, em palavras (mensagem do modal e pendencias.log)
  local -a f=()
  falta_cmd cc && falta_cmd gcc && falta_cmd clang && f+=(compilador)
  falta_cmd make && falta_cmd gmake && f+=(make)
  falta_cmd yacc && falta_cmd bison && falta_cmd byacc && f+=("yacc (bison)")
  falta_cmd pkg-config && falta_cmd pkgconf && f+=(pkg-config)
  falta_cmd curl && f+=(curl)
  falta_cmd tar && f+=(tar)
  cabecalho_dir event2/event.h >/dev/null || f+=("cabeçalhos do libevent")
  { cabecalho_dir ncurses.h || cabecalho_dir curses.h; } >/dev/null || f+=("cabeçalhos do ncurses")
  ((${#f[@]})) && printf '%s, ' "${f[@]}" | sed 's/, $//'
  return 0
}
tmux_construir() {
  local tmp mk jobs inc_e inc_n extra="" ldf="" b rc=0
  [[ -x $DIR_TMUX/bin/tmux ]] && ! versao_menor "$(versao_de "$DIR_TMUX/bin/tmux" -V)" "$TMUX_ALVO" && { tmux_ativar; return 0; }
  pacotes_lib || return 1
  mk=$(command -v gmake || command -v make) || { echo "✗ sem make." >&2; return 1; }
  inc_e=$(cabecalho_dir event2/event.h) || { echo "✗ sem os cabeçalhos do libevent." >&2; return 1; }
  inc_n=$(cabecalho_dir ncurses.h || cabecalho_dir curses.h) || { echo "✗ sem os cabeçalhos do ncurses." >&2; return 1; }
  if falta_cmd yacc && falta_cmd bison && falta_cmd byacc; then
    echo "✗ sem yacc (bison ou byacc): o configure do tmux exige." >&2; pk_log "tmux $TMUX_ALVO: sem yacc (bison ou byacc)"; return 1
  fi
  tmp=$(mktemp -d) || return 1
  jobs=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 2)
  echo "  Baixando e compilando o tmux $TMUX_ALVO (alguns minutos)…"
  for b in "$inc_e" "$inc_n"; do
    case $b in /usr/include | /usr/local/include) ;; *) extra+=" -I$b"; [[ -d ${b%/include}/lib ]] && ldf+=" -L${b%/include}/lib" ;; esac
  done
  local etapa=baixar motivo="" m
  if pk_baixar "$TMUX_URL" "$tmp/t.tgz" "$TMUX_SHA256" 20 &&
     etapa=extrair && tar xzf "$tmp/t.tgz" -C "$tmp" --strip-components=1 &&
     etapa=configure && (cd "$tmp" && CPPFLAGS="${CPPFLAGS:-}$extra" LDFLAGS="${LDFLAGS:-}$ldf" ./configure --prefix="$DIR_TMUX" >"$tmp/configure.log" 2>&1) &&
     etapa=make && (cd "$tmp" && "$mk" -j"$jobs" >"$tmp/make.log" 2>&1 && "$mk" install >>"$tmp/make.log" 2>&1) &&
     etapa=teste && [[ -x $DIR_TMUX/bin/tmux ]] && "$DIR_TMUX/bin/tmux" -V >/dev/null 2>&1; then
    tmux_ativar
    echo "  ✓ tmux $(versao_de "$DIR_TMUX/bin/tmux" -V) pronto em $DIR_TMUX"
    echo "    As sessões abertas não foram tocadas: o novo vale no próximo servidor tmux (feche todas as sessões ou reinicie)."
  else
    rc=1; echo "  ✗ Não consegui compilar o tmux $TMUX_ALVO." >&2
    # O motivo, pela etapa que falhou, vai também para o pendencias.log: antes só ficava na tela do modal
    # e o log dizia só "rc=1" (foi assim com o "yacc not found" de 10/10/2026).
    case $etapa in
      baixar | extrair) motivo="download, sha256 ou extração falhou ($TMUX_URL)" ;;
      configure) motivo="configure falhou: $(tail -3 "$tmp/configure.log" 2>/dev/null)" ;;
      make) m=$(grep -E 'error|Error' "$tmp/make.log" 2>/dev/null | head -5)
            motivo="make falhou: ${m:-$(tail -3 "$tmp/make.log" 2>/dev/null)}" ;;
      teste) motivo="o tmux compilado não roda" ;;
    esac
    printf '  %s\n' "$motivo" >&2; pk_log "tmux $TMUX_ALVO: ${motivo//$'\n'/ | }"
    rm -rf "$DIR_TMUX"
  fi
  rm -rf "$tmp"; return $rc
}
tmux_ativar() { # liga o tmux compilado: na frente do PATH do tt e (sem sobrescrever outro) em ~/.local/bin
  mkdir -p "$DIR_BIN_TT" "$HOME/.local/bin"
  ln -sfn "$DIR_TMUX/bin/tmux" "$DIR_BIN_TT/tmux"
  [[ -e $HOME/.local/bin/tmux && ! -L $HOME/.local/bin/tmux ]] || ln -sfn "$DIR_TMUX/bin/tmux" "$HOME/.local/bin/tmux"
  case ":$PATH:" in *":$DIR_BIN_TT:"*) ;; *) PATH=$DIR_BIN_TT:$PATH ;; esac
}

# --- fzf atual, sem administrador -----------------------------------------------------------------
# A central pede o fzf 0.60 ou mais novo; Ubuntu LTS e Debian estável trazem versões bem mais velhas. O
# binário oficial (um arquivo só, em Go) vai para DIR_BIN_TT, que o tt põe na frente do PATH.
FZF_MINIMO=0.60
FZF_VERSAO=0.74.4

fzf_asset() { # → "arquivo sha256" do release oficial para esta plataforma (rc 1 se não houver)
  pacotes_lib || return 1
  local k; k="$(pk_so)-$(pk_arch)"; [[ $(pk_ambiente) == termux ]] && k=android-aarch64
  case $k in
    linux-x86_64)   echo "linux_amd64 05e6813a337cc722c3ed07e54a764b75cc5d671e2e60459db0ba696ee5fa7504" ;;
    linux-aarch64)  echo "linux_arm64 5d673b849f494f0d64ec471d8640b153ca8849e3846a31da17abdcfce8df6b46" ;;
    linux-armv7)    echo "linux_armv7 0c6e61c89e0932e65b89e6db414c67803b5c10c374ed6a3ab1e14e805eea8486" ;;
    android-aarch64) echo "android_arm64 dc32053d375160bdd55c001545884ca8333edff69f25defe8a658ad42ea24858" ;;
    macos-x86_64)   echo "darwin_amd64 2d392b50be66e2ab104ccd52a6072df692b1f9b9c5b449a9c098de885f32c4c5" ;;
    macos-aarch64)  echo "darwin_arm64 4f6a113bfc0c7959e0005c78d566a51afc4fcefc956f43735c62a9deb19e92ae" ;;
    freebsd-x86_64) echo "freebsd_amd64 ecefbaa7cb0f85da5b653257a77d804e95cd9d2e203a96c03197adc1badd64b1" ;;
    openbsd-x86_64) echo "openbsd_amd64 9ce54b78cd0300ced4e2c793b01ed5801fb06245d32427aa9a43883e06c3b715" ;;
    *) return 1 ;;
  esac
}

fzf_instalar() {
  local a plat sha url tmp
  a=$(fzf_asset) || { echo "✗ não há fzf pronto para esta plataforma; atualize pelo gerenciador de pacotes." >&2; return 1; }
  plat=${a%% *}; sha=${a##* }
  url=${TT_FZF_URL:-https://github.com/junegunn/fzf/releases/download/v$FZF_VERSAO/fzf-$FZF_VERSAO-$plat.tar.gz}
  sha=${TT_FZF_SHA256:-$sha}
  tmp=$(mktemp -d) || return 1
  echo "  Baixando o fzf $FZF_VERSAO…"
  if pk_baixar "$url" "$tmp/f.tgz" "$sha" 20 && tar xzf "$tmp/f.tgz" -C "$tmp" fzf 2>/dev/null &&
     mkdir -p "$DIR_BIN_TT" && cp "$tmp/fzf" "$DIR_BIN_TT/fzf.novo" && chmod +x "$DIR_BIN_TT/fzf.novo" && mv -f "$DIR_BIN_TT/fzf.novo" "$DIR_BIN_TT/fzf"; then
    case ":$PATH:" in *":$DIR_BIN_TT:"*) ;; *) PATH=$DIR_BIN_TT:$PATH ;; esac   # vale já neste processo (a conferência, a central)
    rm -rf "$tmp"; echo "  ✓ fzf $FZF_VERSAO em $DIR_BIN_TT"; return 0
  fi
  rm -rf "$tmp"; echo "  ✗ Não consegui instalar o fzf." >&2; return 1
}

# --- Catálogo de pendências ---------------------------------------------------------------------
#
# Tudo o que o tt pode querer instalar nesta máquina, em um só lugar. Cada item sabe (1) se faz sentido
# aqui, (2) o que falta do gerenciador de pacotes (administrador), (3) se há passo que só baixa/compila na
# pasta do usuário e (4) quão importante é: essencial (o tt degrada sem), recurso (de uma função em uso)
# ou opcional (conforto). O vigia só avisa de essencial e recurso; o menu administrar → 📦 mostra tudo.
PEND_IDS=(nucleo fzf-novo tmux-antigo tmux-novo email-aerc email-sync isync-sasl email-xoauth2 email-espelho email-html email-editor email-spell
          chrome carbonyl chrome-libs clipboard notificacoes xdg-utils termux-api pv mosh nomeador-local sshd sudo-sem-senha)

CHROME_TAM="~120 MB"; CARBONYL_TAM="~60 MB"

# pend_avaliar ID — preenche P_APLICA (1 se faz sentido nesta máquina), P_NIVEL, P_SYS (itens do
# gerenciador que faltam), P_USR (1 = há passo sem administrador a fazer), P_MANUAL (texto: o tt não
# resolve sozinho), P_ROTULO, P_MOTIVO e P_TAM.
declare -A PEND_ROTULOS=(
  [nucleo]="ferramentas básicas" [fzf-novo]="fzf atual" [tmux-antigo]="tmux atual" [tmux-novo]="tmux 3.8 (painel flutuante)" [email-aerc]="aerc (cliente de e-mail)"
  [email-sync]="mbsync (isync)" [email-espelho]="espelho local do e-mail" [isync-sasl]="isync com SASL" [email-xoauth2]="plugin XOAUTH2 do SASL" [email-html]="w3m"
  [email-editor]="vim" [email-spell]="dicionário de português do vim" [chrome]="Google Chrome interno"
  [carbonyl]="Carbonyl (navegador no terminal)" [chrome-libs]="bibliotecas do Chrome e do Carbonyl"
  [clipboard]="área de transferência (wl-clipboard/xclip)" [notificacoes]="notificações da área de trabalho (notify-send)"
  [xdg-utils]="abrir links no navegador do sistema (xdg-utils)" [termux-api]="Termux:API" [pv]="barra de progresso das transferências (pv)" [mosh]="mosh (acesso pelo celular)" [nomeador-local]="nomeador local de abas")
pend_avaliar() {
  pacotes_lib || return 1
  local id=$1 v vc cli
  P_APLICA=1; P_NIVEL=recurso; P_SYS=""; P_USR=0; P_ADM=0; P_ADM_CMD=""; P_MANUAL=""; P_ROTULO=${PEND_ROTULOS[$id]:-$id}; P_MOTIVO=""; P_TAM=""; P_FALTAM=""
  case $id in
    nucleo)
      P_NIVEL=essencial; P_ROTULO="ferramentas básicas"
      P_MOTIVO="o tt precisa delas para funcionar (central, painéis, sincronização e atualização)"
      P_SYS=$(pend_faltam bash tmux fzf python3 ssh tar rg git curl) ;;
    fzf-novo)
      P_NIVEL=essencial; P_ROTULO="fzf atual"; P_TAM="~4 MB"
      v=${TT_FINGE_FZF_VERSAO:-$(versao_de fzf --version)}
      if falta_cmd fzf || ! versao_menor "$v" "$FZF_MINIMO" || ! fzf_asset >/dev/null; then P_APLICA=0; return 0; fi
      P_MOTIVO="o fzf daqui é o $v; a central e os menus pedem o $FZF_MINIMO ou mais novo (baixo o oficial para a sua pasta)"
      P_USR=1; P_SYS=$(pend_faltam curl tar) ;;
    tmux-antigo)
      P_NIVEL=essencial; P_ROTULO="tmux atual"
      v=${TT_FINGE_TMUX_VERSAO:-$(versao_de tmux -V)}
      if falta_cmd tmux || ! versao_menor "$v" 3.4; then P_APLICA=0; return 0; fi
      P_MOTIVO="o tmux daqui é o $v; popups, barra e mouse do tt pedem o 3.4 ou mais novo"
      P_MANUAL="atualize o tmux pelo gerenciador de pacotes ou compile a versão 3.4+ (Debian/Ubuntu antigos: backports ou PPA)" ;;
    tmux-novo)
      # O painel de tarefas flutuante (clica fora e fecha) e outros recursos pedem o tmux 3.8. Os pacotes das
      # distribuições ficam no 3.5/3.6, então o tt compila o 3.8 na pasta do usuário (sem tocar no sistema).
      P_NIVEL=recurso; P_ROTULO="tmux $TMUX_ALVO"; P_TAM="~1 MB"
      v=${TT_FINGE_TMUX_VERSAO:-$(versao_de tmux -V)}
      # O tmux do PATH acompanha o servidor em execução (tmux_alinhar) e fica no 3.6 até o servidor reiniciar,
      # mesmo com o 3.8 já compilado em DIR_TMUX: sem esta conferência a pendência nunca fechava ("ainda falta").
      if [[ -z ${TT_FINGE_TMUX_VERSAO:-} && -x $DIR_TMUX/bin/tmux ]]; then
        vc=$(versao_de "$DIR_TMUX/bin/tmux" -V); versao_menor "$vc" "$TMUX_ALVO" || v=$vc
      fi
      if falta_cmd tmux || versao_menor "$v" 3.4 || ! versao_menor "$v" "$TMUX_ALVO" || ! tmux_compilavel; then P_APLICA=0; return 0; fi
      P_MOTIVO="o tmux daqui é o $v; o $TMUX_ALVO traz o painel flutuante do tt (e correções). O tt o compila na sua pasta; as sessões abertas não são tocadas, vale no próximo servidor tmux"
      P_USR=1; tmux_deps_faltam && { P_SYS=tmux-build; P_FALTAM=$(tmux_deps_quais); } ;;
    email-aerc)
      cli=$(conf email); cli=${cli%% *}
      [[ -z $cli || ${cli##*/} == aerc ]] || { P_APLICA=0; return 0; }
      # Com conta cadastrada o e-mail está em uso (recurso); sem conta é só conforto (opcional, e o botão 📧 oferece na hora).
      tem_conta_email || P_NIVEL=opcional
      P_ROTULO="aerc (cliente de e-mail)"; P_MOTIVO="abre o e-mail do 📧; sem ele o botão só avisa que falta"
      P_SYS=$(pend_faltam aerc) ;;
    email-sync)
      tem_conta_email || { P_APLICA=0; return 0; }
      P_ROTULO="mbsync (isync)"; P_MOTIVO="sync local do e-mail: espelho offline, abre na hora e funciona sem rede"
      mbsync_presente || P_SYS=mbsync ;;
    isync-sasl)
      xoauth2_necessario && mbsync_presente || { P_APLICA=0; return 0; }
      P_ROTULO="isync com SASL"; P_TAM="~1 MB"
      P_MOTIVO="o mbsync daqui foi compilado sem LibSASL e não entra por OAuth (conta Google); o tt compila um com SASL na sua pasta"
      mbsync_tem_sasl && return 0
      P_USR=1; isync_deps_faltam && P_SYS=isync-build ;;
    email-xoauth2)
      xoauth2_necessario || { P_APLICA=0; return 0; }
      P_ROTULO="plugin XOAUTH2 do SASL"
      P_MOTIVO="contas de e-mail com login OAuth (Google) só sincronizam com o plugin XOAUTH2 do SASL; o tt o compila (4 arquivos C, ~1 s) na sua pasta, sem tocar no sistema"
      xoauth2_presente && return 0
      P_USR=1; xoauth2_deps_faltam && P_SYS="xoauth2-build $(pend_faltam curl)"; P_SYS=${P_SYS% } ;;
    email-espelho)
      # Toda conta IMAP com espelho local: é dele que saem as demandas e tarefas recebidas por e-mail. Não aceita
      # "nunca" (PEND_SEMPRE); o mbsync e, para contas OAuth, o SASL/XOAUTH2 entram como pré-requisitos.
      v=$(email_sem_espelho | paste -sd, - | sed 's/,/, /g')
      [[ -n $v ]] || { P_APLICA=0; return 0; }
      P_ROTULO="espelho local do e-mail ($v)"
      P_MOTIVO="sem ele os e-mails [tt] (tarefas e atualizações enviadas por e-mail) não chegam ao painel de tarefas, e o e-mail não abre offline"
      P_USR=1
      if ! mbsync_presente; then P_SYS=mbsync
      elif [[ -n $(email_sem_espelho oauth) ]]; then
        mbsync_tem_sasl || ! isync_deps_faltam || P_SYS=isync-build
        xoauth2_presente || ! xoauth2_deps_faltam || P_SYS="${P_SYS:+$P_SYS }xoauth2-build $(pend_faltam curl)"
        P_SYS=${P_SYS% }
      fi ;;
    email-html)
      tem_conta_email || { P_APLICA=0; return 0; }
      P_ROTULO="w3m"; P_MOTIVO="mostrar e-mails em HTML bem (tabelas, cores, links)"
      P_SYS=$(pend_faltam w3m) ;;
    email-editor)
      tem_conta_email || { P_APLICA=0; return 0; }
      P_ROTULO="vim"; P_MOTIVO="escrever e-mails no editor padronizado do tt (largura certa, ortografia em português)"
      P_SYS=$(pend_faltam vim) ;;
    email-spell)
      tem_conta_email && ! falta_cmd vim || { P_APLICA=0; return 0; }
      P_NIVEL=opcional; P_ROTULO="dicionário de português do vim"; P_TAM="~3 MB"
      P_MOTIVO="corretor ortográfico em português ao escrever e-mails"
      email_vim_spell_tem && return 0
      P_USR=1; P_SYS=$(pend_faltam curl) ;;
    chrome)
      navegadores_graficos_ok && ambiente_grafico && [[ -z ${TT_PEND_SEM_NAVEGADORES:-} ]] || { P_APLICA=0; return 0; }
      P_ROTULO="Google Chrome interno"; P_TAM=$CHROME_TAM
      P_MOTIVO="abre os links do e-mail e do terminal numa janela gráfica (baixado para ~/.local/share/tt-navegadores, sem sudo)"
      [[ -x $(bin_chromium) ]] && return 0
      P_USR=1; P_SYS=$(pend_faltam curl) ;;
    carbonyl)
      navegadores_graficos_ok && [[ -z ${TT_PEND_SEM_NAVEGADORES:-} ]] || { P_APLICA=0; return 0; }
      P_ROTULO="Carbonyl (navegador no terminal)"; P_TAM=$CARBONYL_TAM
      P_MOTIVO="abre os links dentro do próprio terminal, sem janela gráfica (baixado para ~/.local/share/tt-navegadores, sem sudo)"
      [[ -x $(bin_carbonyl) ]] && return 0
      P_USR=1; P_SYS=$(pend_faltam curl unzip) ;;
    chrome-libs)
      # Onde o tt não baixa Chrome/Carbonyl (Termux, ARM, musl), um download antigo esquecido não vira pendência sem pacote.
      navegadores_graficos_ok || [[ -n ${TT_FINGE_CHROME_LIBS:-}${TT_FINGE_CHROME_LIBS_ARQ:-} ]] || { P_APLICA=0; return 0; }
      [[ -x $(bin_chromium) || -x $(bin_carbonyl) || -n ${TT_FINGE_CHROME_LIBS:-}${TT_FINGE_CHROME_LIBS_ARQ:-} ]] || { P_APLICA=0; return 0; }
      P_ROTULO="bibliotecas do Chrome e do Carbonyl"
      P_MOTIVO="bibliotecas do sistema sem as quais o Chrome e o Carbonyl baixados não abrem"
      P_SYS=$(chrome_libs_faltando) ;;
    clipboard)
      [[ $(pk_so) == linux && $(pk_ambiente) == nativo ]] && ambiente_grafico || { P_APLICA=0; return 0; }
      P_NIVEL=opcional; P_ROTULO="área de transferência (wl-clipboard/xclip)"
      P_MOTIVO="copiar do tt para a área de transferência do sistema (sem isso a cópia vai só pelo terminal, OSC 52)"
      falta_cmd wl-copy && falta_cmd xclip || return 0
      if [[ -n ${WAYLAND_DISPLAY:-} ]]; then P_SYS=wl-copy; else P_SYS=xclip; fi ;;
    notificacoes)
      [[ $(pk_so) == linux && $(pk_ambiente) == nativo ]] && ambiente_grafico || { P_APLICA=0; return 0; }
      P_NIVEL=opcional; P_ROTULO="notificações da área de trabalho (notify-send)"
      P_MOTIVO="avisos do tt (e-mail novo, tarefas, agentes) como notificação do sistema"
      P_SYS=$(pend_faltam notify-send) ;;
    xdg-utils)
      [[ $(pk_so) == linux && $(pk_ambiente) == nativo ]] && ambiente_grafico || { P_APLICA=0; return 0; }
      P_NIVEL=opcional; P_ROTULO=${PEND_ROTULOS[xdg-utils]}; P_MOTIVO="abrir links no navegador padrão do sistema"
      P_SYS=$(pend_faltam xdg-open) ;;
    termux-api)
      [[ $(pk_ambiente) == termux ]] || { P_APLICA=0; return 0; }
      P_ROTULO="Termux:API"; P_MOTIVO="notificações, área de transferência e abrir links no celular (precisa também do app Termux:API instalado no Android)"
      falta_cmd termux-notification && P_SYS=termux-api ;;
    pv)
      P_NIVEL=opcional; P_ROTULO=${PEND_ROTULOS[pv]}; P_MOTIVO="barra de progresso nas transferências de arquivos entre máquinas"
      P_SYS=$(pend_faltam pv) ;;
    mosh)
      P_NIVEL=opcional; P_ROTULO=${PEND_ROTULOS[mosh]}; P_MOTIVO="entrar nesta máquina pelo celular sem a conexão cair (mosh)"
      P_SYS=$(pend_faltam mosh) ;;
    sudo-sem-senha)
      [[ -n ${TT_PEND_SEM_SUDO_SEM_SENHA:-} ]] && { P_APLICA=0; return 0; } # testes
      # Passo de administrador que não é pacote (P_ADM): uma regra em /etc/sudoers.d/ deixa o sudo deste usuário sem
      # senha. Com ela, o tt e os agentes ligam o ssh, instalam pendências e corrigem a máquina sozinhos.
      [[ ${PREFIX:-} == *com.termux* || $(id -u) == 0 ]] && { P_APLICA=0; return 0; }
      [[ -n ${TT_SUDO_BIN:-} ]] || tem_cmd sudo || { P_APLICA=0; return 0; }
      "${TT_SUDO_BIN:-sudo}" -n true 2>/dev/null && return 0
      P_NIVEL=recurso; P_ROTULO="sudo sem senha"
      P_MOTIVO="o tt e os agentes ligam o ssh, instalam pendências e corrigem esta máquina sozinhos, sem pedir a senha"
      P_ADM=1; P_ADM_CMD="sudo install -m 0440 <regra> $(sudoers_arquivo)   (regra: $(id -un) ALL=(ALL) NOPASSWD: ALL, conferida pelo visudo)" ;;
    sshd)
      # Máquina numa malha precisa aceitar conexão; o tt sobe o sshd sozinho (sshd_garantir), mas precisa do programa.
      [[ -s $CONF_MAQ && ${PREFIX:-} != *com.termux* ]] || { P_APLICA=0; return 0; }
      sshd_bin >/dev/null && return 0
      P_NIVEL=essencial; P_ROTULO="servidor ssh (openssh-server)"
      P_MOTIVO="sem ele as outras máquinas não alcançam esta (ilha na malha); o tt o liga sozinho depois"
      P_SYS=sshd ;;
    nomeador-local)
      [[ $(conf nomeador) == local ]] || { P_APLICA=0; return 0; }
      P_ROTULO="nomeador local de abas"; P_TAM="1–2,5 GB"
      P_MOTIVO="você escolheu o nomeador local (modelo que roda só aqui); falta baixar o motor e o modelo"
      [[ $(python3 -I "$DIR_TT/nomeador-local.py" estado 2>/dev/null | sed -n 's/^instalado=//p') == 1 ]] && return 0
      P_USR=1; P_SYS=$(pend_faltam curl) ;;
    *) P_APLICA=0 ;;
  esac
  return 0
}

pend_rotulo() { # id → nome para mostrar
  pend_avaliar "$1" 2>/dev/null; echo "$P_ROTULO"
}

pend_estado() { # id → na | ok | falta | manual
  pend_avaliar "$1" || { echo na; return; }
  ((P_APLICA)) || { echo na; return; }
  [[ -n $P_MANUAL ]] && { echo manual; return; }
  [[ -n $P_SYS || $P_USR == 1 || $P_ADM == 1 ]] && echo falta || echo ok
}

# Lista as pendências desta máquina, uma por linha: id<TAB>itens do gerenciador (ou -)<TAB>motivo<TAB>tipo
# (sistema|usuario|misto|admin: passo de administrador que não é pacote, P_ADM)<TAB>nível. Sem argumentos: essencial e recurso, fora as recusadas há menos de 7
# dias, as adiadas ("mais tarde", 1 dia) e as que ele pediu para nunca mais avisar. Com ids ou
# TT_PEND_TODAS=1 (menu administrar): inclusive opcionais, SEM olhar a recusa. O que o tt não resolve
# sozinho (P_MANUAL) só aparece em `tt --pendencias`.
sudo_pendencias() {
  local -a so=("$@"); local id c tipo achou
  pacotes_lib || return 0
  for id in "${PEND_IDS[@]}"; do
    if ((${#so[@]})); then
      achou=0; for c in "${so[@]}"; do [[ $c == "$id" ]] && achou=1; done
      ((achou)) || continue
    fi
    pend_avaliar "$id" || continue
    ((P_APLICA)) || continue
    [[ -n $P_MANUAL ]] && continue
    [[ -n $P_SYS || $P_USR == 1 || $P_ADM == 1 ]] || continue
    if ((${#so[@]} == 0)) && [[ -z ${TT_PEND_TODAS:-} ]]; then
      [[ $P_NIVEL == opcional ]] && continue
      pend_recusado "$id" && continue
    fi
    if [[ -n $P_SYS && $P_USR == 1 ]]; then tipo=misto; elif [[ -n $P_SYS ]]; then tipo=sistema; elif [[ $P_ADM == 1 ]]; then tipo=admin; else tipo=usuario; fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$id" "${P_SYS:--}" "$P_MOTIVO" "$tipo" "$P_NIVEL"
  done
}

# Executa o passo sem administrador de uma pendência.
pend_usuario_instalar() {
  case $1 in
    chrome) navegador_instalar chromium ;;
    carbonyl) navegador_instalar carbonyl ;;
    email-xoauth2) xoauth2_construir ;;
    isync-sasl) isync_sasl_construir ;;
    email-spell) email_vim_spell_garantir ;;
    email-espelho) email_espelho_ligar ;;
    fzf-novo) fzf_instalar ;;
    tmux-novo) tmux_construir ;;
    nomeador-local) python3 -I "$DIR_TT/nomeador-local.py" instalar auto ;;
    *) return 0 ;;
  esac
}

# pend_instalar GER PRIV linha… — instala o que as linhas (da sudo_pendencias) pedem: primeiro os pacotes
# do gerenciador (de uma vez, com recuperação por pacote), depois os passos da pasta do usuário e, se
# baixou navegador, as bibliotecas que ele pede. Confere o resultado e devolve 0 só se tudo ficou certo.
pend_instalar() {
  local ger=$1 priv=$2; shift 2
  local l c id itens="" rc=0 nome p
  local -a ids=() ruins=()
  for l in "$@"; do
    id=${l%%$'\t'*}; ids+=("$id")
    c=$(cut -f2 <<<"$l"); [[ $c != - ]] && itens+=" $c"
  done
  # 1) pacotes do gerenciador
  if [[ -n ${itens// /} ]]; then
    if [[ -z $ger ]]; then
      echo "  ✗ Não achei um gerenciador de pacotes. Instale à mão:${itens}"; rc=1
    elif [[ $priv == indisponivel ]]; then
      pend_resolver "$ger" $itens
      echo "  ✗ Não achei sudo, doas nem su, e você não é administrador. Peça a quem administra, ou rode como root:"
      echo "      $(pk_comando_texto "$ger" nenhum ${PK_PACOTES[@]+"${PK_PACOTES[@]}"})"; rc=1
    else
      pend_resolver "$ger" $itens
      ((${#PK_SEM_PACOTE[@]})) && echo "  ⚠ Sem pacote em $ger para: ${PK_SEM_PACOTE[*]} (instale por outro meio)."
      if ((${#PK_PACOTES[@]})); then
        pk_instalar "$ger" "$priv" "${PK_PACOTES[@]}" || {
          rc=1; ((${#PK_FALHOS[@]})) && echo "  ✗ Não instalou: ${PK_FALHOS[*]}"
          case $PK_MOTIVO in
            permissao) echo "    (sem permissão: senha errada ou você não pode usar $priv)" ;;
            rede) echo "    (sem rede, ou o repositório não respondeu)" ;;
            indice_ou_nome) echo "    (o repositório desta distro não tem esse pacote)" ;;
          esac
        }
      fi
    fi
  fi
  # 1b) passos de administrador que não são pacote (P_ADM): o sudo pede a senha aqui, no terminal do modal
  for id in "${ids[@]}"; do
    pend_avaliar "$id" || continue
    ((P_APLICA)) && [[ $P_ADM == 1 ]] || continue
    echo "  → $P_ROTULO"
    case $id in sudo-sem-senha) sudo_sem_senha_ativar || rc=1 ;; esac
  done
  # 2) passos sem administrador (o pré-requisito pode ter acabado de chegar)
  for id in "${ids[@]}"; do
    pend_avaliar "$id" || continue
    ((P_APLICA)) && [[ $P_USR == 1 ]] || continue
    if [[ -n $P_SYS ]]; then
      echo "  ✗ $P_ROTULO: ainda faltam ferramentas (${P_FALTAM:-$P_SYS})."; pk_log "$P_ROTULO: ainda faltam ferramentas (${P_FALTAM:-$P_SYS})"; continue
    fi
    echo "  → $P_ROTULO${P_TAM:+ ($P_TAM)}"
    pend_usuario_instalar "$id" || rc=1
  done
  # 3) navegador baixado agora: instala as bibliotecas que ele pede
  case " ${ids[*]} " in *" chrome "*|*" carbonyl "*)
    case " ${ids[*]} " in *" chrome-libs "*) ;; *)
      p=$(chrome_libs_faltando)
      if [[ -n $p && -n $ger && $priv != indisponivel ]]; then
        echo "  → bibliotecas do navegador: $p"
        pend_resolver "$ger" $p
        ((${#PK_PACOTES[@]})) && { pk_instalar "$ger" "$priv" "${PK_PACOTES[@]}" || rc=1; }
      fi ;;
    esac ;;
  esac
  # 4) confere
  echo
  for id in "${ids[@]}"; do
    pend_avaliar "$id" || continue
    nome=$P_ROTULO
    if ! ((P_APLICA)) || { [[ -z $P_SYS && $P_USR != 1 && $P_ADM != 1 ]]; }; then printf '  \033[32m✓\033[0m %s\n' "$nome"
    else
      printf '  \033[31m✗\033[0m %s — ainda falta\n' "$nome"; ruins+=("$id"); rc=1
    fi
  done
  # O que falhou não volta a incomodar toda hora: o aviso espera uma semana (ou o menu reabre na hora).
  for id in ${ruins[@]+"${ruins[@]}"}; do sudo_recusa_gravar "$id" semana; done
  ((${#ruins[@]})) && echo "  (Detalhes em ${PK_LOG/#"$HOME"/"~"}. Aviso desta pendência volta em 7 dias; o menu administrar → 📦 reabre na hora.)"
  return $rc
}

# Pendência "sudo sem senha": a regra fica num arquivo próprio em /etc/sudoers.d/ (o nome não pode ter ponto, ou o
# sudo o ignora), conferida pelo visudo antes de entrar (uma regra quebrada travaria o sudo de vez) e com modo 0440.
# Desfazer: sudo rm o arquivo. TT_SUDOERS_DIR e TT_SUDO_BIN só para os testes.
sudoers_arquivo() { local u; u=$(id -un); printf '%s/tt-sem-senha-%s' "${TT_SUDOERS_DIR:-/etc/sudoers.d}" "${u//[^A-Za-z0-9_-]/_}"; }
sudo_sem_senha_ativar() {
  local s=${TT_SUDO_BIN:-sudo} u tmp f
  u=$(id -un); f=$(sudoers_arquivo)
  tmp=$(mktemp) || return 1
  printf '# Gerado pelo tt (pendência "sudo sem senha"): %s usa o sudo sem senha. Desfazer: sudo rm %s\n%s ALL=(ALL) NOPASSWD: ALL\n' "$u" "$f" "$u" >"$tmp"
  chmod 0440 "$tmp"
  if ! "$s" visudo -cf "$tmp" >/dev/null 2>&1; then echo "  ✗ o visudo recusou a regra; nada foi gravado."; rm -f "$tmp"; return 1; fi
  # O grupo do root é "root" no Linux e "wheel" no macOS (lá não existe grupo "root").
  if ! "$s" install -m 0440 -o root -g "$(id -gn root 2>/dev/null || echo root)" "$tmp" "$f"; then echo "  ✗ não consegui gravar $f (senha errada, ou o install recusou: veja a mensagem acima)."; rm -f "$tmp"; return 1; fi
  rm -f "$tmp"
  if "$s" -n true 2>/dev/null; then echo "  ✓ sudo sem senha ativo (regra em $f)"; pk_log "sudo sem senha: regra gravada em $f"; return 0; fi
  echo "  ✗ a regra foi gravada em $f, mas o sudo ainda pede senha (o /etc/sudoers inclui /etc/sudoers.d?)."; return 1
}

# tt --pedir-sudo [--sim] [id…]: o modal. Mostra as pendências (o quê, por quê, o comando exato) e oferece
# [i] instalar agora, [s] selecionar, [m] mais tarde, [n] não instalar (e não avisar mais). Só então roda o
# sudo NO PRÓPRIO terminal do modal, onde ele pede a senha: o tt nunca lê, guarda nem registra a senha.
# --sim aceita tudo sem perguntar (scripts, IA). TT_TTY troca o terminal de leitura (testes).
pedir_sudo_pendencias() {
  pacotes_lib || return 1
  local sim=0; [[ ${1:-} == --sim ]] && { sim=1; shift; }
  local tty=${TT_TTY:-/dev/tty} fd r ger priv lista id cmds motivo tipo nivel rot
  # --sim roda também sem terminal (ssh sem -t, agente de IA): a leitura vem do vazio; o sudo, se pedir senha, falha com clareza.
  if ((sim)) && ! ( : </dev/tty ) 2>/dev/null && [[ -z ${TT_TTY:-} ]]; then tty=/dev/null; fi
  local -a escolhidos=() adiados=() nuncas=() sis=() usu=() adm=()
  lista=$(sudo_pendencias "$@")
  if [[ -z $lista ]]; then
    echo "Nada pendente de instalação."
    if [[ -t 1 ]] && ((!sim)); then   # num popup: segura a mensagem em vez de piscar e fechar
      local ocultas=0; [[ -z ${TT_PEND_TODAS:-} ]] && ocultas=$(TT_PEND_TODAS=1 sudo_pendencias | wc -l)
      printf '\n  \033[1;32m✓ Tudo em ordem\033[0m — nenhuma pendência de instalação nesta máquina.\n'
      ((ocultas)) && printf '  (%s adiada(s), recusada(s) ou opcional(is): menu administrar → 📦 Pendências de instalação as reabre.)\n' "$ocultas"
      read -rsn1 -p $'\n  (qualquer tecla fecha)' <"$tty"; echo
    fi
    return 0
  fi
  ger=$(pk_gerenciador 2>/dev/null) || ger=""
  priv=$(pk_privilegio "$ger" 2>/dev/null)
  ((sim)) || { exec {fd}<"$tty" || return 1; }
  if [[ $priv == sudo || $priv == doas || $priv == su ]]; then printf '\n  \033[1;33m🔐 O tt precisa de permissão de administrador\033[0m\n'
  else printf '\n  \033[1;33m📦 O tt quer instalar uns pacotes\033[0m\n'; fi
  printf '  \033[2m%s\033[0m\n\n' "$(pk_resumo)"
  printf '  Pendências nesta máquina:\n'
  while IFS=$'\t' read -r id cmds motivo tipo nivel; do
    pend_avaliar "$id"; rot=$P_ROTULO
    printf '   • \033[1m%s\033[0m — %s\n' "$rot" "$motivo"
    [[ $cmds != - ]] && sis+=($cmds)
    [[ $tipo == usuario || $tipo == misto ]] && usu+=("$rot${P_TAM:+ ($P_TAM)}")
    [[ $P_ADM == 1 ]] && adm+=("$P_ADM_CMD")
  done <<<"$lista"
  if ((${#sis[@]})); then
    pend_resolver "${ger:-apt-get}" "${sis[@]}"
    if [[ -n $ger ]]; then
      printf '\n  Do gerenciador de pacotes:  \033[36m%s\033[0m\n' "$(pk_comando_texto "$ger" "$priv" ${PK_PACOTES[@]+"${PK_PACOTES[@]}"})"
      ((${#PK_SEM_PACOTE[@]})) && printf '  \033[33m⚠ sem pacote em %s para: %s\033[0m\n' "$ger" "${PK_SEM_PACOTE[*]}"
      [[ $priv == indisponivel ]] && printf '  \033[33m⚠ sem sudo/doas/su e você não é administrador: o comando acima terá de ser rodado por quem pode.\033[0m\n'
    else printf '\n  \033[33m⚠ Não achei um gerenciador de pacotes; instale à mão: %s\033[0m\n' "${sis[*]}"; fi
  fi
  ((${#adm[@]})) && printf '\n  Configuração do sistema:  \033[36m%s\033[0m\n' "${adm[@]}"
  ((${#usu[@]})) && { printf '  Baixado/compilado na sua pasta (sem administrador):  '; printf '%s; ' "${usu[@]}" | sed 's/; $//'; echo; }
  [[ $priv == sudo || $priv == doas || $priv == su ]] && printf '\n  A senha é pedida pelo próprio %s, aqui; o tt não a vê nem a guarda.\n' "$priv"
  for id in $(cut -f1 <<<"$lista"); do
    pend_sempre "$id" && printf '  \033[33m⚠ %s não pode ser recusado de vez: "não" vale como "mais tarde" e pergunto de novo amanhã.\033[0m\n' "$(pend_rotulo "$id")"
  done
  echo
  if ((sim)); then r=i
  else read -r -n1 -u "$fd" -p '  [i] Instalar agora   [s] Selecionar   [m] Mais tarde   [n] Não instalar (e não avisar mais)  ' r || r=m; echo; fi
  case $r in
    i|I|a|A) mapfile -t escolhidos <<<"$lista" ;;
    s|S)
      while IFS=$'\t' read -r id cmds motivo tipo nivel; do
        read -r -n1 -u "$fd" -p "  $(pend_rotulo "$id") — [i] instalar  [m] mais tarde  [n] não instalar: " r || r=m; echo
        case $r in
          i|I|s|S|y|Y) escolhidos+=("$id"$'\t'"$cmds"$'\t'"$motivo"$'\t'"$tipo"$'\t'"$nivel") ;;
          n|N) nuncas+=("$id") ;;
          *) adiados+=("$id") ;;
        esac
      done <<<"$lista" ;;
    n|N|r|R) mapfile -t nuncas <<<"$(cut -f1 <<<"$lista")" ;;
    *) mapfile -t adiados <<<"$(cut -f1 <<<"$lista")" ;;   # Enter, Esc, qualquer outra: mais tarde
  esac
  local -a nuncas_ok=()   # as obrigatórias (PEND_SEMPRE) saem do "nunca" e viram "mais tarde"
  for id in ${nuncas[@]+"${nuncas[@]}"}; do if pend_sempre "$id"; then adiados+=("$id"); else nuncas_ok+=("$id"); fi; done
  nuncas=(${nuncas_ok[@]+"${nuncas_ok[@]}"})
  for id in ${adiados[@]+"${adiados[@]}"}; do sudo_recusa_gravar "$id" tarde; done
  for id in ${nuncas[@]+"${nuncas[@]}"}; do sudo_recusa_gravar "$id" nunca; done
  for id in $(printf '%s\n' ${escolhidos[@]+"${escolhidos[@]}"} | cut -f1); do rm -f "$(sudo_recusa_arq "$id")"; done
  ((${#adiados[@]})) && echo "  Ok. Pergunto de novo amanhã."
  ((${#nuncas[@]})) && echo "  Ok. Não aviso mais. Para voltar atrás: menu administrar → 📦 Pendências de instalação."
  ((${#escolhidos[@]})) || { ((sim)) || exec {fd}<&-; sleep 1; return 1; }
  local rc=0 trava=$ESTADO_DIR/pendencias.trava pegou=0
  mkdir -p "$ESTADO_DIR"
  # Uma instalação por vez (o vigia, um popup esquecido e este modal não podem brigar pela trava do dpkg).
  # Trava com mais de 1 h é de uma instalação que morreu: vale tomá-la.
  if mkdir "$trava" 2>/dev/null; then pegou=1
  elif [[ -n $(find "$trava" -maxdepth 0 -mmin +60 2>/dev/null) ]] && rm -rf "$trava" && mkdir "$trava" 2>/dev/null; then pegou=1; fi
  ((pegou)) || { echo "  Já há uma instalação em andamento; tente de novo daqui a pouco."; ((sim)) || exec {fd}<&-; return 1; }
  # Diagnóstico e proteção: se o terminal do modal fechar (SIGHUP) no meio, o apt/dpkg não pode morrer pela
  # metade; o motivo de qualquer sinal fica em pendencias.log (antes o modal sumia sem deixar rastro).
  # O trap daqui só registra: um sinal com trap volta ao padrão no processo filho, então o apt morreria do
  # mesmo jeito. Quem protege é o subshell abaixo, que IGNORA o HUP (ignorado passa ao apt e ao sudo).
  trap 'pk_log "modal: SIGHUP (o terminal fechou); a instalação continua"' HUP
  trap 'pk_log "modal: SIGTERM"; rmdir "$trava" 2>/dev/null; exit 143' TERM
  trap 'pk_log "modal: SIGINT (Ctrl+C)"; rmdir "$trava" 2>/dev/null; exit 130' INT
  trap 'pk_log "modal: SIGPIPE (a saída fechou)"' PIPE
  (trap '' HUP; pend_instalar "$ger" "$priv" "${escolhidos[@]}") <"${tty}" || rc=$?
  pk_log "modal: instalação terminou (rc=$rc)"
  trap - HUP TERM INT PIPE
  rmdir "$trava" 2>/dev/null
  ((sim)) || exec {fd}<&-
  if ((rc == 0)); then echo "  ✓ Pronto."; ((sim)) || sleep 1
  elif ((!sim)); then   # a mensagem de erro fica na tela até uma tecla (o popup fechava sozinho em 1 s e escondia o motivo)
    echo "  ✗ Nem tudo ficou pronto. A saída do comando está acima."
    read -rsn1 -p '  (qualquer tecla fecha)' <"$tty"; echo
  fi
  return $rc
}

# tt --pendencias [--tsv]: o estado de TUDO que o tt pode precisar nesta máquina, instalado ou não.
pendencias_status() {
  pacotes_lib || return 1
  local tsv=0 id est mark cor; [[ ${1:-} == --tsv ]] && tsv=1
  ((tsv)) || printf '\n  \033[1m📦 Pendências de instalação\033[0m\n  \033[2m%s\033[0m\n\n' "$(pk_resumo)"
  for id in "${PEND_IDS[@]}"; do
    pend_avaliar "$id"
    if ! ((P_APLICA)); then est=na
    elif [[ -n $P_MANUAL ]]; then est=manual
    elif [[ -n $P_SYS || $P_USR == 1 || $P_ADM == 1 ]]; then est=falta
    else est=ok; fi
    if ((tsv)); then printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$est" "$P_NIVEL" "$P_ROTULO" "${P_MANUAL:-${P_SYS:--}}"; continue; fi
    case $est in
      ok) mark="✓"; cor=32 ;;
      falta) mark="✗"; cor=31 ;;
      manual) mark="!"; cor=33 ;;
    esac
    case $est in
      na) printf '  \033[2m– %-46s não se aplica a esta máquina\033[0m\n' "$P_ROTULO" ;;
      *)
        printf '  \033[%sm%s\033[0m %-46s \033[2m%s\033[0m\n' "$cor" "$mark" "$P_ROTULO" "$P_NIVEL"
        [[ $est == falta ]] && printf '      \033[2m%s%s\033[0m\n' "${P_SYS:+precisa: $P_SYS  }" "${P_TAM:+(baixa $P_TAM)}"
        [[ $est == manual ]] && printf '      \033[33m%s\033[0m\n' "$P_MANUAL" ;;
    esac
  done
  ((tsv)) && return 0
  printf '\n  Para instalar o que falta:  tt --pedir-sudo   (ou menu administrar → 📦)\n  Tudo de uma vez, sem perguntar:  tt --pedir-sudo --sim\n\n'
}

# --- Novidades do tt ---------------------------------------------------------------------------
# NOVIDADES.md (no pacote) tem uma seção "## vN · data" por versão, escrita para quem usa o tt, não
# para quem programa. `tt --novidades` mostra o que saiu desde a última versão vista (ou --todas);
# o vigia avisa uma vez por versão nova, e o clique no aviso abre esta tela.
novidades_visto() { cat "$ESTADO_DIR/novidades-visto" 2>/dev/null || echo 0; }

# Versão do título mais novo (o 1º "## v…") do NOVIDADES.md. É ela, e não o rótulo instalado, que `novidades-visto` guarda: o rótulo
# sai da contagem de commits da main e quem publica ao mesmo tempo o faz andar sem entrada no NOVIDADES.md; os títulos podem ficar
# abaixo do rótulo instalado, e aí nada contava como novo (a tela caía em "as 3 mais recentes" e o aviso nunca saía).
novidades_topo() { awk '/^## v/ { n = $2; sub(/^v/, "", n); print n; exit }' "${1:-$DIR_TT/NOVIDADES.md}" 2>/dev/null; }

# Seções novas desde o que foi visto, da mais nova para a mais velha. Se o marcador é o título de uma seção ("## v2.0.9"), são as que estão
# ACIMA dela no arquivo (a ordem do arquivo não depende de número nenhum). Senão (rótulo ou nº de commits de um estado antigo, 0 = tudo),
# as de versão MAIOR (a chave de versao_chave); título "## v1.7.0": a ordem vem dos três números.
novidades_texto() { # desde (título, rótulo ou nº antigo; 0 = tudo) -> seções
  local arq=${2:-$DIR_TT/NOVIDADES.md}
  awk -v desde="$(versao_chave "$1")" -v marca="$1" '
    NR == FNR { if ($0 ~ /^## v/) { n = $2; sub(/^v/, "", n); if (n == marca) existe = 1 } next }
    /^## v/ { n = $2; sub(/^v/, "", n)
      if (existe) { if (n == marca) parou = 1; mostra = !parou }
      else { m = split(n, a, "."); v = (m == 3) ? a[1] * 1e10 + a[2] * 1e6 + a[3] : 0; mostra = (v > desde + 0) } }
    /^# / && !/^## / { next }
    mostra { print }' "$arq" "$arq" 2>/dev/null
}

# O Markdown do NOVIDADES.md para o terminal: **negrito** em negrito, `código` em ciano (sem as crases),
# títulos ## e ###, itens "- " por nível (•, ◦, ▪), listas numeradas e [texto](link). Quebra as linhas na
# largura dada (no máximo 100 colunas, para a leitura não virar uma faixa) com o recuo alinhado ao texto do
# item; emoji e ideogramas contam 2 colunas. Lê o Markdown no stdin. Sem python3, o desenho simples de antes.
novidades_fmt() { # [largura]
  local w=${1:-80}
  [[ $w =~ ^[0-9]+$ ]] || w=80
  if ! command -v python3 >/dev/null 2>&1; then
    sed -e 's/^## \(.*\)$/\x1b[1;33m\1\x1b[0m/' -e 's/^- /  • /'
    return 0
  fi
  python3 -I -c '
import re, sys, unicodedata
W = max(30, min(int(sys.argv[1]), 100))
TOK = re.compile(r"\*\*(?P<b>.+?)\*\*|`(?P<c>[^`]+)`|\[(?P<lt>[^\]]+)\]\((?P<lu>[^)\s]+)\)")
SGR = {"b": "1", "c": "36", "u": "4", "d": "2", "t": "1;33"}

def inline(s, est=()):
    out, pos = [], 0
    for m in TOK.finditer(s):
        if m.start() > pos:
            out.append((s[pos:m.start()], est))
        if m.group("b") is not None:
            out += inline(m.group("b"), est + ("b",))
        elif m.group("c") is not None:
            out.append((m.group("c"), est + ("c",)))
        else:
            out += inline(m.group("lt"), est + ("u",))
            out.append((" (" + m.group("lu") + ")", est + ("d",)))
        pos = m.end()
    if pos < len(s):
        out.append((s[pos:], est))
    return out

def larg(ch):
    if ch in "‍︎️" or unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in "WF" else 1

def palavras(segs):
    """[(palavra, [(texto, estilo)…]), …]: o espaço separa; o estilo vai junto de cada pedaço."""
    ps, atual = [], []
    for txt, est in segs:
        for i, parte in enumerate(re.split(r"( +)", txt)):
            if not parte:
                continue
            if parte.startswith(" "):
                if atual:
                    ps.append(atual); atual = []
            else:
                atual.append((parte, est))
    if atual:
        ps.append(atual)
    return ps

def pinta(pedacos):
    s, ant = "", ()
    for txt, est in pedacos:
        if est != ant:
            s += "\033[0m" + ("\033[" + ";".join(SGR[e] for e in est) + "m" if est else "")
            ant = est
        s += txt
    return s + ("\033[0m" if ant else "")

def bloco(prefixo, recuo, segs):
    """Linhas de no máximo W colunas: a 1ª começa com o prefixo, as outras com o recuo."""
    linhas, atual, col = [], [], len(prefixo)
    lim = W
    for p in palavras(segs):
        lp = sum(larg(c) for t, _ in p for c in t)
        if atual and col + 1 + lp > lim:
            linhas.append(atual); atual, col = [], recuo
        if atual:
            # o espaço entre duas palavras do mesmo estilo (uma frase em negrito) fica no estilo delas
            atual.append((" ", p[0][1] if atual[-1][1] == p[0][1] else ())); col += 1
        atual += p; col += lp
    linhas.append(atual)
    out = []
    for i, l in enumerate(linhas):
        out.append((prefixo if i == 0 else " " * recuo) + pinta(l))
    return out

saida, primeira, pend = [], True, None

def fecha():
    """Despeja o item/parágrafo em montagem: as linhas de continuação já foram coladas no texto dele."""
    global pend
    if pend:
        saida.extend(bloco(pend[0], pend[1], inline(pend[2])))
        pend = None

for ln in sys.stdin.read().splitlines():
    ln = ln.rstrip()
    m = re.match(r"^(#{2,3}) +(.*)$", ln)
    if m:
        fecha()
        if not primeira and saida and saida[-1] != "":
            saida.append("")
        titulo = m.group(2)
        est = ("t",) if m.group(1) == "##" else ("b",)
        saida += bloco("  ", 2, [(t, est + e) for t, e in inline(titulo)])
        if m.group(1) == "##":
            saida.append("  \033[2m" + "─" * min(W - 4, sum(larg(c) for c in titulo) + 2) + "\033[0m")
        primeira = False
        continue
    if not ln.strip():
        fecha()
        if saida and saida[-1] != "":
            saida.append("")
        continue
    m = re.match(r"^( *)([-*+]|\d+[.)]) +(.*)$", ln)
    if m:
        fecha()
        nivel = len(m.group(1)) // 2
        marca = m.group(2) if m.group(2)[0].isdigit() else "•◦▪"[min(nivel, 2)]
        base = 2 + 2 * nivel
        pend = (" " * base + marca + " ", base + len(marca) + 1, m.group(3))
    elif pend:
        # linha de continuação do item (ou do parágrafo): cola no texto e quebra tudo junto
        pend = (pend[0], pend[1], pend[2] + " " + ln.strip())
    else:
        pend = ("  ", 2, ln.strip())
    primeira = False
fecha()
print("\n".join(saida))
' "$w"
}

novidades_ver() { # [--todas]
  local atual desde txt; atual=$(versao_disp)
  desde=$(novidades_visto)
  [[ ${2:-} == --todas ]] && desde=0
  txt=$(novidades_texto "$desde")
  if [[ -z $txt ]]; then
    # Nada novo desde a última vista: mostra as 3 versões mais recentes.
    txt=$(awk '/^## v/ { c++ } /^# / && !/^## / { next } c >= 1 && c <= 3 { print }' "$DIR_TT/NOVIDADES.md" 2>/dev/null)
  fi
  [[ -n $txt ]] || { echo "Sem novidades registradas."; return 0; }
  mkdir -p "$ESTADO_DIR"; echo "$(novidades_topo || true)" >"$ESTADO_DIR/novidades-visto"
  [[ -s $ESTADO_DIR/novidades-visto ]] || echo "$atual" >"$ESTADO_DIR/novidades-visto"
  if [[ -t 1 ]] && command -v less >/dev/null 2>&1; then
    # Sem -F: com pouco texto o less saía sozinho e o popup piscava e fechava. q ou Esc fecham.
    local w=""; { read -r _ w; } < <(stty size </dev/tty 2>/dev/null); [[ $w =~ ^[0-9]+$ ]] && ((w >= 20)) || w=$(tput cols 2>/dev/null)
    { novidades_fmt "$((${w:-80} - 1))" <<<"$txt"; printf '\n  \033[2m(q fecha · ↑↓ rolam)\033[0m\n'; } | LESSCHARSET=utf-8 less -R -P'novidades · q fecha' 2>/dev/null ||
      { printf '%s\n' "$txt"; read -rsn1 -p $'\n  (qualquer tecla fecha)' </dev/tty; echo; }
  else printf '%s\n' "$txt"; fi
}

# Vigia: uma vez por novidade nova (seção nova no NOVIDADES.md acima do último título visto), um aviso na faixa (clique abre).
# O código do aviso é o do título mais novo: o mesmo texto não vira vários avisos mesmo que o rótulo instalado ande com outros commits.
novidades_avisar() {
  local atual visto topo marca=$ESTADO_DIR/novidades-avisada; atual=$(versao_disp); topo=$(novidades_topo)
  [[ -n $topo ]] || return 0
  [[ $(cat "$marca" 2>/dev/null || echo 0) == "$topo" ]] && return 0
  mkdir -p "$ESTADO_DIR"
  visto=$(novidades_visto)
  [[ -n $(novidades_texto "$visto") ]] || return 0
  echo "$topo" >"$marca"
  # Máquina que acabou de ser instalada (nada visto): só marca; o aviso é para quem atualizou.
  [[ -f $ESTADO_DIR/novidades-visto ]] || { echo "$topo" >"$ESTADO_DIR/novidades-visto"; return 0; }
  # Código por título: cada máquina que se atualiza cria o seu aviso, e a rede guarda um só (o primeiro).
  notificar "📰 tt atualizado para a v$atual — veja o que há de novo (clique)" 3600 novidades "" "novidades-v$topo"
}

# --- Checagem pós-atualização (tt --checar, --checar-agente, --checar-handoff) ---------------------------
# Cada máquina, ao instalar uma versão nova, confere se o tt funciona aqui. O coletor (tt --checar, sem
# IA) roda as checagens de checagens-tt.md e diz o estado e a correção de cada uma. O vigia (checar_auto)
# lança então um agente pelo rotador (tt --checar-agente → ia-rot -p, na sessão oculta _tt-checagem), que
# investiga, CORRIGE o que é desta máquina, testa o que a versão trouxe (NOVIDADES.md) e escreve o
# relatório. Tudo fica num lugar só, ~/.local/state/tt/checagens/ (historico.log + uma pasta por rodada),
# e tt --checar-handoff empacota isso, sem segredos, para quem usa o tt entregar a quem o mantém.
CHECAGEM_DIR=$ESTADO_DIR/checagens
CHECAGEM_SESSAO=_tt-checagem
# O que a instalação ou o próprio tt geram dentro do pacote (não são arquivos do usuário largados lá).
CHECAGEM_GERADOS=" rapido html-tt sem-unshare vimrc-tt vimrc-tt-email w3m-keymap __pycache__ "

checar_linha() { printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "${4:--}"; } # id estado(ok|aviso|falha) resumo correção

# Uma linha por checagem (TSV). Só lê: nada aqui corrige, e uma checagem que falha não derruba as outras.
checar_coletar() {
  local agora pid cpu f x n m slug st erro d desde mot inst ativas
  local -a falta=() extra=() codigo=() lst=()
  local -A NO_PACOTE=() E=()
  printf -v agora '%(%s)T' -1

  # vigia: vivo, único e sem girar a CPU (o bug do wait sem pids o deixou horas a 100%)
  pid=$(cat "$RT/tt-vigia-$UID.pid" 2>/dev/null)
  if [[ -n $pid ]] && cmdline_do_pid "$pid" | grep -q -- '--vigia'; then
    cpu=$(ps -o %cpu= -p "$pid" 2>/dev/null | awk '{ printf "%d", $1 }')
    if ((${cpu:-0} >= 50)); then checar_linha vigia aviso "vigia vivo (pid $pid) mas usando ${cpu}% de CPU em média" "ver o fim de ~/.cache/tt-vigia.log; matar o pid e deixar o tmux religar (tmux run-shell -b '~/.local/bin/tt --vigia')"
    else checar_linha vigia ok "vigia vivo (pid $pid, ${cpu:-0}% de CPU)"; fi
  else
    checar_linha vigia falha "vigia parado: sem ele nada se atualiza, sincroniza nem avisa" "tmux run-shell -b '~/.local/bin/tt --vigia' (o vigia vive no servidor tmux do tt)"
  fi

  # atualização. O "publicado" guardado é o da última sonda: logo depois de uma instalação (o vigia novo roda
  # esta checagem junto com a sua 1ª sonda) ele ainda é o de antes, e a máquina recém-atualizada saía "atrás".
  # Sonda anterior ao pacote instalado não diz nada: fica sem comparar até a próxima (5 min).
  n=$(atu_get falhas); x=$(atu_get publicado); f=$(versao_hash_instalado)
  inst=$(stat -c %Y "$DIR_TT/VERSAO" 2>/dev/null || echo 0)
  (($(atu_get sonda_em || echo 0) + 0 >= inst)) || x=""
  if ((${n:-0} >= 3)); then checar_linha atualizacao falha "$n falhas seguidas ao buscar a versão publicada: $(atu_get erro)" "tt --atualizacao-estado; tt --atualizar"
  elif [[ -n $x && -n $f && $x != "$f"* && -z $(atu_get obs) ]]; then checar_linha atualizacao aviso "instalada $(versao_humana) ($f), publicada ${x:0:7}" "tt --atualizar"
  else checar_linha atualizacao ok "$(versao_humana) instalada${x:+, publicada ${x:0:7}}"; fi
  if [[ -f $DIR_TT/rapido/nucleo.sh ]]; then checar_linha partida-rapida ok "núcleo da partida rápida presente"
  else checar_linha partida-rapida aviso "sem partida rápida (rapido/): cada comando do tt fica mais lento" "TT_COMPLETO=1 ~/.local/bin/tt --rapido gerar"; fi

  # separação: pacote (trocado inteiro a cada instalação) × perfil (escolhas do usuário) × clone de desenvolvimento
  for x in "${ARQUIVOS_PACOTE[@]}"; do NO_PACOTE[$x]=1; [[ -e $DIR_TT/$x ]] || falta+=("$x"); done
  for f in "$DIR_TT"/* "$DIR_TT"/.[!.]*; do
    [[ -e $f || -L $f ]] || continue
    x=${f##*/}
    [[ -n ${NO_PACOTE[$x]:-} || $CHECAGEM_GERADOS == *" $x "* || $x == .git ]] || extra+=("$x")
  done
  for f in "$CONF_DIR"/*; do
    [[ -f $f ]] || continue
    x=${f##*/}
    case $x in tmux.conf|AI-DLC.md|*.antes-*|*.bak) continue ;; esac
    [[ -n ${NO_PACOTE[$x]:-} || $x == *.py || $x == *.sh ]] && codigo+=("$x")
  done
  if ((${#falta[@]})); then checar_linha separacao falha "pacote incompleto em ${DIR_TT/#"$HOME"/"~"}: falta ${falta[*]}" "reinstalar o pacote: tt --atualizar (na máquina de desenvolvimento, tt --sincronizar)"
  elif ((${#extra[@]})); then checar_linha separacao aviso "arquivo(s) que não são do pacote em ${DIR_TT/#"$HOME"/"~"}: ${extra[*]} (somem na próxima instalação)" "o que for escolha do usuário vai para ~/.config/tt; resto de versão antiga pode ser apagado"
  elif ((${#codigo[@]})); then checar_linha separacao aviso "código no perfil (~/.config/tt): ${codigo[*]}" "código mora no pacote; mover para fora do perfil ou apagar a cópia antiga"
  else checar_linha separacao ok "pacote completo e sem arquivos do usuário; perfil sem código"; fi
  if [[ -e $REPO_TT/.git ]]; then
    lst=()
    while IFS= read -r x; do [[ -n $x ]] && lst+=("${x:3}"); done < <(git -C "$REPO_TT" status --porcelain --untracked-files=no -- "${ARQUIVOS_FONTE[@]}" .gitignore 2>/dev/null)
    if ((${#lst[@]})); then checar_linha clone aviso "clone de desenvolvimento com arquivo versionado mudado e não gravado: ${lst[*]} (trava a atualização)" "tt --repo-checar (e --corrigir para o .gitignore)"
    else checar_linha clone ok "clone de desenvolvimento ${REPO_TT/#"$HOME"/"~"} sem mudança que trave a atualização"; fi
  fi

  # e-mail: cada conta com espelho local sincronizando; conta sem espelho não gera aviso nem demanda
  n=0
  for slug in $(email_slugs); do
    E=(); email_ler "$slug" 2>/dev/null || continue
    n=$((n + 1))
    # Os comandos (✕ Apagar, ▤ Arquivar) têm para onde mandar a mensagem?
    IFS=$'\t' read -r st erro m < <(email_cmds_estado "$slug")
    [[ -n $st ]] && checar_linha "email-cmd:$slug" "$st" "$erro" "$m"
    if [[ ${E[sync_local]:-} != 1 ]]; then
      checar_linha "email:$slug" aviso "conta sem espelho local: sem aviso de e-mail novo, contador do 📧 e demandas [tt]" "tt --pedir-sudo email-espelho"
      continue
    fi
    st=$(email_sync_resumo "$slug")
    erro=$(head -c 300 "$ESTADO_DIR/email-sync/$slug.erro" 2>/dev/null | tr '\n\t' '  ')
    # INBOX em dia não basta: a volta completa (as outras pastas) falhando seguidas vezes também é aviso
    d=$(awk -F'\t' '$1 == "completo" { n = ($4 == 0 ? 0 : n + 1) } END { print n + 0 }' "$ESTADO_DIR/email-sync/$slug" 2>/dev/null)
    [[ $st == ok ]] && ((${d:-0} >= 2)) && st=completo
    case $st in
      ok) checar_linha "email:$slug" ok "espelho em dia" ;;
      completo) checar_linha "email:$slug" aviso "INBOX em dia, mas a volta completa falhou $d vezes seguidas: $(head -c 300 "$ESTADO_DIR/email-sync/$slug.erro-completo" 2>/dev/null | tr '\n\t' '  ')" \
        "tt --email-sync $slug --completo; \"box … cannot be opened anymore\" = pasta que sumiu do servidor e ficou no espelho: mova-a de $(email_maildir "$slug")/ para fora" ;;
      erro|parado) checar_linha "email:$slug" falha "sync $st${erro:+: $erro}" "tt --email-sync-estado (a dica diz a causa); tt --email-sync $slug; OAuth vencido: tt --email-autorizar $slug" ;;
      *) checar_linha "email:$slug" aviso "sync $st" "tt --email-sync $slug" ;;
    esac
  done
  ((n)) || checar_linha email ok "nenhuma conta de e-mail cadastrada"

  # caixa de entrada de tarefas (demandas por e-mail): o caminho é e-mail [tt] → espelho local da conta →
  # remetente autorizado (e autenticado) → tarefa pendente na aba Entrada
  local esp="" ign="" nesp=0 naut npend desde7 espelhadas=0
  for slug in $(email_slugs); do E=(); email_ler "$slug" 2>/dev/null && [[ ${E[sync_local]:-} == 1 ]] && espelhadas=$((espelhadas + 1)); done
  for f in "$ESTADO_DIR"/email-sync/*.demandas.espera; do
    [[ -s $f ]] || continue
    nesp=$((nesp + $(wc -l <"$f"))); esp+=$(cut -f2 "$f")$'\n'
  done
  esp=$(sort -u <<<"$esp" | grep . | head -3 | paste -sd, - | sed 's/,/, /g')
  desde7=$(date -d '-7 days' +%F 2>/dev/null || echo 0000)
  ign=$(cat "$ESTADO_DIR"/email-sync/*.demandas.log 2>/dev/null | awk -v d="$desde7" '$1 >= d && $3 == "ignorada" { print $4 " " $5 }' | tail -1)
  naut=$(awk -F'\t' '$3 != "-"' "$CONF_DEMANDAS" 2>/dev/null | wc -l)
  npend=$(awk -F'\t' '$2 == "pendente"' "$CONF_TAREFAS" 2>/dev/null | wc -l)
  if ((n && !espelhadas)); then checar_linha demandas aviso "nenhuma conta com espelho local: tarefas mandadas por e-mail ([tt]) não chegam" "tt --pedir-sudo email-espelho"
  elif ((nesp)); then checar_linha demandas aviso "$nesp e-mail(s) [tt] aguardando você autorizar o remetente: $esp" "tt --demanda-autorizar EMAIL (decisão do usuário: só remetente em quem ele confia)"
  elif [[ -n $ign ]]; then checar_linha demandas aviso "e-mail [tt] de remetente autorizado ignorado nos últimos 7 dias: $ign" "autenticação (SPF/DKIM) do remetente falhou: autorizá-lo com segredo (tt --demanda-autorizar EMAIL - segredo XXXX) é decisão do usuário"
  elif ((n)); then checar_linha demandas ok "caixa de entrada de tarefas pronta: $naut remetente(s) autorizado(s), $npend aguardando na aba Entrada"
  fi

  # tarefas
  m=$(tarefas_sync_modo)
  if [[ $m == @(git|ambos) ]]; then
    if [[ -f $ESTADO_DIR/tarefas-git.erro ]]; then
      IFS=$'\t' read -r desde _ mot <"$ESTADO_DIR/tarefas-git.erro"
      checar_linha tarefas falha "sync das tarefas por git falhando há $(( (agora - ${desde:-agora}) / 60 )) min: $mot" "tt --tarefas-sync agora"
    elif ((agora - $(cat "$ESTADO_DIR/tarefas-git.ok" 2>/dev/null || echo 0) > 86400)); then
      checar_linha tarefas aviso "sync das tarefas por git sem troca boa há mais de 1 dia" "tt --tarefas-sync agora"
    else checar_linha tarefas ok "sync das tarefas ($m) em dia"; fi
  else checar_linha tarefas ok "sync das tarefas: $m"; fi

  # malha (malha_vigia conta as voltas com ilha)
  if [[ -s $CONF_MAQ ]]; then
    n=$(cat "$RT/tt-malha-ilha-$UID" 2>/dev/null || echo 0)
    if ((n >= 2)); then checar_linha malha falha "ilha na malha há $n voltas do vigia: alguma máquina não alcança outra" "tt --malha; tt --diagnosticar MÁQUINA; tt --reparar MÁQUINA"
    else checar_linha malha ok "sem ilha na malha"; fi
  else checar_linha malha ok "só esta máquina cadastrada"; fi
  # sshd: sem ele esta máquina é ilha (as outras acham a porta fechada); o vigia o garante a cada 5 min
  if [[ -s $CONF_MAQ && $(conf sshd_garantir) != 0 ]]; then
    x=$(sshd_porta)
    if [[ -n $x ]]; then checar_linha sshd ok "aceita conexão da malha na porta $x"
    elif sshd_bin >/dev/null; then checar_linha sshd falha "nenhum sshd escutando: as outras máquinas não alcançam esta (ilha)" "tt --sshd-garantir (log em ~/.local/state/tt/sshd/)"
    else checar_linha sshd falha "sem servidor ssh (openssh-server): as outras máquinas não alcançam esta" "tt --pedir-sudo sshd"; fi
  fi

  if [[ $(uname -s) == Darwin && ${TT_TAILSCALE_WS_AUTO:-1} != 0 && -z ${TT_RT:-} ]]; then
    if x=$(tailscale_ws status 2>&1); then checar_linha tailscale-ws ok "$x"
    else checar_linha tailscale-ws falha "$x" "tt --tailscale-ws garantir; ver ~/.local/state/tt/tailscale-ws/ultima.log"; fi
  fi
  # tailscale: deslogado ou sem falar com o servidor de coordenação (filtro de rede da empresa, "unexpected EOF") deixa
  # esta máquina fora da tailnet; o cache mantém o nó vivo até o tailscaled reiniciar, e aí o registro falha.
  if command -v tailscale >/dev/null 2>&1; then
    x=$(tailscale status --json 2>/dev/null | python3 -c '
import json, sys
try: d = json.load(sys.stdin)
except Exception: sys.exit(0)
est = d.get("BackendState", "")
saude = " ".join(d.get("Health") or [])
if est and est != "Running": print("parado\t" + est)
elif "coordination" in saude or "logged out" in saude: print("coord\t" + saude[:90])
elif est: print("ok\t" + (d.get("Self") or {}).get("DNSName", "").split(".")[0])' 2>/dev/null) || x=""
    case ${x%%$'\t'*} in
    ok) checar_linha tailscale ok "conectado à tailnet como ${x#*$'\t'}" ;;
    parado) checar_linha tailscale falha "tailscale ${x#*$'\t'}: esta máquina está fora da tailnet" "troque para uma rede sem filtro (hotspot) e rode: sudo tailscale up --ssh (com --hostname=NOME, o mesmo de antes); não reinicie o tailscaled na rede da empresa" ;;
    coord) checar_linha tailscale aviso "tailscale sem falar com o servidor de coordenação (${x#*$'\t'}): provável filtro de rede" "não reinicie o tailscaled nesta rede (o registro falharia e a máquina ficaria deslogada); troque de rede ou peça ao TI para liberar *.tailscale.com" ;;
    esac
  fi

  # agentes: regras do tt no AGENTS.md único, CLAUDE.md como link para ele, skill instalada
  f=$HOME/.agents/AGENTS.md
  if ! grep -q 'tt-managed:regras-tt BEGIN' "$f" 2>/dev/null; then checar_linha agentes falha "as regras do tt não estão em ~/.agents/AGENTS.md" "tt --reforcar-agentes"
  elif [[ -d $HOME/.claude && ! -L $HOME/.claude/CLAUDE.md ]]; then checar_linha agentes aviso "~/.claude/CLAUDE.md não é link para ~/.agents/AGENTS.md" "tt --reforcar-agentes (o texto de fora do bloco vai para a fonte)"
  elif [[ -d $HOME/.claude && ! -f $HOME/.claude/skills/tt-terminais/SKILL.md ]]; then checar_linha agentes aviso "skill tt-terminais ausente no Claude" "tt --reforcar-agentes"
  else checar_linha agentes ok "regras e skill do tt nos agentes"; fi

  # pendências de instalação
  lst=(); x=""
  while IFS=$'\t' read -r f _ _ _ d; do
    [[ -n $f ]] || continue
    lst+=("$f"); [[ $d == essencial ]] && x=1
  done < <(sudo_pendencias 2>/dev/null)
  if ((${#lst[@]})); then checar_linha pendencias "$([[ -n $x ]] && echo falha || echo aviso)" "falta instalar: ${lst[*]}" "tt --pedir-sudo ${lst[*]} (sudo só se funcionar sem senha: sudo -n true)"
  else checar_linha pendencias ok "nada essencial ou de recurso faltando"; fi

  # hora
  hora__ler
  if ((HORA_T == 0)); then checar_linha hora aviso "sem medida do relógio contra a internet" "tt --hora --sincronizar"
  elif ((${HORA_D#-} >= 60)); then checar_linha hora aviso "relógio da máquina desviado ${HORA_D} s (o tt compensa nas tarefas e na barra)" "acertar o relógio do sistema"
  else checar_linha hora ok "relógio certo"; fi

  # conversas das IAs entre as máquinas
  if sessoes_ia_ativo && [[ -s $CONF_MAQ && -d $ESTADO_DIR/sessoes-ia/maquinas ]]; then
    lst=()
    ativas=" $(maquinas 2>/dev/null | awk '{ print $2 }' | tr '\n' ' ')"   # oculta ou desligada no Tailscale não é defeito daqui
    for f in "$ESTADO_DIR"/sessoes-ia/maquinas/*; do
      [[ -f $f ]] || continue
      [[ $ativas == *" ${f##*/} "* ]] || continue
      read -r x st _ <"$f"
      [[ $st == ok && $x =~ ^[0-9]+$ ]] && ((agora - x < 172800)) && continue
      [[ $st == pulada ]] && continue   # a outra estava fora da rede: não é defeito daqui
      lst+=("${f##*/}")
    done
    if ((${#lst[@]})); then checar_linha sessoes-ia aviso "conversas das IAs sem troca boa há mais de 2 dias com: ${lst[*]}" "tt --sessoes-ia agora; log em ~/.cache/tt-sessoes-ia.log"
    else checar_linha sessoes-ia ok "conversas das IAs trocando"; fi
  fi
  return 0
}

checar_contar() { awk -F'\t' '{ c[$2]++ } END { printf "ok=%d aviso=%d falha=%d", c["ok"], c["aviso"], c["falha"] }' "$@"; }

# tt --checar [--tsv]: o coletor, legível. Sai 1 se alguma checagem falhou.
checar() {
  local tsv id st res cor ic
  tsv=$(checar_coletar)
  if [[ ${1:-} == --tsv ]]; then printf '%s\n' "$tsv"
  else
    echo "Checagem do tt em $MAQUINA ($(versao_humana))"
    while IFS=$'\t' read -r id st res cor; do
      case $st in ok) ic=$'\e[32m✓\e[0m' ;; aviso) ic=$'\e[33m!\e[0m' ;; *) ic=$'\e[31m✗\e[0m' ;; esac
      printf '  %s %-16s %s\n' "$ic" "$id" "$res"
      [[ $st != ok && $cor != - ]] && printf '      \e[90m→ %s\e[0m\n' "$cor"
    done <<<"$tsv"
    echo "  ($(checar_contar <<<"$tsv"))"
  fi
  ! grep -q $'\tfalha\t' <<<"$tsv"
}

# Coletor em Markdown (relatório sem agente).
checar_md() { awk -F'\t' '{ i = ($2 == "ok") ? "✓" : ($2 == "aviso") ? "!" : "✗"; printf "- %s **%s**: %s\n", i, $1, $3; if ($2 != "ok" && $4 != "-") printf "  - correção: `%s`\n", $4 }' "$1"; }

checar_ia_rot() {
  local b
  [[ ${TT_IA_ROT:-} == - ]] && return 1 # testes: "nenhum agente nesta máquina"
  for b in "${TT_IA_ROT:-}" "$HOME/.local/bin/ia-rot" "$DIR_TT/ia-rot"; do [[ -n $b && -x $b ]] && { printf '%s' "$b"; return 0; }; done
  return 1
}

# O pedido ao agente: o modelo do pacote (checagem-prompt.md) com os dados desta rodada.
checar_prompt() { # pasta-da-rodada versão-anterior versão-atual
  local rod=$1 de=$2 para=$3 t nov regras dev
  t=$(cat "$DIR_TT/checagem-prompt.md" 2>/dev/null) || return 1
  if [[ -n $de ]]; then nov=$(novidades_texto "$de"); else nov=$(awk '/^## v/ { c++ } c == 1' "$DIR_TT/NOVIDADES.md" 2>/dev/null); fi
  regras=$(cat "$DIR_TT/checagens-tt.md" 2>/dev/null)
  [[ -s $CONF_DIR/checagens.md ]] && regras+=$'\n\n## Regras só desta máquina (~/.config/tt/checagens.md)\n\n'$(cat "$CONF_DIR/checagens.md")
  if [[ -e $REPO_TT/.git ]]; then dev="SIM: o clone de desenvolvimento do tt é $REPO_TT"
  else dev="NÃO: esta máquina não tem o clone de desenvolvimento do tt"; fi
  # Substituição com o valor entre aspas: no bash 5.2+, um & solto no valor viraria o texto casado.
  t=${t//'{{MAQUINA}}'/"$MAQUINA"}; t=${t//'{{DE}}'/"${de:-(primeira checagem)}"}; t=${t//'{{PARA}}'/"$para"}
  t=${t//'{{RODADA}}'/"$rod"}; t=${t//'{{DEV}}'/"$dev"}; t=${t//'{{TT}}'/"$HOME/.local/bin/tt"}
  t=${t//'{{COLETOR}}'/"$(checar_md "$rod/coletor.tsv")"}
  nov=${nov:-(sem entrada no NOVIDADES.md para esta versão)}
  t=${t//'{{NOVIDADES}}'/"$nov"}
  t=${t//'{{CHECAGENS}}'/"$regras"}
  printf '%s\n' "$t"
}

# tt --checar-agente [--de VERSÃO] [--so-coletor]: abre uma rodada. Com conta de IA livre, lança o agente
# na sessão oculta _tt-checagem (ou em 2º plano, sem tmux) e volta logo; o fim da rodada é checar_fechar.
# Saída: 0 lançou (ou fechou só com o coletor, com --so-coletor), 2 nenhuma conta livre (nada criado),
# 3 sem agente nesta máquina (rodada fechada só com o coletor), 4 já há uma rodando.
checar_agente() {
  local de="" so="" para rod ia n
  while (($#)); do case $1 in --de) de=${2:-}; shift ;; --so-coletor) so=so-coletor ;; --sem-conta) so=sem-conta ;; esac; shift; done
  para=$(versao_disp)
  if tmux has-session -t "=$CHECAGEM_SESSAO" 2>/dev/null; then echo "Já há uma checagem rodando (sessão $CHECAGEM_SESSAO)."; return 4; fi
  ia=$(checar_ia_rot) || so=${so:-sem-agente}
  if [[ -z $so ]] && ! "$ia" --melhor >/dev/null 2>&1; then echo "Nenhuma conta de IA livre agora; tente mais tarde (tt --checar mostra o coletor)."; return 2; fi
  rod=$CHECAGEM_DIR/$para-$(date +%Y%m%d-%H%M%S)
  # Duas rodadas no mesmo segundo (um --checar-agente logo depois do outro) dividiam a pasta e o relatório.
  [[ -e $rod ]] && { n=2; while [[ -e $rod-$n ]]; do n=$((n + 1)); done; rod=$rod-$n; }
  mkdir -p "$rod/backup" || return 1
  printf 'de=%s\npara=%s\nmaquina=%s\ninicio=%s\n' "$de" "$para" "$MAQUINA" "$(date -Iseconds)" >"$rod/rodada"
  checar_coletar >"$rod/coletor.tsv"
  if [[ -n $so ]]; then
    checar_fechar "$rod" "$so"
    [[ $so == sem-agente ]] && { echo "Sem agente de IA nesta máquina: relatório só com o coletor em $rod"; return 3; }
    echo "Relatório (só o coletor) em $rod"; return 0
  fi
  checar_prompt "$rod" "$de" "$para" >"$rod/prompt.md" || { checar_fechar "$rod" sem-modelo; return 1; }
  cat >"$rod/rodar.sh" <<FIM
#!/usr/bin/env bash
# Rodada de checagem do tt ($(date -Iseconds)): o agente lê prompt.md; a saída fica em saida.log.
cd ~ || exit 1
$(q "$ia") -p "\$(cat $(q "$rod/prompt.md"))" --dangerously-skip-permissions >$(q "$rod/saida.log") 2>&1
$(q "$EU") --checar-fechar $(q "$rod") "\$?"
FIM
  if tmux list-sessions >/dev/null 2>&1; then
    tmux new-session -d -s "$CHECAGEM_SESSAO" -c "$HOME" "bash $(q "$rod/rodar.sh")" || { checar_fechar "$rod" sem-sessao; return 1; }
  else
    setsid bash "$rod/rodar.sh" >/dev/null 2>&1 </dev/null &
  fi
  echo "Agente da checagem lançado (sessão $CHECAGEM_SESSAO); relatório em $rod"
}

# tt --checar-fechar PASTA MOTIVO (interno; o rodar.sh chama ao fim do agente com o código de saída dele):
# garante o relatório, grava a linha do histórico, poda as rodadas antigas e avisa no 🔔.
checar_fechar() {
  local rod=$1 motivo=${2:-?} de="" para="" res nota ag="-"
  [[ -d $rod ]] || return 1
  de=$(sed -n 's/^de=//p' "$rod/rodada" 2>/dev/null); para=$(sed -n 's/^para=//p' "$rod/rodada" 2>/dev/null)
  case $motivo in
    sem-agente) nota="Sem agente de IA nesta máquina: relatório só com o coletor." ;;
    so-coletor) nota="Rodada só com o coletor (sem agente)." ;;
    sem-conta) nota="Nenhuma conta de IA ficou livre em 3 tentativas: relatório só com o coletor." ;;
    0) ag=agente nota="O agente terminou sem escrever relatorio.md; a saída dele está em saida.log." ;;
    *) ag=agente nota="O agente saiu com o código $motivo sem escrever relatorio.md; a saída dele está em saida.log." ;;
  esac
  if [[ ! -s $rod/relatorio.md ]]; then
    { printf '# Checagem do tt · %s · v%s\n\n%s\n\n## Coletor\n\n' "$MAQUINA" "${para:-?}" "$nota"; checar_md "$rod/coletor.tsv"; } >"$rod/relatorio.md"
  fi
  [[ -s $rod/saida.log ]] && ag=agente
  res=$(grep -m1 -o 'ok=[0-9]* aviso=[0-9]* falha=[0-9]* corrigido=[0-9]*' "$rod/relatorio.md") ||
    res="$(checar_contar "$rod/coletor.tsv") corrigido=0"
  mkdir -p "$CHECAGEM_DIR"
  printf '%s\t%s\t%s→%s\t%s\t%s\t%s\n' "$(date -Iseconds)" "$MAQUINA" "${de:--}" "${para:-?}" "$ag" "$res" "${rod##*/}" >>"$CHECAGEM_DIR/historico.log"
  checar_podar
  notificar "🩺 checagem do tt v${para:-?} em $MAQUINA: ${res//=/ } (clique: relatório)" 86400 "checagem:${rod##*/}" sino
}

# Guarda as últimas TT_CHECAGEM_MANTER (20) rodadas.
checar_podar() {
  local -a ds=(); local d n
  for d in "$CHECAGEM_DIR"/*/; do [[ -f $d/rodada ]] && ds+=("${d%/}"); done
  n=$(( ${#ds[@]} - ${TT_CHECAGEM_MANTER:-20} ))
  ((n > 0)) || return 0
  ls -1dtr "${ds[@]}" | head -n "$n" | while IFS= read -r d; do rm -rf -- "$d"; done
}

# tt --checar-ver [RODADA]: o relatório (da última rodada, sem argumento).
checar_ver() {
  local rod=${1:-} f
  if [[ -z $rod ]]; then rod=$(awk -F'\t' 'END { print $6 }' "$CHECAGEM_DIR/historico.log" 2>/dev/null); fi
  [[ $rod == /* ]] || rod=$CHECAGEM_DIR/$rod
  f=$rod/relatorio.md
  [[ -s $f ]] || { echo "Nenhum relatório de checagem ainda (tt --checar-agente abre uma rodada)."; return 1; }
  if [[ -t 1 ]]; then
    { novidades_fmt "$(( $(tput cols 2>/dev/null || echo 80) - 2 ))" <"$f"; printf '\n\e[90m%s\e[0m\n' "${rod/#"$HOME"/"~"}"; } |
      if tem_cmd less; then LESSCHARSET=utf-8 less -R; else cat; read -rsn1 -p $'\n  (qualquer tecla fecha)' </dev/tty; fi
  else cat "$f"; fi
}

# Máscara do handoff: segredos e e-mails, em todos os arquivos de texto da pasta.
CHECAGEM_MASCARA_PY='
import os, re, sys
pad = [
  (re.compile(r"(?i)\b(refresh_token|access_token|id_token|client_secret|password|passwd|senha|secret|token|api[_-]?key|authorization)(\"?\s*[:=]\s*\"?)(?:Bearer\s+)?[^\s\"'"'"',;]+"), r"\1\2***"),
  (re.compile(r"(?i)\bBearer\s+[A-Za-z0-9._~+/=-]{8,}"), "Bearer ***"),
  (re.compile(r"\b(sk-[A-Za-z0-9_-]{8,}|gh[pousr]_[A-Za-z0-9]{12,}|xox[abpr]-[A-Za-z0-9-]{8,}|ya29\.[A-Za-z0-9._-]{8,}|1//[A-Za-z0-9_-]{16,}|AKIA[A-Z0-9]{12,})"), "***"),
  (re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----", re.S), "*** chave privada ***"),
  (re.compile(r"\b([A-Za-z0-9])[A-Za-z0-9._%+-]*@([A-Za-z0-9.-]+\.[A-Za-z]{2,})"), r"\1***@\2"),
]
for raiz, _, arqs in os.walk(sys.argv[1]):
  for a in arqs:
    p = os.path.join(raiz, a)
    try: t = open(p, encoding="utf-8").read()
    except Exception: os.remove(p); continue
    n = t
    for r, s in pad: n = r.sub(s, n)
    if n != t: open(p, "w", encoding="utf-8").write(n)
'

# tt --checar-handoff [ARQUIVO]: um .tar.gz com tudo o que quem mantém o tt precisa para entender esta
# máquina (rodadas de checagem, fim dos logs, estado atual), mascarado. Nunca leva ~/.secrets, o
# accounts.conf do aerc, os .mbsyncrc nem credencial de IA: só lê os arquivos listados aqui.
checar_handoff() {
  local dest=${1:-} tmp nome raiz f d
  d=$(date +%Y%m%d-%H%M%S); nome=tt-handoff-$MAQUINA-$d
  [[ -n $dest ]] || dest=$(pasta_recebidos)/$nome.tar.gz
  mkdir -p "${dest%/*}" || return 1
  tmp=$(mktemp -d) || return 1
  raiz=$tmp/$nome; mkdir -p "$raiz/checagens" "$raiz/logs" "$raiz/estado" "$raiz/email-sync"
  [[ -d $CHECAGEM_DIR ]] && (cd "$CHECAGEM_DIR" && tar --exclude='./*/backup' --exclude='./*/rodar.sh' -cf - .) | tar -xf - -C "$raiz/checagens"
  for f in "$HOME/.cache/tt-vigia.log" "$HOME/.cache/tt-malha.log" "$HOME/.cache/tt-letreiro.log" "$HOME/.cache/tt/pendencias.log" \
           "$HOME/.cache/tt-sessoes-ia.log" "$HOME/.cache/tt-troca.log" "$ESTADO_DIR/tarefas-git.erro" "$ESTADO_DIR/atualizacao"; do
    [[ -f $f ]] && tail -n 1000 "$f" >"$raiz/logs/${f##*/}"
  done
  for f in "$ESTADO_DIR"/email-sync/*; do
    [[ -f $f ]] || continue
    case ${f##*/} in *.vistas|*.trava|*.tmp|*.andamento|*.lib) continue ;; esac
    tail -n 300 "$f" >"$raiz/email-sync/${f##*/}"
  done
  _ho() { local arq=$1; shift; timeout 60 "$EU" "$@" 2>&1 | sed 's/\x1b\[[0-9;]*[A-Za-z]//g' >"$raiz/estado/$arq"; }
  _ho versao.txt --versao
  _ho atualizacao.txt --atualizacao-estado
  _ho checar.tsv --checar --tsv
  _ho pendencias.tsv --pendencias --tsv
  _ho email-sync.txt --email-sync-estado
  _ho tarefas-sync.txt --tarefas-sync status
  _ho hora.txt --hora
  _ho sessoes-ia.txt --sessoes-ia status
  { pacotes_lib && pk_resumo; echo; uname -srm; } >"$raiz/estado/plataforma.txt" 2>&1
  cat >"$raiz/LEIA-ME.md" <<FIM
# Handoff do tt · $MAQUINA · $(versao_humana) · $(date -Iseconds)

- \`checagens/\`: historico.log (uma linha por rodada) e uma pasta por rodada (relatorio.md, coletor.tsv, prompt.md, saida.log).
- \`estado/\`: o estado agora (versão, atualização, coletor, pendências, e-mail, tarefas, hora, conversas das IAs, plataforma).
- \`logs/\`: o fim dos logs do tt (vigia, malha, letreiro, pendências, conversas das IAs, trocas, sync das tarefas).
- \`email-sync/\`: registro e erros do espelho de cada conta de e-mail.

Segredos e e-mails foram mascarados. Não há nada de ~/.secrets, do accounts.conf do aerc, dos .mbsyncrc nem credenciais de IA.
FIM
  python3 -I -c "$CHECAGEM_MASCARA_PY" "$raiz" || { rm -rf "$tmp"; echo "✗ não consegui mascarar o pacote; nada foi gerado."; return 1; }
  tar -czf "$dest" -C "$tmp" "$nome" || { rm -rf "$tmp"; return 1; }
  rm -rf "$tmp"
  echo "Pacote de handoff: $dest ($(du -h "$dest" | cut -f1))"
  tar -tzf "$dest" | sed -n "s|^$nome/||p" | grep -v '/$' | sed 's/^/  /'
  echo "Confira o conteúdo antes de enviar (tt --enviar, anexo de e-mail ou outra via)."
}

# Vigia (a cada 5 min e ao iniciar, que acontece a cada versão nova): versão instalada mais nova que a
# última checada → uma rodada. Máquina recém-instalada só marca. Sem conta livre, tenta de novo a cada
# 30 min; na 3ª vez fecha só com o coletor. checagem_auto=0 desliga.
checar_auto() {
  [[ $(conf checagem_auto) == 0 ]] && return 0
  local atual visto marca=$CHECAGEM_DIR/versao-checada tent=$CHECAGEM_DIR/tentativas trava=$RT/tt-checagem-$UID.trava rc n
  atual=$(versao_disp)
  mkdir -p "$CHECAGEM_DIR"
  if [[ ! -s $marca ]]; then echo "$atual" >"$marca"; return 0; fi
  visto=$(<"$marca")
  (($(versao_chave "$atual") > $(versao_chave "$visto"))) || return 0
  [[ -f $tent ]] && (($(idade_arquivo "$tent") < ${TT_CHECAGEM_REPETIR:-1800})) && return 0
  [[ -d $trava ]] && (($(idade_arquivo "$trava") > 3600)) && rmdir "$trava" 2>/dev/null
  mkdir "$trava" 2>/dev/null || return 0
  checar_agente --de "$visto" >/dev/null 2>&1; rc=$?
  if ((rc == 2)); then
    n=$(( $(cat "$tent" 2>/dev/null || echo 0) + 1 ))
    if ((n < 3)); then echo "$n" >"$tent"; rmdir "$trava"; return 0; fi
    checar_agente --de "$visto" --sem-conta >/dev/null 2>&1
  fi
  rmdir "$trava" 2>/dev/null
  ((rc == 4)) && return 0
  rm -f "$tent"; echo "$atual" >"$marca"
}

# Chamado pelo vigia (no início e a cada 6 h): se há pendências ainda não respondidas (ou adiadas e
# vencidas), põe UM aviso na faixa — clicar abre o modal. O aviso dura 6 h (um de 1 h passava despercebido
# de noite) e o mesmo conjunto só volta a ser avisado depois de 12 h. Nunca avisa do que o usuário mandou
# "não instalar" (isso só o menu reabre), nem de opcionais, nem do que o tt não instala sozinho.
pendencias_avisar() {
  gerenciador_pacotes >/dev/null 2>&1 || return 0
  local lista ids marca=$ESTADO_DIR/pendencias-avisadas n rot id
  lista=$(sudo_pendencias) || return 0
  if [[ -z $lista ]]; then rm -f "$marca"; return 0; fi
  ids=$(cut -f1 <<<"$lista" | tr '\n' ' ')
  if [[ $(cut -f1 "$marca" 2>/dev/null) == "$ids" ]] && (( $(date +%s) - $(cut -f2 "$marca" 2>/dev/null || echo 0) < 43200 )); then return 0; fi
  mkdir -p "$ESTADO_DIR"; printf '%s\t%s\n' "$ids" "$(date +%s)" >"$marca"
  n=$(wc -l <<<"$lista")
  rot=$(for id in $ids; do pend_rotulo "$id"; done | paste -sd, - | sed 's/,/, /g')
  notificar "📦 $n pendência$( ((n > 1)) && echo s) de instalação ($rot) — clique para decidir" 21600 pendencias
}

