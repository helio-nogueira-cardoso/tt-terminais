# --- Sessões fixadas ----------------------------------------------------------
#
# Uma segunda linha na barra com as sessões fixadas (desta ou de outras máquinas), cada uma um
# botão: clique vai para ela; botão direito: ir, desafixar, mover. Lista em ~/.config/tt/fixadas
# ("rótulo-da-máquina<TAB>sessão", na ordem da barra). A linha só aparece se houver alguma.

CONF_FIX=$CONF_DIR/fixadas

fixadas() { [[ -f $CONF_FIX ]] && grep -v '^\s*$' "$CONF_FIX"; }

session_id() {
  local s=$1 id
  id=$(tmux show-options -qv -t "=$s:" @tt_session_id 2>/dev/null)
  if [[ -z $id ]]; then
    id=$(printf '%s\0%s\0%s\0%s' "$MAQUINA" "$s" "$$" "$(date +%s%N)" | sha256sum | cut -c1-32)
    tmux set-option -q -t "=$s:" @tt_session_id "$id" 2>/dev/null || return 1
  fi
  printf '%s\n' "$id"
}

session_by_id() {
  local id=$1
  # O tmux não converte "\t" no formato: o TAB precisa ir literal ($'\t').
  tmux list-sessions -F "#{session_name}"$'\t'"#{@tt_session_id}" 2>/dev/null |
    awk -F'\t' -v id="$id" '$2 == id { print $1; exit }'
}

# Resolve um código persistente para a sessão atual, mesmo depois de ela ser renomeada.
session_resolve() { # código → rótulo da máquina<TAB>nome atual da sessão
  local id=$1 s
  s=$(session_by_id "$id") || return 1
  [[ -n $s ]] || { echo "sessão não encontrada neste tmux: $id" >&2; return 1; }
  printf '%s\t%s\n' "${MAQUINA//_/-}" "$s"
}

resolver_fixada_remota() {
  local antigo=$1 id=$2 s
  if [[ -n $id ]]; then s=$(session_by_id "$id"); else s=$antigo; fi
  [[ -n $s ]] || return 1
  printf '%s\t%s\n' "$s" "$(session_id "$s")"
}

# Identidade estável do item da barra. O índice pode mudar enquanto o vigia sincroniza a lista;
# a chave permite resolver o clique contra a máquina e a sessão corretas mesmo nesse intervalo.
# O tmux limita o argumento de range=user|X a 15 bytes; 12 hexadecimais deixam margem para
# classificadores e versões que acrescentam o prefixo do tipo ao valor.
fixada_chave() { local __fxk; fixada_chave_em __fxk "$@"; printf '%s\n' "$__fxk"; }
# A chave é função pura de (máquina, id ou sessão): calculada uma vez, fica lembrada no processo e em
# $RT/tt-fixadas-chaves-$UID (o sha256sum custava 2 processos por fixada, em cada clique e em cada
# redesenho da faixa). fixada_chave_em grava em VAR sem subshell.
declare -A _FX_CHAVE=()
_FX_CHAVE_LIDO=""
fixada_chave_em() { # VAR máquina sessão [id]
  local _c=${4:-$3}
  local _p="$2"$'\t'"$_c" _a=$RT/tt-fixadas-chaves-$UID _r _s _k _n=0
  if [[ $_FX_CHAVE_LIDO != "$_a" ]]; then
    _FX_CHAVE_LIDO=$_a
    if [[ -f $_a && -O $_a ]]; then
      while IFS=$'\t' read -r _r _s _k; do
        [[ $_k =~ ^[0-9a-f]{12}$ ]] && _FX_CHAVE["$_r"$'\t'"$_s"]=$_k; _n=$((_n + 1))
      done <"$_a"
      ((_n > 2000)) && : >"$_a" # nunca cresce sem fim (as chaves voltam sob demanda)
    fi
  fi
  _k=${_FX_CHAVE[$_p]:-}
  if [[ -z $_k ]]; then
    _k=$(printf '%s' "$_p" | sha256sum | cut -c1-12)
    if [[ $_k =~ ^[0-9a-f]{12}$ && $2 != *$'\n'* && $_c != *$'\n'* ]]; then
      _FX_CHAVE[$_p]=$_k
      { printf '%s\t%s\n' "$_p" "$_k" >>"$_a"; } 2>/dev/null
    fi
  fi
  printf -v "$1" '%s' "$_k"
}

# A lista é a mesma em todas as máquinas: cada mudança é copiada para as cadastradas (em segundo
# plano), e cada uma redesenha a barra. Assim as fixadas não somem ao entrar numa sessão de outra
# máquina (a barra que aparece é a de lá).
versao_fixadas_em() { printf '%s %s\n' "$1" "$(timeout 6 ssh "${SSH_OPC[@]}" "$1" 'cat ~/.config/tt/fixadas.v 2>/dev/null || echo 0' </dev/null 2>/dev/null)"; }
propagar_fixadas() {
  local dest rot v
  v=$(versao_fixadas)
  while read -r dest rot; do
    (timeout 8 ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --receber-fixadas $v" <"$CONF_FIX" >/dev/null 2>&1 &)
  done < <(maquinas)
}

# Grava a opção @ da sessão S só se o valor for outro (todo set-option redesenha todos os clientes).
opt_sessao() {
  [[ $(tmux show-options -qv -t "=$1:" "$2" 2>/dev/null) == "$3" ]] && return 0
  tmux set-option -q -t "=$1:" "$2" "$3" 2>/dev/null
}

# Trava das gravações da lista (fixar/desafixar, receber de outra máquina, reconciliar): sem ela,
# duas gravações quase juntas faziam uma desfazer a outra (fixar uma sessão desafixava outra).
# mkdir é atômico em qualquer sistema (o Termux não garante flock). Trava velha (>20 s) é de um
# processo que morreu e é retomada.
travar_fixadas() {
  local t=$CONF_FIX.trava i
  mkdir -p "$CONF_DIR"
  for ((i = 0; i < 200; i++)); do
    mkdir "$t" 2>/dev/null && return 0
    (($(idade_arquivo "$t") > 20)) && rmdir "$t" 2>/dev/null
    sleep 0.05
  done
  return 1
}
destravar_fixadas() { rmdir "$CONF_FIX.trava" 2>/dev/null; return 0; }

# Versão da lista: a hora (ns) da última mudança, em ~/.config/tt/fixadas.v.
versao_fixadas() { local v; v=$(cat "$CONF_FIX.v" 2>/dev/null); echo "${v:-0}"; }
marcar_fixadas() { date +%s%N >"$CONF_FIX.v"; snapshot_evento fixadas; }

# Recebe a lista de outra máquina (stdin) com a versão V. Só aceita se for mais nova que a daqui:
# uma máquina que volta atrasada nunca desfaz uma mudança mais recente.
receber_fixadas() {
  local v=${1:-0} tmp
  mkdir -p "$CONF_DIR"
  tmp=$(mktemp "$CONF_FIX.XXXXXX"); cat >"$tmp"
  travar_fixadas || { rm -f "$tmp"; return 1; }
  if [[ $v =~ ^[0-9]+$ ]] && ((v > $(versao_fixadas))); then
    local antes depois
    antes=$(grep -vc '^\s*$' "$CONF_FIX" 2>/dev/null); depois=$(grep -vc '^\s*$' "$tmp" 2>/dev/null)
    ((${depois:-0} < ${antes:-0})) && fixadas_log "lista recebida (v$v) tem ${depois:-0} fixada(s) e a daqui tinha ${antes:-0}: origem ${SSH_CLIENT%% *}"
    mv "$tmp" "$CONF_FIX"; echo "$v" >"$CONF_FIX.v"
    destravar_fixadas
    aplicar_fixadas
  else
    destravar_fixadas
    rm -f "$tmp"
  fi
}

# Puxa a lista mais nova entre as máquinas cadastradas (o vigia chama ao iniciar e a cada 5 min):
# assim quem estava desligada na hora da mudança se atualiza sozinha ao voltar.
puxar_fixadas() {
  local dest v melhor_v melhor_d
  melhor_v=$(versao_fixadas) melhor_d=""
  while read -r dest v; do
    [[ $v =~ ^[0-9]+$ ]] && ((v > melhor_v)) && { melhor_v=$v; melhor_d=$dest; }
  done < <(nas_maquinas versao_fixadas_em)
  [[ -n $melhor_d ]] || return 0
  timeout 8 ssh "${SSH_OPC[@]}" "$melhor_d" 'cat ~/.config/tt/fixadas 2>/dev/null' </dev/null 2>/dev/null | receber_fixadas "$melhor_v"
}

# Cadastro comum das contas de IA (ia-conta): "provedor<TAB>e-mail<TAB>apelido<TAB>hora" por conta, igual
# em todas as máquinas; a identidade é o par (provedor, e-mail) e o apelido é só rótulo. Cada máquina faz o próprio login (copiar a credencial derrubaria a outra na renovação do
# token); o cadastro diz que contas existem e o que falta em cada máquina. Mesclar é por par e a
# mudança mais nova vence (apelido "-" = esquecida): a ordem de chegada não importa. Linhas no
# formato antigo (sem provedor) são do Claude.
CONF_CONTAS_IA=$CONF_DIR/contas-ia
receber_contas_ia() {
  local tmp t=$CONF_CONTAS_IA.trava i
  mkdir -p "$CONF_DIR"
  tmp=$(mktemp "$CONF_CONTAS_IA.XXXXXX") || return 1
  cat >"$tmp.in"
  for ((i = 0; i < 200; i++)); do
    mkdir "$t" 2>/dev/null && break
    (($(idade_arquivo "$t") > 20)) && rmdir "$t" 2>/dev/null
    sleep 0.05
  done
  awk -F'\t' -v OFS='\t' '
    NF == 3 && $1 ~ /@/ { $0 = "claude\t" $0 } # formato antigo: só Claude
    NF >= 4 && $1 ~ /^[a-z][a-z0-9-]*$/ && $2 ~ /^[^ ]+@[^ ]+$/ && ($3 == "-" || $3 ~ /^[A-Za-z0-9][A-Za-z0-9_-]*$/) && $4 ~ /^[0-9]+$/ {
      k = $1 OFS $2
      if (!(k in ts) || $4 + 0 > ts[k] + 0 || ($4 + 0 == ts[k] + 0 && $3 > nome[k])) { ts[k] = $4; nome[k] = $3 }
    }
    END { for (k in ts) print k, nome[k], ts[k] }' "$CONF_CONTAS_IA" "$tmp.in" 2>/dev/null | sort >"$tmp"
  if cmp -s "$tmp" "$CONF_CONTAS_IA"; then rm -f "$tmp"; else mv "$tmp" "$CONF_CONTAS_IA"; fi
  rm -f "$tmp.in"; rmdir "$t" 2>/dev/null
  return 0
}

propagar_contas_ia() {
  local dest rot
  [[ -s $CONF_CONTAS_IA ]] || return 0
  while read -r dest rot; do
    (timeout 8 ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --receber-contas-ia" <"$CONF_CONTAS_IA" >/dev/null 2>&1 &)
  done < <(maquinas)
}

# Junta os cadastros das outras máquinas (o vigia chama ao iniciar e a cada 30 min).
puxar_contas_ia() { nas_maquinas cat_remoto '~/.config/tt/contas-ia' 6 | receber_contas_ia; }

# --- Conversas das IAs entre as máquinas ------------------------------------------------------------
#
# As conversas do Claude Code, do Codex e do Kiro CLI ficam iguais em todas as máquinas: o /resume (ou
# "codex resume", "kiro-cli chat --resume") de qualquer máquina, em qualquer conta, acha a conversa que
# começou em outra. Entre as contas de uma máquina já é o mesmo histórico (projects/sessions/history das
# contas do ia-conta são links para ~/.claude); isto leva o histórico de uma máquina às outras.
# Ligado de fábrica (sessoes_ia_sync=0 desliga nesta máquina: ela nem manda nem recebe). O vigia roda a
# cada TT_T_SESSOES_IA s (1800). Quem decide a mescla é quem recebe (sessoes-ia.py): falta → grava, só
# cresceu → fica a mais longa, divergiu → fica a mais nova e a outra vai para
# ~/.local/state/tt/sessoes-ia/conflitos; conversa em uso fica para a próxima volta. A home dentro do
# "cwd" e a pasta do projeto do Claude são traduzidas (/home/heliocardoso ↔ /home/helio ↔ /root do proot).
# sessoes_ia_excluir= padrões (glob) sobre "provedor/chave", ex.: "claude/@H--secrets*".
SESSOES_IA_DIR=$ESTADO_DIR/sessoes-ia
sessoes_ia_ativo() { [[ $(conf sessoes_ia_sync) != 0 ]]; }
sessoes_ia_py() { TT_SESSOES_EXCLUIR=$(conf sessoes_ia_excluir) python3 "$DIR_TT/sessoes-ia.py" "$@"; }

# Do lado que é chamado por ssh: desligado, responde vazio (quem chama pula esta máquina).
sessoes_ia_remoto() { # inventario|empacotar|aplicar
  if ! sessoes_ia_ativo; then cat >/dev/null; return 1; fi
  sessoes_ia_py "$1"
}

sessoes_ia_puxar_lote() { # dest (lista no stdin)
  timeout 1800 ssh "${SSH_OPC[@]}" "$1" "$TT_REMOTO --sessoes-ia-empacotar" 2>/dev/null | sessoes_ia_py aplicar 2>/dev/null
}
sessoes_ia_enviar_lote() { # dest (lista no stdin)
  sessoes_ia_py empacotar 2>/dev/null | timeout 1800 ssh "${SSH_OPC[@]}" "$1" "$TT_REMOTO --sessoes-ia-aplicar" 2>/dev/null
}
# Passa LISTA à FUNÇÃO em lotes; para no primeiro lote que falha. Imprime os resumos somados.
sessoes_ia_lotes() { # lista função dest
  local lote=${TT_SESSOES_LOTE:-100} r tot="" rc=0
  local -a l; mapfile -t l <<<"$1"
  local i
  for ((i = 0; i < ${#l[@]}; i += lote)); do
    r=$(printf '%s\n' "${l[@]:i:lote}" | "$2" "$3") || { rc=1; break; }
    tot+="$r"$'\n'
  done
  awk '{ for (i = 1; i <= NF; i++) { split($i, kv, "="); if (!(kv[1] in s)) o[++n] = kv[1]; s[kv[1]] += kv[2] } }
       END { for (i = 1; i <= n; i++) printf "%s%s=%d", (i > 1 ? " " : ""), o[i], s[o[i]]; print "" }' <<<"$tot"
  return $rc
}

# tt --sessoes-ia-sync [rótulo…]: troca as conversas com as máquinas cadastradas (todas, ou as dadas).
sessoes_ia_sync() {
  sessoes_ia_ativo || { echo "conversas das IAs: sincronização desligada nesta máquina (sessoes_ia_sync=0)"; return 0; }
  local trava=$RT/tt-sessoes-ia-$UID.trava dest rot inv lista r_p r_e np ne st
  mkdir -p "$SESSOES_IA_DIR/maquinas" "$RT"
  if ! mkdir "$trava" 2>/dev/null; then
    (($(idade_arquivo "$trava") > 3600)) && rmdir "$trava" 2>/dev/null && mkdir "$trava" 2>/dev/null ||
      { echo "conversas das IAs: já há uma sincronização rodando"; return 0; }
  fi
  inv=$(mktemp "$RT/tt-sessoes-inv.XXXXXX")
  while read -r dest rot; do
    [[ -n $dest && $dest != . ]] || continue
    (($# == 0)) || printf '%s\n' "$@" | grep -qxF "$rot" || continue
    r_p="" r_e="" np=0 ne=0 st=ok
    if ! timeout 300 ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --sessoes-ia-inventario" </dev/null >"$inv" 2>/dev/null ||
      ! grep -q '"provedores"' "$inv"; then
      st=pulada # sem rede, tt antigo ou desligada lá
    else
      # Em lotes de TT_SESSOES_LOTE conversas (100): na primeira troca são centenas de MB, e um celular
      # que sai da rede no meio perdia o pacote inteiro; assim cada lote entregue já vale, e a próxima
      # volta continua do que faltou.
      lista=$(sessoes_ia_py pedir "$inv")
      if [[ -n $lista ]]; then
        np=$(wc -l <<<"$lista")
        r_p=$(sessoes_ia_lotes "$lista" sessoes_ia_puxar_lote "$dest") || st=falhou
      fi
      if [[ $st == ok ]] && lista=$(sessoes_ia_py pedir "$inv" --enviar) && [[ -n $lista ]]; then
        ne=$(wc -l <<<"$lista")
        r_e=$(sessoes_ia_lotes "$lista" sessoes_ia_enviar_lote "$dest") || st=falhou
      fi
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%s)" "$st" "$np" "$ne" "${r_p:--}" "${r_e:--}" >"$SESSOES_IA_DIR/maquinas/$rot"
    printf '%-12s %-7s trazidas %-4s levadas %-4s %s\n' "$rot" "$st" "$np" "$ne" "${r_p:+aqui: $r_p}"
  done < <(maquinas)
  rm -f "$inv"; rmdir "$trava" 2>/dev/null
  return 0
}

# tt --sessoes-ia [status|on|off|agora]
sessoes_ia_cmd() {
  local acao=${1:-status} novo="" f rot t st np ne
  case $acao in
    on | ligar) novo=1 ;;
    off | desligar) novo=0 ;;
    agora) shift; sessoes_ia_sync "$@"; return ;;
    status | estado) ;;
    *) echo "uso: tt --sessoes-ia [status|on|off|agora [rótulo…]]"; return 2 ;;
  esac
  if [[ -n $novo ]]; then
    mkdir -p "$CONF_DIR"
    grep -v '^sessoes_ia_sync=' "$CONF" 2>/dev/null >"$CONF.novo"; echo "sessoes_ia_sync=$novo" >>"$CONF.novo"; mv "$CONF.novo" "$CONF"
  fi
  sessoes_ia_ativo && echo "🧠 conversas das IAs: sincronizadas entre as máquinas (a cada $(( ${TT_T_SESSOES_IA:-1800} / 60 )) min)" ||
    echo "🧠 conversas das IAs: sincronização desligada nesta máquina"
  echo "Aqui:"
  sessoes_ia_py estado | awk -F'\t' '{ printf "  %-7s %s\n", $1, ($2 == "-" ? $3 : $2 " conversas  " $3) }'
  echo "Última troca com cada máquina:"
  for f in "$SESSOES_IA_DIR"/maquinas/*; do
    [[ -f $f ]] || { echo "  (nenhuma ainda)"; break; }
    IFS=$'\t' read -r t st np ne _ <"$f"
    printf '  %-12s %s  %-7s trazidas %s, levadas %s\n' "${f##*/}" "$(date -d "@$t" '+%d/%m %H:%M' 2>/dev/null || echo "$t")" "$st" "$np" "$ne"
  done
  [[ -d $SESSOES_IA_DIR/conflitos ]] && echo "Versões guardadas de conflitos: $SESSOES_IA_DIR/conflitos"
  return 0
}

# --- Demandas por e-mail ---------------------------------------------------------------------------
#
# Remetentes autorizados (cadastro comum, propagado como o das contas de IA): "e-mail<TAB>etiqueta<TAB>modo<TAB>
# segredo<TAB>hora". A identidade é o e-mail (minúsculo) e a mudança mais nova vence; modo "-" = removido.
# Modos: auth (padrão — o PROVEDOR que recebeu tem de ter autenticado o remetente: dmarc, ou dkim/spf alinhado),
# segredo (o assunto leva [tt:SEGREDO]) e aberto (sem checagem: o From é forjável, use só onde isso não importa).
# Um e-mail de remetente autorizado com assunto "[tt] título @sex 14h !alta *semanal #tag" vira uma tarefa
# PENDENTE — estado novo no mesmo arquivo das tarefas: sincroniza, não aparece nas listas, só na aba Entrada.
# Linhas "- texto" do corpo viram subtarefas e o resto, a descrição. Aprovar a torna aberta (com as subtarefas);
# recusar deixa uma lápide. O id sai do Message-ID e o horário da tarefa é o da mensagem: várias máquinas que
# sincronizam a mesma caixa criam a MESMA tarefa, e aprovar/recusar (hora de agora) vence uma recriação tardia.
# O texto do e-mail é dado não confiável: nunca é executado.
CONF_DEMANDAS=$CONF_DIR/demandas
demandas_receber() { # stdin: linhas de outra máquina (ou a local); funde por e-mail, a hora mais nova vence
  local tmp t=$CONF_DEMANDAS.trava i
  mkdir -p "$CONF_DIR"; touch "$CONF_DEMANDAS"
  tmp=$(mktemp "$CONF_DEMANDAS.XXXXXX") || return 1
  cat >"$tmp.in"
  for ((i = 0; i < 200; i++)); do
    mkdir "$t" 2>/dev/null && break
    (($(idade_arquivo "$t") > 20)) && rmdir "$t" 2>/dev/null
    sleep 0.05
  done
  awk -F'\t' -v OFS='\t' '
    NF >= 5 && $1 ~ /^[^ \t@]+@[^ \t@]+$/ && $3 ~ /^(auth|aberto|segredo|-)$/ && $5 ~ /^[0-9]+$/ {
      k = tolower($1); l = k OFS $2 OFS $3 OFS $4 OFS $5
      if (!(k in ts) || $5 + 0 > ts[k] + 0 || ($5 + 0 == ts[k] + 0 && l > linha[k])) { ts[k] = $5; linha[k] = l }
    }
    END { for (k in linha) print linha[k] }' "$CONF_DEMANDAS" "$tmp.in" 2>/dev/null | sort >"$tmp"
  chmod 600 "$tmp"
  if cmp -s "$tmp" "$CONF_DEMANDAS"; then rm -f "$tmp"; else mv "$tmp" "$CONF_DEMANDAS"; fi
  rm -f "$tmp.in"; rmdir "$t" 2>/dev/null
  return 0
}
demandas_gravar() { # e-mail etiqueta modo segredo — grava aqui com a hora de agora e propaga
  printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$(hora_agora)" | demandas_receber
  (demandas_propagar >/dev/null 2>&1 &)
}
demandas_autorizar() { # e-mail [etiqueta] [auth|segredo|aberto] [segredo]
  local e=${1:-} tag=${2:-} modo=${3:-auth} seg=${4:-}
  e=${e,,}; tag=${tag,,}; tag=${tag#\#}
  [[ $e =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] || { echo "e-mail inválido: ${1:-}" >&2; return 2; }
  [[ -z $tag || $tag =~ ^[a-z0-9_-]+$ ]] || { echo "etiqueta inválida (letras, números, - e _): $2" >&2; return 2; }
  case $modo in
    auth|aberto) seg=- ;;
    segredo) [[ $seg =~ ^[A-Za-z0-9._-]{4,}$ ]] || { echo "o modo segredo precisa de uma palavra de 4+ caracteres (letras, números, . _ -)" >&2; return 2; } ;;
    *) echo "modo inválido: $modo (auth, segredo ou aberto)" >&2; return 2 ;;
  esac
  demandas_gravar "$e" "${tag:--}" "$modo" "${seg:--}"
  echo "autorizado: $e (etiqueta ${tag:+#}${tag:-nenhuma}, modo $modo)"
}
demandas_remover() { # e-mail
  local e=${1:-}; e=${e,,}
  [[ $e == *@* ]] || { echo 'uso: tt --demanda-remover EMAIL' >&2; return 2; }
  demandas_gravar "$e" - - -
  echo "removido: $e"
}
demandas_ativas() { awk -F'\t' '$3 != "-" { n++ } END { exit !n }' "$CONF_DEMANDAS" 2>/dev/null; }
demandas_remetente() { # e-mail -> "etiqueta<TAB>modo<TAB>segredo" (vazio se não autorizado)
  awk -F'\t' -v e="${1,,}" '$1 == e && $3 != "-" { print $2 "\t" $3 "\t" $4 }' "$CONF_DEMANDAS" 2>/dev/null
}
demandas_listar() {
  demandas_ativas || { echo "nenhum remetente autorizado — tt --demanda-autorizar EMAIL [etiqueta] [auth|segredo|aberto] [segredo]"; return 0; }
  awk -F'\t' '$3 != "-" { printf "%-36s etiqueta %-14s modo %s\n", $1, ($2 == "-" ? "(nenhuma)" : "#" $2), $3 }' "$CONF_DEMANDAS"
}
demandas_propagar() {
  local dest rot
  [[ -s $CONF_DEMANDAS ]] || return 0
  while read -r dest rot; do
    (timeout 8 ssh "${SSH_OPC[@]}" "$dest" "$TT_REMOTO --receber-demandas" <"$CONF_DEMANDAS" >/dev/null 2>&1 &)
  done < <(maquinas)
}
demandas_puxar() { nas_maquinas cat_remoto '~/.config/tt/demandas' 6 | demandas_receber; } # junta os cadastros das outras máquinas

# Cria a tarefa PENDENTE de uma mensagem. Imprime o id; sai 1 sem criar se ela já existe (em qualquer
# estado — aprovada, recusada ou ainda pendente) ou se a frase não tem título.
# Com "~CÓDIGO" na frase o e-mail fala de uma tarefa específica (o código é o id, igual em toda máquina):
#  - não existe aqui (ou ainda é pendente): vira a tarefa PENDENTE com esse mesmo código (um e-mail mais
#    novo sobre a mesma pendente a substitui); aprovada, mantém o código e as próximas mensagens a atualizam;
#  - existe (aberta, feita, arquivada): vira uma PROPOSTA DE ATUALIZAÇÃO (pendente, meta upd=CÓDIGO) na
#    aba Entrada; aprovar aplica sobre a tarefa (texto, prazo, prioridade, repetição, etiquetas, descrição
#    e subtarefas por código), recusar não toca nela;
#  - foi removida aqui: ignorada (remoção nunca ressuscita).
# Subtarefas chegam como linhas "cod<TAB>estado<TAB>texto" (cod/estado "-" quando faltam).
demanda_criar() { # de msgid epoch etiqueta frase descrição subtarefas [extras do protocolo v2: linhas k=v]
  local de=$1 msgid=$2 epoch=$3 tag=$4 frase=$5 desc=$6 subs=$7 ext=${8:-} id now t meta tags i=0 scod sest sub sid sm cod est upd="" se vistos=" " v2="" iest="" rem="" d descartada=0 tmp
  id=$(printf 'demanda\0%s' "$msgid" | sha256sum | cut -c1-12)
  tarefas_frase_ler "$frase" || return 1
  cod=$TT_F_COD
  # Código é identidade: o de uma SUBTAREFA nunca é o de uma tarefa. Um "~código" que aponta para uma subtarefa
  # daqui (de qualquer tarefa) não vale; a mensagem é tratada como demanda nova, sem código.
  if [[ -n $cod && -n $(tarefas_pai_de "$cod") ]]; then cod=""; fi
  if [[ -n $cod ]]; then
    est=$(tarefas_estado_de "$cod")
    case $est in
      removida) return 1 ;;
      ""|pendente) id=$cod ;;
      *) upd=$cod ;;
    esac
  fi
  if [[ -z $cod || -n $upd ]]; then
    [[ -z $(tarefas_raw | awk -F'\t' -v id="$id" '$1 == id { print 1; exit }') ]] || return 1
  fi
  now=$(hora_agora); t=$epoch
  [[ $t =~ ^[0-9]+$ ]] && ((t > 0 && t <= now)) || t=$now
  [[ $tag == - ]] && tag=""
  tags=$(printf '%s\n' "$tag" "${TT_F_TAGS//,/$'\n'}" | awk 'NF && !v[$0]++' | paste -sd, -)
  meta=""
  [[ -n $desc ]] && meta=$(tarefas_meta_set "$meta" desc "$(tarefas_b64 "$desc")")
  [[ -n $TT_F_PRAZO ]] && meta=$(tarefas_meta_set "$meta" prazo "$TT_F_PRAZO")
  [[ -n $TT_F_HORA ]] && meta=$(tarefas_meta_set "$meta" hora 1)
  [[ -n $TT_F_PRIO ]] && meta=$(tarefas_meta_set "$meta" prio "$TT_F_PRIO")
  [[ -n $TT_F_REP ]] && meta=$(tarefas_meta_set "$meta" rep "$TT_F_REP")
  [[ -n $tags ]] && meta=$(tarefas_meta_set "$meta" tags "$tags")
  meta=$(tarefas_meta_set "$meta" de "${de//[^A-Za-z0-9._%+@-]/}")
  [[ -n $upd ]] && meta=$(tarefas_meta_set "$meta" upd "$upd")
  # Protocolo v2 (rodapé "tt:2 …" do e-mail): estado da tarefa na origem e subtarefas que ela removeu.
  if [[ $ext == *v2=1* ]]; then
    v2=1; meta=$(tarefas_meta_set "$meta" v2 1)
    iest=$(sed -n 's/^estado=//p' <<<"$ext")
    case $iest in feita) meta=$(tarefas_meta_set "$meta" iest f) ;; aberta) meta=$(tarefas_meta_set "$meta" iest a) ;; esac
    rem=$(sed -n 's/^removidas=//p' <<<"$ext"); [[ -n $rem ]] && meta=$(tarefas_meta_set "$meta" rem "$rem")
  fi
  tarefas_travar || return 1
  mkdir -p "$CONF_DIR"; touch "$CONF_TAREFAS"
  tmp=$(mktemp "$CONF_TAREFAS.XXXXXX")
  {
    tarefas_linhas
    printf '%s\tpendente\t%s\t%s\t%s\t%s\n' "$id" "$t" "$t" "$TT_F_TXT" "$meta"
    while IFS=$'\t' read -r scod sest sub; do
      sub=$(tarefas_limpa_texto "$sub"); [[ -n $sub ]] || continue
      i=$((i + 1)); sid=$(printf 'demanda\0%s\0sub\0%s' "$msgid" "$i" | sha256sum | cut -c1-12)
      sm=$(tarefas_meta_set "" pai "$id"); sm=$(tarefas_meta_set "$sm" ord "$i")
      if [[ $scod =~ ^[0-9a-f]{6,16}$ ]]; then
        if [[ -n $upd ]]; then sm=$(tarefas_meta_set "$sm" scod "$scod")
        else
          # O código que o remetente deu só vale se estiver livre ou já for desta mesma tarefa (pendente que um
          # e-mail mais novo substitui). Se já é de outra coisa (aberta, feita, arquivada, removida, de outra
          # tarefa) ou se repete na própria mensagem, esta subtarefa nasce com código novo: nunca toma o lugar
          # de uma que existe nem ressuscita uma removida.
          se=$(tarefas_estado_de "$scod")
          if [[ $scod != "$id" && $vistos != *" $scod "* ]] &&
             { [[ -z $se ]] || { [[ $se == pendente && $(tarefas_pai_de "$scod") == "$id" ]]; }; }; then sid=$scod
          else sm=$(tarefas_meta_set "$sm" colide "$scod"); fi
          vistos+="$scod "
        fi
      fi
      # [x] vale também na primeira entrega; "[ ]" explícito (só no protocolo v2) é "aberta" de propósito.
      case $sest in f) sm=$(tarefas_meta_set "$sm" sest f) ;; a) [[ -n $v2 ]] && sm=$(tarefas_meta_set "$sm" sest a) ;; esac
      printf '%s\tpendente\t%s\t%s\t%s\t%s\n' "$sid" "$t" "$t" "$sub" "$sm"
    done <<<"$subs"
  } | tarefas_merge /dev/stdin >"$tmp"
  mv "$tmp" "$CONF_TAREFAS"; marcar_tarefas
  tarefas_destravar
  # Triagem das atualizações: sem diferença em relação à tarefa daqui, superada por uma mais nova do mesmo
  # remetente, ou que substitui as velhas dele. A nova que não traz nada de novo não vira demanda (nem aviso).
  if [[ -n $upd ]]; then
    while read -r d; do
      [[ -n $d ]] || continue
      [[ $d == "$id" ]] && descartada=1
      tarefas_demanda_mudar_linhas recusar "$d" >/dev/null
    done < <(python3 -I "$MERGE_PY" triagem "$CONF_TAREFAS" "$id" 2>/dev/null)
    ((descartada)) && return 1
  fi
  atualizar_barras_pedir 2>/dev/null
  ("$EU" --tarefas-espelhar >/dev/null 2>&1 &)
  printf '%s\n' "$id"
}

# Texto de e-mail para compartilhar uma tarefa: o assunto leva a frase e o "~código" (quem recebe, com
# o tt e você como remetente autorizado, ATUALIZA a mesma tarefa em vez de criar outra) e o corpo, a
# descrição e as subtarefas "- [código] [x] texto". Imprime Para/Assunto/corpo e, por último, um link
# mailto: que qualquer cliente abre. Subtarefa: compartilhe a tarefa mãe.
# Abre o e-mail da tarefa JÁ PREENCHIDO (Para, Assunto "[tt] … ~código" e corpo com as subtarefas e o rodapé v2) para o
# dono só conferir e enviar. Ordem: TT_EMAIL_MAILTO_CMD (comando que recebe a URL mailto:, para quem usa outro cliente e
# para testes) → o compositor do tt (aerc, pelo IPC, depois de mostrar a tela de e-mail) → o cliente padrão do sistema →
# só o texto. Uma tarefa por e-mail: cada uma tem a sua conversa e o seu ~código.
tarefa_email_compor() { # id [destinatário] [cliente]
  local id=$1 dest=${2:-} c=${3:-} out url i
  out=$(tarefa_email "$id" "$dest") || return 1
  url=$(tail -n1 <<<"$out")
  if [[ -n ${TT_EMAIL_MAILTO_CMD:-} ]]; then
    local -a cmd; read -ra cmd <<<"$TT_EMAIL_MAILTO_CMD"; "${cmd[@]}" "$url" >/dev/null 2>&1 </dev/null; return $?
  fi
  [[ -n $c ]] || c=$(tmux display-message -p '#{client_name}' 2>/dev/null) || true
  if [[ -n $c && -z ${TT_EMAIL_SEM_POPUP:-} ]]; then
    if tmux has-session -t "=$EMAIL_SESSAO" 2>/dev/null && email_ipc "$url"; then :
    else
      # o popup sobe o aerc; o compositor abre assim que o IPC responder
      ( for ((i = 0; i < 40; i++)); do sleep 0.5; email_ipc "$url" && break; done ) >/dev/null 2>&1 </dev/null &
    fi
    botao_email "$c"; return 0
  fi
  if email_ipc "$url"; then return 0; fi
  if command -v xdg-open >/dev/null && [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]]; then xdg-open "$url" >/dev/null 2>&1 </dev/null & return 0; fi
  printf '%s\n' "$out"
}
# Tela de envio: escolhe tarefas (várias com Tab; ou já vêm nos argumentos) e o(s) destinatário(s); abre um e-mail por tarefa.
tarefas_email_ui() { # [id…]
  local -a ids=("$@"); local dest ult="$ESTADO_DIR/tarefas-email-ultimo" id
  if ((${#ids[@]} == 0)); then
    mapfile -t ids < <(tarefas_topo_ordenadas | awk -F'\t' '$2 == "aberta" || $2 == "feita" { print $1 }' | while read -r id; do
      printf '%s\t%s  %s\n' "$id" "$(tarefa_slug "$id")" "$(tarefas_raw | awk -F'\t' -v i="$id" '$1 == i { print $5; exit }')"; done |
      fzf --multi --delimiter=$'\t' --with-nth=2 --prompt='tarefas a enviar (Tab marca, ⏎ confirma) > ' --height=100% --reverse |
      cut -f1)
  fi
  ((${#ids[@]})) || return 0
  if [[ -n ${TT_EMAIL_PARA:-} ]]; then dest=$TT_EMAIL_PARA   # sem perguntar (scripts, testes)
  else
    printf '\n  Enviar %s tarefa(s) por e-mail. Para quem? (vários separados por vírgula)\n' "${#ids[@]}"
    read -r -e -p '  Para: ' -i "$(cat "$ult" 2>/dev/null)" dest </dev/tty || return 0
  fi
  [[ -n $dest ]] || return 0
  mkdir -p "$ESTADO_DIR"; printf '%s' "$dest" >"$ult"
  for id in "${ids[@]}"; do tarefa_email_compor "$id" "$dest" "${TT_CLIENTE:-}"; done
}
# O diário de trabalho (blocos "⟡ …": máquina, sessão, conta e e-mail, tokens, custo) é do dono e não viaja.
tarefa_desc_sem_log() { awk '/^⟡ /{ l = 1 } l && /^$/ { l = 0; next } !l { print }' | cat -s; }
tarefa_email() { # id [destinatário]
  local id=$1 dest=${2:-} frase desc corpo si sest stxt rem est
  [[ -n $(tarefas_pai_de "$id") ]] && { echo "é subtarefa: compartilhe a tarefa mãe ($(tarefa_slug "$(tarefas_pai_de "$id")"))" >&2; return 1; }
  frase=$(tarefas_frase_de "$id") || { echo "tarefa $id não existe" >&2; return 1; }
  desc=$(tarefa_get_desc "$id" | tarefa_desc_sem_log | sed -E 's/^([[:space:]]*)[-*•][[:space:]]/\1– /')
  corpo=${desc:+$desc$'\n\n'}
  while IFS=$'\t' read -r si sest stxt; do
    [[ -n $si ]] || continue
    corpo+="- [$si] [$([[ $sest == feita ]] && echo x || echo ' ')] $stxt"$'\n'
  done < <(tarefas_filhas "$id")
  # Protocolo v2: depois da assinatura ("-- ", que um tt antigo e qualquer leitor ignoram) vai o estado da tarefa
  # e os códigos das subtarefas que foram removidas aqui, para quem recebe poder propor a mesma remoção.
  est=$(tarefas_estado_de "$id"); [[ $est == feita ]] || est=aberta
  rem=$(tarefas_raw | awk -F'\t' -v p="$id" '
    function mv(m, k,   n, a, i) { n = split(m, a, "|"); for (i = 1; i <= n; i++) if (index(a[i], k "=") == 1) return substr(a[i], length(k) + 2); return "" }
    $2 == "removida" && mv($6, "pai") == p { print $4 "\t" $1 }' | sort -rn | head -30 | cut -f2 | paste -sd, -)
  corpo+=$'\n-- \n'"tt:2 estado=$est${rem:+ removidas=$rem}"$'\n'
  frase="[tt] $frase ~$id"
  printf 'Para: %s\nAssunto: %s\n\n%s\n' "$dest" "$frase" "$corpo"
  python3 -I -c 'import sys,urllib.parse as u; print("mailto:"+u.quote(sys.argv[1])+"?subject="+u.quote(sys.argv[2])+"&body="+u.quote(sys.argv[3]))' "$dest" "$frase" "$corpo"
  # a versão enviada é a base do próximo confronto
  tarefa_base_gravar "$id" 2>/dev/null || true
}

# Aplica uma proposta de atualização (linha pendente com upd=CÓDIGO) na tarefa alvo; não mexe na
# proposta (quem chama a descarta). Campos do e-mail valem inteiros: marcador ausente tira o atributo
# (como ✎ Editar); a descrição só muda se o e-mail trouxe uma. Subtarefas: com código, atualiza a que já
# é filha desta tarefa ou cria com esse código (removida não ressuscita); sem código, acrescenta se não
# houver uma de mesmo texto. Alvo que sumiu/removido: não cria nada.
# Grava de uma vez linhas de tarefa novas (stdin, TSV de 6 campos): para cada id vale a de "mudada" mais nova.
tarefas_aplicar_linhas() {
  local novas tmp; novas=$(cat); [[ -n $novas ]] || return 0
  tarefas_travar || return 1
  mkdir -p "$CONF_DIR"; touch "$CONF_TAREFAS"
  tmp=$(mktemp "$CONF_TAREFAS.XXXXXX")
  { tarefas_linhas; printf '%s\n' "$novas"; } | tarefas_merge /dev/stdin >"$tmp"
  mv "$tmp" "$CONF_TAREFAS"; marcar_tarefas
  tarefas_destravar
  atualizar_barras_pedir 2>/dev/null
  ("$EU" --tarefas-espelhar >/dev/null 2>&1 &)
}
# "id:situação:mudanças:conflitos" de cada atualização pendente (situação: igual|limpo|conflito), para a aba Entrada.
tarefas_props_resumo() {
  local p r a b c
  for p in $(tarefas_raw | awk -F'\t' '$2 == "pendente" && $6 ~ /(^|\|)upd=/ && $6 !~ /(^|\|)pai=/ { print $1 }'); do
    r=$(python3 -I "$MERGE_PY" estado "$CONF_TAREFAS" "$p" 2>/dev/null) || continue
    IFS=$'\t' read -r a b c <<<"$r"; printf '%s:%s:%s:%s ' "$p" "$a" "$b" "$c"
  done
}
# Aprova de uma vez tudo o que está na Entrada e não tem conflito (demandas novas e atualizações sem conflito). Imprime quantas.
tarefas_aprovar_limpas() {
  local id st; local -a ids=()
  while read -r id; do
    [[ -n $id ]] || continue
    if [[ -n $(tarefas_meta_get "$(tarefas_meta_de "$id")" upd) ]]; then
      st=$(python3 -I "$MERGE_PY" estado "$CONF_TAREFAS" "$id" 2>/dev/null | cut -f1); [[ $st == conflito ]] && continue
    fi
    ids+=("$id")
  done < <(tarefas_raw | awk -F'\t' '$2 == "pendente" && $6 !~ /(^|\|)pai=/ { print $1 }')
  if ((${#ids[@]})); then tarefas_demanda_mudar aprovar "${ids[@]}"; else echo 0; fi
}
tarefas_recusar_todas() {
  local -a ids; mapfile -t ids < <(tarefas_raw | awk -F'\t' '$2 == "pendente" && $6 !~ /(^|\|)pai=/ { print $1 }')
  if ((${#ids[@]})); then tarefas_demanda_mudar recusar "${ids[@]}"; else echo 0; fi
}
# A tela de revisão de UMA atualização (vim): decide campo a campo e subtarefa a subtarefa, e aplica.
tarefas_merge_ui() { # id-da-proposta
  local pid=$1 plano dec rc=0
  [[ -n $(tarefas_meta_get "$(tarefas_meta_de "$pid")" upd) && $(tarefas_estado_de "$pid") == pendente ]] || { echo "não é uma atualização pendente: $pid" >&2; return 1; }
  # Modo não interativo (testes/automação): deixe a política ser resolvida pelo aplicador
  # de três vias, sem depender da UI do Vim.
  if [[ ${TT_MERGE_AUTO:-} == inc || ${TT_MERGE_AUTO:-} == cur ]]; then
    tarefa_aplicar_proposta "$pid" --padrao "$TT_MERGE_AUTO" || { echo "atualização mantida na Entrada (nada foi alterado)" >&2; return 1; }
    tarefas_demanda_mudar_linhas recusar "$pid" >/dev/null
    echo "✓ atualização aplicada"
    return 0
  fi
  plano=$(mktemp "${TMPDIR:-/tmp}/tt-merge-plano.XXXXXX"); dec=$(mktemp "${TMPDIR:-/tmp}/tt-merge-dec.XXXXXX"); : >"$dec"
  python3 -I "$MERGE_PY" plano "$CONF_TAREFAS" "$pid" >"$plano" || { rm -f "$plano" "$dec"; return 1; }
  if [[ -n ${TT_MERGE_AUTO:-} ]] && command -v vim >/dev/null; then
    TT_MERGE_PLANO=$plano TT_MERGE_SAIDA=$dec vim -es -u NONE -N -S "$DIR_TT/tarefas-merge.vim" </dev/null >/dev/null 2>&1 || rc=$?
  elif command -v vim >/dev/null && { : >/dev/tty; } 2>/dev/null; then
    vimrc_tt_garantir
    TT_MERGE_PLANO=$plano TT_MERGE_SAIDA=$dec vim -u "$DIR_TT/vimrc-tt" -S "$DIR_TT/tarefas-merge.vim" </dev/tty >/dev/tty 2>&1 || rc=$?
  else
    tarefas_merge_prompt "$plano" "$dec" || rc=$?
  fi
  if ((rc == 0)) && [[ -s $dec ]]; then
    if tarefa_aplicar_proposta "$pid" --decisoes "$dec"; then
      tarefas_demanda_mudar_linhas recusar "$pid" >/dev/null
      echo "✓ atualização aplicada"; rm -f "$plano" "$dec"; return 0
    fi
    rc=1
  fi
  rm -f "$plano" "$dec"
  echo "atualização mantida na Entrada (nada foi alterado)" >&2
  return $((rc == 0 ? 1 : rc))
}
# Sem vim (ou sem terminal): pergunta um conflito por vez, no terminal. r recebida · m minha · b as duas · q cancela.
tarefas_merge_prompt() { # plano decisoes
  local plano=$1 dec=$2 id grupo rot st cur inc base padrao opc r
  while IFS=$'\t' read -r id grupo rot st cur inc base padrao opc; do
    [[ $id == '#' || -z $id || $st == minha ]] && continue
    if [[ $st == entrada ]]; then printf '%s\tinc\t\n' "$id" >>"$dec"; continue; fi
    printf '\n⚡ %s\n   minha:    %s\n   recebida: %s\n' "$rot" "$cur" "$inc" >&2
    while :; do
      read -r -n1 -p "   [r]ecebida · [m]inha$([[ ,$opc, == *,ambas,* ]] && echo ' · [b] as duas') · [q] cancela > " r </dev/tty 2>/dev/null || return 1
      echo >&2
      case $r in
        r) printf '%s\tinc\t\n' "$id" >>"$dec"; break ;;
        m) printf '%s\tcur\t\n' "$id" >>"$dec"; break ;;
        b) [[ ,$opc, == *,ambas,* ]] && { printf '%s\tambas\t\n' "$id" >>"$dec"; break; } ;;
        q) : >"$dec"; return 1 ;;
      esac
    done
  done <"$plano"
  return 0
}
# Grava a "base" da tarefa (o estado de agora) para o próximo confronto em três vias.
tarefa_base_gravar() { # id
  local linha; linha=$(python3 -I "$MERGE_PY" base "$CONF_TAREFAS" "$1" --agora "$(hora_agora)" 2>/dev/null) || return 1
  tarefas_aplicar_linhas <<<"$linha"
}
tarefa_aplicar_proposta_antiga() { # (substituída por tarefa_aplicar_proposta; mantida só para consulta) id-da-proposta
  local pid=$1 txt m alvo ealvo tm k scod sest si sm se sub sord sd
  IFS=$'\t' read -r txt m < <(tarefas_raw | awk -F'\t' -v id="$pid" '$1==id{print $5"\t"($6==""?"-":$6); exit}')
  [[ -n $txt ]] || return 1
  [[ $m == - ]] && m=""
  alvo=$(tarefas_meta_get "$m" upd); [[ -n $alvo ]] || return 1
  ealvo=$(tarefas_estado_de "$alvo")
  [[ -n $ealvo && $ealvo != removida && $ealvo != pendente ]] || return 1
  tm=$(tarefas_meta_de "$alvo")
  for k in prazo hora prio rep tags; do tm=$(tarefas_meta_set "$tm" "$k" "$(tarefas_meta_get "$m" "$k")"); done
  sd=$(tarefas_meta_get "$m" desc); [[ -n $sd ]] && tm=$(tarefas_meta_set "$tm" desc "$sd")
  tarefas_gravar_linha "$alvo" "$ealvo" "$txt" "$tm" || return 1
  while IFS=$'\t' read -r si sord sub scod sest; do
    [[ -n $si ]] || continue
    if [[ -n $scod ]]; then
      se=$(tarefas_estado_de "$scod")
      if [[ -z $se ]]; then
        sm=$(tarefas_meta_set "" pai "$alvo"); sm=$(tarefas_meta_set "$sm" ord "$(tarefas_sub_proxima_ord "$alvo")")
        tarefas_gravar_linha "$scod" "$([[ $sest == f ]] && echo feita || echo aberta)" "$sub" "$sm"
      elif [[ $se != removida && $(tarefas_pai_de "$scod") == "$alvo" ]]; then
        sm=$(tarefas_meta_de "$scod")
        tarefas_gravar_linha "$scod" "$([[ $sest == f ]] && echo feita || echo "$se")" "$sub" "$sm"
      elif ! { [[ $se == removida ]] && [[ $(tarefas_pai_de "$scod") == "$alvo" ]]; }; then
        # O código é de outra coisa (subtarefa de outra tarefa, ou uma tarefa): não mexe nela. A subtarefa entra
        # como nova, com código daqui, se a tarefa ainda não tem uma de mesmo texto. (Removida DESTA tarefa:
        # foi apagada de propósito, não volta.)
        tarefas_filhas "$alvo" | awk -F'\t' -v t="${sub,,}" 'tolower($3) == t { f = 1 } END { exit !f }' ||
          { tarefa_add_sub "$alvo" "$sub" >/dev/null; }
      fi
    else
      tarefas_filhas "$alvo" | awk -F'\t' -v t="${sub,,}" 'tolower($3) == t { f = 1 } END { exit !f }' ||
        { tarefa_add_sub "$alvo" "$sub" >/dev/null   ; }
    fi
  done < <(tarefas_raw | awk -F'\t' -v p="$pid" '
    function mv(m, k,   n, a, i) { n = split(m, a, "|"); for (i = 1; i <= n; i++) if (index(a[i], k "=") == 1) return substr(a[i], length(k) + 2); return "" }
    mv($6, "pai") == p && $2 == "pendente" { printf "%s\t%d\t%s\t%s\t%s\n", $1, mv($6, "ord") + 0, $5, mv($6, "scod"), mv($6, "sest") }' | sort -t$'\t' -k2,2n |
    awk -F'\t' -v OFS='\t' '{ print $1, $2, $3, $4, $5 }')
  # Mãe feita com subtarefa aberta (nova ou reaberta): volta a ficar aberta.
  if [[ $(tarefas_estado_de "$alvo") == feita ]] && [[ -n $(tarefas_subs_abertas "$alvo") ]]; then tarefa_estado "$alvo" aberta; fi
  return 0
}

# Aplica uma proposta de atualização (linha pendente com upd=CÓDIGO) na tarefa alvo, em TRÊS VIAS (tarefas-merge.py):
# o que só o e-mail mudou entra, o que só você mudou fica, e o que os dois mudaram é conflito (sai com 3, sem
# gravar nada, a menos que venha --padrao inc|cur ou --decisoes ARQ). Grava a base nova (a versão que chegou).
# Não mexe na proposta (quem chama a descarta).
tarefa_aplicar_proposta() { # id-da-proposta [--padrao inc|cur] [--decisoes ARQ]
  local pid=$1 linhas; shift
  linhas=$(python3 -I "$MERGE_PY" aplicar "$CONF_TAREFAS" "$pid" --agora "$(hora_agora)" "$@") || return $?
  tarefas_aplicar_linhas <<<"$linhas"
}

# Olha as mensagens ainda não vistas de uma caixa com espelho local e cria as demandas. Sem remetente
# cadastrado não faz nada (custo zero). Na 1ª vez numa caixa, o que chegou há mais de 1 dia já passou.
demandas_processar_conta() { # slug
  local slug=${1:?} md dir proc log authwait u arq de msgid epoch auth asb dsb ssb assunto frase desc subs info tag modo seg segmsg
  local n=0 criadas=0 ignoradas=0 esperando=0 quem="" id nome="" ultimo="" ext esb k k_criadas="" k_esperando="" k_ignoradas=""
  # Roda mesmo sem nenhum remetente autorizado: um e-mail [tt] que chega antes de a pessoa autorizar alguém
  # fica à espera (e ela é avisada). Antes, sem cadastro nada era lido, e ao autorizar depois a primeira
  # leitura dava como visto tudo o que tinha mais de 1 dia: a tarefa mandada por um colega se perdia calada.
  md=$(email_maildir "$slug")/INBOX; dir="$ESTADO_DIR/email-sync"; proc="$dir/$slug.demandas"; log="$dir/$slug.demandas.log"
  local espera="$dir/$slug.demandas.espera" liberar liberar_auth
  authwait="$dir/$slug.demandas.auth-espera"
  [[ -d $md/new || -d $md/cur ]] || return 0
  mkdir -p "$dir"
  [[ -f $proc ]] || find "$md/new" "$md/cur" -type f -mmin +1440 -printf '%f\n' 2>/dev/null | sed 's/:2,.*//' | sort -u >"$proc"
  # E-mail [tt] de quem ainda não estava autorizado fica em <slug>.demandas.espera (id<TAB>remetente). Quando o
  # remetente passa a valer (autorizado aqui, pela tela ou vindo de outra máquina), o e-mail sai da lista de
  # vistos e é lido de novo nesta volta: antes ele ficava marcado como visto e se perdia para sempre.
  if [[ -s $espera ]]; then
    liberar=$(while IFS=$'\t' read -r u de; do [[ -n $u && -n $(demandas_remetente "$de") ]] && printf '%s\n' "$u"; done <"$espera")
    if [[ -n $liberar ]]; then
      printf '%s\n' "$liberar" >"$espera.lib"
      grep -vxF -f "$espera.lib" "$proc" >"$proc.tmp"; mv -f "$proc.tmp" "$proc"
      awk -F'\t' 'FILENAME == ARGV[1] { l[$1] = 1; next } !($1 in l)' "$espera.lib" "$espera" >"$espera.tmp"; mv -f "$espera.tmp" "$espera"
      rm -f "$espera.lib"
      printf '%s liberadas %s (remetente autorizado depois da chegada)\n' "$(date '+%F %T')" "$(wc -l <<<"$liberar")" >>"$log"
    fi
  fi
  # Mensagens Graph cujo espelho anterior não trazia Authentication-Results são reavaliadas
  # após cada sync. Não afrouxamos o modo auth: sem prova válida, continuam aguardando.
  if [[ -s $authwait ]]; then
    liberar_auth=$(awk -F '\t' '{print $1}' "$authwait" | sort -u)
    if [[ -n $liberar_auth ]]; then
      printf '%s\n' "$liberar_auth" >"$authwait.ids"
      grep -vxF -f "$authwait.ids" "$proc" >"$proc.tmp"; mv -f "$proc.tmp" "$proc"
      rm -f "$authwait.ids"
    fi
  fi
  while IFS=$'\t' read -r u arq; do
    [[ -n $u ]] || continue
    n=$((n + 1)); ((n <= 25)) || break
    printf '%s\n' "$u" >>"$proc"
    IFS=$'\t' read -r de msgid epoch auth asb dsb ssb esb < <(python3 -I "$EMAIL_PY" demanda "$arq" 2>/dev/null) || continue
    assunto=$(printf '%s' "$asb" | base64 -d 2>/dev/null)
    [[ $assunto =~ ^\[[Tt][Tt](:([^]]*))?\][[:space:]]*(.*)$ ]] || continue
    segmsg=${BASH_REMATCH[2]}; frase=${BASH_REMATCH[3]}
    # chave da mensagem para o aviso de lote (igual em toda máquina que espelha a caixa: é a do demanda_criar)
    k=$(printf 'demanda\0%s' "$msgid" | sha256sum | cut -c1-12)
    info=$(demandas_remetente "$de")
    if [[ -z $info ]]; then
      [[ $de == - || -z $de ]] && continue
      printf '%s\t%s\n' "$u" "${de,,}" >>"$espera"
      printf '%s aguardando autorização de=%s (tt --demanda-autorizar %s)\n' "$(date '+%F %T')" "$de" "$de" >>"$log"
      esperando=$((esperando + 1)); quem=$de; k_esperando+="${k_esperando:+,}$k"
      continue
    fi
    IFS=$'\t' read -r tag modo seg <<<"$info"
    case $modo in
      auth)
        if [[ $auth == none ]]; then
          if ! awk -F '\t' -v u="$u" '$1 == u { found=1 } END { exit !found }' "$authwait" 2>/dev/null; then
            printf '%s\t%s\n' "$u" "${de,,}" >>"$authwait"
            printf '%s aguardando cabeçalho de autenticação de=%s\n' "$(date '+%F %T')" "$de" >>"$log"
          fi
          continue
        fi
        [[ $auth == pass ]] || { awk -F '\t' -v u="$u" '$1 != u' "$authwait" >"$authwait.tmp" 2>/dev/null || :; [[ -f $authwait.tmp ]] && mv -f "$authwait.tmp" "$authwait"; ignoradas=$((ignoradas + 1)); k_ignoradas+="${k_ignoradas:+,}$k"; printf '%s ignorada de=%s motivo=autenticacao(%s)\n' "$(date '+%F %T')" "$de" "$auth" >>"$log"; continue; } ;;
      segredo) [[ $seg != - && $segmsg == "$seg" ]] || { ignoradas=$((ignoradas + 1)); k_ignoradas+="${k_ignoradas:+,}$k"; printf '%s ignorada de=%s motivo=segredo\n' "$(date '+%F %T')" "$de" >>"$log"; continue; } ;;
      aberto) ;;
      *) continue ;;
    esac
    if [[ -s $authwait ]]; then awk -F '\t' -v u="$u" '$1 != u' "$authwait" >"$authwait.tmp" && mv -f "$authwait.tmp" "$authwait"; fi
    [[ $dsb == - ]] && dsb=""; [[ $ssb == - ]] && ssb=""; [[ ${esb:--} == - ]] && esb=""
    desc=$(printf '%s' "$dsb" | base64 -d 2>/dev/null); subs=$(printf '%s' "$ssb" | base64 -d 2>/dev/null)
    ext=$(printf '%s' "$esb" | base64 -d 2>/dev/null)
    id=$(demanda_criar "$de" "$msgid" "$epoch" "$tag" "$frase" "$desc" "$subs" "$ext") || continue
    criadas=$((criadas + 1)); ultimo="$de — $frase"; k_criadas+="${k_criadas:+,}$k"
    printf '%s criada id=%s de=%s\n' "$(date '+%F %T')" "$id" "$de" >>"$log"
  done < <(find "$md/new" "$md/cur" -type f -printf '%f\t%p\n' 2>/dev/null |
           awk -F'\t' -v p="$proc" 'FILENAME == p { v[$1] = 1; next } { u = $1; sub(/:2,.*/, "", u); if (!(u in v)) print u "\t" $2 }' "$proc" -)
  [[ -f $log ]] && (($(wc -l <"$log") > 300)) && { tail -n 150 "$log" >"$log.c" && mv -f "$log.c" "$log"; }
  [[ -f $espera ]] && (($(wc -l <"$espera") > 500)) && { tail -n 300 "$espera" >"$espera.c" && mv -f "$espera.c" "$espera"; }
  # Toda máquina que espelha a caixa lê o mesmo e-mail: os avisos são de lote (código com a chave de cada
  # mensagem), um só no 🔔 da rede.
  if ((criadas > 0)); then
    tarefas_notificar "📥 $criadas nova$( ((criadas > 1)) && echo s) demanda$( ((criadas > 1)) && echo s)" "$ultimo — aprove na aba Entrada" "demandas" "" "" "demandas-$slug#$k_criadas"
  fi
  if ((esperando > 0)); then
    tarefas_notificar "📥 Tarefa por e-mail de $quem aguardando sua autorização" "só se você confia no remetente: tt --demanda-autorizar $quem (ela entra na aba Entrada)" "demandas" "" "" "demandas-espera-$slug#$k_esperando"
  fi
  if ((ignoradas > 0)); then
    tarefas_notificar "⚠ $ignoradas e-mail$( ((ignoradas > 1)) && echo s) de remetente autorizado ignorado$( ((ignoradas > 1)) && echo s)" "sem a autenticação exigida (veja tt --demandas)" "" "" "" "demandas-ignoradas-$slug#$k_ignoradas"
  fi
  return 0
}
