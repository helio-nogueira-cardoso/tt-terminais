  printf '\t   A aba %sAgenda%s lista o que tem prazo, dia a dia, pela hora;\n' "$y" "$z"
  printf '\t   %s▦ Calendário%s (e o relógio da barra) mostra o mês com • nos\n' "$y" "$z"
  printf '\t   dias com tarefas e cria tarefas no dia e na hora escolhidos.\n'
  printf '\t\n\t %sMOUSE%s\n' "$a" "$z"
  printf '\t   %sclique%s numa tarefa      com subtarefas, abre/fecha (▸ ▾); sem, só seleciona\n' "$n" "$z"
  printf '\t   %sduplo clique%s            marca/desmarca como feita\n' "$n" "$z"
  printf '\t   %sbotão direito%s           menu com todas as ações\n' "$n" "$z"
  printf '\t   clique numa %ssubtarefa%s   marca/desmarca\n' "$n" "$z"
  printf '\t   abas, botões do topo (+ Nova, ↳ Sub, ✎ Editar, ◷ Prazo, ✦ IA;\n'
  printf '\t   à direita ▦ calendário, ? ajuda e ⋯ Mais, com as demais ações),\n'
  printf '\t   títulos de dia da Agenda e as linhas de\n'
  printf '\t   uma tarefa aberta e o %s⋯ menu%s discreto à direita dela também\n' "$a" "$z"
  printf '\t   são clicáveis\n'
  printf '\t\n\t %sTECLADO%s\n' "$a" "$z"
  printf '\t   %s⏎%s feita/aberta   %s→ ␣%s abre   %s←%s fecha   %sTab%s próxima aba\n' "$y" "$z" "$y" "$z" "$y" "$z" "$y" "$z"
  printf '\t   %s^n%s nova   %s^s%s subtarefa   %s^e%s descrição   %s^d%s prazo   %sF2%s editar\n' "$y" "$z" "$y" "$z" "$y" "$z" "$y" "$z" "$y" "$z"
  printf '\t   %s^p%s prioridade   %s^r%s repetir   %s^k ^j%s sobe/desce   %s^x%s apaga\n' "$y" "$z" "$y" "$z" "$y" "$z" "$y" "$z"
  printf '\t   %s^z%s desfaz a última conclusão (volta um ciclo de uma tarefa que repete)\n' "$y" "$z"
  printf '\t   %s^t%s calendário   %s^o%s mais ações   %s^l%s arquiva/apaga as feitas   %s^/%s descrição\n' "$y" "$z" "$y" "$z" "$y" "$z" "$y" "$z"
  printf '\t   %s^g%s implementa com a melhor IA (a tarefa e as subtarefas, numa sessão nova)\n' "$y" "$z"
  printf '\t   %s?%s ajuda   %sesc%s volta/fecha\n' "$y" "$z" "$y" "$z"
  printf '\t   %s(^n = Ctrl+N)%s\n' "$d" "$z"
  printf '\t\n\t %sSÍMBOLOS%s\n' "$a" "$z"
  printf '\t   %s☐%s aberta   %s☑%s feita   %s▸%s fechada   %s▾%s aberta (▸ apagado: sem subtarefas)\n' "$t" "$z" "$verde" "$z" "$a" "$z" "$a" "$z"
  printf '\t   %s●%s prioridade alta   %s●%s média   %s◷ sex 14:00%s prazo   %s◷ venceu%s atrasada\n' "$verm" "$z" "$y" "$z" "$s" "$z" "$verm" "$z"
  printf '\t   %s↻%s repete   %s━━━%s%s━━━%s 1/2 subtarefas feitas   %s≡%s tem descrição   %s#tag%s\n' "$teal" "$z" "$teal" "$z" "$d" "$z" "$s" "$z" "$lil" "$z"
  printf '\t\n\t %sSINCRONIA%s\n' "$a" "$z"
  printf '\t   As tarefas vão para as suas outras máquinas sozinhas: P2P,\n'
  printf '\t   um repositório git seu (com histórico), os dois ou desligado.\n'
  printf '\t   Configure no menu ⋯ da barra → 🔄, ou tt --tarefas-sync.\n'
  printf '\t   O botão 📋 da barra fica vermelho (⚠ N) quando algo vence hoje.\n'
}

# Menu de ações de uma tarefa, no próprio painel (botão direito, "⋯ mais ações" ou o botão ⋯ Mais).
tarefas_menu_linhas() { # id
  local id=$1 est txt m pai prazo prio rep pr
  IFS=$'\t' read -r est txt m < <(tarefas_raw | awk -F'\t' -v id="$id" '$1==id{print $2"\t"$5"\t"($6==""?"-":$6); exit}')
  [[ -n $est ]] || { printf 'voltar\t ‹ voltar (a tarefa não existe mais)\n'; return 0; }
  [[ $m == - ]] && m=""
  pai=$(tarefas_meta_get "$m" pai); prazo=$(tarefas_meta_get "$m" prazo)
  prio=$(tarefas_meta_get "$m" prio); rep=$(tarefas_meta_get "$m" rep)
  local z=$'\e[0m' t=$'\e[38;2;205;214;244m' d=$'\e[38;2;108;112;134m' a=$'\e[38;2;137;180;250m'
  local y=$'\e[38;2;249;226;175m' r=$'\e[38;2;243;139;168m' g=$'\e[38;2;166;227;161m' s=$'\e[38;2;166;173;200m'
  local n=$'\e[1m'
  _op() { # ação rótulo [dica]
    printf 'act:%s:%s\t   %s%s%s\n' "$1" "$id" "$2" "$z" "${3:+  $d$3$z}"
  }
  _escolha() { # ação marcado rótulo
    if [[ $2 == 1 ]]; then printf 'act:%s:%s\t     %s● %s%s\n' "$1" "$id" "$a$n" "$3" "$z"
    else printf 'act:%s:%s\t     %s○ %s%s\n' "$1" "$id" "$d" "$t$3" "$z"; fi
  }
  printf 'voltar\t %s‹ voltar para a lista%s\n' "$a$n" "$z"
  printf '\t   %s⌗ %s%s%s · %s%s\n\t\n' "$d" "$s" "$(tarefa_slug "$id")" "$d" "$id" "$z"
  if [[ $est == arquivada ]]; then
    _op restaurar "$a↩ Restaurar para a lista" 'volta com as subtarefas, como estava'
    _op apagar "$r✕ Apagar de vez…" 'sem histórico'
    return 0
  fi
  local nfalta; nfalta=$(tarefas_subs_abertas "$id" | grep -c . || true)
  local ant; ant=$(tarefas_meta_get "$m" ant)
  [[ -n $ant ]] && _op desfazer "$a↶ Desfazer a última conclusão" "^z · o prazo volta para $(tarefas_prazo_texto "${ant##*,}" "$(tarefas_meta_get "$m" hora)")"
  if [[ $est == feita ]]; then _op feita "$t↺ Reabrir (marcar como não feita)" '⏎'
  elif ((nfalta > 0)); then _op feita "$d☑ Marcar como feita" "falta$( ((nfalta > 1)) && echo m) $nfalta subtarefa$( ((nfalta > 1)) && echo s)"
  else _op feita "$g☑ Marcar como feita" '⏎ ou duplo clique'; fi
  if [[ -z $pai ]]; then _op editar "$t✎ Editar…" 'F2 · texto e @prazo !prioridade *repetir #etiqueta'
  else _op editar "$t✎ Editar…" 'F2 · o texto'; fi
  [[ -n $(tarefas_meta_get "$m" desc) ]] && _op ver "$t≡ Ver a descrição (cartão)" '^/'
  _op desc "$t✎ Descrição…" "$([[ -n $(tarefas_meta_get "$m" desc) ]] && echo 'editar · ^e' || echo 'escrever · ^e')"
  [[ -z $pai ]] && _op sub "$t↳ Adicionar subtarefa…" '^s'
  [[ -z $pai ]] && _op email "$t✉ Enviar por e-mail…" 'a tarefa e as subtarefas, já com os códigos (quem recebe atualiza em vez de duplicar)'
  if [[ -z $pai ]]; then
    pr=$([[ -n $prazo ]] && tarefas_prazo_texto "$prazo" "$(tarefas_meta_get "$m" hora)")
    _op prazo "$t◷ Prazo e horário…" "${pr:-sem prazo} · ^d"
    printf '\t\n\t   %sPrioridade%s %s(^p alterna)%s\n' "$s" "$z" "$d" "$z"
    _escolha prio1 "$([[ $prio == 1 ]] && echo 1)" "${r}●$z$t Alta"
    _escolha prio2 "$([[ $prio == 2 ]] && echo 1)" "${y}●$z$t Média"
    _escolha prio0 "$([[ -z $prio ]] && echo 1)" 'Sem prioridade'
    printf '\t\n\t   %sRepetir%s %s(ao concluir, o prazo avança · ^r alterna)%s\n' "$s" "$z" "$d" "$z"
    _escolha rep0 "$([[ -z $rep ]] && echo 1)" 'Não repete'
    _escolha repd "$([[ $rep == d ]] && echo 1)" 'Todo dia'
    _escolha repw "$([[ $rep == w ]] && echo 1)" 'Toda semana'
    _escolha repm "$([[ $rep == m ]] && echo 1)" 'Todo mês'
    printf '\t\n'
  fi
  [[ $est == aberta ]] && _op ia "$a🤖 Implementar com a melhor IA" "$([[ -z $pai ]] && echo 'a tarefa e todas as subtarefas · ^g' || echo 'esta subtarefa · ^g')"
  _op cima "$t↑ Subir" '^k'
  _op baixo "$t↓ Descer" '^j'
  [[ -z $pai ]] && _op arquivar "$t▤ Arquivar" 'sai da lista e fica no histórico (aba Arquivo)'
  _op apagar "$r✕ Apagar…" '^x · sem histórico'
}

# O id da tarefa por trás de uma chave de linha ("desc:ID", "sub:ID", "menu:ID" ou o próprio ID).
tarefas_id_da_chave() {
  case $1 in
    desc:*|sub:*|menu:*|rest:*|apag:*|apv:*|rec:*|rev:*) echo "${1#*:}" ;;
    act:*) echo "${1##*:}" ;;
    criar|voltar|dia:*|'') : ;;
    *) echo "$1" ;;
  esac
}

# É tarefa de topo (sem mãe)? Imprime a mãe quando é subtarefa.
tarefas_pai_de() { tarefas_meta_get "$(tarefas_meta_de "$1")" pai; }

# Despachante único do painel: recebe o evento (tecla, clique ou botão) e a chave da linha em foco e
# imprime as ações que o fzf deve executar. Lê a busca em FZF_QUERY.
# Cada tecla do painel era três tt: a ação, a lista (reload) e o cabeçalho (transform-header), ~200 ms com a
# partida rápida. A ação já tem o tt carregado: depois dela, gera a lista e o cabeçalho em arquivos e o fzf
# só os lê (cat). Só quando o resultado é certo: busca vazia, e nada antes da recarga que mude o estado ou a
# busca depois (execute de um editor ou prompt, put, change-query, transform…); senão, o comando de sempre.
tarefa_acao() { # evento chave
  local saida antes f ini c ms agora
  ini=${EPOCHREALTIME:-$(date +%s).0}; ini=${ini/[.,]/}; ini=$((10#${ini:0:13}))
  saida=$(tarefa_acao_ "$@")
  if [[ $saida == *@@TT_RL@@* || $saida == *@@TT_HD@@* ]]; then
    antes=${saida%%@@TT_[RH][LD]@@*}; antes=${antes//clear-query/} # com a busca vazia, limpá-la não muda nada
    if [[ -z ${FZF_QUERY:-} && $antes != *@(execute|become|put\(|query|transform|reload|print|accept)* ]]; then
      if [[ $saida == *@@TT_RL@@* ]] && f=$(mktemp "$RT/tt-menu.tarefas.XXXXXX"); then
        tarefas_lista_fzf "" >"$f"; saida=${saida//@@TT_RL@@/"reload-sync(cat '$f'; rm -f '$f')"}
      fi
      if [[ $saida == *@@TT_HD@@* ]] && f=$(mktemp "$RT/tt-menu.tarefas.XXXXXX"); then
        tarefas_cabecalho >"$f"; saida=${saida//@@TT_HD@@/"transform-header(cat '$f'; rm -f '$f')"}
      fi
    fi
    saida=${saida//@@TT_RL@@/"reload-sync($EU --tarefas-lista {q})"}
    saida=${saida//@@TT_HD@@/"transform-header($EU --tarefas-cabecalho)"}
  fi
  # Duplo clique (tarefa_acao_): a janela conta do FIM deste clique, com a lista e o cabeçalho já prontos, e não do
  # começo. O fzf só entrega o 2º clique quando este termina; contado do começo, o tempo do próprio tt entrava nos
  # 400 ms, e numa máquina carregada dois cliques rápidos viravam dois simples. Só a marca gravada agora é renovada.
  if [[ ${1:-} == clique ]]; then
    read -r c ms <<<"$(tarefas_ui_get clique)"
    if [[ -n $c && $ms =~ ^[0-9]+$ ]] && ((ms >= ini)); then
      agora=${EPOCHREALTIME:-$(date +%s).0}; agora=${agora/[.,]/}; tarefas_ui_set clique "$c $((10#${agora:0:13}))"
    fi
  fi
  [[ -n $saida ]] && printf '%s\n' "$saida"
  return 0
}
tarefa_acao_() { # evento chave (o despachante; tarefa_acao trata as recargas)
  local ev=$1 chave=${2:-} qy=${FZF_QUERY:-} modo id pai
  [[ -n ${TT_TAREFAS_LOG:-} ]] && printf '%s ev=%s chave=%s q=%s\n' "$(date +%T.%N)" "$ev" "$chave" "$qy" >>"$TT_TAREFAS_LOG"
  local rl=@@TT_RL@@ hd=@@TT_HD@@
  modo=$(tarefas_ui_get modo); modo=${modo:-lista}
  id=$(tarefas_id_da_chave "$chave")
  # Teclas que também servem para digitar na busca: só agem com a busca vazia.
  case $ev in
    espaco)       [[ -n $qy ]] && { echo 'put( )'; return; } ;;
    interrogacao) [[ -n $qy ]] && { echo 'put(?)'; return; } ;;
    direita)      [[ -n $qy ]] && { echo 'forward-char'; return; } ;;
    esquerda)     [[ -n $qy ]] && { echo 'backward-char'; return; } ;;
  esac
  # Duplo clique: como o 1º clique já recarrega a lista, o fzf costuma entregar dois cliques simples
  # em vez do evento double-click. Então o 2º clique na MESMA linha vira "duplo". No Android o
  # processo do tt pode levar mais de 1 s entre os eventos; amplia a janela para compensar esse custo,
  # sem mudar o intervalo de clique dos outros terminais.
  local ultimo agora_ms ult_ms janela_duplo_ms=${TT_TAREFAS_DUPLO_MS:-400}
  if [[ -z ${TT_TAREFAS_DUPLO_MS:-} && ( ${PREFIX:-} == *com.termux* || -n ${ANDROID_ROOT:-} ) ]]; then janela_duplo_ms=1500; fi
  agora_ms=${EPOCHREALTIME:-$(date +%s).0}; agora_ms=${agora_ms/[.,]/}; agora_ms=$((10#${agora_ms:0:13}))
  read -r ultimo ult_ms <<<"$(tarefas_ui_get clique)"
  if [[ $ev == clique && -n $chave && $ultimo == "$chave" ]] && ((agora_ms - ${ult_ms:-0} < janela_duplo_ms)); then ev=duplo; fi
  if [[ $ev == clique ]]; then tarefas_ui_set clique "$chave $agora_ms"
  elif [[ $ev == duplo ]]; then tarefas_ui_set clique ""; fi
  if [[ $ev == cabecalho ]]; then
    ev=$(tarefas_cabecalho_acao); [[ -n $ev ]] || { echo ignore; return; }
  fi
  # Fora da lista (ajuda e menu), só voltar, fechar e o item do menu fazem sentido.
  _volta() { tarefas_ui_set modo lista; echo "clear-query+$rl+$hd"; }
  case $ev in
    esc)
      if [[ $modo != lista ]]; then _volta
      elif [[ -n $qy ]]; then echo clear-query
      else echo abort; fi
      return ;;
    voltar) _volta; return ;;
    interrogacao|ajuda)
      if [[ $modo == ajuda ]]; then _volta
      else tarefas_ui_set modo ajuda; echo "clear-query+$rl+$hd+first"; fi
      return ;;
    filtro:*|filtro-proximo)
      if [[ $ev == filtro-proximo ]]; then tarefas_filtro_ciclar; else tarefas_filtro_set "${ev#filtro:}"; fi
      tarefas_ui_set modo lista; echo "$rl+$hd+first"; return ;;
    nova)
      tarefas_ui_set modo lista; echo "execute($EU --tarefa-nova-prompt)+clear-query+$rl+$hd"; return ;;
    calendario)
      echo "execute(TT_CAL_DENTRO=1 $EU --calendario-agenda)+$rl+$hd"; return ;;
    limpar)
      echo "execute($EU --tarefa-limpar-prompt)+$rl+$hd"; return ;;
  esac
  # Linhas especiais da lista.
  case $chave in
    apvt:*) [[ $ev == enter || $ev == clique ]] || { echo ignore; return; }
            n=$(tarefas_aprovar_limpas); tarefas_ui_set aviso "✓ $n demanda(s) aprovada(s) · as que têm conflito esperam a sua revisão"; echo "$rl+$hd"; return ;;
    rect:*) [[ $ev == enter || $ev == clique ]] || { echo ignore; return; }
            n=$(tarefas_recusar_todas); tarefas_ui_set aviso "✕ $n demanda(s) recusada(s)"; echo "$rl+$hd"; return ;;
    voltar) [[ $ev == enter || $ev == clique ]] && { _volta; return; } ;;
    dia:*)
      # Título de um dia na agenda: abre o calendário nesse dia.
      [[ $ev == enter || $ev == clique ]] && { echo "execute(TT_CAL_DENTRO=1 $EU --calendario-agenda ${chave#dia:})+$rl+$hd"; return; } ;;
    criar|'')
      if [[ -n $qy && ( $ev == enter || $chave == criar && $ev == clique ) ]]; then
        tarefa_add_natural "$qy" >/dev/null
        echo "clear-query+$rl+$hd"; return
      fi
      [[ -z $chave ]] && { echo ignore; return; } ;;
    act:*)
      if [[ $ev == enter || $ev == clique ]]; then
        local op=${chave#act:}; op=${op%%:*}
        tarefas_ui_set modo lista
        case $op in
          ver) echo "clear-query+$rl+$hd+show-preview"; return ;;
          prio1|prio2) tarefa_set_prio "$id" "${op#prio}" ;;
          prio0) tarefa_set_prio "$id" "" ;;
          rep0) tarefa_set_rep "$id" "" ;;
          repd|repw|repm) tarefa_set_rep "$id" "${op#rep}" ;;
          *) tarefa_acao "$op" "$id"; return ;;
        esac
        echo "$rl+$hd"; return
      fi ;;
  esac
  [[ -n $id ]] || { echo ignore; return; }
  pai=$(tarefas_pai_de "$id")
  # Marca/desmarca. Mãe com subtarefa aberta não conclui: avisa no cabeçalho e abre a mãe para
  # mostrar o que falta.
  _marcar() {
    local falta n c0 m
    c0=$(tarefas_meta_get "$(tarefas_meta_de "$1")" ciclos)
    if falta=$(tarefa_alternar "$1"); then
      m=$(tarefas_meta_de "$1")
      # Recorrente: a tarefa não fica marcada (o prazo avança), então o cabeçalho diz o que aconteceu.
      [[ $(tarefas_meta_get "$m" ciclos) != "$c0" ]] &&
        tarefas_ui_set aviso "✓ Ciclo feito · próximo: $(tarefas_prazo_texto "$(tarefas_meta_get "$m" prazo)" "$(tarefas_meta_get "$m" hora)") · ^z desfaz"
      echo "$rl+$hd"; return
    fi
    if [[ -n $falta ]]; then
      n=$(grep -c . <<<"$falta")
      tarefas_ui_set aviso "⚠ Para concluir, falta$( ((n > 1)) && echo m) $n subtarefa$( ((n > 1)) && echo s): $(awk 'NR > 1 { printf ", " } { printf "%s", $0 }' <<<"$falta")"
      tarefas_exp_definir "$1" 1
    fi
    echo "$rl+$hd"
  }
  if [[ $ev == duplo ]]; then
    [[ $ultimo == "$chave" ]] || { echo ignore; return; }
  fi
  local txt_t; txt_t=$(tarefas_raw | awk -F'\t' -v id="$id" '$1==id{print $5; exit}')
  # Aprovar uma demanda: atualização com conflito abre a revisão (nada é decidido sozinho); o resto aprova na hora.
  _aprovar_ui() { # id
    local alvo=$1 st
    if [[ -n $(tarefas_meta_get "$(tarefas_meta_de "$alvo")" upd) ]]; then
      st=$(python3 -I "$MERGE_PY" estado "$CONF_TAREFAS" "$alvo" 2>/dev/null | cut -f1)
      if [[ $st == conflito ]]; then
        tarefas_ui_set aviso "⚡ Esta atualização tem conflitos: decida na revisão"
        echo "execute($EU --demanda-merge $alvo)+$rl+$hd"; return
      fi
    fi
    tarefas_demanda_mudar aprovar "$alvo" >/dev/null; tarefas_ui_set aviso "✓ Demanda aprovada: $txt_t · está na lista de tarefas"; echo "$rl+$hd"
  }
  # Arquivo: restaurar e apagar de vez; o resto não mexe numa tarefa arquivada.
  case $chave in
    rest:*) [[ $ev == enter || $ev == clique ]] || { echo ignore; return; }
            tarefa_restaurar "$id"; tarefas_ui_set aviso "↩ Restaurada para a lista: $txt_t"; echo "$rl+$hd"; return ;;
    apag:*) [[ $ev == enter || $ev == clique ]] || { echo ignore; return; }
            echo "execute($EU --tarefa-remover-prompt $id)+$rl+$hd"; return ;;
    rev:*) [[ $ev == enter || $ev == clique ]] || { echo ignore; return; }
           echo "execute($EU --demanda-merge $id)+$rl+$hd"; return ;;
    apv:*) [[ $ev == enter || $ev == clique ]] || { echo ignore; return; }
           _aprovar_ui "$id"; return ;;
    rec:*) [[ $ev == enter || $ev == clique ]] || { echo ignore; return; }
           tarefas_demanda_mudar recusar "$id" >/dev/null; tarefas_ui_set aviso "✕ Demanda recusada: $txt_t"; echo "$rl+$hd"; return ;;
  esac
  # Demanda pendente: só se aprova (⏎, ✓ Feita ou a linha ✓) ou recusa (✕ Apagar ou a linha ✕); o resto espera a aprovação.
  if [[ $(tarefas_estado_de "${pai:-$id}") == pendente ]]; then
    case $ev in
      enter|feita) _aprovar_ui "${pai:-$id}"; return ;;
      apagar) tarefas_demanda_mudar recusar "${pai:-$id}" >/dev/null; tarefas_ui_set aviso "✕ Demanda recusada: $txt_t"; echo "$rl+$hd"; return ;;
      clique|duplo|espaco|direita|esquerda|cima|baixo) echo ignore; return ;;
      *) tarefas_ui_set aviso "⚠ Demanda pendente: aprove (✓) ou recuse (✕) antes de mexer nela"; echo "$rl+$hd"; return ;;
    esac
  fi
  case $ev in
    arquivar)
      if [[ -n $pai ]]; then tarefas_ui_set aviso "⚠ Subtarefa não se arquiva sozinha: arquive a tarefa (leva as subtarefas)"
      else tarefa_arquivar "$id"; tarefas_ui_set aviso "▤ Arquivada: $txt_t · está na aba Arquivo"; fi
      echo "$rl+$hd"; return ;;
    restaurar) tarefa_restaurar "${pai:-$id}"; tarefas_ui_set aviso "↩ Restaurada para a lista: $txt_t"; echo "$rl+$hd"; return ;;
  esac
  if [[ $(tarefas_estado_de "${pai:-$id}") == arquivada ]]; then
    case $ev in
      enter|clique|duplo)
        [[ -z $pai && $chave == "$id" ]] && { tarefas_exp_alternar "$id"; echo "$rl"; return; }
        [[ $chave == desc:* ]] || { echo ignore; return; } ;;
      menu|mais|espaco|direita|esquerda|apagar|desc) ;;
      *) tarefas_ui_set aviso "⚠ Tarefa arquivada: ↩ restaure (menu ⋯ ou a linha ↩) para mexer nela"; echo "$rl+$hd"; return ;;
    esac
  fi
  case $ev in
    enter|clique)
      case $chave in
        desc:*)
          # Com descrição: abre/fecha a visão da descrição (a janela de prévia). Sem: escreve.
          if [[ -n $(tarefas_meta_get "$(tarefas_meta_de "$id")" desc) ]]; then echo toggle-preview
          else echo "execute($EU --tarefa-desc-prompt $id)+$rl"; fi
          return ;;
        sub:*) echo "execute($EU --tarefa-sub-prompt $id)+$rl+$hd"; return ;;
        menu:*) tarefas_ui_set modo "menu:$id"; echo "clear-query+$rl+$hd+first"; return ;;
      esac
      # Clique numa tarefa de topo abre/fecha os detalhes; ⏎ e clique numa subtarefa marcam.
      if [[ $ev == clique && -z $pai ]]; then
        if tarefa_expandivel "$id"; then tarefas_exp_alternar "$id"; echo "$rl"; else echo ignore; fi
      else _marcar "$id"; fi ;;
    duplo)
      # O 1º clique do duplo já abriu/fechou a tarefa de topo: desfaz e marca como feita.
      [[ $chave == "$id" ]] || { echo ignore; return; }
      if [[ -z $pai ]]; then tarefa_expandivel "$id" && tarefas_exp_alternar "$id"; _marcar "$id"
      else echo ignore; fi ;;
    feita) _marcar "$id" ;;
    menu|mais)
      [[ $modo == "menu:$id" ]] && { _volta; return; }
      tarefas_ui_set modo "menu:$id"; echo "clear-query+$rl+$hd+first" ;;
    espaco)
      [[ -n $pai ]] && id=$pai
      if tarefa_expandivel "$id"; then tarefas_exp_alternar "$id"; echo "$rl"; else echo ignore; fi ;;
    direita) [[ -z $pai ]] && tarefa_expandivel "$id" && tarefas_exp_definir "$id" 1; echo "$rl" ;;
    esquerda) [[ -n $pai ]] && id=$pai; tarefas_exp_definir "$id" 0; echo "$rl" ;;
    sub)
      [[ -n $pai ]] && id=$pai
      echo "execute($EU --tarefa-sub-prompt $id)+$rl+$hd" ;;
    desc) echo "execute($EU --tarefa-desc-prompt $id)+$rl" ;;
    email) [[ -n $pai ]] && id=$pai
           echo "execute($EU --tarefa-email-ui $id)+$rl+$hd" ;;
    prazo) [[ -n $pai ]] && id=$pai; echo "execute($EU --tarefa-prazo-prompt $id)+$rl+$hd" ;;
    editar|renomear) echo "execute($EU --tarefa-editar-prompt $id)+$rl+$hd" ;;
    prio) [[ -n $pai ]] && id=$pai; tarefa_prio_ciclar "$id"; echo "$rl" ;;
    rep) [[ -n $pai ]] && id=$pai; tarefa_rep_ciclar "$id"; echo "$rl" ;;
    desfazer)
      [[ -n $pai && -z $(tarefas_meta_get "$(tarefas_meta_de "$id")" ant) && $(tarefas_estado_de "$id") != feita ]] && id=$pai
      if r=$(tarefa_desfazer "$id" 2>&1); then tarefas_ui_set aviso "$r"
      else tarefas_ui_set aviso "⚠ Nada a desfazer nesta tarefa"; fi
      echo "$rl+$hd" ;;
    cima|baixo) tarefa_mover "$id" "$ev"; echo "$rl" ;;
    apagar) echo "execute($EU --tarefa-remover-prompt $id)+$rl+$hd" ;;
    ia) # abre a sessão da IA e fecha o painel (senão ele ficaria por cima da sessão nova)
      if nome=$(tarefa_implementar "$id" "${TT_CLIENTE:-}" 2>/dev/null); then echo abort
      else tarefas_ui_set aviso "⚠ Não consegui abrir a IA para esta tarefa"; echo "$rl+$hd"; fi ;;
    *) echo ignore ;;
  esac
}

# Implementar com a melhor IA: o botão 🤖 do painel de tarefas (e `tt --tarefa-implementar ID`) abre uma
# sessão nova com a IA de mais folga (ia-conta abrir → ia-rot --melhor) já recebendo o pedido: implementar
# a tarefa e todas as suas subtarefas, marcando cada uma como feita ao terminar. Subtarefa: só ela.

# O pedido que a IA recebe (texto puro): título, descrição, prazo e as subtarefas abertas com os ids.
tarefa_ia_prompt() { # id [pasta]
  local id=$1 pasta=${2:-$PWD} est txt m pai prazo desc sid sest stxt n=0 pai_txt
  IFS=$'\t' read -r est txt m < <(tarefas_raw | awk -F'\t' -v id="$id" '$1==id{print $2"\t"$5"\t"($6==""?"-":$6); exit}')
  [[ -n $est ]] || return 1
  [[ $m == - ]] && m=""
  pai=$(tarefas_meta_get "$m" pai); prazo=$(tarefas_meta_get "$m" prazo)
  desc=$(tarefa_get_desc "$id")
  printf 'Você foi aberto pelo painel de tarefas do tt-terminais para IMPLEMENTAR %s abaixo, de ponta a ponta.\n\n' \
    "$([[ -n $pai ]] && echo 'uma subtarefa' || echo 'uma tarefa e todas as suas subtarefas')"
  if [[ -n $pai ]]; then
    pai_txt=$(tarefas_raw | awk -F'\t' -v id="$pai" '$1==id{print $5; exit}')
    printf 'SUBTAREFA [%s]: %s\n(da tarefa [%s]: %s)\n' "$id" "$txt" "$pai" "$pai_txt"
  else
    printf 'TAREFA [%s]: %s\n' "$id" "$txt"
  fi
  [[ -n $prazo ]] && printf 'Prazo: %s\n' "$(tarefas_prazo_texto "$prazo" "$(tarefas_meta_get "$m" hora)")"
  [[ -n $desc ]] && printf '\nDescrição:\n%s\n' "$desc"
  if [[ -z $pai ]]; then
    while IFS=$'\t' read -r sid sest stxt; do
      [[ -n $sid ]] || continue
      if ((n == 0)); then printf '\nSubtarefas (código · estado · texto · apelido estável; refira-se a elas pelo apelido ou código, nunca pela posição):\n'; fi
      n=$((n + 1)); printf '  [%s] %s · %s · %s\n' "$sid" "$([[ $sest == feita ]] && echo feita || echo aberta)" "$stxt" "$(tarefa_ref "$sid")"
    done < <(tarefas_filhas "$id")
  fi
  cat <<FIM

Como trabalhar:
1. Entenda o pedido e o projeto desta pasta ($pasta) antes de mexer: leia AGENTS.md/CLAUDE.md/README se houver, e siga as convenções e o ciclo de testes do projeto.
2. Implemente $([[ -n $pai ]] && echo 'a subtarefa' || echo 'a tarefa e CADA subtarefa aberta acima'), uma a uma, testando de verdade (rode os testes; não declare pronto sem verificar).
3. Ao terminar cada $([[ -n $pai ]] && echo 'item' || echo 'subtarefa'), marque-a: tt --tarefa-ok <id>$([[ -z $pai ]] && echo ". Ao fim de todas, marque a própria tarefa [$id] (tt --tarefa-ok $id; ela só conclui com as subtarefas feitas)").
4. Se algo bloquear (decisão sua, credencial, aprovação), avise com: tt --notificar-daqui "<o que precisa>" --sempre, e espere.
5. Não publique, não faça push nem instale em outras máquinas sem o dono pedir explicitamente. Commits locais podem ser feitos.
6. No fim, resuma o que foi feito e avise: tt --notificar-daqui "Tarefa pronta: <título>".
FIM
}

# Abre a sessão da IA para a tarefa e leva o cliente até ela. Imprime o nome da sessão.
tarefa_implementar() { # id [cliente]
  local id=$1 c=${2:-${TT_CLIENTE:-}} arq pasta nome txt
  txt=$(tarefas_raw | awk -F'\t' -v id="$id" '$1==id{print $5; exit}')
  [[ -n $txt ]] || { echo "tarefa $id não existe" >&2; return 1; }
  [[ -n ${TMUX:-} ]] || tmux has-session 2>/dev/null || { echo "precisa do tmux ligado" >&2; return 1; }
  mkdir -p "$RT"; arq="$RT/tt-impl-$id.md"
  [[ -n $c ]] || c=$(tmux list-clients -F '#{client_activity} #{client_name}' 2>/dev/null | sort -rn | awk 'NR==1{print $2}')
  pasta=$([[ -n $c ]] && do_cliente "$c" '#{pane_current_path}'); [[ -d ${pasta:-} ]] || pasta=$HOME
  tarefa_ia_prompt "$id" "$pasta" >"$arq" || return 1
  nome=$(proximo_nome impl)
  local ia="$DIR_TT/ia-conta"; [[ -x $ia ]] || ia=$(command -v ia-conta) || { echo "ia-conta não encontrado" >&2; return 1; }
  tmux new-session -d -s "$nome" -c "$pasta" "$(printf '%q abrir --prompt-arquivo %q; exec ${SHELL:-bash}' "$ia" "$arq")" || return 1
  tmux set-option -w -t "=$nome:" @tt_papel ia-impl
  [[ -n $c ]] && tmux switch-client -c "$c" -t "=$nome"
  echo "$nome"
}

# Visão da descrição (a janela de prévia do painel, ^/ ou a linha "≡ descrição" de uma tarefa
# aberta): um cartão com o título, prazo/prioridade/repetição/etiquetas, a descrição inteira e as
# subtarefas.
tarefa_preview() { # chave
  local id m txt prazo desc
  id=$(tarefas_id_da_chave "${1:-}")
  [[ -n $id ]] || return 0
  txt=$(tarefas_raw | awk -F'\t' -v id="$id" '$1==id{print $5; exit}')
  [[ -n $txt ]] || return 0
  m=$(tarefas_meta_de "$id")
  local z=$'\e[0m' n=$'\e[1m' t=$'\e[38;2;205;214;244m' s=$'\e[38;2;166;173;200m' d=$'\e[38;2;108;112;134m'
  local verm=$'\e[38;2;243;139;168m' amar=$'\e[38;2;249;226;175m' teal=$'\e[38;2;148;226;213m' lil=$'\e[38;2;203;166;247m'
  local verde=$'\e[38;2;166;227;161m'; local -a info=()
  printf '%s%s%s\n' "$n$t" "$txt" "$z"
  prazo=$(tarefas_meta_get "$m" prazo)
  [[ -n $prazo ]] && info+=("$s◷ $(tarefas_prazo_texto "$prazo" "$(tarefas_meta_get "$m" hora)")$z")
  case $(tarefas_meta_get "$m" prio) in 1) info+=("$verm● alta$z") ;; 2) info+=("$amar● média$z") ;; esac
  case $(tarefas_meta_get "$m" rep) in d) info+=("$teal↻ diária$z") ;; w) info+=("$teal↻ semanal$z") ;; m) info+=("$teal↻ mensal$z") ;; esac
  local nc; nc=$(tarefas_meta_get "$m" ciclos)
  [[ -n $nc ]] && info+=("$verde✓ $nc ciclo$( ((nc > 1)) && echo s) feito$( ((nc > 1)) && echo s)$z")
  local tgs; tgs=$(tarefas_meta_get "$m" tags); [[ -n $tgs ]] && info+=("$lil#${tgs//,/ #}$z")
  ((${#info[@]})) && { local IFS=$'\x1f'; printf '%s\n' "${info[*]}" | sed $'s/\x1f/   /g'; }
  printf '%s⌗ %s · %s%s\n' "$d" "$(tarefa_slug "$id")" "$id" "$z"
  printf '\n'
  desc=$(tarefa_get_desc "$id")
  if [[ -n $desc ]]; then printf '%s\n' "$desc" | awk -v D="$d" -v Z="$z" '/^⟡ /{l=1} l&&/^$/{l=0} { print (l ? D $0 Z : $0) }'
  else printf '%sSem descrição. ^e (ou ✎ Descrição) escreve uma.%s\n' "$d" "$z"; fi
  local arq; arq=$(tarefas_meta_get "$m" arq)
  [[ -n $arq ]] && printf '%s▤ Arquivada em %s · ↩ restaura pelo menu ⋯%s\n' "$d" "$(tt_fmt_epoch "${arq%%:*}" +%d/%m/%Y)" "$z"
  local sid sest stxt nf=0 nt=0 subs=""
  while IFS=$'\t' read -r sid sest stxt; do
    [[ -n $sid ]] || continue
    nt=$((nt + 1)); [[ $sest == feita ]] && nf=$((nf + 1))
    subs+="  $([[ $sest == feita ]] && echo "$verde☑$z $d$stxt$z" || echo "$t☐ $stxt$z")"$'\n'
    subs+="      $d⌗ $(tarefa_slug "$sid") · $sid$z"$'\n'   # apelido e código da subtarefa, discretos
  done < <(tarefas_raw | awk -F'\t' -v p="$id" '
    function mv(m, k,   n, a, i) { n = split(m, a, "|"); for (i = 1; i <= n; i++) if (index(a[i], k "=") == 1) return substr(a[i], length(k) + 2); return "" }
    mv($6, "pai") == p && ($2 == "aberta" || $2 == "feita" || $2 == "arquivada") {
      e = $2; if (e == "arquivada") e = (mv($6, "arq") ~ /:a$/ ? "aberta" : "feita")
      printf "%d\t%d\t%s\t%s\t%s\n", mv($6, "ord") + 0, $3 + 0, $1, e, $5 }' | LC_ALL=C sort -t$'\t' -k1,1n -k2,2n -k3,3 | cut -f3-)
  ((nt > 0)) && printf '\n%sSubtarefas %s/%s%s\n%s' "$s" "$nf" "$nt" "$z" "$subs"
  return 0
}

# Cartão de explicação da sintaxe natural, mostrado ao criar uma tarefa.
tarefas_dica_frase() {
  local z=$'\e[0m' y=$'\e[38;2;249;226;175m' d=$'\e[38;2;108;112;134m'
  printf '  %sNo título dá para incluir, em qualquer ponto (tudo opcional):%s\n' "$d" "$z"
  printf '    %s@amanha%s       prazo       %s@hoje @amanha @seg…@dom @25/12%s\n' "$y" "$z" "$d" "$z"
  printf '    %s@sex 14h%s      com horário %s@14h @sex 9:30 @amanha às 18h%s\n' "$y" "$z" "$d" "$z"
  printf '    %s!alta%s         prioridade  %s!alta !media%s\n' "$y" "$z" "$d" "$z"
  printf '    %s*semanal%s      repetir     %s*diaria *semanal *mensal%s\n' "$y" "$z" "$d" "$z"
  printf '    %s#casa%s         etiqueta\n' "$y" "$z"
