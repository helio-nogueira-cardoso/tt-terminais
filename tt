mover_fixada() {
  local i=$1 j=$2 n
  travar_fixadas || return 0
  n=$(grep -vc '^\s*$' "$CONF_FIX" 2>/dev/null || echo 0)
  # j é o índice de DESTINO absoluto (1..n); fora da faixa é saturado. Mover um item para j desloca
  # os demais (não é troca de pares), para "ir ao início/fim" chegar em um passo.
  ((j < 1)) && j=1; ((j > n)) && j=$n
  if ((i >= 1 && i <= n && i != j)); then
    awk -v i="$i" -v j="$j" '
      { l[NR] = $0 }
      END {
        it = l[i]
        if (i < j) { for (k = i; k < j; k++) l[k] = l[k + 1] }
        else       { for (k = i; k > j; k--) l[k] = l[k - 1] }
        l[j] = it
        for (k = 1; k <= NR; k++) print l[k]
      }' "$CONF_FIX" >"$CONF_FIX.novo" && mv "$CONF_FIX.novo" "$CONF_FIX"
    marcar_fixadas
  fi
  destravar_fixadas
  aplicar_fixadas
  propagar_fixadas
}

# Popup com TODAS as fixadas (abre pelo chip "+N ▾", pelo menu do botão direito, ou
# tt --fixadas-popup): ⏎/clique vai para a sessão, ^x desafixa, ^k/^j (ou alt-↑/↓) REORDENA ao
# vivo — o item acompanha o cursor e a barra e as outras máquinas recebem a ordem nova ao fechar.
fixadas_popup() {
  local c=${1:-$(tmux display-message -p '#{client_name}' 2>/dev/null)}
  [[ -n $c ]] || { fixadas_ui ""; return 0; }
  tmux display-popup -c "$c" -E -w 64 -h 18 -b rounded -S 'fg=#bd93f9' -T ' 📌 sessões fixadas ' "$EU --fixadas-ui $(q "$c")"
}

fixadas_ui_lista() {
  local i=0 r s id rot marca
  local -A existe SELO SELO_COR
  while read -r s; do existe[$s]=1; done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)
  fixadas_selos
  # Nome inteiro (a faixa abrevia; aqui não): "E sessão  · máquina", com o selo colorido.
  while IFS=$'\t' read -r r s id; do
    i=$((i + 1))
    if [[ $r == "$MAQUINA" ]]; then rot=$s; marca=$([[ -n ${existe[$s]:-} ]] && echo "" || echo " ✗ fechada")
    else rot="$(selo_ansi "$r") $s"; marca="  · $r"; fi
    printf 'fx%s\t%2d  📌 %s\033[38;2;108;112;134m%s\033[0m\n' "$(fixada_chave "$r" "$s" "$id")" "$i" "$rot" "$marca"
  done < <(fixadas)
}

fixadas_ui() {
  local c=$1 esc
  while :; do
    [[ -n $(fixadas) ]] || { echo "Nenhuma sessão fixada."; read -rsn1 -t 2; return 0; }
    esc=$(fixadas_ui_lista | fzf --ansi --delimiter=$'\t' --with-nth=2 --layout=reverse --no-sort --no-input \
      --header=$'⏎ vai · ^k/^j reordena · ^x desafixa · Esc fecha' \
      --pointer='▶' --bind "ctrl-k:execute-silent($EU --mover-fixada-rel {n} -1)+reload($EU --fixadas-ui-lista)+up" \
      --bind "alt-up:execute-silent($EU --mover-fixada-rel {n} -1)+reload($EU --fixadas-ui-lista)+up" \
      --bind "ctrl-j:execute-silent($EU --mover-fixada-rel {n} 1)+reload($EU --fixadas-ui-lista)+down" \
      --bind "alt-down:execute-silent($EU --mover-fixada-rel {n} 1)+reload($EU --fixadas-ui-lista)+down" \
      --bind "ctrl-x:execute-silent($EU --desafixar-n {n})+reload($EU --fixadas-ui-lista)" \
      --bind 'q:abort') || { atualizar_barras; return 0; }
    [[ -n $esc ]] || continue
    atualizar_barras
    [[ -n $c ]] && ir_fixada "$c" "$(cut -f1 <<<"$esc")"
    return 0
  done
}

# Reordena pelo índice 0-based do popup (o {n} do fzf): N vai para N+DELTA.
mover_fixada_rel() {
  local n0=$1 delta=$2 i j
  [[ $n0 =~ ^[0-9]+$ ]] || return 0
  i=$((n0 + 1)); j=$((i + delta))
  mover_fixada "$i" "$j"
}

# Desafixa pelo índice 0-based do popup.
desafixar_n() {
  local n0=$1 r s id
  [[ $n0 =~ ^[0-9]+$ ]] || return 0
  IFS=$'\t' read -r r s id < <(fixadas | sed -n "$((n0 + 1))p")
  [[ -n $s ]] && remover_fixada "$r" "$s" "$id"
  return 0
}

