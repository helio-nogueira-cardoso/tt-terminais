# Abre o painel de tarefas como um slide-over ANCORADO À DIREITA (display-popup -x), altura toda.
# Recolher = sair da UI interna (q/esc), que fecha o popup. Em tela estreita (celular) ocupa tudo.
abrir_tarefas() {
  local c=$1 cw ch w x
  read -r cw ch < <(do_cliente "$c" '#{client_width} #{client_height}')
  if ((${cw:-80} < 80)); then
    w=$cw; x=0
  else
    w=64; ((w > cw)) && w=$cw; x=$((cw - w))
  fi
  tmux display-popup -c "$c" -x "$x" -y S -w "$w" -h 100% -b rounded -S 'fg=#f9e2af' \
    -T ' 📋 tarefas · q fecha ' -E "TT_CLIENTE=$(q "$c") $EU --tarefas-ui"
}

# Estado da UI (filtro e nós expandidos) por cliente, para sobreviver aos reloads do fzf.
tarefas_estado_arq() { echo "$RT/tt-tarefas-ui-$(id -u)"; }
tarefas_filtro() { sed -n 's/^filtro=//p' "$(tarefas_estado_arq)" 2>/dev/null | tail -1; }
tarefas_filtro_set() {
  local f=$1 arq; arq=$(tarefas_estado_arq); mkdir -p "$RT"
  { grep -v '^filtro=' "$arq" 2>/dev/null; printf 'filtro=%s\n' "$f"; } >"$arq.tmp" && mv "$arq.tmp" "$arq"
}
# Ciclo do filtro: todas -> abertas -> feitas -> prazo (só com deadline) -> todas.
tarefas_filtro_ciclar() {
  case $(tarefas_filtro) in
    ''|todas) tarefas_filtro_set abertas ;;
    abertas) tarefas_filtro_set feitas ;;
    feitas) tarefas_filtro_set prazo ;;
    *) tarefas_filtro_set todas ;;
  esac
}
tarefas_filtro_rotulo() {
  case $(tarefas_filtro) in
    abertas) echo "abertas" ;; feitas) echo "feitas" ;; prazo) echo "com prazo" ;; *) echo "todas" ;;
  esac
}
# Clique numa aba de filtro do cabeçalho (ação do fzf via transform). O fzf entrega a LINHA
# clicada (com cores) e a coluna; achamos a palavra pela coluna, trocamos o filtro e devolvemos as
# ações do fzf (recarregar a lista e redesenhar o cabeçalho). Clique fora das abas só redesenha.
tarefas_cabecalho_clique() {
  local l=${FZF_CLICK_HEADER_LINE:-0} c=${FZF_CLICK_HEADER_COLUMN:-0} texto w
  if ((l == 1)); then
    texto=$(tarefas_cabecalho | sed -n '1p' | sed 's/\x1b\[[0-9;]*m//g')
    w=$(palavra_em "$texto" "$c")
    case $w in
      abertas|feitas|prazo|todas) tarefas_filtro_set "$w" ;;
    esac
  fi
  echo "reload($EU --tarefas-lista)+transform-header($EU --tarefas-cabecalho)"
}
# Um nó (tarefa com filhas) está expandido? Estado em linhas "exp=<id>" no arquivo da UI.
tarefas_exp_tem() { grep -qxF "exp=$1" "$(tarefas_estado_arq)" 2>/dev/null; }
tarefas_exp_alternar() {
  local id=$1 arq; arq=$(tarefas_estado_arq); mkdir -p "$RT"; touch "$arq"
  if tarefas_exp_tem "$id"; then grep -vxF "exp=$id" "$arq" >"$arq.tmp" || true; mv "$arq.tmp" "$arq"
  else printf 'exp=%s\n' "$id" >>"$arq"; fi
}

# Rótulo curto de prazo: "hoje", "amanhã", "venceu", ou "dd/mm". Vazio se sem prazo.
tarefas_prazo_rotulo() { # epoch
  local ep=$1 hoje alvo dias
  [[ -n $ep ]] || return 0
  hoje=$(date -d "@$(date +%s)" +%Y%m%d 2>/dev/null || date +%Y%m%d)
  alvo=$(date -d "@$ep" +%Y%m%d 2>/dev/null) || return 0
  dias=$(( ( $(date -d "$alvo" +%s 2>/dev/null) - $(date -d "$hoje" +%s 2>/dev/null) ) / 86400 ))
  if ((dias < 0)); then printf '⚠ venceu'
  elif ((dias == 0)); then printf '📅 hoje'
  elif ((dias == 1)); then printf '📅 amanhã'
  else date -d "@$ep" +'📅 %d/%m' 2>/dev/null; fi
}

tarefas_ui() {
  if ! command -v fzf >/dev/null; then
    local t nt
    while :; do
      clear 2>/dev/null
      tarefas_listar
      printf '\n[n] nova  [Enter] fecha\n❯ '
      IFS= read -r t || break
      [[ -z $t ]] && break
      case $t in
        n) printf 'nova tarefa (vazio cancela)\n❯ '; IFS= read -r nt; [[ -n ${nt:-} ]] && tarefa_add "$nt" >/dev/null ;;
      esac
    done
    return 0
  fi
  fzf --with-nth=2.. --delimiter='\t' --wrap --wrap-sign=' ↳ ' \
    --layout=reverse --height=100% --border=none --info=inline --no-separator \
    --prompt='  ❯ ' --pointer='▸' --marker='✔' --header-first \
    --header="$(tarefas_cabecalho)" \
    --color='bg:#1e1e2e,fg:#cdd6f4,header:#89b4fa,pointer:#f9e2af,prompt:#f9e2af,fg+:#f9e2af,bg+:#313244,gutter:#1e1e2e,info:#6c7086,border:#45475a' \
    --preview="$EU --tarefa-preview {1}" --preview-window='down,40%,border-top,wrap,hidden' \
    --bind='ctrl-/:toggle-preview' \
    --bind="start:reload($EU --tarefas-lista)" \
    --bind="enter:execute-silent($EU --tarefa-toggle {1})+reload($EU --tarefas-lista)" \
    --bind="left-click:execute-silent($EU --tarefa-clique {1})+reload($EU --tarefas-lista)" \
    --bind="double-click:execute-silent($EU --tarefa-expandir {1})+reload($EU --tarefas-lista)" \
    --bind="click-header:transform($EU --tarefa-cabecalho-clique)" \
    --bind="space:execute-silent($EU --tarefa-expandir {1})+reload($EU --tarefas-lista)" \
    --bind="ctrl-n:execute($EU --tarefa-nova-prompt)+reload($EU --tarefas-lista)" \
    --bind="ctrl-s:execute($EU --tarefa-sub-prompt {1})+reload($EU --tarefas-lista)" \
    --bind="ctrl-e:execute($EU --tarefa-desc-prompt {1})+reload($EU --tarefas-lista)" \
    --bind="ctrl-d:execute($EU --tarefa-prazo-prompt {1})+reload($EU --tarefas-lista)" \
    --bind="ctrl-k:execute-silent($EU --tarefa-sub-mover {1} cima)+reload($EU --tarefas-lista)" \
    --bind="ctrl-j:execute-silent($EU --tarefa-sub-mover {1} baixo)+reload($EU --tarefas-lista)" \
    --bind="ctrl-x:execute($EU --tarefa-remover-prompt {1})+reload($EU --tarefas-lista)" \
    --bind="tab:execute-silent($EU --tarefa-filtro-ciclar)+reload($EU --tarefas-lista)+transform-header($EU --tarefas-cabecalho)" \
    --bind="ctrl-f:execute-silent($EU --tarefa-filtro-ciclar)+reload($EU --tarefas-lista)+transform-header($EU --tarefas-cabecalho)" \
    --bind="ctrl-l:execute-silent($EU --tarefa-limpar)+reload($EU --tarefas-lista)" \
    --bind='q:abort' --bind='esc:abort' >/dev/null 2>&1 || true
}

# Cabeçalho do painel: 1ª linha é a barra de FILTROS como abas (a ativa realçada, clicável);
# 2ª e 3ª linhas são os atalhos, compactos, cabendo na largura do slide-over.
tarefas_cabecalho() {
  local f; f=$(tarefas_filtro); f=${f:-todas}
  local aba
  aba() { if [[ $1 == "$f" ]]; then printf '\033[7;1m %s \033[0m' "$2"; else printf '\033[90m %s \033[0m' "$2"; fi; }
  printf '%s%s%s%s   \033[90m(Tab/clique)\033[0m\n' \
    "$(aba abertas '▢ abertas')" "$(aba feitas '✔ feitas')" "$(aba prazo '📅 prazo')" "$(aba todas '∗ todas')"
  printf '\033[90m⏎ marca · ␣ abre · ^n nova · ^s sub · ^e descr · ^d prazo\033[0m\n'
  printf '\033[90m^k/^j move · ^x apaga · ^l limpa · ^/ prévia · esc fecha\033[0m'
}

# Linhas para o fzf do painel: "id<TAB>render". Mostra as tarefas de topo conforme o filtro; cada
# tarefa com filhas ganha ▸/▾ (recolhida/expandida) e, se expandida, as subtarefas indentadas logo
# abaixo. O prazo e a marca de descrição (¶) entram no fim da linha. O --wrap do fzf quebra o texto
# longo em várias linhas visuais em vez de cortar.
tarefas_lista_fzf() {
  local filtro; filtro=$(tarefas_filtro); filtro=${filtro:-todas}
  local id est m txt pai prazo marca sub pr desc exp
  # id, estado, meta e texto. A meta vazia vira "-" no awk e volta a "" aqui: sem isso, dois TABs
  # adjacentes (meta vazia no meio) seriam colapsados pelo read e o texto cairia no campo errado.
  while IFS=$'\t' read -r id est m txt; do
    [[ -n $id ]] || continue
    [[ $m == - ]] && m=""
    pai=$(tarefas_meta_get "$m" pai); [[ -n $pai ]] && continue   # subtarefas entram sob a mãe
    prazo=$(tarefas_meta_get "$m" prazo)
    case $filtro in
      abertas) [[ $est == aberta ]] || continue ;;
      feitas)  [[ $est == feita ]] || continue ;;
      prazo)   [[ -n $prazo ]] || continue ;;
    esac
    marca=$([[ $est == feita ]] && echo ✔ || echo ▢)
    sub=$(tarefas_filhas "$id")
    pr=$(tarefas_prazo_rotulo "$prazo"); desc=$([[ -n $(tarefas_meta_get "$m" desc) ]] && echo ' ¶')
    if [[ -n $sub ]]; then
      exp=$(tarefas_exp_tem "$id" && echo ▾ || echo ▸)
      printf '%s\t%s %s %s%s%s\n' "$id" "$exp" "$marca" "$txt" "$desc" "${pr:+  $pr}"
      if tarefas_exp_tem "$id"; then
        local sid sest stxt
        while IFS=$'\t' read -r sid sest stxt; do
          printf '%s\t    %s %s\n' "$sid" "$([[ $sest == feita ]] && echo ✔ || echo ▢)" "$stxt"
        done <<<"$sub"
      fi
    else
      printf '%s\t  %s %s%s%s\n' "$id" "$marca" "$txt" "$desc" "${pr:+  $pr}"
    fi
  done < <(tarefas_vivas | awk -F'\t' '{m=($6==""?"-":$6); print $1"\t"$2"\t"m"\t"$5}')
}

# Prévia de uma tarefa no painel (janela inferior do fzf): texto, prazo e descrição.
tarefa_preview() { # id
  local id=$1 m txt prazo desc pr
  [[ -n $id ]] || return 0
  txt=$(tarefas_raw | awk -F'\t' -v id="$id" '$1==id{print $5; exit}')
  [[ -n $txt ]] || return 0
  m=$(tarefas_meta_de "$id")
  printf '%s\n' "$txt"
  prazo=$(tarefas_meta_get "$m" prazo)
  [[ -n $prazo ]] && printf 'prazo: %s\n' "$(date -d "@$prazo" +'%a, %d/%m/%Y' 2>/dev/null)"
  desc=$(tarefa_get_desc "$id")
  [[ -n $desc ]] && { printf '\n%s\n' "$desc"; }
  return 0
}

# Prompt de nova tarefa (chamado por execute() do fzf: tem o TTY). Lê uma linha e cria.
tarefa_nova_prompt() {
  local t
  clear 2>/dev/null
  printf '📋 nova tarefa (Enter cria, vazio cancela)\n❯ '
  IFS= read -r t || return 0
  [[ -n ${t:-} ]] && tarefa_add "$t" >/dev/null
  return 0
}

# Confirmação de remoção (chamado por execute() do fzf: tem o TTY).
tarefa_remover_prompt() {
  local id=$1 txt resp
  [[ -n $id ]] || return 0
  txt=$(tarefas_raw | awk -F'\t' -v id="$id" '$1==id{print $5; exit}')
  clear 2>/dev/null
  printf 'remover: %s\n\ndigite "sim" e Enter para confirmar (qualquer outra coisa cancela)\n❯ ' "$txt"
  IFS= read -r resp || return 0
  [[ ${resp:-} == sim ]] && tarefa_remover "$id"
  return 0
}

# Nova subtarefa de ID (prompt de linha; tem o TTY via execute()).
tarefa_sub_prompt() {
  local id=$1 t txt
  [[ -n $id ]] || return 0
  txt=$(tarefas_raw | awk -F'\t' -v id="$id" '$1==id{print $5; exit}')
  clear 2>/dev/null
  printf '📋 subtarefa de: %s\n(Enter cria, vazio cancela)\n❯ ' "$txt"
  IFS= read -r t || return 0
  [[ -n ${t:-} ]] && { tarefa_add_sub "$id" "$t" >/dev/null; tarefas_exp_tem "$id" || tarefas_exp_alternar "$id"; }
  return 0
}

# Edita a descrição longa de ID num editor (EDITOR/VISUAL, senão vim/vi). Multi-linha.
tarefa_desc_prompt() {
  local id=$1 ed tmp
  [[ -n $id ]] || return 0
  ed=${VISUAL:-${EDITOR:-}}
  [[ -z $ed ]] && { command -v vim >/dev/null && ed=vim || ed=vi; }
  tmp=$(mktemp "${TMPDIR:-/tmp}/tt-desc.XXXXXX") || return 0
  tarefa_get_desc "$id" >"$tmp"
  # Só usa /dev/tty se der para abri-lo (num fluxo headless/teste ele pode existir mas não abrir).
  if { : >/dev/tty; } 2>/dev/null; then "$ed" "$tmp" </dev/tty >/dev/tty 2>&1 || { rm -f "$tmp"; return 0; }
  else "$ed" "$tmp" >/dev/null 2>&1 || { rm -f "$tmp"; return 0; }; fi
  tarefa_set_desc "$id" "$(cat "$tmp")"
  rm -f "$tmp"
  return 0
}

# Abre o calendário interativo para escolher o prazo de ID. ⏎ grava a data escolhida; "x" limpa
# o prazo; esc cancela.
tarefa_prazo_prompt() {
  local id=$1 escolha ini
  [[ -n $id ]] || return 0
  ini=$(tarefa_get_prazo "$id")
  escolha=$(calendario_tui "$ini") || return 0
  case $escolha in
    "") : ;;
    limpar) tarefa_set_prazo "$id" "" ;;
    *) tarefa_set_prazo "$id" "$escolha" ;;
  esac
  return 0
}

# --- calendário interativo -------------------------------------------------
#
# Calendário navegável desenhado no /dev/tty; imprime no stdout o epoch da data escolhida (⏎),
# "limpar" (tecla x) ou nada (esc). Cabeçalho com o dia por extenso em português; grade do mês com
# o número ISO da semana na lateral; o dia em foco é destacado e "hoje" fica sublinhado.
TT_MESES=(janeiro fevereiro março abril maio junho julho agosto setembro outubro novembro dezembro)
TT_DIAS_SEMANA=(domingo segunda-feira terça-feira quarta-feira quinta-feira sexta-feira sábado)

calendario_tui() { # [epoch_inicial]
  local ini=${1:-} ano mes dia hoje_y hoje_m hoje_d
  local foco_y foco_m foco_d
  hoje_y=$(date +%Y); hoje_m=$(date +%-m); hoje_d=$(date +%-d)
  if [[ -n $ini && $ini =~ ^[0-9]+$ ]]; then
    foco_y=$(date -d "@$ini" +%Y); foco_m=$(date -d "@$ini" +%-m); foco_d=$(date -d "@$ini" +%-d)
  else
    foco_y=$hoje_y; foco_m=$hoje_m; foco_d=$hoje_d
  fi
  local roxo=$'\e[38;5;141m' amar=$'\e[38;5;223m' cinza=$'\e[38;5;245m' inv=$'\e[7m' sub=$'\e[4m' z=$'\e[0m' neg=$'\e[1m'
  _cal_valido() { # ano mes dia -> ajusta dia ao último do mês se estourar
    local y=$1 m=$2 d=$3 ult
    ult=$(date -d "$y-$m-01 +1 month -1 day" +%-d 2>/dev/null) || ult=28
    ((d > ult)) && d=$ult; ((d < 1)) && d=1; echo "$y $m $d"
  }
  _cal_desenha() {
    local y=$foco_y m=$foco_m d=$foco_d
    local prim_dow ult sem lin col epoch_sel diaimp dstr wk
    prim_dow=$(date -d "$y-$m-01" +%w 2>/dev/null)       # 0=domingo
    ult=$(date -d "$y-$m-01 +1 month -1 day" +%-d 2>/dev/null)
    clear >/dev/tty 2>/dev/null
    local titulo
    titulo=$(printf '%s, %02d de %s de %s' "${TT_DIAS_SEMANA[$(date -d "$y-$m-$d" +%w)]^}" "$d" "${TT_MESES[$((m-1))]}" "$y")
    { printf '\n  %s%s%s%s\n\n' "$roxo" "$neg" "$titulo" "$z"
      printf '  %s       seg ter qua qui sex sáb dom%s\n' "$cinza" "$z"
      # começa na segunda; converte prim_dow (0=dom) para offset com semana ISO (seg=0)
      local off=$(( (prim_dow + 6) % 7 ))
      local diapos=1 linha semana_num
      while ((diapos <= ult)); do
        semana_num=$(date -d "$y-$m-$diapos" +%V 2>/dev/null)
        printf '  %ssem %2s %s' "$cinza" "$semana_num" "$z"
        local c
        for ((c=0;c<7;c++)); do
          if ((diapos==1 && c<off)); then printf '    '; continue; fi
          ((diapos>ult)) && { printf '    '; continue; }
          dstr=$(printf '%3d' "$diapos")
          if ((diapos==d)); then printf '%s%s%s%s ' "$roxo" "$inv" "$dstr" "$z"
          elif ((y==hoje_y && m==hoje_m && diapos==hoje_d)); then printf '%s%s%s%s ' "$amar" "$sub" "$dstr" "$z"
          else printf '%s ' "$dstr"; fi
          ((diapos++))
        done
        printf '\n'
        ((diapos>ult)) && break
      done
      printf '\n  %s← → dia · ↑ ↓ semana · < > mês · - + ano%s\n' "$cinza" "$z"
      printf '  %st hoje · x limpar · ⏎ escolher · esc sai%s\n' "$cinza" "$z"
    } >/dev/tty
  }
  local tecla rest
  # Em teste, TT_CAL_TECLAS traz as teclas a consumir (uma por caractere; "\n" = Enter), sem tty.
  local teste_teclas=${TT_CAL_TECLAS:-} teste_i=0
  _cal_tecla() { # lê uma tecla em "tecla"; retorna 1 no fim
    if [[ -n $teste_teclas ]]; then
      ((teste_i < ${#teste_teclas})) || return 1
      tecla=${teste_teclas:$teste_i:1}; teste_i=$((teste_i+1))
      [[ $tecla == $'\n' ]] && tecla=""   # Enter
      return 0
    fi
    IFS= read -rsn1 tecla </dev/tty
  }
  while :; do
    read -r foco_y foco_m foco_d < <(_cal_valido "$foco_y" "$foco_m" "$foco_d")
    [[ -n $teste_teclas ]] || _cal_desenha
    _cal_tecla || { echo ""; return 0; }
    case $tecla in
      $'\e')
        if [[ -n $teste_teclas ]]; then echo ""; return 0; fi
        read -rsn2 -t 0.01 rest </dev/tty || rest=""
        case $rest in
          '[C') foco_d=$((foco_d+1)) ;;  # →
          '[D') foco_d=$((foco_d-1)) ;;  # ←
          '[A') foco_d=$((foco_d-7)) ;;  # ↑
          '[B') foco_d=$((foco_d+7)) ;;  # ↓
          '') echo ""; return 0 ;;        # esc puro
        esac ;;
      h) foco_d=$((foco_d-1)) ;; l) foco_d=$((foco_d+1)) ;;
      k) foco_d=$((foco_d-7)) ;; j) foco_d=$((foco_d+7)) ;;
      '<'|',') foco_m=$((foco_m-1)); ((foco_m<1)) && { foco_m=12; foco_y=$((foco_y-1)); } ;;
      '>'|'.') foco_m=$((foco_m+1)); ((foco_m>12)) && { foco_m=1; foco_y=$((foco_y+1)); } ;;
      '-') foco_y=$((foco_y-1)) ;; '+'|'=') foco_y=$((foco_y+1)) ;;
      t|T) foco_y=$hoje_y; foco_m=$hoje_m; foco_d=$hoje_d ;;
      x|X) clear >/dev/tty 2>/dev/null; echo "limpar"; return 0 ;;
      '') clear >/dev/tty 2>/dev/null; date -d "$foco_y-$foco_m-$foco_d 12:00" +%s 2>/dev/null; return 0 ;;  # Enter
      q) echo ""; return 0 ;;
    esac
    # normaliza transbordo de dia entre meses
    while ((foco_d < 1)); do
      foco_m=$((foco_m-1)); ((foco_m<1)) && { foco_m=12; foco_y=$((foco_y-1)); }
      foco_d=$(( foco_d + $(date -d "$foco_y-$foco_m-01 +1 month -1 day" +%-d) ))
    done
    while :; do
      local ult; ult=$(date -d "$foco_y-$foco_m-01 +1 month -1 day" +%-d)
      ((foco_d <= ult)) && break
      foco_d=$((foco_d-ult)); foco_m=$((foco_m+1)); ((foco_m>12)) && { foco_m=1; foco_y=$((foco_y+1)); }
    done
  done
}

# Saída texto (CLI pura): usada por `tt --tarefas` fora do tmux e como fallback sem fzf.
tarefas_listar() {
  local n; n=$(tarefas_abertas_n)
  printf '📋 tarefas (%s aberta%s)\n' "$n" "$( ((n==1)) || printf s )"
  tarefas_vivas | awk -F'\t' '{ printf "  %s  %s  [%s]\n", ($2=="feita"?"✔":"▢"), $5, substr($1,1,6) }'
}

# Botão direito no 📋: ações rápidas sem abrir o painel inteiro.
menu_tarefas() {
  local c=$1
  menu_popup "$c" "📋 tarefas" <<ITENS
t	📋 Abrir o painel de tarefas	$EU --tarefas $(q "$c")
n	＋ Nova tarefa…	tmux display-popup -c $(q "$c") -E -w 70 -h 7 -T ' nova tarefa ' $(q "$EU --tarefa-add-ui")
l	🧹 Limpar as tarefas feitas	$EU --tarefa-limpar
