  printf '\t   %s▦ Calendário%s (e o relógio da barra) mostra o mês com • nos\n' "$y" "$z"
  printf '\t   dias com tarefas e cria tarefas no dia e na hora escolhidos.\n'
  printf '\t\n\t %sMOUSE%s\n' "$a" "$z"
  printf '\t   %sclique%s numa tarefa      abre/fecha os detalhes (▸ ▾)\n' "$n" "$z"
  printf '\t   %sduplo clique%s            marca/desmarca como feita\n' "$n" "$z"
  printf '\t   %sbotão direito%s           menu com todas as ações\n' "$n" "$z"
  printf '\t   clique numa %ssubtarefa%s   marca/desmarca\n' "$n" "$z"
  printf '\t   abas, botões do topo, títulos de dia da Agenda e as linhas de\n'
  printf '\t   uma tarefa aberta e o %s⋯ menu%s discreto à direita dela também\n' "$a" "$z"
  printf '\t   são clicáveis\n'
  printf '\t\n\t %sTECLADO%s\n' "$a" "$z"
  printf '\t   %s⏎%s feita/aberta   %s→ ␣%s abre   %s←%s fecha   %sTab%s próxima aba\n' "$y" "$z" "$y" "$z" "$y" "$z" "$y" "$z"
  printf '\t   %s^n%s nova   %s^s%s subtarefa   %s^e%s descrição   %s^d%s prazo   %sF2%s editar\n' "$y" "$z" "$y" "$z" "$y" "$z" "$y" "$z" "$y" "$z"
  printf '\t   %s^p%s prioridade   %s^r%s repetir   %s^k ^j%s sobe/desce   %s^x%s apaga\n' "$y" "$z" "$y" "$z" "$y" "$z" "$y" "$z"
  printf '\t   %s^t%s calendário   %s^o%s mais ações   %s^l%s arquiva/apaga as feitas   %s^/%s descrição\n' "$y" "$z" "$y" "$z" "$y" "$z" "$y" "$z"
  printf '\t   %s?%s ajuda   %sesc%s volta/fecha\n' "$y" "$z" "$y" "$z"
  printf '\t   %s(^n = Ctrl+N)%s\n' "$d" "$z"
  printf '\t\n\t %sSÍMBOLOS%s\n' "$a" "$z"
  printf '\t   %s☐%s aberta   %s☑%s feita   %s▸%s fechada   %s▾%s aberta (detalhes)\n' "$t" "$z" "$verde" "$z" "$a" "$z" "$a" "$z"
  printf '\t   %s●%s prioridade alta   %s●%s média   %s◷ sex 14:00%s prazo   %s◷ venceu%s atrasada\n' "$verm" "$z" "$y" "$z" "$s" "$z" "$verm" "$z"
  printf '\t   %s↻%s repete   %s━━━%s%s━━━%s 1/2 subtarefas feitas   %s≡%s tem descrição   %s#tag%s\n' "$teal" "$z" "$teal" "$z" "$d" "$z" "$s" "$z" "$lil" "$z"
  printf '\t\n\t %sSINCRONIA%s\n' "$a" "$z"
  printf '\t   As tarefas vão para as suas outras máquinas sozinhas\n'
  printf '\t   (tarefas_sync em ~/.config/tt/config: p2p, git, ambos ou off).\n'
  printf '\t   O botão 📋 da barra fica vermelho (⚠ N) quando algo vence hoje.\n'
}

# Menu de ações de uma tarefa, no próprio painel (botão direito, "⋯ mais ações" ou o botão ⋯ Mais).
tarefas_menu_linhas() { # id
  local id=$1 est txt m pai prazo prio rep pr
  IFS=$'\t' read -r est txt m < <(tarefas_raw | awk -F'\t' -v id="$id" '$1==id{print $2"\t"$5"\t"($6==""?"-":$6); exit}')
  [[ -n $est ]] || { printf 'voltar\t ‹ voltar (a tarefa não existe mais)\n'; return 0; }
  [[ $m == - ]] && m=""
  pai=$(tarefas_meta_get "$m" pai); prazo=$(tarefas_meta_get "$m" prazo)
  prio=$(tarefas_meta_get "$m" prio); rep=$(tarefas_meta_get "$m" rep)
  local z=$'\e[0m' t=$'\e[38;2;205;214;244m' d=$'\e[38;2;108;112;134m' a=$'\e[38;2;137;180;250m'
  local y=$'\e[38;2;249;226;175m' r=$'\e[38;2;243;139;168m' g=$'\e[38;2;166;227;161m' s=$'\e[38;2;166;173;200m'
  local n=$'\e[1m'
  _op() { # ação rótulo [dica]
    printf 'act:%s:%s\t   %s%s%s\n' "$1" "$id" "$2" "$z" "${3:+  $d$3$z}"
  }
  _escolha() { # ação marcado rótulo
    if [[ $2 == 1 ]]; then printf 'act:%s:%s\t     %s● %s%s\n' "$1" "$id" "$a$n" "$3" "$z"
    else printf 'act:%s:%s\t     %s○ %s%s\n' "$1" "$id" "$d" "$t$3" "$z"; fi
  }
  printf 'voltar\t %s‹ voltar para a lista%s\n\t\n' "$a$n" "$z"
  if [[ $est == arquivada ]]; then
    _op restaurar "$a↩ Restaurar para a lista" 'volta com as subtarefas, como estava'
    _op apagar "$r✕ Apagar de vez…" 'sem histórico'
    return 0
  fi
  local nfalta; nfalta=$(tarefas_subs_abertas "$id" | grep -c . || true)
  if [[ $est == feita ]]; then _op feita "$t↺ Reabrir (marcar como não feita)" '⏎'
  elif ((nfalta > 0)); then _op feita "$d☑ Marcar como feita" "falta$( ((nfalta > 1)) && echo m) $nfalta subtarefa$( ((nfalta > 1)) && echo s)"
  else _op feita "$g☑ Marcar como feita" '⏎ ou duplo clique'; fi
  if [[ -z $pai ]]; then _op editar "$t✎ Editar…" 'F2 · texto e @prazo !prioridade *repetir #etiqueta'
  else _op editar "$t✎ Editar…" 'F2 · o texto'; fi
  [[ -n $(tarefas_meta_get "$m" desc) ]] && _op ver "$t≡ Ver a descrição (cartão)" '^/'
  _op desc "$t✎ Descrição…" "$([[ -n $(tarefas_meta_get "$m" desc) ]] && echo 'editar · ^e' || echo 'escrever · ^e')"
  [[ -z $pai ]] && _op sub "$t↳ Adicionar subtarefa…" '^s'
  if [[ -z $pai ]]; then
    pr=$([[ -n $prazo ]] && tarefas_prazo_texto "$prazo" "$(tarefas_meta_get "$m" hora)")
    _op prazo "$t◷ Prazo e horário…" "${pr:-sem prazo} · ^d"
    printf '\t\n\t   %sPrioridade%s %s(^p alterna)%s\n' "$s" "$z" "$d" "$z"
    _escolha prio1 "$([[ $prio == 1 ]] && echo 1)" "${r}●$z$t Alta"
    _escolha prio2 "$([[ $prio == 2 ]] && echo 1)" "${y}●$z$t Média"
    _escolha prio0 "$([[ -z $prio ]] && echo 1)" 'Sem prioridade'
    printf '\t\n\t   %sRepetir%s %s(ao concluir, o prazo avança · ^r alterna)%s\n' "$s" "$z" "$d" "$z"
    _escolha rep0 "$([[ -z $rep ]] && echo 1)" 'Não repete'
    _escolha repd "$([[ $rep == d ]] && echo 1)" 'Todo dia'
    _escolha repw "$([[ $rep == w ]] && echo 1)" 'Toda semana'
    _escolha repm "$([[ $rep == m ]] && echo 1)" 'Todo mês'
    printf '\t\n'
  fi
  _op cima "$t↑ Subir" '^k'
  _op baixo "$t↓ Descer" '^j'
  [[ -z $pai ]] && _op arquivar "$t▤ Arquivar" 'sai da lista e fica no histórico (aba Arquivo)'
  _op apagar "$r✕ Apagar…" '^x · sem histórico'
}

# O id da tarefa por trás de uma chave de linha ("desc:ID", "sub:ID", "menu:ID" ou o próprio ID).
tarefas_id_da_chave() {
  case $1 in
    desc:*|sub:*|menu:*|rest:*|apag:*) echo "${1#*:}" ;;
    act:*) echo "${1##*:}" ;;
    criar|voltar|dia:*|'') : ;;
    *) echo "$1" ;;
  esac
}

# É tarefa de topo (sem mãe)? Imprime a mãe quando é subtarefa.
tarefas_pai_de() { tarefas_meta_get "$(tarefas_meta_de "$1")" pai; }

# Despachante único do painel: recebe o evento (tecla, clique ou botão) e a chave da linha em foco e
# imprime as ações que o fzf deve executar. Lê a busca em FZF_QUERY.
tarefa_acao() { # evento chave
  local ev=$1 chave=${2:-} qy=${FZF_QUERY:-} modo id pai
  [[ -n ${TT_TAREFAS_LOG:-} ]] && printf '%s ev=%s chave=%s q=%s\n' "$(date +%T.%N)" "$ev" "$chave" "$qy" >>"$TT_TAREFAS_LOG"
  local rl="reload-sync($EU --tarefas-lista {q})" hd="transform-header($EU --tarefas-cabecalho)"
  modo=$(tarefas_ui_get modo); modo=${modo:-lista}
  id=$(tarefas_id_da_chave "$chave")
  # Teclas que também servem para digitar na busca: só agem com a busca vazia.
  case $ev in
    espaco)       [[ -n $qy ]] && { echo 'put( )'; return; } ;;
    interrogacao) [[ -n $qy ]] && { echo 'put(?)'; return; } ;;
    direita)      [[ -n $qy ]] && { echo 'forward-char'; return; } ;;
    esquerda)     [[ -n $qy ]] && { echo 'backward-char'; return; } ;;
  esac
  # Duplo clique: como o 1º clique já recarrega a lista, o fzf costuma entregar dois cliques simples
  # em vez do evento double-click. Então o 2º clique na MESMA linha em menos de 400 ms vira "duplo"
  # (e o double-click nativo, quando vem, também). Em outra linha ou mais devagar é clique comum.
  local ultimo agora_ms ult_ms
  agora_ms=${EPOCHREALTIME:-$(date +%s).0}; agora_ms=${agora_ms/[.,]/}; agora_ms=$((10#${agora_ms:0:13}))
  read -r ultimo ult_ms <<<"$(tarefas_ui_get clique)"
  if [[ $ev == clique && -n $chave && $ultimo == "$chave" ]] && ((agora_ms - ${ult_ms:-0} < 400)); then ev=duplo; fi
  if [[ $ev == clique ]]; then tarefas_ui_set clique "$chave $agora_ms"
  elif [[ $ev == duplo ]]; then tarefas_ui_set clique ""; fi
  if [[ $ev == cabecalho ]]; then
    ev=$(tarefas_cabecalho_acao); [[ -n $ev ]] || { echo ignore; return; }
  fi
  # Fora da lista (ajuda e menu), só voltar, fechar e o item do menu fazem sentido.
  _volta() { tarefas_ui_set modo lista; echo "clear-query+$rl+$hd"; }
  case $ev in
    esc)
      if [[ $modo != lista ]]; then _volta
      elif [[ -n $qy ]]; then echo clear-query
      else echo abort; fi
      return ;;
    voltar) _volta; return ;;
    interrogacao|ajuda)
      if [[ $modo == ajuda ]]; then _volta
      else tarefas_ui_set modo ajuda; echo "clear-query+$rl+$hd+first"; fi
      return ;;
    filtro:*|filtro-proximo)
      if [[ $ev == filtro-proximo ]]; then tarefas_filtro_ciclar; else tarefas_filtro_set "${ev#filtro:}"; fi
      tarefas_ui_set modo lista; echo "$rl+$hd+first"; return ;;
    nova)
      tarefas_ui_set modo lista; echo "execute($EU --tarefa-nova-prompt)+clear-query+$rl+$hd"; return ;;
    calendario)
      echo "execute(TT_CAL_DENTRO=1 $EU --calendario-agenda)+$rl+$hd"; return ;;
    limpar)
      echo "execute($EU --tarefa-limpar-prompt)+$rl+$hd"; return ;;
  esac
  # Linhas especiais da lista.
  case $chave in
    voltar) [[ $ev == enter || $ev == clique ]] && { _volta; return; } ;;
    dia:*)
      # Título de um dia na agenda: abre o calendário nesse dia.
      [[ $ev == enter || $ev == clique ]] && { echo "execute(TT_CAL_DENTRO=1 $EU --calendario-agenda ${chave#dia:})+$rl+$hd"; return; } ;;
    criar|'')
      if [[ -n $qy && ( $ev == enter || $chave == criar && $ev == clique ) ]]; then
        tarefa_add_natural "$qy" >/dev/null
        echo "clear-query+$rl+$hd"; return
      fi
      [[ -z $chave ]] && { echo ignore; return; } ;;
    act:*)
      if [[ $ev == enter || $ev == clique ]]; then
        local op=${chave#act:}; op=${op%%:*}
        tarefas_ui_set modo lista
        case $op in
          ver) echo "clear-query+$rl+$hd+show-preview"; return ;;
          prio1|prio2) tarefa_set_prio "$id" "${op#prio}" ;;
          prio0) tarefa_set_prio "$id" "" ;;
          rep0) tarefa_set_rep "$id" "" ;;
          repd|repw|repm) tarefa_set_rep "$id" "${op#rep}" ;;
          *) tarefa_acao "$op" "$id"; return ;;
        esac
        echo "$rl+$hd"; return
      fi ;;
  esac
  [[ -n $id ]] || { echo ignore; return; }
  pai=$(tarefas_pai_de "$id")
  # Marca/desmarca. Mãe com subtarefa aberta não conclui: avisa no cabeçalho e abre a mãe para
  # mostrar o que falta.
  _marcar() {
    local falta n
    falta=$(tarefa_alternar "$1") && { echo "$rl+$hd"; return; }
    if [[ -n $falta ]]; then
      n=$(grep -c . <<<"$falta")
      tarefas_ui_set aviso "⚠ Para concluir, falta$( ((n > 1)) && echo m) $n subtarefa$( ((n > 1)) && echo s): $(awk 'NR > 1 { printf ", " } { printf "%s", $0 }' <<<"$falta")"
      tarefas_exp_definir "$1" 1
    fi
    echo "$rl+$hd"
  }
  if [[ $ev == duplo ]]; then
    [[ $ultimo == "$chave" ]] || { echo ignore; return; }
  fi
  local txt_t; txt_t=$(tarefas_raw | awk -F'\t' -v id="$id" '$1==id{print $5; exit}')
  # Arquivo: restaurar e apagar de vez; o resto não mexe numa tarefa arquivada.
  case $chave in
    rest:*) [[ $ev == enter || $ev == clique ]] || { echo ignore; return; }
            tarefa_restaurar "$id"; tarefas_ui_set aviso "↩ Restaurada para a lista: $txt_t"; echo "$rl+$hd"; return ;;
    apag:*) [[ $ev == enter || $ev == clique ]] || { echo ignore; return; }
            echo "execute($EU --tarefa-remover-prompt $id)+$rl+$hd"; return ;;
  esac
  case $ev in
    arquivar)
      if [[ -n $pai ]]; then tarefas_ui_set aviso "⚠ Subtarefa não se arquiva sozinha: arquive a tarefa (leva as subtarefas)"
      else tarefa_arquivar "$id"; tarefas_ui_set aviso "▤ Arquivada: $txt_t · está na aba Arquivo"; fi
      echo "$rl+$hd"; return ;;
    restaurar) tarefa_restaurar "${pai:-$id}"; tarefas_ui_set aviso "↩ Restaurada para a lista: $txt_t"; echo "$rl+$hd"; return ;;
  esac
  if [[ $(tarefas_estado_de "${pai:-$id}") == arquivada ]]; then
    case $ev in
      enter|clique|duplo)
        [[ -z $pai && $chave == "$id" ]] && { tarefas_exp_alternar "$id"; echo "$rl"; return; }
        [[ $chave == desc:* ]] || { echo ignore; return; } ;;
      menu|mais|espaco|direita|esquerda|apagar|desc) ;;
      *) tarefas_ui_set aviso "⚠ Tarefa arquivada: ↩ restaure (menu ⋯ ou a linha ↩) para mexer nela"; echo "$rl+$hd"; return ;;
    esac
  fi
  case $ev in
    enter|clique)
      case $chave in
        desc:*)
          # Com descrição: abre/fecha a visão da descrição (a janela de prévia). Sem: escreve.
          if [[ -n $(tarefas_meta_get "$(tarefas_meta_de "$id")" desc) ]]; then echo toggle-preview
          else echo "execute($EU --tarefa-desc-prompt $id)+$rl"; fi
          return ;;
        sub:*) echo "execute($EU --tarefa-sub-prompt $id)+$rl+$hd"; return ;;
        menu:*) tarefas_ui_set modo "menu:$id"; echo "clear-query+$rl+$hd+first"; return ;;
      esac
      # Clique numa tarefa de topo abre/fecha os detalhes; ⏎ e clique numa subtarefa marcam.
      if [[ $ev == clique && -z $pai ]]; then tarefas_exp_alternar "$id"; echo "$rl"
      else _marcar "$id"; fi ;;
    duplo)
      # O 1º clique do duplo já abriu/fechou a tarefa de topo: desfaz e marca como feita.
      [[ $chave == "$id" ]] || { echo ignore; return; }
      if [[ -z $pai ]]; then tarefas_exp_alternar "$id"; _marcar "$id"
      else echo ignore; fi ;;
    feita) _marcar "$id" ;;
    menu|mais)
      [[ $modo == "menu:$id" ]] && { _volta; return; }
      tarefas_ui_set modo "menu:$id"; echo "clear-query+$rl+$hd+first" ;;
    espaco)
      [[ -n $pai ]] && id=$pai
      tarefas_exp_alternar "$id"; echo "$rl" ;;
    direita) [[ -z $pai ]] && tarefas_exp_definir "$id" 1; echo "$rl" ;;
    esquerda) [[ -n $pai ]] && id=$pai; tarefas_exp_definir "$id" 0; echo "$rl" ;;
    sub)
      [[ -n $pai ]] && id=$pai
      echo "execute($EU --tarefa-sub-prompt $id)+$rl+$hd" ;;
    desc) echo "execute($EU --tarefa-desc-prompt $id)+$rl" ;;
    prazo) [[ -n $pai ]] && id=$pai; echo "execute($EU --tarefa-prazo-prompt $id)+$rl+$hd" ;;
    editar|renomear) echo "execute($EU --tarefa-editar-prompt $id)+$rl+$hd" ;;
    prio) [[ -n $pai ]] && id=$pai; tarefa_prio_ciclar "$id"; echo "$rl" ;;
    rep) [[ -n $pai ]] && id=$pai; tarefa_rep_ciclar "$id"; echo "$rl" ;;
    cima|baixo) tarefa_mover "$id" "$ev"; echo "$rl" ;;
    apagar) echo "execute($EU --tarefa-remover-prompt $id)+$rl+$hd" ;;
    *) echo ignore ;;
  esac
}

# Visão da descrição (a janela de prévia do painel, ^/ ou a linha "≡ descrição" de uma tarefa
# aberta): um cartão com o título, prazo/prioridade/repetição/etiquetas, a descrição inteira e as
# subtarefas.
tarefa_preview() { # chave
  local id m txt prazo desc
  id=$(tarefas_id_da_chave "${1:-}")
  [[ -n $id ]] || return 0
  txt=$(tarefas_raw | awk -F'\t' -v id="$id" '$1==id{print $5; exit}')
  [[ -n $txt ]] || return 0
  m=$(tarefas_meta_de "$id")
  local z=$'\e[0m' n=$'\e[1m' t=$'\e[38;2;205;214;244m' s=$'\e[38;2;166;173;200m' d=$'\e[38;2;108;112;134m'
  local verm=$'\e[38;2;243;139;168m' amar=$'\e[38;2;249;226;175m' teal=$'\e[38;2;148;226;213m' lil=$'\e[38;2;203;166;247m'
  local verde=$'\e[38;2;166;227;161m'; local -a info=()
  printf '%s%s%s\n' "$n$t" "$txt" "$z"
  prazo=$(tarefas_meta_get "$m" prazo)
  [[ -n $prazo ]] && info+=("$s◷ $(tarefas_prazo_texto "$prazo" "$(tarefas_meta_get "$m" hora)")$z")
  case $(tarefas_meta_get "$m" prio) in 1) info+=("$verm● alta$z") ;; 2) info+=("$amar● média$z") ;; esac
  case $(tarefas_meta_get "$m" rep) in d) info+=("$teal↻ diária$z") ;; w) info+=("$teal↻ semanal$z") ;; m) info+=("$teal↻ mensal$z") ;; esac
  local tgs; tgs=$(tarefas_meta_get "$m" tags); [[ -n $tgs ]] && info+=("$lil#${tgs//,/ #}$z")
  ((${#info[@]})) && { local IFS=$'\x1f'; printf '%s\n' "${info[*]}" | sed $'s/\x1f/   /g'; }
  printf '\n'
  desc=$(tarefa_get_desc "$id")
  if [[ -n $desc ]]; then printf '%s\n' "$desc"
  else printf '%sSem descrição. ^e (ou ✎ Descrição) escreve uma.%s\n' "$d" "$z"; fi
  local arq; arq=$(tarefas_meta_get "$m" arq)
  [[ -n $arq ]] && printf '%s▤ Arquivada em %s · ↩ restaura pelo menu ⋯%s\n' "$d" "$(tt_fmt_epoch "${arq%%:*}" +%d/%m/%Y)" "$z"
  local sid sest stxt nf=0 nt=0 subs=""
  while IFS=$'\t' read -r sid sest stxt; do
    [[ -n $sid ]] || continue
    nt=$((nt + 1)); [[ $sest == feita ]] && nf=$((nf + 1))
    subs+="  $([[ $sest == feita ]] && echo "$verde☑$z $d$stxt$z" || echo "$t☐ $stxt$z")"$'\n'
  done < <(tarefas_raw | awk -F'\t' -v p="$id" '
    function mv(m, k,   n, a, i) { n = split(m, a, "|"); for (i = 1; i <= n; i++) if (index(a[i], k "=") == 1) return substr(a[i], length(k) + 2); return "" }
    mv($6, "pai") == p && ($2 == "aberta" || $2 == "feita" || $2 == "arquivada") {
      e = $2; if (e == "arquivada") e = (mv($6, "arq") ~ /:a$/ ? "aberta" : "feita")
      print mv($6, "ord") + 0 "\t" $1 "\t" e "\t" $5 }' | sort -t$'\t' -k1,1n | cut -f2-)
  ((nt > 0)) && printf '\n%sSubtarefas %s/%s%s\n%s' "$s" "$nf" "$nt" "$z" "$subs"
  return 0
}

# Cartão de explicação da sintaxe natural, mostrado ao criar uma tarefa.
tarefas_dica_frase() {
  local z=$'\e[0m' y=$'\e[38;2;249;226;175m' d=$'\e[38;2;108;112;134m'
  printf '  %sNo título dá para incluir, em qualquer ponto (tudo opcional):%s\n' "$d" "$z"
  printf '    %s@amanha%s       prazo       %s@hoje @amanha @seg…@dom @25/12%s\n' "$y" "$z" "$d" "$z"
  printf '    %s@sex 14h%s      com horário %s@14h @sex 9:30 @amanha às 18h%s\n' "$y" "$z" "$d" "$z"
  printf '    %s!alta%s         prioridade  %s!alta !media%s\n' "$y" "$z" "$d" "$z"
  printf '    %s*semanal%s      repetir     %s*diaria *semanal *mensal%s\n' "$y" "$z" "$d" "$z"
  printf '    %s#casa%s         etiqueta\n' "$y" "$z"
  printf '  %sex.: Reunião com a Ana @sex 14h !alta%s\n\n' "$d" "$z"
}

# Lê o texto de uma tarefa nova em TT_NOVA: uma linha com edição; colar texto com várias linhas
# traz tudo (a 1ª linha é o título, o resto a descrição) e Ctrl+E abre o editor do tt com o que já
# foi digitado (título em cima, descrição embaixo) e cria ao salvar. Na edição, a linha vem
# preenchida com a frase da tarefa e o editor mostra a descrição atual embaixo; TT_NOVA_EDITOR=1
# diz que o texto passou pelo editor. Sem terminal (testes), lê a entrada inteira.
tarefas_ler_nova() { # [rótulo] [texto-inicial] [descrição-para-o-editor]
  TT_NOVA="" TT_NOVA_EDITOR=""
  if ! [[ -t 0 ]]; then TT_NOVA=$(cat); return 0; fi
  _tt_nova_buf="" _tt_nova_desc=${3:-}
  _tt_nova_guarda() { _tt_nova_buf=$READLINE_LINE; }
  _tt_nova_editor() {
    local tmp; tmp=$(mktemp "${TMPDIR:-/tmp}/tt-tarefa-nova.XXXXXX") || return 0
    printf '%s\n' "$READLINE_LINE" >"$tmp"
    [[ -n $_tt_nova_desc ]] && printf '\n%s\n' "$_tt_nova_desc" >>"$tmp"
    local -a ed; read -ra ed <<<"$(editor_tt)"
    [[ ${ed[0]##*/} == nano ]] && ed+=(-t)
    "${ed[@]}" "$tmp" </dev/tty >/dev/tty 2>&1
    _tt_nova_buf=$(cat "$tmp"); rm -f "$tmp"; TT_NOVA_EDITOR=1
    READLINE_LINE=${_tt_nova_buf%%$'\n'*}; READLINE_POINT=${#READLINE_LINE}
  }
  # ⏎ guarda o buffer inteiro antes de confirmar (o read corta na 1ª quebra de linha);
  # Ctrl+E abre o editor e confirma na volta.
  bind -x '"\C-x\C-y": _tt_nova_guarda' 2>/dev/null
  bind -x '"\C-x\C-v": _tt_nova_editor' 2>/dev/null
  bind '"\C-m": "\C-x\C-y\C-j"' 2>/dev/null
  bind '"\C-e": "\C-x\C-v\C-j"' 2>/dev/null
  local v rc=0
  IFS= read -r -e ${2:+-i "$2"} -p "  ${1:+$1 }❯ " v || rc=1
  # devolve o ⏎ e o Ctrl+E ao normal: o processo pode abrir outros prompts depois (calendário)
  bind '"\C-m": accept-line' 2>/dev/null; bind '"\C-e": end-of-line' 2>/dev/null
  ((rc == 0)) || return 1
  TT_NOVA=${_tt_nova_buf:-$v}
}

# Lê uma linha (com edição de linha quando há terminal). TEXTO inicial e RÓTULO opcionais.
tarefas_ler_linha() { # variável [texto-inicial] [rótulo]
  local _v
  if [[ -t 0 ]]; then IFS= read -r -e ${2:+-i "$2"} -p "  ${3:+$3 }❯ " _v || return 1
  else IFS= read -r _v || return 1; fi
  printf -v "$1" '%s' "$_v"
}

# Prompt de nova tarefa (chamado por execute() do fzf: tem o TTY). Ctrl+E escreve no editor
# (com descrição); ⏎ cria só com o título.
tarefa_nova_prompt() {
  local z=$'\e[0m' a=$'\e[38;2;137;180;250m\e[1m' d=$'\e[38;2;108;112;134m' y=$'\e[38;2;249;226;175m'
  clear 2>/dev/null
  printf '\n  %s+ Nova tarefa%s\n' "$a" "$z"
  printf '  %s⏎ cria · %sCtrl+E%s%s escreve no editor, com descrição (1ª linha = título) · ⏎ vazio cancela%s\n\n' "$d" "$y" "$z" "$d" "$z"
  tarefas_dica_frase
  tarefas_ler_nova "Título" || return 0
  [[ -n ${TT_NOVA//[[:space:]]/} ]] && tarefa_add_natural "$TT_NOVA" >/dev/null
  return 0
}

# Confirmação com dois botões clicáveis (tela cheia, dentro do popup). "s" ou clique no botão
# confirma; ⏎, esc, "n" ou clique em Cancelar desistem (o padrão é não fazer nada). Sem
# terminal (testes), lê uma linha: "s"/"sim" confirma.
tarefas_confirmar() { # título detalhe rótulo-do-botão
  local tit=$1 det=$2 bot=$3 k resto r=1
  local z=$'\e[0m' n=$'\e[1m' d=$'\e[38;2;108;112;134m' t=$'\e[38;2;205;214;244m'
  local bv=$'\e[48;2;243;139;168m\e[38;2;30;30;46m\e[1m' bc=$'\e[48;2;49;50;68m\e[38;2;205;214;244m'
  if ! [[ -t 0 ]]; then
    IFS= read -r k || return 1; [[ ${k,,} == s || ${k,,} == sim ]]; return
  fi
  clear 2>/dev/null
  printf '\n  %s%s%s\n\n  %s%s%s\n\n\n' "$n$t" "$tit" "$z" "$d" "$det" "$z"
  # Linha 7: "  [ s  Apagar ]   [ esc  Cancelar ]"
  local b1=" s  $bot " b2=" esc  Cancelar "
  printf '  %s%s%s   %s%s%s\n' "$bv" "$b1" "$z" "$bc" "$b2" "$z"
  local x1=3 x1f=$((2 + ${#b1})) x2=$((2 + ${#b1} + 4)); local x2f=$((x2 + ${#b2} - 1))
  printf '\e[?1000h\e[?1006h'
  while IFS= read -rsn1 k; do
    case $k in
      s|S) r=0; break ;;
      n|N|q|'') break ;;
      $'\e')
        IFS= read -rsn1 -t 0.05 resto || break
        [[ $resto == '[' ]] || break
        IFS= read -rsn1 -t 0.05 resto || break
        [[ $resto == '<' ]] || break
        local ev=""; while IFS= read -rsn1 -t 0.05 resto; do ev+=$resto; [[ $resto == [Mm] ]] && break; done
        [[ $ev == *M ]] || continue
        local b x y; IFS=';' read -r b x y <<<"${ev%M}"
        ((b == 0 && y == 7)) || continue
        if ((x >= x1 && x <= x1f)); then r=0; break; fi
        if ((x >= x2 && x <= x2f)); then break; fi ;;
    esac
  done
  printf '\e[?1000l\e[?1006l'
  return $r
}

# Confirmação de remoção (chamado por execute() do fzf: tem o TTY).
tarefa_remover_prompt() {
  local id=$1 txt nsub
  [[ -n $id ]] || return 0
  txt=$(tarefas_raw | awk -F'\t' -v id="$id" '$1==id{print $5; exit}')
  [[ -n $txt ]] || return 0
  nsub=$(tarefas_filhas "$id" | grep -c . || true)
  tarefas_confirmar "Apagar esta tarefa de vez?" "$txt$( ((nsub > 0)) && printf ' (e %s subtarefa%s)' "$nsub" "$( ((nsub > 1)) && echo s)") — sem histórico; para guardar, use ▤ Arquivar" Apagar &&
    tarefa_remover "$id"
  return 0
}

# Escolha entre botões clicáveis (tela cheia, dentro do popup). Cada opção é "tecla|rótulo"; a
# 1ª é a padrão (⏎) e vem destacada; esc, n ou q cancelam. Imprime a tecla escolhida (nada se
# cancelou). Sem terminal (testes): lê uma linha — vazia escolhe a 1ª, uma tecla escolhe a dela.
tarefas_escolha() { # título detalhe opção...
  local tit=$1 det=$2; shift 2
  local -a tec=() rot=() x1=() x2=()
  local o k resto i x=3 z=$'\e[0m' n=$'\e[1m' d=$'\e[38;2;108;112;134m' t=$'\e[38;2;205;214;244m'
  local b1=$'\e[48;2;137;180;250m\e[38;2;30;30;46m\e[1m' bo=$'\e[48;2;49;50;68m\e[38;2;205;214;244m'
  for o in "$@"; do tec+=("${o%%|*}"); rot+=("${o#*|}"); done
  if ! [[ -t 0 ]]; then
    IFS= read -r k || return 0
    [[ -z $k ]] && { echo "${tec[0]}"; return 0; }
    for i in "${!tec[@]}"; do [[ ${k,,} == "${tec[i]}" ]] && { echo "${tec[i]}"; return 0; }; done
    return 0
  fi
  clear >/dev/tty 2>/dev/null
  printf '\n  %s%s%s\n\n' "$n$t" "$tit" "$z" >/dev/tty
  printf '%s\n' "$det" | sed "s/^/  $d/; s/\$/$z/" >/dev/tty
  printf '\n' >/dev/tty
  # Um botão por linha (cabe em tela estreita): linha de cada um em lin[], colunas em x1/x2.
  local -a lin=() ; local y=$(( 4 + $(printf '%s\n' "$det" | wc -l) + 1 )) r
  for i in "${!tec[@]}"; do
    r=" ${tec[i]}  ${rot[i]} "
    lin+=("$y"); x1+=(3); x2+=("$((2 + ${#r}))"); y=$((y + 2))
    printf '  %s%s%s\n\n' "$( ((i == 0)) && echo "$b1" || echo "$bo")" "$r" "$z" >/dev/tty
  done
  r=" esc  Cancelar "; lin+=("$y"); x1+=(3); x2+=("$((2 + ${#r}))")
  printf '  %s%s%s\n\n  %s⏎ escolhe o destacado · clique num botão%s\n' "$bo" "$r" "$z" "$d" "$z" >/dev/tty
  printf '\e[?1000h\e[?1006h' >/dev/tty
  local esc=""
  while IFS= read -rsn1 k </dev/tty; do
    case $k in
      '') esc=${tec[0]}; break ;;
      n|N|q) break ;;
      $'\e')
        IFS= read -rsn1 -t 0.05 resto </dev/tty || break
        [[ $resto == '[' ]] || break
        IFS= read -rsn1 -t 0.05 resto </dev/tty || break
        [[ $resto == '<' ]] || break
        local ev=""; while IFS= read -rsn1 -t 0.05 resto </dev/tty; do ev+=$resto; [[ $resto == [Mm] ]] && break; done
        [[ $ev == *M ]] || continue
        local b xx yy hit=-1; IFS=';' read -r b xx yy <<<"${ev%M}"
        ((b == 0)) || continue
        for i in "${!lin[@]}"; do ((yy == lin[i] && xx >= x1[i] && xx <= x2[i])) && { hit=$i; break; }; done
        ((hit >= 0)) || continue
        ((hit < ${#tec[@]})) && esc=${tec[hit]}
        break ;;
      *) for i in "${!tec[@]}"; do [[ ${k,,} == "${tec[i]}" ]] && { esc=${tec[i]}; break 2; }; done ;;
    esac
  done
  printf '\e[?1000l\e[?1006l' >/dev/tty
  [[ -n $esc ]] && echo "$esc"
  return 0
}

# ^l / menu do 📋: o que fazer com as tarefas feitas — arquivar (padrão: guarda o histórico) ou
# apagar de vez. Subtarefas feitas de tarefa aberta ficam (são o checklist dela).
tarefa_limpar_prompt() {
  local n c det
  n=$(tarefas_raw | awk -F'\t' '$2 == "feita" && $6 !~ /(^|\|)pai=/' | wc -l | tr -d ' ')
  if ((n == 0)); then
    [[ -t 0 ]] && { clear 2>/dev/null; printf '\n  Nenhuma tarefa feita para arquivar ou apagar.\n'; sleep 1.2; }
    return 0
  fi
  det="$n tarefa$( ((n > 1)) && echo s) feita$( ((n > 1)) && echo s) (com as subtarefas) $( ((n > 1)) && echo saem || echo sai) da lista.
Arquivar guarda no histórico (aba Arquivo; dá para restaurar).
Apagar de vez não guarda nada: some sem histórico."
  c=$(tarefas_escolha "O que fazer com as tarefas feitas?" "$det" "a|▤ Arquivar (guarda no histórico)" "x|✕ Apagar de vez (sem histórico)")
  case $c in
    a) tarefas_arquivar_feitas >/dev/null ;;
    x) tarefa_limpar_feitas ;;
  esac
  return 0
}

# Nova subtarefa de ID (prompt de linha; tem o TTY via execute()).
tarefa_sub_prompt() {
  local id=$1 t txt z=$'\e[0m' a=$'\e[38;2;137;180;250m\e[1m' d=$'\e[38;2;108;112;134m'
  [[ -n $id ]] || return 0
  txt=$(tarefas_raw | awk -F'\t' -v id="$id" '$1==id{print $5; exit}')
  clear 2>/dev/null
  printf '\n  %s↳ Nova subtarefa%s de: %s\n  %sEscreva e tecle ⏎ · ⏎ vazio cancela%s\n\n' "$a" "$z" "$txt" "$d" "$z"
  tarefas_ler_linha t || return 0
  [[ -n ${t:-} ]] && { tarefa_add_sub "$id" "$t" >/dev/null; tarefas_exp_definir "$id" 1; }
  return 0
}

# Renomeia uma tarefa (o texto vem preenchido para editar).
tarefa_renomear() { # id texto
  local id=$1 txt now tmp; txt=$(tarefas_limpa_texto "$2"); [[ -n $txt ]] || return 1
  [[ -f $CONF_TAREFAS ]] || return 1
  now=$(date +%s)
  tarefas_travar || return 1
  tmp=$(mktemp "$CONF_TAREFAS.XXXXXX")
  TT_TXT=$txt awk -F'\t' -v OFS='\t' -v id="$id" -v now="$now" '
    NF>=5 { if ($1==id) { $4=now; $5=ENVIRON["TT_TXT"] } print }' "$CONF_TAREFAS" >"$tmp"
  mv "$tmp" "$CONF_TAREFAS"; marcar_tarefas
  tarefas_destravar
  atualizar_barras 2>/dev/null
  ("$EU" --tarefas-espelhar >/dev/null 2>&1 &)
}
# Prompt de edição (F2, ✎ Editar na barra, ⋯ menu; chamado por execute() do fzf: tem o TTY): a
# frase da tarefa volta preenchida — título com @prazo !prioridade *repetição #etiquetas — para
# mudar, tirar ou acrescentar; ⏎ grava relendo como na criação (tarefa_editar), Ctrl+E abre o
# editor com a descrição embaixo (o que voltar vale, descrição inclusive), ⏎ vazio ou a frase
# igual cancela. Subtarefa: só o texto. Sem terminal (testes), lê a entrada inteira.
tarefa_editar_prompt() {
  local id=$1 t txt frase z=$'\e[0m' a=$'\e[38;2;137;180;250m\e[1m' d=$'\e[38;2;108;112;134m' y=$'\e[38;2;249;226;175m'
  [[ -n $id ]] || return 0
  txt=$(tarefas_raw | awk -F'\t' -v id="$id" '$1==id{print $5; exit}')
  [[ -n $txt ]] || return 0
  clear 2>/dev/null
  if [[ -n $(tarefas_pai_de "$id") ]]; then
    printf '\n  %s✎ Editar subtarefa%s\n  %sEdite e tecle ⏎ · apague tudo para cancelar%s\n\n' "$a" "$z" "$d" "$z"
    tarefas_ler_linha t "$txt" || return 0
    [[ -n ${t:-} && $t != "$txt" ]] && tarefa_renomear "$id" "$t"
    return 0
  fi
  frase=$(tarefas_frase_de "$id")
  printf '\n  %s✎ Editar tarefa%s\n' "$a" "$z"
  printf '  %s⏎ grava · %sCtrl+E%s%s abre no editor, com a descrição embaixo · ⏎ vazio cancela%s\n' "$d" "$y" "$z" "$d" "$z"
  printf '  %sTire um marcador para tirar o atributo: sem @ fica sem prazo, sem ! sem prioridade,\n  sem * não repete, sem # sem etiqueta. A descrição só muda pelo editor.%s\n\n' "$d" "$z"
  tarefas_dica_frase
  tarefas_ler_nova "Tarefa" "$frase" "$(tarefa_get_desc "$id")" || return 0
  [[ -n ${TT_NOVA//[[:space:]]/} ]] || return 0
  [[ -z $TT_NOVA_EDITOR && $TT_NOVA == "$frase" ]] && return 0
  tarefa_editar "$id" "$TT_NOVA" ${TT_NOVA_EDITOR:+--desc}
  return 0
}
tarefa_renomear_prompt() { tarefa_editar_prompt "$@"; }   # nome antigo

# Editor de texto do tt: VISUAL/EDITOR do usuário mandam; sem eles, o vim com a configuração
# bonita do próprio tt (cores, mouse, quebra de linha, Ctrl+S salva e sai — sem tocar no seu
# ~/.vimrc), senão vi, senão nano. Imprime o comando (pode ter mais de uma palavra).
editor_tt() {
  local ed=${VISUAL:-${EDITOR:-}}
  if [[ -n $ed ]]; then echo "$ed"; return 0; fi
  if command -v vim >/dev/null; then vimrc_tt_garantir; echo "vim -u $DIR_TT/vimrc-tt"
  elif command -v vi >/dev/null; then echo vi
  else echo nano; fi
}

# O vimrc do tt (gerado; vim -u ele, o ~/.vimrc do usuário fica em paz).
vimrc_tt_garantir() {
  local f=$DIR_TT/vimrc-tt tmp
  tmp=$(mktemp) || return 0
  cat >"$tmp" <<'VIMRC'
" Editor do tt — bonito e direto. Salvar e sair: Ctrl+S (ou ZZ, ou :x). Cancelar: :q!
set nocompatible
syntax on
set background=dark
if has('termguicolors') && ($COLORTERM ==# 'truecolor' || $COLORTERM ==# '24bit')
  set termguicolors
endif
silent! colorscheme habamax
set mouse=a                      " clique posiciona, roda rola, arrasto seleciona
set clipboard^=unnamed,unnamedplus
set number cursorline scrolloff=3
set wrap linebreak breakindent display=lastline
set backspace=indent,eol,start whichwrap+=<,>,[,]
set incsearch hlsearch ignorecase smartcase
set wildmenu ttimeoutlen=50 shortmess+=I
set noswapfile nobackup undofile undodir=~/.cache/tt-vim-undo//
silent! call mkdir(expand('~/.cache/tt-vim-undo'), 'p', 0700)
set laststatus=2
let &statusline = ' %t %m%=Ctrl+S salva e sai · :q! cancela  %l/%L '
nnoremap <silent> <C-s> :x<CR>
inoremap <silent> <C-s> <Esc>:x<CR>
vnoremap <silent> <C-s> <Esc>:x<CR>
" Arquivo vazio: já começa escrevendo.
autocmd VimEnter * if line('$') == 1 && empty(getline(1)) | startinsert | endif
VIMRC
  mkdir -p "$DIR_TT" 2>/dev/null
  cmp -s "$tmp" "$f" 2>/dev/null || cat "$tmp" >"$f"
  rm -f "$tmp"
}

# Edita a descrição de ID no editor do tt (editor_tt: o vim com a configuração do tt, a não ser
# que VISUAL/EDITOR digam outro). Multi-linha.
tarefa_desc_prompt() {
  local id=$1 tmp
  [[ -n $id ]] || return 0
  local -a ed; read -ra ed <<<"$(editor_tt)"
  [[ ${ed[0]##*/} == nano ]] && ed+=(-t)   # -t: ^X salva e sai, sem perguntar
  tmp=$(mktemp "${TMPDIR:-/tmp}/tt-descricao.XXXXXX") || return 0
  tarefa_get_desc "$id" >"$tmp"
  # Só usa /dev/tty se der para abri-lo (num fluxo headless/teste ele pode existir mas não abrir).
  if { : >/dev/tty; } 2>/dev/null; then "${ed[@]}" "$tmp" </dev/tty >/dev/tty 2>&1 || { rm -f "$tmp"; return 0; }
  else "${ed[@]}" "$tmp" </dev/null >/dev/null 2>&1 || { rm -f "$tmp"; return 0; }; fi
  tarefa_set_desc "$id" "$(cat "$tmp")"
  rm -f "$tmp"
  return 0
}

# Abre o calendário para escolher o prazo de ID: o dia e, se quiser, o horário (o padrão é o dia
# todo). "Definir prazo" (ou ⏎, ou duplo clique no dia) grava; "sem prazo" (x) tira; esc cancela.
tarefa_prazo_prompt() {
  local id=$1 escolha ini hora ep h
  [[ -n $id ]] || return 0
  ini=$(tarefa_get_prazo "$id"); hora=$(tarefas_meta_get "$(tarefas_meta_de "$id")" hora)
  escolha=$(calendario_tui prazo "$ini" "$hora" "$id") || return 0
  read -r ep h <<<"$escolha"
  case $ep in
    "") : ;;
    limpar) tarefa_set_prazo "$id" "" ;;
    *) tarefa_set_prazo "$id" "$ep" "$h" ;;
  esac
  return 0
}

# --- calendário e agenda ----------------------------------------------------
#
# Um calendário só, em dois modos, desenhado no /dev/tty, com teclado e mouse (SGR 1006):
#   prazo   escolhe o prazo de uma tarefa: o dia e, opcionalmente, o horário. Mostra o que já está
#           marcado no dia em foco. Imprime "EPOCH" (dia todo, 12:00), "EPOCH 1" (com horário),
#           "limpar" (sem prazo) ou nada (cancelou).
#   agenda  o do relógio da barra e do botão ▦ Calendário do painel: marca (•) os dias com tarefas,
#           lista as do dia em foco (clique marca feita) e cria tarefas no dia e horário em foco.
# Em teste, TT_CAL_TECLAS traz as teclas a consumir (uma por caractere; "\n" = ⏎), sem desenhar.
TT_MESES=(janeiro fevereiro março abril maio junho julho agosto setembro outubro novembro dezembro)
TT_DIAS_SEMANA=(domingo segunda-feira terça-feira quarta-feira quinta-feira sexta-feira sábado)

# Dias desde 1970-01-01 <-> data civil, só com aritmética (sem chamar o date para cada célula).
_cal_dias() { # ano mês dia -> R
  local y=$1 m=$2 d=$3 era yoe doy
  ((y -= (m <= 2) ? 1 : 0)); era=$(( (y >= 0 ? y : y - 399) / 400 )); yoe=$((y - era * 400))
  doy=$(( (153 * (m > 2 ? m - 3 : m + 9) + 2) / 5 + d - 1 ))
  R=$(( era * 146097 + yoe * 365 + yoe / 4 - yoe / 100 + doy - 719468 ))
}
_cal_civil() { # dias -> CY CM CD
  local z=$(( $1 + 719468 )) era doe yoe doy mp
  era=$(( (z >= 0 ? z : z - 146096) / 146097 )); doe=$((z - era * 146097))
  yoe=$(( (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365 ))
  doy=$((doe - (365 * yoe + yoe / 4 - yoe / 100))); mp=$(( (5 * doy + 2) / 153 ))
  CD=$((doy - (153 * mp + 2) / 5 + 1)); CM=$(( mp < 10 ? mp + 3 : mp - 9 )); CY=$((yoe + era * 400 + (CM <= 2 ? 1 : 0)))
}

calendario_tui() { # modo [epoch-ou-dia] [1 = com horário] [id da tarefa]
  local modo=${1:-prazo} ini=${2:-} hora_ini=${3:-} tid=${4:-}
  [[ $modo == prazo || $modo == agenda ]] || { ini=$modo; modo=prazo; }
  local agora tz hoje foco hora="" hbuf="" msg="" tecla resto
  local teste=${TT_CAL_TECLAS:-} ti=0 ult_clique="" ult_t=0
  read -r agora tz < <(tarefas_relogio); hoje=$(( (agora + tz) / 86400 )); foco=$hoje
  if [[ $ini =~ ^[0-9]+$ ]]; then
    if ((ini > 1000000)); then
      foco=$(( (ini + tz) / 86400 ))
      if [[ $hora_ini == 1 ]]; then local s=$(( (ini + tz) % 86400 )); printf -v hora '%02d:%02d' $((s / 3600)) $((s % 3600 / 60)); fi
    else foco=$ini; fi
  fi
  local titulo_t=""
  [[ -n $tid ]] && titulo_t=$(tarefas_raw | awk -F'\t' -v id="$tid" '$1==id{print $5; exit}')
  local z=$'\e[0m' neg=$'\e[1m' inv=$'\e[7m' subl=$'\e[4m'
  local c_txt=$'\e[38;2;205;214;244m' c_sub=$'\e[38;2;166;173;200m' c_dim=$'\e[38;2;108;112;134m'
  local c_azul=$'\e[38;2;137;180;250m' c_amar=$'\e[38;2;249;226;175m' c_verm=$'\e[38;2;243;139;168m'
  local c_verde=$'\e[38;2;166;227;161m' c_pess=$'\e[38;2;250;179;135m'
  local b_cinza=$'\e[48;2;49;50;68m' b_azul=$'\e[48;2;137;180;250m\e[38;2;30;30;46m\e[1m'
  local -a TELA=() REG=() DIA_L=() CHIPS=(08:00 09:00 12:00 14:00 18:00)
  local -A MARCA=()
  local ln="" cx=1 W=72 H=40

  # Montagem da tela: _seg acrescenta um pedaço à linha corrente (e registra a área clicável),
  # _fim fecha a linha. Só caracteres de largura 1, então a largura é o número de caracteres.
  _seg() { # visível desenho [ação]
    [[ -n ${3:-} ]] && REG+=("$(( ${#TELA[@]} + 1 )) $cx $((cx + ${#1} - 1)) $3")
    ln+=$2; cx=$((cx + ${#1}))
  }
  _fim() { TELA+=("$ln"); ln=""; cx=1; }
  _botao() { # rótulo ação [estilo]; quebra a linha se não couber
    local r=" $1 "
    ((cx > 3 && cx + ${#r} > W)) && { _fim; _seg "  " "  "; }
    ((cx > 3)) && _seg " " " "
    _seg "$r" "${3:-$b_cinza$c_txt}$r$z" "$2"
  }
  _data_longa() { # dias -> "Quinta-feira, 08 de outubro de 2026"
    _cal_civil "$1"; local ds=${TT_DIAS_SEMANA[$(( ($1 + 4) % 7 ))]}
    printf '%s, %02d de %s de %s' "${ds^}" "$CD" "${TT_MESES[$((CM - 1))]}" "$CY"
  }
  _data_curta() { # dias -> "sex 10/10"
    _cal_civil "$1"; local ds=${TT_DIAS_SEMANA[$(( ($1 + 4) % 7 ))]}
    printf '%s %02d/%02d' "${ds:0:3}" "$CD" "$CM"
  }
  # Tarefas: dias do mês com tarefas abertas (MARCA) e as do dia em foco (DIA_L); em hoje, também
  # as atrasadas. DIA_L: id<TAB>estado<TAB>hora<TAB>atrasada<TAB>texto.
  _dados() { # dia-inicial dia-final
    MARCA=(); DIA_L=()
    [[ -s $CONF_TAREFAS ]] || return 0
    local l
    while IFS= read -r l; do
      case $l in M\ *) MARCA[${l#M }]=1 ;; D\ *) l=${l#D }; DIA_L+=("${l#*$'\t'}") ;; esac
    done < <(LC_ALL=C awk -F'\t' -v NOW="$agora" -v TZOFF="$tz" -v A="$1" -v B="$2" -v F="$foco" -v HJ="$hoje" "$TAREFAS_AWK"'
      NF >= 5 && valida($1, $2) && !($1 in v) && mv($6, "pai") == "" {
        v[$1] = 1; p = mv($6, "prazo"); if (p == "") next
        d = dia(p); h = (mv($6, "hora") == 1)
        if ($2 == "aberta" && d >= A && d <= B) print "M " d
        if (d == F || (F == HJ && $2 == "aberta" && d < HJ))
          printf "D %d%d%010d\t%s\t%s\t%s\t%s\t%s\n", (d < F ? 0 : 1), h, p, $1, $2, (h ? hhmm(p) : "-"), (d < F ? 1 : "-"), $5
      }' "$CONF_TAREFAS" | LC_ALL=C sort)
  }
  _desenha() {
    W=$(tput cols 2>/dev/null || echo 72); H=$(tput lines 2>/dev/null || echo 40)
    ((W > 100)) && W=100
    TELA=(); REG=(); ln=""; cx=1
    local compacto=$(( H < 32 ? 1 : 0 ))
    _br() { ((compacto)) || _fim; }     # linha em branco (some em tela baixa)
    _dicas() { # itens separados por " · ", quebrando só entre itens
      local it lin="" IFS=$'\x1f'
      for it in ${1// · /$'\x1f'}; do
        if [[ -n $lin ]] && ((2 + ${#lin} + 3 + ${#it} > W)); then _seg "  $lin" "  $c_dim$lin$z"; _fim; lin=""; fi
        lin+="${lin:+ · }$it"
      done
      [[ -n $lin ]] && { _seg "  $lin" "  $c_dim$lin$z"; _fim; }
    }
    _cal_civil "$foco"; local y=$CY m=$CM
    local prim ult off; _cal_dias "$y" "$m" 1; prim=$R
    if ((m == 12)); then _cal_dias $((y + 1)) 1 1; else _cal_dias "$y" $((m + 1)) 1; fi; ult=$((R - 1))
    off=$(( (prim + 3) % 7 ))     # 0 = segunda
    _dados "$prim" "$ult"
    # título e o dia em foco por extenso
    _br
    if [[ $modo == prazo ]]; then
      local tt=$titulo_t; ((${#tt} > W - 20)) && tt="${tt:0:$((W - 21))}…"
      _seg "  ◷ Prazo" "  $c_azul$neg◷ Prazo$z"; [[ -n $tt ]] && _seg " de: $tt" "$c_sub de: $c_txt$neg$tt$z"
    else
      _seg "  ▦ Agenda" "  $c_azul$neg▦ Agenda$z"; _seg "  as tarefas com prazo, dia a dia" "$c_dim  as tarefas com prazo, dia a dia$z"
    fi
    _fim
    local dl; dl=$(_data_longa "$foco")
    _seg "  $dl" "  $c_txt$neg$dl$z"
    if [[ -n $hora ]]; then _seg " às $hora" "$c_amar$neg às $hora$z"; else _seg " · dia todo" "$c_dim · dia todo$z"; fi
    _fim; _br
    # navegação do mês
    _seg "  " "  "; _seg " ‹ " "$b_cinza$c_txt ‹ $z" ant
    local mes=" ${TT_MESES[$((m - 1))]} $y "; _seg "$mes" "$neg$c_txt$mes$z"
    _seg " › " "$b_cinza$c_txt › $z" prox; _seg "   " "   "; _seg " hoje " "$b_cinza$c_txt hoje $z" hoje
    _fim; _br
    _seg "         seg ter qua qui sex sáb dom" "$c_dim         seg ter qua qui sex sáb dom$z"; _fim
    # grade: "  sem NN " + 7 células de 4 ("%3d" + marca •)
    local w seg di c qui wk cel
    for ((w = 0; w < 6; w++)); do
      seg=$((prim - off + 7 * w)); ((seg > ult)) && break
      qui=$((seg + 3)); _cal_civil "$qui"; _cal_dias "$CY" 1 1; wk=$(( (qui - R) / 7 + 1 ))
      printf -v cel '  sem %2d ' "$wk"; _seg "$cel" "$c_dim$cel$z"
      for ((c = 0; c < 7; c++)); do
        di=$((seg + c))
        if ((di < prim || di > ult)); then _seg "    " "    "; continue; fi
        _cal_civil "$di"; printf -v cel '%3d' "$CD"
        local est=$c_txt
        ((di < hoje)) && est=$c_dim
        ((di == hoje)) && est=$c_amar$subl
        ((di == foco)) && est=$c_azul$inv$neg
        _seg "$cel" "$est$cel$z" "dia:$di"
        if [[ -n ${MARCA[$di]:-} ]]; then _seg "•" "$c_pess$neg•$z" "dia:$di"; else _seg " " " "; fi
      done
      _fim
    done
    _br
    # horário (opcional): chips clicáveis ou digitar
    _seg "  Horário " "  $c_sub${neg}Horário$z "
    local hc ch
    _botao "dia todo" "hora:" "$([[ -z $hora ]] && echo "$b_azul")"
    for ch in "${CHIPS[@]}"; do _botao "$ch" "hora:$ch" "$([[ $hora == "$ch" ]] && echo "$b_azul")"; done
    hc=0; for ch in "${CHIPS[@]}"; do [[ $hora == "$ch" ]] && hc=1; done
    [[ -n $hora && $hc == 0 ]] && _botao "$hora" "hora:$hora" "$b_azul"
    _fim
    if [[ -n $hbuf ]]; then _seg "  digitando: $hbuf" "  ${c_amar}digitando: $hbuf$z"
    else _seg "  ou digite a hora: 1430, 9h, 18:15 (opcional)" "  ${c_dim}ou digite a hora: 1430, 9h, 18:15 (opcional)$z"; fi
    _fim; _br
    # o que já está marcado no dia em foco
    local n=${#DIA_L[@]} cab; cab="── $(_data_curta "$foco") · $( ((n == 0)) && echo 'nada marcado' || echo "$n tarefa$( ((n > 1)) && echo s)") ──"
    _seg "  $cab" "  $c_sub$cab$z"; _fim
    local rodape=$(( compacto ? 4 : 6 )) cabem i id est hh atr tx caixa rot
    cabem=$((H - ${#TELA[@]} - rodape)); ((cabem < 1)) && cabem=1
    for ((i = 0; i < n && i < cabem; i++)); do
      IFS=$'\t' read -r id est hh atr tx <<<"${DIA_L[i]}"
      [[ $hh == - ]] && hh=""; [[ $atr == - ]] && atr=""   # "-" = vazio (o read junta TABs seguidos)
      if [[ $est == feita ]]; then caixa="$c_verde☑$z"; else caixa="$( [[ -n $atr ]] && echo "$c_verm" || echo "$c_txt")☐$z"; fi
      rot=${hh:-dia todo}; [[ -n $atr ]] && rot="atrasada"
      printf -v rot '%-8s' "$rot"
      ((${#tx} > W - 22)) && tx="${tx:0:$((W - 23))}…"
      _seg "    ☐ $rot  $tx" "    $caixa $( [[ -n $atr ]] && echo "$c_verm" || echo "$c_azul")$rot$z  $( [[ $est == feita ]] && echo "$c_dim" || echo "$c_txt")$tx$z" \
        "$([[ $modo == agenda ]] && echo "tarefa:$id")"
      _fim
    done
    ((n > cabem)) && { _seg "    … e mais $((n - cabem))" "    $c_dim… e mais $((n - cabem))$z"; _fim; }
    _br
    # ações
    _seg "  " "  "
    if [[ $modo == prazo ]]; then
      _botao "✓ Definir prazo: $(_data_curta "$foco")${hora:+ às $hora}" ok "$b_azul"
      _botao "sem prazo" limpar; _botao "cancelar" sair
    else
      _botao "+ Nova tarefa em $(_data_curta "$foco")${hora:+ às $hora}" nova "$b_azul"
      [[ -n ${TT_CLIENTE:-} && -z ${TT_CAL_DENTRO:-} ]] && _botao "☰ Painel de tarefas" painel
      _botao "fechar" sair
    fi
    _fim
    if [[ $modo == prazo ]]; then
      _dicas "← → ↑ ↓ dia · < > mês · t hoje · d dia todo · ⏎ ou duplo clique no dia define · x sem prazo · esc cancela"
    else
      _dicas "← → ↑ ↓ dia · < > mês · t hoje · d dia todo · ⏎ ou duplo clique no dia cria · clique na tarefa marca · esc fecha"
    fi
    [[ -n $msg ]] && { _seg "  $msg" "  $c_verm$msg$z"; _fim; }
    # desenha por cima (sem limpar a tela inteira: não pisca)
    local l
    { printf '\e[H'; for l in "${TELA[@]}"; do printf '%s\e[K\n' "$l"; done; printf '\e[J'; } >/dev/tty
  }
  _tecla() { # lê uma tecla em "tecla"; 1 no fim do roteiro de teste
    if [[ -n $teste ]]; then
      ((ti < ${#teste})) || return 1
      tecla=${teste:ti:1}; ti=$((ti + 1)); [[ $tecla == $'\n' ]] && tecla=""
      return 0
    fi
    IFS= read -rsn1 tecla </dev/tty
  }
  # Hora digitada: "14" -> 14:00, "143" -> 14:30, "1430" -> 14:30, "930" -> 09:30, "9h15", "18:5".
  _hbuf() {
    local hh mm d
    if [[ $hbuf == *[:h]* ]]; then hh=${hbuf%%[:h]*}; mm=${hbuf#*[:h]}; [[ ${#mm} == 1 ]] && mm=${mm}0
    else
      d=$hbuf
      case ${#d} in
        1|2) hh=$d; mm=00 ;;
        3) if ((10#${d:0:2} <= 23)); then hh=${d:0:2}; mm=${d:2}0; else hh=${d:0:1}; mm=${d:1}; fi ;;
        *) hh=${d:0:2}; mm=${d:2:2} ;;
      esac
    fi
    [[ -z $hh ]] && return
    if ((10#$hh < 24 && 10#${mm:-0} < 60)); then printf -v hora '%02d:%02d' "$((10#$hh))" "$((10#${mm:-0}))"; msg=""
    else msg="hora inválida: $hbuf"; fi
  }
  _epoch() { # dia em foco (+ hora) -> epoch
    _cal_civil "$foco"
    tt_epoch_de "$(printf '%04d-%02d-%02d %s' "$CY" "$CM" "$CD" "${hora:-12:00}")"
  }
  _mes() { # ±N meses: mesmo dia no mês de destino (ajustado ao último dia dele)
    _cal_civil "$foco"; local t=$((CY * 12 + CM - 1 + $1)) d=$CD u y m
    y=$((t / 12)); m=$((t % 12 + 1))
    if ((m == 12)); then _cal_dias $((y + 1)) 1 1; else _cal_dias "$y" $((m + 1)) 1; fi; u=$R
    _cal_dias "$y" "$m" 1; ((d > u - R)) && d=$((u - R))
    _cal_dias "$y" "$m" "$d"; foco=$R
  }
  _nova() { # cria uma tarefa no dia (e hora) em foco
    local t d id
    [[ -n $teste ]] || printf '\e[?1000l\e[?1006l\e[?25h\e[H\e[2J' >/dev/tty
    printf '\n  %s+ Nova tarefa%s em %s%s\n' "$c_azul$neg" "$z" "$(_data_longa "$foco")" "${hora:+ às $hora}" >/dev/tty 2>/dev/null
    printf '  %s⏎ cria · %sCtrl+E%s%s escreve no editor, com descrição (1ª linha = título) · ⏎ vazio cancela%s\n' "$c_dim" "$c_amar" "$z" "$c_dim" "$z" >/dev/tty 2>/dev/null
    printf '  %s!alta #tag *semanal também valem no título%s\n\n' "$c_dim" "$z" >/dev/tty 2>/dev/null
    TT_NOVA=""
    tarefas_ler_nova "Título" </dev/tty >/dev/tty 2>&1 || TT_NOVA=""
    if [[ -n ${TT_NOVA//[[:space:]]/} ]]; then
      id=$(tarefa_add_natural "$TT_NOVA")
      [[ -n $id && -z $(tarefa_get_prazo "$id") ]] && tarefa_set_prazo "$id" "$(_epoch)" "$([[ -n $hora ]] && echo 1)"
    fi
    hbuf=""
    [[ -n $teste ]] || printf '\e[?1000h\e[?1006h\e[?25l\e[2J' >/dev/tty
  }
  # Executa uma ação; devolve 0 quando o calendário deve sair.
  _acao() {
    case $1 in
      ant) _mes -1 ;; prox) _mes 1 ;; hoje) foco=$hoje ;;
      hora:*) hora=${1#hora:}; hbuf=""; msg="" ;;
      ok)
        [[ -n $msg ]] && return 1
        [[ $modo == prazo ]] || { _nova; return 1; }
        if [[ -n $hora ]]; then echo "$(_epoch) 1"; else _epoch; fi
        return 0 ;;
      limpar) [[ $modo == prazo ]] && { echo limpar; return 0; } ;;
      nova) _nova ;;
      painel) tmux run-shell -b "sleep 0.3; $(q "$EU") --tarefas $(q "$TT_CLIENTE")" 2>/dev/null; return 0 ;;
      sair) return 0 ;;
      tarefa:*) tarefa_alternar "${1#tarefa:}" ;;
      dia:*)
        local d=${1#dia:} t; t=${EPOCHREALTIME/[.,]/}; t=$((10#${t:0:13}))
        # 2º clique no mesmo dia em < 400 ms = duplo clique: confirma (ou cria, na agenda)
        if [[ $ult_clique == "$d" ]] && ((t - ult_t < 400)); then ult_clique=""; foco=$d; _acao ok; return; fi
        ult_clique=$d; ult_t=$t; foco=$d ;;
    esac
    return 1
  }
  _mouse() { # "b;x;y" de um clique (só o pressionar)
    local b x y r ry rx1 rx2 ra
    IFS=';' read -r b x y <<<"$1"
    case $b in 64) _acao ant; return ;; 65) _acao prox; return ;; 0) ;; *) return 1 ;; esac
    for r in "${REG[@]}"; do
      read -r ry rx1 rx2 ra <<<"$r"
      ((ry == y && x >= rx1 && x <= rx2)) && { _acao "$ra"; return; }
    done
    return 1
  }
  _laco() {
    while :; do
      [[ -n $teste ]] || _desenha
      _tecla || { echo ""; return; }
      case $tecla in
        $'\e')
          [[ -n $teste ]] && return
          IFS= read -rsn1 -t 0.03 resto </dev/tty || resto=""
          if [[ $resto == '[' || $resto == O ]]; then
            IFS= read -rsn1 -t 0.03 resto </dev/tty || resto=""
            case $resto in
              C) foco=$((foco + 1)) ;; D) foco=$((foco - 1)) ;;
              A) foco=$((foco - 7)) ;; B) foco=$((foco + 7)) ;;
              5) read -rsn1 -t 0.03 resto </dev/tty; _mes -1 ;;   # PgUp
              6) read -rsn1 -t 0.03 resto </dev/tty; _mes 1 ;;    # PgDn
              '<')
                local ev="" ch
                while IFS= read -rsn1 -t 0.05 ch </dev/tty; do ev+=$ch; [[ $ch == [Mm] ]] && break; done
                [[ $ev == *M ]] && _mouse "${ev%M}" && return ;;
            esac
          elif [[ -z $resto ]]; then return       # esc puro
          fi ;;
        [0-9]) ((${#hbuf} >= 5)) && hbuf=""; hbuf+=$tecla; _hbuf ;;
        :) [[ -n $hbuf ]] && { hbuf+=:; _hbuf; } ;;
        h)
          if [[ $hbuf =~ [0-9]$ && $hbuf != *[:h]* ]]; then hbuf+=h; _hbuf
          else foco=$((foco - 1)); fi ;;
        $'\x7f'|$'\b') hbuf=${hbuf%?}; if [[ -n $hbuf ]]; then _hbuf; else hora=""; msg=""; fi ;;
        l) foco=$((foco + 1)) ;; k) foco=$((foco - 7)) ;; j) foco=$((foco + 7)) ;;
        '<'|',') _mes -1 ;; '>'|'.') _mes 1 ;;
        '-') _mes -12 ;; '+'|'=') _mes 12 ;;
        t|T) foco=$hoje ;;
        d|D) hora=""; hbuf=""; msg="" ;;
        x|X) _acao limpar && return ;;
        n|N) [[ $modo == agenda ]] && _nova ;;
        '') _acao ok && return ;;
        q) return ;;
      esac
    done
  }
  if [[ -n $teste ]]; then _laco; return 0; fi
  printf '\e[?1000h\e[?1006h\e[?25l\e[2J' >/dev/tty
  _laco
  printf '\e[?1000l\e[?1006l\e[?25h\e[H\e[2J' >/dev/tty
  return 0
}

# Calendário do relógio da barra: a agenda num popup, do tamanho que couber na tela.
abrir_calendario() {
  local c=$1 cw ch w h
  read -r cw ch < <(do_cliente "$c" '#{client_width} #{client_height}')
  w=76; h=36; ((w > ${cw:-80})) && w=${cw:-80}; ((h > ${ch:-24})) && h=${ch:-24}
  tmux display-popup -c "$c" -w "$w" -h "$h" -b rounded -S 'fg=#89b4fa' -T ' ▦ agenda · esc fecha ' \
    -E "TT_CLIENTE=$(q "$c") $EU --calendario-agenda"
}

# Saída texto (CLI pura): usada por `tt --tarefas` fora do tmux e como fallback sem fzf.
tarefas_listar() {
  local n; n=$(tarefas_raw | awk -F'\t' '$2 == "aberta"' | wc -l | tr -d ' ')
  printf '📋 tarefas (%s aberta%s)\n' "$n" "$( ((n==1)) || printf s )"
  tarefas_vivas | awk -F'\t' '{ printf "  %s  %s  [%s]\n", ($2=="feita"?"☑":"☐"), $5, substr($1,1,6) }'
}

# Botão direito no 📋: ações rápidas sem abrir o painel inteiro.
menu_tarefas() {
  local c=$1
  menu_popup "$c" "📋 tarefas" <<ITENS
t	📋 Abrir o painel de tarefas	$EU --tarefas $(q "$c")
a	▦ Agenda (calendário do mês)	$EU --clique relogio $(q "$c") x "$HOME" 0
n	+ Nova tarefa…	tmux display-popup -c $(q "$c") -E -w 72 -h 14 -b rounded -T ' + nova tarefa ' $(q "$EU --tarefa-add-ui")
l	▤ Arquivar ou apagar as tarefas feitas…	tmux display-popup -c $(q "$c") -E -w 72 -h 13 -b rounded $(q "$EU --tarefa-limpar-prompt")
ITENS
}

# Fixa ou desafixa a sessão S da máquina de rótulo R. Ao fixar uma sessão daqui, o vigia para de
# renomeá-la (senão o item da barra ficaria apontando para um nome que sumiu).
alternar_fixada() {
  local r=$1 s=$2 id="" d
  mkdir -p "$CONF_DIR"; touch "$CONF_FIX"
  # O identificador de uma sessão de outra máquina é pedido antes da trava (ssh pode demorar).
  if [[ $r != "$MAQUINA" ]] && ! awk -F'\t' -v r="$r" -v s="$s" '$1 == r && $2 == s { f=1 } END { exit !f }' "$CONF_FIX"; then
    d=$(dest_de "$r")
    [[ -n $d ]] && id=$(timeout 5 ssh "${SSH_OPC[@]}" "$d" "$TT_REMOTO --session-id $(q "$s")" </dev/null 2>/dev/null)
  fi
  travar_fixadas || return 1
  if awk -F'\t' -v r="$r" -v s="$s" '$1 == r && $2 == s { found=1 } END { exit !found }' "$CONF_FIX"; then
    awk -F'\t' -v r="$r" -v s="$s" '$1 != r || $2 != s' "$CONF_FIX" >"$CONF_FIX.novo"; mv "$CONF_FIX.novo" "$CONF_FIX"
    echo "desafixada"
  else
    [[ $r == "$MAQUINA" ]] && id=$(session_id "$s")
    printf '%s\t%s\t%s\n' "$r" "$s" "$id" >>"$CONF_FIX"
    # A marca fica dentro da sessão. Se ela for renomeada fora do tt, conseguimos achar a
    # mesma sessão pelo marcador e corrigir o nome mostrado na barra.
    if [[ $r == "$MAQUINA" ]]; then
      tmux set-option -t "=$s:" @nome_auto 0 2>/dev/null
      tmux set-option -t "=$s:" @tt_fixado_nome "$s" 2>/dev/null
    else
      d=$(dest_de "$r")
      [[ -n $d ]] && timeout 5 ssh "${SSH_OPC[@]}" "$d" "$PATH_REMOTO tmux set-option -t $(q "=$s:") @nome_auto 0; tmux set-option -t $(q "=$s:") @tt_fixado_nome $(q "$s")" </dev/null >/dev/null 2>&1
    fi
    echo "fixada"
  fi
  marcar_fixadas
  destravar_fixadas
  aplicar_fixadas
  propagar_fixadas
}

# ✕ de um item da faixa de fixadas: desafixa a sessão identificada pela chave estável.
desafixar_item() {
  local c=$1 chave=${2#fxx} r s id k
  while IFS=$'\t' read -r r s id; do
    k=$(fixada_chave "$r" "$s" "$id")
    [[ $k == "$chave" ]] && break
    r=""; s=""
  done < <(fixadas)
  [[ -n $s ]] || return 0
  # Só remove, nunca alterna: o ✕ dispara no apertar e no soltar e, num toque lento (> 0,5 s), os
  # dois rodam juntos; com alternar, o segundo achava a sessão já fora da lista e fixava de novo.
  remover_fixada "$r" "$s" "$id"
  tmux display-message -c "$c" -d 2500 "📌 desafixada: $([[ $r == "$MAQUINA" ]] && echo "$s" || echo "$r:$s")"
}

# Tira da lista a fixada de R com nome S ou identificador ID (o nome pode ter mudado num rename entre
# o clique e a trava). Idempotente: se já saiu, não faz nada.
remover_fixada() {
  local r=$1 s=$2 id=${3:-}
  [[ -f $CONF_FIX ]] || return 0
  travar_fixadas || return 1
  if ! awk -F'\t' -v r="$r" -v s="$s" -v id="$id" '$1 == r && ($2 == s || (id != "" && $3 == id)) { f = 1 } END { exit !f }' "$CONF_FIX"; then
    destravar_fixadas; return 0
  fi
  awk -F'\t' -v r="$r" -v s="$s" -v id="$id" '!($1 == r && ($2 == s || (id != "" && $3 == id)))' "$CONF_FIX" >"$CONF_FIX.novo"
  mv "$CONF_FIX.novo" "$CONF_FIX"
  marcar_fixadas
  destravar_fixadas
  aplicar_fixadas
  propagar_fixadas
}

# Pino ao lado do nome da sessão, na barra (mesma convenção do seletor): 📍 = não fixada, o clique
# fixa; 📌 = fixada, o clique desafixa.
fixar_atual() {
  local c=$1 s r
  s=$(do_cliente "$c" '#{session_name}')
  [[ -n $s ]] || return 0
  r=$(alternar_fixada "$MAQUINA" "$s")
  tmux display-message -c "$c" -d 2500 "$([[ $r == fixada ]] && echo 📌 || echo 📍) $s $r$([[ $r == fixada ]] && echo " — aparece na faixa das fixadas em todas as máquinas; o ✕ dela desafixa")"
}

# Sessão daqui renomeada: o item fixado acompanha.
fixada_renomeada() {
  [[ -f $CONF_FIX ]] || return 0
  travar_fixadas || return 0
  awk -F'\t' -v r="$MAQUINA" -v a="$1" -v n="$2" 'BEGIN { OFS = "\t" } $1 == r && $2 == a { $2 = n; mudou = 1 } { print } END { exit !mudou }' "$CONF_FIX" >"$CONF_FIX.novo" || { rm -f "$CONF_FIX.novo"; destravar_fixadas; return 0; }
  mv "$CONF_FIX.novo" "$CONF_FIX"
  marcar_fixadas
  destravar_fixadas
  tmux set-option -t "=$2:" @tt_fixado_nome "$2" 2>/dev/null
  aplicar_fixadas
  propagar_fixadas
}

# Confere periodicamente os itens fixados. Uma máquina sem resposta é preservada (ela pode
# estar desligada); uma sessão comprovadamente inexistente é desafixada. A marca @tt_fixado_nome
# também permite acompanhar um rename feito diretamente pelo tmux ou por outro programa.
reconciliar_fixadas() {
  [[ -f $CONF_FIX ]] || return 0
  local tmp r s id d resposta st mudou=0 novo novo_id v0
  v0=$(versao_fixadas)
  tmp=$(mktemp "$CONF_FIX.XXXXXX") || return 1
  while IFS=$'\t' read -r r s id; do
    [[ -n $r && -n $s ]] || continue
    novo=$s
    if [[ $r == "$MAQUINA" ]]; then
      # Primeiro resolve pelo UUID. O nome antigo pode ter sido reutilizado por outra sessão.
      if [[ -n $id ]]; then novo=$(session_by_id "$id"); fi
      if [[ -n $novo ]]; then
        opt_sessao "$novo" @tt_fixado_nome "$novo"
        novo_id=$(session_id "$novo")
      elif tmux has-session -t "=$s" 2>/dev/null; then
        # Também migra itens fixados de versões antigas para o marcador de identidade.
        novo=$s
        opt_sessao "$s" @tt_fixado_nome "$s"
        novo_id=$(session_id "$s")
      else
        novo=$(tmux list-sessions -F "#{session_name}"$'\t'"#{@tt_fixado_nome}" 2>/dev/null |
          awk -F'\t' -v antigo="$s" '$2 == antigo { print $1; exit }')
        [[ -n $novo ]] && novo_id=$(session_id "$novo")
      fi
      # Sem sessão e sem marca correspondente: ela foi fechada.
      [[ -n $novo ]] || { mudou=1; continue; }
    else
      d=$(dest_de "$r")
      # Rótulo desconhecido ou máquina inacessível não é evidência de fechamento.
      [[ -n $d ]] || { printf '%s\t%s\t%s\n' "$r" "$s" "$id" >>"$tmp"; continue; }
      resposta=$(timeout 6 ssh "${SSH_OPC[@]}" "$d" "$TT_REMOTO --resolver-fixada $(q "$s") $(q "$id")" </dev/null 2>/dev/null)
      st=$?
      ((st == 0)) || { printf '%s\t%s\t%s\n' "$r" "$s" "$id" >>"$tmp"; continue; }
      novo=${resposta%%$'\t'*}; novo_id=${resposta#*$'\t'}
      [[ -n $novo ]] || { mudou=1; continue; }
    fi
    [[ $novo == "$s" && $novo_id == "$id" ]] || mudou=1
    printf '%s\t%s\t%s\n' "$r" "$novo" "$novo_id" >>"$tmp"
  done < <(fixadas)
  # A conferência consulta outras máquinas e leva segundos. Se a lista mudou nesse meio-tempo
  # (fixou/desafixou aqui, ou chegou uma mais nova), esta conferência ficou velha: descarta e a
  # próxima volta do vigia confere de novo. Nunca grava por cima de uma mudança mais recente.
  if ((mudou)) && travar_fixadas; then
    if [[ $(versao_fixadas) == "$v0" ]]; then
      mv "$tmp" "$CONF_FIX"; marcar_fixadas; destravar_fixadas
      aplicar_fixadas
      propagar_fixadas
    else
      destravar_fixadas; rm -f "$tmp"
    fi
  else
    rm -f "$tmp"
  fi
}

# Conteúdo da 2ª linha (chamado pela barra, por sessão: destaca a sessão atual).
# Largura de exibição (colunas de tela) de um texto simples, como o tmux conta: emoji e CJK valem 2.
# Resultado em W (sem subshell: é chamada muitas vezes ao montar a faixa).
tt_largura() {
  local t=$1 i cp n=0 b LC_ALL=C
  b=${#t}; LC_ALL=C.UTF-8
  ((b == ${#t})) && { W=$b; return 0; }   # bytes = caracteres: só ASCII
  for ((i = 0; i < ${#t}; i++)); do
    printf -v cp '%d' "'${t:i:1}"
    if ((cp >= 0x1100 && (cp <= 0x115f || (cp >= 0x2e80 && cp <= 0xa4cf) || (cp >= 0xac00 && cp <= 0xd7a3) ||
        (cp >= 0xf900 && cp <= 0xfaff) || (cp >= 0xfe30 && cp <= 0xfe4f) || (cp >= 0xff00 && cp <= 0xff60) ||
        (cp >= 0xffe0 && cp <= 0xffe6) || (cp >= 0x1f300 && cp <= 0x1faff) || cp >= 0x20000))); then n=$((n + 2))
    else n=$((n + 1)); fi
  done
  W=$n
}

# Abrevia um nome de sessão para caber em N colunas, POR PALAVRAS (separadas por - _ . ou espaço):
# encurta primeiro a palavra mais longa, mantendo o começo de cada uma (nunca abaixo de 2 letras;
# números ficam inteiros), e só no fim corta com "…". "confere-maquinas-futuro" em 12 vira
# "con-maq-futu" — o fim do nome continua lá, ao contrário de cortar à direita.
fixada_abrev() { # texto n -> A
  local t=$1 n=$2 i maior lm tot k=$1$'\x1f'$2 ult manter
  # Memória por (nome, largura) enquanto a faixa é montada (quem chama declara FX_ABREV e FX_MEMO=1).
  if [[ ${FX_MEMO:-} == 1 && -n ${FX_ABREV[$k]+x} ]]; then A=${FX_ABREV[$k]}; return 0; fi
  if ((${#t} <= n)); then A=$t
  else
    local -a pal=() sep=()
    while [[ -n $t ]]; do
      if [[ $t =~ ^([^-_.\ ]*)([-_.\ ]*)(.*)$ ]]; then pal+=("${BASH_REMATCH[1]}"); sep+=("${BASH_REMATCH[2]}"); t=${BASH_REMATCH[3]}
      else pal+=("$t"); sep+=(""); t=""; fi
    done
    tot=${#1}
    while ((tot > n)); do
      maior=-1; lm=2
      for i in "${!pal[@]}"; do
        [[ ${pal[i]} == *[!0-9]* ]] || continue        # números ficam inteiros
        ((${#pal[i]} > lm)) && { lm=${#pal[i]}; maior=$i; }
      done
      ((maior < 0)) && break
      pal[maior]=${pal[maior]:0:$((lm - 1))}; tot=$((tot - 1))
    done
    A=""; for i in "${!pal[@]}"; do A+="${pal[i]}${sep[i]}"; done
    # Nem por palavras coube: guarda o começo e a ÚLTIMA palavra (o que costuma distinguir).
    if ((${#A} > n)); then
      ult=${pal[-1]}; manter=$((n - 1 - ${#ult}))
      if ((${#pal[@]} > 1 && manter >= 2)); then A="${A:0:manter}…$ult"; else A="${A:0:$((n - 1))}…"; fi
    fi
  fi
  [[ ${FX_MEMO:-} == 1 ]] && FX_ABREV[$k]=$A
  return 0
}

# Selo e cor de cada máquina: a 1ª letra em maiúscula (mais letras se duas máquinas começarem
# igual) e uma cor fixa (pela ordem do cadastro), os mesmos na faixa das fixadas, no popup delas e
# no menu de máquinas. Calculados sobre TODAS as máquinas cadastradas (e as das fixadas), para a
# letra não mudar quando a lista muda. Esta máquina não tem selo. Preenche SELO[] e SELO_COR[].
FIX_CORES=('#ffb86c' '#50fa7b' '#8be9fd' '#ff79c6' '#f1fa8c' '#ff5555')
fixadas_selos() {
  local -a maqs=(); local r m k n i j ok ordem
  SELO=(); SELO_COR=()
  while read -r r; do
    [[ -n $r && $r != "$MAQUINA" && -z ${SELO[$r]:-} ]] || continue
    SELO[$r]=x; maqs+=("$r")
  done < <(awk '!/^#/ && NF >= 3 { print $3 }' "$CONF_MAQ" 2>/dev/null; fixadas | cut -f1)
  ((${#maqs[@]})) || return 0
  for ((k = 1; k <= 4; k++)); do
    ok=1
    for m in "${maqs[@]}"; do SELO[$m]=${m:0:k}; SELO[$m]=${SELO[$m]^^}; done
    for ((i = 0; i < ${#maqs[@]}; i++)); do for ((j = i + 1; j < ${#maqs[@]}; j++)); do
      [[ ${SELO[${maqs[i]}]} == "${SELO[${maqs[j]}]}" ]] && ok=0
    done; done
    ((ok)) && break
  done
  for m in "${maqs[@]}"; do
    ordem=$(awk -v m="$m" '!/^#/ && NF >= 3 { n++; if ($3 == m) { print n; exit } }' "$CONF_MAQ" 2>/dev/null)
    [[ -n $ordem ]] || ordem=$(( $(printf '%s' "$m" | cksum | cut -d' ' -f1) % 6 + 1 ))
    SELO_COR[$m]=${FIX_CORES[$(( (ordem - 1) % ${#FIX_CORES[@]} ))]}
  done
}
# O selo de uma máquina em ANSI (para listas fzf/menus): negrito na cor da máquina.
selo_ansi() { # maquina
  local c=${SELO_COR[$1]:-} 
  [[ -n $c ]] || { printf '%s' "${SELO[$1]:-}"; return 0; }
  printf '\033[1;38;2;%d;%d;%dm%s\033[0m' "0x${c:1:2}" "0x${c:3:2}" "0x${c:5:2}" "${SELO[$1]}"
}

# Faixa das fixadas como FORMATO do tmux (vai para @barra_fixadas). Para cada largura em que o
# desenho muda, a faixa é calculada aqui uma vez, e o próprio tmux escolhe, por cliente, a versão
# que cabe em #{client_width}: monitor, notebook e celular veem cada um a sua, e redimensionar
# redesenha na hora — sem processo nenhum na barra (com #() a cada redesenho o cursor piscava).
# O destaque da sessão em uso também é condição do tmux (#{session_name}).
# Estágios confortáveis, do mais rico ao mais pobre: nome até 28 com ✕ → abreviado 20 com ✕ → 16
# com ✕ → 16 sem ✕. Esse 16 é o PISO DE LEGIBILIDADE (o dono pediu ≥ 15 colunas de rótulo por
# item): abaixo dele o texto vira sopa de letras, então os excedentes vão para o chip "+N ▾"
# (popup com todas) ANTES de comprimir mais, e os visíveis ficam em 16. Só se nem UM item em 16
# couber ao lado do chip é que o rótulo desce (12 → 8 → 6), com um item só. No estouro, o último
# lugar visível mostra a sessão em uso DAQUELE cliente se ela estiver entre as escondidas. Nomes
# abreviados nunca ficam iguais (ganham letras até se distinguirem).
# Cada item de cada estágio e cada versão vão para opções pequenas do tmux (@fxK_I, @fxsK, @fxoN),
# gravadas de uma vez por source-file (o servidor lê o arquivo: sem o limite de tamanho de um
# comando, que a faixa inteira estourava com muitas fixadas); @barra_fixadas só as referencia e
# leva um carimbo vazio (#{?,hash,}) para mudar — e a barra redesenhar — quando um item muda.
# TT_FIX_LARGURA força uma largura (só a versão dela, sem condições de largura: testes);
# TT_FIX_VISIVEIS, se definido, é um teto duro de itens na faixa.
barra_fixadas_fmt() {
  local normal='#[bg=#44475a]#[fg=#f8f8f2]#[nobold]' atual='#[bg=#bd93f9]#[fg=#282a36]#[bold]' morta='#[bg=#282a36]#[fg=#6272a4]#[nobold]'
  local -A existe=() SELO=() SELO_COR=() FX_ABREV=([_]=); local FX_MEMO=1
  local s r id
  while read -r s; do existe[$s]=1; done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)
  if [[ -z $(fixadas) ]]; then
    printf '#[fg=#6272a4] ▸ 📌'
    return 0
  fi
  [[ $(locale charmap 2>/dev/null) == UTF-8 ]] || local LC_ALL=C.UTF-8
  fixadas_selos
  local -a nome=() maq=() chaves=() vivas=()
  local total=0
  while IFS=$'\t' read -r r s id; do
    total=$((total + 1))
    chaves[total]=$(fixada_chave "$r" "$s" "$id"); nome[total]=$s; maq[total]=$r
    if [[ $r == "$MAQUINA" && -z ${existe[$s]:-} ]]; then vivas[total]=0
    elif [[ $r == "$MAQUINA" && $s != *[,}#\']* ]]; then vivas[total]=2
    else vivas[total]=1; fi
  done < <(fixadas)
  # Largura do canto direito (tarefas + versão), medida, mais o marcador " ▸ " da esquerda.
  local dir; dir=$(printf '%s' "$(barra_tarefas_fmt)$(versao_barra)" | sed 's/#\[[^]]*\]//g')
  tt_largura "$dir"; dir=$((W + 3 + 1))
  local cfg="" arq
  _fx_opt() { cfg+="set -g $1 '$2'"$'\n'; }   # valores sem aspa simples (vira ’)
  # Texto escapado para dentro de condições do tmux (## #, #}); a aspa simples vira ’.
  _fx_esc() { local t=${1//\'/’}; t=${t//#/##}; t=${t//,/#,}; E=${t//\}/#\}}; }
  local -a rot=()
  _fx_item() { # i com_x -> ITEM (formato) e WI (largura)
    local i=$1 cx=$2 est pre="" rotulo=${rot[$1]}
    case ${vivas[i]} in
      0) est=$morta; rotulo="✗ $rotulo" ;;
      2) est="#{?#{==:#{session_name},${nome[i]}},$atual,$normal}" ;;
      *) est=$normal ;;
    esac
    tt_largura "$rotulo"; WI=$((W + 2))
    [[ ${maq[i]} != "$MAQUINA" ]] && { pre="#[fg=${SELO_COR[${maq[i]}]}]#[bold]${SELO[${maq[i]}]}$est "; WI=$((WI + ${#SELO[${maq[i]}]} + 1)); }
    _fx_esc "$rotulo"
    if ((cx)); then
      # O espaço antes do ✕ fica no range dele: o tmux dá a 1ª coluna de um range ao range colado
      # antes, e um toque bem em cima do ✕ ia para a sessão em vez de desafixar.
      ITEM="#[range=user|fx${chaves[i]}]$est $pre$E#[norange]#[range=user|fxx${chaves[i]}]$est ✕ #[norange]#[default] "
      WI=$((WI + 3 + 1))
    else
      ITEM="#[range=user|fx${chaves[i]}]$est $pre$E #[norange]#[default] "; WI=$((WI + 1))
    fi
  }
  # Rótulos de um estágio: abreviados a CAP e, se dois ficarem iguais (mesma máquina), mais letras.
  _fx_rotulos() { # cap
    local cap=$1 i j k c
    for ((i = 1; i <= total; i++)); do fixada_abrev "${nome[i]}" "$cap"; rot[i]=$A; done
    for ((k = 0; k < 24; k++)); do
      c=0
      for ((i = 1; i <= total; i++)); do for ((j = i + 1; j <= total; j++)); do
        if [[ ${maq[i]} == "${maq[j]}" && ${rot[i]} == "${rot[j]}" && ${nome[i]} != "${nome[j]}" ]]; then
          fixada_abrev "${nome[i]}" $((${#rot[i]} + 1)); rot[i]=$A
          fixada_abrev "${nome[j]}" $((${#rot[j]} + 1)); rot[j]=$A; c=1
        fi
      done; done
      ((c)) || break
    done
  }
  local teto=$total
  [[ ${TT_FIX_VISIVEIS:-} =~ ^[0-9]+$ ]] && ((TT_FIX_VISIVEIS > 0 && TT_FIX_VISIVEIS < total)) && teto=$TT_FIX_VISIVEIS
  local -a REF=() LIM=()        # versões da faixa (referências às opções) e a largura mínima de cada
  local e cap cx k=0 i w ant="" chave vis refs; local -A WKI=() KCAP=()   # largura por (estágio, item); estágio por cap sem ✕
  for e in "28 1" "20 1" "16 1" "16 0" "12 0" "8 0" "6 0"; do
    read -r cap cx <<<"$e"
    _fx_rotulos "$cap"; chave="$cx|${rot[*]}"; w=0
    for ((i = 1; i <= total; i++)); do _fx_item "$i" "$cx"; _fx_opt "@fx${k}_$i" "$ITEM"; WKI[$k,$i]=$WI; w=$((w + WI)); done
    ((cx == 0)) && KCAP[$cap]=$k
    # Versão com todos os itens só nos estágios confortáveis (cap ≥ 16, o piso).
    if ((teto == total && cap >= 16)) && [[ $chave != "$ant" ]]; then
      refs=""; for ((i = 1; i <= total; i++)); do refs+="#{E:@fx${k}_$i}"; done
      _fx_opt "@fxs$k" "$refs"; REF+=("#{E:@fxs$k}"); LIM+=($((w + dir)))
    fi
    ant=$chave; k=$((k + 1))
  done
  # Estouro: os primeiros VIS itens do estágio K + "+N ▾"; o último lugar mostra a sessão em uso do
  # cliente, se ela estiver entre as escondidas (condição em #{session_name}, avaliada por cliente).
  _fx_estouro() { # k vis
    local k=$1 vis=$2 oculto=$((total - $2)) w=0 refs="" slot walt i
    ((oculto > 0)) || return 0
    for ((i = 1; i < vis; i++)); do refs+="#{E:@fx${k}_$i}"; w=$((w + WKI[$k,$i])); done
    slot="#{E:@fx${k}_$vis}"; walt=${WKI[$k,$vis]}
    for ((i = total; i > vis; i--)); do
      ((vivas[i] == 2)) || continue
      ((WKI[$k,$i] > walt)) && walt=${WKI[$k,$i]}
      slot="#{?#{==:#{session_name},${nome[i]}},#{E:@fx${k}_$i},$slot}"
    done
    _fx_opt "@fxo${k}_$vis" "$refs$slot#[range=user|fixmais]#[bg=#44475a]#[fg=#bd93f9]#[bold] +$oculto ▾ #[norange]#[default]"
    REF+=("#{E:@fxo${k}_$vis}"); LIM+=($((w + walt + ${#oculto} + 5 + dir)))
  }
  # Primeiro com os visíveis no piso (16); só depois, um item só, cada vez menor.
  for ((vis = teto == total ? total - 1 : teto; vis >= 1; vis--)); do _fx_estouro "${KCAP[16]}" "$vis"; done
  for cap in 12 8 6; do _fx_estouro "${KCAP[$cap]}" 1; done
  # Só regrava as opções @fx… quando o conteúdo mudou: um source-file igual ao que está no servidor
  # redesenhava a tela inteira de todos os clientes a cada atualizar_barras (vigia por minuto,
  # tarefas/fixadas recebidas…). O carimbo (cksum do cfg) fica em @fx_carimbo, gravado no MESMO
  # source-file — um atualizar_barras concorrente já o encontra gravado — e também viaja no fim de
  # @barra_fixadas, para o formato mudar junto com o conteúdo.
  local carimbo; carimbo=$(printf '%s' "$cfg" | cksum | cut -d' ' -f1)
  # (carimbo igual mas @fx0_1 ausente = opções apagadas à mão: grava de novo)
  if [[ $(tmux show -gqv @fx_carimbo 2>/dev/null) != "$carimbo" || -z $(tmux show -gqv @fx0_1 2>/dev/null) ]]; then
    mkdir -p "$RT"; arq=$(mktemp "$RT/tt-fixadas-fmt.XXXXXX") || return 0
    printf '%sset -g @fx_carimbo %s\n' "$cfg" "$carimbo" >"$arq"; tmux source-file "$arq" 2>/dev/null; rm -f "$arq"
  fi
  printf '#[fg=#6272a4] ▸ ' # só marcador (não clicável); os pinos da barra são botões
  # Largura forçada (testes): só a versão que cabe nela.
  if [[ ${TT_FIX_LARGURA:-} =~ ^[0-9]+$ ]]; then
    for i in "${!REF[@]}"; do ((LIM[i] <= TT_FIX_LARGURA)) && { printf '%s#{?,%s,}' "${REF[i]}" "$carimbo"; return 0; }; done
    printf '%s#{?,%s,}' "${REF[-1]}" "$carimbo"; return 0
  fi
  # Por cliente: #{?#{e|>=:#{client_width},LIM1},V1,#{?…,V2,…Vúltima}}.
  local out=${REF[-1]}
  for ((i = ${#REF[@]} - 2; i >= 0; i--)); do out="#{?#{e|>=:#{client_width},${LIM[i]}},${REF[i]},$out}"; done
  printf '%s#{?,%s,}' "$out" "$carimbo"
  return 0
}

# Indicador discreto no canto direito da faixa de fixadas. É uma opção do tmux, não um #(), para
# não iniciar processo a cada redesenho da barra.
versao_barra() { printf '#[fg=#6c7086]%s ' "$(versao_humana)"; }

# Recalcula as faixas da barra (fixadas, atalhos, transferências) e as guarda em opções do tmux,
# que a barra só lê. Só grava o que mudou: cada set-option redesenha a tela inteira de todos os
# clientes (o miolo da faixa nem passa por aqui — é o letreiro-tt.py, ver barra_notifs_fmt).
atualizar_barras() {
  tmux list-sessions >/dev/null 2>&1 || return 0
  local nome valor
  for nome in fixadas atalhos transf versao tarefas email data notifs notifs_n notifs_slot transf0 faixa faixa_dir lado1 fim0; do
    case $nome in
      fixadas) valor=$(barra_fixadas_fmt) ;;
      atalhos) valor=$(atalhos_barra) ;;
      transf) valor=$(transferencias_barra) ;;
      versao) valor=$(versao_barra); [[ $(versao_num) == 0 ]] && continue ;; # troca de pasta em curso
      tarefas) valor=$(barra_tarefas_fmt) ;;
      email) valor=$(barra_email_fmt) ;;
      data) valor=$(barra_data) ;;
      notifs) valor=$(barra_notifs_fmt) ;;
      notifs_n) { IFS=$'\t' read -r _qn _qi <<<"$(barra_notifs_avisos)"; valor=""; [[ -n $_qi ]] && valor="#[fg=#f9e2af,bold]$_qn#[nobold]"; } ;;
      notifs_slot) valor="#{E:@barra_notifs}" ;;
      transf0)
        if faixa_notif_ativa; then valor=""
        else valor="#{E:@barra_transf}"; fi ;;
      faixa)
        if faixa_notif_ativa; then valor="#[range=user|email]#{E:@barra_email}#[norange]#[default] #{E:@barra_tarefas}#[range=user|notifs]#[fg=#a6adc8] 🔔#{E:@barra_notifs_n} #[norange]#[default]"
        else valor=""; fi ;;
      faixa_dir)
        # Responsivo por cliente: o letreiro tem prioridade sobre o enfeite. < 120 colunas sai o dia,
        # < 90 sai também a versão (sobra só a hora) — assim ele ganha ~25 células num terminal estreito.
        if faixa_notif_ativa; then valor="#[range=user|relogio]#[fg=#a6adc8]#{?#{e|<:#{client_width},120},,#{E:@barra_data}}%H:%M #[norange]#[default]#{?#{e|<:#{client_width},90},, #{E:@barra_versao}}"
        else valor=""; fi ;;
      lado1)
        if faixa_notif_ativa; then valor=""
        else valor="#{E:@barra_tarefas}#{E:@barra_versao}"; fi ;;
      fim0)
        if faixa_notif_ativa; then valor=""
        else valor="#[range=user|email]#{E:@barra_email}#[norange]#[default] #{?#{e|<:#{client_width},60},,#[range=user|relogio]#[fg=#a6adc8]#{?#{e|<:#{client_width},90},,#{E:@barra_data}}%H:%M #[norange]#[default]}"; fi ;;
    esac
    [[ $valor == "$(tmux show -gqv "@barra_$nome")" ]] && continue
    tmux set -g "@barra_$nome" "$valor"
  done
  local st; st=$(barra_status_linhas)
  [[ $(tmux show -gqv status 2>/dev/null) == "$st" ]] || tmux set -g status "$st" 2>/dev/null
  # Cada set-option acima já redesenhou tela e barra de todos os clientes; um refresh-client aqui
  # seria redundante — e recriaria o letreiro (#()) de cada cliente.
  return 0
}

# Dia de hoje para o relógio da barra ("Qui, 08/10/2026 | "), em português sem depender de
# locale; recalculado pelo vigia (vira na madrugada na volta seguinte). Em tela < 90 fica só a hora.
barra_data() {
  local d=(Dom Seg Ter Qua Qui Sex Sáb)
  printf '%s, %s | ' "${d[$(date +%w)]}" "$(date +%d/%m/%Y)"
}

barra_fixadas() {
  local atual=${1:-} i=0 r s id rot cor chave
  local -A existe
  while read -r s; do existe[$s]=1; done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)
  printf '#[fg=#6272a4] ▸ ' # só marcador (não clicável); os pinos da barra são botões
  while IFS=$'\t' read -r r s id; do
    i=$((i + 1))
    chave=$(fixada_chave "$r" "$s" "$id")
    if [[ $r == "$MAQUINA" ]]; then rot=$s; else rot="$r:$s"; fi
    rot=${rot:0:22}
    if [[ $r == "$MAQUINA" && $s == "$atual" ]]; then cor='#[bg=#bd93f9,fg=#282a36,bold]'
    elif [[ $r == "$MAQUINA" && -z ${existe[$s]:-} ]]; then cor='#[bg=#282a36,fg=#6272a4]'; rot="✗ $rot"
    else cor='#[bg=#44475a,fg=#f8f8f2]'; fi
    # Item (clique vai à sessão) + ✕ (clique desafixa).
    printf '#[range=user|fx%s]%s %s#[norange]#[range=user|fxx%s]%s ✕ #[norange]#[default] ' "$chave" "$cor" "$rot" "$chave" "$cor"
  done < <(fixadas)
}

# Clique num item fixado: vai para ele (ponte, se for de outra máquina).
ir_fixada() {
  local c=$1 chave=${2#fx} r s id k d resolvida
  while IFS=$'\t' read -r r s id; do
    k=$(fixada_chave "$r" "$s" "$id")
    [[ $k == "$chave" ]] && break
    r=""; s=""
  done < <(fixadas)
  [[ -n $s ]] || return 0
  d=$(dest_de "$r")
  if [[ -z $d ]]; then tmux display-message -c "$c" "📌 $r: máquina não cadastrada ou desligada"; return 0; fi
  if [[ -n $id ]]; then
    if [[ $d == . ]]; then
      resolvida=$(session_by_id "$id")
    else
      resolvida=$(timeout 6 ssh "${SSH_OPC[@]}" "$d" "$TT_REMOTO --resolver-fixada $(q "$s") $(q "$id")" </dev/null 2>/dev/null)
      resolvida=${resolvida%%$'\t'*}
    fi
    [[ -n $resolvida ]] && s=$resolvida
  fi
  if [[ $d == . ]] && ! tmux has-session -t "=$s" 2>/dev/null; then
    reconciliar_fixadas
    tmux display-message -c "$c" "📌 a sessão \"$s\" não existe mais e foi desafixada"; return 0
  fi
  TT_CLIENTE=$c ir_para "$d" "$s"
}

