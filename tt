  --alternar-fixada-rotulo) alternar_fixada "$2" "$3"; exit ;;
  --alternar-fixada) # DEST CHAVE (do seletor)
    [[ -n $3 && $3 != '!'* && $3 != '+'* && $3 != '%'* ]] && alternar_fixada "$(rotulo "$2")" "$3" >/dev/null; exit ;;
  --fixar) # [máquina:]sessão
    a=${2:?uso: tt --fixar [máquina:]sessão}; [[ $a == *:* ]] && alternar_fixada "${a%%:*}" "${a#*:}" || alternar_fixada "$MAQUINA" "$a"; exit ;;
  --fixadas) fixadas; exit ;;
