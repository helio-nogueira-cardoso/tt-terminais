cerebro_contexto() { # "FRASE(S)": o que muda a cada volta (estado, tela da sessão escolhida, índice, conversa)
  local m s
  m=$(alvo_m); s=$(alvo_s)
  echo "Contexto:"
  echo "- máquinas: $(maquinas | tr '\n' ' ')(esta, de onde ele fala: $(local_rotulo))"
  echo "- máquina atual: $m"
  if [[ -n $s ]]; then echo "- sessão escolhida: $s"; else echo "- sessão escolhida: nenhuma"; fi
  if [[ -n $s ]]; then
    local rm rs t
    IFS=$'\t' read -r rm rs < <(real_de "$m" "$s")
    t=$(capturar "$rm" "$rs" 300)
    if [[ -n $t ]]; then
      echo "- tela de agora da sessão escolhida${rs:+ ($rs em $rm)}; o agente está $(ocupado "$t" && echo "TRABALHANDO$(h=$(ha_quanto "$t"); [[ -n $h ]] && echo " há $h")" || echo parado):"
      limpar_tela <<<"$t" | grep -v '^[[:space:]]*$' | tail -n "${VOZ_TELA_LINHAS:-45}" | cut -c1-200 | sed 's/^/  | /'
    fi
  fi
  [[ -s $ST/lista ]] && { echo "- última lista (sessões em $(head -n 1 "$ST/lista")):"; tail -n +2 "$ST/lista" | awk '{print "  " NR ". " $0}' | head -n 20; }
  local ix; ix=$(indice_lista >/dev/null; indice_texto < "$ST/indice" 2>/dev/null)
  [[ -n $ix ]] && { echo "- índice de sessões (máquina · sessão · agente · título · estado):"; printf '%s\n' "$ix" | head -n 80; }
  [[ -s $ST/pendente ]] && echo "- esperando resposta do agente em: $(cat "$ST/pendente")"
  [[ -n $(pergunta) ]] && echo "- pergunta pendente: $(pergunta) (opcao = espera o número)"
  echo "- contas de IA (desta máquina): $(contas_guardadas "$(local_rotulo)" | cut -f1,2 | tr '\t\n' ': ' | sed 's/ $//')"
  [[ -s $ST/historico ]] && { echo "- conversa recente:"; tail -n 12 "$ST/historico" | sed 's/^/  /'; }
  echo; echo "Frase do usuário (hipóteses do reconhecimento; a primeira é a mais provável):"; printf '%s\n' "$1"
}
