#!/usr/bin/env bash
# bash 4+ (o `env bash` pode achar o 3.2 do macOS: o path_helper põe /usr/bin na frente): recomeça com o do Homebrew.
if [ "${BASH_VERSINFO:-0}" -lt 4 ]; then
  for _tt_b in /opt/homebrew/bin/bash /usr/local/bin/bash; do [ -x "$_tt_b" ] && exec "$_tt_b" "$0" "$@"; done
  echo "$0: precisa do bash 4 ou mais novo (este é o $BASH_VERSION). No macOS: brew install bash" >&2; exit 1
fi
# voz — conversar com o tt-terminais pela voz (ou digitando). No computador (Linux, macOS, WSL) é o 🎤 da barra, uma
# janela que ouve pelo microfone, entende e responde falando; no celular, o Tasker ouve e fala (e o Telegram, no carro).
#   voz --conversa [--digitar]   a janela do 🎤 (a da barra do tt): ouvir, entender, agir e falar; --digitar só teclado
#   voz --audio | --audio-teste  o que esta máquina usa para gravar, transcrever e falar | grava, transcreve e repete
#   voz --instalar-audio         venv com faster-whisper e Piper (voz pt-BR) em ~/.local/share/tt-voz
#   voz --transcrever "LUGARES"  onde transcrever: local e/ou rótulos de máquina (padrão: todas; fica a de menor custo)
#   voz --medir                  mede cada jeito de transcrever nesta máquina (modelo × CPU/GPU): tempo e erro
#   voz --fala MOTOR             auto|piper|say|windows|spd|espeak|nenhum      voz --modelo NOME  (Whisper; padrão: o medido)
#   voz --microfone "NOME, OUTRO" o microfone preferido (parte do nome); padrão: o headset, depois USB, webcam, embutido
#   voz --saida "NOME"           a saída de som preferida; padrão: a do aparelho do microfone (o headset ouve e fala)
#   voz --limiar SENSIBILIDADE   normal (padrão: a fala a partir do nível 350) · alta (180) · máxima (100) · baixa (600) · um
#                                número; alta ou máxima para o headset que entrega a voz baixa (na janela: c e depois g)
#   voz --opcoes                 o painel: o modelo do cérebro e o da transcrição, a máquina, o microfone, a sensibilidade,
#                                a saída e a voz (na janela: c)
#   voz --voz VOZ                piper:pt_BR-faber-medium (padrão, offline) · edge:pt-BR-FranciscaNeural, AntonioNeural ou
#                                ThalitaMultilingualNeural (as neurais da Microsoft, online) · sistema
#   voz "maquinas" | "status" | "ir para notebook" | "sessoes" | "aba claude" | "proxima" | "tarefas" | "contas" | "repetir"
#   voz "qualquer outra frase"   vai, como texto, para a sessão-alvo (só se estiver liberada: "permitir sessao")
#   voz "terminal" / "encerrar"  abre / fecha a conversa (o Tasker ouve de novo depois de cada resposta)
#   VOZ_MUDO=1 voz ...           não fala, só imprime (teste no Termux)
#   voz --daemon                 lê /sdcard/Tasker/voz/in/*.txt (o Tasker grava ali) e responde falando
#   voz --garantir               sobe o daemon se não estiver de pé (cron; só age depois de `celular.sh voz`)
#   voz --abrir                  abre a conversa pelo Tasker (o mesmo que rodar a tarefa Terminal)
#   voz --telegram TOKEN | -     liga um bot do Telegram (token do @BotFather) como canal: é o caminho no Android Auto,
#                                que lê as respostas do bot e deixa você responder falando. "-" desliga
#   voz --contato "NOME"         nome do bot dito nas instruções (padrão: Terminal)
#   voz --carro "GLOBAL..."      globais do Tasker que valem 1 no carro (ex.: a do seu perfil de carro); nelas o
#                                celular não abre o microfone e a conversa segue pelo Telegram. "-" desliga
#   voz --cerebro-modelo M       o Claude do cérebro: sonnet (padrão: entende melhor o ambíguo), haiku ou opus
#   voz --cerebro "LUGARES" | -  liga o cérebro: o que não é comando simples vai a um Claude (ia-rot, Sonnet), que
#                                entende a frase solta e escolhe as ações; LUGARES em ordem: rótulos de máquina do tt (por
#                                ssh) e/ou "local" (no celular, o Claude do Debian/proot). Sem resposta: as regras de sempre
#   voz --panorama [MÁQUINA]     o que cada sessão está fazendo (todas as máquinas, ao mesmo tempo), resumido
#   voz --indice-local [N]       as sessões desta máquina: agente, título, estado e as N últimas linhas da tela
#   voz --cerebro-vivo           o Claude do cérebro aberto em stream-json (a janela o mantém e o serve por um socket)
#   voz --pastas [add|rm P]      as pastas em que a voz confia sozinha quando o agente pergunta ("[MÁQUINA:]PASTA", /** =
#                                subpastas); as telas de rotina dos agentes vêm do catálogo telas-agentes.conf
#   voz --esperas                o que a voz vai falar sozinha depois (esperas agendadas, sessões acompanhadas)
#   voz "espere 1 minuto e depois confira a sessão" | "me avise quando ele terminar" | "cancele a espera"
#   voz "fixar esta sessão" | "nova tarefa X para amanhã às 14 horas" | "ler as notificações" | "pause o letreiro"
#   voz "feche a sessão X" (confirma) | "limpeza" (sugere as paradas; fechar, tira a N, cancelar)
#   voz --retorno [SEGUNDOS|sair|auto sim|nao]   o modo retorno ("modo retorno por 5 minutos", "me chama quando elas
#                                terminarem"): o microfone fecha e as sessões a que você pediu algo chamam sozinhas
#   voz --evento TIPO AGENTE     (os ganchos do Claude e do Codex nas sessões da voz) o agente terminou ou pede algo
# No celular nada roda sozinho: sem `termux/celular.sh voz` o daemon não sobe. O áudio do computador é o voz-audio.py.
# Estado: ~/.local/state/tt-voz (alvo, última resposta, índice das sessões). Escolher uma sessão já a libera para texto
# livre (~/.config/tt-voz/permitidas, linhas "maquina:sessao"); "bloquear sessão" a solta. Fala: grava /sdcard/Tasker/voz/fala.txt e manda o intent tt.VOZ_FALAR (perfil do projeto
# tt-voz do Tasker); sem Tasker, usa termux-tts-speak se existir. O arquivo voz/falando ("1" enquanto o Tasker diz a
# fala anterior) evita atropelar uma fala com a seguinte. Com o Telegram ligado, o que chega pelo bot é respondido pelo bot.
set -u
export PATH="$HOME/.local/bin:$PATH"
# acentos e símbolos (●, ❯, ─) precisam de UTF-8 no sed/grep/awk; o cron começa sem locale (o macOS não tem C.UTF-8)
if [[ ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} != *[Uu][Tt][Ff]* ]]; then
  if [[ $(uname -s) == Darwin ]]; then export LC_ALL=en_US.UTF-8; else export LC_ALL=C.UTF-8; fi
fi
# o tmux do Termux mora em $PREFIX/var/run (como no tt); sem isto o daemon do cron não acha as sessões daqui
[[ -z ${TMUX_TMPDIR:-} && -d ${PREFIX:-/x}/var/run ]] && export TMUX_TMPDIR=$PREFIX/var/run
ST=$HOME/.local/state/tt-voz; CF=$HOME/.config/tt-voz; SD=${VOZ_SDCARD:-/sdcard}
AQUI=$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd); AUDIO=$AQUI/voz-audio.py
mkdir -p "$ST" "$CF"; touch "$CF/permitidas"
# a conexão de cada máquina fica aberta e é a mesma do tt (ControlPath): um comando lá custa ~0,35 s, não ~0,75 s
SSHO=(-o BatchMode=yes -o ConnectTimeout=8 -o ServerAliveInterval=5 -o ControlMaster=auto
  -o "ControlPath=$HOME/.cache/tt-ssh-%r@%h" -o ControlPersist=12h)
TG=${VOZ_TELEGRAM:-$HOME/.secrets/tt-voz/telegram}; TG_API=${VOZ_TG_API:-https://api.telegram.org}; CANAL=; JUNTAR=

mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }  # GNU e BSD (macOS)
norm() { printf '%s' "$*" | tr 'A-Z' 'a-z' | sed 'y/áàâãäéèêëíìîïóòôõöúùûüç/aaaaaeeeeiiiiooooouuuuc/; s/[^a-z0-9 ]/ /g; s/  */ /g; s/^ //; s/ $//'; }
semcor() { sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g'; }

conversa_log() { # QUEM TEXTO: a conversa (a janela do 🎤 no celular a mostra); guarda as últimas 300 linhas
  local f=$ST/conversa.log
  printf '%s %s: %s\n' "$(date +%T)" "$1" "$2" >> "$f"
  (( $(wc -l < "$f") > 400 )) && { tail -n 300 "$f" > "$f.tmp" && mv "$f.tmp" "$f"; }
  return 0
}
falar() { # imprime e (salvo VOZ_MUDO) manda o Tasker dizer; VOZ_AVISO=1: o Tasker não volta a ouvir e "repetir" não o repete
  local t=$* d=$SD/Tasker/voz
  [[ -z ${VOZ_AVISO:-} ]] && printf '%s\n' "$t" > "$ST/ultima.txt"
  printf '%s\n' "$t"
  [[ -n $JUNTAR && -z ${VOZ_AVISO:-} ]] && printf '%s ' "$t" >> "$ST/turno"
  [[ -n $JUNTAR && -z ${VOZ_AVISO:-} ]] && return 0
  conversa_log tt "$t"
  # janela do 🎤 (voz-audio.py conversa): "tipo<TAB>texto" no fd que ela abriu; ela mostra e fala
  if [[ ${VOZ_TELA_FD:-} =~ ^[0-9]+$ ]]; then
    printf '%s\t%s\n' "$( [[ -n ${VOZ_FIM:-} ]] && echo fim || { [[ -n ${VOZ_AVISO:-} ]] && echo aviso || echo fala; })" "$t" >&"$VOZ_TELA_FD"
    return 0
  fi
  [[ -n ${VOZ_MUDO:-} ]] && return 0
  [[ $CANAL == telegram ]] && { tg_enviar "$t"; return 0; }
  if [[ -d $SD/Tasker ]] && mkdir -p "$d" 2>/dev/null; then
    while [[ $(cat "$d/falando" 2>/dev/null) == 1 ]] &&
      (( $(date +%s) - $(mtime "$d/falando") < ${VOZ_ESPERA_FALA:-40} )); do sleep 1; done
    if printf '%s' "$t" > "$d/fala.txt" 2>/dev/null; then
      printf 1 > "$d/falando"
      am broadcast -a tt.VOZ_FALAR ${VOZ_AVISO:+--es ouvir 0} ${VOZ_FIM:+--es fim 1} >/dev/null 2>&1
      return 0
    fi
  fi
  command -v termux-tts-speak >/dev/null && termux-tts-speak "$t" >/dev/null 2>&1
  return 0
}
aviso() { VOZ_AVISO=1 falar "$@"; }
fim() { VOZ_AVISO=1 VOZ_FIM=1 falar "$@"; }  # fala e encerra a conversa (o Tasker não ouve mais)

# ---------- Telegram (opcional): canal do Android Auto ----------
tg_val() { sed -n "s/^$1=//p" "$TG" 2>/dev/null | head -n 1; }
tg_ok() { [[ -n $(tg_val TOKEN) && -n $(tg_val CHAT) ]]; }
tg_enviar() { # tg_enviar TEXTO: manda ao seu chat com o bot
  local tok chat; tok=$(tg_val TOKEN); chat=$(tg_val CHAT); [[ -n $tok && -n $chat ]] || return 1
  curl -s -m 20 -o /dev/null "$TG_API/bot$tok/sendMessage" --data-urlencode "chat_id=$chat" --data-urlencode "text=$1"
}
# lê a resposta do getUpdates: mensagens do seu chat (de até 10 min atrás) viram PASTA/tg-ID.txt; imprime o próximo offset
TG_PY='import json, os, sys, time
chat, pasta, off = sys.argv[1], sys.argv[2], int(sys.argv[3])
d = json.load(sys.stdin)
for u in d.get("result", []):
    off = max(off, u["update_id"] + 1)
    m = u.get("message") or {}
    t = (m.get("text") or "").strip()
    if not t or str(m.get("chat", {}).get("id")) != chat or time.time() - m.get("date", 0) > 600:
        continue
    if t.startswith("/"):
        c = t.split()[0].split("@")[0]
        t = {"/start": "terminal", "/ajuda": "ajuda", "/help": "ajuda"}.get(c, t[1:])
    with open(os.path.join(pasta, "tg-%d.txt" % u["update_id"]), "w") as f:
        f.write(t)
print(off)'
tg_vigiar() { # filho do daemon: long polling do bot
  local tok chat off r n
  tok=$(tg_val TOKEN); chat=$(tg_val CHAT); off=$(cat "$ST/tg_offset" 2>/dev/null || echo 0)
  while :; do
    r=$(curl -s -m 70 "$TG_API/bot$tok/getUpdates?timeout=${VOZ_TG_ESPERA:-50}&offset=$off") &&
      n=$(python3 -I -c "$TG_PY" "$chat" "$SD/Tasker/voz/in" "$off" <<<"$r" 2>/dev/null) && [[ -n $n ]] ||
      { sleep "${VOZ_TG_PAUSA:-5}"; continue; }
    off=$n; printf '%s\n' "$off" > "$ST/tg_offset"
  done
}
tg_ligar() { # tg_ligar TOKEN: confere o token, espera o seu /start (3 min) e grava TOKEN e CHAT
  local tok=$1 me r i chat
  me=$(curl -s -m 20 "$TG_API/bot$tok/getMe" | python3 -I -c 'import json, sys
d = json.load(sys.stdin); print(d["result"]["username"] if d.get("ok") else "")' 2>/dev/null)
  [[ -n $me ]] || { echo "o Telegram recusou o token" >&2; return 1; }
  mkdir -p "${TG%/*}"; chmod 700 "${TG%/*}"; ( umask 077; printf 'TOKEN=%s\n' "$tok" > "$TG" )
  echo "bot @$me. No seu Telegram, abra https://t.me/$me e toque em Começar (espero 3 min)."
  for ((i = 0; i < ${VOZ_TG_LIGAR:-36}; i++)); do
    r=$(curl -s -m 10 "$TG_API/bot$tok/getUpdates?timeout=0")
    chat=$(python3 -I -c 'import json, sys
for u in json.load(sys.stdin).get("result", []):
    c = (u.get("message") or {}).get("chat", {})
    if c.get("type") == "private": print(c["id"], c.get("first_name", "")); break' <<<"$r" 2>/dev/null)
    [[ -n $chat ]] && break; sleep 5
  done
  [[ -n $chat ]] || { echo "ninguém tocou em Começar; rode de novo" >&2; return 1; }
  printf 'CHAT=%s\n' "${chat%% *}" >> "$TG"
  CANAL=telegram falar "Conectado ao terminal. Diga ajuda para saber como usar." >/dev/null
  echo "ligado ao chat de ${chat#* }. Reinicie o daemon: voz --reiniciar"
}

# ---------- máquinas ----------
TTMAQ=
tt_maquinas() { # "usuario@host rótulo" das máquinas do tt; o comando() lê uma vez por volta (cada tt custa ~80 ms)
  if [[ -n $TTMAQ ]]; then printf '%s\n' "$TTMAQ"; else tt --maquinas 2>/dev/null; fi
}
local_rotulo() {
  local f=$ST/local; [[ -s $f ]] || tt --listar-tudo --para-ia 2>/dev/null | sed -n '1s/.*— \([^ ]*\) —.*/\1/p' > "$f"
  cat "$f"
}
maquinas() { tt_maquinas | awk '{print $2}'; local_rotulo; }
destino() { local r=$1; [[ $r == "$(local_rotulo)" ]] && { echo local; return; }; tt_maquinas | awk -v l="$r" '$2==l{print $1}'; }
em() { # em ROTULO comando...  (roda lá, local ou por ssh; EM_TEMPO segundos no máximo, padrão 40)
  local d; d=$(destino "$1"); shift
  if [[ $d == local || -z $d ]]; then timeout "${EM_TEMPO:-40}" bash -c "$*"; else
    timeout "${EM_TEMPO:-40}" ssh "${SSHO[@]}" "$d" "PATH=\"\$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:\$PATH\"; TMUX_TMPDIR=\"\${TMUX_TMPDIR:-\$([ -d \"\${PREFIX:-/x}/var/run\" ] && echo \"\$PREFIX/var/run\")}\"; export TMUX_TMPDIR; $*"; fi
}
achar() { # achar "termo" lista... -> melhor item (todas as palavras do termo contidas, senão a 1ª que contém)
  local termo=$1 it n w ok; shift
  for it in "$@"; do n=$(norm "$it"); ok=1
    for w in $termo; do [[ $n == *"$w"* ]] || { ok=0; break; }; done
    ((ok)) && { printf '%s' "$it"; return 0; }
  done; return 1
}
sessoes() { em "$1" "tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -v '^_'"; }

# No celular, as contas e os agentes de IA ficam no Linux do proot-distro onde o tt instalou o ia-conta (o 🚀 do perfil
# mobile abre lá); o ia-conta do Termux não os vê ("principal ? desconhecido"). proot_ia: esse Linux, ou nada (fora do
# Termux, ou com o claude no próprio Termux).
proot_ia() {
  local b=${PREFIX:-/x}/var/lib/proot-distro r p
  [[ ${PREFIX:-} == *com.termux* && ! -x $HOME/.local/bin/claude ]] && command -v proot-distro >/dev/null || return 0
  for r in "$b"/containers/*/rootfs "$b"/installed-rootfs/*; do
    [[ -x $r/root/.local/share/tt/ia-conta ]] || continue
    if [[ $r == */rootfs ]]; then p=${r%/rootfs}; p=${p##*/}; else p=${r##*/}; fi
    printf '%s' "$p"; return 0
  done
}
ia_em() { # ia_em MAQ "COMANDO": o comando de IA (ia-conta, ia-rot) para rodar em MAQ; neste celular, dentro do proot das IAs
  local d p; d=$(destino "$1")
  if [[ $d == local || -z $d ]] && p=$(proot_ia) && [[ -n $p ]]; then
    printf 'proot-distro login %s --shared-tmp -- bash -lc %q' "$p" "PATH=\"\$HOME/.local/bin:\$PATH\" $2"
  else printf '%s' "$2"; fi
}

alvo_m() { cat "$ST/alvo_m" 2>/dev/null || local_rotulo; }
alvo_s() { cat "$ST/alvo_s" 2>/dev/null; }
liberada() { grep -qxF "$(alvo_m):$(alvo_s)" "$CF/permitidas"; }
liberar() { # MAQ SESSÃO: escolher uma sessão já a libera para texto (pedido do dono: sem "diga sim")
  grep -qxF "$1:$2" "$CF/permitidas" 2>/dev/null || printf '%s:%s\n' "$1" "$2" >> "$CF/permitidas"; }

resumo() { # texto da tela -> 2-3 frases faláveis
  semcor | sed 's/[─│╭╮╰╯┌┐└┘├┤▐▌█▀▄]//g; s/`//g; s/\*\*//g; s/^[#>•●⏺⎿ -]*//' |
    awk 'BEGIN{c=0} /^```/{c=!c; if(c) print "bloco de código omitido."; next} !c' |
    sed 's#https\?://[^ ]*#link#g' | tr '\n' ' ' | sed 's/  */ /g' |
    awk -v L="${VOZ_RESUMO:-420}" '{ s=$0; if (length(s)>L) { s=substr(s,1,L); sub(/[^.!?]*$/,"",s); if (s=="") s=substr($0,1,L) } sub(/^ +/,"",s); sub(/ +$/,"",s); print s }'
}

resumo_longo() { VOZ_RESUMO=900 resumo; }

# A sessão de verdade: uma ponte (sessão "maquina-…" que mostra uma sessão de outra máquina) vira a sessão que o
# cliente dela está mostrando lá (o tt marca esse cliente com TT_PONTE="origem|ponte"; dentro da ponte dá para trocar
# de sessão, então o @ponte_alvo gravado pode estar velho). Ler e mandar texto lá evita as barras do tt e o rodapé
# do agente que a ponte mostra por cima.
real_de() { # MAQ SESSÃO -> "MAQ<TAB>SESSÃO"
  local m=$1 s=$2 dest rot r=""
  dest=$(em "$m" "tmux show-options -qv -t '=$s:' @ponte" 2>/dev/null | head -n 1)
  rot=$([[ -n $dest ]] && tt_maquinas | awk -v d="$dest" '$1 == d { print $2; exit }')
  if [[ -z $rot ]]; then printf '%s\t%s\n' "$m" "$s"; return; fi
  r=$(em "$rot" "voz --cliente-ponte $(printf '%q' "$m|$s")" 2>/dev/null | head -n 1)
  [[ -n $r ]] || { r=$(em "$m" "tmux show-options -qv -t '=$s:' @ponte_alvo" 2>/dev/null); r=${r#*|}; }
  if [[ -n $r ]]; then printf '%s\t%s\n' "$rot" "$r"; else printf '%s\t%s\n' "$m" "$s"; fi
}
cliente_ponte() { # ORIGEM ("máquina|ponte") -> a sessão que o cliente dessa ponte mostra aqui
  local pid c
  while IFS=: read -r pid c; do
    # Linux: /proc; macOS (sem /proc): o `ps eww` do BSD imprime o ambiente depois do comando.
    if [[ -r /proc/$pid/environ ]]; then tr '\0' '\n' <"/proc/$pid/environ"; else ps eww -p "$pid" 2>/dev/null | tr ' ' '\n'; fi |
      grep -qxF "TT_PONTE=$1" && { printf '%s\n' "$c"; return 0; }
  done < <(tmux list-clients -F '#{client_pid}:#{session_name}' 2>/dev/null)
  return 1
}
capturar() { em "$1" "tmux capture-pane -p -J -S -${3:-600} -t '=$2:'" 2>/dev/null; }  # MAQ SESSÃO [LINHAS]
# só a tela visível: é nela que mora uma pergunta de agora (a respondida sobe para o histórico e não vale mais)
capturar_visivel() { em "$1" "tmux capture-pane -p -J -t '=$2:'" 2>/dev/null; }  # MAQ SESSÃO
# Linhas da interface (rodapés do Claude e do Codex, dicas, a barra do tt de uma ponte), que não são conversa
CHROME='bypass permissions|esc to interrupt|shift\+tab to cycle|\? for shortcuts|Tip: |Update installed|Restart to update|still running|☰ terminais|⋯ painel|📧 \(|🔔[0-9]|auto-accept|context left|Context left|^[[:space:]]*[─━═]{5,}|^[[:space:] ]*(❯|>)[[:space:] ]*$'
limpar_tela() { semcor | grep -vE "$CHROME"; }
ocupado() { grep -qiE 'esc to interrupt|ctrl\+c to interrupt|working \(|thinking|[✻✶✳✢✽·*] [A-Z][a-zçãé]+…? \([0-9]+[ms]' <<<"$1"; }
ha_quanto() { grep -oE '\(([0-9]+h )?([0-9]+m )?[0-9]+s' <<<"$1" | tail -n 1 | tr -d '(' | sed 's/h / horas e /; s/m / minutos e /; s/s$/ segundos/; s/^0 minutos e //'; }
descarregar() { # o que o cérebro já mandou dizer nesta volta sai agora (antes de esperar o agente)
  local t; [[ -n $JUNTAR && -s $ST/turno ]] || return 0
  t=$(sed 's/ *$//' "$ST/turno"); : > "$ST/turno"; printf '%s ' "$t" >> "$ST/turno.dito"
  JUNTAR= falar "$t" >/dev/null
}

# ---------- índice: as sessões de todas as máquinas (para escolher pelo assunto e para o panorama) ----------
indice_local() { # [N]: as sessões desta máquina (sem ocultas nem pontes): agente, título, estado e as N últimas linhas
  local n=${1:-0} eu s pon ag oc tit t est h
  eu=$(local_rotulo)
  declare -A AG=() OC=() TIT=()
  while IFS=$'\t' read -r _ s _ oc _ _ ag _ _ _ tit _; do
    [[ -n $s ]] && { AG[$s]=$ag; OC[$s]=$oc; TIT[$s]=$tit; }
  done < <(tt --listar-tudo --para-ia 2>/dev/null | awk -F'\t' -v m="$eu" '$1 == m && NF >= 11')
  while IFS=$'\x1f' read -r s pon; do
    [[ -z $s || $s == _* || -n $pon ]] && continue
    tit=${TIT[$s]:-}; tit=${tit#[✳✻✶✢·*] }; [[ $tit == "Claude Code" || $tit == "$s" ]] && tit=
    t=$(tmux capture-pane -p -J -S -200 -t "=$s:" 2>/dev/null | semcor)
    if ocupado "$t"; then h=$(ha_quanto "$t"); est="trabalhando${h:+ há $h}"
    else oc=${OC[$s]:-}; est=parado; [[ $oc =~ ^[0-9]+$ ]] && ((oc >= 120)) && est="parado há $((oc / 60)) min"; fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$eu" "$s" "${AG[$s]:--}" "$tit" "$est"
    # sem a caixa de digitar do agente (❯/›/>, seguidos de espaço comum ou não separável: o rascunho e as dicas dela
    # não são a conversa)
    ((n > 0)) && limpar_tela <<<"$t" | grep -vE '^[[:space:]]*$|^[[:space:] ]*(❯|›|>)([[:space:] ]|$)' | tail -n "$n" | cut -c1-160 | sed 's/^/\t| /'
  done < <(tmux list-sessions -F $'#{session_name}\x1f#{@ponte}' 2>/dev/null)
  return 0
}
indice_todas() { # [N] [MÁQUINA]: o indice_local de cada máquina (todas ao mesmo tempo; a que não responde em 8 s fica de fora)
  local n=${1:-0} so=${2:-} m d pids=() i=0 lista=()
  d=$(mktemp -d)
  while read -r m; do
    [[ -n $m && ( -z $so || $m == "$so" ) ]] || continue
    lista+=("$m")
    if [[ $(destino "$m") == local ]]; then indice_local "$n" > "$d/$i" 2>/dev/null &
    else EM_TEMPO=${VOZ_T_INDICE:-8} em "$m" "f=\$HOME/.local/share/tt/voz; [ -f \"\$f\" ] && grep -q -- --indice-local \"\$f\" && bash \"\$f\" --indice-local $n" > "$d/$i" 2>/dev/null & fi
    pids+=($!); i=$((i + 1))
  done < <(maquinas | awk 'NF && !v[$0]++')
  ((${#pids[@]})) && wait "${pids[@]}" 2>/dev/null
  for ((i = 0; i < ${#lista[@]}; i++)); do cat "$d/$i" 2>/dev/null; done
  rm -rf "$d"
  return 0
}
indice_atualizar() { # grava o índice compacto (a janela pede a cada ~20 s, em segundo plano)
  local t; t=$(indice_todas 0); [[ -n $t ]] || return 0
  printf '%s\n' "$t" > "$ST/indice.$$" && mv "$ST/indice.$$" "$ST/indice"
}
indice_lista() { # "MAQ<TAB>SESSÃO<TAB>TÍTULO" de todas: o índice guardado (até 60 s), ou um novo
  (( $(date +%s) - $(mtime "$ST/indice") < 60 )) || indice_atualizar
  cut -f1,2,4 "$ST/indice" 2>/dev/null
}
indice_texto() { # o índice para o cérebro: uma linha por sessão (e as linhas da tela, se houver)
  awk -F'\t' '$1 == "" { print "    " $2; next }
    { printf "  %s · %s · %s%s · %s\n", $1, $2, ($3 == "-" ? "sem agente" : $3), ($4 != "" ? " · \"" $4 "\"" : ""), $5 }'
}
panorama() { # [MÁQUINA]: o que cada sessão está fazendo, de todas as máquinas ao mesmo tempo, resumido para ouvir
  local so=${1:-} t pedido resp plano fala
  [[ -n $so ]] && { so=$(achar_maquina "$so") || { falar "Não achei a máquina $1."; return; }; }
  aviso "Vou olhar as sessões${so:+ de $so}."
  t=$(indice_todas "${VOZ_PANORAMA_LINHAS:-20}" "$so")
  [[ -n $t ]] || { falar "Não consegui ler as sessões."; return; }
  printf '%s\n' "$t" | indice_texto > "$ST/panorama.txt"
  pedido=$(printf 'PANORAMA. O usuário pediu um resumo das sessões. Abaixo, cada sessão (máquina · nome · agente · título · estado) e as últimas linhas da tela dela.\nResponda com o JSON de sempre, sem ações; na "fala", uma frase curta por sessão com agente (o que ela faz ou fez por último e se espera algo do usuário), primeiro as que esperam por ele, depois as que trabalham; junte numa frase só as sem agente. Diga o nome da sessão como se fala (sem hífens). Aqui a fala pode passar de 2 frases.\n\n%s' "$(cat "$ST/panorama.txt")")
  if resp=$(cerebro_chamar "$pedido") && plano=$(python3 -I -c "$CEREBRO_PY" <<<"$resp" 2>/dev/null) &&
    fala=$(head -n 1 <<<"$plano") && [[ -n $fala ]]; then falar "$fala"; return; fi
  # sem o cérebro: nome, agente e estado de cada uma
  falar "$(printf '%s\n' "$t" | awk -F'\t' '$1 != "" { printf "%s em %s, %s, %s. ", $2, $1, ($3 == "-" ? "sem agente" : $3), $5 }' | sed 's/[_-]/ /g')"
}

esperar_resposta() { # espera o agente terminar (até VOZ_ESPERA voltas de 2 s); devolve a tela final em $TELA
  local sess=$1 m=$2 ant="" igual=0 ocup i
  for i in $(seq 1 "${VOZ_ESPERA:-15}"); do
    sleep 2
    TELA=$(capturar "$m" "$sess")
    ocup=0; ocupado "$TELA" && ocup=1
    if [[ $TELA == "$ant" ]]; then igual=$((igual+1)); else igual=0; ant=$TELA; fi
    ((ocup == 0 && igual >= 1)) && return 0
    ((ocup == 1)) && igual=0
  done
  return 1
}

extrair() { # extrair TELA [N]: texto das N últimas respostas do agente (padrão 1), separadas por uma linha em branco
  local t; t=$(limpar_tela <<<"$1" | grep -vE '^[[:space:]]*[✻✶✳✢✽·*] [A-Z][a-zçãé]+(…| for) ')
  local bloco; bloco=$(awk -v N="${2:-1}" '
    function fecha() { if (ativo && !skip) { k++; b[k] = buf } ativo = 0 }
    /^(●|⏺) / { fecha(); if ($0 ~ /^(●|⏺) [A-Z][A-Za-z_]*\(/) { skip=1; ativo=1; next } skip=0; buf=$0; ativo=1; next }
    /^(─|━)(─|━)(─|━)(─|━)(─|━)|^(❯|>) / { fecha(); next }
    ativo && !skip { buf = buf "\n" $0 }
    END { fecha(); i = k - N + 1; if (i < 1) i = 1; for (; i <= k; i++) { print b[i]; if (i < k) print "" } }' <<<"$t")
  [[ -n $bloco ]] || bloco=$(grep -v -E '^\s*$|^[─━]|bypass permissions|esc to|shift\+tab' <<<"$t" | tail -n 12)
  printf '%s' "$bloco"
}

falar_resposta() { # TELA N: fala a resposta (ou as N últimas) do agente
  local n=${2:-1} resp
  rm -f "$ST/pendente"
  extrair "$1" "$n" > "$ST/completa.txt"
  if ((n > 1)); then resp=$(awk -v RS= '{ printf "Resposta %d. ", NR; print }' "$ST/completa.txt" | resumo_longo)
  else resp=$(resumo < "$ST/completa.txt"); fi
  falar "${TELA_PREFIXO:-}${resp:-O agente terminou, sem texto novo.}"
}
resposta_ou_pergunta() { # MAQ SESSÃO TELA [N]: a pergunta na tela (a de rotina, numa sessão aberta pela voz, respondida
  # sozinha; a que exige decisão, lida para você) ou, sem pergunta, a resposta do agente (as N últimas)
  local m=$1 s=$2 t=$3 n=${4:-1} r
  tela_tratar "$m" "$s" "$(capturar_visivel "$m" "$s" | semcor)" trabalho "" voz; r=$?
  case $r in
    1) rm -f "$ST/pendente"; return 0 ;;
    2) VOZ_VOLTAS=$(( ${VOZ_VOLTAS:-0} + 1 ))
      if ((VOZ_VOLTAS <= ${VOZ_VOLTAS_MAX:-4})); then aguardar "$s" "$m" "$n"; else pendente_marcar "$m" "$s" "$t"; fi
      return 0 ;;
  esac
  chamada_retornou "$m" "$s"
  falar_resposta "$t" "$n"
}
pendente_marcar() { # MAQ SESSÃO TELA: o agente segue trabalhando; a janela avisa quando ele terminar
  local h; h=$(ha_quanto "$3")
  printf '%s:%s\n' "$1" "$2" > "$ST/pendente"; printf '%s' "${CANAL:-}" > "$ST/pendente.canal"
  falar "${TELA_PREFIXO:-}Ele está trabalhando${h:+ há $h}. Eu aviso quando terminar."
}
aguardar() { # aguardar SESSAO MAQUINA [N]: (depois de mandar texto) espera até ~30 s; senão, pendente
  local s=$1 m=$2 n=${3:-1}
  descarregar
  if esperar_resposta "$s" "$m"; then resposta_ou_pergunta "$m" "$s" "$TELA" "$n"; else pendente_marcar "$m" "$s" "$TELA"; fi
}
ler_agora() { # SESSAO MAQUINA [N]: o estado de agora, sem esperar: a resposta, ou que ele está trabalhando
  local s=$1 m=$2 n=${3:-1} t
  t=$(capturar "$m" "$s")
  [[ -n $t ]] || { falar "Não consegui ler a sessão $(falavel "$s") em $m."; return; }
  if ocupado "$t"; then pendente_marcar "$m" "$s" "$t"; else resposta_ou_pergunta "$m" "$s" "$t" "$n"; fi
}
pendente_pronto() { # 0 se o agente da sessão pendente terminou (duas telas iguais, sem "trabalhando")
  local r m s t1 t2
  [[ -s $ST/pendente ]] || return 1
  r=$(<"$ST/pendente"); m=${r%%:*}; s=${r#*:}
  t1=$(capturar "$m" "$s" 200); ocupado "$t1" && return 1
  sleep 1.5; t2=$(capturar "$m" "$s" 200)
  [[ -n $t1 && $t1 == "$t2" ]]
}

enviar() { # enviar TEXTO -> alvo (na sessão de verdade, se a escolhida é uma ponte)
  local m s txt=$1 rm rs
  m=$(alvo_m); s=$(alvo_s)
  [[ -n $s ]] || { falar "Não entendi. Para falar com um agente, escolha uma sessão: diga sessões. Ou diga ajuda."; return; }
  liberar "$m" "$s"
  em "$m" "tmux has-session -t '=$s' 2>/dev/null" || { falar "A sessão $s não existe mais em $m."; return; }
  IFS=$'\t' read -r rm rs < <(real_de "$m" "$s")
  chamada_registrar "$rm" "$rs" "$txt"  # o retorno espera a resposta desta vez
  em "$rm" "tmux send-keys -t '=$rs:' -l -- $(printf '%q' "$txt"); sleep 0.4; tmux send-keys -t '=$rs:' Enter"
  if [[ -e $CF/retorno-auto ]] && ! retorno_ligado; then  # retorno automático: cada pedido já liga o modo
    printf '%s\t%s\t%s\t%s\n' "$(date +%s)" "$(cat "$CF/retorno-auto" 2>/dev/null | tr -cd 0-9 | grep . || echo 0)" "$(date +%s)" "${CANAL:-}" > "$ST/retorno"
    falar "Enviado para $s. Fecho o microfone e te chamo quando responder."; return
  fi
  if retorno_ligado; then retorno_tocar; falar "Enviado para $s. Te chamo quando responder."; return; fi
  aviso "Enviado para $s."
  aguardar "$rs" "$rm"
}

falavel() { sed 's/[_-]/ /g' <<<"$1"; }  # nome de sessão dito em voz alta

listar_sessoes() { # listar_sessoes MAQUINA [PREFIXO]: lê numeradas e guarda a lista para "2", "dois", "segunda"
  local m=$1 pre=${2:-} lista i txt=""
  mapfile -t lista < <(sessoes "$m")
  ((${#lista[@]})) || { rm -f "$ST/lista"; falar "${pre}Sem sessões em $m."; return; }
  { echo "$m"; printf '%s\n' "${lista[@]}"; } > "$ST/lista"
  for i in "${!lista[@]}"; do ((i < 8)) && txt+="$((i + 1)), $(falavel "${lista[i]}"). "; done
  ((${#lista[@]} > 8)) && txt+="E mais $((${#lista[@]} - 8)). "
  falar "${pre}Em $m: $txt Diga o número ou o nome."
}

pergunta() { [[ -s $ST/pergunta && $(( $(date +%s) - $(mtime "$ST/pergunta") )) -lt 300 ]] && cat "$ST/pergunta"; }

escolhida() { # escolhida SESSAO [MAQ]: grava o alvo, libera e diz como seguir
  local s=$1 m=${2:-$(alvo_m)}
  printf '%s' "$m" > "$ST/alvo_m"; printf '%s' "$s" > "$ST/alvo_s"; rm -f "$ST/pergunta"
  liberar "$m" "$s"
  falar "Sessão $(falavel "$s"), em $m. Pode falar com ela."
}

escolher_sessao() { # NOME (palavras ou número da última lista): na máquina atual e, se não houver lá, nas outras
  local nome=$1 m lista s n r
  m=$(alvo_m)
  if n=$(numero "$nome") && [[ -s $ST/lista && $(head -n 1 "$ST/lista") == "$m" ]]; then
    s=$(sed -n "$((n + 1))p" "$ST/lista"); [[ -n $s ]] || { falar "Não há sessão $n. Diga sessões para ouvir a lista."; return; }
    escolhida "$s"; return
  fi
  mapfile -t lista < <(sessoes "$m")
  if s=$(achar "$nome" "${lista[@]}"); then escolhida "$s"; return; fi
  r=$(sessao_em_todas "$nome") && { escolhida "${r#*$'\t'}" "${r%%$'\t'*}"; return; }
  falar "Não achei a sessão $nome em nenhuma máquina. Diga sessões para ouvir a lista."
}
sessao_em_todas() { # NOME [EXCETO]: "MAQ<TAB>SESSÃO" da 1ª sessão de outra máquina cujo nome (ou título) tem as palavras
  local nome=$1 exceto=${2:-} m s tit n w ok
  while IFS=$'\t' read -r m s tit; do
    [[ $m == "$exceto" || -z $s ]] && continue
    n=$(norm "$s $tit"); ok=1
    for w in $nome; do [[ $n == *"$w"* ]] || { ok=0; break; }; done
    ((ok)) && { printf '%s\t%s\n' "$m" "$s"; return 0; }
  done < <(indice_lista)
  return 1
}

numero() { # "2", "dois", "segunda", "numero 2" -> 2 (a 1ª palavra que for número)
  local w
  for w in $*; do
    case $w in
      [0-9]|[0-9][0-9]) echo $((10#$w)); return 0 ;;
      um|uma|primeira|primeiro) echo 1; return 0 ;; dois|duas|segunda|segundo) echo 2; return 0 ;;
      tres|terceira|terceiro) echo 3; return 0 ;; quatro|quarta|quarto) echo 4; return 0 ;;
      cinco|quinta|quinto) echo 5; return 0 ;; seis|sexta|sexto) echo 6; return 0 ;;
      sete|setima|setimo) echo 7; return 0 ;; oito|oitava|oitavo) echo 8; return 0 ;;
      nove|nona|nono) echo 9; return 0 ;; dez|decima|decimo) echo 10; return 0 ;;
    esac
  done
  return 1
}

maquina_citada() { # imprime a máquina que a frase cita (rótulo inteiro, palavra por palavra), ou nada
  local n=" $1 " m mn
  [[ $n == *" celular "* || $n == *" telefone "* || $n == *" aqui "* ]] && { local_rotulo; return; }
  while read -r m; do
    [[ -n $m ]] || continue; mn=$(norm "$m")
    [[ $n == *" $mn "* ]] && { echo "$m"; return; }
  done < <(maquinas)
}

# frases (já normalizadas) que as regras reconhecem; em variáveis porque o [[ =~ ]] não aceita espaço solto
RE_NOVA='^((abr[aei]r?|cri[ae]r?|inici[ae]r?|comec[ae]r?|quero|preciso de) )?((uma|um) )?((nova|novo) )?(sessao|aba)( nova)?($| )'
RE_NOVA_VERBO='(^| )(nova|novo|abr[aei]r?|cri[ae]r?|inici[ae]r?|comec[ae]r?)( |$)'
RE_PEDIDO=' (abr|cri|nov|resum|todas|cada|conteud|context|panorama)'
RE_PANORAMA='^(o )?(panorama|resumo|resuma|resumir)( (de|das|dos|do|da|geral))?( (todas|tudo|as|os))*( (sessoes|abas|agentes|maquinas))?( abertas)?$'
RE_PANORAMA2='^(o )?que (esta|estao) acontecendo( (nas|em) (todas )?(as )?sessoes)?$'
cru_sufixo() { # FRASE-ORIGINAL TRECHO-NORMALIZADO -> o fim da frase original (com acentos e maiúsculas) que vira o trecho
  local -a w; local i
  read -ra w <<<"$1"
  for ((i = 0; i < ${#w[@]}; i++)); do [[ $(norm "${w[*]:i}") == "$2" ]] && { printf '%s\n' "${w[*]:i}"; return 0; }; done
  printf '%s\n' "$2"
}
cru_trecho() { # FRASE-ORIGINAL TRECHO-NORMALIZADO -> o pedaço do meio da frase original que vira o trecho
  local -a w; local i j k=$(wc -w <<<"$2")
  read -ra w <<<"$1"
  for ((i = 0; i < ${#w[@]}; i++)); do for ((j = k; j <= k + 2 && i + j <= ${#w[@]}; j++)); do
    [[ $(norm "${w[*]:i:j}") == "$2" ]] && { printf '%s\n' "${w[*]:i:j}"; return 0; }; done; done
  printf '%s\n' "$2"
}
# frases das ações novas (esperar, acompanhar, fixadas, tarefas, notificações, letreiro, fechar, limpeza) -> comando()
reescrever_acoes() { # frase normalizada -> o comando, ou 1
  local n=$1 r seg resto dep nome
  if [[ $n =~ ^(espere|espera|esperar|aguarde|aguarda|aguardar|daqui\ a|daqui|dentro\ de|em)\ (.+)$ ]] && r=$(duracao_de "${BASH_REMATCH[2]}"); then
    seg=${r%%$'\t'*}; resto=$(sed -E 's/^((e|depois|entao|ai|e depois|e entao|e ai|voce|me) )+//' <<<"${r#*$'\t'}"); dep=ler; nome=""
    # só o que a voz sabe fazer depois (conferir, ler, resumir, avisar); "espere 2 minutos e rode os testes" é do agente
    [[ -z $resto || " $resto " =~ (confir|\ ler\ |^\ ?le\ |\ le\ |leia|olh|\ ver\ |veja|\ ve\ |respost|resum|avis|lembr|cham|\ fal|\ diga|status|\ como\ |\ fez|terminou|sessao|\ aba\ ) ]] || return 1
    if [[ $resto =~ resum ]]; then dep=resumir
    elif [[ -z $resto || $resto =~ ^(me\ )?(avis|lembr|cham|fal) ]] && ! [[ " $resto " =~ (sessao|\ ler|\ le\ |leia|confir|olh|respost|\ fez|terminou|\ como\ ) ]]; then dep=avisar; fi
    if [[ " $resto " =~ \ (sessao|aba)\ (.+)$ ]]; then nome=$(sed -E 's/^((a|o|da|do|de|esta|essa|escolhida) )+//; s/ (por favor|pra mim)$//' <<<"${BASH_REMATCH[2]}")
      [[ $nome =~ ^(esta|essa|escolhida|atual)?$ ]] && nome=""; fi
    echo "esperar $seg $dep${nome:+ $nome}"; return 0
  fi
  # o modo retorno: "modo retorno (por 5 minutos)", "me chama quando elas terminarem", "pode ir, me chama em no máximo 5 min"
  if [[ $n =~ ^(sair|sai|saia|saio|desligar|desliga|desligue|parar|para|pare|cancelar|cancela|cancele|terminar|termina|termine)\ (do\ |o\ |de\ )?modo\ (retorno|callback|de\ retorno|espera|de\ espera)$|^(volte|volta|voltar)\ a\ (me\ )?ouvir$ ]]; then
    echo "retorno sair"; return 0; fi
  if [[ $n =~ ^(ligar|liga|ligue|ativar|ativa|ative|desligar|desliga|desligue|desativar|desativa|desative)\ (o\ )?(retorno|callback|modo\ retorno)\ automatico$ ]]; then
    [[ ${BASH_REMATCH[1]} == des* ]] && echo "retorno auto nao" || echo "retorno auto sim"; return 0; fi
  if [[ $n =~ ^((entrar|entra|entre|ir|vai|va)\ (no|em|para\ o|pro|para)\ |(ligar|liga|ligue|ativar|ativa|ative)\ (o\ )?)?modo\ (retorno|callback|de\ retorno)(\ (.+))?$ ]]; then
    resto=${BASH_REMATCH[8]}; seg=0
    if [[ -n $resto ]]; then resto=$(sed -E 's/^(por|de|com prazo de|com|ate|no maximo|em no maximo|em|e me chama em|me chama em) //; s/^(no maximo|em) //' <<<"$resto")
      r=$(duracao_de "$resto") && seg=${r%%$'\t'*}; fi
    echo "retorno $seg"; return 0; fi
  if [[ $n =~ ^((pode\ )?(ir|vai|seguir|segue|continuar|continua)\ )?(e\ )?(me\ )?(chama|chame|chamar|avisa|avise|avisar|aviseme|chamame)(\ me)?\ (quando|assim\ que)\ (alguma|algum|qualquer\ uma|qualquer\ um|elas|eles|as\ sessoes|alguma\ sessao|todas|todos|tudo|uma\ delas|um\ deles)\ (terminar|terminarem|responder|responderem|acabar|acabarem|voltar|voltarem)(\ (.+))?$ ||
    $n =~ ^(pode\ ir|pode\ seguir|pode\ continuar|fico\ esperando|vou\ esperar|me\ chama\ depois|me\ chame\ depois)((\ e|\ que)?\ (me\ chama|me\ chame|me\ avisa|me\ avise|eu\ espero)(\ (.+))?)?$ ]]; then
    resto=${BASH_REMATCH[${#BASH_REMATCH[@]}-1]}; seg=0
    if [[ -n $resto ]]; then r=$(duracao_de "$(sed -E 's/^((ou|e|me chama|me chame|em|no maximo|ate|em no maximo|depois de|se nao) )+//' <<<"$resto")") && seg=${r%%$'\t'*}; fi
    echo "retorno $seg"; return 0; fi
  if [[ $n =~ ^(me\ )?(avise|avisa|avisar|aviseme|chame|chama|fala|fale)(\ me)?\ (quando|se)\ (ele\ |ela\ |o\ agente\ |a\ sessao\ |o\ claude\ |o\ codex\ |o\ kiro\ )?(terminar|acabar|concluir|finalizar|pedir|precisar|parar|perguntar) ]]; then
    echo acompanhar; return 0; fi
  if [[ $n =~ ^(acompanhe|acompanha|acompanhar|monitore|monitora|monitorar|vigie|vigia|fique\ de\ olho|fica\ de\ olho)(\ (a|na|essa|esta|nessa|nesta))?(\ (sessao|aba))?(\ (.+))?$ ]]; then
    nome=$(sed -E 's/ ?(ate|até) (concluir|terminar|acabar|o fim|ela terminar|ele terminar)$//; s/^((a|o|da|do|de) )+//' <<<"${BASH_REMATCH[7]}")
    [[ $nome =~ ^(ela|ele|esta|essa|isso|aqui)?$ ]] && nome=""
    echo "acompanhar${nome:+ $nome}"; return 0; fi
  if [[ $n =~ ^(cancel[ae]r?|par[ae]r?|esquec[ae]r?|desist[ae]r?|nao\ precisa|tirar?|tire)(\ (de|a|o|as|os|mais|com|essa|esta|essas|minha|minhas))*\ (espera|esperas|esperar|aviso|avisos|avisar|acompanhar|acompanhamento|acompanhamentos|monitorar|vigiar|agenda|agendado)$ ]]; then
    echo "cancelar espera"; return 0; fi
  [[ $n =~ ^((o\ )?que|quais)\ (voce\ )?(esta|ta|estas)\ (esperando|acompanhando)$|^(esperas|agenda|o\ que\ (tem|ha|esta)\ agendado)$ ]] && { echo esperas; return 0; }
  [[ $n =~ ^(as\ )?(fixadas|sessoes\ fixadas|quais\ (sao\ )?(as\ )?(fixadas|sessoes\ fixadas))$ ]] && { echo fixadas; return 0; }
  [[ $n =~ ^agrup(ar|e|a)(\ as)?\ (fixadas|sessoes\ fixadas)(\ por\ maquina)?$ ]] && { echo "agrupar fixadas"; return 0; }
  if [[ $n =~ ^(mover|move|mova|levar|leva|leve)(\ a)?\ (fixada|sessao)\ (.+)\ (para|pra)\ (o\ |a\ )?(inicio|fim|final|comeco|esquerda|direita|frente|primeira|ultima|primeira\ posicao|ultima\ posicao|posicao\ [a-z0-9]+|[a-z0-9]+\ posicao)$ ]]; then
    echo "mover fixada ${BASH_REMATCH[4]}|${BASH_REMATCH[7]}"; return 0; fi
  if [[ $n =~ ^(desafixar|desafixa|desafixe)(\ (a|esta|essa))?(\ (sessao|aba))?(\ (.+))?$ || $n =~ ^(tirar|tira|tire|remover|remova)(\ (a|esta|essa))?(\ (sessao|aba))?(\ (.+))?\ (das\ fixadas|da\ barra)$ ]]; then
    nome=${BASH_REMATCH[7]}; [[ $nome =~ ^(esta|essa|ela)$ ]] && nome=""; echo "desafixar${nome:+ $nome}"; return 0; fi
  # "fixar" só com sessão/aba, esta/essa ou "na barra" ("fixe o bug do login" é um pedido ao agente)
  nome=-
  if [[ $n =~ ^(fixar|fixa|fixe)\ ((a|esta|essa)\ )?(sessao|aba)(\ (.+))?$ ]]; then nome=${BASH_REMATCH[6]}
  elif [[ $n =~ ^(fixar|fixa|fixe)\ (esta|essa|ela)(\ na\ barra)?$ ]]; then nome=""
  elif [[ $n =~ ^(fixar|fixa|fixe)\ (.+)\ na\ barra$ ]]; then nome=${BASH_REMATCH[2]}; fi
  if [[ $nome != - ]]; then
    nome=$(sed -E 's/ ?(na barra|nas fixadas)$//; s/^(a|o) //' <<<"$nome"); [[ $nome =~ ^(esta|essa|ela|sessao)?$ ]] && nome=""
    echo "fixar${nome:+ $nome}"; return 0; fi
  [[ $n =~ ^((nova|adicione|adiciona|crie|criar|cria)\ (a\ |uma\ )?)?subtarefa\ (.+)\ (na|para\ a|pra|da|dentro\ da)\ tarefa\ (.+)$ ]] && { echo "subtarefa ${BASH_REMATCH[6]}|${BASH_REMATCH[4]}"; return 0; }
  [[ $n =~ ^(nova\ tarefa|(crie|criar|cria|adicione|adiciona|anote|anota)\ (a\ |uma\ )?(nova\ )?tarefa)\ (.+)$ ]] && { echo "nova tarefa ${BASH_REMATCH[5]}"; return 0; }
  if [[ $n =~ ^(mude|mudar|muda|troque|trocar|troca|coloque|coloca|por|poe|ponha|ajuste|ajusta)?\ ?(o\ )?prazo\ da\ tarefa\ (.+)\ (para|pra)\ (.+)$ ]]; then
    echo "prazo tarefa ${BASH_REMATCH[3]}|${BASH_REMATCH[5]}"; return 0; fi
  [[ $n =~ ^(tire|tira|tirar|remova|remove|remover|limpe|limpa|limpar)\ o\ prazo\ da\ tarefa\ (.+)$ ]] && { echo "prazo tarefa ${BASH_REMATCH[2]}|sem prazo"; return 0; }
  [[ $n =~ ^(concluir|conclua|conclui|concluí|marcar|marque|marca|finalizar|finalize|finaliza|fechar|feche|fecha)\ (a\ )?tarefa\ (.+)$ ]] &&
    { nome=$(sed -E 's/ como (feita|concluida)$//' <<<"${BASH_REMATCH[3]}"); echo "concluir tarefa $nome"; return 0; }
  [[ $n =~ ^(a\ )?tarefa\ (.+)\ (feita|concluida|esta\ feita|ta\ feita|esta\ concluida|pronta|esta\ pronta)$ ]] && { echo "concluir tarefa ${BASH_REMATCH[2]}"; return 0; }
  [[ $n =~ ^(reabrir|reabra|reabre|reabrir\ a|desfazer|desfaca|desfaz)\ (a\ )?tarefa\ (.+)$ ]] && { echo "reabrir tarefa ${BASH_REMATCH[3]}"; return 0; }
  [[ $n =~ ^(apagar|apague|apaga|remover|remova|remove|excluir|exclua|exclui|deletar|delete|deleta)\ (a\ )?tarefa\ (.+)$ ]] && { echo "apagar tarefa ${BASH_REMATCH[3]}"; return 0; }
  [[ $n =~ ^(qual\ (e\ )?)?(o\ )?(apelido|codigo)\ da\ tarefa\ (.+)$ ]] && { echo "apelido tarefa ${BASH_REMATCH[5]}"; return 0; }
  [[ $n =~ ^((ler|leia|le|leias|quais|quais\ sao|tem|ha|mostre|mostra)\ )?(as\ )?(minhas\ )?(notificacoes|avisos|alertas|notificacao)(\ novas|\ nao\ lidas|\ do\ sininho)?$ ]] && { echo notificacoes; return 0; }
  [[ $n =~ ^((ler|leia|le)\ )?todas\ as\ (notificacoes|avisos)$ ]] && { echo "notificacoes todas"; return 0; }
  [[ $n =~ ^(marcar|marque|marca)(\ as|\ todas\ as|\ todas)?\ (notificacoes|avisos)(\ como)?\ lidas$|^(marcar|marque|marca)\ (tudo|todas)\ como\ lidas?$|^(zerar|zere|zera)\ o\ sininho$ ]] && { echo "notificacoes lidas"; return 0; }
  [[ $n =~ ^(limpar|limpe|limpa|apagar|apague|apaga)(\ as)?\ (notificacoes|avisos)(\ lidas|\ ja\ lidas)?$|^(limpar|limpe|limpa)\ o\ sininho$ ]] && { echo "notificacoes limpar"; return 0; }
  [[ $n =~ ^((ler|leia|le)\ |o\ que\ (esta|tem|ta)(\ passando)?\ no\ )?(o\ )?letreiro$ ]] && { echo letreiro; return 0; }
  [[ $n =~ ^(pausar|pausa|pause|parar|para|pare|congelar|congela|congele|segurar|segura|segure)(\ o)?\ letreiro$ ]] && { echo "letreiro pausar"; return 0; }
  [[ $n =~ ^(continuar|continua|continue|soltar|solta|solte|retomar|retoma|retome|voltar|volta|volte|rodar|roda|rode|despausar|despausa)(\ o)?\ letreiro$ ]] && { echo "letreiro continuar"; return 0; }
  if [[ $n =~ ^(fechar|feche|fecha|encerrar|encerre|encerra|matar|mate|mata)(\ a|\ esta|\ essa)?\ (sessao|aba)(\ (.+))?$ ]]; then
    nome=${BASH_REMATCH[5]}; [[ $nome =~ ^(esta|essa|atual|escolhida)$ ]] && nome=""; echo "fechar sessao${nome:+ $nome}"; return 0; fi
  if [[ $n =~ ^(limpeza|faxina|(fazer|faca|faz)\ (a\ |uma\ )?(limpeza|faxina)|(limpar|limpe|limpa|arrumar|arrume|arruma)\ (as\ )?sessoes|(quais\ )?sessoes\ (eu\ )?(posso|da\ pra|da\ para|podemos|devo|vale)\ fechar|(o\ )?que\ (eu\ )?(posso|da\ pra|devo)\ fechar|sessoes\ paradas)(\ (em|no|na|do|da|de)\ (.+))?$ ]]; then
    nome=${BASH_REMATCH[${#BASH_REMATCH[@]}-1]}; echo "limpeza${nome:+ $nome}"; return 0; fi
  return 1
}
reescrever() { # frase normalizada -> o vocabulário de comando(); deixa a conversa solta ("empresa", "sessões do dell", "2", "sim")
  local n=$1 m p pre r
  n=$(sed -E 's/^(por favor|ok|entao|e|agora) //; s/ por favor$//
    s/^(me )?(diga|fala|mostra|mostre|mostrar|lista|liste|listar|ver|veja|quero ver|quais sao|quais|qual)( as| os| a| o)? //
    s/^(vai|va|vamos|entra|entrar|entre|muda|troca) (para|pra|no|na|em) /ir para /' <<<"$n")
  n=$(sed -E 's/^ir para (a |o )?(sessao|aba) /sessao /' <<<"$n")
  # "abra uma nova sessão em empresa", "crie uma aba com o codex", "nova sessão no dell" -> o 🚀 (máquina e IA ditas);
  # "abrir a sessão bimo" (sem nova, sem uma, e o resto não é em/no/na/com) é escolher a que existe
  if [[ $n =~ $RE_NOVA ]] && pre=${BASH_REMATCH[0]} && [[ $pre =~ $RE_NOVA_VERBO ]]; then
    r=${n#"$pre"}; r=${r# }
    if [[ " $pre " == *" nov"[ao]" "* || " $pre " == *" um"* || -z $r || $r =~ ^(em|no|na|nos|com)\  ]]; then
      echo "nova sessao${r:+ $r}"; return
    fi
  fi
  p=$(pergunta)
  # respostas curtas a uma pergunta pendente: confirmação, a lista da limpeza, a pergunta da tela de um agente
  case $p in
    confirmar)
      case $n in sim|pode|confirmo|confirma|confirmado|isso|claro|ok|sim\ pode|pode\ fechar|pode\ apagar|sim\ fechar|sim\ apagar|\
        fechar|fecha|apagar|apaga|sim\ de\ novo|sim\ tenho\ certeza|tenho\ certeza|certeza|sim\ sim) echo "confirmar sim"; return ;;
        nao|nao\ fecha|nao\ apaga|cancela|cancelar|deixa|deixa\ pra\ la|esquece|melhor\ nao|nao\ nao) echo "confirmar nao"; return ;; esac ;;
    limpeza)
      case $n in fechar|fecha|fechar\ todas|fecha\ todas|pode\ fechar|sim|confirmo|pode|fechar\ tudo|fecha\ tudo|sim\ fechar|pode\ fechar\ todas) echo "limpeza fechar"; return ;;
        nao|cancela|cancelar|deixa|deixa\ pra\ la|esquece|nao\ fecha|nao\ fechar|nao\ fecha\ nada) echo "limpeza cancelar"; return ;; esac
      if [[ $n =~ ^(tirar|tira|tire|menos|deixa|deixar|deixe|manter|mantem|mantenha|nao\ fecha|nao\ feche|exceto|fica|ficar|fique)(\ (a|o|as|os|numero|sessao))*\ (.+)$ ]] &&
        numero "${BASH_REMATCH[4]}" >/dev/null; then echo "limpeza tirar ${BASH_REMATCH[4]}"; return; fi ;;
    opcao:*|sn:*|enter:*)
      if numero "$n" >/dev/null && [[ $(wc -w <<<"$n") -le 3 ]]; then echo "opcao $n"; return; fi
      case $n in
        sim|pode|aceito|confirmo|confia|confio|claro|isso|ok|sim\ pode|pode\ aceitar|aceitar|permitir|permite) echo "opcao sim"; return ;;
        nao|nao\ aceito|recusa|recusar|negar|nao\ permite|nao\ confia|nao\ confio) echo "opcao nao"; return ;;
        sempre|confia\ sempre|confiar\ sempre|sim\ sempre|sempre\ confiar|confio\ sempre|sempre\ nesta\ pasta) echo "opcao sempre"; return ;;
      esac
      if [[ $p == enter:* ]]; then case $n in enter|continuar|continua|seguir|segue|pode\ continuar) echo "opcao enter"; return ;;
        cancelar|cancela) echo "opcao nao"; return ;; esac; fi ;;
  esac
  r=$(reescrever_acoes "$n") && { echo "$r"; return; }
  if [[ $p == liberar ]]; then
    case $n in sim|pode|libera|liberar|claro|isso|ok|quero|sim\ pode|pode\ liberar) echo "permitir sessao"; return ;;
      nao|agora\ nao|deixa|deixa\ pra\ la) echo "nao"; return ;; esac
  fi
  case $n in maquina|computador|maquinas\ ligadas) echo maquinas; return ;; sessao|aba|janela) echo sessoes; return ;; esac
  # resumo de todas as sessões: o panorama (todas as máquinas ao mesmo tempo)
  if [[ $n =~ $RE_PANORAMA || $n =~ $RE_PANORAMA2 ]]; then echo panorama; return; fi
  # "2", "dois", "numero dois", "a segunda" com uma lista recente
  if [[ -s $ST/lista ]] && [[ $n =~ ^((a|o|numero|aba|sessao) )*[a-z0-9]+$ ]] && numero "$n" >/dev/null &&
    [[ $(wc -w <<<"$n") -le 3 ]]; then echo "aba $n"; return; fi
  m=$(maquina_citada "$n")
  # "sessões do dell", "selecionar sessão de empresa": frase curta; a longa (um pedido que cita a máquina) é do cérebro
  if [[ -n $m ]] && (($(wc -w <<<"$n") <= 6)) && ! [[ " $n " =~ $RE_PEDIDO ]]; then
    case " $n " in
      *" sess"*|*" aba"*|*" janela"*) echo "sessoes em $m"; return ;;
    esac
    case $n in "$(norm "$m")"|"o $(norm "$m")"|"a $(norm "$m")"|celular|aqui|telefone) echo "ir para $m"; return ;; esac
  fi
  echo "$n"
}

CONHECIDOS='^(retorno|retorno .+|esperar .+|acompanhar.*|cancelar espera|esperas|fixadas|agrupar fixadas|fixar.*|desafixar.*|mover fixada .+|nova tarefa .+|subtarefa .+|prazo tarefa .+|concluir tarefa .+|reabrir tarefa .+|apagar tarefa .+|apelido tarefa .+|notificacoes.*|letreiro.*|fechar sessao.*|limpeza.*|confirmar (sim|nao)|panorama|opcao .+|tarefa .+|tarefas abertas|silencio|sem microfone|android auto|ajuda.*|comandos|como funciona|como usar|terminal|ola|oi|inicio|comecar|encerrar|sair|tchau|fim|terminar|desligar|ate mais|maquinas|computadores|status|saude|estado|ir para .+|ir pra .+|trocar para .+|mudar para .+|sessoes|abas|janelas|listar sessoes|sessoes em .+|aba .+|sessao .+|abrir .+|proxima|proxima aba|seguinte|anterior|aba anterior|voltar|nova sessao.*|nova aba.*|tarefas|minhas tarefas|contas|rodizio|uso|limite|repetir|repete|de novo|ler|resposta|e ai|permitir sessao|liberar sessao|bloquear sessao|enter|confirmar|confirma|cancelar|escape|onde|alvo|atual|nao)$'
simples() { # com o cérebro ligado, só os comandos curtos e exatos ficam nas regras (o resto vai ao modelo)
  local r
  case $1 in
    silencio|sem\ microfone|android\ auto|ajuda|ajuda\ *|comandos|como\ funciona|como\ usar|terminal|ola|oi|inicio|comecar|\
    encerrar|sair|tchau|fim|terminar|desligar|ate\ mais|maquinas|computadores|status|saude|estado|sessoes|abas|janelas|\
    listar\ sessoes|sessoes\ em\ *|proxima|proxima\ aba|seguinte|anterior|aba\ anterior|voltar|tarefas|minhas\ tarefas|\
    tarefas\ abertas|contas|rodizio|uso|limite|repetir|repete|de\ novo|ler|resposta|e\ ai|permitir\ sessao|liberar\ sessao|\
    bloquear\ sessao|enter|confirmar|confirma|cancelar|escape|onde|alvo|atual|nao|opcao\ *|nova\ sessao|nova\ aba|panorama|\
    retorno|retorno\ *|esperar\ *|acompanhar|acompanhar\ *|cancelar\ espera|esperas|fixadas|agrupar\ fixadas|fixar|desafixar|mover\ fixada\ *|\
    nova\ tarefa\ *|subtarefa\ *|prazo\ tarefa\ *|concluir\ tarefa\ *|reabrir\ tarefa\ *|apagar\ tarefa\ *|apelido\ tarefa\ *|\
    notificacoes|notificacoes\ *|letreiro|letreiro\ *|fechar\ sessao|limpeza|limpeza\ *|confirmar\ sim|confirmar\ nao) return 0 ;;
    fixar\ *|desafixar\ *|fechar\ sessao\ *) (($(wc -w <<<"$1") <= 6)) ;;
    nova\ sessao\ *) [[ " $1 " != *" para "* && " $1 " != *" pra "* && " $1 " != *" e "* ]] && (($(wc -w <<<"$1") <= 7)) ;;
    ir\ para\ *|ir\ pra\ *|trocar\ para\ *|trocar\ pra\ *|mudar\ para\ *)
      r=${1#ir para }; r=${r#ir pra }; r=${r#trocar para }; r=${r#trocar pra }; r=${r#mudar para }
      achar_maquina "$r" >/dev/null ;;
    aba\ *|sessao\ *|tarefa\ *) (($(wc -w <<<"$1") <= 3)) ;;
    *) return 1 ;;
  esac
}
entender() { # entender "HIPÓTESE1\nHIPÓTESE2...": a 1ª que vira comando; senão a 1ª, como texto livre
  local l n
  while IFS= read -r l; do
    [[ -n $l ]] || continue
    n=$(reescrever "$(tirar_prefixo "$(norm "$l")")")
    [[ $n =~ $CONHECIDOS ]] && { printf '%s\n' "$l"; return; }
  done <<<"$1"
  head -n 1 <<<"$1"
}
tirar_prefixo() { local n=$1; n=${n#terminal }; n=${n#diga }; n=${n#escreva }; printf '%s' "$n"; }

# ---------- cérebro (opcional): um Claude rápido entende a frase solta e escolhe as ações ----------
achar_maquina() { # nome dito -> rótulo do tt
  local r; r=$(norm "$1"); r=${r#a }; r=${r#o }
  [[ $r == celular || $r == aqui || $r == telefone || $r == este ]] && { local_rotulo; return; }
  local lista; mapfile -t lista < <(maquinas); achar "$r" "${lista[@]}"
}
cerebro_lugares() { # onde o cérebro roda: VOZ_CEREBRO_CMD (testes), ~/.config/tt-voz/cerebro ("-" = desligado) ou o padrão
  [[ -n ${VOZ_CEREBRO_CMD:-} ]] && { echo cmd; return; }
  if [[ -f $CF/cerebro ]]; then sed '/^-$/d' "$CF/cerebro"; else printf '%s\n' ${VOZ_CEREBRO_PADRAO:-}; fi
}
# O modelo do cérebro. Medido em 16/10/2026 com frases reais: o Sonnet acertou as ambíguas que o Haiku errava
# (escolher a sessão citada e pedir para liberar; perguntar qual sessão; não agir sobre uma frase mal transcrita) e
# custou ~1 s a mais por volta (quase todo o tempo é a partida do Claude, não o modelo).
cerebro_modelo() { local m; m=$(cat "$CF/cerebro-modelo" 2>/dev/null); m=${VOZ_CEREBRO_MODELO:-${m:-sonnet}}
  [[ $m =~ ^[a-z0-9.-]+$ ]] || m=sonnet; printf '%s' "$m"; }
# O cérebro aberto da janela do 🎤: um Claude em stream-json que fica de pé a conversa toda (cada volta ~1,5 s, contra
# ~7 s de um `claude -p` que parte do zero). A conta sai do rodízio (ia-rot --claude-only --melhor); as regras vão uma
# vez só, no system prompt. Roda no 1º lugar do cérebro: aqui, ou por ssh na máquina configurada. No celular, não.
cerebro_vivo_aqui() { # MODELO: troca este processo pelo Claude (stdin/stdout em stream-json)
  local mod=$1 conta dir
  [[ $mod =~ ^[a-z0-9.-]+$ ]] || mod=sonnet
  conta=$(CLAUDE_ROT_MODELO=$mod ia-rot --claude-only --melhor 2>/dev/null | cut -f1)
  case $conta in principal|"") dir= ;; *) dir=$HOME/.local/share/claude-contas/$conta ;; esac
  cerebro_regras janela > "$ST/cerebro-regras.md"
  if [[ -n $dir ]]; then export CLAUDE_CONFIG_DIR=$dir; else unset CLAUDE_CONFIG_DIR; fi
  exec claude -p --model "$mod" --input-format stream-json --output-format stream-json --verbose --tools "" \
    --no-session-persistence --system-prompt-file "$ST/cerebro-regras.md"
}
cerebro_vivo() { # o comando do cérebro aberto, no 1º lugar configurado (VOZ_CEREBRO_VIVO_CMD nos testes); 1 = não há
  local lugar d mod
  [[ -n ${VOZ_CEREBRO_VIVO_CMD:-} ]] && exec bash -c "$VOZ_CEREBRO_VIVO_CMD"
  [[ ${PREFIX:-} == *com.termux* ]] && return 1
  lugar=$(cerebro_lugares | head -n 1); mod=$(cerebro_modelo)
  case $lugar in
    local) command -v claude >/dev/null && command -v ia-rot >/dev/null || return 1; cerebro_vivo_aqui "$mod" ;;
    ""|cmd) return 1 ;;
    *) d=$(destino "$lugar"); [[ -n $d && $d != local ]] || return 1
      exec ssh "${SSHO[@]}" "$d" "PATH=\"\$HOME/.local/bin:\$PATH\"; f=\$HOME/.local/share/tt/voz; grep -q -- --cerebro-vivo-aqui \"\$f\" && exec bash \"\$f\" --cerebro-vivo-aqui $mod" ;;
  esac
}
CEREBRO_SOCK_PY='import socket, sys
s = socket.socket(socket.AF_UNIX); s.settimeout(float(sys.argv[2]))
s.connect(sys.argv[1]); s.sendall(sys.stdin.buffer.read()); s.shutdown(socket.SHUT_WR)
r = b""
while True:
    b = s.recv(65536)
    if not b:
        break
    r += b
sys.stdout.write(r.decode("utf-8", "replace"))'
cerebro_chamar() { # CONTEXTO -> resposta do modelo: o Claude aberto da janela (VOZ_CEREBRO_SOCK), senão cada lugar, na ordem
  local ctx=$1 p lugar d mod r
  if [[ -n ${VOZ_CEREBRO_SOCK:-} && -S $VOZ_CEREBRO_SOCK ]]; then
    r=$(python3 -I -c "$CEREBRO_SOCK_PY" "$VOZ_CEREBRO_SOCK" "${VOZ_CEREBRO_TEMPO:-45}" <<<"$ctx" 2>/dev/null)
    [[ $r == *'{'* ]] && { printf '%s\n' "$r"; return 0; }
  fi
  p=$(cerebro_regras; echo; printf '%s\n' "$ctx"); mod=$(cerebro_modelo)
  for lugar in $(cerebro_lugares); do
    case $lugar in
      cmd) timeout "${VOZ_CEREBRO_TEMPO:-45}" bash -c "$VOZ_CEREBRO_CMD" <<<"$p" 2>/dev/null && return 0 ;;
      local) timeout 60 bash -c "$(ia_em "$(local_rotulo)" "ia-rot -p --model $mod --no-session-persistence")" <<<"$p" 2>/dev/null && return 0 ;;
      *) d=$(destino "$lugar"); [[ -n $d && $d != local ]] || continue
        timeout 45 ssh "${SSHO[@]}" "$d" "PATH=\"\$HOME/.local/bin:\$PATH\"; ia-rot -p --model $mod --no-session-persistence" <<<"$p" 2>/dev/null && return 0 ;;
    esac
  done
  return 1
}
cerebro_regras() { # [janela]: as instruções fixas do cérebro (no Claude aberto da janela, o system prompt)
  local onde="pelo celular, muitas vezes dirigindo"
  [[ -n ${VOZ_TELA_FD:-} || ${1:-} == janela ]] && onde="pelo microfone do computador (ou digitando), na janela do 🎤 do tt"
  printf 'Você é o "Terminal", a voz do tt-terminais: um gerenciador de sessões tmux em várias máquinas, com agentes de IA (Claude,\n'
  printf 'Codex) rodando nelas. O usuário fala com você %s. A frase vem do reconhecimento de voz\n' "$onde"
  cat <<'FIM'
em português e pode ter erros: entenda a intenção e decida o que fazer.

Responda SÓ com um JSON, sem nada fora dele:
{"fala": "o que dizer (curto, até 2 frases, português do Brasil falado, sem markdown nem listas)", "acoes": [...]}

Ações (na ordem em que devem acontecer):
{"acao":"maquinas"}  lista as máquinas            {"acao":"status"}  diz quais estão ligadas
{"acao":"listar","maquina":"M"}  troca para M e lê as sessões dela, numeradas
{"acao":"escolher","maquina":"M","sessao":"nome exato do índice, parte do nome ou número da última lista"}  escolhe (e
  já libera) a sessão; para ir a uma sessão pelo assunto, ache-a no índice de sessões e passe máquina e nome exatos
{"acao":"panorama","maquina":"opcional"}  lê todas as sessões (de todas as máquinas, ou de M) e resume o que cada uma faz
{"acao":"bloquear"}  solta a sessão escolhida (para de mandar texto a ela)
{"acao":"enviar","texto":"mensagem"}  digita a mensagem no agente da sessão escolhida e lê a resposta dele
